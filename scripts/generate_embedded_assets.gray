//
// generate_embedded_assets.gray - Generate cli/embedded_assets.gray
//
// embed() takes one literal path and cannot embed a directory, so this writes
// an embed() per staged runtime file under cli/runtime.
//
// Usage: grayc scripts/generate_embedded_assets.gray && ./generate_embedded_assets
//        (run from the repo root, after the assets are staged under cli/runtime)
//
// Copyright (c) 2025-Present Marshall A Burns
// Licensed under the MIT License. See LICENSE for details.

import @io, @strings, @arrays, @path

const RUNTIME_DIRECTORY string = "cli/runtime"
const OUTPUT string = "cli/embedded_assets.gray"

// list_files returns every file under directory as a path relative to
// RUNTIME_DIRECTORY, in sorted order.
do list_files(directory string) -> [string] {
    mut found [string] = {}
    mut entries, list_err = io.list_dir(directory)
    if list_err != nil {
        eprintln("generate_embedded_assets.gray: error: cannot read ${directory}")
        exit(1)
    }
    arrays.sort_asc(entries)
    for_each entry in entries {
        entry_path string = path.join_parts({directory, entry})
        if io.is_directory(entry_path) {
            for_each nested in list_files(entry_path) {
                arrays.append(found, nested)
            }
        } otherwise {
            arrays.append(found, strings.remove_prefix(entry_path, "${RUNTIME_DIRECTORY}/"))
        }
    }
    return found
}

do main() {
    source_directory string = "${RUNTIME_DIRECTORY}/src"
    if !io.is_directory(source_directory) {
        eprintln("generate_embedded_assets.gray: error: ${source_directory} not found")
        exit(1)
    }

    mut out [string] = {}
    arrays.append(out, "// embedded_assets.gray — GENERATED by scripts/generate_embedded_assets.gray; do not edit.")
    arrays.append(out, "")
    arrays.append(out, "const EMBEDDED_GRAYC string = embed(\"runtime/grayc\")")
    arrays.append(out, "const EMBEDDED_LIBGRAYRT string = embed(\"runtime/libgrayrt.a\")")
    arrays.append(out, "")
    arrays.append(out, "// embedded_sources maps each runtime source file, as it lies under the")
    arrays.append(out, "// extraction directory, to its contents.")
    arrays.append(out, "do embedded_sources() -> map[string:string] {")
    arrays.append(out, "    mut sources map[string:string] = {:}")
    for_each relative in list_files(source_directory) {
        arrays.append(out, "    sources[\"${relative}\"] = embed(\"runtime/${relative}\")")
    }
    arrays.append(out, "    return sources")
    arrays.append(out, "}")
    arrays.append(out, "")

    _, write_err = io.write_file(OUTPUT, strings.join(out, "\n"))
    if write_err != nil {
        eprintln("generate_embedded_assets.gray: error: cannot write ${OUTPUT}")
        exit(1)
    }
}
