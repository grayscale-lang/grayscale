//
// generate_man_data.gray - Generate cli/man_data.gray from the stdlib headers
//
// Extracts the @man blocks of grayc/src/stdlib/builtins.h (the builtins) and of
// every header under grayc/src/stdlib/ that carries a @module tag (the stdlib
// modules) for the Grayscale CLI's gray man.
//
// Usage: grayc scripts/generate_man_data.gray && ./generate_man_data
//        (run from the repo root)
//
// Copyright (c) 2025-Present Marshall A Burns
// Licensed under the MIT License. See LICENSE for details.

import @io, @strings, @arrays, @fmt
import "./man_blocks"

const STDLIB_DIR string = "grayc/src/stdlib"
const BUILTINS_HEADER string = "grayc/src/stdlib/builtins.h"
const OUTPUT string = "cli/man_data.gray"

// quoted_list joins names into `"a", "b", "c"`.
do quoted_list(names [string]) -> string {
    mut quoted [string] = {}
    for_each name in names {
        arrays.append(quoted, "\"${name}\"")
    }
    return strings.join(quoted, ", ")
}

// escape_dollars makes block text, already escaped for a string literal, safe
// in a Grayscale string: the dollar sign would start an interpolation.
do escape_dollars(text string) -> string {
    return strings.replace(text, "$", "\\\$")
}

// entry_literal is the ManEntry literal for one block.
do entry_literal(block man_blocks.ManBlock) -> string {
    return "ManEntry{module: \"${block.module}\", group: \"${block.group}\", kind: \"${block.kind}\", sig: \"${escape_dollars(block.sig)}\", type_fields: \"${escape_dollars(block.field_text)}\", desc: \"${escape_dollars(block.desc)}\", example: \"${escape_dollars(block.example)}\"}"
}

do main() {
    mut builtin_lines, builtin_err = io.read_lines(BUILTINS_HEADER)
    if builtin_err != nil {
        eprintln("generate_man_data.gray: error: ${BUILTINS_HEADER} not found")
        exit(1)
    }
    mut builtin_blocks [man_blocks.ManBlock] = man_blocks.parse_man_blocks(builtin_lines)

    mut entries, list_err = io.list_dir(STDLIB_DIR)
    if list_err != nil {
        eprintln("generate_man_data.gray: error: cannot read ${STDLIB_DIR}")
        exit(1)
    }
    arrays.sort_asc(entries)

    mut blocks [man_blocks.ManBlock] = {}
    for_each entry in entries {
        if !strings.ends_with(entry, ".h") {
            continue
        }
        mut lines, read_err = io.read_lines("${STDLIB_DIR}/${entry}")
        if read_err != nil {
            eprintln("generate_man_data.gray: error: cannot read ${entry}")
            exit(1)
        }
        for_each block in man_blocks.parse_man_blocks(lines) {
            if block.module != "" {
                arrays.append(blocks, block)
            }
        }
    }

    // First-seen order of modules, with their function names and display groups.
    mut module_names [string] = {}
    mut module_functions [[string]] = {}
    mut group_modules [string] = {}
    mut group_labels [string] = {}
    mut group_functions [[string]] = {}
    for_each block in blocks {
        mut module_index i64 = arrays.index_of(module_names, block.module)
        if module_index == -1 {
            arrays.append(module_names, block.module)
            arrays.append(module_functions, {})
            module_index = len(module_names) - 1
        }
        arrays.append(module_functions[module_index], block.name)

        mut label string = block.group
        if label == "" {
            label = "Other"
        }
        mut group_index i64 = -1
        mut i i64 = 0
        for i < len(group_labels) {
            if group_modules[i] == block.module && group_labels[i] == label {
                group_index = i
                break
            }
            i = i + 1
        }
        if group_index == -1 {
            arrays.append(group_modules, block.module)
            arrays.append(group_labels, label)
            arrays.append(group_functions, {})
            group_index = len(group_labels) - 1
        }
        arrays.append(group_functions[group_index], block.name)
    }

    mut out [string] = {}
    arrays.append(out, "// man_data.gray — GENERATED by scripts/generate_man_data.gray; do not edit.")
    arrays.append(out, "")
    arrays.append(out, "// ManEntry holds documentation for a single builtin, stdlib function, type or")
    arrays.append(out, "// constant. kind is \"func\", \"type\" or \"const\"; fields holds a type's")
    arrays.append(out, "// newline-separated \"name type\" pairs.")
    arrays.append(out, "const ManEntry struct {")
    arrays.append(out, "    module string")
    arrays.append(out, "    group string")
    arrays.append(out, "    kind string")
    arrays.append(out, "    sig string")
    arrays.append(out, "    type_fields string")
    arrays.append(out, "    desc string")
    arrays.append(out, "    example string")
    arrays.append(out, "}")
    arrays.append(out, "")
    arrays.append(out, "// ManGroup is one labeled group of names within a module index.")
    arrays.append(out, "const ManGroup struct {")
    arrays.append(out, "    label string")
    arrays.append(out, "    names [string]")
    arrays.append(out, "}")
    arrays.append(out, "")

    arrays.append(out, "// builtin_man_docs is the lookup table for gray man <builtin>.")
    arrays.append(out, "do builtin_man_docs() -> map[string:ManEntry] {")
    arrays.append(out, "    mut docs map[string:ManEntry] = {:}")
    for_each block in builtin_blocks {
        arrays.append(out, "    docs[\"${block.name}\"] = ${entry_literal(block)}")
    }
    arrays.append(out, "    return docs")
    arrays.append(out, "}")
    arrays.append(out, "")

    arrays.append(out, "// stdlib_man_docs is the per-function lookup table for gray man <module.name>.")
    arrays.append(out, "do stdlib_man_docs() -> map[string:ManEntry] {")
    arrays.append(out, "    mut docs map[string:ManEntry] = {:}")
    for_each block in blocks {
        arrays.append(out, "    docs[\"${block.module}.${block.name}\"] = ${entry_literal(block)}")
    }
    arrays.append(out, "    return docs")
    arrays.append(out, "}")
    arrays.append(out, "")

    arrays.append(out, "// stdlib_modules maps module names to their ordered function lists.")
    arrays.append(out, "do stdlib_modules() -> map[string:[string]] {")
    arrays.append(out, "    mut modules map[string:[string]] = {:}")
    mut m i64 = 0
    for m < len(module_names) {
        arrays.append(out, "    modules[\"${module_names[m]}\"] = {${quoted_list(module_functions[m])}}")
        m = m + 1
    }
    arrays.append(out, "    return modules")
    arrays.append(out, "}")
    arrays.append(out, "")

    arrays.append(out, "// stdlib_module_groups maps module names to their display groups.")
    arrays.append(out, "do stdlib_module_groups() -> map[string:[ManGroup]] {")
    arrays.append(out, "    mut groups map[string:[ManGroup]] = {:}")
    for_each module in module_names {
        arrays.append(out, "    groups[\"${module}\"] = {")
        mut group_lines [string] = {}
        mut g i64 = 0
        for g < len(group_labels) {
            if group_modules[g] == module {
                mut padded string = fmt.pad_right(group_labels[g], 14, ' ')
                arrays.append(group_lines, "        ManGroup{label: \"${padded}\", names: {${quoted_list(group_functions[g])}}}")
            }
            g = g + 1
        }
        arrays.append(out, strings.join(group_lines, ",\n"))
        arrays.append(out, "    }")
    }
    arrays.append(out, "    return groups")
    arrays.append(out, "}")

    mut _, write_err = io.write_file(OUTPUT, "${strings.join(out, "\n")}\n")
    if write_err != nil {
        eprintln("generate_man_data.gray: error: cannot write ${OUTPUT}")
        exit(1)
    }
    println("generate_man_data.gray: ${len(builtin_blocks)} builtins and ${len(blocks)} stdlib entries written to ${OUTPUT}")
}
