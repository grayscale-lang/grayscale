//
// generate_builtins_man.gray - Generate cli/builtins_man_data.go from builtins.h
//
// Extracts the @man blocks from grayc/src/stdlib/builtins.h.
//
// Usage: grayc scripts/generate_builtins_man.gray && ./generate_builtins_man
//        (run from the repo root)
//
// Copyright (c) 2025-Present Marshall A Burns
// Licensed under the MIT License. See LICENSE for details.

import @io, @strings, @arrays
import "./man_blocks"

const HEADER string = "grayc/src/stdlib/builtins.h"
const OUTPUT string = "cli/builtins_man_data.go"

do main() {
    mut lines, read_err = io.read_lines(HEADER)
    if read_err != nil {
        eprintln("generate_builtins_man.gray: error: ${HEADER} not found")
        exit(1)
    }

    mut out [string] = {}
    arrays.append(out, "// Code generated by scripts/generate_builtins_man.gray — do not edit.")
    arrays.append(out, "package main")
    arrays.append(out, "")
    arrays.append(out, "// BuiltinManEntry holds documentation for a single builtin function, type, or constant.")
    arrays.append(out, "type BuiltinManEntry struct {")
    arrays.append(out, "\tKind    string // \"func\", \"type\", or \"const\"")
    arrays.append(out, "\tSig     string // for funcs: signature string")
    arrays.append(out, "\tFields  string // for types: newline-separated \"name\\ttype\" pairs")
    arrays.append(out, "\tDesc    string")
    arrays.append(out, "\tExample string")
    arrays.append(out, "}")
    arrays.append(out, "")
    arrays.append(out, "// builtinManDocs is the lookup table used by gray man <name>.")
    arrays.append(out, "var builtinManDocs = map[string]BuiltinManEntry{")

    mut blocks [man_blocks.ManBlock] = man_blocks.parse_man_blocks(lines)
    for_each block in blocks {
        arrays.append(out, "\t\"${block.name}\": {Kind: \"${block.kind}\", Sig: \"${block.sig}\", Fields: \"${block.field_text}\", Desc: \"${block.desc}\", Example: \"${block.example}\"},")
    }
    arrays.append(out, "}")

    mut _, write_err = io.write_file(OUTPUT, "${strings.join(out, "\n")}\n")
    if write_err != nil {
        eprintln("generate_builtins_man.gray: error: cannot write ${OUTPUT}")
        exit(1)
    }
    println("generate_builtins_man.gray: ${len(blocks)} entries written to ${OUTPUT}")
}
