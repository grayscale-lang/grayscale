//
// generate_stdlib_man.gray - Generate cli/stdlib_man_data.go from stdlib headers
//
// Extracts the @man blocks that carry a @module tag from every header under
// grayc/src/stdlib/.
//
// Usage: grayc scripts/generate_stdlib_man.gray && ./generate_stdlib_man
//        (run from the repo root)
//
// Copyright (c) 2025-Present Marshall A Burns
// Licensed under the MIT License. See LICENSE for details.

import @io, @strings, @arrays, @fmt
import "./man_blocks"

const STDLIB_DIR string = "grayc/src/stdlib"
const OUTPUT string = "cli/stdlib_man_data.go"

// quoted_list joins names into `"a", "b", "c"`.
do quoted_list(names [string]) -> string {
    mut quoted [string] = {}
    for_each name in names {
        arrays.append(quoted, "\"${name}\"")
    }
    return strings.join(quoted, ", ")
}

do main() {
    mut entries, list_err = io.list_dir(STDLIB_DIR)
    if list_err != nil {
        eprintln("generate_stdlib_man.gray: error: cannot read ${STDLIB_DIR}")
        exit(1)
    }
    arrays.sort_asc(entries)

    mut blocks [man_blocks.ManBlock] = {}
    for_each entry in entries {
        if !strings.ends_with(entry, ".h") {
            continue
        }
        mut lines, read_err = io.read_lines("${STDLIB_DIR}/${entry}")
        if read_err != nil {
            eprintln("generate_stdlib_man.gray: error: cannot read ${entry}")
            exit(1)
        }
        for_each block in man_blocks.parse_man_blocks(lines) {
            if block.module != "" {
                arrays.append(blocks, block)
            }
        }
    }

    // First-seen order of modules, with their function names and display groups.
    mut module_names [string] = {}
    mut module_functions [[string]] = {}
    mut group_modules [string] = {}
    mut group_labels [string] = {}
    mut group_functions [[string]] = {}
    for_each block in blocks {
        mut module_index i64 = arrays.index_of(module_names, block.module)
        if module_index == -1 {
            arrays.append(module_names, block.module)
            arrays.append(module_functions, {})
            module_index = len(module_names) - 1
        }
        arrays.append(module_functions[module_index], block.name)

        mut label string = block.group
        if label == "" {
            label = "Other"
        }
        mut group_index i64 = -1
        mut i i64 = 0
        for i < len(group_labels) {
            if group_modules[i] == block.module && group_labels[i] == label {
                group_index = i
                break
            }
            i = i + 1
        }
        if group_index == -1 {
            arrays.append(group_modules, block.module)
            arrays.append(group_labels, label)
            arrays.append(group_functions, {})
            group_index = len(group_labels) - 1
        }
        arrays.append(group_functions[group_index], block.name)
    }

    mut out [string] = {}
    arrays.append(out, "// Code generated by scripts/generate_stdlib_man.gray — do not edit.")
    arrays.append(out, "package main")
    arrays.append(out, "")
    arrays.append(out, "// StdlibManEntry holds documentation for a single stdlib function, type, or constant.")
    arrays.append(out, "type StdlibManEntry struct {")
    arrays.append(out, "\tModule  string")
    arrays.append(out, "\tGroup   string")
    arrays.append(out, "\tKind    string // \"func\", \"type\", or \"const\"")
    arrays.append(out, "\tSig     string // for funcs: signature string")
    arrays.append(out, "\tFields  string // for types: newline-separated \"name\\ttype\" pairs")
    arrays.append(out, "\tDesc    string")
    arrays.append(out, "\tExample string")
    arrays.append(out, "}")
    arrays.append(out, "")
    arrays.append(out, "// stdlibManDocs is the per-function lookup table used by gray man <name>.")
    arrays.append(out, "var stdlibManDocs = map[string]StdlibManEntry{")
    for_each block in blocks {
        arrays.append(out, "\t\"${block.module}.${block.name}\": {Module: \"${block.module}\", Group: \"${block.group}\", Kind: \"${block.kind}\", Sig: \"${block.sig}\", Fields: \"${block.field_text}\", Desc: \"${block.desc}\", Example: \"${block.example}\"},")
    }
    arrays.append(out, "}")
    arrays.append(out, "")

    arrays.append(out, "// stdlibModules maps module names to their ordered function lists.")
    arrays.append(out, "var stdlibModules = map[string][]string{")
    mut m i64 = 0
    for m < len(module_names) {
        arrays.append(out, "\t\"${module_names[m]}\": {${quoted_list(module_functions[m])}},")
        m = m + 1
    }
    arrays.append(out, "}")
    arrays.append(out, "")

    arrays.append(out, "// stdlibGroup is one labeled group of names within a module index.")
    arrays.append(out, "type stdlibGroup struct {")
    arrays.append(out, "\tLabel string")
    arrays.append(out, "\tNames []string")
    arrays.append(out, "}")
    arrays.append(out, "")
    arrays.append(out, "// stdlibModuleGroups maps module names to their display groups.")
    arrays.append(out, "var stdlibModuleGroups = map[string][]stdlibGroup{")
    for_each module in module_names {
        arrays.append(out, "\t\"${module}\": {")
        mut g i64 = 0
        for g < len(group_labels) {
            if group_modules[g] == module {
                mut padded string = fmt.pad_right(group_labels[g], 14, ' ')
                arrays.append(out, "\t\t{Label: \"${padded}\", Names: []string{${quoted_list(group_functions[g])}}},")
            }
            g = g + 1
        }
        arrays.append(out, "\t},")
    }
    arrays.append(out, "}")

    mut _, write_err = io.write_file(OUTPUT, "${strings.join(out, "\n")}\n")
    if write_err != nil {
        eprintln("generate_stdlib_man.gray: error: cannot write ${OUTPUT}")
        exit(1)
    }
    println("generate_stdlib_man.gray: wrote ${OUTPUT}")
}
