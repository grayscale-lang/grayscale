/*
 * generate_runtime_macros.gray:  Generate grayc/src/codegen/runtime_macros.h
 *
 * Lists every macro the runtime and stdlib headers define, and every
 * gray-prefixed name they declare. The generated C saves each one before the
 * headers of an `extern import` and restores it after them, so a C header
 * cannot redefine a runtime macro or turn a runtime function into a macro.
 *
 * Usage: grayc scripts/generate_runtime_macros.gray && ./generate_runtime_macros
 *        (run from the repo root)
 *
 * Author:  Marshall A Burns <marshallbcodes@gmail.com>
 * GitHub: @SchoolyB
 * Copyright (c) 2026-Present Marshall A Burns
 * Licensed under the MIT License. See LICENSE for details.
 */

import @io, @strings, @arrays

const OUTPUT string = "grayc/src/codegen/runtime_macros.h"

// is_identifier_character reports whether character can appear in a C identifier.
do is_identifier_character(character char) -> bool {
    return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') ||
           (character >= '0' && character <= '9') || character == '_'
}

// add_name appends name to names when it is new.
do add_name(name string, &names [string]) {
    if !arrays.contains(names, name) {
        arrays.append(names, name)
    }
}

// collect_line adds every identifier on line that the runtime owns: one
// starting with gray, GRAY or Gray, which includes each function, type and
// macro the generated code calls.
do collect_line(line string, &names [string]) {
    mut word string = ""
    for_each character in line {
        if is_identifier_character(character) {
            word = "${word}${character}"
        } otherwise {
            if strings.starts_with(word, "gray") || strings.starts_with(word, "GRAY") || strings.starts_with(word, "Gray") {
                add_name(word, names)
            }
            word = ""
        }
    }
    if strings.starts_with(word, "gray") || strings.starts_with(word, "GRAY") || strings.starts_with(word, "Gray") {
        add_name(word, names)
    }
}

// macro_name returns the name defined by a `#define` line, or "" when the
// line is not a #define.
do macro_name(line string) -> string {
    trimmed string = strings.trim(line)
    if !strings.starts_with(trimmed, "#") {
        return ""
    }
    directive string = strings.trim(strings.remove_prefix(trimmed, "#"))
    if !strings.starts_with(directive, "define ") && !strings.starts_with(directive, "define\t") {
        return ""
    }
    rest string = strings.trim(strings.remove_prefix(directive, "define"))
    mut end i64 = 0
    for_each character in rest {
        if character == ' ' || character == '(' || character == '\t' {
            break
        }
        end += 1
    }
    return strings.slice(rest, 0, end)
}

do collect(directory string, &names [string]) {
    mut entries, list_err = io.list_dir(directory)
    if list_err != nil {
        eprintln("generate_runtime_macros.gray: error: cannot read ${directory}")
        exit(1)
    }
    arrays.sort_asc(entries)
    for_each entry in entries {
        if !strings.ends_with(entry, ".h") {
            continue
        }
        mut lines, read_err = io.read_lines("${directory}/${entry}")
        if read_err != nil {
            eprintln("generate_runtime_macros.gray: error: cannot read ${directory}/${entry}")
            exit(1)
        }
        for_each line in lines {
            name string = macro_name(line)
            if name != "" {
                add_name(name, names)
            }
            collect_line(line, names)
        }
    }
}

do main() {
    mut names [string] = {}
    collect("grayc/src/runtime", names)
    collect("grayc/src/stdlib", names)
    arrays.sort_asc(names)

    mut out [string] = {}
    arrays.append(out, "/* GENERATED by scripts/generate_runtime_macros.gray; do not edit. */")
    arrays.append(out, "")
    arrays.append(out, "#define GRAY_RUNTIME_MACROS(X) \\")
    for i in range(0, len(names)) {
        suffix string = ""
        if i + 1 < len(names) {
            suffix = " \\"
        }
        arrays.append(out, "    X(${names[i]})${suffix}")
    }
    arrays.append(out, "")
    _, write_err = io.write_file(OUTPUT, strings.join(out, "\n"))
    if write_err != nil {
        eprintln("generate_runtime_macros.gray: error: cannot write ${OUTPUT}")
        exit(1)
    }
    println("wrote ${OUTPUT} (${len(names)} macros)")
}
