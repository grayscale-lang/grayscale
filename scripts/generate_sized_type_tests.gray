//
// generate_sized_type_tests.gray - Generate the sized-type test grid
//
// Writes every sized type (i8..i256, u8..u256, f32, f64) at every slot a value
// can be stored into (STANDARD.md, "Sized types") with each case:
//
//   - an in-range literal            (compiles)
//   - an out-of-range literal        (E3036)
//   - a widening value               (compiles)
//   - a narrowing value              (E3155)
//   - a signedness-crossing value    (E3019)
//   - a binary expression with a literal (compiles)
//   - a compound assignment at the type's maximum value (overflow panic)
//   - a shift by a count at and beyond the type's width  (P0092)
//
// A range() bound or step is a slot whose target is i64, u64 when a bound is
// u64, or the widest wide integer type among the range's bounds: each type is stored into the start,
// the end and the step, and into a bound of a range whose other bound is i128.
// A runtime panic file pins its panic code with an expect-contains marker.
//
// into integration-tests/:
//
//   pass/core/sized_grid_<slot>.gray            every case that compiles
//   fail/errors/<code>_sized_grid_<slot>_<case>.gray
//                                               every case expected to fail
//                                               with <code>, one file per code
//   fail/errors/<panic>_sized_grid_<shape>_<type>.gray
//                                               one runtime panic per file
//
// A new slot or sized type is added here, and the grid is regenerated. The
// generated files are checked in; CI runs them like any other test.
//
// Usage: grayc scripts/generate_sized_type_tests.gray && ./generate_sized_type_tests
//        (run from the repo root)
//
// Copyright (c) 2025-Present Marshall A Burns
// Licensed under the MIT License. See LICENSE for details.

import @io, @strings, @arrays

const PASS_DIR string = "integration-tests/pass/core"
const FAIL_DIR string = "integration-tests/fail/errors"
const HEADER_NOTE string = "Generated by scripts/generate_sized_type_tests.gray — do not edit; regenerate."

// --- Type facts ---------------------------------------------------------------
//
// The tables below are parallel to TYPES.

const TYPES [string, 14] = {"i8", "i16", "i32", "i64", "i128", "i256", "u8", "u16", "u32", "u64", "u128", "u256", "f32", "f64"}

const MAX_LITERALS [string, 14] = {
    "127", "32767", "2147483647", "9223372036854775807",
    "170141183460469231731687303715884105727",
    "57896044618658097711785492504343953926634992332820282019728792003956564819967",
    "255", "65535", "4294967295", "18446744073709551615",
    "340282366920938463463374607431768211455",
    "115792089237316195423570985008687907853269984665640564039457584007913129639935",
    "3.0e38", "1.0e308"
}

// A literal one past the type's range: a negative one for an unsigned type,
// max + 1 for a signed one, beyond the float range for a float.
const OVER_LITERALS [string, 14] = {
    "128", "32768", "2147483648", "9223372036854775808",
    "170141183460469231731687303715884105728",
    "57896044618658097711785492504343953926634992332820282019728792003956564819968",
    "-1", "-1", "-1", "-1", "-1", "-1",
    "1.0e39", "1.0e308 * 10.0"
}

// The next narrower / wider type of the same family, or "".
const NARROWER [string, 14] = {"", "i8", "i16", "i32", "i64", "i128", "", "u8", "u16", "u32", "u64", "u128", "", "f32"}
const WIDER [string, 14] = {"i16", "i32", "i64", "i128", "i256", "", "u16", "u32", "u64", "u128", "u256", "", "f64", ""}

// The overflow panic `+` raises for each integer type (the first 12 TYPES).
const OVERFLOW_PANICS [string, 12] = {"P0011", "P0011", "P0011", "P0004", "P0021", "P0027", "P0015", "P0015", "P0015", "P0008", "P0024", "P0030"}

const WIDTHS [i64, 12] = {8, 16, 32, 64, 128, 256, 8, 16, 32, 64, 128, 256}

const INT_TYPE_COUNT i64 = 12

// --- Slots --------------------------------------------------------------------
//
// Each slot stores a value of the target type T.

const SLOTS [string, 23] = {
    "var_decl", "module_var_decl", "reassign", "compound_assign", "array_element", "map_value",
    "map_key", "deref_assign", "field_assign", "struct_literal", "field_default", "default_param",
    "enum_payload", "when_arm", "destructure", "array_literal", "map_literal_key",
    "map_literal_value", "function_arg", "struct_function_arg", "func_value_arg", "return",
    "map_index"
}

// Slots whose target is always i64, whatever the value's type T.
const I64_SLOTS [string, 4] = {"array_index", "string_index", "builtin_arg", "stdlib_arg"}

// range() slots: the start, end and step of an i64 range, and a bound of a
// range whose other bound is i128.
const RANGE_SLOTS [string, 4] = {"range_start", "range_end", "range_step", "range_bound_with_i128"}

const SHAPES [string, 6] = {"variable", "element", "map_value", "field", "deref", "element_through_pointer"}

// Case is one generated function, buffered until its output file is written.
const Case struct {
    path string
    code string
    id string
    text string
}

do table_value(table [string], type_name string) -> string {
    return table[arrays.index_of(TYPES, type_name)]
}

do one(type_name string) -> string {
    if strings.starts_with(type_name, "f") {
        return "1.0"
    }
    return "1"
}

do zero(type_name string) -> string {
    if strings.starts_with(type_name, "f") {
        return "0.0"
    }
    return "0"
}

// other_sign returns the integer type of the same width and the other
// signedness, or "".
do other_sign(type_name string) -> string {
    mut width string = strings.slice(type_name, 1, len(type_name))
    if strings.starts_with(type_name, "i") {
        return "u${width}"
    } or strings.starts_with(type_name, "u") {
        return "i${width}"
    }
    return ""
}

// Slots where the value must be a literal (a constant position).
do literal_only(slot string) -> bool {
    return slot == "field_default" || slot == "default_param" || slot == "when_arm"
}

// slot_case returns one case as Grayscale: any file-scope declarations, then
// `do case_<id>() { ... }`. setup is a statement (or ""), e the value expression.
do slot_case(slot string, id string, t string, setup string, value string) -> string {
    mut z string = zero(t)
    mut e string = value
    if slot == "var_decl" {
        return "do case_${id}() {\n    ${setup}\n    mut v ${t} = ${e}\n    println(v)\n}"
    } or slot == "module_var_decl" {
        mut src_decl string = ""
        if setup != "" {
            src_decl = strings.replace(setup, "src_V", "msrc${id}")
            e = strings.replace(e, "src_V", "msrc${id}")
        }
        return "${src_decl}\nmut g_${id} ${t} = ${e}\ndo case_${id}() {\n    println(g_${id})\n}"
    } or slot == "reassign" {
        return "do case_${id}() {\n    ${setup}\n    mut v ${t} = ${z}\n    v = ${e}\n    println(v)\n}"
    } or slot == "compound_assign" {
        return "do case_${id}() {\n    ${setup}\n    mut v ${t} = ${z}\n    v += ${e}\n    println(v)\n}"
    } or slot == "array_element" {
        return "do case_${id}() {\n    ${setup}\n    mut xs [${t}] = {${z}}\n    xs[0] = ${e}\n    println(xs)\n}"
    } or slot == "map_value" {
        return "do case_${id}() {\n    ${setup}\n    mut m map[string:${t}] = {:}\n    m[\"k\"] = ${e}\n    println(m)\n}"
    } or slot == "map_key" {
        return "do case_${id}() {\n    ${setup}\n    mut m map[${t}:string] = {:}\n    m[${e}] = \"v\"\n    println(len(m))\n}"
    } or slot == "deref_assign" {
        return "do case_${id}() {\n    ${setup}\n    mut x ${t} = ${z}\n    mut p ^${t} = addr(x)\n    p^ = ${e}\n    println(x)\n}"
    } or slot == "field_assign" {
        return "const F${id} struct {\n    f ${t}\n}\ndo case_${id}() {\n    ${setup}\n    mut s F${id} = F${id}{f: ${z}}\n    s.f = ${e}\n    println(s.f)\n}"
    } or slot == "struct_literal" {
        return "const S${id} struct {\n    f ${t}\n}\ndo case_${id}() {\n    ${setup}\n    mut s S${id} = S${id}{f: ${e}}\n    println(s.f)\n}"
    } or slot == "field_default" {
        return "const D${id} struct {\n    f ${t} = ${e}\n}\ndo case_${id}() {\n    mut s D${id} = D${id}{}\n    println(s.f)\n}"
    } or slot == "default_param" {
        return "do take${id}(x ${t} = ${e}) -> ${t} {\n    return x\n}\ndo case_${id}() {\n    println(take${id}())\n}"
    } or slot == "enum_payload" {
        return "const E${id} enum {\n    V(${t})\n    N\n}\ndo case_${id}() {\n    ${setup}\n    mut e E${id} = E${id}.V(${e})\n    when e {\n        is V(x) { println(x) }\n        default { println(\"n\") }\n    }\n}"
    } or slot == "when_arm" {
        return "do case_${id}() {\n    mut w ${t} = ${z}\n    when w {\n        is ${e} { println(\"match\") }\n        default { println(\"default\") }\n    }\n}"
    } or slot == "destructure" {
        // The value's type is the function's result type; e names it. The
        // second position keeps the source type, so each case has exactly one
        // conversion.
        mut v string = one(e)
        return "do two${id}() -> (${e}, ${e}) {\n    return ${v}, ${v}\n}\ndo case_${id}() {\n    mut a ${t}, b ${e} = two${id}()\n    println(a)\n    println(b)\n}"
    } or slot == "array_literal" {
        return "do case_${id}() {\n    ${setup}\n    mut xs [${t}] = {${e}}\n    println(xs)\n}"
    } or slot == "map_literal_key" {
        return "do case_${id}() {\n    ${setup}\n    mut m map[${t}:string] = {${e}: \"v\"}\n    println(len(m))\n}"
    } or slot == "map_literal_value" {
        return "do case_${id}() {\n    ${setup}\n    mut m map[string:${t}] = {\"k\": ${e}}\n    println(m)\n}"
    } or slot == "function_arg" {
        return "do take${id}(x ${t}) {\n    println(x)\n}\ndo case_${id}() {\n    ${setup}\n    take${id}(${e})\n}"
    } or slot == "struct_function_arg" {
        return "const H${id} struct {\n    n i64\n\n    do take(x ${t}) {\n        println(x)\n    }\n}\ndo case_${id}() {\n    ${setup}\n    H${id}.take(${e})\n}"
    } or slot == "func_value_arg" {
        return "do show${id}(x ${t}) {\n    println(x)\n}\ndo run${id}(g func(${t})) {\n    ${setup}\n    g(${e})\n}\ndo case_${id}() {\n    run${id}(()show${id})\n}"
    } or slot == "return" {
        return "do give${id}() -> ${t} {\n    ${setup}\n    return ${e}\n}\ndo case_${id}() {\n    println(give${id}())\n}"
    } or slot == "map_index" {
        return "do case_${id}() {\n    ${setup}\n    mut m map[${t}:string] = {${z}: \"v\"}\n    if len(m) > 5 {\n        println(m[${e}])\n    }\n}"
    } or slot == "array_index" {
        return "do case_${id}() {\n    ${setup}\n    mut xs [i64] = {7, 8}\n    println(xs[${e}])\n}"
    } or slot == "string_index" {
        return "do case_${id}() {\n    ${setup}\n    mut s string = \"ab\"\n    println(s[${e}])\n}"
    } or slot == "builtin_arg" {
        return "do case_${id}() {\n    ${setup}\n    sleep_ns(${e})\n}"
    } or slot == "stdlib_arg" {
        return "do case_${id}() {\n    ${setup}\n    println(fmt.i64_to_binary(${e}))\n}"
    }

    // range_start, range_end, range_step and range_bound_with_i128
    mut bounds string = "${e}, i128(3)"
    if slot == "range_start" {
        bounds = "${e}, 3"
    } or slot == "range_end" {
        bounds = "0, ${e}"
    } or slot == "range_step" {
        bounds = "0, 3, ${e}"
    }
    return "do case_${id}() {\n    ${setup}\n    for i in range(${bounds}) {\n        println(i)\n    }\n}"
}

// --- Expected outcomes ----------------------------------------------------------

// i64_slot_outcome returns the code a value of type s stored into the i64
// slot gets, or "ok".
do i64_slot_outcome(slot string, s string) -> string {
    if s == "u64" {
        return "E3019"
    } or s == "i128" || s == "i256" || s == "u128" || s == "u256" {
        return "E3155"
    } or s == "f32" || s == "f64" {
        if slot == "array_index" || slot == "string_index" {
            return "E3003"
        }
        return "E5026"
    }
    return "ok"
}

// range_slot_outcome returns the code a value of type s stored into a range
// slot gets, or "ok". An integer widens into i64, or makes the range u64 or
// wide; a u128 or u256 crosses signedness against an i128 bound.
do range_slot_outcome(slot string, s string) -> string {
    if s == "f32" || s == "f64" {
        return "E5026"
    } or s == "u128" || s == "u256" {
        if slot == "range_bound_with_i128" {
            return "E3019"
        }
    }
    return "ok"
}

// --- Generation --------------------------------------------------------------------

// make_case builds one case; the pass file is per slot, the fail file per
// code, slot and label.
do make_case(slot string, outcome string, label string, t string, setup string, e string, id i64) -> Case {
    mut id_text string = "${id}"
    mut path string = "${PASS_DIR}/sized_grid_${slot}.gray"
    if outcome != "ok" {
        path = "${FAIL_DIR}/${outcome}_sized_grid_${slot}_${label}.gray"
    }
    return Case{path: path, code: outcome, id: id_text, text: slot_case(slot, id_text, t, setup, e)}
}

do write_file_or_exit(path string, content string) {
    mut _, write_err = io.write_file(path, content)
    if write_err != nil {
        eprintln("generate_sized_type_tests.gray: error: cannot write ${path}")
        exit(1)
    }
}

do main() {
    mut stale_pass, pass_err = io.list_dir(PASS_DIR)
    mut stale_fail, fail_err = io.list_dir(FAIL_DIR)
    if pass_err != nil || fail_err != nil {
        eprintln("generate_sized_type_tests.gray: error: run from the repo root")
        exit(1)
    }
    for_each name in stale_pass {
        if strings.starts_with(name, "sized_grid_") && strings.ends_with(name, ".gray") {
            mut _, _ = io.delete_file("${PASS_DIR}/${name}")
        }
    }
    for_each name in stale_fail {
        if strings.contains(name, "_sized_grid_") && strings.ends_with(name, ".gray") {
            mut _, _ = io.delete_file("${FAIL_DIR}/${name}")
        }
    }

    mut cases [Case] = {}

    for_each slot in SLOTS {
        for_each t in TYPES {
            mut narrower string = table_value(NARROWER, t)
            mut wider string = table_value(WIDER, t)
            mut crossed string = other_sign(t)
            if slot == "destructure" {
                if narrower != "" {
                    arrays.append(cases, make_case(slot, "ok", "widening", t, "", narrower, len(cases) + 1))
                }
                if wider != "" {
                    arrays.append(cases, make_case(slot, "E3155", "narrowing", t, "", wider, len(cases) + 1))
                }
                if crossed != "" {
                    arrays.append(cases, make_case(slot, "E3019", "sign_crossing", t, "", crossed, len(cases) + 1))
                }
                continue
            }
            arrays.append(cases, make_case(slot, "ok", "in_range", t, "", table_value(MAX_LITERALS, t), len(cases) + 1))
            // map keys of a float type are allowed, but only an integer is a
            // sensible when arm or index
            if !(slot == "when_arm" && strings.starts_with(t, "f")) {
                arrays.append(cases, make_case(slot, "E3036", "out_of_range", t, "", table_value(OVER_LITERALS, t), len(cases) + 1))
            }
            if literal_only(slot) {
                continue
            }
            if narrower != "" {
                arrays.append(cases, make_case(slot, "ok", "widening", t, "mut src_V ${narrower} = ${one(narrower)}", "src_V", len(cases) + 1))
            }
            if wider != "" {
                arrays.append(cases, make_case(slot, "E3155", "narrowing", t, "mut src_V ${wider} = ${one(wider)}", "src_V", len(cases) + 1))
            }
            if crossed != "" {
                arrays.append(cases, make_case(slot, "E3019", "sign_crossing", t, "mut src_V ${crossed} = ${one(crossed)}", "src_V", len(cases) + 1))
            }
            arrays.append(cases, make_case(slot, "ok", "binary", t, "mut src_V ${t} = ${one(t)}", "src_V + ${one(t)}", len(cases) + 1))
        }
    }

    for_each slot in I64_SLOTS {
        arrays.append(cases, make_case(slot, "ok", "in_range", "i64", "", "0", len(cases) + 1))
        arrays.append(cases, make_case(slot, "E3036", "out_of_range", "i64", "", "9223372036854775808", len(cases) + 1))
        for_each s in TYPES {
            mut outcome string = i64_slot_outcome(slot, s)
            mut label string = "value_${outcome}"
            if outcome == "ok" {
                label = "value"
            }
            arrays.append(cases, make_case(slot, outcome, label, s, "mut src_V ${s} = ${zero(s)}", "src_V", len(cases) + 1))
        }
    }

    for_each slot in RANGE_SLOTS {
        arrays.append(cases, make_case(slot, "ok", "in_range", "i64", "", "1", len(cases) + 1))
        if slot != "range_bound_with_i128" {
            arrays.append(cases, make_case(slot, "E3036", "out_of_range", "i64", "", "9223372036854775808", len(cases) + 1))
        }
        for_each s in TYPES {
            mut outcome string = range_slot_outcome(slot, s)
            mut label string = "value_${outcome}"
            if outcome == "ok" {
                label = "value"
            }
            arrays.append(cases, make_case(slot, outcome, label, s, "mut src_V ${s} = ${one(s)}", "src_V", len(cases) + 1))
        }
    }

    // Group the cases by output file, in first-seen order.
    mut paths [string] = {}
    mut codes [string] = {}
    mut bodies [string] = {}
    mut calls [string] = {}
    mut counts [i64] = {}
    for_each c in cases {
        mut index i64 = arrays.index_of(paths, c.path)
        if index == -1 {
            arrays.append(paths, c.path)
            arrays.append(codes, c.code)
            arrays.append(bodies, "")
            arrays.append(calls, "")
            arrays.append(counts, 0)
            index = len(paths) - 1
        }
        bodies[index] = "${bodies[index]}${c.text}\n"
        calls[index] = "${calls[index]}    case_${c.id}()\n"
        counts[index] = counts[index] + 1
    }

    mut pass_files i64 = 0
    mut fail_files i64 = 0
    mut p i64 = 0
    for p < len(paths) {
        mut out string = "// ${HEADER_NOTE}\n"
        if codes[p] != "ok" {
            out = "${out}// expect-error: ${codes[p]}\n// expect-error-count: ${counts[p]}\n"
            fail_files = fail_files + 1
        } otherwise {
            pass_files = pass_files + 1
        }
        out = "${out}\n"
        if strings.contains(paths[p], "stdlib_arg") {
            out = "${out}import @fmt\n\n"
        }
        out = "${out}${strings.replace(bodies[p], "src_V", "src")}\ndo main() {\n${calls[p]}}\n"
        write_file_or_exit(paths[p], out)
        p = p + 1
    }

    // --- Runtime cases ------------------------------------------------------------

    // A compound assignment at the type's maximum, for every shape of target.
    for_each shape in SHAPES {
        mut i i64 = 0
        for i < INT_TYPE_COUNT {
            mut t string = TYPES[i]
            mut code string = OVERFLOW_PANICS[i]
            mut max string = MAX_LITERALS[i]
            mut out string = "// ${HEADER_NOTE}\n// expect-contains: panic[${code}]\n\n"
            if shape == "field" {
                out = "${out}const Box struct {\n    f ${t}\n}\n\n"
            }
            out = "${out}do main() {\n"
            if shape == "variable" {
                out = "${out}    mut v ${t} = ${max}\n    v += 1\n    println(v)\n"
            } or shape == "element" {
                out = "${out}    mut xs [${t}] = {${max}}\n    xs[0] += 1\n    println(xs)\n"
            } or shape == "map_value" {
                out = "${out}    mut m map[string:${t}] = {\"k\": ${max}}\n    m[\"k\"] += 1\n    println(m)\n"
            } or shape == "field" {
                out = "${out}    mut b Box = Box{f: ${max}}\n    b.f += 1\n    println(b.f)\n"
            } or shape == "deref" {
                out = "${out}    mut x ${t} = ${max}\n    mut p ^${t} = addr(x)\n    p^ += 1\n    println(x)\n"
            } otherwise {
                out = "${out}    mut xs [${t}] = {${max}}\n    mut p ^[${t}] = addr(xs)\n    p^[0] += 1\n    println(xs)\n"
            }
            out = "${out}}\n"
            write_file_or_exit("${FAIL_DIR}/${code}_sized_grid_compound_max_${shape}_${t}.gray", out)
            fail_files = fail_files + 1
            i = i + 1
        }
    }

    // A shift by a count at, and beyond, the type's width.
    mut j i64 = 0
    for j < INT_TYPE_COUNT {
        mut t string = TYPES[j]
        mut width i64 = WIDTHS[j]
        for_each which in {"at", "beyond"} {
            mut count i64 = width
            if which == "beyond" {
                count = width + 1
            }
            write_file_or_exit("${FAIL_DIR}/P0092_sized_grid_shift_${which}_width_${t}.gray",
                "// ${HEADER_NOTE}\n// expect-contains: panic[P0092]\n\ndo main() {\n    mut v ${t} = 1\n    mut n i64 = ${count}\n    println(v bit_shift_left n)\n}\n")
            fail_files = fail_files + 1
        }
        j = j + 1
    }

    println("generate_sized_type_tests.gray: wrote ${pass_files} pass and ${fail_files} fail files")
}
