/*
 * json_struct_roundtrip.gray - #json struct serialization covers every
 * supported primitive field type (i64, u64, f64, string, bool) through
 * both json.stringify and json.parse.
 */

import @json

#json
const Record struct {
    id i64
    count u64
    ratio f64
    label string
    active bool
}

do main() {
    println("=== #json Struct Roundtrip Tests ===")
    mut passed i64 = 0
    mut failed i64 = 0

    mut r Record = Record{id: -7, count: 42, ratio: 1.5, label: "hello", active: true}
    mut js string = json.stringify(r)

    if js == "{\"id\": -7, \"count\": 42, \"ratio\": 1.5, \"label\": \"hello\", \"active\": true}" {
        println("  [PASS] stringify all primitive field types")
        passed += 1
    } otherwise {
        println("  [FAIL] stringify: got ${js}")
        failed += 1
    }

    mut back Record = json.parse(js)
    if back.id == -7 {
        println("  [PASS] parse i64 field")
        passed += 1
    } otherwise {
        println("  [FAIL] parse i64 field: ${back.id}")
        failed += 1
    }
    if back.count == 42 {
        println("  [PASS] parse u64 field")
        passed += 1
    } otherwise {
        println("  [FAIL] parse u64 field: ${back.count}")
        failed += 1
    }
    if back.ratio == 1.5 {
        println("  [PASS] parse f64 field")
        passed += 1
    } otherwise {
        println("  [FAIL] parse f64 field: ${back.ratio}")
        failed += 1
    }
    if back.label == "hello" {
        println("  [PASS] parse string field")
        passed += 1
    } otherwise {
        println("  [FAIL] parse string field: ${back.label}")
        failed += 1
    }
    if back.active {
        println("  [PASS] parse bool field")
        passed += 1
    } otherwise {
        println("  [FAIL] parse bool field")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        panic("SOME TESTS FAILED")
    }
    println("ALL TESTS PASSED")
}
