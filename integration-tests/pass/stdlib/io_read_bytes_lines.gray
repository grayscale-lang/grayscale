/*
 * Test: io module read_bytes, read_lines, file_size_result, glob_result,
 *       and O_RDONLY/O_WRONLY/O_RDWR constants
 */

import @io

do main() {
    mut passed int = 0
    mut failed int = 0

    mut test_file string = "/tmp/gray_io_readtest.txt"
    mut _, _ = io.write_file(test_file, "line1\nline2\nline3")

    // Test 1: read_bytes returns correct byte count
    mut byte_data, _ = io.read_bytes(test_file)
    if len(byte_data) == 17 {
        println("  [PASS] read_bytes: correct byte count (17)")
        passed += 1
    } otherwise {
        println("  [FAIL] read_bytes: expected 17 bytes, got ${len(byte_data)}")
        failed += 1
    }

    // Test 2: read_bytes_result success
    mut bdata, berr = io.read_bytes(test_file)
    if berr == nil {
        println("  [PASS] read_bytes_result: no error on valid file")
        passed += 1
    } otherwise {
        println("  [FAIL] read_bytes_result: unexpected error")
        failed += 1
    }

    // Test 3: read_bytes_result error on nonexistent file
    mut bdata2, berr2 = io.read_bytes("/tmp/gray_nonexistent_bytes.txt")
    if berr2 != nil {
        println("  [PASS] read_bytes_result: error on nonexistent file")
        passed += 1
    } otherwise {
        println("  [FAIL] read_bytes_result: expected error on nonexistent file")
        failed += 1
    }

    // Test 4: read_lines returns correct line count
    mut lines, _ = io.read_lines(test_file)
    if len(lines) == 3 {
        println("  [PASS] read_lines: 3 lines")
        passed += 1
    } otherwise {
        println("  [FAIL] read_lines: expected 3 lines, got ${len(lines)}")
        failed += 1
    }

    // Test 5: read_lines line content is correct
    if lines[0] == "line1" {
        println("  [PASS] read_lines: first line correct")
        passed += 1
    } otherwise {
        println("  [FAIL] read_lines: first line expected \"line1\", got \"${lines[0]}\"")
        failed += 1
    }

    // Test 6: read_lines_result success
    mut ldata, lerr = io.read_lines(test_file)
    if lerr == nil {
        println("  [PASS] read_lines_result: no error on valid file")
        passed += 1
    } otherwise {
        println("  [FAIL] read_lines_result: unexpected error")
        failed += 1
    }

    // Test 7: read_lines_result error on nonexistent file
    mut ldata2, lerr2 = io.read_lines("/tmp/gray_nonexistent_lines.txt")
    if lerr2 != nil {
        println("  [PASS] read_lines_result: error on nonexistent file")
        passed += 1
    } otherwise {
        println("  [FAIL] read_lines_result: expected error on nonexistent file")
        failed += 1
    }

    // Test 8: file_size_result success
    mut sz, szerr = io.file_size(test_file)
    if szerr == nil {
        println("  [PASS] file_size_result: no error on valid file")
        passed += 1
    } otherwise {
        println("  [FAIL] file_size_result: unexpected error")
        failed += 1
    }

    // Test 9: file_size_result correct size
    if sz == 17 {
        println("  [PASS] file_size_result: correct size (17)")
        passed += 1
    } otherwise {
        println("  [FAIL] file_size_result: expected 17, got ${sz}")
        failed += 1
    }

    // Test 10: file_size_result error on nonexistent
    mut sz2, szerr2 = io.file_size("/tmp/gray_nonexistent_size.txt")
    if szerr2 != nil {
        println("  [PASS] file_size_result: error on nonexistent file")
        passed += 1
    } otherwise {
        println("  [FAIL] file_size_result: expected error on nonexistent file, got ${sz2}")
        failed += 1
    }

    // Test 11: glob_result finds files
    mut gfiles, gerr = io.glob("/tmp/gray_io_readtest*")
    if gerr == nil {
        println("  [PASS] glob_result: no error on valid pattern")
        passed += 1
    } otherwise {
        println("  [FAIL] glob_result: unexpected error")
        failed += 1
    }

    // Test 12: glob_result returns matches
    if len(gfiles) > 0 {
        println("  [PASS] glob_result: found matches")
        passed += 1
    } otherwise {
        println("  [FAIL] glob_result: expected at least 1 match")
        failed += 1
    }

    // Test 13: io.O_RDONLY is the OpenFlag enum, equal to OpenFlag.O_RDONLY
    mut rdonly OpenFlag = io.O_RDONLY
    if rdonly == OpenFlag.O_RDONLY {
        println("  [PASS] io.O_RDONLY == OpenFlag.O_RDONLY")
        passed += 1
    } otherwise {
        println("  [FAIL] io.O_RDONLY")
        failed += 1
    }

    // Test 14: OpenFlag variants are distinct
    if io.O_WRONLY != io.O_RDONLY && io.O_WRONLY != io.O_RDWR {
        println("  [PASS] OpenFlag variants distinct")
        passed += 1
    } otherwise {
        println("  [FAIL] OpenFlag variants not distinct")
        failed += 1
    }

    // Test 15: OpenFlag matched with when
    mut mode string = ""
    when io.O_RDWR {
        is .O_RDONLY { mode = "r" }
        is .O_WRONLY { mode = "w" }
        is .O_RDWR   { mode = "rw" }
        default      { mode = "?" }
    }
    if mode == "rw" {
        println("  [PASS] when over OpenFlag")
        passed += 1
    } otherwise {
        println("  [FAIL] when over OpenFlag: got ${mode}")
        failed += 1
    }

    // Test 16: temp_dir / temp_file return usable non-empty paths
    mut tdir string, tderr = io.temp_dir()
    mut tfile string, tferr = io.temp_file()
    if tderr == nil && tferr == nil && len(tdir) > 0 && len(tfile) > 0 {
        println("  [PASS] temp_dir / temp_file")
        passed += 1
    } otherwise {
        println("  [FAIL] temp_dir / temp_file")
        failed += 1
    }

    // Test 17: write_bytes then append_bytes, read back the full contents
    mut bin_file string = "${tdir}/gray_io_bytes.bin"
    mut w_ok bool, werr = io.write_bytes(bin_file, {72, 105})
    mut a_ok bool, aerr = io.append_bytes(bin_file, {33})
    mut round [byte], rerr = io.read_bytes(bin_file)
    if werr == nil && aerr == nil && rerr == nil &&
       w_ok && a_ok && len(round) == 3 && round[0] == 72 && round[2] == 33 {
        println("  [PASS] write_bytes / append_bytes")
        passed += 1
    } otherwise {
        println("  [FAIL] write_bytes / append_bytes")
        failed += 1
    }
    mut _, _ = io.delete_file(bin_file)

    // Cleanup
    mut _, _ = io.delete_file(test_file)

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
