import @net

do main() {
    mut pass int = 0
    mut fail int = 0

    // Bind to localhost only using the host parameter
    mut listener, err = net.listen("127.0.0.1", 0)
    if err == nil { pass += 1 } otherwise { fail += 1 }
    net.close(listener)

    // Second explicit-host bind, also loopback: binding 0.0.0.0 here would
    // trigger a firewall prompt on Windows and macOS on every suite run.
    mut listener2, err2 = net.listen("127.0.0.1", 0)
    if err2 == nil { pass += 1 } otherwise { fail += 1 }
    net.close(listener2)

    println("net.listen host: ${pass} passed, ${fail} failed")
    if fail > 0 { exit(1) }
    println("ALL TESTS PASSED")
}
