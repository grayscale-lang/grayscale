/*
 * mem.alloc copies the whole value into the arena. Strings, arrays && maps
 * inside it must not keep pointing into the scope that built them (#3220).
 */

import @mem
import @strings

const Box struct {
    name string
}

const Bag struct {
    items [i64]
}

const Outer struct {
    inner Box
    tags [string]
    counts map[string:i64]
}

unsafe do make_box(a mem.Arena, n i64) -> ^Box {
    mut s string = strings.repeat("name", 2) + "${n}"
    return mem.alloc(a, Box{name: s})
}

unsafe do make_array(a mem.Arena, n i64) -> ^[i64] {
    mut xs [i64] = {n, n + 10}
    return mem.alloc(a, xs)
}

unsafe do make_map(a mem.Arena, n i64) -> ^map[string:i64] {
    mut m map[string:i64] = {"k": n}
    return mem.alloc(a, m)
}

unsafe do make_bag(a mem.Arena, n i64) -> ^Bag {
    mut xs [i64] = {n, n + 10}
    return mem.alloc(a, Bag{items: xs})
}

unsafe do make_outer(a mem.Arena, n i64) -> ^Outer {
    mut s string = strings.repeat("t", 2) + "${n}"
    mut tags [string] = {s}
    mut counts map[string:i64] = {"c": n}
    return mem.alloc(a, Outer{inner: Box{name: s}, tags: tags, counts: counts})
}

unsafe do main() {
    mut passed i64 = 0
    mut a = mem.arena(65536)

    mut b0 = make_box(a, 0)
    mut b1 = make_box(a, 1)
    if b0^.name == "namename0" && b1^.name == "namename1" {
        println("  [PASS] struct with string field")
        passed += 1
    } otherwise {
        println("  [FAIL] string field: ${b0^.name} ${b1^.name}")
    }

    mut a0 = make_array(a, 0)
    mut a1 = make_array(a, 1)
    if a0^[0] == 0 && a0^[1] == 10 && a1^[0] == 1 && a1^[1] == 11 {
        println("  [PASS] array")
        passed += 1
    } otherwise {
        println("  [FAIL] array")
    }

    mut m0 = make_map(a, 0)
    mut m1 = make_map(a, 1)
    if m0^["k"] == 0 && m1^["k"] == 1 {
        println("  [PASS] map")
        passed += 1
    } otherwise {
        println("  [FAIL] map")
    }

    mut g0 = make_bag(a, 0)
    mut g1 = make_bag(a, 1)
    if g0^.items[0] == 0 && g1^.items[0] == 1 {
        println("  [PASS] struct with array field")
        passed += 1
    } otherwise {
        println("  [FAIL] array field")
    }

    mut o0 = make_outer(a, 0)
    mut o1 = make_outer(a, 1)
    if o0^.inner.name == "tt0" && o1^.inner.name == "tt1" && o0^.tags[0] == "tt0" && o1^.tags[0] == "tt1" && o0^.counts["c"] == 0 && o1^.counts["c"] == 1 {
        println("  [PASS] nested struct, [string] and map fields")
        passed += 1
    } otherwise {
        println("  [FAIL] nested")
    }
    mem.destroy(a)

    println("Results: ${passed} passed")
    if passed == 5 {
        println("ALL TESTS PASSED")
    } otherwise {
        println("SOME TESTS FAILED")
    }
}
