/*
 * Test: chars module - scalar ASCII case folding and Unicode display width
 * Verifies chars.to_upper / chars.to_lower fold ASCII letters and pass
 * everything else through, and chars.width / chars.string_width follow
 * wcwidth semantics (normal, wide, zero-width, control).
 */

import and use @chars

do check(label string, got char, want char) -> int {
    if got == want {
        println("  [PASS] ${label}")
        return 1
    }
    println("  [FAIL] ${label}: got '${got}' want '${want}'")
    return 0
}

do check_int(label string, got int, want int) -> int {
    if got == want {
        println("  [PASS] ${label}")
        return 1
    }
    println("  [FAIL] ${label}: got ${got} want ${want}")
    return 0
}

do main() {
    mut passed int = 0

    // ASCII letters fold
    passed += check("to_upper('a')", chars.to_upper('a'), 'A')
    passed += check("to_upper('z')", chars.to_upper('z'), 'Z')
    passed += check("to_lower('Z')", chars.to_lower('Z'), 'z')
    passed += check("to_lower('A')", chars.to_lower('A'), 'a')

    // already-cased is a no-op
    passed += check("to_upper('A')", chars.to_upper('A'), 'A')
    passed += check("to_lower('a')", chars.to_lower('a'), 'a')

    // digits pass through
    passed += check("to_upper('5')", chars.to_upper('5'), '5')
    passed += check("to_lower('9')", chars.to_lower('9'), '9')

    // symbols and whitespace pass through
    passed += check("to_lower('#')", chars.to_lower('#'), '#')
    passed += check("to_upper(' ')", chars.to_upper(' '), ' ')

    // non-ASCII codepoint passes through unchanged
    mut hi char = char(0xC3)
    passed += check("to_upper(0xC3)", chars.to_upper(hi), hi)
    mut hi2 char = char(0xFF)
    passed += check("to_lower(0xFF)", chars.to_lower(hi2), hi2)

    // bare-call form after `import and use`
    passed += check("bare to_upper('q')", to_upper('q'), 'Q')
    passed += check("bare to_lower('Q')", to_lower('Q'), 'q')

    // chars.width — wcwidth semantics
    passed += check_int("width('A') is 1 (normal)", chars.width('A'), 1)
    passed += check_int("width('中') is 2 (CJK, wide)", chars.width('中'), 2)
    mut combining char = char(0x301) // COMBINING ACUTE ACCENT
    passed += check_int("width(U+0301) is 0 (combining mark)", chars.width(combining), 0)
    passed += check_int("width('\\n') is -1 (control)", chars.width('\n'), -1)

    // chars.string_width — sums width() over codepoints, control chars count as 0
    passed += check_int("string_width(\"café\") is 4", chars.string_width("café"), 4)
    passed += check_int("string_width(\"中文\") is 4 (two wide chars)", chars.string_width("中文"), 4)
    passed += check_int("string_width mixed ASCII+CJK+control", chars.string_width("hi 中\t"), 5)

    println("")
    println("Results: ${passed}/21 passed")
    if passed == 21 {
        println("ALL TESTS PASSED")
    } otherwise {
        println("SOME TESTS FAILED")
        exit(1)
    }
}
