/*
 * mem_c.gray - Integration test for @mem (compiler)
 */

import @mem

do main() {
    println("=== Mem Module Test ===")
    mut passed int = 0
    mut failed int = 0

    // arena(size) returns a pointer
    mut arena = mem.arena(1024)
    println("  [PASS] arena created")
    passed += 1

    // usage returns >= 0
    mut usage int = mem.usage(arena)
    if usage >= 0 {
        println("  [PASS] usage (${usage})")
        passed += 1
    } otherwise {
        println("  [FAIL] usage: got ${usage}")
        failed += 1
    }

    // reset doesn't crash (void)
    mem.reset(arena)
    println("  [PASS] reset")
    passed += 1

    // usage after reset
    mut usage_after int = mem.usage(arena)
    if usage_after >= 0 {
        println("  [PASS] usage after reset (${usage_after})")
        passed += 1
    } otherwise {
        println("  [FAIL] usage after reset: got ${usage_after}")
        failed += 1
    }

    // destroy doesn't crash (void)
    mem.destroy(arena)
    println("  [PASS] destroy")
    passed += 1

    // raw byte ops on scalar storage
    mut z int = 123456789
    mem.zero(addr(z), 8)
    if z == 0 {
        println("  [PASS] zero")
        passed += 1
    } otherwise {
        println("  [FAIL] zero: got ${z}")
        failed += 1
    }

    mut fbyte int = 0
    mem.fill(addr(fbyte), 0xFF, 1)
    if fbyte == 255 {
        println("  [PASS] fill")
        passed += 1
    } otherwise {
        println("  [FAIL] fill: got ${fbyte}")
        failed += 1
    }

    mut cp_src int = 777
    mut cp_dst int = 0
    mem.raw_copy(addr(cp_dst), addr(cp_src), 8)
    if cp_dst == 777 {
        println("  [PASS] raw_copy")
        passed += 1
    } otherwise {
        println("  [FAIL] raw_copy: got ${cp_dst}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        panic("Some tests failed!")
    }
    println("ALL TESTS PASSED")
}
