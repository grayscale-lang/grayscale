/*
 * net_c.gray - Integration test for @net (compiler)
 */

import @net

do main() {
    mut pass int = 0
    mut fail int = 0

    // DNS resolve
    mut ip, _ = net.resolve("localhost")
    if ip == "127.0.0.1" { pass += 1 } otherwise { fail += 1 }

    // TCP listen and close (port 0 = any available). Loopback bind: listening
    // on all interfaces triggers a firewall prompt on Windows and macOS.
    mut listener, _ = net.listen("127.0.0.1", 0)
    net.close(listener)
    pass += 1

    println("net: ${pass} passed, ${fail} failed")
    if fail > 0 { exit(1) }
    println("ALL TESTS PASSED")
}
