/*
 * Test: a NaN in an [f64] orders after every other value wherever it sits
 */

import @arrays
import @strconv
import @math

do main() {
    mut pass i64 = 0
    mut fail i64 = 0
    mut nan, _ = strconv.to_f64("nan")

    mut first [f64] = {nan, 3.0, 1.0, 2.0}
    mut inner [f64] = {3.0, 1.0, 2.0, nan, 0.5}
    mut desc [f64] = {3.0, nan, 1.0, 2.0}

    if arrays.get_min(first) == 1.0 && arrays.min_index(first) == 2 { pass += 1 } otherwise { fail += 1 }
    if math.is_nan(arrays.get_max(first)) && arrays.max_index(first) == 0 { pass += 1 } otherwise { fail += 1 }

    arrays.sort_asc(first)
    if first[0] == 1.0 && first[1] == 2.0 && first[2] == 3.0 && math.is_nan(first[3]) && arrays.is_sorted(first) { pass += 1 } otherwise { fail += 1 }

    arrays.sort_asc(inner)
    if inner[0] == 0.5 && inner[1] == 1.0 && inner[2] == 2.0 && inner[3] == 3.0 && math.is_nan(inner[4]) { pass += 1 } otherwise { fail += 1 }
    if arrays.get_min(inner) == 0.5 { pass += 1 } otherwise { fail += 1 }

    arrays.sort_desc(desc)
    if math.is_nan(desc[0]) && desc[1] == 3.0 && desc[2] == 2.0 && desc[3] == 1.0 { pass += 1 } otherwise { fail += 1 }

    println("arrays_nan_ordering: ${pass} passed, ${fail} failed")
    if fail > 0 { exit(1) }
    println("ALL TESTS PASSED")
}
