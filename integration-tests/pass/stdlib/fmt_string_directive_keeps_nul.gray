/*
 * Test: a %s of a string argument keeps the bytes after an embedded NUL.
 */
import @fmt

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut s string = "ab\0cd"
    if len(fmt.sprintf("%s", {s})) == 5 && len(fmt.sprintf("x%sy", {s})) == 7 {
        passed += 1
    } otherwise {
        println("[FAIL] sprintf %s length")
        failed += 1
    }

    if len(fmt.sprintf("%.4s", {s})) == 4 && len(fmt.sprintf("%8s", {s})) == 8 && len(fmt.sprintf("%-8s|", {s})) == 9 {
        passed += 1
    } otherwise {
        println("[FAIL] sprintf width and precision")
        failed += 1
    }

    mut values [string] = {"a\0b", "c"}
    if fmt.sprintf("%s-%s!%d", {values[0], values[1], 7}) == "a\0b-c!7" {
        passed += 1
    } otherwise {
        println("[FAIL] sprintf mixed arguments")
        failed += 1
    }

    fmt.printf("[%s]\n", {s})

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
