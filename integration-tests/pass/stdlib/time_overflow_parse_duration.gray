import @time

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut seconds, seconds_error = time.parse_duration("9223372036854775808s")
    if seconds == 0 && seconds_error != nil { passed += 1 } otherwise { failed += 1 }

    mut hours, hours_error = time.parse_duration("9223372036854775807h")
    if hours == 0 && hours_error != nil { passed += 1 } otherwise { failed += 1 }

    mut valid, valid_error = time.parse_duration("1h30m")
    if valid == 5400 && valid_error == nil { passed += 1 } otherwise { failed += 1 }

    println("passed: ${passed}, failed: ${failed}")
}
