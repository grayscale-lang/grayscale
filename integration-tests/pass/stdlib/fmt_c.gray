/*
 * fmt_c.gray - Comprehensive integration test for @fmt (compiler)
 * Tests all implemented fmt module functions.
 * NOT IMPLEMENTED: printf, sprintf, format
 */

import @fmt

do main() {
    println("=== Fmt Module Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // pad_left
    mut zero_ch char = '0'
    mut pl string = fmt.pad_left("hi", 5, zero_ch)
    if pl == "000hi" {
        println("  [PASS] pad_left")
        passed += 1
    } otherwise {
        println("  [FAIL] pad_left: expected '000hi', got '${pl}'")
        failed += 1
    }

    // pad_right
    mut dot_ch char = '.'
    mut pr string = fmt.pad_right("hi", 5, dot_ch)
    if pr == "hi..." {
        println("  [PASS] pad_right")
        passed += 1
    } otherwise {
        println("  [FAIL] pad_right: expected 'hi...', got '${pr}'")
        failed += 1
    }

    // center
    mut dash_ch char = '-'
    mut ct string = fmt.center("hi", 6, dash_ch)
    if ct == "--hi--" {
        println("  [PASS] center")
        passed += 1
    } otherwise {
        println("  [FAIL] center: expected '--hi--', got '${ct}'")
        failed += 1
    }

    // pad_left/pad_right/center with a non-ASCII (2-u8 UTF-8) pad char
    mut e_ch char = char(233)
    mut pl_utf8 string = fmt.pad_left("hi", 4, e_ch)
    mut pr_utf8 string = fmt.pad_right("hi", 4, e_ch)
    mut ct_utf8 string = fmt.center("hi", 4, e_ch)
    if pl_utf8 == "ééhi" && len(pl_utf8) == 6 &&
       pr_utf8 == "hiéé" && len(pr_utf8) == 6 &&
       ct_utf8 == "éhié" && len(ct_utf8) == 6 {
        println("  [PASS] pad_left/pad_right/center with non-ASCII pad char")
        passed += 1
    } otherwise {
        println("  [FAIL] non-ASCII pad char: got '${pl_utf8}' (${len(pl_utf8)}), '${pr_utf8}' (${len(pr_utf8)}), '${ct_utf8}' (${len(ct_utf8)})")
        failed += 1
    }

    // i64_to_hex
    mut hex_val string = fmt.i64_to_hex(255)
    if hex_val == "ff" {
        println("  [PASS] i64_to_hex")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_hex: expected 'ff', got '${hex_val}'")
        failed += 1
    }

    // i64_to_hex - zero
    mut hex_zero string = fmt.i64_to_hex(0)
    if hex_zero == "0" {
        println("  [PASS] i64_to_hex (zero)")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_hex (zero): expected '0', got '${hex_zero}'")
        failed += 1
    }

    // i64_to_hex - large number
    mut hex_large string = fmt.i64_to_hex(256)
    if hex_large == "100" {
        println("  [PASS] i64_to_hex (256)")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_hex (256): expected '100', got '${hex_large}'")
        failed += 1
    }

    // i64_to_binary
    mut bin_val string = fmt.i64_to_binary(10)
    if bin_val == "1010" {
        println("  [PASS] i64_to_binary")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_binary: expected '1010', got '${bin_val}'")
        failed += 1
    }

    // i64_to_binary - 1
    mut bin_one string = fmt.i64_to_binary(1)
    if bin_one == "1" {
        println("  [PASS] i64_to_binary (1)")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_binary (1): expected '1', got '${bin_one}'")
        failed += 1
    }

    // i64_to_octal
    mut oct_val string = fmt.i64_to_octal(8)
    if oct_val == "10" {
        println("  [PASS] i64_to_octal")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_octal: expected '10', got '${oct_val}'")
        failed += 1
    }

    // i64_to_octal - 7
    mut oct_seven string = fmt.i64_to_octal(7)
    if oct_seven == "7" {
        println("  [PASS] i64_to_octal (7)")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_octal (7): expected '7', got '${oct_seven}'")
        failed += 1
    }

    // f64_to_fixed
    mut ff_val string = fmt.f64_to_fixed(3.14159, 2)
    if ff_val == "3.14" {
        println("  [PASS] f64_to_fixed")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_fixed: expected '3.14', got '${ff_val}'")
        failed += 1
    }

    // f64_to_fixed - zero decimals
    mut ff_zero string = fmt.f64_to_fixed(3.14159, 0)
    if ff_zero == "3" {
        println("  [PASS] f64_to_fixed (0 decimals)")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_fixed (0 decimals): expected '3', got '${ff_zero}'")
        failed += 1
    }

    // f64_to_scientific
    mut fs_val string = fmt.f64_to_scientific(1234.5)
    if len(fs_val) > 0 {
        println("  [PASS] f64_to_scientific (output: ${fs_val})")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_scientific: empty result")
        failed += 1
    }

    // eprintln doesn't crash
    eprintln("test stderr")
    println("  [PASS] eprintln")
    passed += 1

    // eprint doesn't crash
    eprint("test no newline\n")
    println("  [PASS] eprint")
    passed += 1

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
        exit(1)
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
