/*
 * sqlite_c.gray - Integration test for @sqlite (compiler)
 */

import @sqlite

do main() {
    println("=== SQLite Module Test ===")
    mut passed int = 0
    mut failed int = 0

    // open in-memory database
    mut db, _ = sqlite.open(":memory:")
    println("  [PASS] open :memory:")
    passed += 1

    // exec create table
    mut ok, _ = sqlite.exec(db, "CREATE TABLE test (id INTEGER PRIMARY KEY, name TEXT)")
    if ok {
        println("  [PASS] exec CREATE TABLE")
        passed += 1
    } otherwise {
        println("  [FAIL] exec CREATE TABLE")
        failed += 1
    }

    // exec insert
    mut ok2, _ = sqlite.exec(db, "INSERT INTO test (id, name) VALUES (1, 'Alice')")
    if ok2 {
        println("  [PASS] exec INSERT")
        passed += 1
    } otherwise {
        println("  [FAIL] exec INSERT")
        failed += 1
    }

    // exec insert another
    mut _, _ = sqlite.exec(db, "INSERT INTO test (id, name) VALUES (2, 'Bob')")

    // query
    mut rows, _ = sqlite.query(db, "SELECT * FROM test ORDER BY id")
    if len(rows) == 2 {
        println("  [PASS] query returns 2 rows")
        passed += 1
    } otherwise {
        println("  [FAIL] query: expected 2 rows, got ${len(rows)}")
        failed += 1
    }

    // read a column value out of an iterated row
    mut names_seen string = ""
    for_each row in rows {
        names_seen = names_seen + row["name"]
    }
    if names_seen == "AliceBob" {
        println("  [PASS] read column via for_each row")
        passed += 1
    } otherwise {
        println("  [FAIL] for_each column read: got ${names_seen}")
        failed += 1
    }

    // index a row directly and read a column
    mut first map[string:string] = rows[0]
    if first["name"] == "Alice" {
        println("  [PASS] index row then read column")
        passed += 1
    } otherwise {
        println("  [FAIL] rows[0][\"name\"]: got ${first["name"]}")
        failed += 1
    }

    // close
    sqlite.close(db)
    println("  [PASS] close")
    passed += 1

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        panic("Some tests failed!")
    }
    println("ALL TESTS PASSED")
}
