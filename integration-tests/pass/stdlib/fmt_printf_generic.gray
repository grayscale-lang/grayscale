/*
 * fmt_printf_generic.gray - printf calls inside a generic function are
 * checked when the function is instantiated, not rejected in its body.
 */

import @fmt

do format_one(kind generic, value kind) -> string {
    return fmt.sprintf("%d", {value})
}

do format_pair(kind generic, values [kind]) -> string {
    return fmt.sprintf("%s|%s", values)
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut one string = format_one(i64, 5)
    if one == "5" {
        println("  [PASS] generic element formats once instantiated")
        passed += 1
    } otherwise {
        println("  [FAIL] generic element formats once instantiated: got '${one}'")
        failed += 1
    }

    mut words [string] = {"a", "b"}
    mut pair string = format_pair(string, words)
    if pair == "a|b" {
        println("  [PASS] [kind] args formats once instantiated")
        passed += 1
    } otherwise {
        println("  [FAIL] [kind] args formats once instantiated: got '${pair}'")
        failed += 1
    }

    println("Passed: ${passed}, Failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
