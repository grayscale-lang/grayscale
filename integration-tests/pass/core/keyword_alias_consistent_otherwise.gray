/* Pass Test: 'otherwise' keyword alias used consistently for the else arm. */

do classify(x int) -> string {
    if x > 5 {
        return "big"
    } otherwise {
        return "small"
    }
}

do main() {
    mut passed int = 0
    mut failed int = 0

    if classify(10) == "big" {
        passed += 1
    } otherwise {
        println("[FAIL] otherwise: big branch")
        failed += 1
    }
    if classify(1) == "small" {
        passed += 1
    } otherwise {
        println("[FAIL] otherwise: small branch")
        failed += 1
    }

    mut label string = ""
    if false {
        label = "a"
    } otherwise {
        label = "b"
    }
    if label == "b" {
        passed += 1
    } otherwise {
        println("[FAIL] otherwise: taken when condition is false")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
