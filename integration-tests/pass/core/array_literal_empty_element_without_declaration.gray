/*
 * array_literal_empty_element_without_declaration.gray
 * An array literal with an empty {} element takes its element type from the
 * non-empty elements when no declaration fixes it.
 */

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if len({{"a"}, {}}) == 2 && len({{}, {"a"}}) == 2 && len({{}, {}}) == 2 {
        println("  [PASS] len of a literal with empty elements")
        passed += 1
    } otherwise {
        println("  [FAIL] len")
        failed += 1
    }

    mut visited i64 = 0
    for_each row in {{"a"}, {}} { visited += len(row) }
    if visited == 1 && len({{1, 2}, {3}, {}}[2]) == 0 && len({{1.5}, {}}) == 2 && len({{'a'}, {}}) == 2 {
        println("  [PASS] for_each, index base and other element types")
        passed += 1
    } otherwise {
        println("  [FAIL] ${visited}")
        failed += 1
    }

    if "${{{"a"}, {}}}" == "{{\"a\"}, {}}" {
        println("  [PASS] interpolation")
        passed += 1
    } otherwise {
        println("  [FAIL] interpolation")
        failed += 1
    }

    println("Passed: ${passed}, Failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
