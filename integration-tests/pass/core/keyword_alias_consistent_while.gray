/* Pass Test: 'while' keyword alias drives a loop the same as 'as_long_as'. */

do count_to(n i64) -> i64 {
    mut i i64 = 0
    while i < n {
        i++
    }
    return i
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if count_to(3) == 3 {
        passed += 1
    } otherwise {
        println("[FAIL] while loop count: ${count_to(3)}")
        failed += 1
    }

    // A while whose condition is false from the start runs zero times.
    mut ran i64 = 0
    while false {
        ran = 1
    }
    if ran == 0 {
        passed += 1
    } otherwise {
        println("[FAIL] while with a false condition executed its body")
        failed += 1
    }

    // Accumulate inside the loop.
    mut sum i64 = 0
    mut k i64 = 1
    while k <= 5 {
        sum += k
        k++
    }
    if sum == 15 {
        passed += 1
    } otherwise {
        println("[FAIL] while accumulation: ${sum}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
