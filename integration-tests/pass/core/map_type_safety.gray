/* Pass Test: valid same-type map assignments and args work correctly */
do count_items(m map[string:i64]) -> i64 {
    mut total i64 = 0
    for_each k, v in m {
        total += v
    }
    return total
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut scores map[string:i64] = {"alice": 10, "bob": 20}
    mut scores_copy map[string:i64] = scores
    if scores_copy["alice"] == 10 && scores_copy["bob"] == 20 {
        println("  [PASS] same-type map assignment")
        passed += 1
    } otherwise {
        println("  [FAIL] same-type map assignment failed")
        failed += 1
    }

    mut total i64 = count_items(scores)
    if total == 30 {
        println("  [PASS] map[string:i64] passed to matching parameter")
        passed += 1
    } otherwise {
        println("  [FAIL] expected 30, got ${total}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 { println("SOME TESTS FAILED") } otherwise { println("ALL TESTS PASSED") }
}
