// Test: addr() pointer in inner scope is not treated as raw
do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut x i64 = 42
    mut p ^i64 = raw(x)

    // Outer p is raw — bare dereference, no nil check
    if p^ == 42 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] outer raw p^ wrong value")
        failed = failed + 1
    }

    if true {
        mut y i64 = 99
        mut p ^i64 = addr(y) // shadows outer raw p with addr
        // Inner p should NOT be raw — nil check must be emitted
        if p^ == 99 {
            passed = passed + 1
        } otherwise {
            println("[FAIL] inner addr p^ wrong value")
            failed = failed + 1
        }
    }

    // Outer p should still be raw after leaving inner scope
    if p^ == 42 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] outer p^ after inner scope wrong value")
        failed = failed + 1
    }

    println("passed: ${passed}")
    println("failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
