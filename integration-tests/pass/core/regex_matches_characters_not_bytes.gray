import @regex

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut dots, _ = regex.find_all(".", "héllo")
    if len(dots) == 5 && dots[1] == "é" {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
        println("FAIL: '.' matches one whole character")
    }

    mut accented, _ = regex.find("[é]+", "héé!")
    if accented == "éé" {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
        println("FAIL: a bracket expression matches a whole non-ASCII character")
    }

    mut replaced, _ = regex.replace(".", "é", "x")
    if replaced == "x" {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
        println("FAIL: replace substitutes once per character")
    }

    mut dot_count, _ = regex.count(".", "日本語")
    if dot_count == 3 {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
        println("FAIL: count counts characters")
    }

    mut repeated, _ = regex.find("é+", "ééé")
    if repeated == "ééé" {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
        println("FAIL: a quantifier applies to the whole character")
    }

    println("passed: ${passed}, failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
