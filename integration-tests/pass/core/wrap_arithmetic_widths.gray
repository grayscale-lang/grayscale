/*
 * Test: wrap_add, wrap_sub, wrap_mult and wrap_div wrap modulo 2^N at every
 * integer width, and wrap_div of MIN by -1 returns MIN.
 */

do main() {
    unsafe {
        mut a i8 = 127
        assert(wrap_add(a, 1) == -128)
        mut b i8 = -128
        assert(wrap_sub(b, 1) == 127)
        assert(wrap_mult(b, 2) == 0)
        assert(wrap_div(b, -1) == -128)
        assert(wrap_div(b, 2) == -64)

        mut c u8 = 255
        assert(wrap_add(c, 1) == 0)
        mut d u8 = 0
        assert(wrap_sub(d, 1) == 255)
        assert(wrap_mult(c, c) == 1)
        assert(wrap_div(c, 5) == 51)

        mut e i16 = 32767
        assert(wrap_add(e, 1) == -32768)
        mut f i16 = -32768
        assert(wrap_div(f, -1) == -32768)

        mut g u16 = 65535
        assert(wrap_mult(g, g) == 1)

        mut h i32 = 2147483647
        assert(wrap_add(h, 1) == -2147483648)
        mut i i32 = -2147483648
        assert(wrap_sub(i, 1) == 2147483647)
        assert(wrap_div(i, -1) == -2147483648)

        mut j u32 = 4294967295
        assert(wrap_mult(j, j) == 1)
        assert(wrap_add(j, 2) == 1)

        mut k i64 = 9223372036854775807
        assert(wrap_add(k, 1) == -9223372036854775808)
        mut l i64 = -9223372036854775808
        assert(wrap_sub(l, 1) == 9223372036854775807)
        assert(wrap_mult(l, 2) == 0)
        assert(wrap_div(l, -1) == -9223372036854775808)

        mut m u64 = 18446744073709551615
        assert(wrap_add(m, 1) == 0)
        assert(wrap_mult(m, m) == 1)
        mut n u64 = 0
        assert(wrap_sub(n, 1) == 18446744073709551615)

        mut o i128 = 170141183460469231731687303715884105727
        assert(wrap_add(o, 1) == -170141183460469231731687303715884105728)
        mut p i128 = -170141183460469231731687303715884105728
        assert(wrap_div(p, -1) == p)
        assert(wrap_sub(p, 1) == o)

        mut q u128 = 340282366920938463463374607431768211455
        assert(wrap_add(q, 1) == 0)
        assert(wrap_mult(q, q) == 1)
        mut r u128 = 0
        assert(wrap_sub(r, 1) == q)

        mut s u256 = 0
        assert(wrap_sub(s, 1) == 115792089237316195423570985008687907853269984665640564039457584007913129639935)

        mut t i256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
        assert(wrap_div(t, -1) == t)
        assert(wrap_sub(t, 1) == 57896044618658097711785492504343953926634992332820282019728792003956564819967)
        assert(wrap_sub(0, t) == t)
    }
    println("ok")
}
