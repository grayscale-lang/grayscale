const Holder struct {
    data map[string:i64]
}

do check_map(h ^Holder) -> bool {
    if "foo" in h.data { return true }
    return false
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut h = new(Holder)
    h.data = {"foo": 42}
    if check_map(h) {
        passed = passed + 1
    } otherwise {
        println("[FAIL] map in check through pointer failed")
        failed = failed + 1
    }

    println("passed: ${passed}")
    println("failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
