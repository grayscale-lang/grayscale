/*
 * map_foreach_key_binding.gray - for_each over a map must bind the key
 * variable with the key type's real C type, not GrayString.
 *
 * The key binding only special-cased i64/u64; enum, f64, char, and u8
 * keys fell through to GrayString, so any loop body that read the key
 * produced type-mismatched C.
 */

const Color enum {
    RED
    GREEN
    BLUE
}

do main() {
    println("=== for_each map key binding ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // -- enum key read in the loop body --
    mut em map[Color:i64] = {:}
    em[Color.RED] = 1
    em[Color.GREEN] = 2
    mut enum_hits i64 = 0
    for_each k, v in em {
        if k == Color.RED || k == Color.GREEN {
            enum_hits += v
        }
    }
    if enum_hits == 3 {
        println("  [PASS] enum key")
        passed += 1
    } otherwise {
        println("  [FAIL] enum key: ${enum_hits}")
        failed += 1
    }

    // -- f64 key --
    mut fm map[f64:i64] = {:}
    fm[1.5] = 10
    mut float_sum f64 = 0.0
    for_each k, v in fm {
        float_sum += k
    }
    if float_sum == 1.5 {
        println("  [PASS] f64 key")
        passed += 1
    } otherwise {
        println("  [FAIL] f64 key: ${float_sum}")
        failed += 1
    }

    // -- char key --
    mut cm map[char:i64] = {:}
    cm['a'] = 1
    mut got_char char = ' '
    for_each k, v in cm {
        got_char = k
    }
    if got_char == 'a' {
        println("  [PASS] char key")
        passed += 1
    } otherwise {
        println("  [FAIL] char key")
        failed += 1
    }

    // -- u8 key --
    mut bm map[u8:i64] = {:}
    bm[255] = 1
    mut byte_sum i64 = 0
    for_each k, v in bm {
        byte_sum += cast(k, i64)
    }
    if byte_sum == 255 {
        println("  [PASS] u8 key")
        passed += 1
    } otherwise {
        println("  [FAIL] u8 key: ${byte_sum}")
        failed += 1
    }

    // -- string and i64 keys still work --
    mut sm map[string:i64] = {:}
    sm["x"] = 7
    mut str_ok bool = false
    for_each k, v in sm {
        if k == "x" { str_ok = true }
    }
    mut im map[i64:i64] = {:}
    im[42] = 1
    mut int_key i64 = 0
    for_each k, v in im {
        int_key = k
    }
    if str_ok && int_key == 42 {
        println("  [PASS] string and i64 keys")
        passed += 1
    } otherwise {
        println("  [FAIL] string and i64 keys")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
