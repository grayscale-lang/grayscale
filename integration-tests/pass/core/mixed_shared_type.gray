/*
 * Test: a named-return signature `(name, city string, age int)` shares
 * `string` across the first two names and returns all three by value.
 */

do get_full_info() -> (name, city string, age int) {
    mut name string = "Alice"
    mut city string = "NYC"
    mut age int = 30
    return name, city, age
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut n string, c string, a int = get_full_info()
    if n == "Alice" {
        passed += 1
    } otherwise {
        println("[FAIL] name: ${n}")
        failed += 1
    }
    if c == "NYC" {
        passed += 1
    } otherwise {
        println("[FAIL] city: ${c}")
        failed += 1
    }
    if a == 30 {
        passed += 1
    } otherwise {
        println("[FAIL] age: ${a}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
