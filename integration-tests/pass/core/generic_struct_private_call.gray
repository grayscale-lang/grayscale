/*
 * Test: generic struct function calling a private function of the same struct
 * Verifies that the Pass 3 generic re-check correctly sets the struct context
 * so private access is permitted.
 */

const Box struct {
    value i64

    private do secret(self Box) -> i64 {
        return self.value * 2
    }

    do reveal(self Box, extra ?) -> ? {
        mut s i64 = self.secret()
        return extra
    }
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut b Box = Box{value: 21}
    mut r i64 = b.reveal(100)

    if r == 100 { passed = passed + 1 } otherwise { failed = failed + 1 }

    println("passed: ${passed}/${passed + failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
