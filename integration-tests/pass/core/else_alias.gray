/*
 * else_alias.gray - else as alias for otherwise
 *
 * `else` is a syntax alias for `otherwise`.
 * Both keywords produce the same token, so they are interchangeable.
 *
 * The branch keywords are tracked jointly: a file that closes a chain
 * with `else` must spell its middle branches `elif`, not `or`.
 */

do main() {
    mut passed int = 0
    mut failed int = 0

    // -- else in if/else --
    mut x int = 10
    if x > 20 {
        failed += 1
    } else {
        passed += 1
    }

    // -- else in if/elif/else chain --
    if x > 100 {
        failed += 1
    } elif x == 5 {
        failed += 1
    } else {
        passed += 1
    }

    // -- else after a multi-branch elif chain --
    mut name string = "Grayscale"
    if name == "Go" {
        failed += 1
    } elif name == "Rust" {
        failed += 1
    } else {
        passed += 1
    }

    println("else_alias: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } else {
        println("ALL TESTS PASSED")
    }
}
