/*
 * cast_conversions.gray - Test cast() conversion functions
 *
 * Verifies that cast() dispatches to proper conversion functions
 * for string/bool/f64/i64 conversions instead of raw C casts.
 */


alias I = i64
alias S = string
alias Chain = I

const Hue enum {
    RED,
    GREEN
}
alias Shade = Hue

do main() {
    println("=== Cast Conversion Tests ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: i64 → string
    mut s1 string = cast(42, string)
    if s1 == "42" {
        println("  [PASS] cast(42, string) == '42'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(42, string) got '${s1}'")
        failed += 1
    }

    // Test 2: negative i64 → string
    mut s2 string = cast(-99, string)
    if s2 == "-99" {
        println("  [PASS] cast(-99, string) == '-99'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(-99, string) got '${s2}'")
        failed += 1
    }

    // Test 3: f64 → string
    mut s3 string = cast(3.14, string)
    if s3 == "3.14" {
        println("  [PASS] cast(3.14, string) == '3.14'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(3.14, string) got '${s3}'")
        failed += 1
    }

    // Test 4: bool → string
    mut s4 string = cast(true, string)
    if s4 == "true" {
        println("  [PASS] cast(true, string) == 'true'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(true, string) got '${s4}'")
        failed += 1
    }

    // Test 5: bool false → string
    mut s5 string = cast(false, string)
    if s5 == "false" {
        println("  [PASS] cast(false, string) == 'false'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(false, string) got '${s5}'")
        failed += 1
    }

    // Test 6: f64 → i64 (truncation)
    mut i3 i64 = cast(9.99, i64)
    if i3 == 9 {
        println("  [PASS] cast(9.99, i64) == 9 (truncated)")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(9.99, i64) got ${i3}")
        failed += 1
    }

    // Test 10: i64 → f64
    mut f2 f64 = cast(42, f64)
    if f2 > 41.99 && f2 < 42.01 {
        println("  [PASS] cast(42, f64) == 42.0")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(42, f64) got ${f2}")
        failed += 1
    }

    // Test 11: zero → string
    mut s6 string = cast(0, string)
    if s6 == "0" {
        println("  [PASS] cast(0, string) == '0'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(0, string) got '${s6}'")
        failed += 1
    }

    // Test 10: i64 variable → string
    mut num i64 = 777
    mut s7 string = cast(num, string)
    if s7 == "777" {
        println("  [PASS] cast(variable, string) == '777'")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(variable, string) got '${s7}'")
        failed += 1
    }

    // An alias is fully interchangeable with its underlying type, so it
    // names the same cast target the underlying type does.
    mut d f64 = 3.9
    mut ai I = cast(d, I)
    if ai == 3 && type_of(ai) == "i64" {
        println("  [PASS] cast(f64, I) where alias I = i64")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(f64, I) got '${ai}' of type '${type_of(ai)}'")
        failed += 1
    }

    mut as_ S = cast(42, S)
    if as_ == "42" {
        println("  [PASS] cast(i64, S) where alias S = string")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(i64, S) got '${as_}'")
        failed += 1
    }

    mut ac Chain = cast(d, Chain)
    if ac == 3 {
        println("  [PASS] cast through a chained alias")
        passed += 1
    } otherwise {
        println("  [FAIL] cast through a chained alias got '${ac}'")
        failed += 1
    }

    mut sh Shade = cast(1, Shade)
    if sh == Hue.GREEN {
        println("  [PASS] cast(i64, Shade) where alias Shade = Hue")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(i64, Shade) did not produce Hue.GREEN")
        failed += 1
    }

    if cast(sh, I) == 1 {
        println("  [PASS] cast(enum, I) where alias I = i64")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(enum, I) got '${cast(sh, I)}'")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
