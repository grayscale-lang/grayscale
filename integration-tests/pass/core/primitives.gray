/*
 * primitives.gray - Test primitive types (i64, f64, string, bool, char, u8)
 */


do main() {
    println("=== Primitives Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: i64
    mut i i64 = 42
    if i == 42 {
        println("  [PASS] i64 literal")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 literal: expected 42, got ${i}")
        failed += 1
    }

    // Test 2: negative i64
    mut negative_i i64 = -10
    if negative_i == -10 {
        println("  [PASS] negative i64")
        passed += 1
    } otherwise {
        println("  [FAIL] negative i64: expected -10, got ${negative_i}")
        failed += 1
    }

    // Test 3: underscore in numbers
    mut underscore_num i64 = 1_000_000
    if underscore_num == 1000000 {
        println("  [PASS] underscore in i64 literal")
        passed += 1
    } otherwise {
        println("  [FAIL] underscore in i64 literal: expected 1000000, got ${underscore_num}")
        failed += 1
    }

    // Test 4: f64
    mut f f64 = 3.14159
    if f > 3.14 && f < 3.15 {
        println("  [PASS] float literal")
        passed += 1
    } otherwise {
        println("  [FAIL] float literal: unexpected value ${f}")
        failed += 1
    }

    // Test 5: negative f64
    mut negative_f f64 = -2.5
    if negative_f == -2.5 {
        println("  [PASS] negative f64")
        passed += 1
    } otherwise {
        println("  [FAIL] negative f64: expected -2.5, got ${negative_f}")
        failed += 1
    }

    // Test 6: string
    mut s string = "Hello, World!"
    if s == "Hello, World!" {
        println("  [PASS] string literal")
        passed += 1
    } otherwise {
        println("  [FAIL] string literal: unexpected value")
        failed += 1
    }

    // Test 7: empty string
    mut empty_s string = ""
    if len(empty_s) == 0 {
        println("  [PASS] empty string length")
        passed += 1
    } otherwise {
        println("  [FAIL] empty string length: expected 0, got ${len(empty_s)}")
        failed += 1
    }

    // Test 8: bool true
    mut b_true bool = true
    if b_true == true {
        println("  [PASS] bool true")
        passed += 1
    } otherwise {
        println("  [FAIL] bool true: expected true, got ${b_true}")
        failed += 1
    }

    // Test 9: bool false
    mut b_false bool = false
    if b_false == false {
        println("  [PASS] bool false")
        passed += 1
    } otherwise {
        println("  [FAIL] bool false: expected false, got ${b_false}")
        failed += 1
    }

    // Test 10: char
    mut c char = 'A'
    if c == 'A' {
        println("  [PASS] char literal")
        passed += 1
    } otherwise {
        println("  [FAIL] char literal: expected 'A', got '${c}'")
        failed += 1
    }

    // Test 11: char escape
    mut newline char = '\n'
    if cast(newline, i64) == 10 {
        println("  [PASS] char newline escape")
        passed += 1
    } otherwise {
        println("  [FAIL] char newline escape: expected code 10, got ${cast(newline, i64)}")
        failed += 1
    }

    // Test 12: u8
    mut b u8 = 0xFF
    if cast(b, i64) == 255 {
        println("  [PASS] u8 hex literal")
        passed += 1
    } otherwise {
        println("  [FAIL] u8 hex literal: expected 255, got ${cast(b, i64)}")
        failed += 1
    }

    // Test 13: u8 from decimal
    mut b2 u8 = cast(128, u8)
    if cast(b2, i64) == 128 {
        println("  [PASS] u8 from decimal")
        passed += 1
    } otherwise {
        println("  [FAIL] u8 from decimal: expected 128, got ${cast(b2, i64)}")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
