/*
 * typeof_stdlib_returns.gray - Test type_of() for stdlib function returns
 *
 * Verifies that random.choice(), maps.get_keys/values, and range()
 * return correctly resolved types for type_of().
 */

import @random
import @maps

do main() {
    println("=== type_of() Stdlib Return Types ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: random.choice([i64]) returns i64
    mut nums [i64] = {10, 20, 30}
    mut pick = random.choice(nums)
    if type_of(pick) == "i64" {
        println("  [PASS] type_of(random.choice([i64])) == 'i64'")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${type_of(pick)}'")
        failed += 1
    }

    // Test 2: random.choice([string]) returns string
    mut names [string] = {"Alice", "Bob"}
    mut name = random.choice(names)
    if type_of(name) == "string" {
        println("  [PASS] type_of(random.choice([string])) == 'string'")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${type_of(name)}'")
        failed += 1
    }

    // Test 3: random.shuffle preserves array type
    mut arr [i64] = {1, 2, 3}
    mut shuffled = random.shuffle(arr)
    if type_of(shuffled) == "[i64]" {
        println("  [PASS] type_of(random.shuffle([i64])) == '[i64]'")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${type_of(shuffled)}'")
        failed += 1
    }

    // Test 4: maps.get_keys returns array typed to key type
    mut m map[string:i64] = {"a": 1, "b": 2}
    mut k = maps.get_keys(m)
    if type_of(k) == "[string]" {
        println("  [PASS] type_of(maps.get_keys(map[string:i64])) == '[string]'")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${type_of(k)}'")
        failed += 1
    }

    // Test 5: maps.get_values returns array typed to value type
    mut v = maps.get_values(m)
    if type_of(v) == "[i64]" {
        println("  [PASS] type_of(maps.get_values(map[string:i64])) == '[i64]'")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${type_of(v)}'")
        failed += 1
    }

    // Test 6: range() returns Range<i64>
    if type_of(range(0, 5)) == "Range<i64>" {
        println("  [PASS] type_of(range(0, 5)) == 'Range<i64>'")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${type_of(range(0, 5))}'")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
