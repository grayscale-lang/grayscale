/*
 * Test: for_each over map from function call evaluates collection once
 * Verifies that the map expression is hoisted into a temporary
 */

mut call_count i64 = 0
mut passed i64 = 0
mut failed i64 = 0

do get_map() -> map[string:i64] {
    call_count++
    mut m map[string:i64] = {"a": 1, "b": 2}
    return m
}

do main() {
    for_each k, v in get_map() {
        println("${k}=${v}")
    }
    if call_count == 1 {
        passed++
    } otherwise {
        failed++
    }

    println("passed: ${passed}, failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
