/*
 * result_builder_direct_fill.gray - result-building stdlib functions
 *
 * strings.to_chars, arrays.reverse / concat / flatten, and maps.get_keys /
 * get_values now fill their exact-size result array with a direct memcpy
 * instead of a push per element. These cases pin the observable behaviour:
 * element order, empty / single-element inputs, string (16-byte) elements,
 * source independence, and map order after removals.
 */

import @arrays
import @maps
import @strings

do main() {
    println("=== Result Builder Direct Fill Test ===")
    mut passed int = 0
    mut failed int = 0

    // -- to_chars: bytes become codepoints, length exact --
    mut cs [char] = strings.to_chars("AzB9")
    if len(cs) == 4 && int(cs[0]) == 65 && int(cs[1]) == 122 && int(cs[3]) == 57 {
        println("  [PASS] to_chars ASCII")
        passed += 1
    } otherwise {
        println("  [FAIL] to_chars ASCII: ${int(cs[0])} ${int(cs[1])} ${int(cs[3])}")
        failed += 1
    }

    // -- to_chars: empty and high byte --
    mut empty_cs [char] = strings.to_chars("")
    mut hi_cs [char] = strings.to_chars("x\xE9y")
    if len(empty_cs) == 0 && len(hi_cs) == 3 && int(hi_cs[1]) == 233 {
        println("  [PASS] to_chars empty + high byte")
        passed += 1
    } otherwise {
        println("  [FAIL] to_chars empty/high: ${len(empty_cs)} ${len(hi_cs)} ${int(hi_cs[1])}")
        failed += 1
    }

    // -- reverse [int], and source stays intact --
    mut src [int] = {1, 2, 3, 4, 5}
    mut rev [int] = arrays.reverse(src)
    if len(rev) == 5 && rev[0] == 5 && rev[4] == 1 && src[0] == 1 && src[4] == 5 {
        println("  [PASS] reverse [int], source intact")
        passed += 1
    } otherwise {
        println("  [FAIL] reverse [int]")
        failed += 1
    }

    // -- reverse [string] (16-byte elements), empty, single --
    mut ws [string] = {"a", "bb", "ccc"}
    mut wr [string] = arrays.reverse(ws)
    mut er [int] = arrays.reverse({})
    mut sr [int] = arrays.reverse({99})
    if wr[0] == "ccc" && wr[2] == "a" && len(er) == 0 && len(sr) == 1 && sr[0] == 99 {
        println("  [PASS] reverse [string] / empty / single")
        passed += 1
    } otherwise {
        println("  [FAIL] reverse [string]/empty/single: ${wr[0]} ${wr[2]}")
        failed += 1
    }

    // -- concat [int]: both, left-empty, right-empty, both-empty --
    mut c1 [int] = arrays.concat({1, 2, 3}, {4, 5})
    mut c2 [int] = arrays.concat({}, {7, 8})
    mut c3 [int] = arrays.concat({7, 8}, {})
    mut c4 [int] = arrays.concat({}, {})
    mut cc_ok bool = len(c1) == 5 && c1[0] == 1 && c1[3] == 4 && c1[4] == 5
    cc_ok = cc_ok && len(c2) == 2 && c2[0] == 7 && len(c3) == 2 && c3[1] == 8 && len(c4) == 0
    if cc_ok {
        println("  [PASS] concat [int] all empties")
        passed += 1
    } otherwise {
        println("  [FAIL] concat [int]")
        failed += 1
    }

    // -- concat [string] --
    mut cw [string] = arrays.concat({"x", "y"}, {"z"})
    if len(cw) == 3 && cw[0] == "x" && cw[2] == "z" {
        println("  [PASS] concat [string]")
        passed += 1
    } otherwise {
        println("  [FAIL] concat [string]")
        failed += 1
    }

    // -- concat result is a fresh array (mutating it does not touch source) --
    mut cbase [int] = {1, 2}
    mut cnew [int] = arrays.concat(cbase, {3})
    cnew[0] = 99
    if cbase[0] == 1 && cnew[0] == 99 {
        println("  [PASS] concat result independent of source")
        passed += 1
    } otherwise {
        println("  [FAIL] concat independence")
        failed += 1
    }

    // -- flatten [[int]] with uneven inner lengths and an empty inner --
    mut nested [[int]] = {{1, 2, 3}, {}, {4}, {5, 6}}
    mut flat [int] = arrays.flatten(nested)
    mut fl_ok bool = len(flat) == 6
    for i in range(0, 6) {
        if flat[i] != i + 1 { fl_ok = false }
    }
    mut flat_empty [int] = arrays.flatten({})
    if fl_ok && len(flat_empty) == 0 {
        println("  [PASS] flatten uneven + empty inner + empty outer")
        passed += 1
    } otherwise {
        println("  [FAIL] flatten: len ${len(flat)}")
        failed += 1
    }

    // -- get_keys / get_values: insertion order, exact count --
    mut m map[string:int] = {"one": 1, "two": 2, "three": 3, "four": 4}
    mut ks [string] = maps.get_keys(m)
    mut vs [int] = maps.get_values(m)
    if len(ks) == 4 && ks[0] == "one" && ks[3] == "four"
        && len(vs) == 4 && vs[0] == 1 && vs[3] == 4 {
        println("  [PASS] get_keys / get_values in insertion order")
        passed += 1
    } otherwise {
        println("  [FAIL] get_keys/get_values: ${ks[0]}..${ks[3]}")
        failed += 1
    }

    // -- after a removal the order array has a hole; result must skip it --
    maps.remove_key(m, "two")
    mut ks2 [string] = maps.get_keys(m)
    mut vs2 [int] = maps.get_values(m)
    mut rm_ok bool = len(ks2) == 3 && len(vs2) == 3
    rm_ok = rm_ok && ks2[0] == "one" && ks2[1] == "three" && ks2[2] == "four"
    rm_ok = rm_ok && vs2[0] == 1 && vs2[1] == 3 && vs2[2] == 4
    if rm_ok {
        println("  [PASS] get_keys / get_values skip removed entry")
        passed += 1
    } otherwise {
        println("  [FAIL] get_keys after removal: len ${len(ks2)}")
        failed += 1
    }

    // -- empty map --
    mut em map[int:int] = {:}
    mut eks [int] = maps.get_keys(em)
    if len(eks) == 0 {
        println("  [PASS] get_keys of empty map")
        passed += 1
    } otherwise {
        println("  [FAIL] get_keys empty: ${len(eks)}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
