/*
 * string_concat_operator.gray - Test the '+' and '+=' operators on strings
 */

do first() -> string {
    return "Ada"
}

do last() -> string {
    return "Lovelace"
}

do join(a ?, b ?) -> ? {
    return a + b
}

do main() {
    println("=== String Concatenation Test ===")
    mut passed int = 0
    mut failed int = 0

    // Test 1: two string literals
    mut greeting string = "hello" + " world"
    if greeting == "hello world" {
        println("  [PASS] literal + literal")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${greeting}'")
        failed += 1
    }

    // Test 2: literal + variable + literal (chained)
    mut name string = "Gray"
    mut msg string = "Hello, " + name + "!"
    if msg == "Hello, Gray!" {
        println("  [PASS] chained concatenation")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${msg}'")
        failed += 1
    }

    // Test 3: function returns
    mut full string = first() + " " + last()
    if full == "Ada Lovelace" {
        println("  [PASS] function-return concatenation")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${full}'")
        failed += 1
    }

    // Test 4: += append
    mut acc string = "a"
    acc += "b"
    acc += "c"
    if acc == "abc" {
        println("  [PASS] += append")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${acc}'")
        failed += 1
    }

    // Test 5: += inside a loop (result must outlive the iteration arena)
    mut loop_acc string = ""
    for i in range(0, 5) {
        loop_acc += "x"
    }
    if loop_acc == "xxxxx" {
        println("  [PASS] += in loop")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${loop_acc}'")
        failed += 1
    }

    // Test 6: empty-string operands
    mut e string = "" + "done" + ""
    if e == "done" {
        println("  [PASS] empty operands")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${e}'")
        failed += 1
    }

    // Test 7: generic function instantiated with string
    mut g string = join("foo", "bar")
    if g == "foobar" {
        println("  [PASS] generic instantiation with string")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${g}'")
        failed += 1
    }

    // Test 8: += on a string array element
    mut words [string] = {"cat", "dog"}
    words[0] += "s"
    if words[0] == "cats" {
        println("  [PASS] += on array element")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${words[0]}'")
        failed += 1
    }

    // Test 9: += on a string map value
    mut tags [string:string] = {"a": "x"}
    tags["a"] += "y"
    if tags["a"] == "xy" {
        println("  [PASS] += on map value")
        passed += 1
    } otherwise {
        println("  [FAIL] got '${tags["a"]}'")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
