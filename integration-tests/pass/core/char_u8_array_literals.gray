/*
 * Test: [char] and [u8] array literals hold the expected element
 * values and interoperate with strings.from_chars.
 */

import @strings

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut cs [char] = {'H', 'i', '!'}
    if cs[0] == 'H' && cs[2] == '!' && len(cs) == 3 {
        passed += 1
    } otherwise {
        println("[FAIL] [char] literal elements")
        failed += 1
    }

    if strings.from_chars(cs) == "Hi!" {
        passed += 1
    } otherwise {
        println("[FAIL] from_chars([char])")
        failed += 1
    }

    mut data [u8] = {0x48, 0x69, 0x21}
    if data[0] == 0x48 && data[1] == 0x69 && data[2] == 0x21 {
        passed += 1
    } otherwise {
        println("[FAIL] [u8] literal elements")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
