/*
 * Test: new() on collection types
 * Verifies that new() can heap-allocate arrays and maps
 * with properly initialized metadata so operations work.
 */

import @arrays

do main() {
    mut passed int = 0
    mut failed int = 0

    // Test 1: new([int]) → empty array with valid metadata
    mut pa = new([int])
    mut arr [int] = pa^
    if len(arr) == 0 {
        println("  [PASS] new([int]) is empty")
        passed += 1
    } otherwise {
        println("  [FAIL] new([int]): expected len 0, got ${len(arr)}")
        failed += 1
    }

    // Test 2: append to array from new([int]) (proves elem_size is set)
    arrays.append(arr, 10)
    arrays.append(arr, 20)
    if len(arr) == 2 {
        println("  [PASS] new([int]) append works, len is 2")
        passed += 1
    } otherwise {
        println("  [FAIL] new([int]) append: expected len 2, got ${len(arr)}")
        failed += 1
    }

    // Test 3: values are correct after append
    if arr[0] == 10 {
        println("  [PASS] new([int]) first element is 10")
        passed += 1
    } otherwise {
        println("  [FAIL] new([int]) first element: expected 10, got ${arr[0]}")
        failed += 1
    }

    // Test 4: new([string]) → empty string array
    mut psa = new([string])
    mut sarr [string] = psa^
    if len(sarr) == 0 {
        println("  [PASS] new([string]) is empty")
        passed += 1
    } otherwise {
        println("  [FAIL] new([string]): expected len 0, got ${len(sarr)}")
        failed += 1
    }

    // Test 5: append to string array
    arrays.append(sarr, "hello")
    if sarr[0] == "hello" {
        println("  [PASS] new([string]) append works")
        passed += 1
    } otherwise {
        println("  [FAIL] new([string]) append: expected 'hello'")
        failed += 1
    }

    // Test 6: new(map[string:int]) → empty map
    mut pm = new(map[string:int])
    mut m map[string:int] = pm^
    if len(m) == 0 {
        println("  [PASS] new(map[string:int]) is empty")
        passed += 1
    } otherwise {
        println("  [FAIL] new(map[string:int]): expected len 0, got ${len(m)}")
        failed += 1
    }

    // Test 7: insert into map (proves key_size/value_size are set)
    m["x"] = 42
    if m["x"] == 42 {
        println("  [PASS] new(map[string:int]) insert works")
        passed += 1
    } otherwise {
        println("  [FAIL] new(map[string:int]) insert: expected 42")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
