/*
 * cast_array.gray - element-wise cast(arr, [target]) between array types
 * of the same element width ([i64] <-> [f64]).
 */

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut ints [i64] = {1, 2, 3}

    // i64 -> f64 (widening in kind, same 8-u8 element)
    mut floats [f64] = cast(ints, [f64])
    if len(floats) == 3 && floats[0] == 1.0 && floats[1] == 2.0 && floats[2] == 3.0 {
        passed += 1
    } otherwise {
        println("[FAIL] [i64] -> [f64]")
        failed += 1
    }

    // f64 -> i64 back (truncating), round trip on whole numbers
    mut back [i64] = cast(floats, [i64])
    if back[0] == 1 && back[1] == 2 && back[2] == 3 {
        passed += 1
    } otherwise {
        println("[FAIL] [f64] -> [i64] round trip")
        failed += 1
    }

    // A single-element array casts too.
    mut one [i64] = {42}
    mut onef [f64] = cast(one, [f64])
    if len(onef) == 1 && onef[0] == 42.0 {
        passed += 1
    } otherwise {
        println("[FAIL] single-element array cast")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
