    return p^.a + p^.b
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut s ^S260 = new(S260)
    s^.a = 20
    s^.b = 22
    if take(s) == 42 {
        println("  [PASS] struct past the 256th is usable")
        passed += 1
    } otherwise {
        println("  [FAIL] struct past the 256th is usable")
        failed += 1
    }

    mut z S299 = S299 { a: 1, b: 2, next: new(S0) }
    if z.a + z.b == 3 {
        println("  [PASS] last struct literal works")
        passed += 1
    } otherwise {
        println("  [FAIL] last struct literal works")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
