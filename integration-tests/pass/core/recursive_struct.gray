const Node struct {
    value i64
    next ^Node
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut a = new(Node)
    a.value = 10
    a.next = nil

    mut b = new(Node)
    b.value = 20
    b.next = nil

    a.next = b

    // Test 1: head node value
    if a.value == 10 {
        println("  [PASS] head node value")
        passed += 1
    } otherwise {
        println("  [FAIL] head node value: expected 10")
        failed += 1
    }

    // Test 2: linked node value (explicit deref of ^Node field)
    if a.next^.value == 20 {
        println("  [PASS] linked node value")
        passed += 1
    } otherwise {
        println("  [FAIL] linked node value: expected 20")
        failed += 1
    }

    // Test 3: tail next is nil
    if a.next^.next == nil {
        println("  [PASS] tail next is nil")
        passed += 1
    } otherwise {
        println("  [FAIL] tail next should be nil")
        failed += 1
    }

    // Test 4: auto-deref dot access on pointer field (no explicit ^)
    if a.next.value == 20 {
        println("  [PASS] auto-deref pointer field access")
        passed += 1
    } otherwise {
        println("  [FAIL] auto-deref pointer field access: expected 20")
        failed += 1
    }

    // Test 5: chained auto-deref (a.next.next.value)
    mut c = new(Node)
    c.value = 30
    c.next = nil
    b.next = c

    if a.next.next.value == 30 {
        println("  [PASS] chained auto-deref pointer field access")
        passed += 1
    } otherwise {
        println("  [FAIL] chained auto-deref pointer field access: expected 30")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
