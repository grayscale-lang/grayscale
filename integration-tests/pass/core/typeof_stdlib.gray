/*
 * Test: type_of() for stdlib return types
 * Tests that stdlib functions return correct Grayscale type names
 */

import @random
import @strings
import @maps


do main() {
    // Test random module types
    mut rf f64 = random.rand_f64()
    assert(type_of(rf) == "f64", "random.rand_f64() should return 'f64'")

    mut ri i64 = random.rand_i64(100)
    assert(type_of(ri) == "i64", "random.rand_i64() should return 'i64'")

    mut rb bool = random.rand_bool()
    assert(type_of(rb) == "bool", "random.rand_bool() should return 'bool'")

    mut rc u8 = random.rand_u8()
    assert(type_of(rc) == "u8", "random.rand_u8() should return 'u8'")

    mut rchar char = random.rand_char()
    assert(type_of(rchar) == "char", "random.rand_char() should return 'char'")

    // Test random array functions preserve element types
    mut arr [i64] = {1, 2, 3, 4, 5}
    mut shuffled = random.shuffle(arr)
    assert(type_of(shuffled) == "[i64]", "random.shuffle() should preserve '[i64]' type")

    mut sampled = random.sample(arr, 2)
    assert(type_of(sampled) == "[i64]", "random.sample() should preserve '[i64]' type")

    mut choice = random.choice(arr)
    assert(type_of(choice) == "i64", "random.choice() should return element type 'i64'")

    // Test with string array
    mut strArr [string] = {"a", "b", "c"}
    mut strShuffled = random.shuffle(strArr)
    assert(type_of(strShuffled) == "[string]", "random.shuffle() should preserve '[string]' type")

    // Test Range type
    mut r = range(0, 10)
    assert(type_of(r) == "Range<i64>", "range() should return 'Range<i64>'")

    // Test string array from split
    mut parts = strings.split("a,b,c", ",")
    assert(type_of(parts) == "[string]", "strings.split() should return '[string]'")

    // Test map types
    mut m map[string:i64] = {"a": 1, "b": 2}
    mut keys = maps.get_keys(m)
    assert(type_of(keys) == "[string]", "maps.get_keys() should return '[string]'")

    mut values = maps.get_values(m)
    assert(type_of(values) == "[i64]", "maps.get_values() should return '[i64]'")

    // Test with different map types
    mut m2 map[i64:string] = {1: "one", 2: "two"}
    mut keys2 = maps.get_keys(m2)
    assert(type_of(keys2) == "[i64]", "maps.get_keys() should return '[i64]' for i64 keys")

    mut values2 = maps.get_values(m2)
    assert(type_of(values2) == "[string]", "maps.get_values() should return '[string]' for string values")

    println("ALL TESTS PASSED")
}
