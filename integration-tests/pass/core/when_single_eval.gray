/*
 * Test: when statement evaluates the match expression exactly once
 * Verifies that side-effecting expressions are not re-evaluated per arm
 */

mut counter int = 0
mut passed int = 0
mut failed int = 0

do next_val() -> int {
    counter++
    return counter
}

do main() {
    mut matched string = ""
    when next_val() {
        is 10 { matched = "10" }
        is 20 { matched = "20" }
        is 30 { matched = "30" }
        default { matched = "none" }
    }

    // next_val() returns 1 on its first (and only) call, so no arm matches.
    if matched == "none" {
        passed++
    } otherwise {
        println("[FAIL] wrong arm taken: ${matched}")
        failed++
    }

    // The subject expression must have run exactly once.
    if counter == 1 {
        passed++
    } otherwise {
        println("[FAIL] subject evaluated ${counter} times, expected 1")
        failed++
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
