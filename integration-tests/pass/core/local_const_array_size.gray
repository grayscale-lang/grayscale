/*
 * Test: a fixed-size array can take its length from a function-local
 * const or a file-scope const.
 */

const G i64 = 3

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    const N i64 = 5
    const arr [i64, N] = {1, 2, 3, 4, 5}
    if arr[0] == 1 && arr[4] == 5 && len(arr) == 5 {
        passed += 1
    } otherwise {
        println("[FAIL] local const size")
        failed += 1
    }

    const global_arr [i64, G] = {10, 20, 30}
    if global_arr[2] == 30 && len(global_arr) == 3 {
        passed += 1
    } otherwise {
        println("[FAIL] file-scope const size")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
