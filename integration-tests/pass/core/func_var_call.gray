/*
 * func_var_call.gray - Calls through func-typed variables
 *
 * func-typed variables now carry
 * their referenced function, so calls through them are validated for arity
 * and parameter types AND propagate the real return type instead of
 * unknown. This test confirms correct calls still work end-to-end and that
 * the inferred return type is usable in expressions.
 */

do add(a i64, b i64) -> i64 { return a + b }
do mul(a i64, b i64) -> i64 { return a * b }
do greet(name string) -> string { return name }
do is_even(n i64) -> bool { return n % 2 == 0 }

do main() {
    println("=== Func Variable Call Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // -- i64 return --
    const f func(i64, i64) -> i64 = ()add
    mut result i64 = f(10, 20) + 1
    if result == 31 {
        println("  [PASS] i64-returning func var call + arithmetic")
        passed += 1
    } otherwise {
        println("  [FAIL] i64-returning func var call: got ${result}")
        failed += 1
    }

    // -- string return --
    const g func(string) -> string = ()greet
    mut s string = g("hello")
    if s == "hello" {
        println("  [PASS] string-returning func var call")
        passed += 1
    } otherwise {
        println("  [FAIL] string-returning func var call")
        failed += 1
    }

    // -- bool return used in condition --
    const p func(i64) -> bool = ()is_even
    if p(4) && !p(5) {
        println("  [PASS] bool-returning func var call in condition")
        passed += 1
    } otherwise {
        println("  [FAIL] bool-returning func var call in condition")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
