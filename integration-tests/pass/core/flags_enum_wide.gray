/*
 * flags_enum_wide.gray - Regression test for #2186
 * Flags enum with 32+ variants must use 64-bit shifts.
 */

#flags
const Wide enum {
    B0
    B1
    B2
    B3
    B4
    B5
    B6
    B7
    B8
    B9
    B10
    B11
    B12
    B13
    B14
    B15
    B16
    B17
    B18
    B19
    B20
    B21
    B22
    B23
    B24
    B25
    B26
    B27
    B28
    B29
    B30
    B31
}

do main() {
    // B31 must be 2^31 = 2147483648, not -2147483648
    mut f Wide = Wide.B31
    if cast(f, int) == 2147483648 {
        println("[PASS] flags enum B31 == 2^31")
    } otherwise {
        println("[FAIL] flags enum B31: got ${cast(f, int)}")
    }
}
