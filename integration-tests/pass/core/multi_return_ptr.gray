/*
 * Test: multi-return with pointer types and repeated mut keyword
 * Expected output:
 * passed: 1
 * passed: 2
 * passed: 3
 */

do get_ptrs(x ^int, y ^int) -> (^int, ^int) {
    return x, y
}

do divide(a int, b int) -> (int, int) {
    return a / b, a % b
}

do main() {
    mut passed int = 0
    mut failed int = 0

    // repeated mut with pointer types
    mut a int = 10
    mut b int = 20
    mut pa ^int, mut pb ^int = get_ptrs(addr(a), addr(b))
    if pa^ == 10 && pb^ == 20 {
        passed = passed + 1
        println("passed: ${passed}")
    } otherwise {
        failed = failed + 1
        println("failed")
    }

    // single mut with pointer types
    mut c int = 30
    mut d int = 40
    mut pc ^int, pd ^int = get_ptrs(addr(c), addr(d))
    if pc^ == 30 && pd^ == 40 {
        passed = passed + 1
        println("passed: ${passed}")
    } otherwise {
        failed = failed + 1
        println("failed")
    }

    // repeated mut with non-pointer types
    mut q int, mut r int = divide(17, 5)
    if q == 3 && r == 2 {
        passed = passed + 1
        println("passed: ${passed}")
    } otherwise {
        failed = failed + 1
        println("failed")
    }
}
