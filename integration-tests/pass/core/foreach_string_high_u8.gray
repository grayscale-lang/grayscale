// for_each over a string yields one codepoint per character, never a
// sign-extended negative value for bytes >= 0x80. s[i] still indexes bytes.

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    // "é" is 0xC3 0xA9 in UTF-8 -> one codepoint, 233
    mut s string = "é"

    mut count i64 = 0
    mut codepoint i64 = 0
    for_each ch in s {
        codepoint = cast(ch, i64)
        count += 1
    }

    if count == 1 && codepoint == 233 {
        passed += 1
    } otherwise {
        failed += 1
        println("FAIL: loop codepoint ${codepoint} (count ${count})")
    }

    if cast(s[0], i64) == 195 && cast(s[1], i64) == 169 {
        passed += 1
    } otherwise {
        failed += 1
        println("FAIL: index bytes")
    }

    // ASCII unaffected
    mut sum i64 = 0
    for_each ch in "abc" {
        sum += cast(ch, i64)
    }
    if sum == 294 {
        passed += 1
    } otherwise {
        failed += 1
        println("FAIL: ascii sum ${sum}")
    }

    println("passed: ${passed}, failed: ${failed}")
    if failed == 0 {
        println("ALL TESTS PASSED")
    } otherwise {
        println("SOME TESTS FAILED")
        exit(1)
    }
}
