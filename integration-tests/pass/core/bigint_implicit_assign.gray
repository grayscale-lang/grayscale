/*
 * bigint_implicit_assign.gray - Test implicit scalar→wide integer assignment
 *
 * Covers: assigning integer literals and i64/u64 variables directly to
 * i128/u128/i256/u256 declared variables without explicit constructor.
 */

do main() {
    println("=== Wide Integer Implicit Assignment Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: i64 literal → i128
    mut a i128 = 42
    if a == i128(42) {
        println("  [PASS] i64 literal → i128")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 literal → i128: got ${a}")
        failed += 1
    }

    // Test 2: i64 literal → u128
    mut b u128 = 100
    if b == u128(100) {
        println("  [PASS] i64 literal → u128")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 literal → u128: got ${b}")
        failed += 1
    }

    // Test 3: i64 literal → i256
    mut c i256 = 9999
    if c == i256(9999) {
        println("  [PASS] i64 literal → i256")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 literal → i256: got ${c}")
        failed += 1
    }

    // Test 4: i64 literal → u256
    mut d u256 = 555
    if d == u256(555) {
        println("  [PASS] i64 literal → u256")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 literal → u256: got ${d}")
        failed += 1
    }

    // Test 5: i64 variable → i128
    mut n i64 = 77
    mut e i128 = n
    if e == i128(77) {
        println("  [PASS] i64 variable → i128")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 variable → i128: got ${e}")
        failed += 1
    }

    // Test 6: u64 variable → u128
    mut m u64 = 200
    mut f u128 = m
    if f == u128(200) {
        println("  [PASS] u64 variable → u128")
        passed += 1
    } otherwise {
        println("  [FAIL] u64 variable → u128: got ${f}")
        failed += 1
    }

    // Test 7: i64 variable → i256
    mut k i64 = 1234
    mut g i256 = k
    if g == i256(1234) {
        println("  [PASS] i64 variable → i256")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 variable → i256: got ${g}")
        failed += 1
    }

    // Test 8: negative i64 literal → i128
    mut h i128 = -50
    if h == i128(-50) {
        println("  [PASS] negative i64 literal → i128")
        passed += 1
    } otherwise {
        println("  [FAIL] negative i64 literal → i128: got ${h}")
        failed += 1
    }

    // Test 9: zero → i256
    mut z i256 = 0
    if z == i256(0) {
        println("  [PASS] zero → i256")
        passed += 1
    } otherwise {
        println("  [FAIL] zero → i256")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
