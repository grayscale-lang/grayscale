/* Test: a named return variable can be reassigned and conditionally
 * updated in the function body before it is returned. */

do calculate() -> (result i64) {
    mut result i64 = 10
    result = result * 2      // 20
    if result > 15 {
        result = result + 5  // 25
    }
    return result
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if calculate() == 25 {
        passed += 1
    } otherwise {
        println("[FAIL] modified named return: ${calculate()}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
