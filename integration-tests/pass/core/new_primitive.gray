/*
 * Test: new() on primitive types
 * Verifies that new() can heap-allocate any primitive type
 * and that the zero-value is correct for each.
 */

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: new(i64) → 0
    mut pi = new(i64)
    if pi^ == 0 {
        println("  [PASS] new(i64) zero value is 0")
        passed += 1
    } otherwise {
        println("  [FAIL] new(i64): expected 0, got ${pi^}")
        failed += 1
    }

    // Test 2: new(f64) → 0.0
    mut pf = new(f64)
    if pf^ == 0.0 {
        println("  [PASS] new(f64) zero value is 0.0")
        passed += 1
    } otherwise {
        println("  [FAIL] new(f64): expected 0.0")
        failed += 1
    }

    // Test 3: new(string) → ""
    mut ps = new(string)
    if ps^ == "" {
        println("  [PASS] new(string) zero value is empty")
        passed += 1
    } otherwise {
        println("  [FAIL] new(string): expected empty string")
        failed += 1
    }

    // Test 4: new(bool) → false
    mut pb = new(bool)
    if pb^ == false {
        println("  [PASS] new(bool) zero value is false")
        passed += 1
    } otherwise {
        println("  [FAIL] new(bool): expected false")
        failed += 1
    }

    // Test 5: new(u8) → 0
    mut pby = new(u8)
    if cast(pby^, i64) == 0 {
        println("  [PASS] new(u8) zero value is 0")
        passed += 1
    } otherwise {
        println("  [FAIL] new(u8): expected 0")
        failed += 1
    }

    // Test 6: new(u64) → 0
    mut pu = new(u64)
    if pu^ == cast(0, u64) {
        println("  [PASS] new(u64) zero value is 0")
        passed += 1
    } otherwise {
        println("  [FAIL] new(u64): expected 0")
        failed += 1
    }

    // Test 7: mutation through pointer
    pi^ = 42
    if pi^ == 42 {
        println("  [PASS] new(i64) mutation works")
        passed += 1
    } otherwise {
        println("  [FAIL] new(i64) mutation: expected 42, got ${pi^}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
