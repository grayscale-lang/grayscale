/*
 * Test: void functions across every control-flow exit path — early
 * return, ensure, loops, when/is, nesting, as_long_as. Each function
 * records a side effect so the exit path is observable, not just
 * "it compiled".
 */

import @arrays

mut hits [int] = {}

do note(n int) {
    arrays.append(hits, n)
}

do basic_void() {
    note(1)
}

do early_return(should_return bool) {
    if should_return {
        note(2)
        return
    }
    note(3)
}

do with_ensure() {
    ensure note(4)
    note(5)
}

do ensure_with_early_return(should_return bool) {
    ensure note(6)
    if should_return {
        return
    }
    note(7)
}

do return_in_loop() {
    for i in range(0, 3) {
        note(10 + i)
        if i == 1 {
            return
        }
    }
}

do return_in_when(val int) {
    when val {
        is 1 { note(20) return }
        is 2 { note(21) return }
        default { note(22) return }
    }
}

do inner_v() {
    note(30)
    return
}

do outer_v() {
    inner_v()
    note(31)
}

do return_in_while() {
    mut count int = 0
    as_long_as count < 10 {
        if count == 2 {
            note(40)
            return
        }
        count++
    }
}

do main() {
    mut passed int = 0
    mut failed int = 0

    basic_void()
    early_return(true)
    early_return(false)
    with_ensure()
    ensure_with_early_return(true)
    ensure_with_early_return(false)
    return_in_loop()
    return_in_when(1)
    return_in_when(2)
    return_in_when(99)
    outer_v()
    return_in_while()

    // basic:1  early(t):2  early(f):3  ensure:5,4  ewer(t):6  ewer(f):7,6
    // loop:10,11  when:20 21 22  outer:30,31  while:40
    mut want [int] = {1, 2, 3, 5, 4, 6, 7, 6, 10, 11, 20, 21, 22, 30, 31, 40}

    if len(hits) == len(want) {
        passed += 1
    } otherwise {
        println("[FAIL] hit count: got ${len(hits)}, want ${len(want)}")
        failed += 1
    }

    mut ordered bool = len(hits) == len(want)
    for_each i, h in hits {
        if i < len(want) && h != want[i] {
            ordered = false
        }
    }
    if ordered {
        passed += 1
    } otherwise {
        println("[FAIL] exit-path order does not match")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
