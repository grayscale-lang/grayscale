/* Test: ++ and -- on a u64 variable adjust it by one and stay in range. */

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut x u64 = 5
    x++
    x++
    x--
    if x == 6 {
        passed += 1
    } otherwise {
        println("[FAIL] u64 ++/-- net: ${x}")
        failed += 1
    }

    mut y u64 = 0
    y++
    if y == 1 {
        passed += 1
    } otherwise {
        println("[FAIL] u64 ++ from 0: ${y}")
        failed += 1
    }

    mut z u64 = 1
    z--
    if z == 0 {
        passed += 1
    } otherwise {
        println("[FAIL] u64 -- to 0: ${z}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
