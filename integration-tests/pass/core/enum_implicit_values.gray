/*
 * enum_implicit_values.gray - Enum implicit values continue from
 * the last explicit value.
 *
 * implicit entries used the 0-based position
 * index (`= j`) instead of continuing from the previous explicit
 * value. `PENDING = 10, ACTIVE` gave ACTIVE = 1 instead of 11.
 */

const Status enum {
    PENDING = 10,
    ACTIVE,
    DONE = 20
}

const Mixed enum {
    A,
    B,
    C = 100,
    D,
    E = 200,
    F,
    G
}

do main() {
    println("=== Enum Implicit Values Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Assign enum values to i64 variables, then compare
    mut sp i64 = cast(Status.PENDING, i64)
    mut sa i64 = cast(Status.ACTIVE, i64)
    mut sd i64 = cast(Status.DONE, i64)
    if sp == 10 && sa == 11 && sd == 20 {
        println("  [PASS] PENDING=10, ACTIVE=11, DONE=20")
        passed += 1
    } otherwise {
        println("  [FAIL] Status: ${sp}, ${sa}, ${sd}")
        failed += 1
    }

    mut ma i64 = cast(Mixed.A, i64)
    mut mb i64 = cast(Mixed.B, i64)
    mut mc i64 = cast(Mixed.C, i64)
    mut md i64 = cast(Mixed.D, i64)
    mut me i64 = cast(Mixed.E, i64)
    mut mf i64 = cast(Mixed.F, i64)
    mut mg i64 = cast(Mixed.G, i64)
    if ma == 0 && mb == 1 && mc == 100 && md == 101 &&
       me == 200 && mf == 201 && mg == 202 {
        println("  [PASS] A=0, B=1, C=100, D=101, E=200, F=201, G=202")
        passed += 1
    } otherwise {
        println("  [FAIL] Mixed: A=${ma} B=${mb} C=${mc} D=${md} E=${me} F=${mf} G=${mg}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
