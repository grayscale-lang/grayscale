/*
 * Test: named return values that share a single type annotation
 * `(first, last string)` are both returned correctly.
 */

do get_names() -> (first, last string) {
    mut first string = "John"
    mut last string = "Doe"
    return first, last
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut f string, l string = get_names()
    if f == "John" {
        passed += 1
    } otherwise {
        println("[FAIL] first: ${f}")
        failed += 1
    }
    if l == "Doe" {
        passed += 1
    } otherwise {
        println("[FAIL] last: ${l}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
