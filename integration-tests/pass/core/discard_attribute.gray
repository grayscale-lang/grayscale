/*
 * Test: #discard suppresses E5011 for an unused return value, on both a
 * free function and a struct function, while the value is still usable
 * when captured.
 */

#discard
do get_value() -> int {
    return 42
}

const Counter struct {
    count int

    #discard
    do increment(self Counter) -> int {
        return self.count + 1
    }
}

do main() {
    mut passed int = 0
    mut failed int = 0

    // Called for effect, return discarded — must not be an error.
    get_value()

    mut x int = get_value()
    if x == 42 {
        passed += 1
    } otherwise {
        println("[FAIL] captured free-function return: ${x}")
        failed += 1
    }

    mut c Counter = Counter{ count: 5 }
    c.increment()

    mut y int = c.increment()
    if y == 6 {
        passed += 1
    } otherwise {
        println("[FAIL] captured struct-function return: ${y}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
