/*
 * generic_composite_return.gray - a generic function can build and return a
 * collection of its type parameter from a composite literal.
 *
 * {x, x} where x has the generic type must infer as a collection of that type
 * so it matches a declared -> [kind]; likewise {k: v} against
 * -> map[string:kind]. Monomorphization then specializes per call site.
 */

do wrap(kind generic, x kind) -> [kind] {
    return {x, x, x}
}

do pair(kind generic, k string, v kind) -> map[string:kind] {
    return {k: v}
}

do main() {
    mut pass i64 = 0
    mut fail i64 = 0

    /* -> [kind] specialized to [i64] */
    mut ai [i64] = wrap(i64, 7)
    if len(ai) == 3 && ai[0] == 7 && ai[2] == 7 { pass += 1 } otherwise { fail += 1 }

    /* same function specialized to [string] */
    mut as_ [string] = wrap(string, "hi")
    if len(as_) == 3 && as_[1] == "hi" { pass += 1 } otherwise { fail += 1 }

    /* -> map[string:kind] specialized to map[string:i64] */
    mut mi map[string:i64] = pair(i64, "a", 9)
    if mi["a"] == 9 { pass += 1 } otherwise { fail += 1 }

    /* same function specialized to map[string:string] */
    mut ms map[string:string] = pair(string, "b", "yes")
    if ms["b"] == "yes" { pass += 1 } otherwise { fail += 1 }

    println("generic_composite_return: ${pass} passed, ${fail} failed")
    if fail > 0 { exit(1) }
    println("ALL TESTS PASSED")
}
