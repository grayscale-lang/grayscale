// Test: a nested array literal fills [[T]] and map[K:[T]] for a sized numeric T, as the flat literal fills [T]

do show_sum(a [[i32]]) -> i32 {
    mut total i32 = 0
    for_each row in a {
        for_each x in row {
            total += x
        }
    }
    return total
}

do first_of(m map[string:[u8]]) -> u8 {
    return m["a"][0]
}

do make_grid() -> [[i32]] {
    return {{1}, {2, 3}}
}

do make_map() -> map[string:[i32]] {
    return {"a": {4, 5}}
}

do main() {
    mut grid [[i32]] = {{1, 2}, {3, 4}}
    if grid[1][0] == 3 && len(grid[0]) == 2 {
        println("  [PASS] [[i32]] declaration")
    } else {
        println("  [FAIL] [[i32]] declaration")
    }

    mut bytes [[u8]] = {{1}, {2, 3}}
    if bytes[1][1] == 3 {
        println("  [PASS] [[u8]] declaration")
    } else {
        println("  [FAIL] [[u8]] declaration")
    }

    mut wide [[i64]] = {{1}, {2, 3}}
    mut unsigned [[uint]] = {{1}, {2, 3}}
    if wide[1][1] == 3 && unsigned[1][1] == 3 {
        println("  [PASS] [[i64]] and [[uint]] declarations")
    } else {
        println("  [FAIL] [[i64]] and [[uint]] declarations")
    }

    mut floats [[f32]] = {{1.5}, {2.5, 3.5}}
    if floats[0][0] == 1.5 && floats[1][1] == 3.5 {
        println("  [PASS] [[f32]] declaration keeps the float values")
    } else {
        println("  [FAIL] [[f32]] declaration keeps the float values")
    }

    mut cube [[[i32]]] = {{{1}, {2}}, {{3}}}
    if cube[1][0][0] == 3 {
        println("  [PASS] three-level [[[i32]]] declaration")
    } else {
        println("  [FAIL] three-level [[[i32]]] declaration")
    }

    mut m map[string:[i32]] = {"a": {1, 2}}
    if m["a"][1] == 2 {
        println("  [PASS] map[string:[i32]] declaration")
    } else {
        println("  [FAIL] map[string:[i32]] declaration")
    }

    mut mf map[string:[f32]] = {"a": {1.5}}
    if mf["a"][0] == 1.5 {
        println("  [PASS] map[string:[f32]] declaration keeps the float values")
    } else {
        println("  [FAIL] map[string:[f32]] declaration keeps the float values")
    }

    if show_sum({{1}, {2, 3}}) == 6 {
        println("  [PASS] nested literal passed to a [[i32]] parameter")
    } else {
        println("  [FAIL] nested literal passed to a [[i32]] parameter")
    }

    if first_of({"a": {7, 8}}) == 7 {
        println("  [PASS] map literal passed to a map[string:[u8]] parameter")
    } else {
        println("  [FAIL] map literal passed to a map[string:[u8]] parameter")
    }

    mut made [[i32]] = make_grid()
    mut made_map map[string:[i32]] = make_map()
    if made[1][1] == 3 && made_map["a"][1] == 5 {
        println("  [PASS] nested literals returned as [[i32]] and map[string:[i32]]")
    } else {
        println("  [FAIL] nested literals returned as [[i32]] and map[string:[i32]]")
    }
}
