/* Test: named return variables initialized to each primitive's zero
 * value and returned. */

do get_zero_int() -> (count i64) {
    mut count i64 = 0
    return count
}

do get_zero_string() -> (text string) {
    mut text string = ""
    return text
}

do get_zero_bool() -> (flag bool) {
    mut flag bool = false
    return flag
}

do get_zero_float() -> (value f64) {
    mut value f64 = 0.0
    return value
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if get_zero_int() == 0 {
        passed += 1
    } otherwise {
        println("[FAIL] zero i64")
        failed += 1
    }
    if get_zero_string() == "" {
        passed += 1
    } otherwise {
        println("[FAIL] zero string")
        failed += 1
    }
    if get_zero_bool() == false {
        passed += 1
    } otherwise {
        println("[FAIL] zero bool")
        failed += 1
    }
    if get_zero_float() == 0.0 {
        passed += 1
    } otherwise {
        println("[FAIL] zero f64")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
