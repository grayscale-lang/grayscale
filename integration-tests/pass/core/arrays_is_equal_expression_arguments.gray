// Test: arrays.is_equal accepts any array-typed expression as either argument
import @arrays

const W struct {
    v [int]
}

do mk() -> [int] {
    return {1, 2}
}

do main() {
    mut a [int] = {1, 2}
    mut names [string] = {"a"}
    mut w W = W{v: {1, 2}}

    if arrays.is_equal(a, {1, 2}) && !arrays.is_equal(a, {1, 3}) {
        println("  [PASS] array literal as the second argument")
    } else {
        println("  [FAIL] array literal as the second argument")
    }

    if arrays.is_equal({1}, {1}) && arrays.is_equal({"a"}, {"a"}) {
        println("  [PASS] array literals as both arguments")
    } else {
        println("  [FAIL] array literals as both arguments")
    }

    if arrays.is_equal(names, {"a"}) {
        println("  [PASS] string array against a literal")
    } else {
        println("  [FAIL] string array against a literal")
    }

    if arrays.is_equal(a, mk()) && arrays.is_equal(mk(), a) {
        println("  [PASS] call result as either argument")
    } else {
        println("  [FAIL] call result as either argument")
    }

    if arrays.is_equal(a, w.v) {
        println("  [PASS] struct field as the second argument")
    } else {
        println("  [FAIL] struct field as the second argument")
    }

    mut c [int] = {1, 3}
    if !arrays.is_equal(a, arrays.slice(c, 0, 1)) && !arrays.is_equal(a, arrays.concat(a, c)) {
        println("  [PASS] arrays function results as the second argument")
    } else {
        println("  [FAIL] arrays function results as the second argument")
    }
}
