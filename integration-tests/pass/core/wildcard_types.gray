/*
 * wildcard_types.gray - Wildcard (?) types in function signatures
 *
 * Covers param wildcards, return wildcards, [?] element wildcards,
 * mixed-type instantiations, same-function reuse with different
 * concrete types, and inference through longer expressions.
 */

do first(arr [?]) -> ? {
    return arr[0]
}

do last(arr [?]) -> ? {
    return arr[len(arr) - 1]
}

do max(a ?, b ?) -> ? {
    if a > b { return a }
    return b
}

do min(a ?, b ?) -> ? {
    if a < b { return a }
    return b
}

do identity(x ?) -> ? {
    return x
}

do contains(arr [?], target ?) -> bool {
    for_each item in arr {
        if item == target { return true }
    }
    return false
}

// --- map wildcard helpers ---

do get_or(m map[string:?], k string, fallback ?) -> ? {
    if k in m { return m[k] }
    return fallback
}

do has_key(m map[?:i64], k ?) -> bool {
    return k in m
}

// map[?:?] — fix accepts this only when the arg's key type equals its value
// type, since a single '?' binding must satisfy both slots.
do count_entries(m map[?:?]) -> i64 {
    mut n i64 = 0
    for_each k, v in m {
        n += 1
    }
    return n
}

// Non-string concrete key in map[K:?] — exercises the key-slot match path
// with a key type other than string.
do get_or_int_key(m map[i64:?], k i64, fallback ?) -> ? {
    if k in m { return m[k] }
    return fallback
}

do main() {
    println("=== Wildcard Types Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // -- first/last on [i64] --
    mut nums [i64] = {10, 20, 30, 40}
    if first(nums) == 10 && last(nums) == 40 {
        println("  [PASS] first/last on [i64]")
        passed += 1
    } otherwise {
        println("  [FAIL] first/last on [i64]")
        failed += 1
    }

    // -- first/last on [string] — reuse of same wildcard fn with different concrete type --
    mut words [string] = {"alpha", "beta", "gamma"}
    if first(words) == "alpha" && last(words) == "gamma" {
        println("  [PASS] first/last on [string]")
        passed += 1
    } otherwise {
        println("  [FAIL] first/last on [string]")
        failed += 1
    }

    // -- first on [f64] --
    mut floats [f64] = {1.5, 2.5, 3.5}
    if first(floats) == 1.5 {
        println("  [PASS] first on [f64]")
        passed += 1
    } otherwise {
        println("  [FAIL] first on [f64]")
        failed += 1
    }

    // -- max/min with i64 --
    if max(10, 20) == 20 && min(10, 20) == 10 {
        println("  [PASS] max/min i64")
        passed += 1
    } otherwise {
        println("  [FAIL] max/min i64")
        failed += 1
    }

    // -- max/min with f64 --
    if max(1.5, 2.5) == 2.5 && min(1.5, 2.5) == 1.5 {
        println("  [PASS] max/min f64")
        passed += 1
    } otherwise {
        println("  [FAIL] max/min f64")
        failed += 1
    }

    // -- identity preserves concrete types across distinct instantiations --
    mut i i64 = identity(42)
    mut s string = identity("hi")
    mut f f64 = identity(3.14)
    mut b bool = identity(true)
    if i == 42 && s == "hi" && f == 3.14 && b {
        println("  [PASS] identity across i64/string/f64/bool")
        passed += 1
    } otherwise {
        println("  [FAIL] identity across types")
        failed += 1
    }

    // -- contains over [i64]: for_each element type must substitute --
    if contains(nums, 20) && !contains(nums, 99) {
        println("  [PASS] contains [i64]")
        passed += 1
    } otherwise {
        println("  [FAIL] contains [i64]")
        failed += 1
    }

    // -- contains over [string]: for_each + string '==' dispatch --
    if contains(words, "beta") && !contains(words, "zeta") {
        println("  [PASS] contains [string]")
        passed += 1
    } otherwise {
        println("  [FAIL] contains [string]")
        failed += 1
    }

    // -- contains over [f64] --
    if contains(floats, 2.5) && !contains(floats, 9.9) {
        println("  [PASS] contains [f64]")
        passed += 1
    } otherwise {
        println("  [FAIL] contains [f64]")
        failed += 1
    }

    // -- inference chains: use a wildcard result inside another wildcard call --
    if max(first(nums), last(nums)) == 40 {
        println("  [PASS] nested wildcard calls")
        passed += 1
    } otherwise {
        println("  [FAIL] nested wildcard calls")
        failed += 1
    }

    // -- map[K:?] with concrete key and wildcard value --
    mut ages map[string:i64] = {"alice": 30, "bob": 25}
    if get_or(ages, "alice", 0) == 30 && get_or(ages, "zoe", 99) == 99 {
        println("  [PASS] get_or on map[string:i64]")
        passed += 1
    } otherwise {
        println("  [FAIL] get_or on map[string:i64]")
        failed += 1
    }

    // -- same generic reused against a different concrete value type --
    mut titles map[string:string] = {"a": "Admin"}
    if get_or(titles, "a", "Guest") == "Admin" && get_or(titles, "b", "Guest") == "Guest" {
        println("  [PASS] get_or on map[string:string]")
        passed += 1
    } otherwise {
        println("  [FAIL] get_or on map[string:string]")
        failed += 1
    }

    // -- map[?:V] with wildcard key and concrete value --
    mut prices map[string:i64] = {"apple": 5}
    mut weights map[i64:i64] = {42: 7}
    if has_key(prices, "apple") && !has_key(prices, "pear") &&
       has_key(weights, 42) && !has_key(weights, 99) {
        println("  [PASS] has_key across map[string:i64] and map[i64:i64]")
        passed += 1
    } otherwise {
        println("  [FAIL] has_key across map[string:i64] and map[i64:i64]")
        failed += 1
    }

    // -- map[?:?] — both slots wildcard (key type == value type) --
    mut ii map[i64:i64] = {1: 10, 2: 20, 3: 30}
    mut ss map[string:string] = {"a": "A", "b": "B"}
    if count_entries(ii) == 3 && count_entries(ss) == 2 {
        println("  [PASS] count_entries on map[?:?] (i64:i64 and string:string)")
        passed += 1
    } otherwise {
        println("  [FAIL] count_entries on map[?:?]")
        failed += 1
    }

    // -- non-string concrete key in map[K:?] --
    mut ids map[i64:string] = {1: "one", 2: "two"}
    if get_or_int_key(ids, 1, "none") == "one" && get_or_int_key(ids, 99, "none") == "none" {
        println("  [PASS] get_or_int_key on map[i64:string]")
        passed += 1
    } otherwise {
        println("  [FAIL] get_or_int_key on map[i64:string]")
        failed += 1
    }

    // -- narrow value types through gray_map_elem_c_type routing --
    // The fix routes gray_map_elem_c_type's input through cg_effective_type_str
    // so that narrow types (f64/bool/char/u8) don't fall back to int64_t.
    mut float_m map[string:f64] = {"pi": 3.14}
    mut flag_m map[string:bool] = {"on": true, "off": false}
    mut char_m map[string:char] = {"a": 'A', "b": 'B'}
    mut byte_m map[string:u8] = {"x": 0b1010}
    mut zb u8 = 0b0
    mut ex u8 = 0b1010
    if get_or(float_m, "pi", 0.0) == 3.14 &&
       get_or(float_m, "e", 2.71) == 2.71 &&
       get_or(flag_m, "on", false) &&
       !get_or(flag_m, "off", true) &&
       get_or(char_m, "a", '?') == 'A' &&
       get_or(char_m, "z", '?') == '?' &&
       get_or(byte_m, "x", zb) == ex &&
       get_or(byte_m, "y", zb) == zb {
        println("  [PASS] get_or with narrow value types (f64/bool/char/u8)")
        passed += 1
    } otherwise {
        println("  [FAIL] get_or with narrow value types")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
