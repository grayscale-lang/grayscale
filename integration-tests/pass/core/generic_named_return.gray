/*
 * generic_named_return.gray - Generic return types in named multi-return
 * functions, bound to a different type at each call.
 */

do first_and_len(kind generic, arr [kind]) -> (first kind, count i64) {
    mut first kind = arr[0]
    mut count i64 = len(arr)
    return first, count
}

do main() {
    println("=== Generic Named Return Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // -- i64 binding --
    mut v i64, n i64 = first_and_len(i64, {10, 20, 30})
    if v == 10 && n == 3 {
        println("  [PASS] first_and_len([i64]) = (10, 3)")
        passed += 1
    } otherwise {
        println("  [FAIL] got (${v}, ${n})")
        failed += 1
    }

    // -- string binding (different instantiation) --
    mut s string, n2 i64 = first_and_len(string, {"a", "b"})
    if s == "a" && n2 == 2 {
        println("  [PASS] first_and_len([string]) = (a, 2)")
        passed += 1
    } otherwise {
        println("  [FAIL] got (${s}, ${n2})")
        failed += 1
    }

    // -- f64 binding --
    mut f f64, n3 i64 = first_and_len(f64, {1.5, 2.5, 3.5, 4.5})
    if f == 1.5 && n3 == 4 {
        println("  [PASS] first_and_len([f64]) = (1.5, 4)")
        passed += 1
    } otherwise {
        println("  [FAIL] got (${f}, ${n3})")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
