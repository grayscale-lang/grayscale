/*
 * Treating a call through a func value (func-typed parameter or func-typed
 * local) as a conservative escape point (#2661) must not flag a call that
 * passes no local address: by-value arguments, and pointers into memory that
 * outlives the function, are fine.
 */

mut g_slot i64 = 0

do add_to_slot(n i64) { g_slot += n }

do bump(p ^i64) { p^ += 1 }

do run_ptr(f func(^i64), p ^i64) { f(p) }

do main() {
    mut passed i64 = 0

    // 1. func-typed parameter call with a pointer to a global (outlives the call)
    run_ptr(ref(bump), addr(g_slot))
    if g_slot == 1 {
        println("  [PASS] func-typed param call, pointer to global")
        passed += 1
    } otherwise {
        println("  [FAIL] func param: ${g_slot}")
    }

    // 2. func-typed local, by-value argument
    const local_fn func(i64) = ref(add_to_slot)
    local_fn(7)
    if g_slot == 8 {
        println("  [PASS] func-typed local call, value arg")
        passed += 1
    } otherwise {
        println("  [FAIL] func local: ${g_slot}")
    }

    println("Results: ${passed} passed")
    if passed == 2 {
        println("ALL TESTS PASSED")
    } otherwise {
        println("SOME TESTS FAILED")
    }
}
