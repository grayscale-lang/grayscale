/*
 * size_of_container_types.gray - Test size_of on container type expressions
 *
 * Covers: size_of([i64]), size_of([i64,3]), size_of([[i64]]),
 *         size_of(map[string:i64]), and cast to a container type.
 * Every array spelling is the same runtime value, so their sizes agree.
 */

do main() {
    println("=== size_of Container Type Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: size_of([i64]) is a real size
    if size_of([i64]) > 0 {
        println("  [PASS] size_of([i64]) == ${size_of([i64])}")
        passed += 1
    } otherwise {
        println("  [FAIL] size_of([i64]) == ${size_of([i64])}")
        failed += 1
    }

    // Test 2: every array spelling is the same runtime value
    if size_of([string]) == size_of([i64]) {
        println("  [PASS] size_of([string]) == size_of([i64])")
        passed += 1
    } otherwise {
        println("  [FAIL] size_of([string]) == ${size_of([string])}")
        failed += 1
    }

    // Test 3: fixed-size array spelling
    if size_of([i64,3]) == size_of([i64]) {
        println("  [PASS] size_of([i64,3]) == size_of([i64])")
        passed += 1
    } otherwise {
        println("  [FAIL] size_of([i64,3]) == ${size_of([i64,3])}")
        failed += 1
    }

    // Test 4: nested array spelling
    if size_of([[i64]]) == size_of([i64]) {
        println("  [PASS] size_of([[i64]]) == size_of([i64])")
        passed += 1
    } otherwise {
        println("  [FAIL] size_of([[i64]]) == ${size_of([[i64]])}")
        failed += 1
    }

    // Test 5: map spelling
    if size_of(map[string:i64]) > 0 {
        println("  [PASS] size_of(map[string:i64]) == ${size_of(map[string:i64])}")
        passed += 1
    } otherwise {
        println("  [FAIL] size_of(map[string:i64]) == ${size_of(map[string:i64])}")
        failed += 1
    }

    // Test 6: a map is not an array
    if size_of(map[string:i64]) != size_of([i64]) {
        println("  [PASS] size_of(map[string:i64]) != size_of([i64])")
        passed += 1
    } otherwise {
        println("  [FAIL] map and array sizes matched")
        failed += 1
    }

    // Test 7: cast still takes an array spelling
    mut ints [i64] = {1, 2, 3}
    mut floats [f64] = cast(ints, [f64])
    if floats[2] == 3.0 {
        println("  [PASS] cast(ints, [f64]) converts elements")
        passed += 1
    } otherwise {
        println("  [FAIL] cast(ints, [f64]) gave ${floats[2]}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
