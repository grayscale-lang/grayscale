import @fmt

const Product struct {
    name string
    qty int

    do with_quantity(p Product, q int) -> Product {
        return Product{name: "${p.name}", qty: q}
    }
}

const Inventory struct {
    items [Product]

    do update(&inv Inventory, idx int, q int) {
        p Product = inv.items[idx]
        inv.items[idx] = Product.with_quantity(p, q)
    }

    do label(&inv Inventory, idx int) -> string {
        p Product = inv.items[idx]
        return "${p.name} x${p.qty}"
    }
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut inv Inventory = Inventory{items: {Product{name: "Laptop Pro 15", qty: 1}}}

    // A mutable-reference function called from inside an if block writes a
    // string through the reference; it has to outlive the block's arena.
    mut flag bool = true
    if flag {
        inv.update(0, 5)
    }

    // Same call from inside a loop body.
    mut i int = 0
    for i < 3 {
        inv.update(0, 10 + i)
        i++
    }

    // Churn the arenas so anything freed gets reused.
    mut junk string = ""
    mut j int = 0
    for j < 50 {
        junk = fmt.sprintf("filler %d (in stock) [Lots of text here]", j)
        j++
    }

    if inv.items[0].name == "Laptop Pro 15" {
        passed = passed + 1
    } otherwise {
        println("[FAIL] name was '${inv.items[0].name}', expected 'Laptop Pro 15'")
        failed = failed + 1
    }

    if inv.items[0].qty == 12 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] qty was ${inv.items[0].qty}, expected 12")
        failed = failed + 1
    }

    // A value returned from a mutable-reference function called inside a
    // block must survive the block too.
    mut tag string = ""
    if flag {
        tag = inv.label(0)
    }

    mut k int = 0
    for k < 50 {
        junk = fmt.sprintf("more filler %d [padding padding]", k)
        k++
    }

    if tag == "Laptop Pro 15 x12" {
        passed = passed + 1
    } otherwise {
        println("[FAIL] tag was '${tag}', expected 'Laptop Pro 15 x12'")
        failed = failed + 1
    }

    println("passed: ${passed}")
    println("failed: ${failed}")
}
