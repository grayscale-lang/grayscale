/*
 * pointer_forward_through_call_ok.gray - the pointer-lifetime checks must not
 * flag an address that is passed through a call but never outlives its origin.
 *
 * - reads_through_call: addr() of a local handed to a function that only
 *   dereferences it, result is an i64 -- no address escapes.
 * - returns_safe_pointer: a call whose result is forwarded from a long-lived
 *   pointer argument, not from a local.
 * - wrap_param: a struct literal field initialised from a pointer parameter,
 *   returned inside the struct -- the pointee is the caller's, still alive.
 */

const Box struct {
    p ^i64
}

do sum_at(p ^i64) -> i64 { return p^ }

do pick(a ^i64, b ^i64) -> ^i64 { return a }

do wrap_param(q ^i64) -> Box {
    mut b Box = Box{p: q}
    return b
}

do reads_through_call() -> i64 {
    mut x i64 = 21
    return sum_at(addr(x))
}

do returns_safe_pointer() -> ^i64 {
    mut n ^i64 = new(i64)
    n^ = 42
    return pick(n, n)
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if reads_through_call() == 21 {
        println("  [PASS] addr passed to a reader")
        passed += 1
    } otherwise {
        println("  [FAIL] addr passed to a reader")
        failed += 1
    }

    mut sp ^i64 = returns_safe_pointer()
    if sp^ == 42 {
        println("  [PASS] call result forwarded from a heap pointer")
        passed += 1
    } otherwise {
        println("  [FAIL] call result forwarded from a heap pointer")
        failed += 1
    }

    mut y i64 = 7
    mut w Box = wrap_param(addr(y))
    if w.p^ == 7 {
        println("  [PASS] struct field from a pointer parameter")
        passed += 1
    } otherwise {
        println("  [FAIL] struct field from a pointer parameter")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
