/*
 * flags_enum_max_variants.gray - a #flags enum may have up to 63 variants,
 * one per usable bit of int64. The highest, M62, must be 1 << 62 and stay
 * positive.
 */

#flags
const F enum {
    M0
    M1
    M2
    M3
    M4
    M5
    M6
    M7
    M8
    M9
    M10
    M11
    M12
    M13
    M14
    M15
    M16
    M17
    M18
    M19
    M20
    M21
    M22
    M23
    M24
    M25
    M26
    M27
    M28
    M29
    M30
    M31
    M32
    M33
    M34
    M35
    M36
    M37
    M38
    M39
    M40
    M41
    M42
    M43
    M44
    M45
    M46
    M47
    M48
    M49
    M50
    M51
    M52
    M53
    M54
    M55
    M56
    M57
    M58
    M59
    M60
    M61
    M62
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut top int = int(F.M62)
    if top == 4611686018427387904 {
        println("  [PASS] M62 == 1 << 62")
        passed += 1
    } otherwise {
        println("  [FAIL] M62 == ${top}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
