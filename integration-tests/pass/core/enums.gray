/*
 * enums.gray - Test enum definitions and usage
 */


/* Basic i64 enum (auto-incremented 0, 1, 2, 3) */
const Direction enum {
    NORTH
    EAST
    SOUTH
    WEST
}

/* Flags enum with power-of-2 values (1, 2, 4, 8) */
#flags
const Permissions enum {
    READ      // 1
    WRITE     // 2
    EXECUTE   // 4
    DELETE    // 8
}

/* String enum with explicit values */
const Status enum {
    TODO = "todo"
    IN_PROGRESS = "in_progress"
    DONE = "done"
}

/* Int enum without explicit attribute (auto-detected) */
const Priority enum {
    LOW       // 0
    MEDIUM    // 1
    HIGH      // 2
}

do main() {
    println("=== Enums Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // ==================== BASIC INT ENUM ====================
    println("  -- Basic Int Enum --")

    // Test 1: first enum value is 0
    mut n i64 = cast(Direction.NORTH, i64)
    if n == 0 {
        println("  [PASS] Direction.NORTH = 0")
        passed += 1
    } otherwise {
        println("  [FAIL] Direction.NORTH: expected 0, got ${n}")
        failed += 1
    }

    // Test 2: auto-increment
    mut e i64 = cast(Direction.EAST, i64)
    mut s i64 = cast(Direction.SOUTH, i64)
    mut w i64 = cast(Direction.WEST, i64)
    if e == 1 && s == 2 && w == 3 {
        println("  [PASS] enum auto-increment (1, 2, 3)")
        passed += 1
    } otherwise {
        println("  [FAIL] enum auto-increment")
        failed += 1
    }

    // Test 3: store enum in variable
    mut current i64 = cast(Direction.SOUTH, i64)
    if current == 2 {
        println("  [PASS] enum value in variable")
        passed += 1
    } otherwise {
        println("  [FAIL] enum in variable: expected 2, got ${current}")
        failed += 1
    }

    // ==================== FLAGS ENUM ====================
    println("  -- Flags Enum (power-of-2) --")

    // Test 4: first flag value is 1
    mut r i64 = cast(Permissions.READ, i64)
    if r == 1 {
        println("  [PASS] Permissions.READ = 1")
        passed += 1
    } otherwise {
        println("  [FAIL] Permissions.READ: expected 1, got ${r}")
        failed += 1
    }

    // Test 5: power-of-2 values
    mut wr i64 = cast(Permissions.WRITE, i64)
    if wr == 2 {
        println("  [PASS] Permissions.WRITE = 2")
        passed += 1
    } otherwise {
        println("  [FAIL] Permissions.WRITE: expected 2, got ${wr}")
        failed += 1
    }

    // Test 6: continue power-of-2
    mut ex i64 = cast(Permissions.EXECUTE, i64)
    mut dl i64 = cast(Permissions.DELETE, i64)
    if ex == 4 && dl == 8 {
        println("  [PASS] Permissions.EXECUTE=4, DELETE=8")
        passed += 1
    } otherwise {
        println("  [FAIL] flags enum: EXECUTE=${ex}, DELETE=${dl}")
        failed += 1
    }

    // ==================== STRING ENUM ====================
    println("  -- String Enum --")

    // Test 7: string enum value
    if cast(Status.TODO, string) == "todo" {
        println("  [PASS] Status.TODO = \"todo\"")
        passed += 1
    } otherwise {
        println("  [FAIL] Status.TODO: expected \"todo\", got \"${Status.TODO}\"")
        failed += 1
    }

    // Test 8: other string values
    if cast(Status.IN_PROGRESS, string) == "in_progress" && cast(Status.DONE, string) == "done" {
        println("  [PASS] Status.IN_PROGRESS and DONE")
        passed += 1
    } otherwise {
        println("  [FAIL] string enum values")
        failed += 1
    }

    // Test 9: string enum in variable
    mut current_status string = cast(Status.IN_PROGRESS, string)
    if current_status == "in_progress" {
        println("  [PASS] string enum in variable")
        passed += 1
    } otherwise {
        println("  [FAIL] string enum in variable: got \"${current_status}\"")
        failed += 1
    }

    // ==================== INT ENUM (auto-detected) ====================
    println("  -- Int Enum (auto-detected) --")

    // Test 10: i64 enum auto-increment works without any attribute
    mut lo i64 = cast(Priority.LOW, i64)
    mut md i64 = cast(Priority.MEDIUM, i64)
    mut hi i64 = cast(Priority.HIGH, i64)
    if lo == 0 && md == 1 && hi == 2 {
        println("  [PASS] i64 enum auto-increment (0, 1, 2)")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 enum: LOW=${lo}, MEDIUM=${md}, HIGH=${hi}")
        failed += 1
    }

    // ==================== ENUM COMPARISON ====================
    println("  -- Enum Comparison --")

    // Test 11: compare enum values via i64 variables
    mut priority i64 = cast(Priority.HIGH, i64)
    if priority >= Priority.MEDIUM {
        println("  [PASS] enum comparison (HIGH >= MEDIUM)")
        passed += 1
    } otherwise {
        println("  [FAIL] enum comparison")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
