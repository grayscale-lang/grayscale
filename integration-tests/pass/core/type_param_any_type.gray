const Color enum {
    RED
    GREEN
}

const Point struct {
    x i64
}

alias Num = i64

do mk(T <?>) -> ^? {
    return new(T)
}

do mk_val(T <?>) -> ? {
    return new(T)^
}

do mk_size(T <?>) -> i64 {
    return size_of(T)
}

do wrap(T <?>) -> ^? {
    return mk(T)
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut i ^i64 = mk(i64)
    mut s ^string = mk(string)
    mut f ^f64 = mk(f64)
    mut b ^bool = mk(bool)
    if i^ == 0 && s^ == "" && f^ == 0.0 && b^ == false {
        println("  [PASS] primitive type arguments")
        passed += 1
    } otherwise {
        println("  [FAIL] primitive type arguments")
        failed += 1
    }

    mut c ^Color = mk(Color)
    if c^ == Color.RED {
        println("  [PASS] enum type argument")
        passed += 1
    } otherwise {
        println("  [FAIL] enum type argument")
        failed += 1
    }

    mut p ^Point = mk(Point)
    if p^.x == 0 {
        println("  [PASS] struct type argument still works")
        passed += 1
    } otherwise {
        println("  [FAIL] struct type argument still works")
        failed += 1
    }

    mut n ^i64 = mk(Num)
    if n^ == 0 {
        println("  [PASS] alias of a primitive as a type argument")
        passed += 1
    } otherwise {
        println("  [FAIL] alias of a primitive as a type argument")
        failed += 1
    }

    mut sz i64 = mk_size(i64)
    if sz == 8 {
        println("  [PASS] size_of(T) with a primitive binding")
        passed += 1
    } otherwise {
        println("  [FAIL] size_of(T) with a primitive binding: got ${sz}")
        failed += 1
    }

    mut w ^i64 = wrap(i64)
    if w^ == 0 {
        println("  [PASS] type-parameter forwarding with a primitive binding")
        passed += 1
    } otherwise {
        println("  [FAIL] type-parameter forwarding with a primitive binding")
        failed += 1
    }

    mut v i64 = mk_val(i64)
    if v == 0 {
        println("  [PASS] value-returning type parameter with a primitive")
        passed += 1
    } otherwise {
        println("  [FAIL] value-returning type parameter with a primitive")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
