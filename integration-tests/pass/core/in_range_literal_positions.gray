/*
 * in_range_literal_positions.gray
 * In-range integer literals in the positions covered by the E3036 range
 * check (struct-literal field, map value, default param, return, index
 * assignment, and call argument — plain and struct-function dispatch) must
 * still compile and round-trip.
 */

const S struct {
    b u8
    n i16
}

const V struct {
    n i64

    do take(v V, x i8) -> i8 {
        return x
    }
}

do ret_ok() -> u8 {
    return 255
}

do with_default(b u8 = 200) -> u8 {
    return b
}

do sink(a i64, x i8) -> i8 {
    return x
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut s S = S{ b: 250, n: -32000 }
    mut m map[string:u8] = {"a": 100}
    mut xs [u8] = {1, 2}
    xs[0] = 254
    mut mm map[string:u8] = {:}
    mm["k"] = 255

    mut v V = V{ n: 0 }

    if s.b == 250 && s.n == -32000 && m["a"] == 100 && xs[0] == 254 &&
       mm["k"] == 255 && ret_ok() == 255 && with_default() == 200 &&
       sink(1, 127) == 127 && sink(1, -128) == -128 &&
       V.take(v, 100) == 100 && v.take(-100) == -100 {
        println("  [PASS] in-range literals accepted in all positions")
        passed += 1
    } otherwise {
        println("  [FAIL] ${s.b} ${s.n} ${m["a"]} ${xs[0]} ${mm["k"]} ${ret_ok()} ${with_default()}")
        failed += 1
    }

    println("Passed: ${passed}, Failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
