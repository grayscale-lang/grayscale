/*
 * Pass Test: file-scope const declarations can reference other const
 * variables in arithmetic expressions, and the folded values are correct.
 */

const BASE i64 = 10
const STEP i64 = 3
const NEXT i64 = BASE + STEP
const PRODUCT i64 = BASE * STEP
const NESTED i64 = (NEXT - STEP) * 2

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if NEXT == 13 {
        passed += 1
    } otherwise {
        println("[FAIL] NEXT: ${NEXT}")
        failed += 1
    }
    if PRODUCT == 30 {
        passed += 1
    } otherwise {
        println("[FAIL] PRODUCT: ${PRODUCT}")
        failed += 1
    }
    if NESTED == 20 {
        passed += 1
    } otherwise {
        println("[FAIL] NESTED: ${NESTED}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
