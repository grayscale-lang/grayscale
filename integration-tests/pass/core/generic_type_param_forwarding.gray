/*
 * Test: generic type parameter forwarding between functions
 * Verifies that a generic parameter can be forwarded through nested generic calls.
 */

const Point struct {
    x i64
    y i64
}

do make(kind generic) -> ^kind {
    return new(kind)
}

do wrap(kind generic) -> ^kind {
    return make(kind)
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut p = wrap(Point)
    p^.x = 42
    p^.y = 7

    if p^.x == 42 { passed = passed + 1 } otherwise { failed = failed + 1 }
    if p^.y == 7  { passed = passed + 1 } otherwise { failed = failed + 1 }

    println("passed: ${passed}/${passed + failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
