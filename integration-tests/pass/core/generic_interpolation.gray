/*
 * generic_interpolation.gray - generic-typed params in string interpolation
 *
 * A parameter typed by a generic name used inside "${x}" must be formatted
 * for the type it is bound to, not defaulted to an integer, which would emit
 * C that fails to compile for types like string, f64, bool.
 */

do show_int(kind generic, x kind) -> string {
    return "value=${x}"
}

do show_float(kind generic, x kind) -> string {
    return "value=${x}"
}

do show_string(kind generic, x kind) -> string {
    return "value=${x}"
}

do show_bool(kind generic, x kind) -> string {
    return "value=${x}"
}

do describe(kind generic, x kind) -> string {
    return "item=${x}"
}

do main() {
    println("=== Generic Interpolation Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: i64 generic in interpolation
    mut r1 string = show_int(i64, 42)
    if r1 == "value=42" {
        println("  [PASS] generic i64 interpolation")
        passed += 1
    } otherwise {
        println("  [FAIL] generic i64: got '${r1}'")
        failed += 1
    }

    // Test 2: f64 generic in interpolation
    mut r2 string = show_float(f64, 3.14)
    if r2 == "value=3.140000" || r2 == "value=3.14" {
        println("  [PASS] generic f64 interpolation")
        passed += 1
    } otherwise {
        println("  [FAIL] generic f64: got '${r2}'")
        failed += 1
    }

    // Test 3: string generic in interpolation
    mut r3 string = show_string(string, "hello")
    if r3 == "value=hello" {
        println("  [PASS] generic string interpolation")
        passed += 1
    } otherwise {
        println("  [FAIL] generic string: got '${r3}'")
        failed += 1
    }

    // Test 4: bool generic in interpolation
    mut r4 string = show_bool(bool, true)
    if r4 == "value=true" {
        println("  [PASS] generic bool interpolation")
        passed += 1
    } otherwise {
        println("  [FAIL] generic bool: got '${r4}'")
        failed += 1
    }

    // Test 5: same generic fn reused with i64 then string
    mut r5a string = describe(i64, 99)
    mut r5b string = describe(string, "abc")
    if r5a == "item=99" && r5b == "item=abc" {
        println("  [PASS] same generic fn, different concrete types")
        passed += 1
    } otherwise {
        println("  [FAIL] describe: got '${r5a}' and '${r5b}'")
        failed += 1
    }

    // Test 6: generic bool false interpolation
    mut r6 string = show_bool(bool, false)
    if r6 == "value=false" {
        println("  [PASS] generic bool false interpolation")
        passed += 1
    } otherwise {
        println("  [FAIL] generic bool false: got '${r6}'")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
