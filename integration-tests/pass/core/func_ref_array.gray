/*
 * func_ref_array.gray - Arrays of function references [func]
 *
 * A [func] array stores function references of any signature. The elements
 * cannot be called, since no signature is known to check the call against.
 * Covers literal, empty literal + append, for_each, and element assignment.
 */

import @arrays

do add(a i64, b i64) -> i64 { return a + b }
do sub(a i64, b i64) -> i64 { return a - b }
do mul(a i64, b i64) -> i64 { return a * b }

do is_pos(n i64) -> bool { return n > 0 }
do is_neg(n i64) -> bool { return n < 0 }

do main() {
    println("=== [func] Array Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // -- literal with inferred func element type --
    mut ops [func] = {()add, ()sub, ()mul}
    if len(ops) == 3 {
        println("  [PASS] literal [func]")
        passed += 1
    } otherwise {
        println("  [FAIL] literal [func]")
        failed += 1
    }

    // -- empty literal, declared [func], append --
    mut preds [func] = {}
    arrays.append(preds, ()is_pos)
    arrays.append(preds, ()is_neg)
    if len(preds) == 2 {
        println("  [PASS] empty [func] literal + append")
        passed += 1
    } otherwise {
        println("  [FAIL] empty [func] literal + append")
        failed += 1
    }

    // -- for_each over [func] --
    mut visited i64 = 0
    for_each _ in ops {
        visited += 1
    }
    if visited == 3 {
        println("  [PASS] for_each over [func]")
        passed += 1
    } otherwise {
        println("  [FAIL] for_each over [func]: got ${visited}")
        failed += 1
    }

    // -- element assignment --
    ops[0] = ()mul
    if len(ops) == 3 {
        println("  [PASS] [func] element reassignment")
        passed += 1
    } otherwise {
        println("  [FAIL] [func] element reassignment")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
