/*
 * Test: wildcard (?) struct functions monomorphize per concrete argument
 * type, via type-qualified calls and instance dispatch, across two
 * structs in one file.
 */

const Box struct {
    value int

    do identity(val ?) -> ? {
        return val
    }

    do wrap(self Box, val ?) -> ? {
        return val
    }
}

const Pair struct {
    first int
    second int

    do pick(index int, a ?, b ?) -> ? {
        if index == 0 {
            return a
        }
        return b
    }
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut b = Box { value: 10 }

    mut r1 int = Box.identity(42)
    mut r2 string = Box.identity("hello")
    mut r3 bool = Box.identity(true)
    mut r4 float = Box.identity(3.5)
    if r1 == 42 && r2 == "hello" && r3 == true && r4 == 3.5 {
        passed += 1
    } otherwise {
        println("[FAIL] type-qualified wildcard calls")
        failed += 1
    }

    mut r5 int = b.wrap(99)
    mut r6 string = b.wrap("world")
    if r5 == 99 && r6 == "world" {
        passed += 1
    } otherwise {
        println("[FAIL] instance-dispatch wildcard calls")
        failed += 1
    }

    mut r7 int = Pair.pick(0, 10, 20)
    mut r8 string = Pair.pick(1, "left", "right")
    if r7 == 10 && r8 == "right" {
        passed += 1
    } otherwise {
        println("[FAIL] second struct wildcard calls")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
