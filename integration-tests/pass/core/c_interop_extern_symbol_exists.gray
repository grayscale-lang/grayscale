/*
 * c_interop_extern_symbol_exists.gray - valid extern.func() calls and
 * extern.CONST accesses, including a function-like macro (toupper/isdigit
 * are macros on some libc implementations) called with real parens, all
 * compile and run without the E5052 "unknown C symbol" check misfiring.
 */

extern import "stdio.h"
extern import "stdlib.h"
extern import "math.h"
extern import "ctype.h"

do main() {
    mut passed int = 0
    mut failed int = 0

    extern.printf("  [ran] extern.printf\n")
    passed += 1

    mut e int = extern.EXIT_SUCCESS
    if e == 0 {
        passed += 1
    } otherwise {
        failed += 1
    }

    mut r float = extern.sqrt(4.0)
    if r == 2.0 {
        passed += 1
    } otherwise {
        failed += 1
    }

    mut c int = extern.toupper(97)
    if c == 65 {
        passed += 1
    } otherwise {
        failed += 1
    }

    mut ok int = extern.isdigit(53)
    if ok != 0 {
        passed += 1
    } otherwise {
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
