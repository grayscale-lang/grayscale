import @arrays

const Item struct {
    kind int
    value int
}

do add_item(&items [Item], item Item) -> int {
    idx int = len(items)
    arrays.append(items, item)
    return idx
}

do insert_front(&items [Item], item Item) {
    arrays.insert_at(items, 0, item)
}

// Every mutation happens inside a helper called from an if block, so the
// growth must land in the array's own arena, not the if block's.
do build() -> [Item] {
    mut items [Item] = {}
    mut i int = 0
    for i < 6 {
        if i < 3 {
            _ = add_item(items, Item{kind: 1, value: i * 10})
        }
        if i >= 3 {
            _ = add_item(items, Item{kind: 2, value: i * 100})
        }
        i++
    }
    return items
}

do main() {
    mut passed int = 0
    mut failed int = 0

    mut items [Item] = build()

    if len(items) == 6 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] expected 6 items, got ${len(items)}")
        failed = failed + 1
    }

    mut i int = 0
    for i < len(items) {
        item Item = items[i]
        mut want_kind int = 2
        mut want_value int = i * 100
        if i < 3 {
            want_kind = 1
            want_value = i * 10
        }
        if item.kind == want_kind {
            passed = passed + 1
        } otherwise {
            println("[FAIL] items[${i}].kind was ${item.kind}, expected ${want_kind}")
            failed = failed + 1
        }
        if item.value == want_value {
            passed = passed + 1
        } otherwise {
            println("[FAIL] items[${i}].value was ${item.value}, expected ${want_value}")
            failed = failed + 1
        }
        i++
    }

    // insert_at grows the same way and must survive the block it ran in
    mut j int = 0
    for j < 5 {
        if j >= 0 {
            insert_front(items, Item{kind: 3, value: j})
        }
        j++
    }

    if len(items) == 11 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] expected 11 items after inserts, got ${len(items)}")
        failed = failed + 1
    }

    if items[0].kind == 3 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] items[0].kind was ${items[0].kind}, expected 3")
        failed = failed + 1
    }

    if items[10].kind == 2 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] items[10].kind was ${items[10].kind}, expected 2")
        failed = failed + 1
    }

    println("passed: ${passed}")
    println("failed: ${failed}")
}
