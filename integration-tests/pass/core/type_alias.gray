/*
 * type_alias.gray - Test type alias declarations
 */

/* Basic primitive alias */
alias Meters = f64
alias Count = i64
alias Flag = bool
alias Name = string

/* Alias of collection types */
alias Numbers = [i64]
alias Names = [string]
alias Lookup = map[string:i64]

/* Struct with alias */
const Point struct {
    x i64,
    y i64
}
alias Vec2 = Point

/* Enum with alias */
const Color enum {
    RED,
    GREEN,
    BLUE
}
alias Hue = Color

/* Chained alias */
alias Distance = Meters
alias Length = Distance

/* Private alias (accessible within same file) */
private alias Secret = i64

/* Chained struct alias */
alias Spot = Vec2

do sum_point(p Point) -> i64 {
    return p.x + p.y
}

do main() {
    /* Primitive aliases */
    mut d Meters = 10.5
    assert(type_of(d) == "f64", "Meters should resolve to f64")

    mut c Count = 42
    assert(type_of(c) == "i64", "Count should resolve to i64")

    mut f Flag = true
    assert(type_of(f) == "bool", "Flag should resolve to bool")

    mut n Name = "hello"
    assert(type_of(n) == "string", "Name should resolve to string")

    /* Collection aliases */
    mut nums Numbers = {1, 2, 3}
    assert(len(nums) == 3, "Numbers array should have 3 elements")

    mut names Names = {"alice", "bob"}
    assert(len(names) == 2, "Names array should have 2 elements")

    mut lk Lookup = {"a": 1, "b": 2}
    assert(len(lk) == 2, "Lookup map should have 2 entries")

    /* Struct alias */
    mut p Vec2 = Point{x: 5, y: 10}
    assert(p.x == 5, "Vec2 alias should work for struct access")
    assert(p.y == 10, "Vec2 alias should work for struct access")

    /* Struct alias as a constructor */
    mut v Vec2 = Vec2{x: 7, y: 8}
    assert(v.x == 7, "Vec2 alias should work as a struct constructor")
    assert(v.y == 8, "Vec2 alias should work as a struct constructor")
    assert(type_of(v) == "Point", "Vec2 constructor should build a Point")

    /* Chained struct alias as a constructor */
    mut v2 Spot = Spot{x: 1, y: 2}
    assert(v2.x == 1, "chained struct alias should work as a constructor")

    /* Struct alias constructor passed where the struct is expected */
    assert(sum_point(Vec2{x: 2, y: 3}) == 5, "alias constructor should pass as Point")

    /* Struct alias with new() */
    mut q ^Vec2 = new(Vec2)
    q^.x = 3
    q^.y = 4
    assert(q^.x == 3, "Vec2 alias should work with new()")

    /* Enum alias */
    mut color Hue = Hue.RED
    assert(color == Color.RED, "Hue alias should resolve to Color enum")

    mut green Hue = Hue.GREEN
    assert(green == Color.GREEN, "Hue.GREEN should equal Color.GREEN")

    /* Chained alias */
    mut dist Distance = 100.0
    assert(type_of(dist) == "f64", "Distance should chain-resolve to f64")

    mut len_ Length = 200.0
    assert(type_of(len_) == "f64", "Length should chain-resolve to f64")

    /* Private alias (same file access) */
    mut s Secret = 999
    assert(type_of(s) == "i64", "Secret should resolve to i64")

    /* type_of returns underlying type */
    mut m Meters = 42.5
    assert(type_of(m) == "f64", "type_of should return underlying type, not alias")

    println("ALL TESTS PASSED")
}
