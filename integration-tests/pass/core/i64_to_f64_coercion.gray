/*
 * int_to_float_coercion.gray - Implicit i64 → f64 promotion.
 *
 * integer literals and i64-typed values assigned to
 * f64/f32/f64 variables, struct fields, map values, and return
 * positions are accepted without explicit casts. C handles the
 * promotion natively.
 *
 * Note: array literals (`[f64] = {1, 2}`) pass typechecking but
 * codegen picks the array constructor based on the first element's
 * resolved type (i64), producing wrong storage. That's tracked as
 * a follow-up and intentionally not tested here.
 */

do takes_float(x f64) -> f64 {
    return x + 0.5
}

do main() {
    println("=== Int-to-Float Coercion Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // -- var_decl: i64 literal to f64 --
    mut x f64 = 5
    if x == 5.0 {
        println("  [PASS] mut x f64 = 5 → 5.0")
        passed += 1
    } otherwise {
        println("  [FAIL] x = ${x}")
        failed += 1
    }

    // -- var_decl: i64 literal to f32 --
    mut y f32 = 1
    if y == 1.0 {
        println("  [PASS] mut y f32 = 1 → 1.0")
        passed += 1
    } otherwise {
        println("  [FAIL] y = ${y}")
        failed += 1
    }

    // -- reassignment: i64 to f64 var --
    x = 42
    if x == 42.0 {
        println("  [PASS] x = 42 (reassign) → 42.0")
        passed += 1
    } otherwise {
        println("  [FAIL] reassign x = ${x}")
        failed += 1
    }

    // -- function argument: i64 to f64 param --
    if takes_float(7) == 7.5 {
        println("  [PASS] takes_float(7) → 7.5")
        passed += 1
    } otherwise {
        println("  [FAIL] takes_float(7)")
        failed += 1
    }

    // -- i64-typed variable to f64 --
    mut n i64 = 100
    mut z f64 = n
    if z == 100.0 {
        println("  [PASS] mut z f64 = n (i64 var) → 100.0")
        passed += 1
    } otherwise {
        println("  [FAIL] z = ${z}")
        failed += 1
    }

    // -- map literal: i64 value in f64-typed map --
    mut m map[string:f64] = {"pi": 3, "e": 2}
    if m["pi"] == 3.0 && m["e"] == 2.0 {
        println("  [PASS] map[string:f64] with i64 values")
        passed += 1
    } otherwise {
        println("  [FAIL] map values")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
