/* Test: a single named return value is returned by name. */

do get_user_name() -> (name string) {
    mut name string = "Alice"
    return name
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if get_user_name() == "Alice" {
        passed += 1
    } otherwise {
        println("[FAIL] named return value: ${get_user_name()}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
