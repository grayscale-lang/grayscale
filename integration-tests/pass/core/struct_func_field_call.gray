do double(n i64) -> i64 { return n * 2 }
do triple(n i64) -> i64 { return n * 3 }

const Wrapper struct {
    f func(i64) -> i64
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut w = new(Wrapper)
    w.f = ()double
    mut r i64 = w.f(5)
    if r == 10 {
        println("  [PASS] new() struct func field call")
        passed += 1
    } otherwise {
        println("  [FAIL] new() struct func field call: expected 10, got ${r}")
        failed += 1
    }

    const w2 = Wrapper{f: ()triple}
    mut r2 i64 = w2.f(5)
    if r2 == 15 {
        println("  [PASS] struct literal func field call")
        passed += 1
    } otherwise {
        println("  [FAIL] struct literal func field call: expected 15, got ${r2}")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
