/*
 * Test: eprint accepts every primitive type without a format string and
 * returns control (output goes to stderr, so this test only asserts that
 * the calls run to completion).
 */

do main() {
    eprint(42)
    eprint(" ")
    eprint(3.14)
    eprint(" ")
    eprint(true)
    eprint(" ")
    eprint(false)
    eprint(" ")
    eprint('c')
    eprint(" ")
    eprint("done")
    eprintln("")

    println("Results: 1 passed, 0 failed")
    println("ALL TESTS PASSED")
}
