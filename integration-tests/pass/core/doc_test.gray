/*
 * doc_test.gray - #doc attribute (with and without a description text) on
 * functions, structs, and enums compiles, and the annotated declarations
 * behave normally.
 */

import @arrays

#doc("Adds two integers and returns the sum")
do add(a i64, b i64) -> i64 {
    return a + b
}

#doc("Multiplies a number by two")
do double(n i64) -> i64 {
    return n * 2
}

#doc
do helper() -> i64 {
    return 7
}

#doc("Represents a person with name and age")
const Person struct {
    name string
    age i64
}

#doc("Task status values")
const Status enum {
    PENDING
    ACTIVE
    DONE
}

#doc("Permission flags for access control")
#flags
const Permissions enum {
    READ
    WRITE
    EXECUTE
}

do main() {
    mut fails [string] = {}

    if add(2, 3) != 5 {
        arrays.append(fails, "add")
    }
    if double(21) != 42 {
        arrays.append(fails, "double")
    }
    if helper() != 7 {
        arrays.append(fails, "helper")
    }

    mut p Person = Person{name: "Ada", age: 30}
    if p.name != "Ada" || p.age != 30 {
        arrays.append(fails, "Person")
    }

    mut s Status = Status.ACTIVE
    if s != Status.ACTIVE || s == Status.DONE {
        arrays.append(fails, "Status")
    }

    mut perm Permissions = Permissions.WRITE
    if perm != Permissions.WRITE {
        arrays.append(fails, "Permissions")
    }

    for_each name in fails {
        println("[FAIL] ${name}")
    }
    println("Results: ${6 - len(fails)} passed, ${len(fails)} failed")
    if len(fails) > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
