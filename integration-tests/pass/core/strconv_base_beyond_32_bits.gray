// Test: strconv.to_i64 and to_u64 reject a base that only fits once narrowed to 32 bits
import @strconv

do main() {
    mut base i64 = 4294967298

    mut v, err = strconv.to_i64("11", base)
    if err != nil && v == 0 {
        println("  [PASS] to_i64 rejects base 2^32 + 2")
    } else {
        println("  [FAIL] to_i64 rejects base 2^32 + 2")
    }

    mut u, uerr = strconv.to_u64("11", base)
    if uerr != nil && u == 0 {
        println("  [PASS] to_u64 rejects base 2^32 + 2")
    } else {
        println("  [FAIL] to_u64 rejects base 2^32 + 2")
    }
}
