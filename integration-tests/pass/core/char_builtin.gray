/*
 * Test: char() builtin — converts an integer codepoint to a char value.
 * Accepts i64 and u8 arguments; the result compares against char literals.
 */

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    if char(65) == 'A' {
        passed += 1
    } otherwise {
        println("[FAIL] char(65) == 'A'")
        failed += 1
    }

    mut b char = char(66)
    if b == 'B' {
        passed += 1
    } otherwise {
        println("[FAIL] char(66) assigned to a variable")
        failed += 1
    }

    mut n i64 = 67
    if char(n) == 'C' {
        passed += 1
    } otherwise {
        println("[FAIL] char() of an i64 variable")
        failed += 1
    }

    mut by u8 = 68
    if char(by) == 'D' {
        passed += 1
    } otherwise {
        println("[FAIL] char() of a u8 variable")
        failed += 1
    }

    // Codepoint outside ASCII: ☺ is U+263A. Round-trips through i64().
    if cast(char(0x263A), i64) == 0x263A {
        passed += 1
    } otherwise {
        println("[FAIL] char() of a non-ASCII codepoint round-trips")
        failed += 1
    }

    if type_of(char(65)) == "char" {
        passed += 1
    } otherwise {
        println("[FAIL] type_of(char(...)) is 'char'")
        failed += 1
    }

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
