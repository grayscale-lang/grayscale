import @arrays

const Node struct {
    val i64
    name string
    children [i64]
}

do make_node(v i64) -> ^Node {
    mut n = new(Node)
    n.val = v
    n.name = "node"
    arrays.append(n.children, v)
    return n
}

do test() -> ^Node {
    mut left = make_node(0)
    mut i i64 = 0
    as_long_as i < 3 {
        left = make_node(i)
        i = i + 1
    }
    return left
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut result = test()
    if result.val == 2 {
        passed = passed + 1
    } otherwise {
        println("[FAIL] expected val 2, got ${result.val}")
        failed = failed + 1
    }

    println("passed: ${passed}")
    println("failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
