/*
 * raw_pointer.gray - raw() returns a pointer with no nil check
 * and no const-source protection.
 */

const Point struct {
    x i64
    y i64
}

do main() {
    println("=== raw() pointer tests ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: raw() on a const var, write through it (bypasses const_source)
    const val i64 = 10
    mut p ^i64 = raw(val)
    p^ = 99
    if p^ == 99 {
        println("  [PASS] write through raw(const) pointer")
        passed += 1
    } otherwise {
        println("  [FAIL] write through raw(const) pointer")
        failed += 1
    }

    // Test 2: raw() on a mut var, basic dereference
    mut x i64 = 42
    mut q ^i64 = raw(x)
    if q^ == 42 {
        println("  [PASS] read through raw(mut) pointer")
        passed += 1
    } otherwise {
        println("  [FAIL] read through raw(mut) pointer")
        failed += 1
    }

    // Test 3: raw() on a struct, field access through pointer
    mut pt Point = Point{ x: 1, y: 2 }
    mut sp ^Point = raw(pt)
    sp.x = 100
    if sp.x == 100 {
        println("  [PASS] write struct field through raw pointer")
        passed += 1
    } otherwise {
        println("  [FAIL] write struct field through raw pointer")
        failed += 1
    }

    // Test 4: raw() with explicit deref field access (p^.field)
    sp^.y = 200
    if sp^.y == 200 {
        println("  [PASS] write struct field via p^.field with raw pointer")
        passed += 1
    } otherwise {
        println("  [FAIL] write struct field via p^.field with raw pointer")
        failed += 1
    }

    // Test 5: addr() still nil-checks (ensure raw didn't break addr)
    mut z i64 = 7
    mut ap ^i64 = addr(z)
    if ap^ == 7 {
        println("  [PASS] addr() still works correctly")
        passed += 1
    } otherwise {
        println("  [FAIL] addr() still works correctly")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        panic("raw pointer tests failed")
    }
}
