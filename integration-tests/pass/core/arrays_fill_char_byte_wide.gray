import @arrays

do main() {
    mut passed int = 0
    mut failed int = 0

    // char fill
    mut cs [char] = {}
    arrays.fill(cs, 'X', 3)
    if len(cs) == 3 {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
    }

    // byte fill
    mut barr [byte] = {}
    arrays.fill(barr, cast(0xAB, byte), 2)
    if len(barr) == 2 {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
    }

    // i128 fill — cast form
    mut i128s [i128] = {}
    arrays.fill(i128s, cast(42, i128), 3)
    if len(i128s) == 3 && i128s[0] == i128(42) && i128s[2] == i128(42) {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
    }

    // i128 fill — bare literal value (previously emitted invalid C)
    mut i128b [i128] = {}
    arrays.fill(i128b, 7, 2)
    if len(i128b) == 2 && i128b[0] == i128(7) && i128b[1] == i128(7) {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
    }

    // u256 fill — bare literal value
    mut u256s [u256] = {}
    arrays.fill(u256s, 7, 2)
    if len(u256s) == 2 && u256s[0] == u256(7) && u256s[1] == u256(7) {
        passed = passed + 1
    } otherwise {
        failed = failed + 1
    }

    println("passed: ${passed}")
    println("failed: ${failed}")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
