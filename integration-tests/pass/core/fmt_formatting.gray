/*
 * fmt_formatting.gray - Integration tests for @fmt formatting functions
 * Tests: sprintf, pad_left, pad_right, center,
 *        i64_to_hex, i64_to_binary, i64_to_octal,
 *        f64_to_fixed, f64_to_scientific
 */

import @fmt

do main() {
    println("=== Fmt Formatting Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: sprintf with string and i64
    mut s1 string = fmt.sprintf("Hello %s, you are %d", "Alice", 30)
    if s1 == "Hello Alice, you are 30" {
        println("  [PASS] sprintf with string and i64")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf: got '${s1}'")
        failed += 1
    }

    // Test 2: sprintf with no extra args
    mut s2 string = fmt.sprintf("plain text")
    if s2 == "plain text" {
        println("  [PASS] sprintf with no args")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf no args: got '${s2}'")
        failed += 1
    }

    // Test 3: pad_left
    mut pl string = fmt.pad_left("42", 8, '0')
    if pl == "00000042" {
        println("  [PASS] pad_left")
        passed += 1
    } otherwise {
        println("  [FAIL] pad_left: got '${pl}'")
        failed += 1
    }

    // Test 4: pad_left when string already wider
    mut pl2 string = fmt.pad_left("longstring", 4, '0')
    if pl2 == "longstring" {
        println("  [PASS] pad_left no-op")
        passed += 1
    } otherwise {
        println("  [FAIL] pad_left no-op: got '${pl2}'")
        failed += 1
    }

    // Test 5: pad_right
    mut pr string = fmt.pad_right("hi", 6, '.')
    if pr == "hi...." {
        println("  [PASS] pad_right")
        passed += 1
    } otherwise {
        println("  [FAIL] pad_right: got '${pr}'")
        failed += 1
    }

    // Test 6: pad_right when string already wider
    mut pr2 string = fmt.pad_right("longstring", 4, '.')
    if pr2 == "longstring" {
        println("  [PASS] pad_right no-op")
        passed += 1
    } otherwise {
        println("  [FAIL] pad_right no-op: got '${pr2}'")
        failed += 1
    }

    // Test 7: center
    mut ct string = fmt.center("hi", 8, '-')
    if ct == "---hi---" {
        println("  [PASS] center")
        passed += 1
    } otherwise {
        println("  [FAIL] center: got '${ct}'")
        failed += 1
    }

    // Test 8: center with odd padding
    mut ct2 string = fmt.center("hi", 7, '-')
    if ct2 == "--hi---" {
        println("  [PASS] center odd padding")
        passed += 1
    } otherwise {
        println("  [FAIL] center odd: got '${ct2}'")
        failed += 1
    }

    // Test 9: center no-op
    mut ct3 string = fmt.center("longstring", 4, '-')
    if ct3 == "longstring" {
        println("  [PASS] center no-op")
        passed += 1
    } otherwise {
        println("  [FAIL] center no-op: got '${ct3}'")
        failed += 1
    }

    // Test 10: i64_to_hex
    mut hex string = fmt.i64_to_hex(255)
    if hex == "ff" {
        println("  [PASS] i64_to_hex")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_hex: got '${hex}'")
        failed += 1
    }

    // Test 11: i64_to_hex zero
    mut hex0 string = fmt.i64_to_hex(0)
    if hex0 == "0" {
        println("  [PASS] i64_to_hex zero")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_hex zero: got '${hex0}'")
        failed += 1
    }

    // Test 12: i64_to_binary
    mut bin string = fmt.i64_to_binary(10)
    if bin == "1010" {
        println("  [PASS] i64_to_binary")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_binary: got '${bin}'")
        failed += 1
    }

    // Test 13: i64_to_binary zero
    mut bin0 string = fmt.i64_to_binary(0)
    if bin0 == "0" {
        println("  [PASS] i64_to_binary zero")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_binary zero: got '${bin0}'")
        failed += 1
    }

    // Test 14: i64_to_binary power of 2
    mut bin8 string = fmt.i64_to_binary(128)
    if bin8 == "10000000" {
        println("  [PASS] i64_to_binary 128")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_binary 128: got '${bin8}'")
        failed += 1
    }

    // Test 15: i64_to_octal
    mut oct string = fmt.i64_to_octal(8)
    if oct == "10" {
        println("  [PASS] i64_to_octal")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_octal: got '${oct}'")
        failed += 1
    }

    // Test 16: i64_to_octal zero
    mut oct0 string = fmt.i64_to_octal(0)
    if oct0 == "0" {
        println("  [PASS] i64_to_octal zero")
        passed += 1
    } otherwise {
        println("  [FAIL] i64_to_octal zero: got '${oct0}'")
        failed += 1
    }

    // Test 17: f64_to_fixed
    mut ff string = fmt.f64_to_fixed(3.14159, 2)
    if ff == "3.14" {
        println("  [PASS] f64_to_fixed")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_fixed: got '${ff}'")
        failed += 1
    }

    // Test 18: f64_to_fixed zero decimals
    mut ff0 string = fmt.f64_to_fixed(3.14159, 0)
    if ff0 == "3" {
        println("  [PASS] f64_to_fixed zero decimals")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_fixed 0 dec: got '${ff0}'")
        failed += 1
    }

    // Test 19: f64_to_scientific
    mut fs string = fmt.f64_to_scientific(1230.0)
    if fs == "1.230000e+03" {
        println("  [PASS] f64_to_scientific")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_scientific: got '${fs}'")
        failed += 1
    }

    // Test 20: f64_to_scientific small number
    mut fs2 string = fmt.f64_to_scientific(0.00123)
    if fs2 == "1.230000e-03" {
        println("  [PASS] f64_to_scientific small")
        passed += 1
    } otherwise {
        println("  [FAIL] f64_to_scientific small: got '${fs2}'")
        failed += 1
    }

    // Test 21: %b directive formats bool as true/false
    mut b1 string = fmt.sprintf("%b", true)
    if b1 == "true" {
        println("  [PASS] %b true")
        passed += 1
    } otherwise {
        println("  [FAIL] %b true: got '${b1}'")
        failed += 1
    }

    // Test 22: %b directive with false
    mut b2 string = fmt.sprintf("%b", false)
    if b2 == "false" {
        println("  [PASS] %b false")
        passed += 1
    } otherwise {
        println("  [FAIL] %b false: got '${b2}'")
        failed += 1
    }

    // Test 23: multiple %b directives don't desync later directives
    mut b3 string = fmt.sprintf("t=%b f=%b n=%d", true, false, 42)
    if b3 == "t=true f=false n=42" {
        println("  [PASS] %b does not desync following directives")
        passed += 1
    } otherwise {
        println("  [FAIL] %b desync: got '${b3}'")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        panic("Some tests failed!")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
