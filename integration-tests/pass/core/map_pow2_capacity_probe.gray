/*
 * map_pow2_capacity_probe.gray - map capacity is rounded to a power of two
 *
 * The probe loop masks (idx & (capacity - 1)) instead of taking a modulo,
 * which is only correct when capacity is a power of two. A map literal with
 * more than four entries used to get capacity = count * 2 (e.g. 10, 12),
 * which is not a power of two. These cases exercise odd-sized literals,
 * rebuild-on-grow, and tombstone reclamation so a wrong mask would surface
 * as a lost or duplicated key.
 */

import @maps

do main() {
    println("=== Map Pow2 Capacity Probe Test ===")
    mut passed int = 0
    mut failed int = 0

    // -- literal with 5 entries (old capacity 10, not a power of two) --
    mut five map[string:int] = {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5}
    mut ok bool = len(five) == 5
    ok = ok && five["a"] == 1 && five["b"] == 2 && five["c"] == 3
    ok = ok && five["d"] == 4 && five["e"] == 5
    if ok {
        println("  [PASS] 5-entry literal reads back every key")
        passed += 1
    } otherwise {
        println("  [FAIL] 5-entry literal: len ${len(five)}")
        failed += 1
    }

    // -- literal with 7 entries (old capacity 14) --
    mut seven map[int:int] = {10: 100, 20: 200, 30: 300, 40: 400, 50: 500, 60: 600, 70: 700}
    mut sum int = 0
    for_each k in seven {
        sum = sum + seven[k]
    }
    if len(seven) == 7 && sum == 2800 {
        println("  [PASS] 7-entry literal iterates and sums correctly")
        passed += 1
    } otherwise {
        println("  [FAIL] 7-entry literal: len ${len(seven)} sum ${sum}")
        failed += 1
    }

    // -- grow across several rebuilds, then verify all keys survive --
    mut big map[int:int] = {0: 0}
    for i in range(1, 500) {
        big[i] = i * 3
    }
    mut grow_ok bool = len(big) == 500
    for i in range(0, 500) {
        if big[i] != i * 3 {
            grow_ok = false
        }
    }
    if grow_ok {
        println("  [PASS] 500 inserts across rebuilds keep every key")
        passed += 1
    } otherwise {
        println("  [FAIL] grow across rebuilds lost or corrupted a key")
        failed += 1
    }

    // -- churn: insert/remove to build tombstones and force a same-cap rebuild --
    mut churn map[int:int] = {1: 1}
    for i in range(0, 2000) {
        churn[i] = i
        if i >= 8 {
            maps.remove_key(churn, i - 8)
        }
    }
    mut churn_ok bool = true
    for i in range(1992, 2000) {
        if !maps.has_key(churn, i) || churn[i] != i {
            churn_ok = false
        }
    }
    churn_ok = churn_ok && !maps.has_key(churn, 0) && !maps.has_key(churn, 1000)
    if churn_ok {
        println("  [PASS] insert/remove churn keeps the live window intact")
        passed += 1
    } otherwise {
        println("  [FAIL] churn corrupted the live window")
        failed += 1
    }

    // -- string keys with a non-power-of-two literal size --
    mut names map[string:string] = {
        "one": "1", "two": "2", "three": "3",
        "four": "4", "five": "5", "six": "6"
    }
    names["seven"] = "7"
    maps.remove_key(names, "four")
    mut str_ok bool = len(names) == 6 && names["one"] == "1" && names["seven"] == "7"
    str_ok = str_ok && !maps.has_key(names, "four") && names["six"] == "6"
    if str_ok {
        println("  [PASS] string-keyed odd-sized literal after add/remove")
        passed += 1
    } otherwise {
        println("  [FAIL] string-keyed map wrong after add/remove")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
