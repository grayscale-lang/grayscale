/*
 * typed-func-pointers.gray - Test function pointer calls with properly
 * typed arguments.
 */


do double_it(n i64) -> i64 {
    return n * 2
}

do add(a i64, b i64) -> i64 {
    return a + b
}

do main() {
    println("=== Typed Function Pointers ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: Function pointer with i64 arg and i64 return
    const fn_dbl = ()double_it
    mut result i64 = fn_dbl(21)
    if result == 42 {
        println("  [PASS] func ptr with i64 arg and return")
        passed += 1
    } otherwise {
        println("  [FAIL] func ptr with i64 arg and return")
        failed += 1
    }

    // Test 2: Function pointer with multiple args
    const fn_add = ()add
    mut sum i64 = fn_add(17, 25)
    if sum == 42 {
        println("  [PASS] func ptr with multiple i64 args")
        passed += 1
    } otherwise {
        println("  [FAIL] func ptr with multiple i64 args")
        failed += 1
    }

    // Test 3: Call function pointer stored in variable
    const fn_ref = ()add
    mut val i64 = fn_ref(3, 7)
    if val == 10 {
        println("  [PASS] func ptr call from variable")
        passed += 1
    } otherwise {
        println("  [FAIL] func ptr call from variable")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
