/*
 * container_element_copy.gray - Test that storing a composite into a
 * container element, and reading one back out, copies its storage
 *
 * Writing through either side of the move must leave the other side alone,
 * as it does for plain variable-to-variable assignment.
 */

import @arrays
import @maps

const Box struct {
    items [int]
    n int
}

mut passed int = 0
mut failed int = 0

do check(name string, ok bool) {
    if ok {
        println("  [PASS] ${name}")
        passed += 1
    } otherwise {
        println("  [FAIL] ${name}")
        failed += 1
    }
}

do is_one(x [int]) -> bool { return x[0] == 1 }

do main() {
    println("=== Container Element Copy Tests ===")

    // stores
    mut row [int] = {1, 2}
    mut grid [[int]] = {{0}}
    grid[0] = row
    grid[0][0] = 9
    check("grid[0]=row", row[0] == 1)

    mut arr [int] = {1, 2}
    mut m map[string:[int]] = {"k": {0}}
    m["k"] = arr
    m["k"][0] = 9
    check("m[k]=arr", arr[0] == 1)

    mut r1 [int] = {1, 2}
    mut o1 [[int]] = {{0}}
    arrays.append(o1, r1)
    o1[1][0] = 9
    check("append", r1[0] == 1)

    mut r2 [int] = {1, 2}
    mut o2 [[int]] = {{0}}
    arrays.prepend(o2, r2)
    o2[0][0] = 9
    check("prepend", r2[0] == 1)

    mut r3 [int] = {1, 2}
    mut o3 [[int]] = {{0}}
    arrays.insert_at(o3, 0, r3)
    o3[0][0] = 9
    check("insert_at", r3[0] == 1)

    mut box Box = Box{items: {1, 2}, n: 1}
    mut bs [Box] = {Box{items: {0}, n: 0}}
    bs[0] = box
    bs[0].items[0] = 9
    check("bs[0]=box", box.items[0] == 1)

    mut box2 Box = Box{items: {1, 2}, n: 1}
    arrays.append(bs, box2)
    bs[1].items[0] = 9
    check("append box", box2.items[0] == 1)

    mut box3 Box = Box{items: {1, 2}, n: 1}
    mut ms map[string:Box] = {"k": Box{items: {0}, n: 0}}
    ms["k"] = box3
    ms["k"].items[0] = 9
    check("ms[k]=box", box3.items[0] == 1)

    mut pa [int] = {1, 2}
    mut src [int] = {5, 6}
    mut p ^[int] = addr(pa)
    p^ = src
    p^[0] = 9
    check("p^=arr", src[0] == 5)

    // reads
    mut g [[int]] = {{1, 2}}
    mut e [int] = g[0]
    e[0] = 9
    check("e=g[0]", g[0][0] == 1)

    mut mv map[string:[int]] = {"k": {1, 2}}
    mut v [int] = mv["k"]
    v[0] = 9
    check("v=m[k]", mv["k"][0] == 1)

    mut mm map[string:map[string:int]] = {"x": {"a": 1}}
    mut inner map[string:int] = mm["x"]
    inner["a"] = 9
    check("inner=mm[x]", mm["x"]["a"] == 1)

    mut msm [map[string:int]] = {{"a": 1}}
    mut inner2 map[string:int] = msm[0]
    inner2["a"] = 9
    check("inner2=msm[0]", msm[0]["a"] == 1)

    mut bs2 [Box] = {Box{items: {1, 2}, n: 1}}
    mut b Box = bs2[0]
    b.items[0] = 9
    check("b=bs[0]", bs2[0].items[0] == 1)

    mut ms2 map[string:Box] = {"k": Box{items: {1, 2}, n: 1}}
    mut b2 Box = ms2["k"]
    b2.items[0] = 9
    check("b2=ms[k]", ms2["k"].items[0] == 1)

    mut g2 [[int]] = {{1, 2}, {3, 4}}
    mut a1 [int] = arrays.get_first(g2)
    a1[0] = 9
    check("get_first", g2[0][0] == 1)
    mut a2 [int] = arrays.get_last(g2)
    a2[0] = 9
    check("get_last", g2[1][0] == 3)

    mut g3 [[int]] = {{1, 2}, {3, 4}}
    mut h, ok = arrays.find(g3, ()is_one)
    h[0] = 9
    check("find", g3[0][0] == 1)

    mut mg map[string:[int]] = {"k": {1, 2}}
    mut vals [[int]] = maps.get_values(mg)
    vals[0][0] = 9
    check("get_values", mg["k"][0] == 1)

    // inferred
    mut g4 [[int]] = {{1, 2}}
    mut e4 = g4[0]
    e4[0] = 9
    check("infer e=g[0]", g4[0][0] == 1)

    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
