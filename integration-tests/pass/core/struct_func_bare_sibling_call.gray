/*
 * struct_func_bare_sibling_call.gray - A struct function can call a sibling
 * function in the same struct by its bare name, public or private, and a bare
 * top-level call still resolves from the same body.
 */

do top_level_double(n i64) -> i64 {
    return n * 2
}

const Calculator struct {
    value i64

    private do internal_add(a i64, b i64) -> i64 {
        return a + b
    }

    do add(a i64, b i64) -> i64 {
        return internal_add(a, b)
    }

    do add_thrice(a i64, b i64, c i64) -> i64 {
        return add(add(a, b), c)
    }

    do doubled_sum(a i64, b i64) -> i64 {
        mut d i64 = top_level_double(a)
        return internal_add(d, b)
    }
}

const Actor struct {
    id i64
    name string

    do rename(a Actor, n string) -> Actor {
        return Actor{id: a.id, name: n}
    }

    do build(a Actor) -> Actor {
        mut doubled i64 = top_level_double(a.id)
        return rename(Actor{id: doubled, name: a.name}, "bob")
    }
}

do main() {
    println("=== Bare Sibling Struct Function Call Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: bare call to a private sibling
    mut r1 i64 = Calculator.add(3, 4)
    if r1 == 7 {
        println("  [PASS] Calculator.add(3, 4) = 7")
        passed += 1
    } otherwise {
        println("  [FAIL] Calculator.add(3, 4): expected 7, got ${r1}")
        failed += 1
    }

    // Test 2: bare call to a public sibling, nested
    mut r2 i64 = Calculator.add_thrice(1, 2, 3)
    if r2 == 6 {
        println("  [PASS] Calculator.add_thrice(1, 2, 3) = 6")
        passed += 1
    } otherwise {
        println("  [FAIL] Calculator.add_thrice(1, 2, 3): expected 6, got ${r2}")
        failed += 1
    }

    // Test 3: bare top-level call and bare sibling call in the same body
    mut r3 i64 = Calculator.doubled_sum(5, 1)
    if r3 == 11 {
        println("  [PASS] Calculator.doubled_sum(5, 1) = 11")
        passed += 1
    } otherwise {
        println("  [FAIL] Calculator.doubled_sum(5, 1): expected 11, got ${r3}")
        failed += 1
    }

    // Test 4: bare sibling call returning the struct itself
    mut a Actor = Actor{id: 1, name: "alice"}
    mut built Actor = Actor.build(a)
    if built.name == "bob" && built.id == 2 {
        println("  [PASS] Actor.build produced id 2, name bob")
        passed += 1
    } otherwise {
        println("  [FAIL] Actor.build: expected id 2 name bob, got id ${built.id} name ${built.name}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
