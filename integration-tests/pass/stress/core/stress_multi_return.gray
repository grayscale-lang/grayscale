/* Stress test: Multiple and named return values (Section 6.2-6.3)
 * Expected: all tests pass
 */


do two() -> (i64, string) { return 42, "hello" }
do three() -> (i64, string, bool) { return 1, "two", true }
do five() -> (i64, i64, i64, i64, i64) { return 10, 20, 30, 40, 50 }
do eight() -> (i64, i64, i64, i64, i64, i64, i64, i64) { return 1, 2, 3, 4, 5, 6, 7, 8 }

// Named returns
do named_single() -> (result i64) {
    mut result i64 = 42
    return result
}

do named_multi() -> (name string, age i64) {
    mut name string = "Alice"
    mut age i64 = 30
    return name, age
}

// Explicit return with named values
do explicit_return() -> (x i64, y i64) {
    mut x i64 = 10
    mut y i64 = 20
    return x, y
}

// Grouped type named returns
do grouped() -> (a, b i64, c string) {
    mut a i64 = 1
    mut b i64 = 2
    mut c string = "three"
    return a, b, c
}

do main() {
    println("=== Stress: Multi & Named Returns ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // 2 returns
    mut a, b = two()
    if a == 42 && b == "hello" {
        println("  [PASS] 2 return values")
        passed += 1
    } otherwise { println("  [FAIL] 2 returns") failed += 1 }

    // 3 returns
    mut c, d, e = three()
    if c == 1 && d == "two" && e == true {
        println("  [PASS] 3 return values")
        passed += 1
    } otherwise { println("  [FAIL] 3 returns") failed += 1 }

    // 5 returns
    mut f1, f2, f3, f4, f5 = five()
    if f1 == 10 && f3 == 30 && f5 == 50 {
        println("  [PASS] 5 return values")
        passed += 1
    } otherwise { println("  [FAIL] 5 returns") failed += 1 }

    // 8 returns
    mut g1, g2, g3, g4, g5, g6, g7, g8 = eight()
    if g1 == 1 && g4 == 4 && g8 == 8 {
        println("  [PASS] 8 return values")
        passed += 1
    } otherwise { println("  [FAIL] 8 returns") failed += 1 }

    // Discard with _
    mut val, _ = two()
    if val == 42 {
        println("  [PASS] discard with _")
        passed += 1
    } otherwise { println("  [FAIL] discard") failed += 1 }

    // Named single return
    mut ns i64 = named_single()
    if ns == 42 {
        println("  [PASS] named single return")
        passed += 1
    } otherwise { println("  [FAIL] named single") failed += 1 }

    // Named multi return
    mut nm_name string, nm_age i64 = named_multi()
    if nm_name == "Alice" && nm_age == 30 {
        println("  [PASS] named multi return")
        passed += 1
    } otherwise { println("  [FAIL] named multi") failed += 1 }

    // Explicit return
    mut bx i64, by i64 = explicit_return()
    if bx == 10 && by == 20 {
        println("  [PASS] explicit return with named values")
        passed += 1
    } otherwise { println("  [FAIL] explicit return") failed += 1 }

    // Grouped type return
    mut ga i64, gb i64, gc string = grouped()
    if ga == 1 && gb == 2 && gc == "three" {
        println("  [PASS] grouped type named return")
        passed += 1
    } otherwise { println("  [FAIL] grouped return") failed += 1 }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 { println("SOME TESTS FAILED") } otherwise { println("ALL TESTS PASSED") }
}
