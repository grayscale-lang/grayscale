/* Stress test: Primitive types exhaustive (Section 2.1)
 * Tests i64, u64, f64, string, bool, char, u8
 * Expected: all tests pass
 */


do return_int() -> i64 { return 42 }
do return_uint() -> u64 { return 100 }
do return_float() -> f64 { return 3.14 }
do return_string() -> string { return "hello" }
do return_bool() -> bool { return true }
do return_char() -> char { return 'A' }
do return_byte() -> u8 { return cast(255, u8) }

do main() {
    println("=== Stress: Primitive Types ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // i64: declare, assign, reassign, print, interpolate
    mut i i64 = 0
    i = 42
    if i == 42 && type_of(i) == "i64" && return_int() == 42 {
        println("  [PASS] i64 basics")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 basics")
        failed += 1
    }

    // i64 edge values
    mut neg_i i64 = -9223372036854775807
    mut big_i i64 = 9223372036854775807
    if neg_i < 0 && big_i > 0 {
        println("  [PASS] i64 edge values")
        passed += 1
    } otherwise {
        println("  [FAIL] i64 edge values")
        failed += 1
    }

    // u64
    mut u u64 = cast(0, u64)
    u = cast(100, u64)
    if type_of(u) == "u64" {
        println("  [PASS] u64 basics")
        passed += 1
    } otherwise {
        println("  [FAIL] u64 basics")
        failed += 1
    }

    // f64
    mut f f64 = 0.0
    f = 3.14
    if f == 3.14 && type_of(f) == "f64" && return_float() == 3.14 {
        println("  [PASS] f64 basics")
        passed += 1
    } otherwise {
        println("  [FAIL] f64 basics")
        failed += 1
    }

    // string
    mut s string = ""
    s = "hello"
    mut interp string = "val: ${s}"
    if s == "hello" && type_of(s) == "string" && return_string() == "hello" && interp == "val: hello" {
        println("  [PASS] string basics")
        passed += 1
    } otherwise {
        println("  [FAIL] string basics")
        failed += 1
    }

    // bool
    mut b bool = false
    b = true
    if b == true && type_of(b) == "bool" && return_bool() == true {
        println("  [PASS] bool basics")
        passed += 1
    } otherwise {
        println("  [FAIL] bool basics")
        failed += 1
    }

    // char
    mut c char = 'z'
    c = 'A'
    if c == 'A' && type_of(c) == "char" && return_char() == 'A' {
        println("  [PASS] char basics")
        passed += 1
    } otherwise {
        println("  [FAIL] char basics")
        failed += 1
    }

    // u8
    mut by u8 = cast(0, u8)
    by = cast(255, u8)
    if by == cast(255, u8) && type_of(by) == "u8" {
        println("  [PASS] u8 basics")
        passed += 1
    } otherwise {
        println("  [FAIL] u8 basics")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
