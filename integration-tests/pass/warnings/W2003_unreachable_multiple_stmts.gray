/*
 * Warning Test: W2003 - multiple unreachable statements after return
 * Expected: warning about unreachable code (warns once per block)
 */


do example() -> i64 {
    return 1
    mut a i64 = 2  // unreachable — should warn here
    mut b i64 = 3  // also unreachable but only one warning per block
    println(a + b)
}

do main() {
    println(example())
}
