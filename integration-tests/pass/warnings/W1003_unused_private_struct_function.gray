/*
 * Warning Test: W1003 - unused-function
 * Expected: warning about a private struct function that nothing calls
 */

const Counter struct {
    n i64

    private do unused_helper(self Counter) -> i64 {
        return 42
    }

    do get(self Counter) -> i64 {
        return self.n
    }
}

do main() {
    mut c Counter = Counter{n: 1}
    println(c.get())
}
