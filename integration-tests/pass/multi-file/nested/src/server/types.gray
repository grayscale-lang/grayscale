/*
 * types.gray - Server type definitions
 * Part of the 'server' module
 */


const Request struct {
    method string
    path string
    body string
}

const Response struct {
    status i64
    body string
}

mut StatusCodes map[i64:string] = {
    200: "OK",
    404: "Not Found",
    500: "Internal Server Error"
  }

do get_status_text(code i64) -> string {
    if code == 200 {
        return StatusCodes[code]
    }
    if code == 404 {
        return StatusCodes[code]
    }
    if code == 500 {
        return StatusCodes[code]
    }
    return "Unknown"
}
