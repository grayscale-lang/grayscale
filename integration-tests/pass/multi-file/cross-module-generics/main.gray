/*
 * cross-module-generics - Generic functions called through a module prefix.
 * The qualified spelling recorded no instantiation, so codegen emitted no
 * specialization while the call site still mangled the name, and the C
 * compiler was handed a call to a function that did not exist.
 *
 * Every case is written twice, once qualified and once bare via 'using', to
 * pin that both spellings agree.
 */

import "./vutils.gray"
import "./utils.gray"
import and use "./models.gray"
using vutils

const Actor struct {
    id i64
}

do main() {
    println("=== Cross-Module Generics Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Value of a generic type, qualified
    mut a i64 = vutils.identity(i64, 42)
    if a == 42 {
        println("  [PASS] vutils.identity(i64, 42) == 42")
        passed += 1
    } otherwise {
        println("  [FAIL] vutils.identity(i64, 42): expected 42, got ${a}")
        failed += 1
    }

    // Value of a generic type, bare through 'using'
    mut b i64 = identity(i64, 42)
    if b == 42 {
        println("  [PASS] identity(i64, 42) == 42")
        passed += 1
    } otherwise {
        println("  [FAIL] identity(i64, 42): expected 42, got ${b}")
        failed += 1
    }

    // A second call site binds a different type
    mut s string = vutils.identity(string, "hello")
    if s == "hello" {
        println("  [PASS] vutils.identity(string, \"hello\") == hello")
        passed += 1
    } otherwise {
        println("  [FAIL] vutils.identity(string, \"hello\"): got ${s}")
        failed += 1
    }

    // Type argument, qualified, local struct
    mut c Actor = utils.new_T(Actor)
    if c.id == 0 {
        println("  [PASS] utils.new_T(Actor) returned a zeroed Actor")
        passed += 1
    } otherwise {
        println("  [FAIL] utils.new_T(Actor): expected id 0, got ${c.id}")
        failed += 1
    }

    // Type argument returning a pointer, qualified
    mut d ^Actor = utils.new_T_ptr(Actor)
    if d^.id == 0 {
        println("  [PASS] utils.new_T_ptr(Actor) returned a pointer to a zeroed Actor")
        passed += 1
    } otherwise {
        println("  [FAIL] utils.new_T_ptr(Actor): expected id 0, got ${d^.id}")
        failed += 1
    }

    // Type argument, qualified, imported struct
    mut e models.Thing = utils.new_T(models.Thing)
    if models.Thing.bump(e) == 1 {
        println("  [PASS] utils.new_T(models.Thing) on an imported struct type")
        passed += 1
    } otherwise {
        println("  [FAIL] utils.new_T(models.Thing): got ${models.Thing.bump(e)}")
        failed += 1
    }

    // Type argument, imported struct named bare through 'import and use'
    mut f Thing = utils.new_T(Thing)
    if Thing.bump(f) == 1 {
        println("  [PASS] utils.new_T(Thing) with the bare imported name")
        passed += 1
    } otherwise {
        println("  [FAIL] utils.new_T(Thing): got ${Thing.bump(f)}")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
