/*
 * Test for_each with namespaced identifier as collection
 *
 * This tests that for_each correctly parses lib.Items as a collection
 * when an import uses namespace prefix (import lib"..." without and use).
 */
import lib "./testlib/lib.gray"


do main() {
    println("=== For_each Namespaced Collection Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: for_each over namespaced string array
    println("Items from lib.Items:")
    mut item_count i64 = 0
    for_each item in lib.Items {
        println("  ${item}")
        item_count += 1
    }
    if item_count == 3 {
        println("  [PASS] for_each over namespaced string array")
        passed += 1
    } otherwise {
        println("  [FAIL] expected 3 items, got ${item_count}")
        failed += 1
    }

    // Test 2: for_each over namespaced i64 array with accumulation
    mut sum i64 = 0
    for_each n in lib.Numbers {
        sum += n
    }
    if sum == 100 {
        println("  [PASS] for_each over namespaced i64 array (sum=${sum})")
        passed += 1
    } otherwise {
        println("  [FAIL] for_each over namespaced i64 array: expected 100, got ${sum}")
        failed += 1
    }

    // Summary
    println("")
    println("Results: ${passed} passed, ${failed} failed")

    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
