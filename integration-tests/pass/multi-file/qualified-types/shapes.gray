
const Circle struct {
    radius f64
}

const Rect struct {
    width i64
    height i64
}

do make_circle(r f64) -> shapes.Circle {
    return Circle{radius: r}
}

do make_rect(w i64, h i64) -> shapes.Rect {
    return Rect{width: w, height: h}
}

do area(r Rect) -> i64 {
    return r.width * r.height
}

const Shade enum {
    LIGHT
    DARK
}

alias Extent = i64
