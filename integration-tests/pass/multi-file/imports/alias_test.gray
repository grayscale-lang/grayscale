/*
 * alias_test.gray - Test aliased import and use syntax
 *
 * Tests:
 *   - import and use alias"./path.gray" syntax
 *   - import and use of a stdlib module alongside aliased local modules
 *   - Chained with mixed aliases
 */

// Use aliased imports for everything
import and use a"./libA.gray", b"./libB.gray", @math

const TestResult struct {
    passed int
    failed int
}

do main() {
    println("========================================")
    println("  Aliased Import and Use Test")
    println("========================================")
    println("")

    mut total_passed int = 0
    mut total_failed int = 0
    mut result TestResult = TestResult{passed: 0, failed: 0}

    result = test_aliased_user_modules()
    total_passed += result.passed
    total_failed += result.failed

    result = test_aliased_stdlib()
    total_passed += result.passed
    total_failed += result.failed

    result = test_mixed_access()
    total_passed += result.passed
    total_failed += result.failed

    mut total int = total_passed + total_failed

    println("")
    println("========================================")
    println("  Total:  ${total}")
    println("  Passed: ${total_passed}")
    println("  Failed: ${total_failed}")
    if total_failed == 0 {
        println("  Status: ALL TESTS PASSED!")
    } otherwise {
        println("  Status: SOME TESTS FAILED")
    }
    println("========================================")
}

do test_aliased_user_modules() -> TestResult {
    println("------------------------------------------")
    println("  Test: Aliased user modules (a, b)")
    println("------------------------------------------")
    mut passed int = 0
    mut failed int = 0

    // libA imported as 'a' with auto-use
    println("  Testing a.greet() and unqualified greet()...")
    mut g1 string = a.greet("Alias")
    mut g2 string = greet("Direct")
    println("    a.greet('Alias') = '${g1}'")
    println("    greet('Direct') = '${g2}'")
    if g1 == "Hello, Alias" {
        passed += 1
    } otherwise {
        failed += 1
    }
    if g2 == "Hello, Direct" {
        passed += 1
    } otherwise {
        failed += 1
    }

    // libB imported as 'b' with auto-use
    println("  Testing b.multiply() and unqualified multiply()...")
    mut m1 int = b.multiply(3, 4)
    mut m2 int = multiply(5, 6)
    println("    b.multiply(3, 4) = ${m1}")
    println("    multiply(5, 6) = ${m2}")
    if m1 == 12 {
        passed += 1
    } otherwise {
        failed += 1
    }
    if m2 == 30 {
        passed += 1
    } otherwise {
        failed += 1
    }

    println("  PASSED: ${passed}, FAILED: ${failed}")
    println("")
    return TestResult{passed: passed, failed: failed}
}

do test_aliased_stdlib() -> TestResult {
    println("------------------------------------------")
    println("  Test: Stdlib alongside aliased locals (@math)")
    println("------------------------------------------")
    mut passed int = 0
    mut failed int = 0

    // math imported with auto-use
    println("  Testing math.sqrt() and unqualified sqrt()...")
    mut s1 float = math.sqrt(16.0)
    mut s2 float = sqrt(25.0)
    println("    math.sqrt(16.0) = ${s1}")
    println("    sqrt(25.0) = ${s2}")
    if s1 == 4.0 {
        passed += 1
    } otherwise {
        failed += 1
    }
    if s2 == 5.0 {
        passed += 1
    } otherwise {
        failed += 1
    }

    println("  Testing math.abs()...")
    mut a1 int = math.abs(-42)
    println("    math.abs(-42) = ${a1}")
    if a1 == 42 {
        passed += 1
    } otherwise {
        failed += 1
    }

    println("  PASSED: ${passed}, FAILED: ${failed}")
    println("")
    return TestResult{passed: passed, failed: failed}
}

do test_mixed_access() -> TestResult {
    println("------------------------------------------")
    println("  Test: Mixed qualified/unqualified access")
    println("------------------------------------------")
    mut passed int = 0
    mut failed int = 0

    // Combine functions from different modules
    // Note: add() exists in both libA and math, so use qualified access
    println("  Testing combined operations...")
    mut sum int = a.add(10, 20)            // from libA via alias (avoids ambiguity with math.add)
    mut product int = b.multiply(sum, 2)   // from libB via alias
    mut root float = sqrt(float(product))  // from math via auto-use
    println("    a.add(10, 20) = ${sum}")
    println("    b.multiply(${sum}, 2) = ${product}")
    println("    sqrt(${product}) = ${root}")

    if sum == 30 {
        passed += 1
    } otherwise {
        failed += 1
    }
    if product == 60 {
        passed += 1
    } otherwise {
        failed += 1
    }

    // Test format_number from libB
    println("  Testing format_number from libB...")
    mut formatted string = format_number(42)
    println("    format_number(42) = '${formatted}'")
    if formatted == "Number: 42" {
        passed += 1
    } otherwise {
        failed += 1
    }

    println("  PASSED: ${passed}, FAILED: ${failed}")
    println("")
    return TestResult{passed: passed, failed: failed}
}
