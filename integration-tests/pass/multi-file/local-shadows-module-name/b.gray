/*
 * b.gray - the module name is 'b', which locals below deliberately reuse.
 */

const Inner struct {
    n i64
}

const Box struct {
    v i64
    inner Inner
}

/* A local named after this file's own module. */
do peek() -> i64 {
    mut box Box = Box{v: 5, inner: Inner{n: 2}}
    box.v = 9
    box.inner.n = 4
    mut p ^Box = addr(box)
    return box.v + box.inner.n + p^.v
}

/* A parameter named after this file's own module. */
do via_param(box Box) -> i64 {
    return box.v + box.inner.n
}
