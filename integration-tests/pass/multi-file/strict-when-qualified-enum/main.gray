/*
 * Test: #strict exhaustiveness over module-qualified is patterns
 *
 * A `when` handling every variant as `mod.Enum.VARIANT` is exhaustive. It was
 * rejected with E3056 two different ways: a tagged enum reported its
 * payload-free variant missing, and a plain enum was not recognized as an
 * enum at all.
 */
import "./shapes.gray"
import "./dirs.gray"

do area(s shapes.Shape) -> float {
    #strict
    when s {
        is shapes.Shape.Circle(r)  { return 3.0 * r * r }
        is shapes.Shape.Rect(w, h) { return w * h }
        is shapes.Shape.Point      { return 0.0 }
    }
    return 0.0
}

do name(d dirs.Dir) -> string {
    #strict
    when d {
        is dirs.Dir.NORTH { return "n" }
        is dirs.Dir.SOUTH { return "s" }
    }
    return "?"
}

do main() {
    assert(area(shapes.Shape.Circle(2.0)) == 12.0, "tagged variant with a payload")
    assert(area(shapes.Shape.Rect(2.0, 5.0)) == 10.0, "tagged variant with two payloads")
    assert(area(shapes.Shape.Point) == 0.0, "payload-free variant of a tagged enum")

    assert(name(dirs.Dir.NORTH) == "n", "plain enum first variant")
    assert(name(dirs.Dir.SOUTH) == "s", "plain enum second variant")

    println("ALL TESTS PASSED")
}
