// Test: a func reference to a struct function through its module (()mod.Type.fn) compiles and runs
import "./lib.gray"
import @arrays

do apply(f func(int) -> int, x int) -> int {
    return f(x)
}

do main() {
    const inc = ()lib.P.inc
    if inc(4) == 5 {
        println("  [PASS] const holds a module struct function reference")
    } else {
        println("  [FAIL] const holds a module struct function reference")
    }

    if apply(()lib.P.inc, 9) == 10 {
        println("  [PASS] module struct function reference passed to a user function")
    } else {
        println("  [FAIL] module struct function reference passed to a user function")
    }

    mut a [int] = {1, 2}
    mut mapped [int] = arrays.map(a, ()lib.P.inc)
    if mapped[0] == 2 && mapped[1] == 3 {
        println("  [PASS] module struct function reference passed to arrays.map")
    } else {
        println("  [FAIL] module struct function reference passed to arrays.map")
    }

    const mk func(int) -> lib.P = ()lib.P.mk
    if mk(4).n == 4 {
        println("  [PASS] module struct function reference returning a struct")
    } else {
        println("  [FAIL] module struct function reference returning a struct")
    }
}
