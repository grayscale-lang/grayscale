alias Score = i64

do bump(s Score) -> Score {
    return s + 1
}

const Point struct {
    x i64
    y i64
}

const Color enum {
    RED
    GREEN
}

alias Vec = Point
alias Spot = Vec
alias Hue = Color
alias Scores = [Score]

do make_vec(x i64, y i64) -> Vec {
    return Vec{x: x, y: y}
}

do vec_sum(v Spot) -> i64 {
    return v.x + v.y
}
