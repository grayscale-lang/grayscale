/*
 * Error Test: E3043 - cannot cast int to a string-backed enum
 * Expected: "cannot cast"
 *
 * A string-backed enum is a GrayString at runtime, not an integer, so the
 * int-backed cast rules must not apply to it.
 */
// expect-error: E3043

const Status enum {
    OK = "ok"
    BAD = "bad"
}

do main() {
    mut s Status = cast(0, Status)
    println(s)
}
