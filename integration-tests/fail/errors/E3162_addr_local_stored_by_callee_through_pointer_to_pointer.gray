// expect-error: E3162
// expect-error-count: 1
/*
 * Error Test: E3162 - a callee stores a pointer parameter through a ^^Node
 * slot that is addr() of a new() heap object, so the returned object holds
 * a pointer to a local.
 */

const Node struct {
    v i64
    next ^Node
}

do store(slot ^^Node, b ^Node) {
    slot^ = b
}

do build() -> ^Node {
    mut heap ^Node = new(Node)
    mut local = Node{v: 42, next: nil}
    store(addr(heap), addr(local))
    return heap
}

do main() {
    mut h = build()
    println("${h^.v}")
}
