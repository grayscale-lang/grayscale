// expect-error: E3163
/*
 * Error Test: E3163 - inner-scope address laundered through an intermediate
 * pointer before escaping to an outer-scope pointer
 *
 * 's' lives in the if-block's arena; 'p' outlives it.
 */

do main() {
    mut p ^i64 = nil
    if true {
        mut s i64 = 42
        mut tmp ^i64 = addr(s)
        p = tmp
    }
    println(p^)
}
