// expect-error: E3163
// expect-error-count: 3
// expect-not: 'x' outlives the variable 'x'
/*
 * Error Test: E3163 - a local's address must not be passed into a call
 * whose target is a function-typed parameter (#2692). Escape analysis
 * cannot see through the indirect call, so every pointer/aggregate
 * argument such a call receives is treated as escaping to an unknown,
 * program-lifetime sink.
 *
 *   1. indirect call stashes the pointer into a global
 *   2. indirect call writes the pointer through a ^^i64 out-parameter
 *      (both the out-pointer and the payload pointer are flagged)
 *
 * The specific global reached through an opaque callee's own summary is
 * unknowable, so the message must say so generically rather than repeat
 * the pointee's own name in both slots (#2755).
 */

mut leaked ^i64 = nil

do stash(p ^i64) { leaked = p }

do apply1(f func(^i64), p ^i64) { f(p) }

do writeback(p ^i64, out ^^i64) { out^ = p }

do apply2(f func(^i64, ^^i64), out ^^i64, p ^i64) { f(p, out) }

do main() {
    if true {
        mut x i64 = 42
        const g func(^i64) = ()stash
        apply1(g, addr(x))
    }

    mut sink ^i64 = nil
    if true {
        mut y i64 = 99
        const h func(^i64, ^^i64) = ()writeback
        apply2(h, addr(sink), addr(y))
    }

    println("unreachable")
}
