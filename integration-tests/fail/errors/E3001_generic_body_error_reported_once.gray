// expect-error: E3001
// expect-error-count: 2
/*
 * Error Test: E3001 - a type error inside a generic function body is
 * reported once, at the offending line, however many call sites instantiate
 * the function, and without an "in instantiation of" wrapper.
 * Covers both the '?' wildcard and the 'T <?>' forms.
 */

do wrap(s ?) -> i64 {
    mut v i64 = "not an i64"
    return v
}

do first(T <?>) -> i64 {
    mut v i64 = "also not an i64"
    return v
}

do main() {
    println("${wrap(42)}")
    println("${wrap("x")}")
    println("${first(i64)}")
}
