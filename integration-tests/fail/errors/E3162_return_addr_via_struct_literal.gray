/*
 * Error Test: E3162 - returning a struct-literal field that holds
 * addr(local) is rejected, same as returning addr(local) directly.
 */
// expect-error: E3162
// expect-error-count: 1

const B struct {
    p ^int
}

do f() -> ^int {
    mut x int = 1
    mut b B = B{p: addr(x)}
    return b.p
}

do main() {
    mut d ^int = f()
    println("done")
}
