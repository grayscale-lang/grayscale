/*
 * Error Test: E3162 - returning a struct-literal field that holds
 * addr(local) is rejected, same as returning addr(local) directly.
 */
// expect-error: E3162
// expect-error-count: 1

const B struct {
    p ^i64
}

do f() -> ^i64 {
    mut x i64 = 1
    mut b B = B{p: addr(x)}
    return b.p
}

do main() {
    mut d ^i64 = f()
    println("done")
}
