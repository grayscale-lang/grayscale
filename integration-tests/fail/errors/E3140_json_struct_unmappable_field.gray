/*
 * Error Test: E3140 - #json struct with a field type that has no JSON mapping
 */

// expect-error: E3140

import @json

const Inner struct {
    x i64
}

#json
const S struct {
    a i64
    n Inner
}

do main() {
    mut inner Inner = Inner{x: 1}
    mut s S = S{a: 1, n: inner}
    println(s.a)
}
