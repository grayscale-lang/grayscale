/*
 * Error Test: E3158 - a Grayscale function returning a string cannot be
 * passed as a C callback.
 * A `string` return lowers to a GrayString struct, not the scalar return
 * C callback APIs such as qsort's comparator require, so the C API's
 * function-pointer type declares a return convention that never matches.
 */
// expect-error: E3158
// expect-error-count: 1

extern import "stdlib.h"

do cmp(a i32, b i32) -> string {
    return "not an i64"
}

do main() {
    mut buf ^i64 = extern.malloc(16)
    extern.qsort(buf, 2, 8, ()cmp)
    extern.free(buf)
}
