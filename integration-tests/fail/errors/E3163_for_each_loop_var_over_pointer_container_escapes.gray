// expect-error: E3163
// expect-error-count: 2
/*
 * Error Test: E3163 - a `for_each` loop variable bound over a container of
 * pointers keeps the container's lifetime origin, so storing it into a
 * longer-lived global is caught (#2695) - directly, and laundered through a
 * helper whose escape summary is PARAM_ESCAPE_GLOBAL.
 */

mut leaked ^i64 = nil

do take(p ^i64) { leaked = p }

do direct() {
    mut x i64 = 7
    mut pts [^i64] = {addr(x)}
    for_each pp in pts {
        leaked = pp
    }
}

do via_helper() {
    mut y i64 = 9
    mut pts [^i64] = {addr(y)}
    for_each pp in pts {
        take(pp)
    }
}

do main() {
    direct()
    via_helper()
    println("unreachable")
}
