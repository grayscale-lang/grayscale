/*
 * Error Test: E4017 - private struct function called via namespace dispatch
 * Expected: "private and cannot be called from outside the struct"
 */

const Secret struct {
    value i64

    private do hidden(a i64, b i64) -> i64 {
        return a * b
    }
}

do main() {
    mut r i64 = Secret.hidden(5, 6)
}
