/*
 * Error Test: E3050 - mut array inference only applies to primitive elements;
 * a struct-element literal still needs an explicit annotation.
 * Expected: "array needs a type annotation"
 */

// expect-error: E3050

const Point struct {
    x int
    y int
}

do main() {
    mut ps = {Point{x: 1, y: 2}}
}
