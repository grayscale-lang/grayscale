/*
 * Error Test: E3162 - returning a map-literal value that holds
 * addr(local) is rejected, same as returning addr(local) directly.
 */
// expect-error: E3162
// expect-error-count: 1

do f() -> ^i64 {
    mut x i64 = 1
    mut m map[string:^i64] = {"k": addr(x)}
    return m["k"]
}

do main() {
    mut d ^i64 = f()
    println("done")
}
