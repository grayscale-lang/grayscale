/*
 * Error Test: E3040 - a single or_return binding for a call with more than
 * one non-error return slot. The second value was silently dropped.
 */

do two() -> (i64, string, Error) { return 10, "hi", nil }

do consume() -> (i64, Error) {
    mut a = two() or_return
    return a, nil
}

do main() {
    mut n, e = consume()
    println("${n}")
}
