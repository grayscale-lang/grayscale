/*
 * Error Test: E3001 - passing wrong struct type to a struct function
 * Expected: "expected struct 'Point', got struct 'Color'"
 */

const Point struct {
    x i64
    y i64

    do distance(a Point, b Point) -> i64 {
        return a.x - b.x
    }
}

const Color struct {
    r i64
    g i64
}

do main() {
    mut c = Color{r: 255, g: 0}
    mut p = Point{x: 1, y: 2}
    mut d i64 = Point.distance(c, p)
}
