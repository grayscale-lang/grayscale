/*
 * Error Test: E3063 - returning an array-literal element that holds
 * addr(local) is rejected, same as returning addr(local) directly. The
 * array literal must not launder the address past the escape checker.
 */
// expect-error: E3063
// expect-error-count: 1

do f() -> ^int {
    mut x int = 42
    mut a [^int] = {addr(x)}
    return a[0]
}

do main() {
    mut d ^int = f()
    println("done")
}
