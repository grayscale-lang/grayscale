// expect-contains: .gray:
/* Panic Test: P0129 - json.parse into a string-backed enum field with a value that matches no variant */
import @json

const Role enum {
    ADMIN = "admin"
    USER  = "user"
}

#json
const Account struct {
    name string
    role Role
}

do main() {
    mut a Account = json.parse("{\"name\": \"x\", \"role\": \"superuser\"}")
    println(a.role)
}
