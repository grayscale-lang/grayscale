/*
 * Error Test: E3061 - mutual by-value struct recursion routed through aliases
 *
 * A -> BAlias (B) -> AAlias (A) is the same cycle as A -> B -> A and must
 * be reported for both structs, not silently passed to the C compiler.
 */

// expect-error: E3061
// expect-error-count: 2

const A struct {
    b BAlias
}

const B struct {
    a AAlias
}

alias AAlias = A
alias BAlias = B

do main() {
    println("hi")
}
