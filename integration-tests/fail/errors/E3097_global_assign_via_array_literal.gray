/*
 * Error Test: E3097 - assigning a global from an array-literal element
 * that holds addr(local) is rejected, same as `G = addr(local)` directly.
 */
// expect-error: E3097
// expect-error-count: 1

mut G ^int = nil

do stash() {
    mut x int = 424242
    mut a [^int] = {addr(x)}
    G = a[0]
}

do main() {
    stash()
    println("done")
}
