/*
 * Error Test: E3162 - returning an array-literal element that holds
 * addr(local) is rejected, same as returning addr(local) directly. The
 * array literal must not launder the address past the escape checker.
 */
// expect-error: E3162
// expect-error-count: 1

do f() -> ^i64 {
    mut x i64 = 42
    mut a [^i64] = {addr(x)}
    return a[0]
}

do main() {
    mut d ^i64 = f()
    println("done")
}
