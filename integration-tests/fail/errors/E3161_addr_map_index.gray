/*
 * Error Test: E3161 - addr() of a map index expression is rejected;
 * a map value can be relocated by a rehash, leaving the pointer dangling.
 */
// expect-error: E3161
// expect-error-count: 1

do main() {
    mut scores map[string:i64] = {"a": 1}
    mut p ^i64 = addr(scores["a"])
    println("${p^}")
}
