/*
 * Error Test: E3066 - a struct literal supplying a mismatched func ref
 * Expected: compile-time error on the field value
 */

const Handler struct {
    callback func(i64) -> i64
}

do takes_float(n f64) -> i64 { return 0 }

do main() {
    const h = Handler{callback: ()takes_float}
    println(h.callback(1))
}
