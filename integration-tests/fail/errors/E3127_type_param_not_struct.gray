/*
 * Error Test: E3127 - a T{...} literal in the body narrows a type parameter
 * to struct types, so a primitive binding is rejected where the literal is
 * written. E3058 names the call site that bound it.
 * Expected: "type parameter 'T' is used as a struct literal"
 */

do mk_stack(T <?>) -> ? {
    return T{}
}

do main() {
    mut x = mk_stack(int)
    println(x)
}
