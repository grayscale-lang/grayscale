/*
 * Error Test: E3127 - a kind{...} literal in the body narrows a generic
 * parameter to struct types, so a primitive binding is rejected where the
 * literal is written. E3058 names the call site that bound it.
 * Expected: "generic parameter 'kind' is used as a struct literal"
 */

do mk_stack(kind generic) -> kind {
    return kind{}
}

do main() {
    mut x = mk_stack(i64)
    println(x)
}
