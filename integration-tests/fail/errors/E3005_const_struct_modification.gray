/*
 * E3005_const_struct_modification.gray
 * Tests that modifying a const struct field fails with E3005
 */
// expect-error: E3005
// expect-error-count: 1

const Point struct {
    x i64
    y i64
}

do main() {
    const p = Point{x: 10, y: 20}
    p.x = 999  // ERROR: cannot modify immutable struct
}
