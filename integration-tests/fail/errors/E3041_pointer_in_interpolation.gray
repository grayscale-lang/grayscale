/*
 * Error Test: E3041 - pointer value in string interpolation
 *
 * "${ptr}" where ptr is ^T used to leak to
 * clang the same way as structs did. Typechecker now rejects with
 * a hint to dereference with ^ or format the pointee.
 */

do main() {
    mut v i64 = 42
    mut p ^i64 = addr(v)
    println("ptr: ${p}")
}
