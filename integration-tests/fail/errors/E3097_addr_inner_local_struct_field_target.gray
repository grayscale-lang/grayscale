// expect-error: E3097
// expect-error-count: 1
/*
 * Error Test: E3097 - a struct field as the assignment target of an
 * inner-scope address.
 *
 * 'inner' lives in the if-block's arena; 'b' outlives it, so b.p is left
 * pointing at freed memory once the block ends.
 */

const Box struct {
    p ^int
}

do main() {
    mut b Box = Box{p: nil}
    if true {
        mut inner int = 9
        b.p = addr(inner)
    }
    println(b.p^)
}
