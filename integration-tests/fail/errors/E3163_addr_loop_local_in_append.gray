/*
 * Error Test: E3163 - addr() of a loop-local variable passed into
 * arrays.append alongside an outer-scope destination must name that
 * destination (ptrs), not repeat the pointee's own name (x), in the
 * message (#2755).
 */
// expect-error: E3163
// expect-error-count: 1
// expect-not: 'x' outlives the variable 'x'

import @arrays

do main() {
    mut ptrs [^i64] = {}
    for i in range(3) {
        mut x i64 = i * 10
        arrays.append(ptrs, addr(x))
    }
    println(ptrs[0]^)
}
