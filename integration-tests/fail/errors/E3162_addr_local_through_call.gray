// expect-error: E3162
// expect-error-count: 1
/*
 * Error Test: E3162 - a local's address returned after passing through a
 * function call that forwards its argument.
 *
 * id() returns its parameter unchanged, so id(addr(local)) is still the
 * address of 'local', which dies when leak() returns.
 */

do id(p ^i64) -> ^i64 { return p }

do leak() -> ^i64 {
    mut local i64 = 7
    return id(addr(local))
}

do main() {
    mut r ^i64 = leak()
    println(r^)
}
