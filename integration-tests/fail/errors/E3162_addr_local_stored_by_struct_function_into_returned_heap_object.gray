// expect-error: E3162
// expect-error-count: 2
/*
 * Error Test: E3162 - a struct function stores its second pointer parameter
 * into the pointee of self. Both the instance and the static-style call
 * leave the returned heap object holding a pointer to a local.
 */

const Node struct {
    v i64
    next ^Node

    do link(self ^Node, other ^Node) {
        self^.next = other
    }
}

do build_instance() -> ^Node {
    mut heap ^Node = new(Node)
    mut local = Node{v: 42, next: nil}
    heap.link(addr(local))
    return heap
}

do build_static() -> ^Node {
    mut heap ^Node = new(Node)
    mut local = Node{v: 42, next: nil}
    Node.link(heap, addr(local))
    return heap
}

do main() {
    mut h = build_instance()
    mut g = build_static()
    println("${h^.next^.v} ${g^.next^.v}")
}
