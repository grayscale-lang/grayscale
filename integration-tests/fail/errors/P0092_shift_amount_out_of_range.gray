/*
 * Panic Test: P0092 - shift amount out of range
 *
 * Shifting by a negative amount is undefined behavior in C. Grayscale must
 * validate the shift amount at runtime and panic instead of silently
 * producing a wrong result.
 */

do main() {
    mut amount i64 = -1
    mut result i64 = 1 bit_shift_left amount
    println(result)
}
