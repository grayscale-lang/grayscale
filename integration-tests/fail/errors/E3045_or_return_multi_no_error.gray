/*
 * Error Test: E3045 - or_return destructure on a call whose return tuple
 * does not end in Error.
 * Expected: "or_return requires a function that returns (T, Error)"
 */

do two() -> (i64, i64) {
    return 3, 4
}

do consume() -> (i64, Error) {
    mut a, b = two() or_return
    return a + b, nil
}

do main() {
    mut r, e = consume()
    println("${r} ${e != nil}")
}
