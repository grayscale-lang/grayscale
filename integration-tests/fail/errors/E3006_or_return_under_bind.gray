/*
 * Error Test: E3006 - or_return destructure with fewer bindings than the
 * call's non-error return slots. The trailing value was silently dropped.
 */

do three() -> (i64, i64, i64, Error) { return 10, 20, 30, nil }

do consume() -> (i64, Error) {
    mut a, b = three() or_return
    return a + b, nil
}

do main() {
    mut n, e = consume()
    println("${n}")
}
