// expect-error: E3163
// expect-error-count: 1
/*
 * Error Test: E3163 - a block-local's address laundered through a pointer
 * variable and stored into a longer-lived array via arrays.insert_at.
 *
 * Same class as the append case, on a different container-mutating stdlib
 * function.
 */

import @arrays

do main() {
    mut ptrs [^i64] = {}
    if true {
        mut inner i64 = 3
        mut t ^i64 = addr(inner)
        arrays.insert_at(ptrs, 0, t)
    }
    println(ptrs[0]^)
}
