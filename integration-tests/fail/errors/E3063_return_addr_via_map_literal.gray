/*
 * Error Test: E3063 - returning a map-literal value that holds
 * addr(local) is rejected, same as returning addr(local) directly.
 */
// expect-error: E3063
// expect-error-count: 1

do f() -> ^int {
    mut x int = 1
    mut m map[string:^int] = {"k": addr(x)}
    return m["k"]
}

do main() {
    mut d ^int = f()
    println("done")
}
