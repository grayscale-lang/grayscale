/*
 * Error Test: E3053 - mixed enum types in array literal
 * Expected: type mismatch for different enum in array
 */
// expect-error: E3053
// expect-error-count: 1

const Color enum {
    RED
    GREEN
}

const Dir enum {
    NORTH
    SOUTH
}

do main() {
    mut arr [Color] = {Color.RED, Dir.NORTH}
}
