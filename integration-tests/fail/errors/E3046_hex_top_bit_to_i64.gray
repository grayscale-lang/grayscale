/*
 * Error Test: E3046 - integer-overflow (hex top bit set cannot go into i64)
 * Expected: "overflows 64-bit integer"
 * Previously this silently stored -1 because the hex parser never flagged
 * overflow. Now the parser tracks the full unsigned range and the
 * typechecker rejects an above-INT64_MAX literal for a signed `i64`.
 */

do main() {
    mut x i64 = 0xFFFFFFFFFFFFFFFF  // above INT64_MAX, not allowed for i64
}
