// expect-error: E3162
// expect-error-count: 1
// A pointer field read out of an array element built from addr(local) dangles after return.

const Holder struct { p ^i64 }

do make() -> ^i64 {
    mut x i64 = 7
    mut holders [Holder] = {Holder{p: addr(x)}}
    return holders[0].p
}

do main() {
    mut p ^i64 = make()
    println(p^)
}
