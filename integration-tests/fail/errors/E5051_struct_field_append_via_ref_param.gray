/*
 * Error Test: E5051 - a fixed-size struct field passed by mutable reference
 * into a plain '[T]' parameter loses its fixed-ness at that boundary. The
 * callee's own length-changing 'arrays.append' call on the bare parameter
 * name is still caught, one level of function-call indirection deep.
 */
// expect-error: E5051
// expect-error-count: 1

import @arrays

const Widget struct {
    items [int, 3]
}

do mutate(&arr [int]) {
    arrays.append(arr, 99)
}

do main() {
    mut w Widget = Widget{items: {1, 2, 3}}
    mutate(w.items)
    println(len(w.items))
}
