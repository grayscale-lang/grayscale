/*
 * Error Test: E3167 - cast() cannot reinterpret one pointer type as another
 * Expected: E3167 "cast() cannot reinterpret pointer types" error
 */

const Point struct {
    x i64
    y i64
}

const Vec struct {
    a i64
    b i64
}

do main() {
    mut p = new(Point)
    mut q ^Vec = cast(p, ^Vec)
    println(q^.a)
}
