/*
 * Error Test: E3154 - the pointer-parameter wrapper gap reproduces for a
 * struct instance function exactly like a plain top-level function: a
 * struct function that takes a `^T` parameter and passes it straight into
 * its own extern. call still leaks the caller's stack address into C.
 */
// expect-error: E3154
// expect-error-count: 1

extern import "stdlib.h"

const Wrapper struct {
    tag i64

    do do_free(self Wrapper, p ^i64) {
        extern.free(p)
    }
}

do main() {
    mut local i64 = 5
    mut w Wrapper = Wrapper{tag: 1}
    w.do_free(addr(local))
}
