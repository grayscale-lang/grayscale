/*
 * Error Test: E3127 - the same kind{...} body form with an enum binding. An enum
 * names a real type, so the call site accepts it; the struct literal does not.
 * Expected: "generic parameter 'kind' is used as a struct literal"
 */

const Color enum {
    RED
    GREEN
}

do mk_stack(kind generic) -> kind {
    return kind{}
}

do main() {
    mut x = mk_stack(Color)
    println(x)
}
