/*
 * Error Test: E3158 - a Grayscale function with a string parameter cannot be
 * passed as a C callback.
 * A `string` parameter lowers to a GrayString struct, not the `void *` C
 * callback APIs such as qsort's comparator require, so the C API's raw
 * address gets reinterpreted as a GrayString that was never actually there.
 */
// expect-error: E3158
// expect-error-count: 1

extern import "stdlib.h"

do cmp(a string, b string) -> i32 {
    return 0
}

do main() {
    mut buf ^int = extern.malloc(16)
    extern.qsort(buf, 2, 8, ()cmp)
    extern.free(buf)
}
