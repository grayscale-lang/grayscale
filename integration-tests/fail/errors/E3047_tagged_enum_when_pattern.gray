/*
 * Error Test: E3047 - tagged enum when pattern names a variant the enum lacks
 */
// expect-error: E3047

const Color enum {
    RED
    GREEN
}

const Shape enum {
    Circle(i64)
    Square(i64)
}

do main() {
    mut s Shape = Shape.Circle(1)
    when s {
        is Shape.Hexagon(n) { println(n) }
        default { }
    }
}
