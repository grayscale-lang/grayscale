/*
 * Error Test: E3163 - assigning a global from an array-literal element
 * that holds addr(local) is rejected, same as `G = addr(local)` directly.
 */
// expect-error: E3163
// expect-error-count: 1

mut G ^i64 = nil

do stash() {
    mut x i64 = 424242
    mut a [^i64] = {addr(x)}
    G = a[0]
}

do main() {
    stash()
    println("done")
}
