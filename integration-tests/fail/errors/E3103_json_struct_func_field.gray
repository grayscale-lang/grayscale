/*
 * Error Test: E3103 - #json struct with func-typed field
 * Expected: E3103 error, compilation fails
 */

import @json

do double(n i64) -> i64 { return n * 2 }

#json
const Wrapper struct {
    value i64
    transform func(i64) -> i64
}

do main() {
    mut w = Wrapper{value: 10, transform: ()double}
}
