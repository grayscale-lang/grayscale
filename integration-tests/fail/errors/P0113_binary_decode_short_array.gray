/*
 * Panic Test: P0113 - binary.decode_i64_be reads past the end of a u8
 * array shorter than the decoded type's width. Must panic instead of
 * silently reading uninitialized/stale arena memory past bytes.len.
 */

import @binary
import @encoding

do main() {
    mut short [u8] = encoding.from_string("Xy")
    mut leaked i64 = binary.decode_i64_be(short)
    println("${leaked}")
}
