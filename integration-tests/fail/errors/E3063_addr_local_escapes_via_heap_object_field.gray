// expect-error: E3063
// expect-error-count: 1
/*
 * Error Test: E3063 - a new() heap object whose pointer field is set to a
 * local's address and is then returned: the object outlives the local, so
 * the returned pointer carries a dangling field (#2650 vector B).
 */

const Node struct {
    link ^int
}

do build() -> ^Node {
    mut n ^Node = new(Node)
    mut local int = 42
    n^.link = addr(local)
    return n
}

do main() {
    mut node ^Node = build()
    println("${node^.link^}")
}
