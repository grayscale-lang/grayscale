/*
 * Error Test: E3164 - pointer into a @mem arena used after mem.destroy()
 * Expected: the arena is destroyed conditionally on a later iteration of the
 * loop; the deref inside the loop body is caught regardless.
 */

import @mem

do main() {
    mut a = mem.arena(1024)
    for i in range(0, 3) {
        mut p ^int = mem.alloc(a, i)
        if i == 1 {
            mem.destroy(a)
        }
        println(p^)
    }
}
