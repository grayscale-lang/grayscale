/*
 * Error Test: E5053 - a declaration annotates an extern.func() result with a
 * type of a different kind than the real C return type (void * here), which
 * would otherwise leak a raw C "incompatible type" error.
 */
// expect-error: E5053
// expect-error-count: 1

extern import "stdlib.h"

do main() {
    mut x f64 = extern.malloc(16)
    println("${x}")
}
