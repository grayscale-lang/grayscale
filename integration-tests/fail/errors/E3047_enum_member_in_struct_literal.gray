/*
 * Error Test: E3047 - struct literal field names a variant the enum lacks
 */
// expect-error: E3047

const Color enum {
    RED
    GREEN
}

const Shape enum {
    Circle(i64)
    Square(i64)
}

const Box struct {
    c Color
}

do main() {
    mut b Box = Box{c: Color.PURPLE}
    println(b.c)
}
