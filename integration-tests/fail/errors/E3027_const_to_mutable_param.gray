/*
 * Error Test: E3027 - passing const to mutable parameter
 * Expected: compiler should reject this with E3027
 */
// expect-contains: mutable parameter 'arr' of 'modify'

do modify(&arr [i64]) {
    arr[0] = 999
}

do main() {
    const nums [i64, 3] = {1, 2, 3}
    modify(nums)  // ERROR: cannot pass immutable to mutable parameter
}
