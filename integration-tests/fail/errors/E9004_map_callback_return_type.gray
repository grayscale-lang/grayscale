/*
 * Error Test: E9004 - arrays.map() callback return type mismatch
 * Expected: E9004 error (map callback must return the same type as the array element type)
 */

import @arrays

do to_str(n i64) -> string {
    return "n${n}"
}

do main() {
    mut nums [i64] = {1, 2, 3}
    mut strs = arrays.map(nums, ()to_str)
}
