/*
 * Error Test: E3142 - a function declared with a func return type
 *
 * STANDARD 7.6.6: a returned func value cannot be called, assigned, or
 * stored, so the declaration itself is rejected rather than every use of
 * the result.
 */

// expect-error: E3142

do inc(x i64) -> i64 {
    return x + 1
}

do pick() -> func(i64) -> i64 {
    return ()inc
}

do main() {
    println("hi")
}
