/* Error Test: E2088 - mixed when/switch aliases in same file */
// expect-error: E2088
do main() {
    mut x int = 1
    when x {
        is 1 { println("one") }
        default { println("other") }
    }

    switch x {
        case 1 { println("still one") }
        default { println("other") }
    }
}
