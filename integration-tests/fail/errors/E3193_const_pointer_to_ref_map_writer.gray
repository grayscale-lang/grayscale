import @arrays
import @maps

const Box struct {
    items [i64]
    m map[string:i64]
}

do drop(p ^Box) { maps.remove_key(p^.m, "a") }

do push(p ^Box) {
    mut r = ref(p^.items)
    arrays.append(r, 1)
}

do main() {
    const cb Box = Box{items: {1}, m: {"a": 1}}
    drop(addr(cb))
    push(addr(cb))
}
