/*
 * Error Test: E3032 - comparing values from different enum types
 * Expected: type mismatch for cross-enum comparison
 */
// expect-error: E3032
// expect-error-count: 1

const Color enum {
    RED
    GREEN
}

const Dir enum {
    NORTH
    SOUTH
}

do main() {
    mut c Color = Color.RED
    mut d Dir = Dir.NORTH
    if c == d {
        println("same")
    }
}
