// expect-contains: .gray:
/* Panic Test: P0129 - json.parse into an int-backed enum field with a value that matches no variant */
import @json

const Priority enum {
    LOW
    HIGH
}

#json
const Task struct {
    name string
    priority Priority
}

do main() {
    mut t Task = json.parse("{\"name\": \"x\", \"priority\": 7}")
    println(t.priority)
}
