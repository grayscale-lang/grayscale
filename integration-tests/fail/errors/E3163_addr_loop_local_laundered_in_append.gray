// expect-error: E3163
// expect-error-count: 1
/*
 * Error Test: E3163 - a loop-local's address laundered through a pointer
 * variable before being appended to an array that outlives the loop body.
 *
 * The inline form arrays.append(ptrs, addr(x)) is already rejected; here the
 * address is copied into 't' first so it never appears at the call.
 */

import @arrays

do main() {
    mut ptrs [^i64] = {}
    for i in range(3) {
        mut x i64 = i * 10
        mut t ^i64 = addr(x)
        arrays.append(ptrs, t)
    }
    println(ptrs[0]^)
}
