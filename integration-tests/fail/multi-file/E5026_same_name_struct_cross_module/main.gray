/*
 * Error Test: E3001 - same-named structs from different modules are
 * distinct types; a shapes.Point is not a colors.Point.
 */
// expect-error: E3001
// expect-error-count: 1

import "./shapes.gray"
import "./colors.gray"

do main() {
    mut p shapes.Point = shapes.origin()
    println(colors.describe(p))
}
