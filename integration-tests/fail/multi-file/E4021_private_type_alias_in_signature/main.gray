/*
 * Error Test: E4021 - private type alias named in a signature, field,
 * or container element, each reported once at its own location
 * Expected: "is private and cannot be accessed from outside its file"
 */

import "./lib.gray"

const Holder struct {
    f lib.ID
}

do takes(p lib.ID) -> int {
    return 1
}

do gives() -> lib.ID {
    return 2
}

do main() {
    mut arr [lib.ID] = {1}
    println("${arr[0]}")
}
