/*
 * vm/cell - nominal types, error codes, the instruction set and generic helpers of the dillo64 VM.
 * Exercises: distinct aliases, #error_code enums, default struct fields, generics.
 */

import @arrays

distinct alias Cell = i64
distinct alias Slot = u32

#error_code
const VmFault enum {
    BAD_ADDRESS
    STACK_EMPTY
    BAD_OPCODE
    BUDGET_SPENT
}

const Op enum {
    PUSH
    ADD
    MUL
    MULHI
    DUP
    SWAP
    STORE
    LOAD
    JNZ
    DEC
    OUT
    HALT
}

const Instr struct {
    op Op
    arg Cell = 0

    do make(op Op, arg i64 = 0) -> Instr {
        return Instr{op: op, arg: cast(arg, Cell)}
    }
}

do pop_last(T generic, &items [T], fallback T) -> (value T, ok bool) {
    mut value T = fallback
    mut ok bool = false
    if len(items) > 0 {
        value = arrays.remove_last(items)
        ok = true
    }
    return value, ok
}

do filled(T generic, count i64, seed T) -> [T] {
    mut out [T] = {}
    for _ in range(0, count) {
        arrays.append(out, seed)
    }
    return out
}
