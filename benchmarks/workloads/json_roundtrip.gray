/*
 * json_roundtrip - decode a large JSON object to a map, re-encode it, repeat.
 * Exercises: json, maps, strings, arena allocation.
 */

import @json
import @io
import @os

do main() {
    mut gen string = os.get_env("BENCH_GEN")
    mut content, err = io.read_file("${gen}/blob.json")
    if err != nil {
        println("json_roundtrip: cannot read fixture")
        exit(1)
    }

    mut checksum int = 0
    for i in range(0, 200) {
        mut decoded map[string:string] = json.parse(content)
        mut encoded string = json.encode(decoded)
        checksum += len(encoded) + len(decoded)
    }

    println("json_roundtrip checksum=${checksum}")
}
