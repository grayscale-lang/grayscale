/*
 * json_roundtrip - decode a large JSON object to a map, re-encode it, repeat.
 * Exercises: json, maps, strings, arena allocation.
 */

import @json
import @io
import @os

// The runner exports BENCH_GEN; running a workload by hand falls back to
// benchmarks/.gen next to this file's directory.
do fixture_dir() -> string {
    mut env string = os.get_env("BENCH_GEN")
    if env != "" {
        return env
    }
    mut src string = here().file
    if !io.is_absolute(src) {
        src = io.path_join({os.current_dir(), src})
    }
    return io.path_join({io.dirname(io.dirname(src)), ".gen"})
}

do main() {
    mut gen string = fixture_dir()
    mut content, err = io.read_file("${gen}/blob.json")
    if err != nil {
        println("json_roundtrip: cannot read fixture")
        exit(1)
    }

    mut checksum int = 0
    for i in range(0, 200) {
        mut decoded map[string:string] = json.parse(content)
        mut encoded string = json.encode(decoded)
        checksum += len(encoded) + len(decoded)
    }

    println("json_roundtrip checksum=${checksum}")
}
