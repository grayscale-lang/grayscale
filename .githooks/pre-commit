#!/bin/sh
# Block the commit if any staged .gray file under cli/, scripts/ or benchmarks/
# is not formatted. Fix with: gray fmt <file>

if [ -x ./gray ]; then
  gray_bin=./gray
elif command -v gray >/dev/null 2>&1; then
  gray_bin=gray
else
  echo "pre-commit: gray binary not found; run 'make build' first" >&2
  exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACM -- 'cli/*.gray' 'scripts/*.gray' 'benchmarks/*.gray')
[ -z "$files" ] && exit 0

status=0
for file in $files; do
  if ! "$gray_bin" fmt --check "$file" >/dev/null 2>&1; then
    echo "pre-commit: $file is not formatted; run: gray fmt $file" >&2
    status=1
  fi
done
exit $status
