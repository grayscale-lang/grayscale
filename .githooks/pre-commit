#!/bin/sh
# Block the commit if any staged file has a disallowed extension, or if any staged
# .gray file under cli/, scripts/ or benchmarks/ is not formatted.

# Reject disallowed file extensions (executables, archives, installers)
blocked_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(exe|dll|out|db|sqlite|sqlite3|sh|tar|tar\.gz|tgz|tar\.bz2|tar\.xz|zip|7z|rar|gz|bz2|xz|dmg|pkg|msi|deb|rpm|jar|whl|iso)$' || true)
if [ -n "$blocked_files" ]; then
  echo "pre-commit: Disallowed file extensions detected:" >&2
  echo "$blocked_files" >&2
  exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACM -- 'cli/*.gray' 'scripts/*.gray' 'benchmarks/*.gray')
[ -z "$files" ] && exit 0

if [ -x ./gray ]; then
  gray_bin=./gray
elif command -v gray >/dev/null 2>&1; then
  gray_bin=gray
else
  echo "pre-commit: gray binary not found; run 'make selfhost build' first" >&2
  exit 1
fi

status=0
for file in $files; do
  if ! "$gray_bin" fmt --check "$file" >/dev/null 2>&1; then
    echo "pre-commit: $file is not formatted; run: gray fmt $file" >&2
    status=1
  fi
done
exit $status
