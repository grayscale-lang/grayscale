// args_text.gray — The help text of every gray command, as the Go CLI prints it.

const LONG_BUILD string = `Compile a Grayscale source file to a native binary. The binary is named after the source file and written to the current directory unless -o is given.

Examples:
  gray build main.gray                Build ./main
  gray build main.gray -o app         Build ./app
  gray build main.gray --emit-c       Write the generated C to main.c, no binary
  gray build main.gray --cc clang     Build with a chosen C compiler`

const LONG_CHECK string = `Type-check a file or directory and report errors and warnings without compiling or running it. A trailing /... checks every directory under the given path that directly holds source files, each as its own module.

Examples:
  gray check main.gray       Check a single file
  gray check src             Check one directory
  gray check ./...           Check every directory under the current one`

const LONG_UPDATE string = `Check for updates and upgrade Grayscale.

Without flags, installs the latest stable release and prints a note if a newer pre-release is available.

With --pre, installs the latest pre-release (alpha, beta, or rc).`

const LONG_NEW string = `Scaffold a new Grayscale project with templates.

Examples:
  gray new                      Interactive mode
  gray new myproject            Create with basic template
  gray new myproject -t cli     Create with cli template
  gray new myproject -t lib -c  Create library with comments

Templates:
  basic  - Single file hello world (default)
  cli    - CLI application with arg handling
  lib    - Reusable library module
  multi  - Multi-module project
  server - HTTP server (use -s for minimal/normal)
  client - HTTP client (use -s for minimal/normal)`

const LONG_CROSS string = `Cross-compile Grayscale programs to other platforms using zig cc as the C backend.`

const LONG_CROSS_BUILD string = `Cross-compile a Grayscale source file for another platform using zig cc. The binary is named <file>-<target> (with .exe for Windows targets) unless -o is given. Run 'gray cross targets' to list the targets.

Examples:
  gray cross build main.gray --target linux-amd64
  gray cross build main.gray --target windows-amd64 -o app.exe`

const LONG_COMPLETION string = `Generate the autocompletion script for gray for the specified shell.
See each sub-command's help for details on how to use the generated script.`

const LONG_COMPLETION_ZSH string = `Generate the autocompletion script for the zsh shell.

If shell completion is not already enabled in your environment you will need
to enable it.  You can execute the following once:

	echo "autoload -U compinit; compinit" >> ~/.zshrc

To load completions in your current shell session:

	source <(gray completion zsh)

To load completions for every new session, execute once:

#### Linux:

	gray completion zsh > "${fpath[1]}/_gray"

#### macOS:

	gray completion zsh > $(brew --prefix)/share/zsh/site-functions/_gray

You will need to start a new shell for this setup to take effect.`

const LONG_COMPLETION_INSTALL string = `Install the completion script for the shell named by $SHELL (PowerShell on Windows) into the directory that shell loads.

No rc file is modified.`

const LONG_MAN string = `Show documentation for a builtin, a stdlib module, or a language keyword, type, or symbol. With no name, prints the index.

Examples:
  gray man                    Show the index
  gray man println            Docs for a builtin
  gray man math               List a stdlib module
  gray man strings.contains   Qualified lookup
  gray man keywords           List language keywords`

const LONG_FMT string = `Normalize formatting of .gray and .grayscale source files (indentation, trailing
whitespace, end-of-file newline, blank-line runs).

Examples:
  gray fmt .              Format source files in current directory (no recursion)
  gray fmt ./...          Format recursively from current directory
  gray fmt file.gray        Format a single file
  gray fmt a.gray b.gray      Format multiple files
  gray fmt --check ./...  Exit non-zero if any file would change (CI gate)

By default files are rewritten in place. Use --check for a non-mutating CI gate.`

const LONG_DOC string = `Generate markdown documentation from #doc attributes in Grayscale source files.

Examples:
  gray doc .              Generate docs for current directory (no recursion)
  gray doc ./...          Generate docs recursively from current directory
  gray doc ./src          Generate docs for src directory only
  gray doc ./src/...      Generate docs recursively from src directory
  gray doc file.gray        Generate docs for a single file
  gray doc a.gray b.gray      Generate docs for multiple files

Output is written to DOCS.md by default. Use -o/--output to write
to a different path (parent directories are created as needed).`

const LONG_TEST string = `Compile and run every function marked with the #test attribute.

#test functions take no parameters, return nothing, and are stripped from
'gray build' output — they exist only for 'gray test'.

Examples:
  gray test                Run tests in every source file under the current directory
  gray test file.gray      Run tests in a single file
  gray test ./src          Run tests in the source files directly inside ./src
  gray test ./src/...      Run tests in every source file under ./src (recursive)

A failed assert (or any panic) inside a #test is reported as a test failure;
the runner continues with the remaining tests. Exit status is non-zero if any
test fails or any file fails to compile.`

const LONG_WATCH string = `Watch a file or directory for changes and automatically re-run it.

A file is watched together with the files it imports. A directory must hold
exactly one file with a main() function; that file is run on each change.

Examples:
  gray watch main.gray     Re-run main.gray whenever it or its imports change
  gray watch src           Watch a directory`

const LONG_VERIFY string = `Compile and run the built-in language verification program to confirm the installed compiler and runtime work. Exits non-zero on failure. Not available on Windows.

Example:
  gray verify`

const LONG_VERSION string = `Print the installed Grayscale version, commit, and build time, and the latest stable release.

Example:
  gray version`

const LONG_INSTALL string = `Install a specific Grayscale version by exact semver, replacing the current install. Downgrades and pre-release versions are supported.

Examples:
  gray install "grayscale: v0.11.5"
  gray install v0.11.5`

const LONG_REPORT string = `Print the Grayscale version, commit, install path, OS, CPU, RAM, and C compiler details to paste into a bug report.

Example:
  gray report`

const LONG_COMPLETION_BASH string = `Generate the autocompletion script for the bash shell.

This script depends on the 'bash-completion' package.
If it is not installed already, you can install it via your OS's package manager.

To load completions in your current shell session:

	source <(gray completion bash)

To load completions for every new session, execute once:

#### Linux:

	gray completion bash > /etc/bash_completion.d/gray

#### macOS:

	gray completion bash > $(brew --prefix)/etc/bash_completion.d/gray

You will need to start a new shell for this setup to take effect.`

const LONG_COMPLETION_FISH string = `Generate the autocompletion script for the fish shell.

To load completions in your current shell session:

	gray completion fish | source

To load completions for every new session, execute once:

	gray completion fish > ~/.config/fish/completions/gray.fish

You will need to start a new shell for this setup to take effect.`

const LONG_COMPLETION_POWERSHELL string = `Generate the autocompletion script for powershell.

To load completions in your current shell session:

	gray completion powershell | Out-String | Invoke-Expression

To load completions for every new session, add the output of the above command
to your powershell profile.`

const LONG_CROSS_TARGETS string = `List the targets accepted by 'gray cross build --target', with the zig triple each maps to.

Example:
  gray cross targets`

const LONG_HELP string = `Help provides help for any command in the application.
Simply type gray help [path to command] for full details.`

const LONG_ROOT string = `Grayscale is a programming language for software that's simple to write and safe to run.`
