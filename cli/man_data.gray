// man_data.gray — GENERATED by scripts/generate_man_data.gray; do not edit.

// ManEntry holds documentation for a single builtin, stdlib function, type or
// constant. kind is "func", "type" or "const"; fields holds a type's
// newline-separated "name type" pairs.
const ManEntry struct {
    module string
    group string
    kind string
    sig string
    type_fields string
    desc string
    example string
}

// ManGroup is one labeled group of names within a module index.
const ManGroup struct {
    label string
    names [string]
}

// builtin_man_docs is the lookup table for gray man <builtin>.
do builtin_man_docs() -> map[string:ManEntry] {
    mut docs map[string:ManEntry] = {:}
    docs["println"] = ManEntry{module: "", group: "", kind: "func", sig: "println(value T = \"\")", type_fields: "", desc: "Prints any value to stdout followed by a newline. The argument is optional; called with no argument it prints a blank line.", example: "println(\"hello, world\")\nprintln(42)\nprintln(my_struct)\nprintln()"}
    docs["print"] = ManEntry{module: "", group: "", kind: "func", sig: "print(value T)", type_fields: "", desc: "Prints any value to stdout without a trailing newline.", example: "print(\"loading... \")\nprint(42)"}
    docs["flush"] = ManEntry{module: "", group: "", kind: "func", sig: "flush()", type_fields: "", desc: "Flushes buffered stdout so partial-line output (prompts, progress indicators) appears immediately, even when stdout is a pipe or file.", example: "print(\"working\")\nflush()"}
    docs["eprintln"] = ManEntry{module: "", group: "", kind: "func", sig: "eprintln(value T = \"\")", type_fields: "", desc: "Prints any value to stderr followed by a newline. Supports all types: string, i64, u64, f64, bool, char, and pointers. The argument is optional; called with no argument it prints a blank line.", example: "eprintln(\"error: something went wrong\")\neprintln(404)\neprintln(3.14)\neprintln(true)\neprintln()"}
    docs["eprint"] = ManEntry{module: "", group: "", kind: "func", sig: "eprint(value T)", type_fields: "", desc: "Prints any value to stderr without a trailing newline. Supports all types: string, i64, u64, f64, bool, char, and pointers.", example: "eprint(\"warning: \")\neprint(404)\neprint(3.14)\neprint(true)"}
    docs["input"] = ManEntry{module: "", group: "", kind: "func", sig: "input() -> string", type_fields: "", desc: "Reads a line from stdin and returns it as a string (newline stripped).", example: "print(\"Name: \")\nmut name string = input()\nprintln(\"Hello, \${name}\")"}
    docs["assert"] = ManEntry{module: "", group: "", kind: "func", sig: "assert(condition bool, message string = \"\")", type_fields: "", desc: "Terminates the program if condition is false, printing the message and source location.", example: "assert(x > 0, \"x must be positive\")\nassert(len(items) > 0, \"list cannot be empty\")"}
    docs["panic"] = ManEntry{module: "", group: "", kind: "func", sig: "panic(message string)", type_fields: "", desc: "Immediately terminates the program with the given message and source location.", example: "panic(\"unreachable code reached\")"}
    docs["exit"] = ManEntry{module: "", group: "", kind: "func", sig: "exit(code i64)", type_fields: "", desc: "Exits the program immediately with the given exit code.", example: "exit(0)\nexit(1)"}
    docs["sleep_s"] = ManEntry{module: "", group: "", kind: "func", sig: "sleep_s(seconds i64)", type_fields: "", desc: "Pauses execution for the given number of seconds.", example: "sleep_s(1)"}
    docs["sleep_ms"] = ManEntry{module: "", group: "", kind: "func", sig: "sleep_ms(milliseconds i64)", type_fields: "", desc: "Pauses execution for the given number of milliseconds.", example: "sleep_ms(500)"}
    docs["sleep_ns"] = ManEntry{module: "", group: "", kind: "func", sig: "sleep_ns(nanoseconds i64)", type_fields: "", desc: "Pauses execution for the given number of nanoseconds.", example: "sleep_ns(1000000)"}
    docs["string"] = ManEntry{module: "", group: "", kind: "func", sig: "string(value T) -> string", type_fields: "", desc: "Converts any value to its string representation.", example: "mut s string = string(123)\nmut s2 string = string(true)"}
    docs["char"] = ManEntry{module: "", group: "", kind: "func", sig: "char(codepoint i64) -> char", type_fields: "", desc: "Converts an integer Unicode codepoint to a char value.", example: "mut c char = char(65)\nprintln(c)"}
    docs["bool"] = ManEntry{module: "", group: "", kind: "func", sig: "bool(value T) -> bool", type_fields: "", desc: "Converts a value to bool.", example: "mut flag bool = true\nmut done bool = false"}
    docs["func"] = ManEntry{module: "", group: "", kind: "func", sig: "func_name(param T) -> T {}", type_fields: "", desc: "The function reference type. Written with a full typed signature: parameter list and return type. Holds a reference to a named function created with ()name or ref(name). Used as parameter types, struct fields, and in arrays/maps. References are const-only and not printable.", example: "do double(n i64) -> i64 { return n * 2 }\ndo apply(f func(i64) -> i64, x i64) -> i64 { return f(x) }\nconst g func(i64) -> i64 = ()double\nprintln(apply(g, 5))   // 10"}
    docs["cast"] = ManEntry{module: "", group: "", kind: "func", sig: "cast(value T, TargetType) -> TargetType", type_fields: "", desc: "Explicit type conversion between primitive types. Truncates floating-point values toward zero; a string target type parses the string and panics if it is not a number. Enforces range at runtime.", example: "mut x i64 = cast(3.7, i64)\nmut b u8 = cast(200, u8)\nmut f f64 = cast(count, f64)\nmut n i64 = cast(\"42\", i64)"}
    docs["i128"] = ManEntry{module: "", group: "", kind: "func", sig: "i128(value T) -> i128", type_fields: "", desc: "128-bit signed integer. Supports all arithmetic and comparisons. Overflow panics at runtime.", example: "mut a i128 = i128(99999999999999999999)\nmut b i128 = a * i128(2)\nprintln(b)"}
    docs["u128"] = ManEntry{module: "", group: "", kind: "func", sig: "u128(value T) -> u128", type_fields: "", desc: "128-bit unsigned integer. Supports all arithmetic and comparisons. Overflow panics at runtime.", example: "mut a u128 = u128(99999999999999999999)"}
    docs["i256"] = ManEntry{module: "", group: "", kind: "func", sig: "i256(value T) -> i256", type_fields: "", desc: "256-bit signed integer. Supports all arithmetic and comparisons. Overflow panics at runtime.", example: "mut a i256 = i256(0)"}
    docs["u256"] = ManEntry{module: "", group: "", kind: "func", sig: "u256(value T) -> u256", type_fields: "", desc: "256-bit unsigned integer. Supports all arithmetic and comparisons. Overflow panics at runtime.", example: "mut a u256 = u256(0)"}
    docs["len"] = ManEntry{module: "", group: "", kind: "func", sig: "len(collection T) -> i64", type_fields: "", desc: "Returns the length of a string, array, map, Channel, Builder, or range. For strings returns byte length, not character count (use char_count for that). For a Channel returns the values currently buffered, a snapshot. For a Builder returns the bytes written. For a range returns the iteration count; an empty range is 0.", example: "println(len(\"hello\"))\nprintln(len(my_array))\nprintln(len(my_map))\nprintln(len(range(0, 10, 2)))"}
    docs["type_of"] = ManEntry{module: "", group: "", kind: "func", sig: "type_of(value T) -> string", type_fields: "", desc: "Returns the Grayscale type name of any value as a string at runtime.", example: "println(type_of(42))\nprintln(type_of(\"hi\"))\nprintln(type_of(my_struct))"}
    docs["fields"] = ManEntry{module: "", group: "", kind: "func", sig: "fields(instance T) -> [string]", type_fields: "", desc: "Returns the field names of a struct as an array of strings in declaration order. Accepts struct instances and pointers to structs.", example: "const Point struct {\n    x i64\n    y i64\n}\nmut p = Point{x: 1, y: 2}\nprintln(fields(p))"}
    docs["size_of"] = ManEntry{module: "", group: "", kind: "func", sig: "size_of(Type) -> i64", type_fields: "", desc: "Returns the size in bytes of a type. i64=8, f64=8, bool=1, string=16.", example: "println(size_of(i64))\nprintln(size_of(MyStruct))"}
    docs["new"] = ManEntry{module: "", group: "", kind: "func", sig: "new(Type) -> ^Type", type_fields: "", desc: "Allocates a zero-initialized struct on the heap and returns a pointer to it.", example: "mut p = new(Point)\np.x = 10\np.y = 20"}
    docs["ref"] = ManEntry{module: "", group: "", kind: "func", sig: "ref(variable T) -> T", type_fields: "", desc: "Creates a transparent alias to a variable; the alias has the same type as the variable and cannot be explicitly annotated. Reads and writes through the alias affect the original. Also used to take a function reference.", example: "mut x i64 = 10\nmut r = ref(x)\nr = 99\nprintln(x)"}
    docs["addr"] = ManEntry{module: "", group: "", kind: "func", sig: "addr(variable T) -> ^T", type_fields: "", desc: "Returns a pointer to the memory address of a variable.", example: "mut x i64 = 10\nmut p ^i64 = addr(x)\nprintln(p^)"}
    docs["raw"] = ManEntry{module: "", group: "", kind: "func", sig: "raw(variable T) -> ^T", type_fields: "", desc: "Returns a raw pointer to a variable. Unlike addr(), raw pointers are unsafe: dereferences skip nil-check panics and the compiler does not enforce const-source write protection. Use only in performance-critical code where pointer validity is guaranteed. Unsafe: requires an unsafe block or an unsafe function.", example: "unsafe {\n    mut x i64 = 10\n    mut p = raw(x)\n    println(p^)\n}"}
    docs["wrap_add"] = ManEntry{module: "", group: "", kind: "func", sig: "wrap_add(a T, b T) -> T", type_fields: "", desc: "Adds two integers and wraps modulo 2^N instead of panicking on overflow, in two's complement for signed types. T is any integer type; a literal takes the other operand's type. Unsafe: requires an unsafe block or an unsafe function.", example: "unsafe {\n    mut x u8 = 255\n    println(wrap_add(x, 1))\n}"}
    docs["wrap_sub"] = ManEntry{module: "", group: "", kind: "func", sig: "wrap_sub(a T, b T) -> T", type_fields: "", desc: "Subtracts two integers and wraps modulo 2^N instead of panicking on overflow. Wrapping negation is wrap_sub(0, x). Unsafe: requires an unsafe block or an unsafe function.", example: "unsafe {\n    mut x u32 = 0\n    println(wrap_sub(x, 1))\n}"}
    docs["wrap_mult"] = ManEntry{module: "", group: "", kind: "func", sig: "wrap_mult(a T, b T) -> T", type_fields: "", desc: "Multiplies two integers and wraps modulo 2^N instead of panicking on overflow, as a hash or random number generator needs. Unsafe: requires an unsafe block or an unsafe function.", example: "unsafe {\n    mut hash u64 = 14695981039346656037\n    hash = wrap_mult(hash bit_xor 97, 1099511628211)\n}"}
    docs["wrap_div"] = ManEntry{module: "", group: "", kind: "func", sig: "wrap_div(a T, b T) -> T", type_fields: "", desc: "Divides two integers, returning the type's minimum for MIN / -1 instead of panicking. Division by zero still panics. Unsafe: requires an unsafe block or an unsafe function.", example: "unsafe {\n    mut x i8 = -128\n    println(wrap_div(x, -1))\n}"}
    docs["copy"] = ManEntry{module: "", group: "", kind: "func", sig: "copy(value T) -> T", type_fields: "", desc: "Creates a deep copy of any value. Mutations to the copy do not affect the original.", example: "mut arr2 = copy(arr)\narr2[0] = 99\nprintln(arr[0])\nmut m2 = copy(my_map)\nmut s2 = copy(my_struct)"}
    docs["error"] = ManEntry{module: "", group: "", kind: "func", sig: "error(code ErrorCode, message string = \"\") -> Error", type_fields: "", desc: "Creates an Error value with the given code and message, e.g. error(.NotFound, \"file not found\") or error(.Unknown, \"msg\"). Inspect err.code with == or `when`; err.msg holds the message.", example: "mut err Error = error(.NotFound, \"file not found\")\nwhen err.code { is .NotFound { println(err.msg) } default { } }"}
    docs["range"] = ManEntry{module: "", group: "", kind: "func", sig: "range(start i64, end i64, step i64 = 1) -> Range<i64>", type_fields: "", desc: "Returns a Range from start (inclusive) to end (exclusive). The step defaults to 1 and controls the increment. A literal step of 0 is a compile error; a step of 0 from a variable panics when the range is used. A Range can be iterated with for, checked with in and not_in, matched with is, and stored in a local variable; Range cannot be written as a type and cannot be passed to or returned from a function. The loop variable is an i64, or the widest of i128, u128, i256 and u256 among the bounds.", example: "for i in range(0, 5) { println(i) }\nfor i in range(0, 10, 2) { println(i) }\nmut r = range(0, 10)\nif 4 in r { println(\"in range\") }"}
    docs["from_c_string"] = ManEntry{module: "", group: "", kind: "func", sig: "from_c_string(ptr ^u8) -> string", type_fields: "", desc: "Wraps a null-terminated C char* pointer as a Grayscale string. Only valid with values from C interop (extern import \"header.h\").", example: "extern import \"mylib.h\"\nmut s string = from_c_string(mylib_get_name())"}
    docs["to_c_string"] = ManEntry{module: "", group: "", kind: "func", sig: "to_c_string(s string) -> ^u8", type_fields: "", desc: "Returns a NUL-terminated copy of the string as a raw C pointer, for storing in an extern struct field or a ^u8 variable. The copy lives for the rest of the program, so the pointer stays valid after the string, the loop iteration, or the function that created it is gone; writing through it does not change the string.", example: "extern import \"mylib.h\"\nmut name ^u8 = to_c_string(\"grayscale\")"}
    docs["to_char"] = ManEntry{module: "", group: "", kind: "func", sig: "to_char(s string, index i64) -> char", type_fields: "", desc: "Returns the char at character position index (not byte position) in a UTF-8 string. The char is a 32-bit Unicode codepoint; apply i64() to the result for its numeric value. Panics if out of bounds.", example: "mut c char = to_char(\"hello\", 0)\nprintln(c)\nprintln(cast(c, i64))"}
    docs["char_count"] = ManEntry{module: "", group: "", kind: "func", sig: "char_count(s string) -> i64", type_fields: "", desc: "Returns the number of Unicode codepoints in a UTF-8 string. Unlike len() which counts bytes.", example: "println(char_count(\"hello\"))\nprintln(len(\"hello\"))"}
    docs["here"] = ManEntry{module: "", group: "", kind: "func", sig: "here() -> SourceLocation", type_fields: "", desc: "Returns a SourceLocation with the current file, line, and column filled in at compile time.", example: "mut loc = here()\nprintln(loc.file)\nprintln(loc.line)"}
    docs["SourceLocation"] = ManEntry{module: "", group: "", kind: "type", sig: "", type_fields: "file string\nline i64\ncolumn i64", desc: "Returned by here(). Contains the source file path, line number, and column at the call site, filled in at compile time.", example: "mut loc = here()\nprintln(loc.file)\nprintln(loc.line)\nprintln(loc.column)"}
    docs["embed"] = ManEntry{module: "", group: "", kind: "func", sig: "embed(path string) -> string", type_fields: "", desc: "Reads a file at compile time and returns its contents as a string literal baked into the binary. The path is resolved relative to the source file containing the embed() call. The argument must be a string literal — variables and expressions are rejected (E5017). If the file cannot be read, the compiler emits E5018. Valid at file scope and inside function bodies.", example: "const LICENSE string = embed(\"../../LICENSE\")\nconst CONFIG string = embed(\"config/defaults.json\")\ndo main() {\n    println(LICENSE)\n}"}
    docs["Error"] = ManEntry{module: "", group: "", kind: "type", sig: "", type_fields: "", desc: "Represents a runtime error. Opaque type with no accessible fields. Use string interpolation to get the message.", example: "mut err Error = error(.Unknown, \"file not found\")\nprintln(\"\${err}\")"}
    docs["system"] = ManEntry{module: "", group: "", kind: "func", sig: "system(command string) -> i64", type_fields: "", desc: "Runs a shell command and returns its exit code. Mirrors C's system(). Returns -1 if the process was killed by a signal.", example: "mut code i64 = system(\"ls -la\")\nprintln(code)\nsystem(\"echo hello\")"}
    return docs
}

// stdlib_man_docs is the per-function lookup table for gray man <module.name>.
do stdlib_man_docs() -> map[string:ManEntry] {
    mut docs map[string:ManEntry] = {:}
    docs["arrays.append"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "append(&arr [T], value T)", type_fields: "", desc: "Appends value to the end of arr. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\narrays.append(nums, 4)\nprintln(nums)"}
    docs["arrays.insert_at"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "insert_at(&arr [T], index i64, value T)", type_fields: "", desc: "Inserts value at the given index, shifting subsequent elements right. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\narrays.insert_at(nums, 1, 99)\nprintln(nums)"}
    docs["arrays.prepend"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "prepend(&arr [T], value T)", type_fields: "", desc: "Inserts value at the front of arr, shifting all elements right. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {2, 3, 4}\narrays.prepend(nums, 1)\nprintln(nums)"}
    docs["arrays.remove_at"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "remove_at(&arr [T], index i64)", type_fields: "", desc: "Removes the element at the given index, shifting subsequent elements left. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\narrays.remove_at(nums, 1)\nprintln(nums)"}
    docs["arrays.remove"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "remove(&arr [T], value T)", type_fields: "", desc: "Removes the first occurrence of value from arr. Modifies the array in place. Does nothing if value is not found.", example: "import @arrays\nmut nums [i64] = {1, 2, 3, 2}\narrays.remove(nums, 2)\nprintln(nums)"}
    docs["arrays.clear"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "clear(&arr [T])", type_fields: "", desc: "Removes all elements from arr, leaving it empty. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\narrays.clear(nums)\nprintln(nums)"}
    docs["arrays.fill"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "fill(&arr [T], value T, count i64)", type_fields: "", desc: "Appends count copies of value to arr. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {}\narrays.fill(nums, 0, 5)\nprintln(nums)"}
    docs["arrays.get_first"] = ManEntry{module: "arrays", group: "Access", kind: "func", sig: "get_first(arr [T]) -> T", type_fields: "", desc: "Returns the first element of arr. Panics if arr is empty.", example: "import @arrays\nmut nums [i64] = {10, 20, 30}\nprintln(arrays.get_first(nums))"}
    docs["arrays.get_last"] = ManEntry{module: "arrays", group: "Access", kind: "func", sig: "get_last(arr [T]) -> T", type_fields: "", desc: "Returns the last element of arr. Panics if arr is empty.", example: "import @arrays\nmut nums [i64] = {10, 20, 30}\nprintln(arrays.get_last(nums))"}
    docs["arrays.remove_first"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "remove_first(&arr [T]) -> T", type_fields: "", desc: "Removes and returns the first element of arr. Panics if arr is empty. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {10, 20, 30}\nmut val i64 = arrays.remove_first(nums)\nprintln(val)"}
    docs["arrays.remove_last"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "remove_last(&arr [T]) -> T", type_fields: "", desc: "Removes and returns the last element of arr. Panics if arr is empty. Modifies the array in place.", example: "import @arrays\nmut nums [i64] = {10, 20, 30}\nmut val i64 = arrays.remove_last(nums)\nprintln(val)"}
    docs["arrays.is_empty"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "is_empty(arr [T]) -> bool", type_fields: "", desc: "Returns true if arr has no elements.", example: "import @arrays\nmut nums [i64] = {}\nprintln(arrays.is_empty(nums))"}
    docs["arrays.contains"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "contains(arr [T], value T) -> bool", type_fields: "", desc: "Returns true if arr contains value.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\nprintln(arrays.contains(nums, 2))"}
    docs["arrays.index_of"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "index_of(arr [T], value T) -> i64", type_fields: "", desc: "Returns the index of the first occurrence of value in arr, or -1 if not found.", example: "import @arrays\nmut nums [i64] = {10, 20, 30}\nprintln(arrays.index_of(nums, 20))"}
    docs["arrays.count"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "count(arr [T], value T) -> i64", type_fields: "", desc: "Returns the number of times value appears in arr.", example: "import @arrays\nmut nums [i64] = {1, 2, 2, 3}\nprintln(arrays.count(nums, 2))"}
    docs["arrays.is_equal"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "is_equal(a [T], b [T]) -> bool", type_fields: "", desc: "Returns true if a and b have the same length and identical elements. T must be a primitive or string. Use this instead of == which is not allowed on arrays.", example: "import @arrays\nmut a [i64] = {1, 2, 3}\nmut b [i64] = {1, 2, 3}\nprintln(arrays.is_equal(a, b))"}
    docs["arrays.is_sorted"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "is_sorted(arr [T]) -> bool", type_fields: "", desc: "Returns true if the elements of arr are in ascending order (each element is <= the next). Empty and single-element arrays are sorted. T must be comparable, as for sort_asc.", example: "import @arrays\nmut nums [i64] = {1, 2, 2, 5}\nprintln(arrays.is_sorted(nums))"}
    docs["arrays.binary_search"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "binary_search(arr [T], val T) -> i64", type_fields: "", desc: "Searches a sorted array for val using binary search, returning its index or -1 if absent. arr must already be sorted in ascending order (as by sort_asc); behavior on an unsorted array is undefined. T must be comparable, as for sort_asc.", example: "import @arrays\nmut nums [i64] = {1, 3, 5, 7, 9}\nprintln(arrays.binary_search(nums, 7))"}
    docs["arrays.reverse"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "reverse(arr [T]) -> [T]", type_fields: "", desc: "Returns a new array with elements in reverse order. Does not modify the original.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\nprintln(arrays.reverse(nums))"}
    docs["arrays.slice"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "slice(arr [T], start i64, end i64) -> [T]", type_fields: "", desc: "Returns a new array containing elements from index start (inclusive) to end (exclusive). Does not modify the original.", example: "import @arrays\nmut nums [i64] = {10, 20, 30, 40}\nprintln(arrays.slice(nums, 1, 3))"}
    docs["arrays.concat"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "concat(a [T], b [T]) -> [T]", type_fields: "", desc: "Returns a new array containing all elements of a followed by all elements of b.", example: "import @arrays\nmut a [i64] = {1, 2}\nmut b [i64] = {3, 4}\nprintln(arrays.concat(a, b))"}
    docs["arrays.deduplicate"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "deduplicate(arr [T]) -> [T]", type_fields: "", desc: "Returns a new array with duplicate values removed, preserving the order of first occurrence.", example: "import @arrays\nmut nums [i64] = {1, 2, 2, 3, 1}\nprintln(arrays.deduplicate(nums))"}
    docs["arrays.counts"] = ManEntry{module: "arrays", group: "Query", kind: "func", sig: "counts(arr [T]) -> map[T:i64]", type_fields: "", desc: "Returns a frequency table mapping each distinct element of arr to the number of times it occurs. Keys appear in order of first occurrence; an empty array returns an empty map. T must be a primitive type, string, or enum.", example: "import @arrays\nmut votes [string] = {\"a\", \"b\", \"a\", \"c\", \"a\"}\nmut tally map[string:i64] = arrays.counts(votes)   // {\"a\": 3, \"b\": 1, \"c\": 1}"}
    docs["arrays.flatten"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "flatten(arr [[T]]) -> [T]", type_fields: "", desc: "Flattens one level of nesting, returning a single array of all inner elements.", example: "import @arrays\nmut nested [[i64]] = {{1, 2}, {3, 4}}\nprintln(arrays.flatten(nested))"}
    docs["arrays.split_every"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "split_every(arr [T], size i64) -> [[T]]", type_fields: "", desc: "Splits arr into sub-arrays of at most size elements each. The last chunk may be smaller.", example: "import @arrays\nmut nums [i64] = {1, 2, 3, 4, 5}\nprintln(arrays.split_every(nums, 2))"}
    docs["arrays.pair"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "pair(a [T], b [T]) -> [[T]]", type_fields: "", desc: "Returns an array of two-element arrays, pairing each element of a with the corresponding element of b. Length is determined by the shorter array.", example: "import @arrays\nmut keys [i64] = {1, 2, 3}\nmut vals [i64] = {10, 20, 30}\nprintln(arrays.pair(keys, vals))"}
    docs["arrays.rotate"] = ManEntry{module: "arrays", group: "Transformation", kind: "func", sig: "rotate(arr [T], n i64) -> [T]", type_fields: "", desc: "Returns a new array with elements rotated left by n. A negative n rotates right. Does not modify the original.", example: "import @arrays\nmut nums [i64] = {1, 2, 3, 4, 5}\nprintln(arrays.rotate(nums, 2))"}
    docs["arrays.get_sum"] = ManEntry{module: "arrays", group: "Computation", kind: "func", sig: "get_sum(arr [T]) -> T", type_fields: "", desc: "Returns the sum of all elements. Accepts i64, f64, or sized numeric types.", example: "import @arrays\nmut nums [i64] = {1, 2, 3, 4}\nprintln(arrays.get_sum(nums))"}
    docs["arrays.get_min"] = ManEntry{module: "arrays", group: "Computation", kind: "func", sig: "get_min(arr [T]) -> T", type_fields: "", desc: "Returns the smallest element in arr.", example: "import @arrays\nmut nums [i64] = {3, 1, 4, 1, 5}\nprintln(arrays.get_min(nums))"}
    docs["arrays.get_max"] = ManEntry{module: "arrays", group: "Computation", kind: "func", sig: "get_max(arr [T]) -> T", type_fields: "", desc: "Returns the largest element in arr.", example: "import @arrays\nmut nums [i64] = {3, 1, 4, 1, 5}\nprintln(arrays.get_max(nums))"}
    docs["arrays.min_index"] = ManEntry{module: "arrays", group: "Computation", kind: "func", sig: "min_index(arr [T]) -> i64", type_fields: "", desc: "Returns the index of the smallest element in arr, or -1 if arr is empty.", example: "import @arrays\nmut nums [i64] = {3, 1, 4, 1, 5}\nprintln(arrays.min_index(nums))"}
    docs["arrays.max_index"] = ManEntry{module: "arrays", group: "Computation", kind: "func", sig: "max_index(arr [T]) -> i64", type_fields: "", desc: "Returns the index of the largest element in arr, or -1 if arr is empty.", example: "import @arrays\nmut nums [i64] = {3, 1, 4, 1, 5}\nprintln(arrays.max_index(nums))"}
    docs["arrays.sort_asc"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "sort_asc(&arr [T])", type_fields: "", desc: "Sorts arr in ascending order in place. Works on arrays of any number type, char, bool, and string.", example: "import @arrays\nmut nums [i64] = {3, 1, 4, 1, 5}\narrays.sort_asc(nums)\nprintln(nums)"}
    docs["arrays.sort_desc"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "sort_desc(&arr [T])", type_fields: "", desc: "Sorts arr in descending order in place. Works on arrays of any number type, char, bool, and string.", example: "import @arrays\nmut nums [i64] = {3, 1, 4, 1, 5}\narrays.sort_desc(nums)\nprintln(nums)"}
    docs["arrays.sort_by"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "sort_by(&arr [T], less func(T, T) -> bool)", type_fields: "", desc: "Sorts arr in place using a caller-supplied comparison. less(a, b) returns true when a must come before b. Elements for which neither less(a, b) nor less(b, a) is true keep their relative order. Works on any element type, including structs.", example: "import @arrays\nconst Person struct {\n    name string\n    age i64\n}\ndo younger(a Person, b Person) -> bool { return a.age < b.age }\nmut people [Person] = {Person{name: \"Bo\", age: 30}, Person{name: \"Al\", age: 25}}\narrays.sort_by(people, ()younger)\nprintln(people[0].name)"}
    docs["arrays.swap"] = ManEntry{module: "arrays", group: "Modification", kind: "func", sig: "swap(&arr [T], i i64, j i64)", type_fields: "", desc: "Swaps the elements at indices i and j in place. Panics if either index is out of bounds.", example: "import @arrays\nmut nums [i64] = {1, 2, 3}\narrays.swap(nums, 0, 2)\nprintln(nums)"}
    docs["arrays.average"] = ManEntry{module: "arrays", group: "Computation", kind: "func", sig: "average(arr [T]) -> f64", type_fields: "", desc: "Returns the arithmetic mean of arr as an f64. T must be numeric. Panics on an empty array.", example: "import @arrays\nmut nums [i64] = {2, 4, 6}\nprintln(arrays.average(nums))"}
    docs["arrays.find"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "find(arr [T], predicate func(T) -> bool) -> (T, bool)", type_fields: "", desc: "Returns the first element for which predicate returns true and the boolean true, or the zero value and false when no element matches. The result must be destructured.", example: "import @arrays\ndo is_even(x i64) -> bool { return x % 2 == 0 }\nmut nums [i64] = {1, 3, 4, 7}\nmut hit i64, ok bool = arrays.find(nums, ()is_even)\nprintln(\"\${hit} \${ok}\")"}
    docs["arrays.find_index"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "find_index(arr [T], predicate func(T) -> bool) -> i64", type_fields: "", desc: "Returns the index of the first element for which predicate returns true, or -1 when no element matches.", example: "import @arrays\ndo is_even(x i64) -> bool { return x % 2 == 0 }\nmut nums [i64] = {1, 3, 4, 7}\nprintln(arrays.find_index(nums, ()is_even))"}
    docs["arrays.map"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "map(arr [T], transform func(T) -> T) -> [T]", type_fields: "", desc: "Returns a new array with transform applied to each element. transform must be a function that takes T and returns T. Does not modify the original.", example: "import @arrays\ndo double_it(x i64) -> i64 { return x * 2 }\nmut nums [i64] = {1, 2, 3}\nmut result [i64] = arrays.map(nums, ()double_it)\nprintln(result)"}
    docs["arrays.filter"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "filter(arr [T], predicate func(T) -> bool) -> [T]", type_fields: "", desc: "Returns a new array containing only elements for which predicate returns true. predicate must be a function that takes T and returns bool. Does not modify the original.", example: "import @arrays\ndo is_even(x i64) -> bool { return x % 2 == 0 }\nmut nums [i64] = {1, 2, 3, 4}\nmut result [i64] = arrays.filter(nums, ()is_even)\nprintln(result)"}
    docs["arrays.reduce"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "reduce(arr [T], initial T, accumulator func(T, T) -> T) -> T", type_fields: "", desc: "Reduces arr to a single value by applying accumulator(acc, element) for each element, starting with initial. accumulator must take two T parameters and return T. Does not modify the original.", example: "import @arrays\ndo add(a i64, b i64) -> i64 { return a + b }\nmut nums [i64] = {1, 2, 3, 4}\nmut total i64 = arrays.reduce(nums, 0, ()add)\nprintln(total)"}
    docs["arrays.any"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "any(arr [T], predicate func(T) -> bool) -> bool", type_fields: "", desc: "Returns true if predicate returns true for at least one element. predicate must be a function that takes T and returns bool.", example: "import @arrays\ndo is_negative(x i64) -> bool { return x < 0 }\nmut nums [i64] = {1, -2, 3}\nprintln(arrays.any(nums, ()is_negative))"}
    docs["arrays.all"] = ManEntry{module: "arrays", group: "Higher-Order", kind: "func", sig: "all(arr [T], predicate func(T) -> bool) -> bool", type_fields: "", desc: "Returns true if predicate returns true for every element. predicate must be a function that takes T and returns bool.", example: "import @arrays\ndo is_positive(x i64) -> bool { return x > 0 }\nmut nums [i64] = {1, 2, 3}\nprintln(arrays.all(nums, ()is_positive))"}
    docs["atomic.load"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "load(ptr ^i64) -> i64", type_fields: "", desc: "Atomically load a value.", example: "import @atomic\nmut val i64 = atomic.load(ptr)"}
    docs["atomic.store"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "store(ptr ^i64, val i64)", type_fields: "", desc: "Atomically store a value.", example: "import @atomic\natomic.store(ptr, 42)"}
    docs["atomic.add"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "add(ptr ^i64, val i64) -> i64", type_fields: "", desc: "Atomic add. Returns the previous value.", example: "import @atomic\nmut old i64 = atomic.add(ptr, 1)"}
    docs["atomic.sub"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "sub(ptr ^i64, val i64) -> i64", type_fields: "", desc: "Atomic subtract. Returns the previous value.", example: "import @atomic\nmut old i64 = atomic.sub(ptr, 1)"}
    docs["atomic.exchange"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "exchange(ptr ^i64, val i64) -> i64", type_fields: "", desc: "Atomic swap. Returns the previous value.", example: "import @atomic\nmut old i64 = atomic.exchange(ptr, 99)"}
    docs["atomic.cas"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "cas(ptr ^i64, expected i64, desired i64) -> bool", type_fields: "", desc: "Compare-and-swap. Returns true if the swap succeeded.", example: "import @atomic\nif atomic.cas(ptr, 0, 1) {\n    println(\"swapped\")\n}"}
    docs["atomic.and"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "and(ptr ^i64, val i64) -> i64", type_fields: "", desc: "Atomic bitwise AND. Returns the previous value.", example: "import @atomic\nmut old i64 = atomic.and(ptr, 0xFF)"}
    docs["atomic.or"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "or(ptr ^i64, val i64) -> i64", type_fields: "", desc: "Atomic bitwise OR. Returns the previous value.", example: "import @atomic\nmut old i64 = atomic.or(ptr, 0x01)"}
    docs["atomic.xor"] = ManEntry{module: "atomic", group: "64-bit Atomics", kind: "func", sig: "xor(ptr ^i64, val i64) -> i64", type_fields: "", desc: "Atomic bitwise XOR. Returns the previous value.", example: "import @atomic\nmut old i64 = atomic.xor(ptr, 0xFF)"}
    docs["atomic.spinlock"] = ManEntry{module: "atomic", group: "Spinlock", kind: "func", sig: "spinlock() -> SpinLock", type_fields: "", desc: "Create a new spinlock.", example: "import @atomic\nmut lk SpinLock = atomic.spinlock()"}
    docs["atomic.spin_lock"] = ManEntry{module: "atomic", group: "Spinlock", kind: "func", sig: "spin_lock(lk SpinLock)", type_fields: "", desc: "Acquire a spinlock. Spins until acquired.", example: "import @atomic\natomic.spin_lock(lk)\n// critical section\natomic.spin_unlock(lk)"}
    docs["atomic.spin_trylock"] = ManEntry{module: "atomic", group: "Spinlock", kind: "func", sig: "spin_trylock(lk SpinLock) -> bool", type_fields: "", desc: "Try to acquire a spinlock without blocking. Returns true if acquired.", example: "import @atomic\nif atomic.spin_trylock(lk) {\n    // critical section\n    atomic.spin_unlock(lk)\n}"}
    docs["atomic.spin_unlock"] = ManEntry{module: "atomic", group: "Spinlock", kind: "func", sig: "spin_unlock(lk SpinLock)", type_fields: "", desc: "Release a spinlock.", example: "import @atomic\natomic.spin_unlock(lk)"}
    docs["atomic.spinlock_destroy"] = ManEntry{module: "atomic", group: "Spinlock", kind: "func", sig: "spinlock_destroy(lk SpinLock)", type_fields: "", desc: "Destroy a spinlock and free its resources.", example: "import @atomic\natomic.spinlock_destroy(lk)"}
    docs["atomic.fence"] = ManEntry{module: "atomic", group: "Memory Barrier", kind: "func", sig: "fence()", type_fields: "", desc: "Full memory barrier with sequential consistency.", example: "import @atomic\natomic.fence()"}
    docs["binary.encode_i8"] = ManEntry{module: "binary", group: "8-bit", kind: "func", sig: "encode_i8(val i8) -> [u8]", type_fields: "", desc: "Encodes a signed 8-bit integer as a 1-byte array.", example: "import @binary\nmut bytes [u8] = binary.encode_i8(-42)"}
    docs["binary.decode_i8"] = ManEntry{module: "binary", group: "8-bit", kind: "func", sig: "decode_i8(bytes [u8]) -> i8", type_fields: "", desc: "Decodes a 1-byte array as a signed 8-bit integer.", example: "import @binary\nmut bytes [u8] = binary.encode_i8(-42)\nmut val i8 = binary.decode_i8(bytes)"}
    docs["binary.encode_u8"] = ManEntry{module: "binary", group: "8-bit", kind: "func", sig: "encode_u8(val u8) -> [u8]", type_fields: "", desc: "Encodes an unsigned 8-bit integer as a 1-byte array.", example: "import @binary\nmut bytes [u8] = binary.encode_u8(200)"}
    docs["binary.decode_u8"] = ManEntry{module: "binary", group: "8-bit", kind: "func", sig: "decode_u8(bytes [u8]) -> u8", type_fields: "", desc: "Decodes a 1-byte array as an unsigned 8-bit integer.", example: "import @binary\nmut bytes [u8] = binary.encode_u8(200)\nmut val u8 = binary.decode_u8(bytes)"}
    docs["binary.encode_i16_le"] = ManEntry{module: "binary", group: "16-bit", kind: "func", sig: "encode_i16_le(val i16) -> [u8]", type_fields: "", desc: "Encodes a signed 16-bit integer as a 2-byte little-endian array.", example: "import @binary\nmut bytes [u8] = binary.encode_i16_le(-1000)"}
    docs["binary.decode_i16_le"] = ManEntry{module: "binary", group: "16-bit", kind: "func", sig: "decode_i16_le(bytes [u8]) -> i16", type_fields: "", desc: "Decodes a 2-byte little-endian array as a signed 16-bit integer.", example: "import @binary\nmut bytes [u8] = binary.encode_i16_le(-1000)\nmut val i16 = binary.decode_i16_le(bytes)"}
