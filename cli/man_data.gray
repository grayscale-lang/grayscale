    docs["binary.decode_i64_le"] = ManEntry{module: "binary", group: "64-bit", kind: "func", sig: "decode_i64_le(bytes [u8]) -> i64", type_fields: "", desc: "Decodes an 8-byte little-endian array as a signed 64-bit integer.", example: "import @binary\nmut bytes [u8] = binary.encode_i64_le(-1000)\nmut val i64 = binary.decode_i64_le(bytes)"}
    docs["binary.encode_i64_be"] = ManEntry{module: "binary", group: "64-bit", kind: "func", sig: "encode_i64_be(val i64) -> [u8]", type_fields: "", desc: "Encodes a signed 64-bit integer as an 8-byte big-endian array.", example: "import @binary\nmut bytes [u8] = binary.encode_i64_be(-1000)"}
