    docs["binary.encode_u32_le"] = ManEntry{module: "binary", group: "32-bit", kind: "func", sig: "encode_u32_le(val u32) -> [u8]", type_fields: "", desc: "Encodes an unsigned 32-bit integer as a 4-byte little-endian array.", example: "import @binary\nmut bytes [u8] = binary.encode_u32_le(1000)"}
