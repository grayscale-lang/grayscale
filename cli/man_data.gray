    docs["binary.encode_i128_le"] = ManEntry{module: "binary", group: "128-bit", kind: "func", sig: "encode_i128_le(val i128) -> [u8]", type_fields: "", desc: "Encodes a signed 128-bit integer as a 16-byte little-endian array.", example: "import @binary\nmut bytes [u8] = binary.encode_i128_le(i128(-1000))"}
    docs["binary.decode_i128_le"] = ManEntry{module: "binary", group: "128-bit", kind: "func", sig: "decode_i128_le(bytes [u8]) -> i128", type_fields: "", desc: "Decodes a 16-byte little-endian array as a signed 128-bit integer.", example: "import @binary\nmut bytes [u8] = binary.encode_i128_le(i128(-1000))\nif binary.decode_i128_le(bytes) == i128(-1000) { println(\"round-trip ok\") }"}
    docs["binary.encode_i128_be"] = ManEntry{module: "binary", group: "128-bit", kind: "func", sig: "encode_i128_be(val i128) -> [u8]", type_fields: "", desc: "Encodes a signed 128-bit integer as a 16-byte big-endian array.", example: "import @binary\nmut bytes [u8] = binary.encode_i128_be(i128(-1000))"}
