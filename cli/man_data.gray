    docs["binary.encode_u64_le"] = ManEntry{module: "binary", group: "64-bit", kind: "func", sig: "encode_u64_le(val u64) -> [u8]", type_fields: "", desc: "Encodes an unsigned 64-bit integer as an 8-byte little-endian array.", example: "import @binary\nmut bytes [u8] = binary.encode_u64_le(1000)"}
