        passed++
    } otherwise {
        println("  [FAIL] maps.merge / remove_key: ${mmerge}")
        failed++
    }

    mut mclear map[string:int] = {"x": 1, "y": 2}
    maps.clear(mclear)
    if len(mclear) == 0 {
        println("  [PASS] maps.clear empties the map")
        passed++
    } otherwise {
        println("  [FAIL] maps.clear: len=${len(mclear)}")
        failed++
    }

    // =========================================================================
    println("")
    println("=== 45. @math (extended) ===")
    // =========================================================================

    if math.round(2.5) == 3.0 && math.trunc(2.9) == 2.0 {
        println("  [PASS] math.round / trunc")
        passed++
    } otherwise {
        println("  [FAIL] math.round / trunc")
        failed++
    }

    if math.gcd(12, 8) == 4 && math.lcm(4, 6) == 12 {
        println("  [PASS] math.gcd(12,8) = 4, math.lcm(4,6) = 12")
        passed++
    } otherwise {
        println("  [FAIL] math.gcd / lcm")
        failed++
    }

    if math.clamp(15, 0, 10) == 10 && math.clamp(-3, 0, 10) == 0 {
        println("  [PASS] math.clamp bounds both ends")
        passed++
    } otherwise {
        println("  [FAIL] math.clamp")
        failed++
    }

    if math.factorial(5) == 120 && math.log2(8.0) == 3.0 {
        println("  [PASS] math.factorial(5) = 120, math.log2(8.0) = 3.0")
        passed++
    } otherwise {
        println("  [FAIL] math.factorial / log2")
        failed++
    }

    if math.PI > 3.14159 && math.PI < 3.1416 && math.TAU > 6.28 {
        println("  [PASS] math.PI / math.TAU constants")
        passed++
    } otherwise {
        println("  [FAIL] math constants: PI=${math.PI}")
        failed++
    }

    // =========================================================================
    println("")
    println("=== 46. @json (decode / round-trip / nested) ===")
    // =========================================================================

    mut jd_map, jd_err = json.decode("{\"x\":\"1\",\"y\":\"two\"}")
    if jd_err == nil && jd_map["x"] == "1" && jd_map["y"] == "two" {
        println("  [PASS] json.decode into a string-valued map")
        passed++
    } otherwise {
        println("  [FAIL] json.decode: err or wrong values")
        failed++
    }

    mut _, jd_bad_err = json.decode("{not json}")
    if jd_bad_err != nil {
        println("  [PASS] json.decode reports an error on malformed input")
        passed++
    } otherwise {
        println("  [FAIL] json.decode should fail on \"{not json}\"")
        failed++
    }

    mut jrt_src map[string:string] = {"name": "gray", "kind": "lang"}
    mut jrt_txt string = json.encode(jrt_src)
    mut jrt_back, jrt_back_err = json.decode(jrt_txt)
    if jrt_back_err == nil && jrt_back["name"] == "gray" && jrt_back["kind"] == "lang" {
        println("  [PASS] json encode → decode round-trip")
        passed++
    } otherwise {
        println("  [FAIL] json round-trip: \"${jrt_txt}\"")
        failed++
    }

    if json.is_valid("{\"a\":{\"b\":1},\"c\":[1,2,3]}") && !json.is_valid("{\"a\":}") {
        println("  [PASS] json.is_valid on a nested object")
        passed++
    } otherwise {
        println("  [FAIL] json.is_valid nested")
        failed++
    }

    // =========================================================================
    println("")
    println("=== 47. @strconv (error slot) ===")
    // =========================================================================

    mut sc_n, sc_e = strconv.to_int("123")
    if sc_e == nil && sc_n == 123 {
        println("  [PASS] strconv.to_int(\"123\") = 123, nil error")
        passed++
    } otherwise {
        println("  [FAIL] strconv.to_int valid: n=${sc_n}")
        failed++
    }

    mut _, sc_e2 = strconv.to_int("not-a-number")
    if sc_e2 != nil {
        println("  [PASS] strconv.to_int reports an error on invalid input")
        passed++
    } otherwise {
        println("  [FAIL] strconv.to_int(\"not-a-number\") should error")
        failed++
    }

    mut _, sc_ef = strconv.to_float("3.5x")
    if sc_ef != nil {
        println("  [PASS] strconv.to_float reports an error on invalid input")
        passed++
    } otherwise {
        println("  [FAIL] strconv.to_float(\"3.5x\") should error")
        failed++
    }

    // =========================================================================
    println("")
    println("=== 48. @csv ===")
    // =========================================================================

    mut csv_rows [[string]] = csv.parse("name,age\nalice,30\nbob,25")
    if len(csv_rows) == 3 && csv_rows[1][0] == "alice" && csv_rows[2][1] == "25" {
        println("  [PASS] csv.parse splits rows and fields")
        passed++
    } otherwise {
        println("  [FAIL] csv.parse: ${len(csv_rows)} rows")
        failed++
    }

    mut csv_head [string] = csv.headers(csv_rows)
    if len(csv_head) == 2 && csv_head[0] == "name" && csv_head[1] == "age" {
        println("  [PASS] csv.headers returns the first row")
        passed++
    } otherwise {
        println("  [FAIL] csv.headers: got ${csv_head}")
        failed++
    }

    mut csv_in [[string]] = {{"a", "b"}, {"1", "2"}}
    mut csv_out string = csv.encode(csv_in)
    if strings.contains(csv_out, "a,b") && strings.contains(csv_out, "1,2") {
        println("  [PASS] csv.encode joins fields with commas")
        passed++
    } otherwise {
        println("  [FAIL] csv.encode: got \"${csv_out}\"")
        failed++
    }

    // =========================================================================
    println("")
    println("=== 49. @runtime ===")
    // =========================================================================

    if runtime.version() != "" {
        println("  [PASS] runtime.version() returns a non-empty build string")
        passed++
    } otherwise {
        println("  [FAIL] runtime.version() is empty")
        failed++
    }

    if runtime.call_limit() > 0 && runtime.call_depth() >= 1 {
        println("  [PASS] runtime.call_limit / call_depth report sane values")
        passed++
    } otherwise {
        println("  [FAIL] runtime.call_limit / call_depth")
        failed++
    }

    if runtime.total_usage() == runtime.arena_usage() + runtime.heap_usage() {
        println("  [PASS] runtime.total_usage = arena_usage + heap_usage")
        passed++
    } otherwise {
        println("  [FAIL] runtime usage invariant")
        failed++
    }

    // =========================================================================
    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
        exit(1)
    }
    println("ALL TESTS PASSED")
}
