// verify.gray — "gray verify": compile and run the embedded language
// verification program to confirm the installation works.

import @io
import @os
import @path
import "./driver"

const VERIFY_SOURCE string = embed("tests.gray")

// run_verify writes the embedded tests.gray to a temporary file, compiles and
// runs it with grayc, then reports pass or fail. It returns the exit status.
do run_verify() -> i64 {
    // verify compiles and runs a program, which needs the Grayscale runtime.
    // Say so up front: "Running verification test..." followed by a compile
    // error reads as a broken install rather than a missing feature.
    if os.current_os() == os.WINDOWS {
        eprintln("gray verify is not available on Windows yet.")
        eprintln("  It compiles and runs a program, which needs the Grayscale runtime.")
        eprintln("  Working today: gray check, gray fmt, gray doc, gray build --emit-c")
        return 1
    }

    temp_directory, temp_err = io.temp_dir()
    if temp_err != nil {
        eprintln("error: could not create temp file: ${temp_err.message}")
        return 1
    }
    source_path string = path.join_parts({temp_directory, "gray-verify.gray"})
    _, write_err = io.write_file(source_path, VERIFY_SOURCE)
    if write_err != nil {
        eprintln("error: could not write temp file: ${write_err.message}")
        return 1
    }

    println("Running Grayscale language verification test...")
    no_arguments [string] = {}
    code, run_err = driver.run(source_path, no_arguments)
    if run_err != nil {
        eprintln("error: ${run_err.message}")
        return 1
    }
    if code == 0 {
        println("Verification passed.")
    } otherwise {
        eprintln("Verification FAILED.")
    }
    return code
}
