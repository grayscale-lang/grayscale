        "E6009": "'%s' and '%s' produce the same compiled name; one of them would be lost",
        "E6010": "unknown module '%s'; no import, struct, or variable by that name is in scope",
        "E6011": "module '%s' is already imported in this file",
        "E6012": "#json struct '%s' requires 'import @json' in the same file",
        "E6013": "C interop symbols cannot be brought into scope with 'using'; every C call must stay qualified with 'extern.'",
        "E6014": "malformed import statement",
        "E6015": "C header '%s' could not be found for the current target",
        "E6016": "C header '%s' conflicts with C header '%s': both declare '%s' with incompatible types",
        "E6017": "import '%s' matches both a .gray and a .grayscale file; import one by its full file name",
        "E7014": "cannot convert %lld to char; value must be a valid Unicode scalar value (0 to 1114111, excluding the surrogates 55296 to 57343)",
        "E7015": "'len()' is not supported for type '%s'",
