        "E5066": "-define: names '%s', which is not marked #define",
        "E5067": "callback '%s' passed as argument %d of C function '%s' does not match the function pointer type '%s' the imported header declares",
        "E5068": "'%s' wraps integers only; got %s and %s",
        "E5069": "'size_of()' requires a type, not a value",
        "E5070": "'copy()' cannot be applied to '%s'; it is a handle to shared state, not a copyable value",
        "E6001": "unknown module '@%s'",
        "E6002": "cannot find file or directory '%s'",
        "E6003": "directory '%s' contains no source files",
        "E6004": "cannot import own module directory",
        "E6005": "cannot import the program's entry point",
        "E6006": "module name derived from the import path is not a usable identifier",
        "E6007": "standard library imports cannot be aliased",
