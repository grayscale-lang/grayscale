        "E5040": "constant requires a compile-time value; function calls are evaluated at runtime",
        "E5042": "'#discard' attribute is not allowed on void function '%s'; only functions that return a value can use '#discard'",
        "E5043": "'fields()' requires a struct instance, got '%s'",
        "E5045": "'%s.%s' requires %s; got %lld",
        "E5046": "'#test' function '%s' must take no parameters and have no return type",
        "E5047": "'#test' function '%s' cannot be called directly; it runs only under 'gray test'",
        "E5049": "return type mismatch: expected %s, got %s",
        "E5050": "wrong number of arguments to C function '%s'; the imported header declares %s argument(s), the call passes %d",
        "E5051": "cannot call '%s' on '%s'; it is a fixed-size array field and its length cannot change",
        "E5052": "unknown C symbol '%s'; no such function, constant, or macro in the imported header(s)",
        "E5053": "C function '%s' returns '%s', which cannot be used as '%s'",
        "E5054": "argument %d of C function '%s' has type '%s', which C cannot convert to the parameter type '%s' the imported header declares",
        "E5055": "named arguments are not supported for C interop calls; pass arguments to 'extern.%s' positionally",
