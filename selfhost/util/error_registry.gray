        "E3215": "'distinct alias %s' must target a primitive type (an integer, f32, f64, bool, char, or string), not '%s'",
        "E3216": "cannot pass a string to '%s'; the C function keeps the pointer past the string's scope. Pass to_c_string(...) instead",
        "E4001": "undefined variable '%s'",
        "E4002": "undefined function '%s'",
        "E4003": "variable '%s' already declared in this scope (line %d)",
