        "E5057": "'%s.%s()' arguments must share one number type",
        "E5058": "'%s.is_equal()' does not support %s of type %s",
        "E5060": "'csv.filter_rows()' requires a function reference",
        "E5061": "'csv.filter_rows()' callback must be func([string]) -> bool",
