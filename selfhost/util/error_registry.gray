        "E9003": "'arrays.%s()' requires a function reference; use '()func_name' to pass a function",
        "E9004": "'arrays.%s()' callback signature mismatch; %s",
        "E9005": "invalid range: start (%s) must be %s end (%s)",
        "E9006": "'arrays.contains()' does not support arrays of '%s'; only primitive and string element types are supported",
        "E9007": "'arrays.%s()' requires a comparable array (numeric, string, bool, or enum), got array of '%s'",
        "E12001": "'maps.%s()' requires a map argument, got an array",
        "E12006": "duplicate key in map literal",
        "E12007": "'maps.%s()' does not support maps with '%s' values; only primitive and string value types are supported",
        "E12008": "'maps.sorted_keys()' requires string, integer, or char keys, got '%s'",
        "E8001": "'%s' can only be used with integers or #flags enums; got '%s' and '%s'",
        "E8002": "'bit_not' can only be used with integers; got '%s'",
        "W1001": "variable '%s' is declared but never used",
        "W1003": "function '%s' is declared but never called",
        "W1005": "typed blank identifier; '_' doesn't need a type annotation, use 'mut _ = <expr>' instead",
        "W1004": "'%s' declared with no value — defaults to %s",
        "W1002": "module '%s' is imported but never used; remove the import or use the module",
        "W2002": "%s '%s' shadows a variable declared on line %d",
        "W2003": "unreachable code; this statement will never execute because it comes after a return",
        "W2007": "variable '%s' shadows a global constant or variable declared on line %d",
        "W2008": "parameter '%s' shadows enum variant '%s.%s'",
        "W2011": "named return value '%s' is declared in the signature but no matching variable exists in the function body",
        "W2012": "'when' condition is a float; equality checks on floats are imprecise; prefer 'math.abs(x - y) < epsilon'",
        "W2014": "intra-directory import already included by directory import",
        "W2015": "direct import of a file already covered by a directory import in this file is redundant",
        "W3003": "fixed-size array %s initialized with only %d of %d elements; remaining will be zero-valued",
        "W3005": "when statement matches on enum values without #strict and no default; exhaustiveness is not checked",
        "W3006": "empty default branch in when statement; unmatched values are silently ignored",
        "W3007": "%s '%s' is deprecated"
    }
    return registry
}

// The registry message of `code`, or "" when the code is unknown.
fn registry_message(code string) -> string {
    registry = error_registry()
    return maps.get_or_default(registry, code, "")
}

// The registry message with each `%s` / `%d` replaced, left to right, by `arguments`.
fn registry_message_formatted(code string, arguments [string]) -> string {
    template string = registry_message(code)
    mut text string = ""
    mut next_arg i64 = 0
    mut i i64 = 0
    as_long_as i < len(template) {
        character char = strings.char_at(template, i)
        if character == '%' && i + 1 < len(template) {
            specifier char = strings.char_at(template, i + 1)
            mut specifier_end i64 = i + 1
            as_long_as specifier_end < len(template) - 1 && (strings.char_at(template, specifier_end) == 'l' || strings.char_at(template, specifier_end) == 'z') {
                specifier_end = specifier_end + 1
            }
            conversion char = strings.char_at(template, specifier_end)
            if (conversion == 's' || conversion == 'd' || conversion == 'u' || conversion == 'c') && next_arg < len(arguments) {
                text = "${text}${arguments[next_arg]}"
                next_arg = next_arg + 1
                i = specifier_end + 1
                continue
            }
            if specifier == '%' {
                text = "${text}%"
                i = i + 2
                continue
            }
        }
        text = "${text}${strings.slice(template, i, i + 1)}"
        i = i + 1
    }
    return text
}
