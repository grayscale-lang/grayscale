        if module_name == "math" { return gen_math_call(generator, node, function_name) }
        direct_call = gen_direct_module_call(generator, node, module_name, function_name)
        if direct_call != "" { return direct_call }
        return "0 /* unsupported stdlib call ${key} */"
    }
    entry = generator^.stdlib_calls[key]
    // An id is reserved for every array function emitted generically
    mut generic_array_id i64 = -1
    if entry.module == "arrays" && !arrays_function_has_own_emission(function_name, len(arguments)) { generic_array_id = next_id(generator) }
    mut pieces [string] = {}
    if entry.takes_arena { arrays.append(pieces, "gray_default_arena") }
    for i in range(0, len(arguments)) {
        mut piece = gen_expr(generator, arguments[i])
        if arrays.contains(entry.pointer_params, i) { piece = address_of_arg(generator, arguments[i]) }
        // an element stored into an array is a copy of a composite that already has storage
        if entry.module == "arrays" && i > 0 && is_array_type(expr_type(generator, arguments[0])) && expr_type(generator, arguments[i]) == array_element_type(expr_type(generator, arguments[0])) && names_existing_storage(arguments[i]) && type_shares_storage(generator, expr_type(generator, arguments[i])) {
            piece = "(${ctype(generator, expr_type(generator, arguments[i]))}[1]){${gen_stored(generator, expr_type(generator, arguments[i]), arguments[i])}}"
        }
        arrays.append(pieces, piece)
    }
    // Parameters the call leaves out take their declared defaults
    for i in range(len(arguments), len(entry.defaults)) {
        default_text = entry.defaults[i]
        if default_text == "" { continue }
        if strings.starts_with(default_text, "\"") {
            arrays.append(pieces, "gray_string_lit(${default_text})")
        } otherwise {
            arrays.append(pieces, default_text)
        }
    }
    call_result = "${entry.c_name}(${strings.join(pieces, ", ")})"
    // the merged values still share storage with both sources
    if entry.module == "maps" && function_name == "merge" && len(arguments) == 2 && type_shares_storage(generator, map_value_type(expr_type(generator, arguments[0]))) {
        merge_id = next_id(generator)
        return "({ GrayMap _mg${merge_id} = ${call_result}; ${value_deep_copy(generator, expr_type(generator, arguments[0]), "_mg${merge_id}")}; })"
    }
    // an array of composites built from another array's elements holds copies of them
    if generic_array_id >= 0 {
        copied_type = copied_array_type(generator, function_name, arguments[0])
        if copied_type != "" { return "({ GrayArray _ac${generic_array_id} = ${call_result}; ${value_deep_copy(generator, copied_type, "_ac${generic_array_id}")}; })" }
    }
    return call_result
}

// True for the array functions emitted with a branch of their own; every other one goes
// through its generic path.
fn arrays_function_has_own_emission(function_name string, argument_count i64) -> bool {
    if arrays.contains({"append", "remove", "sort_by", "contains", "index_of", "count", "is_equal", "prepend", "find_index", "find", "map", "filter", "any", "all", "binary_search"}, function_name) { return argument_count == 2 }
    if function_name == "sort_asc" || function_name == "sort_desc" { return argument_count == 1 }
    if function_name == "insert_at" || function_name == "fill" || function_name == "reduce" { return argument_count == 3 }
    if arrays.contains({"get_first", "get_last", "remove_last", "remove_first", "average", "get_sum", "get_min", "get_max"}, function_name) { return argument_count == 1 }
    return false
}

// The array type a generic array function's result is deep-copied as (its elements still share
// storage with the source), or "".
fn copied_array_type(generator ^CodeGen, function_name string, source ^ast.AstNode) -> string {
    source_element = array_element_type(expr_type(generator, source))
    if function_name == "reverse" || function_name == "slice" || function_name == "concat" || function_name == "deduplicate" {
        if source_element != "" && type_shares_storage(generator, source_element) { return "[${source_element}]" }
        return ""
    }
    if function_name == "split_every" || function_name == "pair" || function_name == "flatten" {
        mut inner = source_element
        if function_name == "flatten" {
            inner = ""
            if strings.starts_with(source_element, "[") { inner = strings.slice(source_element, 1, len(source_element)) }
            if inner != "" { inner = strings.slice(inner, 0, len(inner) - 1) }
        }
        if inner != "" && type_shares_storage(generator, inner) {
            if function_name == "flatten" { return "[${inner}]" }
            return "[[${inner}]]"
        }
    }
    return ""
}

// --- Statements ---

// True if evaluating this expression can reach C code that panics without a location of its own
// (any call, allocation, aggregate literal, string interpolation or concatenation, cast).
fn expression_needs_panic_location(generator ^CodeGen, expression ^ast.AstNode) -> bool {
    if expression == nil { return false }
    when expression^.kind {
        is ast.NodeKind.CALL_EXPR { return true }
        is ast.NodeKind.NEW_EXPR { return true }
        is ast.NodeKind.INTERPOLATED_STRING { return true }
        is ast.NodeKind.STRING_VALUE { return true }
        is ast.NodeKind.ARRAY_VALUE { return true }
        is ast.NodeKind.MAP_VALUE { return true }
        is ast.NodeKind.STRUCT_VALUE { return true }
        is ast.NodeKind.CAST_EXPR { return true }
        is ast.NodeKind.PREFIX_EXPR { return expression_needs_panic_location(generator, expression^.prefix^.right) }
        is ast.NodeKind.POSTFIX_EXPR { return expression_needs_panic_location(generator, expression^.postfix^.left) }
        is ast.NodeKind.INFIX_EXPR {
            if expr_type(generator, expression) == "string" { return true }
            return expression_needs_panic_location(generator, expression^.infix^.left) || expression_needs_panic_location(generator, expression^.infix^.right)
        }
        is ast.NodeKind.INDEX_EXPR {
            return expression_needs_panic_location(generator, expression^.index_data^.left) || expression_needs_panic_location(generator, expression^.index_data^.index_expr)
        }
        is ast.NodeKind.MEMBER_EXPR { return expression_needs_panic_location(generator, expression^.member^.object) }
        is ast.NodeKind.RANGE_EXPR {
            return expression_needs_panic_location(generator, expression^.range_expr^.start_expr) || expression_needs_panic_location(generator, expression^.range_expr^.end_expr) || expression_needs_panic_location(generator, expression^.range_expr^.step)
        }
        default { return false }
    }
}

// Whether a statement's source location is stamped for the runtime. Only the expressions the
// statement evaluates directly count; nested statements stamp themselves.
fn statement_needs_panic_location(generator ^CodeGen, node ^ast.AstNode) -> bool {
    when node^.kind {
        is ast.NodeKind.VAR_DECL { return expression_needs_panic_location(generator, node^.var_decl^.value) }
        is ast.NodeKind.ASSIGN_STMT {
            return expression_needs_panic_location(generator, node^.assign^.target) || expression_needs_panic_location(generator, node^.assign^.value)
        }
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values {
                if expression_needs_panic_location(generator, value) { return true }
            }
            return false
        }
        is ast.NodeKind.EXPR_STMT { return expression_needs_panic_location(generator, node^.expr_stmt^.expr) }
        is ast.NodeKind.IF_STMT { return expression_needs_panic_location(generator, node^.if_stmt^.condition) }
        is ast.NodeKind.WHILE_STMT { return expression_needs_panic_location(generator, node^.while_stmt^.condition) }
        is ast.NodeKind.WHEN_STMT { return expression_needs_panic_location(generator, node^.when_stmt^.value) }
        is ast.NodeKind.FOR_EACH_STMT { return expression_needs_panic_location(generator, node^.for_each_stmt^.collection) }
        is ast.NodeKind.BREAK_STMT { return false }
        is ast.NodeKind.CONTINUE_STMT { return false }
        default { return true }
    }
}

// `#line N "file"` at column 0 (a directive must not be indented).
fn emit_line_directive(generator ^CodeGen, file string, line i64) {
    emit(generator, "#line ${line} \"${file}\"\n")
}

// Points the generated C that follows at a synthetic marker, so scaffolding with no source
// origin does not inherit the last statement's location.
fn reset_line_directive(generator ^CodeGen) {
    emit(generator, "#line 1 \"<generated>\"\n")
    generator^.last_line_file = ""
    generator^.last_line_number = 0
}

// The location stamp and `#line` directive that precede a statement inside a function body.
fn stmt_prelude(generator ^CodeGen, node ^ast.AstNode) {
    if generator^.indent <= 0 || generator^.file == "" || node^.tok.line <= 0 { return }
    if statement_needs_panic_location(generator, node) {
        emit_line(generator, "gray_set_panic_call(\"${generator^.file}\", ${node^.tok.line});")
    }
    if generator^.last_line_file != generator^.file || generator^.last_line_number != node^.tok.line {
        emit_line_directive(generator, generator^.file, node^.tok.line)
        generator^.last_line_file = generator^.file
        generator^.last_line_number = node^.tok.line
    }
}

// Opens the frame a labeled loop's `break name` and `continue name` find. Call
// after the loop's own iteration guard is registered, before its body.
fn begin_loop(generator ^CodeGen, node ^ast.AstNode, has_iteration_arena bool) {
    if node^.loop_label == "" { return }
    arrays.append(generator^.labeled_loops, LabeledLoop{label: node^.loop_label, id: next_id(generator), guard_floor: len(generator^.iterating), arena_floor: len(generator^.scope_arena_variables), has_iteration_arena: has_iteration_arena})
}

// Where `continue name` lands: the end of the labeled loop's body, so the loop
// goes on to its next iteration.
fn emit_continue_target(generator ^CodeGen, node ^ast.AstNode) {
    if node^.loop_label == "" { return }
    frame = generator^.labeled_loops[len(generator^.labeled_loops) - 1]
    if frame.is_continue_used { emit_line(generator, "_gray_continue_${frame.id}: ;") }
}

// Closes the frame; `break name` lands just after the labeled loop.
fn end_loop(generator ^CodeGen, node ^ast.AstNode) {
    if node^.loop_label == "" { return }
    frame = generator^.labeled_loops[len(generator^.labeled_loops) - 1]
    mut _ = arrays.remove_last(generator^.labeled_loops)
    if frame.is_break_used { emit_line(generator, "_gray_break_${frame.id}: ;") }
}

// `break name` / `continue name`: release the iteration guards of the loops
// left, then jump. The target's own guard stays live.
fn gen_labeled_jump(generator ^CodeGen, node ^ast.AstNode, is_break bool) {
    name = node^.loop_jump^.label
    mut index i64 = len(generator^.labeled_loops) - 1
    as_long_as index >= 0 && generator^.labeled_loops[index].label != name { index = index - 1 }
    if index < 0 {
        emit_line(generator, "/* labeled jump names no enclosing loop at ${node^.tok.file}:${node^.tok.line} */")
        return
    }
    mut release = labeled_exit_unwind(generator, generator^.labeled_loops[index])
    mut guard i64 = len(generator^.iterating) - 1
    as_long_as guard >= generator^.labeled_loops[index].guard_floor {
        release = "${release}gray_atomic_sub32(&${generator^.iterating[guard]}.iterating, 1); "
        guard = guard - 1
    }
    id = generator^.labeled_loops[index].id
    if is_break {
        generator^.labeled_loops[index].is_break_used = true
        emit_line(generator, "${release}goto _gray_break_${id};")
    } otherwise {
        generator^.labeled_loops[index].is_continue_used = true
        emit_line(generator, "${release}goto _gray_continue_${id};")
    }
}

fn gen_block_body(generator ^CodeGen, block ^ast.AstNode) {
    if block == nil { return }
    if block^.kind != ast.NodeKind.BLOCK_STMT {
        gen_statement(generator, block)
        return
    }
    for_each statement in block^.block^.stmts { gen_statement(generator, statement) }
}

fn gen_statement(generator ^CodeGen, node ^ast.AstNode) {
    if node == nil { return }
    stmt_prelude(generator, node)
    when node^.kind {
        is ast.NodeKind.VAR_DECL { gen_var_decl(generator, node) }
        is ast.NodeKind.ASSIGN_STMT { gen_module_aware(generator, node) }
        is ast.NodeKind.RETURN_STMT { gen_return(generator, node) }
        is ast.NodeKind.EXPR_STMT { gen_module_aware(generator, node) }
        is ast.NodeKind.ENSURE_STMT { generator^.ensure_reached = generator^.ensure_reached + 1 }
        is ast.NodeKind.IF_STMT {
            saved_raw_names = generator^.raw_names
            gen_if(generator, node)
            generator^.raw_names = saved_raw_names
        }
        is ast.NodeKind.FOR_STMT { gen_for(generator, node) }
        is ast.NodeKind.WHEN_STMT { gen_when(generator, node) }
        is ast.NodeKind.FOR_EACH_STMT { gen_for_each(generator, node) }
        is ast.NodeKind.WHILE_STMT {
            no_arena = block_allocation_free(generator, node^.while_stmt^.body)
            loop_arena_prologue(generator, no_arena)
            emit_line(generator, "while (${gen_expr(generator, node^.while_stmt^.condition)}) {")
            generator^.indent = generator^.indent + 1
            gen_loop_body(generator, node, node^.while_stmt^.body, no_arena)
            generator^.indent = generator^.indent - 1
            emit_line(generator, "}")
            end_loop(generator, node)
            loop_arena_epilogue(generator, no_arena)
        }
        is ast.NodeKind.LOOP_STMT {
            no_arena = block_allocation_free(generator, node^.loop_stmt^.body)
            loop_arena_prologue(generator, no_arena)
            emit_line(generator, "for (;;) {")
            generator^.indent = generator^.indent + 1
            gen_loop_body(generator, node, node^.loop_stmt^.body, no_arena)
            generator^.indent = generator^.indent - 1
            emit_line(generator, "}")
            end_loop(generator, node)
            loop_arena_epilogue(generator, no_arena)
        }
        is ast.NodeKind.BREAK_STMT {
            if node^.loop_jump^.label != "" {
                gen_labeled_jump(generator, node, true)
            } otherwise {
                emit_line(generator, "${loop_exit_unwind(generator)}break;")
            }
        }
        is ast.NodeKind.CONTINUE_STMT {
            if node^.loop_jump^.label != "" {
                gen_labeled_jump(generator, node, false)
            } otherwise {
                emit_line(generator, "${loop_exit_unwind(generator)}continue;")
            }
        }
        is ast.NodeKind.BLOCK_STMT {
            if is_desugared_block(node) || !node^.block^.is_unsafe {
                gen_block_body(generator, node)
            } otherwise {
                saved_raw_names = generator^.raw_names
                emit_line(generator, "{")
                gen_nested_block(generator, node)
                emit_line(generator, "}")
                generator^.raw_names = saved_raw_names
            }
        }
        is ast.NodeKind.USING_STMT {}
        default { emit_line(generator, "/* unsupported statement kind ${cast(node^.kind, i64)} at ${node^.tok.file}:${node^.tok.line} */") }
    }
}

// The parser's destructuring and or_return desugarings are blocks that declare
// into the enclosing scope: their first statement is a compiler temporary.
fn is_desugared_block(block ^ast.AstNode) -> bool {
    stmts = block^.block^.stmts
    if len(stmts) == 0 { return false }
    first = stmts[0]
    return first^.kind == ast.NodeKind.VAR_DECL && strings.starts_with(first^.var_decl^.name, ast.SYNTH_PREFIX)
}

fn gen_nested_block(generator ^CodeGen, block ^ast.AstNode) {
    generator^.indent = generator^.indent + 1
    gen_block_body(generator, block)
    generator^.indent = generator^.indent - 1
}

// A variable initialized from `ref(place)` is a transparent reference: every
// later use of its name reads and writes through the address.
fn register_reference(generator ^CodeGen, name string, value ^ast.AstNode) -> bool {
    if value == nil || value^.kind != ast.NodeKind.CALL_EXPR { return false }
    callee = value^.call^.function
    arguments = value^.call^.args
    if callee^.kind != ast.NodeKind.LABEL || callee^.label^.value != "ref" || len(arguments) != 1 { return false }
    place = arguments[0]
    is_function = referenced_function_name(generator, place) != ""
    if (place^.kind == ast.NodeKind.LABEL && !is_function) || place^.kind == ast.NodeKind.MEMBER_EXPR || place^.kind == ast.NodeKind.INDEX_EXPR {
        arrays.append(generator^.ref_params, name)
        return true
    }
    return false
}

// A variable declared without a type takes `__auto_type` when its value is a call, `new`, a
// member, an index, a pointer postfix, a function reference or a name, unless that value is an
// array, map or struct held by another place (which is copied under its own type), or an
// arithmetic expression that is not a string, float or bool.
// True for a struct the program declares and for the stdlib types that are structs in C.
fn is_struct_kind_type(generator ^CodeGen, type_name string) -> bool {
    return maps.contains_key(generator^.structs, type_name) || is_handle_type(type_name) || type_name == "UUID" || type_name == "ExecResult" || type_name == "HttpResponse"
}

fn declares_auto_type(generator ^CodeGen, value ^ast.AstNode) -> bool {
    when value^.kind {
        is ast.NodeKind.CALL_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.MEMBER_EXPR, ast.NodeKind.INDEX_EXPR, ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.FUNC_REF, ast.NodeKind.LABEL {
            if names_existing_storage(value) {
                value_type = expr_type(generator, value)
                if (is_array_type(value_type) || is_map_type(value_type) || is_struct_kind_type(generator, value_type)) && type_shares_storage(generator, value_type) { return false }
            }
            return true
        }
        is ast.NodeKind.INFIX_EXPR {
            value_type = expr_type(generator, value)
            return value_type != "string" && !is_float_name(value_type) && value_type != "bool"
        }
        default { return false }
    }
}

// Tracks a pointer bound to raw(): a dereference of it is not nil-checked. Any other value
// bound to the name (a typed pointer, or a plain assignment) clears it.
fn track_raw_variable(generator ^CodeGen, name string, declared_type string, value ^ast.AstNode) {
    mut is_raw_call = false
    if value != nil && value^.kind == ast.NodeKind.CALL_EXPR && value^.call^.function^.kind == ast.NodeKind.LABEL && value^.call^.function^.label^.value == "raw" { is_raw_call = true }
    if is_raw_call {
        if !arrays.contains(generator^.raw_names, name) { arrays.append(generator^.raw_names, name) }
        return
    }
    if declared_type != "" && !strings.starts_with(declared_type, "^") { return }
    if !arrays.contains(generator^.raw_names, name) { return }
    mut kept [string] = {}
    for_each raw_name in generator^.raw_names {
        if raw_name != name { arrays.append(kept, raw_name) }
    }
    generator^.raw_names = kept
}

// The initial value of a declaration: a value that names existing storage is copied, in a shape
// per kind - `_dtopN` for an array, `_msN` for a map, `_vdcN` for a struct.
fn gen_declared_value(generator ^CodeGen, written_type string, node ^ast.AstNode) -> string {
    declared = eff(generator, written_type)
    // a string given a name's value is a copy of it
    if declared == "string" && node^.kind == ast.NodeKind.LABEL {
        string_id = next_id(generator)
        return "({ GrayString _vdc${string_id} = ${gen_expr(generator, node)}; ${value_deep_copy(generator, declared, "_vdc${string_id}")}; })"
    }
    if names_existing_storage(node) && type_shares_storage(generator, declared) && fixed_array_size(generator, declared) <= 0 {
        if is_array_type(declared) { return deep_copy_of(generator, declared, node) }
        id = next_id(generator)
        if is_map_type(declared) { return "({ GrayMap _ms${id} = ${gen_expr(generator, node)}; ${value_deep_copy(generator, declared, "_ms${id}")}; })" }
        return "({ ${ctype(generator, declared)} _vdc${id} = ${gen_expr(generator, node)}; ${value_deep_copy(generator, declared, "_vdc${id}")}; })"
    }
    return gen_stored(generator, written_type, node)
}

fn gen_var_decl(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.var_decl
    track_raw_variable(generator, data^.name, data^.type_name, data^.value)
    track_heap_variable(generator, data^.name, data^.value)
    if data^.name == "_" {
        // A blank declaration is indented twice, and one without a value is indented but emits nothing
        emit_indent(generator)
        if data^.value != nil { emit_line(generator, "(void)(${gen_expr(generator, data^.value)});") }
        return
    }
    track_mem_variable(generator, data^.name, data^.type_name, data^.value)
    if register_reference(generator, data^.name, data^.value) {
        emit_line(generator, "__auto_type ${data^.name} = ${gen_expr(generator, data^.value)};")
        return
    }
    if data^.shadows_own_initializer && generator^.indent > 0 && data^.value != nil {
        // The initializer reads an outer variable of the declared name, which the new C
        // variable would hide inside its own initializer: evaluate it into a temporary first
        original_value = data^.value
        temporary_name = "_gray_shadow${next_id(generator)}"
        original_name = data^.name
        data^.name = temporary_name
        data^.shadows_own_initializer = false
        gen_var_decl(generator, node)
        temporary_label = ast.ast_alloc(ast.NodeKind.LABEL, original_value^.tok)
        temporary_label_data = new(ast.LabelData)
        temporary_label_data^.value = temporary_name
        temporary_label^.label = temporary_label_data
        temporary_label^.resolved_type = original_value^.resolved_type
        data^.name = original_name
        data^.value = temporary_label
        gen_var_decl(generator, node)
        data^.value = original_value
        data^.shadows_own_initializer = true
        return
    }
    mut type_name = eff(generator, data^.type_name)
    written_type_is_empty = type_name == ""
    if strings.starts_with(type_name, "^") && data^.value != nil && data^.value^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, data^.value^.label^.value) {
        // a ref variable given to a ^T pointer passes the pointer through
        emit_line(generator, "${ctype(generator, type_name)} ${data^.name} = ${data^.value^.label^.value};")
        return
    }
    if type_name == "" && data^.value != nil && declares_auto_type(generator, data^.value) {
        generator^.current_variable = data^.name
        auto_text = gen_expr(generator, data^.value)
        generator^.current_variable = ""
        emit_line(generator, "__auto_type ${data^.name} = ${auto_text};")
        return
    }
    if type_name == "" && data^.value != nil { type_name = expr_type(generator, data^.value) }
    if type_name == "unknown" || type_name == "" || type_name == "a C interop value" {
        generator^.current_variable = data^.name
        untyped_text = gen_expr(generator, data^.value)
        generator^.current_variable = ""
        emit_line(generator, "__auto_type ${data^.name} = ${untyped_text};")
        return
    }
    expect_type(data^.value, type_name)
    if data^.value == nil && is_map_type(type_name) {
        emit_line(generator, "${ctype(generator, type_name)} ${data^.name} = GRAY_MAP_NEW_OF(gray_default_arena, ${map_slot_c(generator, map_key_type(type_name))}, ${map_slot_c(generator, map_value_type(type_name))}, 8);")
        return
    }
    if data^.value == nil && is_array_type(type_name) {
        emit_line(generator, "${ctype(generator, type_name)} ${data^.name} = ${empty_array_text(generator, type_name)};")
        return
    }
    if data^.value == nil {
        zero_text = zero_value_text(generator, type_name)
        if zero_text != "" {
            emit_line(generator, "${ctype(generator, type_name)} ${data^.name} = ${zero_text};")
            return
        }
        emit_line(generator, "${ctype(generator, type_name)} ${data^.name} = ${constant_zero_text(generator, type_name)};")
        return
    }
    generator^.current_variable = data^.name
    initializer_text = gen_declared_value(generator, type_name, data^.value)
    if data^.elides_copy {
        initializer_text = gen_coerced(generator, type_name, data^.value)
        if place_reached_through_pointer(generator, data^.value) { generator^.elided_array = data^.name }
    }
    generator^.current_variable = ""
    mut declared_c = ctype(generator, type_name)
    if written_type_is_empty && data^.value != nil && data^.value^.kind == ast.NodeKind.INFIX_EXPR && is_float_name(type_name) { declared_c = "double" }
    mut const_marker = ""
    if !data^.is_mutable && strings.starts_with(type_name, "^") { const_marker = " const" }
    emit_line(generator, "${declared_c}${const_marker} ${data^.name} = ${initializer_text};")
}

fn gen_assign(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.assign
    if data^.target^.kind == ast.NodeKind.LABEL { track_heap_variable(generator, data^.target^.label^.value, data^.value) }
    if data^.target^.kind == ast.NodeKind.LABEL { track_raw_variable(generator, data^.target^.label^.value, "", data^.value) }
    if data^.is_decl && data^.target^.kind == ast.NodeKind.LABEL {
        if register_reference(generator, data^.target^.label^.value, data^.value) {
            emit_line(generator, "__auto_type ${data^.target^.label^.value} = ${gen_expr(generator, data^.value)};")
            return
        }
        declared_type = expr_type(generator, data^.target)
        c_declared = "__auto_type"
        if declared_type != "" && declared_type != "unknown" && declared_type != "a C interop value" { c_declared = ctype(generator, declared_type) }
        generator^.current_variable = data^.target^.label^.value
        assigned_text = gen_declared_value(generator, declared_type, data^.value)
        generator^.current_variable = ""
        emit_line(generator, "${c_declared} ${data^.target^.label^.value} = ${assigned_text};")
        return
    }
    if data^.target^.kind == ast.NodeKind.MEMBER_EXPR {
        member_checks = enclosing_iteration_checks(generator, node, data^.target)
        if member_checks != "" { emit_line_prefix(generator, member_checks) }
    }
    if data^.target^.kind == ast.NodeKind.INDEX_EXPR && is_array_type(expr_type(generator, data^.target^.index_data^.left)) {
        element_left = data^.target^.index_data^.left
        element_checks = enclosing_iteration_checks(generator, node, element_left)
        if data^.op != token.TokenKind.ASSIGN && !is_number_type_name(expr_type(generator, data^.target)) && expr_type(generator, data^.target) != "string" && !expression_calls_function(element_left) {
            element_checks = "if (gray_atomic_load32(&(${gen_expr(generator, element_left)}).iterating) > 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0034\", \"cannot modify array during for_each iteration\"); } ${element_checks}"
        }
        if element_checks != "" { emit_line_prefix(generator, element_checks) }
    }
    if data^.target^.kind == ast.NodeKind.INDEX_EXPR && is_array_type(expr_type(generator, data^.target^.index_data^.left)) && (data^.op == token.TokenKind.ASSIGN || (data^.op == token.TokenKind.PLUS_ASSIGN && array_element_type(expr_type(generator, data^.target^.index_data^.left)) == "string")) {
        gen_array_element_store(generator, node)
        return
    }
    if data^.target^.kind == ast.NodeKind.INDEX_EXPR && data^.op == token.TokenKind.ASSIGN {
        gen_index_store(generator, node)
        return
    }
    if data^.target^.kind == ast.NodeKind.INDEX_EXPR && data^.op == token.TokenKind.PLUS_ASSIGN && is_map_type(expr_type(generator, data^.target^.index_data^.left)) && map_value_type(expr_type(generator, data^.target^.index_data^.left)) == "string" {
        gen_map_store(generator, node, data^.target^.index_data^.left, expr_type(generator, data^.target^.index_data^.left), data^.target^.index_data^.index_expr)
        return
    }
    if gen_pointer_assignment(generator, node) { return }
    if gen_value_assignment(generator, node) { return }
    target_type = declared_target_type(generator, data^.target)
    expect_type(data^.value, target_type)
    if data^.op == token.TokenKind.ASSIGN && (is_array_type(target_type) || is_map_type(target_type)) && !expression_calls_function(data^.target) {
        mut whole_code = "P0034"
        mut whole_text = "cannot modify array during for_each iteration"
        if is_map_type(target_type) {
            whole_code = "P0035"
            whole_text = "cannot modify map during for_each iteration"
        }
        emit_line(generator, "if (gray_atomic_load32(&(${gen_expr(generator, data^.target)}).iterating) > 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"${whole_code}\", \"${whole_text}\"); }")
    }
    // the array indexes of a plain store into a field are worked out before the value
    mut hoisted_prefix = ""
    mut hoisted_nodes [^ast.AstNode] = {}
    mut hoisted_originals [^ast.AstNode] = {}
    if data^.op == token.TokenKind.ASSIGN && data^.target^.kind == ast.NodeKind.MEMBER_EXPR {
        mut indexed [^ast.AstNode] = {}
        mut walk = data^.target
        as_long_as walk != nil {
            if walk^.kind == ast.NodeKind.MEMBER_EXPR {
                walk = walk^.member^.object
            } or walk^.kind == ast.NodeKind.INDEX_EXPR {
                if is_array_type(expr_type(generator, walk^.index_data^.left)) && walk^.index_data^.index_expr^.kind != ast.NodeKind.INT_VALUE { arrays.append(indexed, walk) }
                walk = walk^.index_data^.left
            } otherwise {
                break
            }
        }
        mut position = len(indexed) - 1
        as_long_as position >= 0 {
            hoisted_id = next_id(generator)
            hoisted_name = "_gray_ix${hoisted_id}"
            hoisted_prefix = "${hoisted_prefix}{ int64_t ${hoisted_name} = ${gen_expr(generator, indexed[position]^.index_data^.index_expr)}; "
            index_label = ast.ast_alloc(ast.NodeKind.LABEL, indexed[position]^.index_data^.index_expr^.tok)
            index_label_data = new(ast.LabelData)
            index_label_data^.value = hoisted_name
            index_label^.label = index_label_data
            index_label^.resolved_type = "i64"
            arrays.append(hoisted_nodes, indexed[position])
            arrays.append(hoisted_originals, indexed[position]^.index_data^.index_expr)
            indexed[position]^.index_data^.index_expr = index_label
            position = position - 1
        }
    }
    target = gen_expr(generator, data^.target)
    mut value = gen_stored(generator, target_type, data^.value)
    store_arena = value_store_arena(generator, data^.target)
    if data^.op == token.TokenKind.ASSIGN && store_arena != "" && !(data^.value^.kind == ast.NodeKind.LABEL && generator^.elided_array == data^.value^.label^.value) {
        value = store_value_in_arena(generator, target_type, data^.value, value, store_arena)
    }
    if data^.op == token.TokenKind.ASSIGN && data^.value^.kind == ast.NodeKind.LABEL && generator^.elided_array == data^.value^.label^.value {
        // the elided copy already lives in the field's storage
        value = gen_coerced(generator, target_type, data^.value)
        generator^.elided_array = ""
    }
    if data^.op == token.TokenKind.ASSIGN && strings.starts_with(target_type, "^") && data^.value^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, data^.value^.label^.value) {
        // a ref variable assigned to a ^T pointer passes the pointer through
        value = data^.value^.label^.value
    }
    if len(hoisted_nodes) > 0 {
        for restore in range(0, len(hoisted_nodes)) { hoisted_nodes[restore]^.index_data^.index_expr = hoisted_originals[restore] }
        mut closers = ""
        for closer in range(0, len(hoisted_nodes)) { closers = "${closers} }" }
        emit_line(generator, "${hoisted_prefix}${target} = ${value};${closers}")
        return
    }
    // `items[idx()].x = val()`: the place is worked out before the value
    if data^.op == token.TokenKind.ASSIGN && target_calls_function(data^.target) && target_type != "" && target_type != "unknown" {
        place_id = next_id(generator)
        emit_line(generator, "{ ${ctype(generator, target_type)} *_gray_place${place_id} = &(${target}); *_gray_place${place_id} = ${value}; }")
        return
    }
    compound_kind = compound_operator(data^.op)
    if compound_kind != token.TokenKind.ASSIGN && is_number_type_name(target_type) {
        emit_line(generator, "({ ${ctype(generator, eff(generator, target_type))} *_lv = ${place_address(generator, data^.target)}; *_lv = ${compound_value(generator, node, "(*_lv)", value, compound_kind)}; });")
        return
    }
    when data^.op {
        is token.TokenKind.ASSIGN { emit_line(generator, "${target} = ${value};") }
        is token.TokenKind.PLUS_ASSIGN { emit_line(generator, "${target} = ${compound_value(generator, node, target, value, token.TokenKind.PLUS)};") }
        is token.TokenKind.MINUS_ASSIGN { emit_line(generator, "${target} = ${compound_value(generator, node, target, value, token.TokenKind.MINUS)};") }
        is token.TokenKind.ASTERISK_ASSIGN { emit_line(generator, "${target} = ${compound_value(generator, node, target, value, token.TokenKind.ASTERISK)};") }
        is token.TokenKind.SLASH_ASSIGN { emit_line(generator, "${target} = ${compound_value(generator, node, target, value, token.TokenKind.SLASH)};") }
        is token.TokenKind.PERCENT_ASSIGN { emit_line(generator, "${target} = ${compound_value(generator, node, target, value, token.TokenKind.PERCENT)};") }
        default { emit_line(generator, "${target} = ${value};") }
    }
}

// The C operator of an assignment.
fn assign_operator_text(operator token.TokenKind) -> string {
    when operator {
        is token.TokenKind.PLUS_ASSIGN { return "+=" }
        is token.TokenKind.MINUS_ASSIGN { return "-=" }
        is token.TokenKind.ASTERISK_ASSIGN { return "*=" }
        is token.TokenKind.SLASH_ASSIGN { return "/=" }
        is token.TokenKind.PERCENT_ASSIGN { return "%=" }
        default { return "=" }
    }
}

// `{ __auto_type _dp = POINTER; if (!_dp) { panic } ` - the nil check of a store through a
// pointer; a pointer from raw() is not checked.
fn pointer_capture(generator ^CodeGen, node ^ast.AstNode, pointer ^ast.AstNode) -> string {
    is_raw = pointer^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, pointer^.label^.value)
    mut text = "{ __auto_type _dp = ${gen_expr(generator, pointer)}; "
    if !is_raw { text = "${text}if (!_dp) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0080\", \"nil pointer dereference\"); } " }
    return text
}

// The value stored through a pointer: the pointee may live in the heap arena, which outlives every
// scope, so a string, array, map or struct with embedded storage is copied there.
fn pointer_store_value(generator ^CodeGen, target_type string, value ^ast.AstNode) -> string {
    if !needs_copy_walk(generator, target_type, true) { return gen_expr(generator, value) }
    if value^.kind == ast.NodeKind.LABEL && array_argument_in_heap(generator, value) {
        generator^.elided_array = ""
        return gen_expr(generator, value)
    }
    id = next_id(generator)
    copied_c = ctype(generator, target_type)
    return "({ ${copied_c} _hv${id} = ${gen_expr(generator, value)}; GrayArena *_hs${id} = gray_default_arena; gray_default_arena = gray_heap_arena; ${copied_c} _hd${id} = ${value_deep_copy(generator, target_type, "_hv${id}")}; gray_default_arena = _hs${id}; _hd${id}; })"
}

// A store through a pointer: `p^ = v`, `p^.f = v`, `p.f = v`, `p.a.b = v` - the pointer is held
// and nil-checked, then written through. False when the target is not reached through one.
fn gen_pointer_assignment(generator ^CodeGen, node ^ast.AstNode) -> bool {
    data = node^.assign
    target = data^.target
    if data^.op != token.TokenKind.ASSIGN && is_number_type_name(declared_target_type(generator, target)) { return false }
    operator = assign_operator_text(data^.op)
    target_type = expr_type(generator, target)
    if is_deref(target) {
        pointer_node = target^.postfix^.left
        pointer_type = expr_type(generator, pointer_node)
        pointee_type = ""
        if strings.starts_with(pointer_type, "^") { pointee_type = strings.slice(pointer_type, 1, len(pointer_type)) }
        if is_wide_name(pointee_type) && data^.op != token.TokenKind.ASSIGN { return false }
        capture = pointer_capture(generator, node, pointer_node)
        if is_wide_name(pointee_type) {
            emit_line(generator, "${capture}*_dp = ${gen_coerced(generator, pointee_type, data^.value)}; }")
            return true
        }
        if data^.op == token.TokenKind.PLUS_ASSIGN && target_type == "string" {
            emit_line(generator, "${capture}*_dp = gray_string_concat(gray_heap_arena, *_dp, ${gen_expr(generator, data^.value)}); }")
            return true
        }
        mut stored = ""
        if data^.op == token.TokenKind.ASSIGN {
            stored = pointer_store_value(generator, target_type, data^.value)
        } otherwise {
            stored = gen_expr(generator, data^.value)
        }
        emit_line(generator, "${capture}*_dp ${operator} ${stored}; }")
        return true
    }
    if target^.kind != ast.NodeKind.MEMBER_EXPR { return false }
    object = target^.member^.object
    if is_deref(object) {
        capture = pointer_capture(generator, node, object^.postfix^.left)
        field_reference = "_dp->${target^.member^.member}"
        return emit_pointer_field_store(generator, node, capture, field_reference, operator, target_type)
    }
    // some ancestor of the field is a pointer: write through it
    mut chain [string] = {}
    mut current = target
    mut pointer_root ^ast.AstNode = nil
    as_long_as current^.kind == ast.NodeKind.MEMBER_EXPR {
        arrays.append(chain, current^.member^.member)
        owner = current^.member^.object
        owner_is_reference = owner^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, owner^.label^.value)
        if strings.starts_with(expr_type(generator, owner), "^") && !owner_is_reference {
            pointer_root = owner
            break
        }
        current = owner
    }
    if pointer_root == nil { return false }
    mut field_reference = "_dp->"
    mut position = len(chain) - 1
    as_long_as position >= 0 {
        field_reference = "${field_reference}${chain[position]}"
        if position > 0 { field_reference = "${field_reference}." }
        position = position - 1
    }
    return emit_pointer_field_store(generator, node, pointer_capture(generator, node, pointer_root), field_reference, operator, target_type)
}

fn emit_pointer_field_store(generator ^CodeGen, node ^ast.AstNode, capture string, field_reference string, operator string, target_type string) -> bool {
    data = node^.assign
    if data^.op == token.TokenKind.PLUS_ASSIGN && target_type == "string" {
        emit_line(generator, "${capture}${field_reference} = gray_string_concat(gray_heap_arena, ${field_reference}, ${gen_expr(generator, data^.value)}); }")
        return true
    }
    mut stored = ""
    if data^.op == token.TokenKind.ASSIGN {
        stored = pointer_store_value(generator, target_type, data^.value)
    } otherwise {
        stored = gen_expr(generator, data^.value)
    }
    emit_line(generator, "${capture}${field_reference} ${operator} ${stored}; }")
    return true
}

// A plain `=` of an array, map or struct that holds storage, a string append, and a string or
// composite stored from inside a loop: each is held in a temporary and copied into the arena the
// target lives in. False when the assignment is none of these.
fn gen_value_assignment(generator ^CodeGen, node ^ast.AstNode) -> bool {
    data = node^.assign
    target = data^.target
    target_type = expr_type(generator, target)
    if data^.op == token.TokenKind.PLUS_ASSIGN && target_type == "string" {
        arena = "gray_default_arena"
        if generator^.loop_scope_depth > 0 { arena = "_gray_outer_arena" }
        emit_line(generator, "{ GrayString *_tgt = &(${gen_expr(generator, target)}); GrayString _sv = ${gen_expr(generator, data^.value)}; *_tgt = gray_string_concat(${arena}, *_tgt, _sv); }")
        return true
    }
    if data^.op != token.TokenKind.ASSIGN { return false }
    if is_array_type(target_type) {
        id = next_id(generator)
        copied_type = "[${array_element_type(target_type)}]"
        value_text = gen_coerced(generator, copied_type, data^.value)
        target_text = gen_expr(generator, target)
        mut opener = ""
        mut closer = "; }"
        if generator^.loop_scope_depth > 0 {
            opener = "GrayArena *_esc_a = gray_default_arena; gray_default_arena = _gray_outer_arena; "
            closer = "; gray_default_arena = _esc_a; }"
        }
        emit_line(generator, "{ GrayArray _dtop${id} = ${value_text}; if (gray_atomic_load32(&${target_text}.iterating) > 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0034\", \"cannot modify array during for_each iteration\"); } ${opener}${target_text} = ${value_deep_copy(generator, copied_type, "_dtop${id}")}${closer}")
        return true
    }
    if is_map_type(target_type) {
        id = next_id(generator)
        value_text = gen_coerced(generator, target_type, data^.value)
        target_text = gen_expr(generator, target)
        mut opener = ""
        mut closer = "; }"
        if generator^.loop_scope_depth > 0 {
            opener = "GrayArena *_esc_m = gray_default_arena; gray_default_arena = _gray_outer_arena; "
            closer = "; gray_default_arena = _esc_m; }"
        }
        emit_line(generator, "{ GrayMap _ma${id} = ${value_text}; if (gray_atomic_load32(&${target_text}.iterating) > 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0035\", \"cannot modify map during for_each iteration\"); } ${opener}${target_text} = ${value_deep_copy(generator, target_type, "_ma${id}")}${closer}")
        return true
    }
    is_struct_target = maps.contains_key(generator^.structs, target_type)
    if is_struct_target && needs_copy_walk(generator, target_type, true) {
        id = next_id(generator)
        value_text = gen_coerced(generator, target_type, data^.value)
        target_text = gen_expr(generator, target)
        mut opener = ""
        mut closer = "; }"
        if generator^.loop_scope_depth > 0 {
            opener = "GrayArena *_esc_a = gray_default_arena; gray_default_arena = _gray_outer_arena; "
            closer = "; gray_default_arena = _esc_a; }"
        }
        emit_line(generator, "{ ${ctype(generator, target_type)} _sa${id} = ${value_text}; ${opener}${target_text} = ${value_deep_copy(generator, target_type, "_sa${id}")}${closer}")
        return true
    }
    if generator^.loop_scope_depth > 0 && (target^.kind == ast.NodeKind.MEMBER_EXPR || target^.kind == ast.NodeKind.LABEL) {
        if target_type == "string" {
            if target^.kind == ast.NodeKind.MEMBER_EXPR {
                emit_line(generator, "{ GrayString *_tgt = &(${gen_expr(generator, target)}); GrayString _esc_v = ${gen_expr(generator, data^.value)}; *_tgt = gray_string_new(_gray_outer_arena, _esc_v.data, _esc_v.len); }")
            } otherwise {
                emit_line(generator, "{ GrayString _esc_v = ${gen_expr(generator, data^.value)}; ${gen_expr(generator, target)} = gray_string_new(_gray_outer_arena, _esc_v.data, _esc_v.len); }")
            }
            return true
        }
        if (is_struct_target || maps.contains_key(generator^.enums, target_type)) && needs_copy_walk(generator, target_type, true) {
            emit_line(generator, "{ ${ctype(generator, target_type)} _esc_v = ${gen_expr(generator, data^.value)}; GrayArena *_esc_a = gray_default_arena; gray_default_arena = _gray_outer_arena; ${gen_expr(generator, target)} = ${value_deep_copy(generator, target_type, "_esc_v")}; gray_default_arena = _esc_a; }")
            return true
        }
    }
    return false
}

// The statements that copy a staged map key or value into `arena`.
fn map_store_copy(generator ^CodeGen, slot_type string, temporary_name string, arena string) -> string {
    if eff(generator, slot_type) == "string" { return "${temporary_name} = gray_string_new(${arena}, ${temporary_name}.data, ${temporary_name}.len); " }
    if slot_type != "" && needs_copy_walk(generator, slot_type, true) {
        return "{ GrayArena *_esc = gray_default_arena; gray_default_arena = ${arena}; ${temporary_name} = ${value_deep_copy(generator, slot_type, temporary_name)}; gray_default_arena = _esc; } "
    }
    return ""
}

// `m[key] = value`: the key and the value are staged, copied into the arena the map lives in when
// that is not the current one, and set. A map held in a field of a pointee is reached by
// holding and nil-checking the pointer.
fn gen_map_store(generator ^CodeGen, node ^ast.AstNode, left ^ast.AstNode, left_type string, index_node ^ast.AstNode) {
    data = node^.assign
    key_type = map_key_type(left_type)
    value_type = map_value_type(left_type)
    key_c = map_slot_c(generator, key_type)
    value_c = map_slot_c(generator, value_type)
    mut map_pointer ^ast.AstNode = nil
    mut direct_deref = false
    if left^.kind == ast.NodeKind.MEMBER_EXPR {
        member_object = left^.member^.object
        if strings.starts_with(expr_type(generator, member_object), "^") {
            map_pointer = member_object
        } or is_deref(member_object) {
            map_pointer = member_object^.postfix^.left
        }
    }
    if map_pointer == nil && is_deref(left) { direct_deref = true }
    mut map_in_heap = false
    if map_pointer != nil && map_pointer^.kind == ast.NodeKind.LABEL { map_in_heap = is_heap_variable(generator, map_pointer^.label^.value) }
    mut store_arena = "gray_default_arena"
    if map_in_heap {
        store_arena = "gray_heap_arena"
    } or !generator^.is_module_store && generator^.loop_scope_depth > 0 {
        store_arena = "_gray_outer_arena"
    }
    escapes = map_in_heap || (!generator^.is_module_store && generator^.loop_scope_depth > 0)
    mut text = "{ ${key_c} _mk = ${gen_coerced(generator, key_type, index_node)}; "
    if escapes { text = "${text}${map_store_copy(generator, key_type, "_mk", store_arena)}" }
    nil_panic = "gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0080\", \"nil pointer dereference\")"
    missing_panic = "gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0081\", \"key not found in map\")"
    is_compound = data^.op == token.TokenKind.PLUS_ASSIGN
    mut held_pointer ^ast.AstNode = nil
    if map_pointer != nil { held_pointer = map_pointer } or direct_deref { held_pointer = left^.postfix^.left }
    mut held_is_raw = false
    if held_pointer != nil && held_pointer^.kind == ast.NodeKind.LABEL { held_is_raw = arrays.contains(generator^.raw_names, held_pointer^.label^.value) }
    mut map_reference = "&${gen_expr(generator, left)}"
    if held_pointer != nil {
        map_reference = "_mp"
        if map_pointer != nil { map_reference = "&_mp->${left^.member^.member}" }
    }
    if is_compound {
        if held_pointer != nil {
            mut compound_guard = "; if (!_mp) { ${nil_panic}; } "
            if held_is_raw { compound_guard = "; " }
            text = "${text}__auto_type _mp = ${gen_expr(generator, held_pointer)}${compound_guard}"
        }
        text = "${text}void *_cur = gray_map_get(${map_reference}, &_mk); if (!_cur) { ${missing_panic}; } "
    }
    mut value_text = gen_coerced(generator, value_type, data^.value)
    if is_compound { value_text = "gray_string_concat(gray_default_arena, *(GrayString*)_cur, ${gen_expr(generator, data^.value)})" }
    if !is_compound && !escapes && names_existing_storage(data^.value) && needs_copy_walk(generator, value_type, false) { value_text = deep_copy_operand(generator, value_type, data^.value) }
    text = "${text}${value_c} _mv = ${value_text}; "
    if escapes { text = "${text}${map_store_copy(generator, value_type, "_mv", store_arena)}" }
    if held_pointer != nil {
        if is_compound {
            emit_line(generator, "${text}gray_map_set(${store_arena}, ${map_reference}, &_mk, &_mv, ${location_args(generator, node)}); }")
            return
        }
        mut guard = "; if (!_mp) { ${nil_panic}; } "
        if held_is_raw { guard = "; " }
        emit_line(generator, "${text}{ __auto_type _mp = ${gen_expr(generator, held_pointer)}${guard}gray_map_set(${store_arena}, ${map_reference}, &_mk, &_mv, ${location_args(generator, node)}); } }")
        return
    }
    emit_line(generator, "${text}gray_map_set(${store_arena}, ${map_reference}, &_mk, &_mv, ${location_args(generator, node)}); }")
}

// The value stored into an array element: a composite that names storage already, or any
// composite stored from inside a loop, is a copy (in the outer arena inside a loop).
fn element_store_operand(generator ^CodeGen, element_type string, value ^ast.AstNode) -> string {
    if generator^.loop_scope_depth > 0 && eff(generator, element_type) != "string" && needs_copy_walk(generator, element_type, true) { return deep_copy_operand(generator, element_type, value) }
    if names_existing_storage(value) && needs_copy_walk(generator, element_type, false) { return deep_copy_operand(generator, element_type, value) }
    return gen_coerced(generator, element_type, value)
}

// `arr[i] = v` and `arr[i] += s` for a string element. A container reached through a map lookup or a
// pointer is held in a temporary first, so the store lands on the real storage.
fn gen_array_element_store(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.assign
    left = data^.target^.index_data^.left
    left_type = expr_type(generator, left)
    element = array_element_type(left_type)
    element_c = ctype(generator, element)
    mut macro = "GRAY_ARRAY_SET_AT"
    if generator^.is_element_write_back { macro = "GRAY_ARRAY_STORE_BACK_AT" }
    is_compound = data^.op == token.TokenKind.PLUS_ASSIGN
    index_node = data^.target^.index_data^.index_expr
    nil_panic = "gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0080\", \"nil pointer dereference\")"
    // the store itself, with the array named `reference`
    mut hold = ""
    mut reference = ""
    mut closer = ";"
    if index_left_is_map_lookup(generator, left) {
        hold = "{ GrayArray _ea = ${gen_expr(generator, left)}; "
        reference = "_ea"
        closer = "; }"
    } otherwise {
        mut struct_pointer ^ast.AstNode = nil
        mut array_field = ""
        if left^.kind == ast.NodeKind.MEMBER_EXPR {
            member_object = left^.member^.object
            if strings.starts_with(expr_type(generator, member_object), "^") {
                struct_pointer = member_object
                array_field = left^.member^.member
            } or is_deref(member_object) {
                struct_pointer = member_object^.postfix^.left
                array_field = left^.member^.member
            }
        }
        if struct_pointer != nil {
            is_raw = struct_pointer^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, struct_pointer^.label^.value)
            id = next_id(generator)
            mut guard = "; if (!_asdp${id}) { ${nil_panic}; } "
            if is_raw { guard = "; " }
            hold = "{ __auto_type _asdp${id} = ${gen_expr(generator, struct_pointer)}${guard}"
            reference = "_asdp${id}->${array_field}"
            closer = "; }"
        } or is_deref(left) {
            array_pointer = left^.postfix^.left
            is_raw = array_pointer^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, array_pointer^.label^.value)
            id = next_id(generator)
            mut guard = "; if (!_asdp${id}) { ${nil_panic}; } "
            if is_raw { guard = "; " }
            hold = "{ __auto_type _asdp${id} = ${gen_expr(generator, array_pointer)}${guard}"
            reference = "*_asdp${id}"
            closer = "; }"
        }
    }
    if reference != "" {
        index_text = gen_expr(generator, index_node)
        mut value_text = ""
        if is_compound && element_c == "GrayString" {
            arena = "gray_default_arena"
            if generator^.loop_scope_depth > 0 { arena = "_gray_outer_arena" }
            value_text = "gray_string_concat(${arena}, GRAY_ARRAY_GET_AT(${reference}, GrayString, ${index_text}, ${location_args(generator, node)}), ${gen_expr(generator, data^.value)})"
        } otherwise {
            value_text = element_store_operand(generator, element, data^.value)
        }
        emit_line(generator, "${hold}${macro}(${reference}, ${element_c}, ${index_text}, ${value_text}, ${location_args(generator, node)})${closer}")
        return
    }
    // a string stored from inside a loop is copied into the outer arena
    if !is_compound && element_c == "GrayString" && generator^.loop_scope_depth > 0 {
        value_text = gen_expr(generator, data^.value)
        left_text = gen_expr(generator, left)
        index_text = gen_expr(generator, index_node)
        emit_line(generator, "{ GrayString _esc_v = ${value_text}; ${macro}(${left_text}, GrayString, ${index_text}, gray_string_new(_gray_outer_arena, _esc_v.data, _esc_v.len), ${location_args(generator, node)}); }")
        return
    }
    left_text = gen_expr(generator, left)
    index_text = gen_expr(generator, index_node)
    mut value_text = ""
    if is_compound && element_c == "GrayString" {
        arena = "gray_default_arena"
        if generator^.loop_scope_depth > 0 { arena = "_gray_outer_arena" }
        value_text = "gray_string_concat(${arena}, GRAY_ARRAY_GET_AT(${left_text}, GrayString, ${index_text}, ${location_args(generator, node)}), ${gen_expr(generator, data^.value)})"
    } otherwise {
        value_text = element_store_operand(generator, element, data^.value)
    }
    emit_line(generator, "${macro}(${left_text}, ${element_c}, ${index_text}, ${value_text}, ${location_args(generator, node)});")
}

fn gen_index_store(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.assign
    left = data^.target^.index_data^.left
    index_node = data^.target^.index_data^.index_expr
    left_type = expr_type(generator, left)
    if is_map_type(left_type) {
        gen_map_store(generator, node, left, left_type, index_node)
        return
    }
    index = gen_expr(generator, index_node)
    value = gen_stored(generator, array_element_type(left_type), data^.value)
    if generator^.loop_scope_depth > 0 && !generator^.is_module_store {
        value = copy_into_arena(generator, array_element_type(left_type), value, "_gray_outer_arena")
    }
    emit_line(generator, "GRAY_ARRAY_SET_AT(${gen_expr(generator, left)}, ${ctype(generator, array_element_type(left_type))}, ${index}, ${value}, ${location_args(generator, node)});")
}

// `target operator= value` as the value computed from the current target.
fn compound_value(generator ^CodeGen, node ^ast.AstNode, target string, value string, operator token.TokenKind) -> string {
    operand_type = expr_type(generator, node^.assign^.target)
    if operand_type == "string" && operator == token.TokenKind.PLUS {
        return "gray_string_concat(${string_append_arena(generator, node^.assign^.target)}, ${target}, ${value})"
    }
    if is_wide_name(operand_type) {
        wide_result = wide_binary(wide_prefix(operand_type), operator, target, value, location_args(generator, node))
        if wide_result != "" { return wide_result }
    }
    checked_result = checked_arithmetic(generator, node, operand_type, operator, target, "(${value})")
    if checked_result != "" { return checked_result }
    return "(${target} ${op_text(operator)} (${value}))"
}

// The zero value of a result slot an `or_return` leaves unset: 0 for a scalar or pointer, braces for the rest.
fn or_return_zero_slot(generator ^CodeGen, type_name string) -> string {
    resolved = eff(generator, type_name)
    if is_wide_name(resolved) || resolved == "string" || is_array_type(resolved) || is_map_type(resolved) || maps.contains_key(generator^.structs, resolved) || resolved == "Error" && false { return "{0}" }
    if maps.contains_key(generator^.enums, resolved) && (is_tagged_enum(generator, resolved) || is_string_enum(generator, resolved)) { return "{0}" }
    return "0"
}

fn gen_return(generator ^CodeGen, node ^ast.AstNode) {
    values = node^.return_stmt^.values
    mut release = ""
    for_each source in generator^.iterating { release = "gray_atomic_sub32(&${source}.iterating, 1); ${release}" }
    function_node = generator^.current_function
    release = "${release}${scope_arena_unwind(generator)}"
    runs_in_caller_arena = function_node != nil && function_uses_caller_arena(generator, function_node)
    runs_on_watermark = function_node != nil && len(function_node^.func_decl^.return_types) > 0 && function_uses_watermark(generator, function_node)
    takes_scope_mark = function_node != nil && function_needs_scope_mark(generator, function_node)
    mut restore_mark = ""
    if !runs_in_caller_arena && takes_scope_mark { restore_mark = "gray_scope_restore(gray_default_arena, _scope_mark); " }
    if len(values) == 0 {
        emit_line(generator, "{ ${ensure_cleanup(generator)}${release}${restore_mark}gray_exit_func(); return; }")
        return
    }
    for i in range(0, len(values)) {
        if i < len(generator^.return_types) { expect_type(values[i], generator^.return_types[i]) }
    }
    if len(generator^.return_types) > 1 {
        mut returned [string] = {}
        // `or_return` hands back just the error: the slots before it are zero
        missing = len(generator^.return_types) - len(values)
        for i in range(0, missing) {
            arrays.append(returned, or_return_zero_slot(generator, generator^.return_types[i]))
        }
        for i in range(0, len(values)) {
            arrays.append(returned, gen_coerced(generator, generator^.return_types[missing + i], values[i]))
        }
        emit_line(generator, "{ ${generator^.multi_name} _ret = (${generator^.multi_name}){${strings.join(returned, ", ")}}; ${ensure_cleanup(generator)}${multi_return_escape(generator, release)}gray_exit_func(); return _ret; }")
        return
    }
    // the value is generated before the escape of the result, so the temporaries are numbered in that order
    if len(generator^.return_types) == 1 && is_wide_name(generator^.return_types[0]) {
        wide_value = gen_coerced(generator, generator^.return_types[0], values[0])
        exit_text = single_return_escape(generator, release, runs_in_caller_arena, runs_on_watermark)
        emit_line(generator, "{ __auto_type _ret = ${wide_value}; ${ensure_cleanup(generator)}${exit_text}gray_exit_func(); return _ret; }")
        return
    }
    // a parameter handed back shares storage with the caller's value: the result is a copy of it
    if len(generator^.return_types) == 1 && values[0]^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.current_params, values[0]^.label^.value) && !arrays.contains(generator^.ref_params, values[0]^.label^.value) && type_shares_storage(generator, generator^.return_types[0]) {
        copied_value = deep_copy_of(generator, generator^.return_types[0], values[0])
        exit_text = single_return_escape(generator, release, runs_in_caller_arena, runs_on_watermark)
        emit_line(generator, "{ __auto_type _ret = ${copied_value}; ${ensure_cleanup(generator)}${exit_text}gray_exit_func(); return _ret; }")
        return
    }
    plain_value = gen_expr(generator, values[0])
    exit_text = single_return_escape(generator, release, runs_in_caller_arena, runs_on_watermark)
    emit_line(generator, "{ __auto_type _ret = ${plain_value}; ${ensure_cleanup(generator)}${exit_text}gray_exit_func(); return _ret; }")
}

// What a single-valued return does with the function's memory: copy the result out of
// the function's arena, unwind any scratch arenas, and free the arena. A function that runs
// in its caller's arena or on the watermark has nothing to copy out or free.
fn single_return_escape(generator ^CodeGen, release string, runs_in_caller_arena bool, runs_on_watermark bool) -> string {
    if len(generator^.return_types) == 0 || runs_in_caller_arena || runs_on_watermark { return release }
    return_type = generator^.return_types[0]
    mut text = ""
    if return_type == "string" {
        text = "_ret = gray_string_new(_func_saved, _ret.data, _ret.len); "
    } or return_type == "Error" {
        text = "if (_ret) { GrayError *_src_err = (GrayError *)_ret; GrayError *_esc_err = (GrayError *)gray_arena_alloc(_func_saved, sizeof(GrayError)); _esc_err->code = _src_err->code; _esc_err->msg = gray_string_new(_func_saved, _src_err->msg.data, _src_err->msg.len); _ret = _esc_err; } "
    } or needs_copy_walk(generator, return_type, true) {
        text = "{ GrayArena *_esc = gray_default_arena; gray_default_arena = _func_saved; _ret = ${value_deep_copy(generator, return_type, "_ret")}; gray_default_arena = _esc; } "
    }
    return "${text}${release}gray_default_arena = _func_saved; gray_arena_destroy(_func_arena, __FILE__, __LINE__); free(_func_arena); "
}

// The same for a multi-valued return: every heap-backed slot is copied out of the arena.
fn multi_return_escape(generator ^CodeGen, release string) -> string {
    function_node = generator^.current_function
    if function_node != nil && function_uses_caller_arena(generator, function_node) { return release }
    if function_node != nil && function_uses_watermark(generator, function_node) { return release }
    mut text = ""
    // The results are read as the function wrote them: a type parameter or an alias is not a string
    written_returns = function_node^.func_decl^.return_types
    for slot in range(0, len(written_returns)) {
        slot_type = written_returns[slot]
        if slot_type == "string" {
            text = "${text}_ret.v${slot} = gray_string_new(_func_saved, _ret.v${slot}.data, _ret.v${slot}.len); "
        } or slot_type == "Error" {
            text = "${text}if (_ret.v${slot}) { GrayError *_esc_err = (GrayError *)gray_arena_alloc(_func_saved, sizeof(GrayError)); _esc_err->code = _ret.v${slot}->code; _esc_err->msg = gray_string_new(_func_saved, _ret.v${slot}->msg.data, _ret.v${slot}->msg.len); _ret.v${slot} = _esc_err; } "
        } or eff(generator, slot_type) == slot_type && needs_copy_walk(generator, slot_type, true) {
            text = "${text}{ GrayArena *_esc = gray_default_arena; gray_default_arena = _func_saved; _ret.v${slot} = ${value_deep_copy(generator, slot_type, "_ret.v${slot}")}; gray_default_arena = _esc; } "
        }
    }
    return "${text}${release}gray_default_arena = _func_saved; gray_arena_destroy(_func_arena, __FILE__, __LINE__); free(_func_arena); "
}

// True if the function takes any `&` or `^T` parameter. It can write freshly allocated data
// into caller-owned memory through that parameter, so it runs in the caller's arena: no
// private arena, no scope restore, no return escape.
fn function_uses_caller_arena(generator ^CodeGen, function_node ^ast.AstNode) -> bool {
    if function_node == nil || function_node^.kind != ast.NodeKind.FUNC_DECL { return false }
    for_each parameter in function_node^.func_decl^.params {
        if parameter.is_mutable { return true }
        if parameter.type_name != "" && strings.starts_with(eff(generator, parameter.type_name), "^") { return true }
    }
    return false
}

// A value of this kind is copied by C assignment with no heap traffic.
fn type_is_copy_free(type_text string) -> bool {
    return type_text == "i8" || type_text == "i16" || type_text == "i32" || type_text == "i64" || type_text == "i128" || type_text == "i256" || type_text == "u8" || type_text == "u16" || type_text == "u32" || type_text == "u64" || type_text == "u128" || type_text == "u256" || type_text == "f32" || type_text == "f64" || type_text == "bool" || type_text == "char" || type_text == "string"
}

// The kinds a non-void function may return and stay on the watermark path.
fn type_is_plain_scalar_name(type_text string) -> bool {
    return type_is_copy_free(type_text) && type_text != "string" && !is_wide_name(type_text)
}

// A call to a function on the watermark path allocates nothing that outlives it. Arguments
// must be allocation-free and copy-free. While a function is being scanned, a call back to it
// is assumed to be on the watermark path (the rest of its body decides), and a call to any
// other function still being scanned is not, so the scan cannot recurse through callers.
fn call_allocation_free(generator ^CodeGen, expression ^ast.AstNode) -> bool {
    callee_node = expression^.call^.function
    if callee_node == nil || callee_node^.kind != ast.NodeKind.LABEL { return false }
    if !maps.contains_key(generator^.funcs, callee_node^.label^.value) { return false }
    callee = generator^.funcs[callee_node^.label^.value]
    if len(callee^.func_decl^.instantiations) > 0 { return false }
    if len(expression^.call^.args) != len(callee^.func_decl^.params) { return false }
    for position in range(0, len(expression^.call^.args)) {
        if position < len(expression^.call^.arg_names) && expression^.call^.arg_names[position] != "" { return false }
        argument = expression^.call^.args[position]
        if !expression_allocation_free(generator, argument) { return false }
        if !type_is_copy_free(table_type(generator, argument)) { return false }
    }
    probe_count = len(generator^.watermark_probes)
    if probe_count > 0 {
        if generator^.watermark_probes[probe_count - 1] == callee { return true }
        for outer_index in range(0, probe_count - 1) {
            if generator^.watermark_probes[outer_index] != callee { continue }
            generator^.watermark_tainted = true
            return false
        }
    }
    return function_uses_watermark(generator, callee)
}

fn expression_allocation_free(generator ^CodeGen, expression ^ast.AstNode) -> bool {
    if expression == nil { return true }
    when expression^.kind {
        is ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE, ast.NodeKind.NIL_VALUE, ast.NodeKind.STRING_VALUE, ast.NodeKind.LABEL { return true }
        is ast.NodeKind.PREFIX_EXPR { return expression_allocation_free(generator, expression^.prefix^.right) }
        is ast.NodeKind.POSTFIX_EXPR { return expression_allocation_free(generator, expression^.postfix^.left) }
        is ast.NodeKind.MEMBER_EXPR { return expression_allocation_free(generator, expression^.member^.object) }
        is ast.NodeKind.INDEX_EXPR { return expression_allocation_free(generator, expression^.index_data^.left) && expression_allocation_free(generator, expression^.index_data^.index_expr) }
        is ast.NodeKind.INFIX_EXPR {
            // string + string allocates a fresh string
            if expression^.infix^.op == token.TokenKind.PLUS && (expr_type(generator, expression^.infix^.left) == "string" || expr_type(generator, expression^.infix^.right) == "string") { return false }
            return expression_allocation_free(generator, expression^.infix^.left) && expression_allocation_free(generator, expression^.infix^.right)
        }
        is ast.NodeKind.CALL_EXPR { return call_allocation_free(generator, expression) }
        // new(), array/map/struct literals, interpolation, casts, ranges, func refs and
        // implicit enums are assumed to allocate
        default { return false }
    }
}

fn statement_allocation_free(generator ^CodeGen, statement ^ast.AstNode) -> bool {
    if statement == nil { return true }
    when statement^.kind {
        is ast.NodeKind.VAR_DECL {
            declared_value = statement^.var_decl^.value
            if declared_value == nil { return true }
            if !expression_allocation_free(generator, declared_value) { return false }
            return type_is_copy_free(table_type(generator, declared_value))
        }
        is ast.NodeKind.ASSIGN_STMT {
            if !expression_allocation_free(generator, statement^.assign^.target) { return false }
            if !expression_allocation_free(generator, statement^.assign^.value) { return false }
            // `s += t` on a string is a concat
            if statement^.assign^.op == token.TokenKind.PLUS_ASSIGN && expr_type(generator, statement^.assign^.target) == "string" { return false }
            return type_is_copy_free(table_type(generator, statement^.assign^.target))
        }
        is ast.NodeKind.EXPR_STMT { return expression_allocation_free(generator, statement^.expr_stmt^.expr) }
        is ast.NodeKind.IF_STMT {
            alternative = statement^.if_stmt^.alternative
            if !expression_allocation_free(generator, statement^.if_stmt^.condition) || !block_allocation_free(generator, statement^.if_stmt^.consequence) { return false }
            if alternative == nil { return true }
            if alternative^.kind == ast.NodeKind.IF_STMT { return statement_allocation_free(generator, alternative) }
            return block_allocation_free(generator, alternative)
        }
        is ast.NodeKind.FOR_STMT {
            iterable_node = statement^.for_stmt^.iterable
            return iterable_node != nil && iterable_node^.kind == ast.NodeKind.RANGE_EXPR && expression_allocation_free(generator, iterable_node^.range_expr^.start_expr) && expression_allocation_free(generator, iterable_node^.range_expr^.end_expr) && expression_allocation_free(generator, iterable_node^.range_expr^.step) && block_allocation_free(generator, statement^.for_stmt^.body)
        }
        is ast.NodeKind.WHILE_STMT { return expression_allocation_free(generator, statement^.while_stmt^.condition) && block_allocation_free(generator, statement^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { return block_allocation_free(generator, statement^.loop_stmt^.body) }
        is ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT { return true }
        is ast.NodeKind.RETURN_STMT {
            // Scalar values only: a string, array, map or struct is escaped out of the arena
            for_each returned in statement^.return_stmt^.values {
                if !expression_allocation_free(generator, returned) { return false }
                if !type_is_copy_free(table_type(generator, returned)) { return false }
            }
            return true
        }
        // when / for_each / ensure / bare block keep the arena
        default { return false }
    }
}

fn block_allocation_free(generator ^CodeGen, body ^ast.AstNode) -> bool {
    if body == nil || body^.kind != ast.NodeKind.BLOCK_STMT { return false }
    for_each statement in body^.block^.stmts {
        if !statement_allocation_free(generator, statement) { return false }
    }
    return true
}

// True when a non-void function can take the void watermark path (no private arena per
// call): it returns one copy-free scalar and its body allocates nothing.
fn function_uses_watermark(generator ^CodeGen, function_node ^ast.AstNode) -> bool {
    if function_node == nil || function_node^.kind != ast.NodeKind.FUNC_DECL { return false }
    function_data = function_node^.func_decl
    if function_data^.watermark_state != WATERMARK_UNKNOWN { return function_data^.watermark_state == WATERMARK_ALLOCATION_FREE }
    if len(function_data^.return_types) != 1 { return false }
    if len(function_data^.return_names) > 0 && function_data^.return_names[0] != "" { return false }
    if function_uses_caller_arena(generator, function_node) { return false }
    if !type_is_plain_scalar_name(function_data^.return_types[0]) { return false }
    body = function_data^.body
    if body == nil || body^.kind != ast.NodeKind.BLOCK_STMT { return false }
    arrays.append(generator^.watermark_probes, function_node)
    outer_tainted = generator^.watermark_tainted
    generator^.watermark_tainted = false
    mut is_allocation_free = true
    for_each statement in body^.block^.stmts {
        if !is_allocation_free { break }
        if statement != nil && statement^.kind == ast.NodeKind.RETURN_STMT {
            for_each returned in statement^.return_stmt^.values {
                if !expression_allocation_free(generator, returned) { is_allocation_free = false }
            }
        } otherwise {
            is_allocation_free = statement_allocation_free(generator, statement)
        }
    }
    _ = arrays.remove_last(generator^.watermark_probes)
    // A result reached through a call to a function still being scanned depends on where the
    // scan started, so only the outermost scan may memoize it
    if !generator^.watermark_tainted || len(generator^.watermark_probes) == 0 {
        if is_allocation_free { function_data^.watermark_state = WATERMARK_ALLOCATION_FREE } otherwise { function_data^.watermark_state = WATERMARK_ALLOCATES }
    }
    generator^.watermark_tainted = outer_tainted || generator^.watermark_tainted
    return is_allocation_free
}

// True when a void function takes a real scope mark to restore: it does unless its own body
// is provably allocation-free.
fn function_needs_scope_mark(generator ^CodeGen, function_node ^ast.AstNode) -> bool {
    if function_node == nil || len(function_node^.func_decl^.return_types) != 0 { return false }
    return !block_allocation_free(generator, function_node^.func_decl^.body)
}

// The calls of the `ensure` / `defer` statements control flow has reached, last first.
fn ensure_cleanup(generator ^CodeGen) -> string {
    mut text = ""
    mut index i64 = generator^.ensure_reached
    if index > len(generator^.ensures) { index = len(generator^.ensures) }
    as_long_as index > 0 {
        index = index - 1
        text = "${text}${strings.repeat("    ", generator^.indent)}${gen_expr(generator, generator^.ensures[index]^.ensure_stmt^.expr)};\n"
    }
    return text
}

fn gen_if(generator ^CodeGen, node ^ast.AstNode) {
    // An if that allocates nothing has no temporaries to free and opens no scope. Otherwise its
    // branches free their temporaries on exit: nested inside a loop or another scope the enclosing
    // scratch arena is only watermarked; a top-level if keeps a private arena of its own, since it
    // shares its arena with the outer one that escaping writes go to.
    id = next_id(generator)
    is_scoped = !current_function_uses_caller_arena(generator) && !statement_allocation_free(generator, node)
    is_watermark = is_scoped && generator^.loop_scope_depth > 0
    mut outer_declaration = ""
    if is_scoped && generator^.loop_scope_depth == 0 { outer_declaration = "GrayArena *_gray_outer_arena = gray_default_arena; " }
    if !is_scoped {
        emit_line(generator, "{ ")
    } or is_watermark {
        emit_line(generator, "{ ${outer_declaration}GrayScopeMark _if_mark_${id} = gray_scope_save(gray_default_arena);")
    } otherwise {
        emit_line(generator, "{ ${outer_declaration}GrayArena *_if_arena_${id} = gray_capped_arena_create(4096); GrayArena *_if_saved_${id} = gray_default_arena; gray_default_arena = _if_arena_${id};")
    }
    if is_scoped {
        generator^.loop_scope_depth = generator^.loop_scope_depth + 1
        if !is_watermark { scope_arena_push(generator, "_if_arena_${id}", "_if_saved_${id}") }
    }
    gen_if_chain(generator, node)
    mut closing = ""
    if is_scoped {
        generator^.loop_scope_depth = generator^.loop_scope_depth - 1
        if is_watermark {
            closing = "gray_scope_restore(gray_default_arena, _if_mark_${id}); "
        } otherwise {
            scope_arena_pop(generator)
            closing = "gray_default_arena = _if_saved_${id}; gray_arena_destroy(_if_arena_${id}, __FILE__, __LINE__); free(_if_arena_${id}); "
        }
    }
    emit_line(generator, "${closing}}")
}

fn gen_if_chain(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.if_stmt
    emit_line(generator, "if (${gen_expr(generator, data^.condition)}) {")
    gen_nested_block(generator, data^.consequence)
    mut alternative ^ast.AstNode = data^.alternative
    as_long_as alternative != nil {
        if alternative^.kind == ast.NodeKind.IF_STMT {
            emit_line(generator, "} else if (${gen_expr(generator, alternative^.if_stmt^.condition)}) {")
            gen_nested_block(generator, alternative^.if_stmt^.consequence)
            alternative = alternative^.if_stmt^.alternative
        } otherwise {
            emit_line(generator, "} else {")
            gen_nested_block(generator, alternative)
            alternative = nil
        }
    }
    emit_line(generator, "}")
}

// Iterates a string one character at a time, decoding UTF-8.
fn gen_for_each_string(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.for_each_stmt
    mut index_name = data^.index_name
    if index_name == "" { index_name = "_gray_idx" }
    emit(generator, "{ GrayString _gray_str = ${gen_expr(generator, data^.collection)};\n")
    emit_line(generator, "const uint8_t *_gray_cursor = (const uint8_t *)_gray_str.data;")
    emit_line(generator, "const uint8_t *_gray_end_cursor = _gray_cursor + _gray_str.len;")
    emit_line(generator, "for (int32_t ${index_name} = 0; _gray_cursor < _gray_end_cursor; ${index_name}++) {")
    generator^.indent = generator^.indent + 1
    emit_line(generator, "int32_t ${data^.var_name};")
    emit_line(generator, "_gray_cursor += gray_builtin_utf8_next(_gray_cursor, _gray_end_cursor, &${data^.var_name});")
    gen_loop_body(generator, node, data^.body, false)
    generator^.indent = generator^.indent - 1
    emit_line(generator, "}")
    end_loop(generator, node)
    emit_line(generator, "}")
}

// `for_each key, value in map`: entries in insertion order, removed slots skipped.
fn gen_for_each_map(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.for_each_stmt
    collection_type = expr_type(generator, data^.collection)
    id = next_id(generator)
    mut source = gen_expr(generator, data^.collection)
    needs_snapshot = data^.collection^.kind != ast.NodeKind.LABEL
    if needs_snapshot {
        emit(generator, "{ GrayMap _gray_map${id} = ${source};\n")
        emit_indent(generator)
        source = "_gray_map${id}"
    }
    arrays.append(generator^.iterating, source)
    emit(generator, "gray_atomic_add32(&${source}.iterating, 1);\n")
    emit_line(generator, "for (int32_t _gray_mi${id} = 0; _gray_mi${id} < ${source}.order_len; _gray_mi${id}++) {")
    generator^.indent = generator^.indent + 1
    emit_line(generator, "int32_t _gray_sl${id} = ${source}.order[_gray_mi${id}];")
    emit_line(generator, "if (_gray_sl${id} < 0) continue;")
    key_c = map_slot_c(generator, map_key_type(collection_type))
    value_c = map_slot_c(generator, map_value_type(collection_type))
    if data^.index_name == "" {
        // `for_each key in map`: the loop variable is the key
        emit_line(generator, "${key_c} ${data^.var_name} = *(${key_c} *)gray_map_key_at(&${source}, _gray_sl${id});")
    } otherwise {
        if data^.index_name != "_" { emit_line(generator, "${key_c} ${data^.index_name} = *(${key_c} *)gray_map_key_at(&${source}, _gray_sl${id});") }
        if data^.var_name != "_" { emit_line(generator, "${value_c} ${data^.var_name} = *(${value_c} *)gray_map_value_at(&${source}, _gray_sl${id});") }
    }
    gen_loop_body(generator, node, data^.body, false)
    generator^.indent = generator^.indent - 1
    emit_line(generator, "}")
    end_loop(generator, node)
    mut _ = arrays.remove_last(generator^.iterating)
    emit_line(generator, "gray_atomic_sub32(&${source}.iterating, 1);")
    if needs_snapshot { emit_line(generator, "}") }
}


fn gen_for_each(generator ^CodeGen, node ^ast.AstNode) {
    loop_arena_prologue(generator, false)
    emit_indent(generator)
    gen_for_each_inner(generator, node)
    loop_arena_epilogue(generator, false)
}

fn gen_for_each_inner(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.for_each_stmt
    collection = data^.collection
    collection_type = expr_type(generator, collection)
    if collection_type == "string" {
        gen_for_each_string(generator, node)
        return
    }
    if is_map_type(collection_type) {
        gen_for_each_map(generator, node)
        return
    }
    if !is_array_type(collection_type) {
        emit_line(generator, "/* unsupported for_each over ${collection_type} at ${node^.tok.file}:${node^.tok.line} */")
        return
    }
    id = next_id(generator)
    element_c = ctype(generator, array_element_type(collection_type))
    mut index_name = data^.index_name
    if index_name == "" { index_name = "_gray_idx" }
    mut source = gen_expr(generator, collection)
    // anything but a plain name is held in a snapshot first
    needs_snapshot = collection^.kind != ast.NodeKind.LABEL
    mut guard_source = source
    if needs_snapshot {
        if is_real_array_path(collection) {
            // the guard sits on the array the caller can still reach, not on the snapshot
            emit(generator, "{ GrayArray *_gray_arrp${id} = &(${source}); GrayArray _gray_arr${id} = *_gray_arrp${id};\n")
            guard_source = "(*_gray_arrp${id})"
        } otherwise {
            emit(generator, "{ GrayArray _gray_arr${id} = ${source};\n")
            guard_source = "_gray_arr${id}"
        }
        emit_indent(generator)
        source = "_gray_arr${id}"
    }
    emit(generator, "{ int32_t _gray_alen${id} = ${source}.len;\n")
    arrays.append(generator^.iterating, guard_source)
    emit_line(generator, "gray_atomic_add32(&${guard_source}.iterating, 1);")
    emit_line(generator, "for (int32_t ${index_name} = 0; ${index_name} < _gray_alen${id}; ${index_name}++) {")
    generator^.indent = generator^.indent + 1
    // The loop index is written here as it is; only a use in the body is sanitized
    element_line = "${element_c} ${data^.var_name} = GRAY_ARRAY_GET_AT(${source}, ${element_c}, ${index_name}, ${location_args(generator, node)});"
    arrays.append(generator^.index_skip_texts, element_line)
    arrays.append(generator^.index_skip_words, index_name)
    emit_line(generator, element_line)
    gen_loop_body(generator, node, data^.body, false)
    generator^.indent = generator^.indent - 1
    emit_line(generator, "}")
    end_loop(generator, node)
    mut _ = arrays.remove_last(generator^.iterating)
    emit_line(generator, "gray_atomic_sub32(&${guard_source}.iterating, 1);")
    emit_line(generator, "}")
    if needs_snapshot { emit_line(generator, "}") }
}

fn gen_for(generator ^CodeGen, node ^ast.AstNode) {
    no_arena = block_allocation_free(generator, node^.for_stmt^.body)
    loop_arena_prologue(generator, no_arena)
    gen_for_inner(generator, node, no_arena)
    loop_arena_epilogue(generator, no_arena)
}

// The start of a range loop is held in a variable first unless it is an integer literal;
// returns the id of that variable, or -1.
fn hoist_range_start(generator ^CodeGen, start ^ast.AstNode, wide_c string, wide_type string) -> i64 {
    if start == nil || start^.kind == ast.NodeKind.INT_VALUE { return -1 }
    id = next_id(generator)
    if wide_c != "" {
        emit_line(generator, "${wide_c} _gray_start_${id} = ${gen_coerced(generator, wide_type, start)};")
    } otherwise {
        emit_line(generator, "int64_t _gray_start_${id} = ${gen_expr(generator, start)};")
    }
    return id
}

fn range_start_text(generator ^CodeGen, start ^ast.AstNode, start_id i64) -> string {
    if start_id >= 0 { return "_gray_start_${start_id}" }
    return gen_expr(generator, start)
}

// A literal step, or a negated one, has a direction known from how it is written.
fn range_step_direction_known(step ^ast.AstNode) -> bool {
    return step^.kind == ast.NodeKind.INT_VALUE || (step^.kind == ast.NodeKind.PREFIX_EXPR && step^.prefix^.op == token.TokenKind.MINUS)
}

fn range_step_is_negative(step ^ast.AstNode) -> bool {
    if step^.kind == ast.NodeKind.INT_VALUE { return step^.int_value^.value < 0 }
    return true
}

fn gen_for_inner(generator ^CodeGen, node ^ast.AstNode, no_arena bool) {
    data = node^.for_stmt
    iterable = data^.iterable
    if iterable != nil && iterable^.kind != ast.NodeKind.RANGE_EXPR && strings.starts_with(expr_type(generator, iterable), "Range<") {
        // `for i in r`: the range is copied once, so the loop runs the range it started with
        element = range_element(expr_type(generator, iterable))
        range_c = "GrayRange_${element}"
        mut stored_variable = data^.var_name
        if stored_variable == "_" { stored_variable = "_gray_for_blank_${next_id(generator)}" }
        id = next_id(generator)
        mut loop_c = "int64_t"
        mut advance = "gray_range_advance"
        if element != "i64" {
            loop_c = "gray_${element}"
            advance = "gray_${element}_range_advance"
        }
        emit_line(generator, "${range_c} _gray_range_${id} = ${gen_expr(generator, iterable)};")
        emit_line(generator, "if (${range_c}_has_zero_step(_gray_range_${id})) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0090\", \"range step cannot be zero\"); }")
        emit_line(generator, "for (${loop_c} ${stored_variable} = _gray_range_${id}.start; ${range_c}_continues(_gray_range_${id}, ${stored_variable}); ${stored_variable} = ${advance}(${stored_variable}, _gray_range_${id}.step, _gray_range_${id}.stop)) {")
        generator^.indent = generator^.indent + 1
        gen_loop_body(generator, node, data^.body, no_arena)
        generator^.indent = generator^.indent - 1
        emit_line(generator, "}")
        end_loop(generator, node)
        return
    }
    if iterable != nil && iterable^.kind == ast.NodeKind.RANGE_EXPR {
        range_data = iterable^.range_expr
        mut variable = data^.var_name
        if variable == "_" { variable = "_gray_for_blank_${next_id(generator)}" }
        step = range_data^.step
        mut header = ""
        mut wide_type = ""
        // a 128/256-bit bound decides the type; u64 only when no bound is wider
        for_each bound in {range_data^.start_expr, range_data^.end_expr, step} {
            if wide_type == "" && bound != nil && is_wide_name(expr_type(generator, bound)) { wide_type = expr_type(generator, bound) }
        }
        for_each bound in {range_data^.start_expr, range_data^.end_expr, step} {
            if wide_type == "" && bound != nil && expr_type(generator, bound) == "u64" { wide_type = "u64" }
        }
        if wide_type != "" {
            // a wide range: bounds are held and stepped in the wide type
            prefix = range_prefix(wide_type)
            c_wide = prefix
            wide_start_id = hoist_range_start(generator, range_data^.start_expr, c_wide, wide_type)
            id = next_id(generator)
            emit_line(generator, "${c_wide} _gray_end_${id} = ${gen_coerced(generator, wide_type, range_data^.end_expr)};")
            mut advance = "${prefix}_from_u64(1)"
            mut condition = "${prefix}_lt(${variable}, _gray_end_${id})"
            if step != nil {
                emit_line(generator, "${c_wide} _gray_step_${id} = ${gen_coerced(generator, wide_type, step)};")
                emit_line(generator, "if (${prefix}_eq(_gray_step_${id}, ${prefix}_from_u64(0))) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0090\", \"range step cannot be zero\"); }")
                advance = "_gray_step_${id}"
                if strings.starts_with(wide_type, "i") {
                    condition = "${prefix}_gt(_gray_step_${id}, ${prefix}_from_u64(0)) ? ${prefix}_lt(${variable}, _gray_end_${id}) : ${prefix}_gt(${variable}, _gray_end_${id})"
                }
            }
            mut start_text = "${prefix}_from_u64(0)"
            if wide_start_id >= 0 {
                start_text = "_gray_start_${wide_start_id}"
            } or range_data^.start_expr != nil {
                start_text = gen_coerced(generator, wide_type, range_data^.start_expr)
            }
            header = "for (${c_wide} ${variable} = ${start_text}; ${condition}; ${variable} = ${prefix}_range_advance(${variable}, ${advance}, _gray_end_${id})"
        } or range_data^.start_expr == nil {
            // range(end): from 0
            id = next_id(generator)
            emit_line(generator, "__auto_type _gray_end_${id} = ${gen_expr(generator, range_data^.end_expr)};")
            header = "for (int64_t ${variable} = 0; ${variable} < _gray_end_${id}; ${variable}++"
        } or step != nil && !range_step_direction_known(step) {
            // a step known only at run time: its sign picks the direction
            id = next_id(generator)
            start_id = hoist_range_start(generator, range_data^.start_expr, "", "")
            emit_line(generator, "int64_t _gray_end_${id} = ${gen_expr(generator, range_data^.end_expr)}, _gray_step_${id} = ${gen_expr(generator, step)};")
            emit_line(generator, "if (_gray_step_${id} == 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0090\", \"range step cannot be zero\"); }")
            header = "for (int64_t ${variable} = ${range_start_text(generator, range_data^.start_expr, start_id)}; _gray_step_${id} > 0 ? ${variable} < _gray_end_${id} : ${variable} > _gray_end_${id}; ${variable} = gray_range_advance(${variable}, _gray_step_${id}, _gray_end_${id})"
        } or step != nil && step^.kind == ast.NodeKind.INT_VALUE && step^.int_value^.value == 0 {
            emit_line(generator, "gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0090\", \"range step cannot be zero\");")
            header = "for (int64_t ${variable} = 0; 0; (void)0"
        } otherwise {
            // the end (and a step that is not a literal) is evaluated once, before the loop
            start_id = hoist_range_start(generator, range_data^.start_expr, "", "")
            id = next_id(generator)
            emit_line(generator, "__auto_type _gray_end_${id} = ${gen_expr(generator, range_data^.end_expr)};")
            mut step_text = ""
            if step != nil {
                step_text = gen_expr(generator, step)
                if step^.kind != ast.NodeKind.INT_VALUE {
                    emit_line(generator, "__auto_type _gray_step_${id} = ${step_text};")
                    step_text = "_gray_step_${id}"
                }
            }
            mut comparison = "<"
            if step != nil && range_step_is_negative(step) { comparison = ">" }
            mut advance_text = "${variable}++"
            if step != nil { advance_text = "${variable} = gray_range_advance(${variable}, ${step_text}, _gray_end_${id})" }
            header = "for (int64_t ${variable} = ${range_start_text(generator, range_data^.start_expr, start_id)}; ${variable} ${comparison} _gray_end_${id}; ${advance_text}"
        }
        emit_line(generator, "${header}) {")
        generator^.indent = generator^.indent + 1
        gen_loop_body(generator, node, data^.body, no_arena)
        generator^.indent = generator^.indent - 1
        emit_line(generator, "}")
        end_loop(generator, node)
        return
    }
    emit_line(generator, "/* unsupported for loop at ${node^.tok.file}:${node^.tok.line} */")
}

// A when case value as the C comparison against the subject.
fn when_condition(generator ^CodeGen, subject string, subject_type string, value ^ast.AstNode) -> string {
    if value^.kind == ast.NodeKind.RANGE_EXPR { return when_range_text(generator, subject, subject_type, value^.range_expr, value) }
    if strings.starts_with(expr_type(generator, value), "Range<") {
        element = range_element(expr_type(generator, value))
        range_c = "GrayRange_${element}"
        id = next_id(generator)
        mut subject_c = "int64_t"
        if element != "i64" { subject_c = "gray_${element}" }
        return "({ ${subject_c} _gray_subject_${id} = ${subject}; ${range_c} _gray_range_${id} = ${gen_expr(generator, value)}; if (${range_c}_has_zero_step(_gray_range_${id})) { gray_panic_code_at(\"${generator^.file}\", ${generator^.when_line}, \"P0090\", \"range step cannot be zero\"); } ${range_c}_contains(_gray_range_${id}, _gray_subject_${id}, \"${generator^.file}\", ${generator^.when_line}); })"
    }
    if value^.kind == ast.NodeKind.WHEN_PATTERN {
        pattern = value^.when_pattern
        enum_name = pattern^.enum_name
        if enum_name == "" { enum_name = subject_type }
        if is_tagged_enum(generator, enum_name) { return "${subject}.tag == GrayEnum_${enum_name}_TAG_${pattern^.variant}" }
        return "${subject} == GrayEnum_${enum_name}_${pattern^.variant}"
    }
    if is_tagged_enum(generator, subject_type) && value^.kind == ast.NodeKind.IMPLICIT_ENUM {
        return "${subject}.tag == GrayEnum_${subject_type}_TAG_${value^.implicit_enum^.variant}"
    }
    if is_tagged_enum(generator, subject_type) && value^.kind == ast.NodeKind.MEMBER_EXPR {
        return "${subject}.tag == GrayEnum_${subject_type}_TAG_${value^.member^.member}"
    }
    if subject_type == "string" || is_string_enum(generator, subject_type) { return "gray_string_eq(${subject}, ${gen_expr(generator, value)})" }
    if is_wide_name(subject_type) { return "${wide_prefix(subject_type)}_eq(${subject}, ${gen_coerced(generator, subject_type, value)})" }
    if subject_type == "f32" && value^.kind == ast.NodeKind.FLOAT_VALUE { return "${subject} == (${float_literal_f32(value)})" }
    return "${subject} == (${gen_expr(generator, value)})"
}

// The payload variables a tagged-enum pattern binds, declared from the subject.
fn gen_pattern_bindings(generator ^CodeGen, subject string, subject_type string, values [^ast.AstNode]) {
    for_each value in values {
        if value^.kind != ast.NodeKind.WHEN_PATTERN { continue }
        pattern = value^.when_pattern
        mut enum_name = pattern^.enum_name
        if enum_name == "" { enum_name = subject_type }
        if !is_tagged_enum(generator, enum_name) { continue }
        for_each variant in generator^.enums[enum_name]^.enum_decl^.values {
            if variant.name != pattern^.variant { continue }
            generator^.indent = generator^.indent + 1
            for i in range(0, len(pattern^.bindings)) {
                if pattern^.bindings[i] == "_" || i >= len(variant.payload_types) { continue }
                emit_line(generator, "${ctype(generator, variant.payload_types[i])} ${pattern^.bindings[i]} = ${subject}.data.${variant.name}._${i};")
            }
            generator^.indent = generator^.indent - 1
        }
    }
}

fn gen_when(generator ^CodeGen, node ^ast.AstNode) {
    generator^.when_line = node^.tok.line
    data = node^.when_stmt
    subject_name = "_gray_when${next_id(generator)}"
    subject_type = expr_type(generator, data^.value)
    emit_line(generator, "__auto_type ${subject_name} = ${gen_expr(generator, data^.value)};")
    mut first = true
    for_each when_case in data^.cases {
        mut conditions [string] = {}
        for_each value in when_case.values {
            arrays.append(conditions, when_condition(generator, subject_name, subject_type, value))
        }
        // a case closes the branch before it on the line that opens its own
        mut opener = "} else if ("
        if first { opener = "if (" }
        first = false
        emit_line(generator, "${opener}${strings.join(conditions, " || ")}) {")
        gen_pattern_bindings(generator, subject_name, subject_type, when_case.values)
        gen_nested_block(generator, when_case.body)
    }
    if data^.default_body != nil {
        if first {
            emit_line(generator, "{")
        } otherwise {
            emit_line(generator, "} else {")
        }
        gen_nested_block(generator, data^.default_body)
    } or data^.is_strict && !first {
        // an exhaustive match: the fall-through is dead
        emit_line(generator, "} else { GRAY_UNREACHABLE(); }")
        return
    }
    emit_line(generator, "}")
}

// --- Functions and program ---

fn param_list(generator ^CodeGen, function_data ^ast.FuncDeclData) -> string {
    mut pieces [string] = {}
    for_each param in function_data^.params {
        // A type parameter has no C parameter: the instantiation bakes it in
        if param.is_type_param { continue }
        if param.is_mutable {
            arrays.append(pieces, "${param_c_type(generator, param)} *${param.name}")
        } otherwise {
            arrays.append(pieces, "${param_c_type(generator, param)} ${param.name}")
        }
    }
    if len(pieces) == 0 { return "void" }
    return strings.join(pieces, ", ")
}

fn param_types(generator ^CodeGen, function_data ^ast.FuncDeclData) -> string {
    mut pieces [string] = {}
    for_each param in function_data^.params {
        if param.is_type_param { continue }
        if param.is_mutable {
            arrays.append(pieces, "${param_c_type(generator, param)} *")
        } otherwise {
            arrays.append(pieces, param_c_type(generator, param))
        }
    }
    if len(pieces) == 0 { return "void" }
    return strings.join(pieces, ", ")
}

// True when a result of the function is written with one of its type parameters.
fn return_depends_on_generic(function_data ^ast.FuncDeclData) -> bool {
    for_each param in function_data^.params {
        if !param.is_type_param { continue }
        for_each return_type in function_data^.return_types {
            if type_mentions_name(return_type, param.name) { return true }
        }
    }
    return false
}

fn type_mentions_name(type_text string, name string) -> bool {
    mut position i64 = 0
    total = len(type_text)
    as_long_as position < total {
        character = strings.char_at(type_text, position)
        if ast.is_type_identifier_char(character) {
            start = position
            as_long_as position < total && ast.is_type_identifier_char(strings.char_at(type_text, position)) { position = position + 1 }
            if strings.slice(type_text, start, position) == name { return true }
        } otherwise {
            position = position + 1
        }
    }
    return false
}

// The name of the struct a function returns several values in: its own for an instantiation whose
// results depend on the type parameters, the shared one otherwise.
fn multi_return_type_name(function_data ^ast.FuncDeclData, fn_name string) -> string {
    if !ast.func_has_generic_params(function_data) || return_depends_on_generic(function_data) { return "GrayMulti_${fn_name}" }
    return "GrayMulti_${function_data^.name}"
}

fn return_c_type(generator ^CodeGen, function_data ^ast.FuncDeclData, fn_name string) -> string {
    if len(function_data^.return_types) == 0 { return "void" }
    if len(function_data^.return_types) > 1 { return multi_return_type_name(function_data, fn_name) }
    return ctype(generator, function_data^.return_types[0])
}

// The C name of one instantiation of a generic function: the base name and
// the bound types, with every character that is not legal in a C identifier
// replaced by an underscore.
fn mangle_generic_name(base string, concrete string) -> string {
    mut pieces [string] = {}
    for i in range(0, len(concrete)) {
        character = strings.char_at(concrete, i)
        if ast.is_type_identifier_char(character) {
            arrays.append(pieces, strings.slice(concrete, i, i + 1))
        } otherwise {
            arrays.append(pieces, "_")
        }
    }
    return "${base}__${strings.join(pieces, "")}"
}

// Emits one function. A generic function is emitted once per instantiation
// (`concrete` is that instantiation's bound types); any other has `concrete` empty.
fn gen_function(generator ^CodeGen, node ^ast.AstNode, concrete string, owner string) {
    function_data = node^.func_decl
    // panic locations name the file the function's code lives in
    saved_file = generator^.file
    if node^.tok.file != "" { generator^.file = node^.tok.file }
    mut fn_name = function_data^.name
    if concrete != "" {
        fn_name = mangle_generic_name(function_data^.name, concrete)
        generator^.generics = ast.generic_bindings_init(function_data, concrete)
    }
    mut eff_returns [string] = {}
    for_each rt in function_data^.return_types { arrays.append(eff_returns, eff(generator, rt)) }
    generator^.return_types = eff_returns
    generator^.multi_name = multi_return_type_name(function_data, fn_name)
    generator^.ref_params = {}
    generator^.current_params = {}
    generator^.heap_variables = {}
    generator^.mem_names = {}
    generator^.mem_arenas = {}
    generator^.mem_has_epoch = {}
    generator^.loop_scope_depth = 0
    generator^.scope_arena_variables = {}
    generator^.scope_arena_saved = {}
    generator^.is_in_no_arena_loop = false
    saved_raw_names = generator^.raw_names
    generator^.raw_names = {}
    for_each param in function_data^.params {
        if param.is_mutable { arrays.append(generator^.ref_params, param.name) }
        arrays.append(generator^.current_params, param.name)
    }
    if node^.tok.file != "" && node^.tok.line > 0 { emit_line_directive(generator, node^.tok.file, node^.tok.line) }
    emit_line(generator, "static ${return_c_type(generator, function_data, fn_name)} gray_fn_${fn_name}(${param_list(generator, function_data)}) {")
    generator^.indent = generator^.indent + 1
    // a C library can run a callback on a thread it created, which has no arenas yet
    if function_data^.is_c_callback { emit_line(generator, "gray_callback_thread_init();") }
    saved_function = generator^.current_function
    generator^.current_function = node
    is_main_function = function_data^.name == "main"
    runs_in_caller_arena = function_uses_caller_arena(generator, node)
    runs_on_watermark = len(function_data^.return_types) == 0 || function_uses_watermark(generator, node)
    takes_scope_mark = function_needs_scope_mark(generator, node)
    if !is_main_function && !runs_in_caller_arena {
        if runs_on_watermark {
            if takes_scope_mark { emit_line(generator, "GrayScopeMark _scope_mark = gray_scope_save(gray_default_arena);") }
        } otherwise {
            emit_line(generator, "GrayArena *_func_arena = gray_capped_arena_create(65536);")
            emit_line(generator, "GrayArena *_func_saved = gray_default_arena;")
            emit_line(generator, "gray_default_arena = _func_arena;")
        }
    }
    mut runtime_name = function_data^.name
    if function_data^.original_name != "" { runtime_name = function_data^.original_name }
    if owner != "" && strings.starts_with(runtime_name, "${owner}_") {
        runtime_name = "${display_type_name(generator, owner)}.${strings.slice(runtime_name, len(owner) + 1, len(runtime_name))}"
    }
    generator^.function_runtime_name = runtime_name
    emit_line(generator, "gray_enter_func(\"${generator^.file}\", ${node^.tok.line}, \"${runtime_name}\");")
    saved_ensures = generator^.ensures
    saved_reached = generator^.ensure_reached
    generator^.ensures = {}
    generator^.ensure_reached = 0
    if function_data^.body != nil && function_data^.body^.kind == ast.NodeKind.BLOCK_STMT {
        for_each statement in function_data^.body^.block^.stmts {
            if statement^.kind == ast.NodeKind.ENSURE_STMT { arrays.append(generator^.ensures, statement) }
        }
    }
    gen_block_body(generator, function_data^.body)
    emit(generator, ensure_cleanup(generator))
    generator^.ensures = saved_ensures
    generator^.ensure_reached = saved_reached
    if !is_main_function && !runs_in_caller_arena {
        if runs_on_watermark {
            if takes_scope_mark { emit_line(generator, "gray_scope_restore(gray_default_arena, _scope_mark);") }
        } otherwise {
            emit_line(generator, "gray_default_arena = _func_saved;")
            emit_line(generator, "gray_arena_destroy(_func_arena, __FILE__, __LINE__); free(_func_arena);")
        }
    }
    generator^.raw_names = saved_raw_names
    generator^.current_function = saved_function
    emit_line(generator, "gray_exit_func();")
    generator^.indent = generator^.indent - 1
    emit_line(generator, "}")
    emit(generator, "\n")
    reset_line_directive(generator)
    generator^.generics = ast.GenericBindings{}
    generator^.file = saved_file
}

// The program-wide open ErrorCode enum: the builtin slots, then the variants of
// every `#error_code` enum in source order, as `#define`s and a name lookup.
fn error_code_names(program ^ast.AstNode) -> [string] {
    mut names [string] = {"Unknown", "NotFound", "AlreadyExists", "PermissionDenied", "InvalidInput", "OutOfRange", "Unsupported", "Timeout", "Interrupted", "Closed", "WouldBlock", "Unavailable", "IoFailure", "ParseFailure", "EncodingFailure", "ConversionFailure", "NotAuthenticated", "ConnectionRefused", "ConnectionReset", "AddressInUse", "BrokenPipe", "WriteZero"}
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.ENUM_DECL || !statement^.enum_decl^.is_error_code { continue }
        for_each value in statement^.enum_decl^.values { arrays.append(names, value.name) }
    }
    return names
}

fn gen_error_codes(generator ^CodeGen, program ^ast.AstNode) {
    names = error_code_names(program)
    emit_line(generator, "typedef int64_t GrayErrorCode;")
    for i in range(0, len(names)) { emit_line(generator, "#define GrayErrorCode_${names[i]} ${i}") }
    emit_line(generator, "static inline const char *gray_error_code_name(int64_t _c) {")
    emit_line(generator, "    switch (_c) {")
    for i in range(0, len(names)) { emit_line(generator, "        case ${i}: return \"${names[i]}\";") }
    emit_line(generator, "        default: return \"Unknown\";")
    emit_line(generator, "    }")
    emit_line(generator, "}")
    emit(generator, "\n")
}

// The includes a program needs: the runtime, then one header per stdlib import.
// Whether the program is built as a test runner (--test) rather than an executable.
mut is_test_mode bool = false

fn set_test_mode(enabled bool) {
    is_test_mode = enabled
}

// The arena limit given with --arena-limit, in bytes; 0 keeps the 1 GB default.
mut arena_limit i64 = 0

fn set_arena_limit(limit i64) {
    arena_limit = limit
}

// #test functions exist only for `gray test`: a normal build drops them, and a --test build
// keeps only those declared in the file being compiled. Returns the ones kept.
fn strip_test_functions(program ^ast.AstNode, file string) -> [^ast.AstNode] {
    mut kept_tests [^ast.AstNode] = {}
    mut kept_statements [^ast.AstNode] = {}
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.FUNC_DECL && statement^.func_decl^.is_test {
            if is_test_mode && (statement^.tok.file == "" || statement^.tok.file == file) {
                arrays.append(kept_tests, statement)
                arrays.append(kept_statements, statement)
            }
            continue
        }
        arrays.append(kept_statements, statement)
    }
    program^.program^.stmts = kept_statements
    return kept_tests
}

fn preamble_head() -> string {
    mut text = "/* Generated by grayc */\n#include \"runtime.h\"\n#include \"array.h\"\n#include \"map.h\"\n#include \"stdlib/builtins.h\"\n#include \"os.h\"\n"
    if is_test_mode { text = "${text}#include \"test.h\"\n" }
    return text
}

// Whether the program imports the standard library module `module_name`.
fn imports_stdlib_module(program ^ast.AstNode, module_name string) -> bool {
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.IMPORT_STMT { continue }
        for_each item in statement^.import_stmt^.items {
            if item.is_stdlib && item.mod_name == module_name { return true }
        }
    }
    return false
}

// The headers after the collection headers: bigint.h, then each imported module's header in the
// fixed order of the table, then the `extern import` headers and the blank line that closes the
// preamble.
fn preamble_tail(program ^ast.AstNode) -> string {
    mut text = "#include \"bigint.h\"\n"
    modules = {"mem", "fmt", "math", "io", "random", "time", "uuid", "encoding", "crypto", "binary", "csv", "json", "strconv", "chars", "path", "sqlite", "threads", "sync", "atomic", "channels", "regex", "net", "http", "server", "runtime"}
    headers = {"mem.h", "fmt.h", "math.h", "io.h", "random.h", "time.h", "uuid.h", "encoding.h", "crypto.h", "binary.h", "csv.h", "json.h", "strconv.h", "chars.h", "path.h", "sqlite.h", "threads.h", "sync.h", "atomic_mod.h", "channels.h", "regex.h", "net.h", "http.h", "server.h", "runtime_mod.h"}
    for position in range(0, len(modules)) {
        if imports_stdlib_module(program, modules[position]) { text = "${text}#include \"${headers[position]}\"\n" }
    }
    return "${text}${c_interop_includes(program)}\n"
}

// The `extern import` headers, guarded so a header cannot redefine a runtime macro:
// every runtime macro name is saved before the includes and restored after them.
fn c_interop_includes(program ^ast.AstNode) -> string {
    mut includes [string] = {}
    mut seen [string] = {}
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.IMPORT_STMT { continue }
        for_each item in statement^.import_stmt^.items {
            if !item.is_c_import { continue }
            mut header = item.source_path
            mut quoted = false
            if strings.starts_with(header, "./") || strings.starts_with(header, "../") {
                quoted = true
                slash = strings.last_index_of(statement^.tok.file, "/")
                mut directory = ""
                if slash >= 0 { directory = strings.slice(statement^.tok.file, 0, slash + 1) }
                resolved, resolve_error = path.absolute_path("${directory}${header}")
                if resolve_error == nil { header = resolved } otherwise { header = "${directory}${header}" }
            }
            if arrays.contains(seen, header) { continue }
            if strings.contains(header, "\"") || strings.contains(header, ">") || strings.contains(header, "\\") || strings.contains(header, "\n") { continue }
            arrays.append(seen, header)
            if quoted {
                arrays.append(includes, "#include \"${header}\"")
            } otherwise {
                arrays.append(includes, "#include <${header}>")
            }
        }
    }
    if len(includes) == 0 { return "" }
    mut text = "\n/* C interop headers */\n"
    names = runtime_macros.runtime_macro_names()
    for_each name in names { text = "${text}#pragma push_macro(\"${name}\")\n" }
    for_each include_line in includes { text = "${text}${include_line}\n" }
    for_each name in names { text = "${text}#pragma pop_macro(\"${name}\")\n" }
    return text
}

// The enums a stdlib module exposes (io.OpenFlag, os.Platform), as declarations
// of the importing program: a variant is reachable as `module.VARIANT` and as
// `EnumName.VARIANT`, and its value is its position.
fn stdlib_enum_decls(program ^ast.AstNode) -> [^ast.AstNode] {
    mut decls [^ast.AstNode] = {}
    mut seen [string] = {}
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.IMPORT_STMT { continue }
        for_each item in statement^.import_stmt^.items {
            if !item.is_stdlib { continue }
            mut enum_name = ""
            mut variants [string] = {}
            if item.mod_name == "io" {
                enum_name = "OpenFlag"
                variants = {"O_RDONLY", "O_WRONLY", "O_RDWR"}
            }
            if item.mod_name == "os" {
                enum_name = "Platform"
                variants = {"MAC_OS", "LINUX", "WINDOWS", "OTHER"}
            }
            if enum_name == "" || arrays.contains(seen, enum_name) { continue }
            arrays.append(seen, enum_name)
            node = ast.ast_alloc(ast.NodeKind.ENUM_DECL, statement^.tok)
            data = new(ast.EnumDeclData)
            data^.name = enum_name
            mut values [ast.EnumVal] = {}
            for_each variant in variants { arrays.append(values, ast.EnumVal{name: variant}) }
            data^.values = values
            node^.enum_decl = data
            arrays.append(decls, node)
        }
    }
    return decls
}

// Registers every struct and enum so later emission can look them up.
fn register_types(generator ^CodeGen, program ^ast.AstNode) {
    for_each decl in stdlib_enum_decls(program) {
        generator^.enums[decl^.enum_decl^.name] = decl
        arrays.append(generator^.stdlib_enum_names, decl^.enum_decl^.name)
    }
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.VAR_DECL && !statement^.var_decl^.is_mutable && statement^.var_decl^.value != nil && statement^.var_decl^.value^.kind == ast.NodeKind.INT_VALUE {
            generator^.int_constants[statement^.var_decl^.name] = statement^.var_decl^.value^.int_value^.value
        }
        if statement^.kind == ast.NodeKind.VAR_DECL && statement^.tok.file == generator^.file { arrays.append(generator^.entry_globals, statement^.var_decl^.name) }
        if statement^.kind == ast.NodeKind.STRUCT_DECL { generator^.structs[statement^.struct_decl^.name] = statement }
        if statement^.kind == ast.NodeKind.ENUM_DECL { generator^.enums[statement^.enum_decl^.name] = statement }
        if statement^.kind == ast.NodeKind.FUNC_DECL { generator^.funcs[statement^.func_decl^.name] = statement }
        if statement^.kind == ast.NodeKind.STRUCT_DECL {
            // a struct function is emitted as `Type_name`
            for_each member in statement^.struct_decl^.funcs {
                member_decl = member.func_decl^.func_decl
                member_decl^.name = "${statement^.struct_decl^.name}_${member_decl^.name}"
                generator^.funcs[member_decl^.name] = member.func_decl
            }
        }
    }
}

// The struct a multi-value function returns.
fn gen_multi_typedef(generator ^CodeGen, function_data ^ast.FuncDeclData, fn_name string) {
    arrays.append(generator^.skipped_start, len(generator^.out))
    emit_line(generator, "typedef struct {")
    generator^.indent = generator^.indent + 1
    for i in range(0, len(function_data^.return_types)) {
        emit_line(generator, "${ctype(generator, function_data^.return_types[i])} v${i};")
    }
    generator^.indent = generator^.indent - 1
    emit_line(generator, "} GrayMulti_${fn_name};")
    emit(generator, "\n")
    arrays.append(generator^.skipped_end, len(generator^.out))
}

// A tagged enum: a tag, plus a union holding the payload of the variant. The
// tag and the forward typedef come first; the body follows once every type it
// holds by value is complete (gen_tagged_enum_body).
fn gen_tagged_enum_definition(generator ^CodeGen, data ^ast.EnumDeclData) {
    name = data^.name
    emit_line(generator, "typedef enum {")
    for i in range(0, len(data^.values)) {
        emit_line(generator, "    GrayEnum_${name}_TAG_${data^.values[i].name} = ${i},")
    }
    emit_line(generator, "} GrayEnum_${name}_Tag;")
    emit(generator, "\n")
}

fn gen_tagged_enum_body(generator ^CodeGen, name string, &done map[string:bool]) {
    if maps.contains_key(done, name) { return }
    done[name] = true
    data = generator^.enums[name]^.enum_decl
    for_each value in data^.values {
        if len(value.payload_types) == 0 { continue }
        mut slots [string] = {}
        for i in range(0, len(value.payload_types)) {
            arrays.append(slots, "${ctype(generator, value.payload_types[i])} _${i};")
        }
        emit_line(generator, "typedef struct { ${strings.join(slots, " ")} } GrayEnum_${name}_Data_${value.name};")
    }
    emit_line(generator, "struct GrayEnum_${name} {")
    emit_line(generator, "    GrayEnum_${name}_Tag tag;")
    emit_line(generator, "    union {")
    for_each value in data^.values {
        if len(value.payload_types) > 0 { emit_line(generator, "        GrayEnum_${name}_Data_${value.name} ${value.name};") }
    }
    emit_line(generator, "    } data;")
    emit_line(generator, "};")
    emit(generator, "\n")
}

// Emits the struct or tagged enum a value of `type_name` holds by value.
fn gen_by_value_dependency(generator ^CodeGen, type_name string, &done map[string:bool]) {
    if maps.contains_key(generator^.structs, type_name) { gen_struct_definition(generator, type_name, done) }
    if is_tagged_enum(generator, type_name) { gen_tagged_enum_body(generator, type_name, done) }
}

// A tagged enum variant with no payload, written as a name (`Shape.Point`, `.Point`).
fn unit_variant_value(enum_name string, variant string) -> string {
    return "(GrayEnum_${enum_name}){ .tag = GrayEnum_${enum_name}_TAG_${variant} }"
}

// A tagged enum value of variant `variant`, its payload the given arguments.
fn gen_tagged_value(generator ^CodeGen, enum_name string, variant string, arguments [^ast.AstNode]) -> string {
    if len(arguments) == 0 { return "((GrayEnum_${enum_name}){ .tag = GrayEnum_${enum_name}_TAG_${variant} })" }
    mut payload_types [string] = {}
    for_each value in generator^.enums[enum_name]^.enum_decl^.values {
        if value.name == variant { payload_types = value.payload_types }
    }
    mut pieces [string] = {}
    for i in range(0, len(arguments)) {
        if i < len(payload_types) {
            expect_type(arguments[i], payload_types[i])
            arrays.append(pieces, gen_stored(generator, payload_types[i], arguments[i]))
        } otherwise {
            arrays.append(pieces, gen_expr(generator, arguments[i]))
        }
    }
    return "((GrayEnum_${enum_name}){ .tag = GrayEnum_${enum_name}_TAG_${variant}, .data.${variant} = { ${strings.join(pieces, ", ")} } })"
}

fn is_tagged_enum(generator ^CodeGen, type_name string) -> bool {
    return maps.contains_key(generator^.enums, type_name) && generator^.enums[type_name]^.enum_decl^.is_tagged
}

fn gen_enum_definition(generator ^CodeGen, node ^ast.AstNode) {
    data = node^.enum_decl
    if data^.is_tagged {
        gen_tagged_enum_definition(generator, data)
        return
    }
    if is_string_enum(generator, data^.name) {
        emit_line(generator, "typedef GrayString GrayEnum_${data^.name};")
        for_each value in data^.values {
            // a variant without a value is its own name
            mut text = value.name
            if value.value != nil { text = ast.ast_string_decode(value.value^.string_value) }
            emit_line(generator, "#define GrayEnum_${data^.name}_${value.name} ((GrayString){ ${c_quote(text)}, ${len(text)} })")
        }
        emit(generator, "\n")
        return
    }
    emit_line(generator, "typedef enum {")
    generator^.indent = generator^.indent + 1
    mut value_index i64 = 0
    for_each value in data^.values {
        if data^.is_error_code {
            // the variant's value is its global ErrorCode slot
            emit_line(generator, "GrayEnum_${data^.name}_${value.name} = GrayErrorCode_${value.name},")
        } or value.value == nil && data^.is_flags && value_index < MAX_FLAG_VARIANTS {
            emit_line(generator, "GrayEnum_${data^.name}_${value.name} = ${1 bit_shift_left value_index}LL,")
        } or value.value != nil {
            emit_line(generator, "GrayEnum_${data^.name}_${value.name} = ${gen_expr(generator, value.value)},")
        } or arrays.contains(generator^.stdlib_enum_names, data^.name) {
            emit_line(generator, "GrayEnum_${data^.name}_${value.name} = ${value_index},")
        } otherwise {
            emit_line(generator, "GrayEnum_${data^.name}_${value.name},")
        }
        value_index = value_index + 1
    }
    generator^.indent = generator^.indent - 1
    emit_line(generator, "} GrayEnum_${data^.name};")
    emit(generator, "\n")
}

// Emits a struct after every struct it holds by value.
fn gen_struct_definition(generator ^CodeGen, name string, &done map[string:bool]) {
    if maps.contains_key(done, name) { return }
    done[name] = true
    node = generator^.structs[name]
    declared_fields = node^.struct_decl^.struct_fields
    emit_line(generator, "struct GrayStruct_${name} {")
    generator^.indent = generator^.indent + 1
    for_each field in declared_fields {
        emit_line(generator, "${ctype(generator, field.type_name)} ${field.name};")
    }
    generator^.indent = generator^.indent - 1
    emit_line(generator, "};")
    emit(generator, "\n")
}

// The structs and tagged enums, each after the ones it holds by value: the declarations are swept
// in order, over and over, and one is written once nothing it holds is still waiting. A cycle's
// remainder is written as it stands.
fn gen_type_definitions(generator ^CodeGen, program ^ast.AstNode) {
    mut forward_declared = false
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.ENUM_DECL && statement^.enum_decl^.is_tagged {
            emit_line(generator, "typedef struct GrayEnum_${statement^.enum_decl^.name} GrayEnum_${statement^.enum_decl^.name};")
            forward_declared = true
        }
    }
    if forward_declared { emit(generator, "\n") }
    mut slot_names [string] = {}
    mut slot_is_struct [bool] = {}
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.STRUCT_DECL {
            arrays.append(slot_names, statement^.struct_decl^.name)
            arrays.append(slot_is_struct, true)
        }
    }
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.ENUM_DECL && statement^.enum_decl^.is_tagged {
            arrays.append(slot_names, statement^.enum_decl^.name)
            arrays.append(slot_is_struct, false)
        }
    }
    total = len(slot_names)
    mut emitted [bool] = {}
    for slot in range(0, total) { arrays.append(emitted, false) }
    mut done [string:bool] = {:}
    mut emitted_count i64 = 0
    for sweep in range(0, total) {
        if emitted_count >= total { break }
        for slot in range(0, total) {
            if emitted[slot] { continue }
            dependencies = type_definition_dependencies(generator, slot_names[slot], slot_is_struct[slot])
            mut dependencies_met = true
            for_each dependency in dependencies {
                for other in range(0, total) {
                    if other == slot || emitted[other] { continue }
                    if slot_names[other] == dependency { dependencies_met = false }
                }
            }
            if !dependencies_met { continue }
            emitted[slot] = true
            emitted_count = emitted_count + 1
            if slot_is_struct[slot] {
                gen_struct_definition(generator, slot_names[slot], done)
            } otherwise {
                gen_tagged_enum_body(generator, slot_names[slot], done)
            }
        }
    }
    for slot in range(0, total) {
        if emitted[slot] { continue }
        if slot_is_struct[slot] {
            gen_struct_definition(generator, slot_names[slot], done)
        } otherwise {
            gen_tagged_enum_body(generator, slot_names[slot], done)
        }
    }
}

// The types a struct's fields, or a tagged enum's payloads, hold by value.
fn type_definition_dependencies(generator ^CodeGen, name string, is_struct bool) -> [string] {
    mut types [string] = {}
    mut held [string] = {}
    if is_struct {
        for_each field in generator^.structs[name]^.struct_decl^.struct_fields { arrays.append(held, field.type_name) }
    } otherwise {
        for_each value in generator^.enums[name]^.enum_decl^.values {
            for_each payload_type in value.payload_types { arrays.append(held, payload_type) }
        }
    }
    for_each held_type in held {
        if held_type == "" || strings.starts_with(held_type, "^") || strings.starts_with(held_type, "[") || strings.starts_with(held_type, "map[") { continue }
        arrays.append(types, eff(generator, held_type))
    }
    return types
}

// The C translation unit for a type-checked program.
fn generate_program(program ^ast.AstNode, file string) -> string {
    test_functions = strip_test_functions(program, file)
    generator = codegen_create(file)
    register_stdlib_calls(generator)
    register_aliases(generator, program)
    register_types(generator, program)
    emit(generator, preamble_head())
    collection_include_index i64 = len(generator^.out) - 1
    generator^.needs_arrays_header = imports_stdlib_module(program, "arrays")
    generator^.needs_maps_header = imports_stdlib_module(program, "maps")
    generator^.needs_strings_header = imports_stdlib_module(program, "strings")
    emit(generator, preamble_tail(program))
    undefine_index i64 = len(generator^.out) - 1

    mut has_forward_typedefs = false
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.STRUCT_DECL {
            emit_line(generator, "typedef struct GrayStruct_${statement^.struct_decl^.name} GrayStruct_${statement^.struct_decl^.name};")
            has_forward_typedefs = true
        }
    }
    if has_forward_typedefs { emit(generator, "\n") }
    gen_error_codes(generator, program)
    for_each decl in stdlib_enum_decls(program) { gen_enum_definition(generator, decl) }
    for_each statement in program^.program^.stmts {
        if statement^.kind == ast.NodeKind.ENUM_DECL { gen_enum_definition(generator, statement) }
    }
    gen_type_definitions(generator, program)
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.FUNC_DECL || len(statement^.func_decl^.return_types) < 2 { continue }
        function_data = statement^.func_decl
        // an instantiation whose results depend on the type parameters gets its typedef ahead of its prototype
        if !ast.func_has_generic_params(function_data) || !return_depends_on_generic(function_data) { gen_multi_typedef(generator, function_data, function_data^.name) }
    }
    // the multi-value results of struct functions
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.STRUCT_DECL { continue }
        for_each member in statement^.struct_decl^.funcs {
            member_fd = member.func_decl^.func_decl
            if len(member_fd^.return_types) < 2 { continue }
            if !ast.func_has_generic_params(member_fd) || !return_depends_on_generic(member_fd) { gen_multi_typedef(generator, member_fd, member_fd^.name) }
        }
    }

    gen_json_helpers(generator, program)

    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.FUNC_DECL { continue }
        function_data = statement^.func_decl
        if !ast.func_has_generic_params(function_data) {
            emit_line(generator, "static ${return_c_type(generator, function_data, function_data^.name)} gray_fn_${function_data^.name}(${param_types(generator, function_data)});")
            continue
        }
        // a generic function is emitted once per recorded instantiation
        for_each concrete in function_data^.instantiations {
            generator^.generics = ast.generic_bindings_init(function_data, concrete)
            fn_name = mangle_generic_name(function_data^.name, concrete)
            if len(function_data^.return_types) > 1 && return_depends_on_generic(function_data) { gen_multi_typedef(generator, function_data, fn_name) }
            emit_line(generator, "static ${return_c_type(generator, function_data, fn_name)} gray_fn_${fn_name}(${param_types(generator, function_data)});")
            generator^.generics = ast.GenericBindings{}
        }
    }
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.STRUCT_DECL { continue }
        for_each member in statement^.struct_decl^.funcs {
            member_decl = member.func_decl^.func_decl
            if !ast.func_has_generic_params(member_decl) {
                emit_line(generator, "static ${return_c_type(generator, member_decl, member_decl^.name)} gray_fn_${member_decl^.name}(${param_types(generator, member_decl)});")
                continue
            }
            for_each concrete in member_decl^.instantiations {
                generator^.generics = ast.generic_bindings_init(member_decl, concrete)
                member_name = mangle_generic_name(member_decl^.name, concrete)
                if len(member_decl^.return_types) > 1 && return_depends_on_generic(member_decl) { gen_multi_typedef(generator, member_decl, member_name) }
                emit_line(generator, "static ${return_c_type(generator, member_decl, member_name)} gray_fn_${member_name}(${param_types(generator, member_decl)});")
                generator^.generics = ast.GenericBindings{}
            }
        }
    }
    emit(generator, "\n")
    gen_global_declarations(generator, program)
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.FUNC_DECL { continue }
        if !ast.func_has_generic_params(statement^.func_decl) {
            gen_function(generator, statement, "", "")
            continue
        }
        for_each concrete in statement^.func_decl^.instantiations { gen_function(generator, statement, concrete, "") }
    }
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.STRUCT_DECL { continue }
        for_each member in statement^.struct_decl^.funcs {
            if !ast.func_has_generic_params(member.func_decl^.func_decl) {
                gen_function(generator, member.func_decl, "", statement^.struct_decl^.name)
                continue
            }
            for_each concrete in member.func_decl^.func_decl^.instantiations { gen_function(generator, member.func_decl, concrete, statement^.struct_decl^.name) }
        }
    }

    main_index = len(generator^.out)
    emit(generator, "int main(int argc, char **argv) {\n")
    emit(generator, "    (void)argc; (void)argv;\n")
    mut arena_limit_text = "1073741824"
    if arena_limit > 0 { arena_limit_text = "${arena_limit}" }
    emit(generator, "    gray_runtime_init(${arena_limit_text}ULL);\n")
    emit(generator, "    gray_os_init(argc, argv);\n")
    generator^.indent = 1
    // Module-level containers grow and copy their keys into the arena they were created in:
    // create them in the heap arena, which no function return rewinds
    initializer_lines = generator^.global_initializers
    if len(initializer_lines) > 0 {
        emit(generator, "    { GrayArena *_gray_init_saved = gray_default_arena; gray_default_arena = gray_heap_arena;\n")
        for_each initializer_line in initializer_lines { emit(generator, initializer_line) }
        emit(generator, "    gray_default_arena = _gray_init_saved; }\n")
    }
    generator^.indent = 0
    if is_test_mode {
        emit(generator, "    gray_test_begin();\n")
        for_each test_function in test_functions {
            test_decl = test_function^.func_decl
            mut test_name string = test_decl^.original_name
            if test_name == "" { test_name = test_decl^.name }
            emit(generator, "    gray_test_run(\"${test_name}\", gray_fn_${test_decl^.name}, \"${generator^.file}\", ${test_function^.tok.line});\n")
        }
        emit(generator, "    int _gray_test_rc = gray_test_end();\n")
        emit(generator, "    return _gray_test_rc;\n")
    } otherwise {
        emit(generator, "    gray_fn_main();\n")
        emit(generator, "    return 0;\n")
    }
    emit(generator, "}\n")
    emit(generator, "\nconst GrayFunctionSignatureEntry gray_function_signatures[] = {\n")
    for i in range(0, len(generator^.function_signature_symbols)) { emit(generator, "    { (void *)${generator^.function_signature_symbols[i]}, \"${generator^.function_signature_types[i]}\" },\n") }
    emit(generator, "    { NULL, NULL }\n};\n")
    // The collection headers the body turned out to need
    mut collection_includes string = ""
    if generator^.needs_arrays_header { collection_includes = "${collection_includes}#include \"arrays.h\"\n" }
    if generator^.needs_maps_header { collection_includes = "${collection_includes}#include \"maps.h\"\n" }
    if generator^.needs_strings_header { collection_includes = "${collection_includes}#include \"strings.h\"\n" }
    // The names the program uses as written may be macros in the C headers
    mut undefines string = ""
    identifiers = identifiers_in_emission_order(generator, undefine_index + 1, main_index)
    for_each identifier in identifiers { undefines = "${undefines}#undef ${identifier}\n" }
    generator^.out[collection_include_index] = "${generator^.out[collection_include_index]}${collection_includes}"
    generator^.out[undefine_index] = "${generator^.out[undefine_index]}${undefines}"
    return strings.join(generator^.out, "")
}

// `addr(x)` and `raw(x)`. `addr(p^.f)` / `addr(p^)` nil-check `p`; `raw` does not and
// strips a `const` qualifier from the pointer it yields.
fn gen_address_call(generator ^CodeGen, node ^ast.AstNode, name string, argument ^ast.AstNode) -> string {
    mut pointer_expression ^ast.AstNode = nil
    mut field_name = ""
    if argument^.kind == ast.NodeKind.MEMBER_EXPR {
        object = argument^.member^.object
        if is_deref(object) {
            pointer_expression = object^.postfix^.left
            field_name = argument^.member^.member
        } or strings.starts_with(expr_type(generator, object), "^") {
            pointer_expression = object
            field_name = argument^.member^.member
        }
    }
    mut cast_text = ""
    if name == "raw" && strings.starts_with(expr_type(generator, node), "^") {
        cast_text = "(${ctype(generator, expr_type(generator, node))})"
    }
    if pointer_expression != nil && field_name != "" {
        if name == "raw" { return "${cast_text}&(${gen_expr(generator, pointer_expression)})->${field_name}" }
        id = next_id(generator)
        return "({ __auto_type _aadp${id} = ${gen_expr(generator, pointer_expression)}; if (!_aadp${id}) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0080\", \"nil pointer dereference\"); } &_aadp${id}->${field_name}; })"
    }
    if is_deref(argument) {
        inner = argument^.postfix^.left
        if name == "raw" { return "${cast_text}${gen_expr(generator, inner)}" }
        id = next_id(generator)
        return "({ __auto_type _aadp${id} = ${gen_expr(generator, inner)}; if (!_aadp${id}) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0080\", \"nil pointer dereference\"); } _aadp${id}; })"
    }
    if name == "raw" { return "${cast_text}&${gen_expr(generator, argument)}" }
    return "&${gen_expr(generator, argument)}"
}

// `&handle` so a runtime function can clear the caller's handle; a handle that is
// not a variable (a call result) is passed in a one-element array.
fn handle_address(generator ^CodeGen, handle ^ast.AstNode, handle_type string) -> string {
    value = gen_expr(generator, handle)
    if handle^.kind == ast.NodeKind.LABEL || handle^.kind == ast.NodeKind.MEMBER_EXPR || handle^.kind == ast.NodeKind.INDEX_EXPR || handle^.kind == ast.NodeKind.POSTFIX_EXPR {
        return "&(${value})"
    }
    return "(${handle_type}[1]){${value}}"
}

// The declared length of a `[T, N]` array type, or -1 when the type has no length.
fn fixed_array_size(generator ^CodeGen, type_name string) -> i64 {
    if !strings.starts_with(type_name, "[") { return -1 }
    comma = last_top_level_comma(strings.slice(type_name, 1, len(type_name) - 1))
    if comma < 0 { return -1 }
    size_text = strings.trim(strings.slice(type_name, comma + BRACKET_AND_COMMA_LENGTH, len(type_name) - 1))
    if maps.contains_key(generator^.int_constants, size_text) { return generator^.int_constants[size_text] }
    declared_size, size_error = strconv.to_i64(size_text)
    if size_error != nil { return -1 }
    return declared_size
}

// An array with no elements written: empty, or N zero slots for a `[T, N]` type.
fn empty_array_text(generator ^CodeGen, type_name string) -> string {
    element_c = ctype(generator, array_element_type(type_name))
    size = fixed_array_size(generator, type_name)
    if size > 0 {
        // the slots of a fixed-size array are typed the way a map's are: a plain enum is an int64, a string enum its string
        if maps.contains_key(generator^.enums, eff(generator, array_element_type(type_name))) { element_c = map_slot_c(generator, array_element_type(type_name)) }
        if is_string_enum(generator, array_element_type(type_name)) { element_c = "GrayString" }
        slot_zero = zero_value_text(generator, array_element_type(type_name))
        if slot_zero != "" {
            mut slots [string] = {}
            for slot in range(0, size) { arrays.append(slots, slot_zero) }
            return "gray_array_from(gray_default_arena, (${element_c}[${size}]){${strings.join(slots, ", ")}}, sizeof(${element_c}), ${size}, GRAY_ELEM_KIND_OF(${element_c}))"
        }
        return "gray_array_from(gray_default_arena, (${element_c}[${size}]){}, sizeof(${element_c}), ${size}, GRAY_ELEM_KIND_OF(${element_c}))"
    }
    return "GRAY_ARRAY_NEW_OF(gray_default_arena, ${element_c}, 4)"
}

// A module-level variable whose initializer is a C constant is emitted inline; any other value is
// zero-initialized at file scope and assigned at the start of main.
fn global_initializer_is_constant(value ^ast.AstNode) -> bool {
    if value == nil { return true }
    if value^.folded_literal != "" { return true }
    when value^.kind {
        is ast.NodeKind.BOOL_VALUE, ast.NodeKind.CHAR_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE, ast.NodeKind.NIL_VALUE { return true }
        default { return false }
    }
}

// The file-scope zero a deferred global starts as.
fn constant_zero_text(generator ^CodeGen, type_name string) -> string {
    c_name = ctype(generator, type_name)
    if c_name == "int64_t" { return "0" }
    if c_name == "double" { return "0.0" }
    if c_name == "bool" { return "false" }
    if c_name == "GrayString" { return "(GrayString){\"\", 0}" }
    if c_name == "GrayArray" { return "(GrayArray){0}" }
    if c_name == "GrayMap" { return "(GrayMap){0}" }
    if c_name == "gray_i128" { return "GRAY_I128_ZERO" }
    if c_name == "gray_u128" { return "GRAY_U128_ZERO" }
    if c_name == "gray_i256" { return "GRAY_I256_ZERO" }
    if c_name == "gray_u256" { return "GRAY_U256_ZERO" }
    if enum_has_default_variant(generator, type_name) {
        return "GrayEnum_${type_name}_${generator^.enums[type_name]^.enum_decl^.values[0].name}"
    }
    return "{0}"
}

// The module-level variables, after the function forward declarations; the statements that
// initialize the non-constant ones are collected for main.
// Queues the statement that sets a module-level variable at the start of main, and remembers
// where in the output its text was generated.
fn note_deferred_initializer(generator ^CodeGen, c_name string, text string) {
    arrays.append(generator^.global_initializers, "    ${c_name} = ${text};\n")
    arrays.append(generator^.deferred_positions, len(generator^.out))
    arrays.append(generator^.deferred_texts, text)
}

// The text of a deferred initializer, generated as code inside main.
fn deferred_initializer_text(generator ^CodeGen, type_name string, value ^ast.AstNode) -> string {
    generator^.indent = 1
    text = gen_declared_value(generator, type_name, value)
    generator^.indent = 0
    return text
}

fn gen_global_declarations(generator ^CodeGen, program ^ast.AstNode) {
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.VAR_DECL { continue }
        global = statement^.var_decl
        if global^.name == "_" { continue }
        c_name = global_c_name(generator, global^.name)
        mut global_type = eff(generator, global^.type_name)
        if global_type == "" && global^.value != nil { global_type = expr_type(generator, global^.value) }
        if is_array_type(global_type) || is_map_type(global_type) {
            mut container_c = "GrayArray"
            if is_map_type(global_type) { container_c = "GrayMap" }
            emit_line(generator, "${container_c} ${c_name};")
            if global^.value != nil {
                expect_type(global^.value, global_type)
                note_deferred_initializer(generator, c_name, deferred_initializer_text(generator, global_type, global^.value))
            } otherwise {
                note_deferred_initializer(generator, c_name, zero_value_text(generator, global_type))
            }
            continue
        }
        if global^.value != nil {
            expect_type(global^.value, global_type)
            if global_initializer_is_constant(global^.value) {
                emit_line(generator, "${ctype(generator, global_type)} ${c_name} = ${gen_coerced(generator, global_type, global^.value)};")
                continue
            }
            emit_line(generator, "${ctype(generator, global_type)} ${c_name} = ${constant_zero_text(generator, global_type)};")
            note_deferred_initializer(generator, c_name, deferred_initializer_text(generator, global_type, global^.value))
            continue
        }
        global_zero = zero_value_text(generator, global_type)
        if is_struct_kind_type(generator, global_type) {
            emit_line(generator, "${ctype(generator, global_type)} ${c_name} = ${constant_zero_text(generator, global_type)};")
            if global_zero == "" { global_zero = "(${ctype(generator, global_type)}){0}" }
            note_deferred_initializer(generator, c_name, global_zero)
            continue
        }
        if global_zero == "" { global_zero = constant_zero_text(generator, global_type) }
        emit_line(generator, "${ctype(generator, global_type)} ${c_name} = ${global_zero};")
    }
}

// An enum whose zero matches no variant starts as its first one: the first variant carries an
// explicit value and the enum is not a set of flags.
fn enum_has_default_variant(generator ^CodeGen, type_name string) -> bool {
    if !maps.contains_key(generator^.enums, type_name) { return false }
    declaration = generator^.enums[type_name]^.enum_decl
    if declaration^.is_error_code || declaration^.is_flags || declaration^.is_tagged || len(declaration^.values) == 0 { return false }
    return declaration^.values[0].value != nil
}

// The starting value of a field or variable that is given none, when plain C zero is not it:
// an empty collection, an enum's first variant, a struct whose fields need the same.
// "" when zero is right.
fn zero_value_text(generator ^CodeGen, written_type string) -> string {
    type_name = eff(generator, written_type)
    if is_map_type(type_name) {
        return "GRAY_MAP_NEW_OF(gray_default_arena, ${map_slot_c(generator, map_key_type(type_name))}, ${map_slot_c(generator, map_value_type(type_name))}, 8)"
    }
    if is_array_type(type_name) { return empty_array_text(generator, type_name) }
    if maps.contains_key(generator^.enums, type_name) {
        values = generator^.enums[type_name]^.enum_decl^.values
        if enum_has_default_variant(generator, type_name) { return "GrayEnum_${type_name}_${values[0].name}" }
        return ""
    }
    if maps.contains_key(generator^.structs, type_name) && generator^.struct_zero_depth < MAX_STRUCT_ZERO_DEPTH {
        generator^.struct_zero_depth = generator^.struct_zero_depth + 1
        mut field_inits [string] = {}
        for_each field in generator^.structs[type_name]^.struct_decl^.struct_fields {
            if field.default_value != nil {
                expect_type(field.default_value, field.type_name)
                arrays.append(field_inits, ".${field.name} = ${gen_expr(generator, field.default_value)}")
            } otherwise {
                field_zero = zero_value_text(generator, field.type_name)
                if field_zero != "" { arrays.append(field_inits, ".${field.name} = ${field_zero}") }
            }
        }
        generator^.struct_zero_depth = generator^.struct_zero_depth - 1
        return "(${ctype(generator, type_name)}){${strings.join(field_inits, ", ")}}"
    }
    return ""
}

// The type an assignment target was declared with. A struct field keeps the length written in
// its declaration (`[T, N]`), which the checked type of the expression drops.
fn declared_target_type(generator ^CodeGen, target ^ast.AstNode) -> string {
    checked = expr_type(generator, target)
    if target^.kind != ast.NodeKind.MEMBER_EXPR || !strings.starts_with(checked, "[") { return checked }
    mut owner = expr_type(generator, target^.member^.object)
    if strings.starts_with(owner, "^") { owner = strings.slice(owner, 1, len(owner)) }
    if !maps.contains_key(generator^.structs, owner) { return checked }
    for_each field in generator^.structs[owner]^.struct_decl^.struct_fields {
        if field.name == target^.member^.member { return eff(generator, field.type_name) }
    }
    return checked
}

// Whether `subject` (C text) falls in a range: from start up to end, every step-th value;
// a negative step runs downwards.
// The wide type a range test runs in: the subject's, else the first bound that is wide or u64; "" for a plain range.
fn range_wide_type(generator ^CodeGen, subject_type string, range_data ^ast.RangeData) -> string {
    if is_wide_name(subject_type) { return subject_type }
    for_each bound in {range_data^.start_expr, range_data^.end_expr, range_data^.step} {
        if bound != nil && is_wide_name(expr_type(generator, bound)) { return expr_type(generator, bound) }
    }
    for_each bound in {range_data^.start_expr, range_data^.end_expr, range_data^.step} {
        if bound != nil && expr_type(generator, bound) == "u64" { return "u64" }
    }
    return ""
}

// An operand of a u64 range is converted to the runtime's u64 struct; the wider types coerce as usual.
fn wide_range_operand(generator ^CodeGen, wide_type string, operand ^ast.AstNode) -> string {
    if wide_type == "u64" { return "gray_u64_from_u64((uint64_t)(${gen_expr(generator, operand)}))" }
    return gen_coerced(generator, wide_type, operand)
}

fn range_start_or_zero(generator ^CodeGen, range_data ^ast.RangeData) -> string {
    if range_data^.start_expr == nil { return "0" }
    return gen_expr(generator, range_data^.start_expr)
}

// `x in range(a, b, step)` over a wide integer: each operand is held once and the step's sign picks
// the direction the bounds are compared in.
fn in_wide_range_text(generator ^CodeGen, left_node ^ast.AstNode, wide_type string, range_data ^ast.RangeData, where_node ^ast.AstNode) -> string {
    prefix = range_prefix(wide_type)
    id = next_id(generator)
    value_text = wide_range_operand(generator, wide_type, left_node)
    mut start_text = "${prefix}_from_u64(0)"
    if range_data^.start_expr != nil { start_text = wide_range_operand(generator, wide_type, range_data^.start_expr) }
    end_text = wide_range_operand(generator, wide_type, range_data^.end_expr)
    text = "({ ${prefix} _gray_in_value_${id} = ${value_text}; ${prefix} _gray_in_start_${id} = ${start_text}; ${prefix} _gray_in_end_${id} = ${end_text}; "
    if range_data^.step == nil {
        return "${text}${prefix}_ge(_gray_in_value_${id}, _gray_in_start_${id}) && ${prefix}_lt(_gray_in_value_${id}, _gray_in_end_${id}); })"
    }
    step_text = wide_range_operand(generator, wide_type, range_data^.step)
    where = location_args(generator, where_node)
    return "${text}${prefix} _gray_in_step_${id} = ${step_text}; bool _gray_in_down_${id} = ${prefix}_lt(_gray_in_step_${id}, ${prefix}_from_u64(0)); (_gray_in_down_${id} ? (${prefix}_le(_gray_in_value_${id}, _gray_in_start_${id}) && ${prefix}_gt(_gray_in_value_${id}, _gray_in_end_${id})) : (${prefix}_ge(_gray_in_value_${id}, _gray_in_start_${id}) && ${prefix}_lt(_gray_in_value_${id}, _gray_in_end_${id}))) && ${prefix}_eq(${prefix}_mod(${prefix}_sub(_gray_in_value_${id}, _gray_in_start_${id}), _gray_in_step_${id}, ${where}), ${prefix}_from_u64(0)); })"
}

// A `when` case that is a range: an inline comparison against the subject, descending when the step is negated.
fn when_range_text(generator ^CodeGen, subject string, subject_type string, range_data ^ast.RangeData, where_node ^ast.AstNode) -> string {
    step = range_data^.step
    descending = step != nil && step^.kind == ast.NodeKind.PREFIX_EXPR && step^.prefix^.op == token.TokenKind.MINUS
    wide_type = range_wide_type(generator, subject_type, range_data)
    if wide_type != "" {
        prefix = range_prefix(wide_type)
        mut lower = "ge"
        mut upper = "lt"
        if descending {
            lower = "le"
            upper = "gt"
        }
        mut start_text = "${prefix}_from_u64(0)"
        if range_data^.start_expr != nil { start_text = gen_coerced(generator, wide_type, range_data^.start_expr) }
        text = "(${prefix}_${lower}(${subject}, ${start_text}) && ${prefix}_${upper}(${subject}, ${gen_coerced(generator, wide_type, range_data^.end_expr)})"
        if step != nil {
            text = "${text} && ${prefix}_eq(${prefix}_mod(${prefix}_sub(${subject}, ${start_text}), ${gen_coerced(generator, wide_type, step)}, ${location_args(generator, where_node)}), ${prefix}_from_u64(0))"
        }
        return "${text})"
    }
    mut lower_operator = " >= "
    mut upper_operator = " < "
    if descending {
        lower_operator = " <= "
        upper_operator = " > "
    }
    start_text = range_start_or_zero(generator, range_data)
    mut text = "(${subject}${lower_operator}${start_text} && ${subject}${upper_operator}${gen_expr(generator, range_data^.end_expr)}"
    if step != nil { text = "${text} && (${subject} - ${start_text}) % ${gen_expr(generator, step)} == 0" }
    return "${text})"
}

fn range_membership_text(generator ^CodeGen, subject string, subject_type string, range_data ^ast.RangeData, where_node ^ast.AstNode) -> string {
    mut wide_type = ""
    if is_wide_name(subject_type) { wide_type = subject_type }
    for_each bound in {range_data^.start_expr, range_data^.end_expr, range_data^.step} {
        if wide_type == "" && bound != nil && (is_wide_name(expr_type(generator, bound)) || expr_type(generator, bound) == "u64") { wide_type = expr_type(generator, bound) }
    }
    if wide_type != "" {
        prefix = range_prefix(wide_type)
        c_wide = ctype(generator, wide_type)
        id = next_id(generator)
        mut start_text = "${prefix}_from_u64(0)"
        if range_data^.start_expr != nil { start_text = gen_coerced(generator, wide_type, range_data^.start_expr) }
        mut subject_text = "(uint64_t)(${subject})"
        if wide_type != "u64" { subject_text = to_wide(wide_type, subject_type, subject) }
        where = location_args(generator, where_node)
        text = "({ ${c_wide} _rs${id} = ${subject_text}, _ra${id} = ${start_text}, _re${id} = ${gen_coerced(generator, wide_type, range_data^.end_expr)}; "
        if range_data^.step == nil { return "${text}${prefix}_ge(_rs${id}, _ra${id}) && ${prefix}_lt(_rs${id}, _re${id}); })" }
        zero = "${prefix}_from_u64(0)"
        up = "${prefix}_ge(_rs${id}, _ra${id}) && ${prefix}_lt(_rs${id}, _re${id}) && ${prefix}_eq(${prefix}_mod(${prefix}_sub(_rs${id}, _ra${id}), _rt${id}, ${where}), ${zero})"
        if !strings.starts_with(wide_type, "i") {
            return "${text}${c_wide} _rt${id} = ${gen_coerced(generator, wide_type, range_data^.step)}; ${up}; })"
        }
        down = "${prefix}_lt(_rt${id}, ${zero}) && ${prefix}_le(_rs${id}, _ra${id}) && ${prefix}_gt(_rs${id}, _re${id}) && ${prefix}_eq(${prefix}_mod(${prefix}_sub(_ra${id}, _rs${id}), ${prefix}_neg(_rt${id}), ${where}), ${zero})"
        return "${text}${c_wide} _rt${id} = ${gen_coerced(generator, wide_type, range_data^.step)}; ${prefix}_gt(_rt${id}, ${zero}) ? (${up}) : (${down}); })"
    }
    mut start_text = "0"
    if range_data^.start_expr != nil { start_text = gen_expr(generator, range_data^.start_expr) }
    end_text = gen_expr(generator, range_data^.end_expr)
    if range_data^.step == nil { return "(${subject} >= ${start_text} && ${subject} < ${end_text})" }
    id = next_id(generator)
    return "({ int64_t _rs${id} = ${subject}, _ra${id} = ${start_text}, _re${id} = ${end_text}, _rt${id} = ${gen_expr(generator, range_data^.step)}; _rt${id} > 0 ? (_rs${id} >= _ra${id} && _rs${id} < _re${id} && (_rs${id} - _ra${id}) % _rt${id} == 0) : (_rt${id} < 0 && _rs${id} <= _ra${id} && _rs${id} > _re${id} && (_ra${id} - _rs${id}) % (-_rt${id}) == 0); })"
}

// True when `callee` (a member expression) names a field of a struct value, or of a pointer to
// one, whose type is a function type.
fn is_func_field(generator ^CodeGen, callee ^ast.AstNode) -> bool {
    mut owner = expr_type(generator, callee^.member^.object)
    if strings.starts_with(owner, "^") { owner = strings.slice(owner, 1, len(owner)) }
    if !maps.contains_key(generator^.structs, owner) { return false }
    for_each field in generator^.structs[owner]^.struct_decl^.struct_fields {
        if field.name == callee^.member^.member { return is_func_type(eff(generator, field.type_name)) }
    }
    return false
}

// `a, [b, character], d` split at the commas outside brackets and parentheses.
fn split_top_level(text string) -> [string] {
    mut parts [string] = {}
    mut depth i64 = 0
    mut start i64 = 0
    for i in range(0, len(text)) {
        character = strings.char_at(text, i)
        if character == '[' || character == '(' { depth = depth + 1 }
        if character == ']' || character == ')' { depth = depth - 1 }
        if character == ',' && depth == 0 {
            arrays.append(parts, strings.slice(text, start, i))
            start = i + 1
        }
    }
    arrays.append(parts, strings.slice(text, start, len(text)))
    return parts
}

// The index of the `)` that closes the `(` at `open_index`, or -1.
fn matching_paren(text string, open_index i64) -> i64 {
    mut depth i64 = 0
    for i in range(open_index, len(text)) {
        character = strings.char_at(text, i)
        if character == '(' { depth = depth + 1 }
        if character == ')' {
            depth = depth - 1
            if depth == 0 { return i }
        }
    }
    return -1
}

// The range arguments of a checked narrowing cast to the sized integer `type_name`.
fn array_cast_bounds(type_name string, file string, line i64) -> string {
    when type_name {
        is "i8" { return "-128, 127, \"i8\", \"${file}\", ${line}" }
        is "i16" { return "-32768, 32767, \"i16\", \"${file}\", ${line}" }
        is "i32" { return "-2147483648LL, 2147483647, \"i32\", \"${file}\", ${line}" }
        is "u8" { return "255, \"u8\", \"${file}\", ${line}" }
        is "u16" { return "65535, \"u16\", \"${file}\", ${line}" }
        is "u32" { return "4294967295ULL, \"u32\", \"${file}\", ${line}" }
        default { return "0, 0, \"${type_name}\", \"${file}\", ${line}" }
    }
}

// The integer type a stored range runs in: i64, or one of the wide types and u64.
fn range_element(range_type string) -> string {
    inner = strings.slice(range_type, RANGE_PREFIX_LENGTH, len(range_type))
    for_each wide_element in {"i128", "u128", "i256", "u256", "u64"} {
        if strings.starts_with(inner, wide_element) { return wide_element }
    }
    return "i64"
}

// A `range(...)` kept as a value: start, stop and step evaluated in order, defaults filled in.
fn gen_range_value(generator ^CodeGen, node ^ast.AstNode) -> string {
    element = range_element(expr_type(generator, node))
    id = next_id(generator)
    range_data = node^.range_expr
    mut value_c = "int64_t"
    mut zero = "0"
    mut one = "1"
    if element != "i64" {
        value_c = "gray_${element}"
        zero = "gray_${element}_from_u64(0)"
        one = "gray_${element}_from_u64(1)"
    }
    mut parts = "({ "
    names = {"start", "stop", "step"}
    nodes = {range_data^.start_expr, range_data^.end_expr, range_data^.step}
    defaults = {zero, zero, one}
    for slot in range(0, 3) {
        mut part_text = defaults[slot]
        if nodes[slot] != nil {
            if element == "i64" { part_text = gen_expr(generator, nodes[slot]) } otherwise { part_text = wide_range_operand(generator, element, nodes[slot]) }
        }
        parts = "${parts}${value_c} _gray_range_${names[slot]}_${id} = ${part_text}; "
    }
    return "${parts}(GrayRange_${element}){ _gray_range_start_${id}, _gray_range_stop_${id}, _gray_range_step_${id} }; })"
}

// The helper prefix of a range bound type: a wide type's, or u64's.
fn range_prefix(type_name string) -> string {
    if type_name == "u64" { return "gray_u64" }
    return wide_prefix(type_name)
}

// True when `node` yields a container value with no address: the result of a call or literal.
fn is_rvalue_container(node ^ast.AstNode) -> bool {
    if node^.kind == ast.NodeKind.INDEX_EXPR { return is_rvalue_container(node^.index_data^.left) }
    if node^.kind == ast.NodeKind.MEMBER_EXPR { return is_rvalue_container(node^.member^.object) }
    return node^.kind == ast.NodeKind.CALL_EXPR || node^.kind == ast.NodeKind.ARRAY_VALUE || node^.kind == ast.NodeKind.MAP_VALUE || node^.kind == ast.NodeKind.INTERPOLATED_STRING
}

// A number that keeps the locals of one write-back call apart from those of another.
fn id_for_write_back(generator ^CodeGen) -> i64 {
    return next_id(generator)
}

// --- JSON ---

// Which container helper a primitive element type maps to: 's' signed, 'u' unsigned, 'f' float,
// 'b' bool, 'S' string, "" other.
fn json_prim_class(type_name string) -> string {
    if type_name == "string" { return "S" }
    if type_name == "bool" { return "b" }
    if is_wide_name(type_name) { return "" }
    if is_float_name(type_name) { return "f" }
    if is_signed_int_name(type_name) || type_name == "char" { return "s" }
    if is_unsigned_int_name(type_name) { return "u" }
    return ""
}

fn json_is_number(type_name string) -> bool {
    return is_signed_int_name(type_name) || is_unsigned_int_name(type_name) || is_float_name(type_name) || is_wide_name(type_name)
}

// A `#json` field that is an array or a nested `#json` struct.
fn json_field_is_composite(generator ^CodeGen, type_name string) -> bool {
    if type_name == "string" || type_name == "bool" || json_is_number(type_name) { return false }
    return !maps.contains_key(generator^.enums, eff(generator, type_name))
}

fn json_key_text(key string) -> string {
    return strings.replace(key, "?", "\\?")
}

fn json_key_lookup(key string) -> string {
    return "    { GrayString _k = gray_string_lit(\"${json_key_text(key)}\"); void *_v = gray_map_get(&_m, &_k);\n"
}

// The statement that decodes the array element text `_es` into `_e`.
fn json_element_decode(generator ^CodeGen, element_type string, line i64) -> string {
    if element_type == "string" { return "            _e = gray_json_element_as_string(arena, _es, _k, \"${generator^.file}\", ${line});\n" }
    if element_type == "bool" { return "            _e = gray_json_field_as_bool(_es, _k, \"${generator^.file}\", ${line});\n" }
    if json_is_number(element_type) {
        return "            gray_json_field_decode(_es, GRAY_ELEM_KIND_OF(${ctype(generator, element_type)}), &_e, \"${generator^.file}\", ${line});\n"
    }
    return "            if (!gray_json_is_null(_es)) _e = gray_json_parse_${eff(generator, element_type)}(arena, _es);\n"
}

// The helpers of every `#json` struct: parse and encode, for the struct and for an array of it.
fn gen_json_helpers(generator ^CodeGen, program ^ast.AstNode) {
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.STRUCT_DECL || !statement^.struct_decl^.is_json { continue }
        name = statement^.struct_decl^.name
        emit(generator, "static GrayStruct_${name} gray_json_parse_${name}(GrayArena *arena, GrayString text);\nstatic GrayString gray_json_encode_struct_${name}(GrayArena *arena, GrayStruct_${name} _s);\nstatic GrayArray gray_json_parse_array_${name}(GrayArena *arena, GrayString text);\nstatic GrayString gray_json_encode_struct_array_${name}(GrayArena *arena, GrayArray _arr);\n")
    }
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.STRUCT_DECL || !statement^.struct_decl^.is_json { continue }
        emit(generator, gen_json_struct_helpers(generator, statement))
    }
}

fn gen_json_struct_helpers(generator ^CodeGen, statement ^ast.AstNode) -> string {
    name = statement^.struct_decl^.name
    struct_members = statement^.struct_decl^.struct_fields
    line = statement^.tok.line
    file = generator^.file
    // --- parse: JSON text -> struct ---
    mut text = "static GrayStruct_${name} gray_json_parse_${name}(GrayArena *arena, GrayString text) {\n    GrayStruct_${name} _r = {0};\n"
    for_each field in struct_members {
        field_type = eff(generator, field.type_name)
        if maps.contains_key(generator^.enums, field_type) && !is_tagged_enum(generator, field_type) && len(generator^.enums[field_type]^.enum_decl^.values) > 0 {
            text = "${text}    _r.${field.name} = GrayEnum_${field_type}_${generator^.enums[field_type]^.enum_decl^.values[0].name};\n"
        }
    }
    text = "${text}    GrayMap _q;\n    GrayMap _m = gray_json_decode_fields(arena, text, &_q, \"${file}\", ${line});\n"
    for_each field in struct_members {
        mut key = field.name
        if field.json_tag != "" { key = field.json_tag }
        field_type = eff(generator, field.type_name)
        if field.type_name == "string" {
            text = "${text}${json_key_lookup(key)}      if (_v) { gray_json_check_field_quoting(&_q, _k, true, \"a string\", \"${file}\", ${line}); _r.${field.name} = *(GrayString *)_v; } }\n"
        } or json_is_number(field.type_name) {
            text = "${text}${json_key_lookup(key)}      if (_v) { gray_json_check_field_quoting(&_q, _k, false, \"a number\", \"${file}\", ${line}); gray_json_field_decode(*(GrayString *)_v, GRAY_ELEM_KIND_OF(${ctype(generator, field.type_name)}), &_r.${field.name}, \"${file}\", ${line}); } }\n"
        } or field.type_name == "bool" {
            text = "${text}${json_key_lookup(key)}      if (_v) { gray_json_check_field_quoting(&_q, _k, false, \"a bool\", \"${file}\", ${line}); _r.${field.name} = gray_json_field_as_bool(*(GrayString *)_v, _k, \"${file}\", ${line}); } }\n"
        } or json_field_is_composite(generator, field.type_name) {
            text = "${text}${json_key_lookup(key)}"
            if is_array_type(field_type) {
                element_type = array_element_type(field_type)
                element_c = ctype(generator, element_type)
                text = "${text}      if (_v) { gray_json_require_array_field(&_q, _k, *(GrayString *)_v, \"${file}\", ${line});\n        GrayArray _ea = gray_json_split_array(arena, *(GrayString *)_v);\n        _r.${field.name} = GRAY_ARRAY_NEW_OF(arena, ${element_c}, _ea.len > 0 ? _ea.len : 4);\n        for (int32_t _i = 0; _i < _ea.len; _i++) {\n            GrayString _es = *(GrayString *)((char *)_ea.data + (size_t)_i * (size_t)_ea.elem_size);\n            ${element_c} _e = {0};\n${json_element_decode(generator, element_type, line)}            gray_array_push(arena, &_r.${field.name}, &_e, __FILE__, __LINE__);\n        } } }\n"
            } otherwise {
                text = "${text}      if (_v && !gray_json_is_null(*(GrayString *)_v)) { _r.${field.name} = gray_json_parse_${field_type}(arena, *(GrayString *)_v); } }\n"
            }
        } or maps.contains_key(generator^.enums, field_type) && !is_tagged_enum(generator, field_type) {
            enum_values = generator^.enums[field_type]^.enum_decl^.values
            mut variant_names [string] = {}
            for_each value in enum_values { arrays.append(variant_names, "GrayEnum_${field_type}_${value.name}") }
            text = "${text}${json_key_lookup(key)}      if (_v) { GrayString _sv = *(GrayString *)_v;\n"
            if is_string_enum(generator, field_type) {
                text = "${text}        _r.${field.name} = gray_json_enum_from_str(_sv, (const GrayString[${len(enum_values)}]){${strings.join(variant_names, ", ")}}, ${len(enum_values)}, \"${field_type}\"); } }\n"
            } otherwise {
                text = "${text}        int64_t _iv = gray_builtin_string_to_i64(_sv);\n        _r.${field.name} = (${ctype(generator, field_type)})gray_json_enum_from_number(_sv, _iv, (const int64_t[${len(enum_values)}]){${strings.join(variant_names, ", ")}}, ${len(enum_values)}, \"${field_type}\"); } }\n"
            }
        }
    }
    text = "${text}    return _r;\n}\n\n"
    // --- encode: struct -> JSON text ---
    text = "${text}static GrayString gray_json_encode_struct_${name}(GrayArena *arena, GrayStruct_${name} _s) {\n"
    mut fixed i64 = JSON_BRACES_LENGTH
    mut index i64 = 0
    for_each field in struct_members {
        mut key = field.name
        if field.json_tag != "" { key = field.json_tag }
        field_type = eff(generator, field.type_name)
        if index > 0 { fixed = fixed + JSON_SEPARATOR_LENGTH }
        fixed = fixed + JSON_KEY_DECORATION_LENGTH + len(key)
        is_number_enum = maps.contains_key(generator^.enums, field_type) && !is_string_enum(generator, field_type)
        if is_number_enum { fixed = fixed + MAX_NUMBER_TEXT_LENGTH } or field.type_name == "bool" { fixed = fixed + JSON_FALSE_LENGTH }
        index = index + 1
    }
    text = "${text}    size_t _need = ${fixed};\n"
    index = 0
    for_each field in struct_members {
        field_type = eff(generator, field.type_name)
        is_string_valued = field.type_name == "string" || (maps.contains_key(generator^.enums, field_type) && is_string_enum(generator, field_type))
        if is_string_valued {
            text = "${text}    _need += json_escaped_len(_s.${field.name});\n"
        } or json_field_is_composite(generator, field.type_name) {
            if is_array_type(field_type) {
                element_type = array_element_type(field_type)
                if maps.contains_key(generator^.structs, eff(generator, element_type)) {
                    text = "${text}    GrayString _nt${index} = gray_json_encode_struct_array_${eff(generator, element_type)}(arena, _s.${field.name});\n"
                } otherwise {
                    mut encode_function = "gray_json_encode_array_signed_integer"
                    if is_wide_name(element_type) { encode_function = "gray_json_encode_array_wide_integer" }
                    class = json_prim_class(element_type)
                    if class == "u" { encode_function = "gray_json_encode_array_unsigned_integer" }
                    if class == "f" { encode_function = "gray_json_encode_array_floating_point" }
                    if class == "b" { encode_function = "gray_json_encode_array_bool" }
                    if class == "S" { encode_function = "gray_json_encode_array_string" }
                    text = "${text}    GrayString _nt${index} = ${encode_function}(arena, &_s.${field.name});\n"
                }
            } otherwise {
                text = "${text}    GrayString _nt${index} = gray_json_encode_struct_${field_type}(arena, _s.${field.name});\n"
            }
            text = "${text}    _need += (size_t)_nt${index}.len;\n"
        } or json_is_number(field.type_name) {
            text = "${text}    GrayString _nt${index} = gray_json_number_text(arena, GRAY_ELEM_KIND_OF(${ctype(generator, field.type_name)}), &_s.${field.name});\n    _need += (size_t)_nt${index}.len;\n"
        }
        index = index + 1
    }
    text = "${text}    char *_buf = gray_arena_alloc(arena, _need + 1);\n    int _pos = 0;\n    _buf[_pos++] = '{';\n"
    index = 0
    for_each field in struct_members {
        mut key = field.name
        if field.json_tag != "" { key = field.json_tag }
        field_type = eff(generator, field.type_name)
        if index > 0 { text = "${text}    _buf[_pos++] = ','; _buf[_pos++] = ' ';\n" }
        text = "${text}    _buf[_pos++] = '\"';\n    memcpy(_buf + _pos, \"${json_key_text(key)}\", ${len(key)}); _pos += ${len(key)};\n    _buf[_pos++] = '\"'; _buf[_pos++] = ':'; _buf[_pos++] = ' ';\n"
        is_string_valued = field.type_name == "string" || (maps.contains_key(generator^.enums, field_type) && is_string_enum(generator, field_type))
        is_number_enum = maps.contains_key(generator^.enums, field_type) && !is_string_enum(generator, field_type)
        if is_string_valued {
            text = "${text}    json_append_escaped(_buf, &_pos, _s.${field.name});\n"
        } or is_number_enum {
            text = "${text}    _pos += snprintf(_buf + _pos, _need + 1 - (size_t)_pos, \"%lld\", (long long)_s.${field.name});\n"
        } or json_is_number(field.type_name) || json_field_is_composite(generator, field.type_name) {
            text = "${text}    memcpy(_buf + _pos, _nt${index}.data, (size_t)_nt${index}.len); _pos += _nt${index}.len;\n"
        } or field.type_name == "bool" {
            text = "${text}    { const char *_bv = _s.${field.name} ? \"true\" : \"false\"; int _bl = _s.${field.name} ? 4 : 5;\n      memcpy(_buf + _pos, _bv, (size_t)_bl); _pos += _bl; }\n"
        }
        index = index + 1
    }
    text = "${text}    _buf[_pos++] = '}';\n    _buf[_pos] = '\\0';\n    return (GrayString){_buf, (int32_t)_pos};\n}\n\n"
    // --- parse array ---
    text = "${text}static GrayArray gray_json_parse_array_${name}(GrayArena *arena, GrayString text) {\n    gray_json_require_document(text, '[', \"${file}\", ${line});\n    GrayArray _elems = gray_json_split_array(arena, text);\n    GrayArray _result = GRAY_ARRAY_NEW_OF(arena, GrayStruct_${name}, _elems.len > 0 ? _elems.len : 4);\n    for (int32_t _i = 0; _i < _elems.len; _i++) {\n        GrayString _elem_str = *(GrayString *)((char *)_elems.data + (size_t)_i * (size_t)_elems.elem_size);\n        GrayStruct_${name} _item = gray_json_parse_${name}(arena, _elem_str);\n        gray_array_push(arena, &_result, &_item, __FILE__, __LINE__);\n    }\n    return _result;\n}\n\n"
    // --- encode array ---
    text = "${text}static GrayString gray_json_encode_struct_array_${name}(GrayArena *arena, GrayArray _arr) {\n    GrayString *_parts = (GrayString *)gray_arena_alloc(arena, sizeof(GrayString) * (size_t)(_arr.len > 0 ? _arr.len : 1));\n    size_t _need = 2;\n    for (int32_t _i = 0; _i < _arr.len; _i++) {\n        GrayStruct_${name} _item = *(GrayStruct_${name} *)((char *)_arr.data + (size_t)_i * (size_t)_arr.elem_size);\n        GrayString _js = gray_json_encode_struct_${name}(arena, _item);\n        _parts[_i] = _js;\n        _need += (size_t)_js.len;\n        if (_i > 0) _need += 2;\n    }\n    char *_buf = gray_arena_alloc(arena, _need + 1);\n    int _pos = 0;\n    _buf[_pos++] = '[';\n    for (int32_t _i = 0; _i < _arr.len; _i++) {\n        if (_i > 0) { _buf[_pos++] = ','; _buf[_pos++] = ' '; }\n        memcpy(_buf + _pos, _parts[_i].data, (size_t)_parts[_i].len); _pos += _parts[_i].len;\n    }\n    _buf[_pos++] = ']';\n    _buf[_pos] = '\\0';\n    return (GrayString){_buf, (int32_t)_pos};\n}\n\n"
    return text
}

// json.encode / json.parse / json.decode / json.pretty_print / json.is_valid calls.
fn gen_json_call(generator ^CodeGen, node ^ast.AstNode, function_name string) -> string {
    arguments = node^.call^.args
    if function_name == "encode" && len(arguments) >= 1 {
        argument_type = expr_type(generator, arguments[0])
        is_array = is_array_type(argument_type)
        mut struct_name = ""
        if is_array { struct_name = eff(generator, array_element_type(argument_type)) } or maps.contains_key(generator^.structs, argument_type) { struct_name = argument_type }
        if struct_name != "" && maps.contains_key(generator^.structs, struct_name) && generator^.structs[struct_name]^.struct_decl^.is_json {
            mut array_part = ""
            if is_array { array_part = "_array" }
            return "gray_json_encode_struct${array_part}_${struct_name}(gray_default_arena, ${gen_expr(generator, arguments[0])})"
        }
        if is_map_type(argument_type) {
            mut function = "gray_json_encode_map"
            class = json_prim_class(map_value_type(argument_type))
            if class == "s" { function = "gray_json_encode_map_signed_integer" }
            if class == "u" { function = "gray_json_encode_map_unsigned_integer" }
            if class == "f" { function = "gray_json_encode_map_floating_point" }
            if class == "b" { function = "gray_json_encode_map_bool" }
            return "({ GrayMap _jm = ${gen_expr(generator, arguments[0])}; ${function}(gray_default_arena, &_jm); })"
        }
        if is_array {
            mut function = "gray_json_encode_array_signed_integer"
            class = json_prim_class(array_element_type(argument_type))
            if class == "u" { function = "gray_json_encode_array_unsigned_integer" }
            if class == "f" { function = "gray_json_encode_array_floating_point" }
            if class == "b" { function = "gray_json_encode_array_bool" }
            if class == "S" { function = "gray_json_encode_array_string" }
            return "({ GrayArray _ja = ${gen_expr(generator, arguments[0])}; ${function}(gray_default_arena, &_ja); })"
        }
        if is_signed_int_name(argument_type) || argument_type == "char" {
            return "({ char _jbuf[32]; snprintf(_jbuf, sizeof(_jbuf), \"%\" PRId64, (int64_t)${gen_expr(generator, arguments[0])}); gray_string_new(gray_default_arena, _jbuf, (int32_t)strlen(_jbuf)); })"
        }
        if is_unsigned_int_name(argument_type) {
            return "({ char _jbuf[32]; snprintf(_jbuf, sizeof(_jbuf), \"%\" PRIu64, (uint64_t)${gen_expr(generator, arguments[0])}); gray_string_new(gray_default_arena, _jbuf, (int32_t)strlen(_jbuf)); })"
        }
        if is_float_name(argument_type) {
            mut c_float = "double"
            mut kind = "GRAY_ELEM_F64"
            if argument_type == "f32" {
                c_float = "float"
                kind = "GRAY_ELEM_F32"
            }
            return "({ ${c_float} _jv = ${gen_expr(generator, arguments[0])}; gray_json_number_text(gray_default_arena, ${kind}, &_jv); })"
        }
        if argument_type == "bool" { return "(${gen_expr(generator, arguments[0])} ? gray_string_lit(\"true\") : gray_string_lit(\"false\"))" }
        return "gray_json_encode_string(gray_default_arena, ${gen_expr(generator, arguments[0])})"
    }
    if function_name == "decode" && len(arguments) >= 1 {
        mut suffix = ""
        if strings.starts_with(generator^.current_variable, "_gray_tmp") || strings.starts_with(generator^.current_variable, "_gray_or") { suffix = "_result" }
        return "gray_json_decode${suffix}(gray_default_arena, ${gen_expr(generator, arguments[0])})"
    }
    if function_name == "parse" && len(arguments) >= 1 {
        result_type = expr_type(generator, node)
        mut parse_struct = ""
        mut parse_is_array = false
        if is_array_type(result_type) {
            parse_is_array = true
            parse_struct = eff(generator, array_element_type(result_type))
        } or maps.contains_key(generator^.structs, result_type) { parse_struct = result_type }
        if parse_struct != "" && maps.contains_key(generator^.structs, parse_struct) && generator^.structs[parse_struct]^.struct_decl^.is_json {
            mut parse_array_part = ""
            if parse_is_array { parse_array_part = "_array" }
            return "gray_json_parse${parse_array_part}_${parse_struct}(gray_default_arena, ${gen_expr(generator, arguments[0])})"
        }
        return "gray_json_decode(gray_default_arena, ${gen_expr(generator, arguments[0])})"
    }
    if function_name == "is_valid" && len(arguments) == 1 { return "gray_json_is_valid(${gen_expr(generator, arguments[0])})" }
    if function_name == "pretty_print" && len(arguments) == 2 { return "gray_json_pretty_map(gray_default_arena, ${address_of_arg(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
    return ""
}

// True when the place named by `target` is worked out by calling a function: `items[idx()].x`.
fn target_calls_function(target ^ast.AstNode) -> bool {
    if target == nil { return false }
    if target^.kind == ast.NodeKind.CALL_EXPR { return true }
    if target^.kind == ast.NodeKind.INDEX_EXPR { return target_calls_function(target^.index_data^.left) || target_calls_function(target^.index_data^.index_expr) }
    if target^.kind == ast.NodeKind.MEMBER_EXPR { return target_calls_function(target^.member^.object) }
    if target^.kind == ast.NodeKind.POSTFIX_EXPR { return target_calls_function(target^.postfix^.left) }
    return false
}

// True when evaluating `node` calls a function (so its order against other calls is visible).
// A value computed ahead of its use takes no type context from the slot it lands in, so literals that need one stay where they are.
fn expression_can_be_hoisted(node ^ast.AstNode) -> bool {
    return expression_calls_function(node) && node^.kind != ast.NodeKind.ARRAY_VALUE && node^.kind != ast.NodeKind.MAP_VALUE && node^.kind != ast.NodeKind.STRUCT_VALUE
}

fn expression_calls_function(node ^ast.AstNode) -> bool {
    if node == nil { return false }
    when node^.kind {
        is ast.NodeKind.CALL_EXPR { return true }
        is ast.NodeKind.INFIX_EXPR { return expression_calls_function(node^.infix^.left) || expression_calls_function(node^.infix^.right) }
        is ast.NodeKind.PREFIX_EXPR { return expression_calls_function(node^.prefix^.right) }
        is ast.NodeKind.POSTFIX_EXPR { return expression_calls_function(node^.postfix^.left) }
        is ast.NodeKind.INDEX_EXPR { return expression_calls_function(node^.index_data^.left) || expression_calls_function(node^.index_data^.index_expr) }
        is ast.NodeKind.MEMBER_EXPR { return expression_calls_function(node^.member^.object) }
        is ast.NodeKind.CAST_EXPR { return expression_calls_function(node^.cast_data^.value) }
        is ast.NodeKind.INTERPOLATED_STRING {
            for_each part in node^.interp_string^.parts {
                if expression_calls_function(part) { return true }
            }
            return false
        }
        default { return false }
    }
}

// The stdlib calls that are written out rather than taken from the table: the `net` family
// (a `_result` form when the call fills a multi-value temporary), `os`, `random`, `chars`,
// `time` and the server router builders. "" for any other call.
fn gen_more_module_call(generator ^CodeGen, node ^ast.AstNode, module_name string, function_name string) -> string {
    arguments = node^.call^.args
    is_result = strings.starts_with(generator^.current_variable, "_gray_tmp") || strings.starts_with(generator^.current_variable, "_gray_or")
    mut result_suffix = ""
    if is_result { result_suffix = "_result" }
    if module_name == "http" {
        mut body_methods = false
        if function_name == "post" || function_name == "put" || function_name == "patch" { body_methods = true }
        if body_methods || function_name == "get" || function_name == "delete" || function_name == "head" {
            // the headers argument is last and may be omitted
            mut headers_index i64 = 1
            if body_methods { headers_index = 2 }
            if len(arguments) == headers_index || len(arguments) == headers_index + 1 {
                mut http_pieces [string] = {gen_expr(generator, arguments[0])}
                if body_methods { arrays.append(http_pieces, gen_expr(generator, arguments[1])) }
                mut headers_text = "NULL"
                if len(arguments) > headers_index && !(arguments[headers_index]^.kind == ast.NodeKind.MAP_VALUE && len(arguments[headers_index]^.map_value^.keys) == 0) { headers_text = address_of_arg(generator, arguments[headers_index]) }
                arrays.append(http_pieces, headers_text)
                return "gray_http_${function_name}${result_suffix}(gray_default_arena, ${strings.join(http_pieces, ", ")})"
            }
        }
    }
    if module_name == "net" {
        if function_name == "connect" && len(arguments) == 2 { return "gray_net_dial${result_suffix}(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "send" && len(arguments) == 2 {
            if is_result { return "gray_net_send_result(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
            return "gray_net_send(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})"
        }
        if function_name == "receive" && len(arguments) == 2 { return "gray_net_recv${result_suffix}(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "receive_line" && len(arguments) == 2 { return "gray_net_receive_line_result(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "listen" && len(arguments) >= 1 {
            mut host = "gray_string_lit(\"0.0.0.0\")"
            if len(arguments) == 2 { host = gen_expr(generator, arguments[1]) }
            return "gray_net_listen${result_suffix}(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${host})"
        }
        if function_name == "accept" && len(arguments) == 1 { return "gray_net_accept${result_suffix}(gray_default_arena, ${gen_expr(generator, arguments[0])})" }
        if function_name == "resolve" && len(arguments) == 1 { return "gray_net_resolve${result_suffix}(gray_default_arena, ${gen_expr(generator, arguments[0])})" }
    }
    if module_name == "os" {
        if function_name == "executable_path" { return "gray_os_executable_path(gray_default_arena)" }
        if function_name == "find_executable" && len(arguments) == 1 { return "gray_os_find_executable(gray_default_arena, ${gen_expr(generator, arguments[0])})" }
        if function_name == "current_dir" { return "gray_os_cwd(gray_default_arena)" }
        if function_name == "cpu_usage" && len(arguments) == 1 { return "gray_os_cpu_usage(gray_default_arena, ${gen_expr(generator, arguments[0])})" }
        if function_name == "memory_usage" { return "gray_os_memory_usage(gray_default_arena)" }
        if function_name == "load_average" { return "gray_os_load_average(gray_default_arena)" }
        if function_name == "disk_usage" && len(arguments) == 1 { return "gray_os_disk_usage(gray_default_arena, ${gen_expr(generator, arguments[0])})" }
    }
    if module_name == "random" {
        if function_name == "rand_bool" { return "gray_random_bool()" }
        if function_name == "rand_u8" { return "gray_random_u8()" }
        if function_name == "rand_bytes" && len(arguments) == 1 { return "gray_random_bytes(gray_default_arena, ${gen_expr(generator, arguments[0])})" }
        if function_name == "rand_string" && len(arguments) == 2 { return "gray_random_string(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "rand_char" && len(arguments) == 0 { return "gray_random_char()" }
        if function_name == "rand_char" && len(arguments) == 2 { return "gray_random_char_range(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "rand_f64" && len(arguments) == 0 { return "gray_random_f64_unit()" }
        if function_name == "rand_f64" && len(arguments) == 2 { return "gray_random_f64_range(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "rand_i64" && len(arguments) == 2 { return "gray_random_i64_range(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "roll_dice" && len(arguments) == 2 { return "gray_random_roll_dice(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
    }
    if module_name == "chars" && len(arguments) == 1 && (function_name == "is_alnum" || function_name == "is_alpha" || function_name == "is_consonant" || function_name == "is_digit" || function_name == "is_lower" || function_name == "is_upper" || function_name == "is_vowel" || function_name == "is_whitespace" || function_name == "mirror") {
        return "gray_chars_${function_name}(${gen_expr(generator, arguments[0])})"
    }
    if module_name == "time" && len(arguments) == 1 && (function_name == "end_of_month" || function_name == "start_of_month") { return "gray_time_${function_name}(${gen_expr(generator, arguments[0])})" }
    if module_name == "time" && len(arguments) == 2 && (function_name == "add_minutes" || function_name == "add_months") { return "gray_time_${function_name}(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
    if module_name == "threads" && function_name == "get_id" { return "gray_threads_id()" }
    if module_name == "server" {
        if function_name == "add_router" { return "gray_server_router()" }
        if function_name == "add_route" && len(arguments) == 4 {
            return "gray_server_route(${address_of_arg(generator, arguments[0])}, ${gen_expr(generator, arguments[1])}, ${gen_expr(generator, arguments[2])}, (GrayHttpResponse (*)(GrayRequest))${gen_expr(generator, arguments[3])})"
        }
        if function_name == "listen" && len(arguments) == 2 { return "gray_server_listen(${gen_expr(generator, arguments[1])}, ${address_of_arg(generator, arguments[0])})" }
        if function_name == "listen" && len(arguments) == 3 { return "gray_server_listen_host(${gen_expr(generator, arguments[1])}, ${gen_expr(generator, arguments[2])}, ${address_of_arg(generator, arguments[0])})" }
        if function_name == "cors" && len(arguments) == 2 { return "gray_server_cors(${address_of_arg(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})" }
        if function_name == "add_middleware" && len(arguments) == 2 { return "gray_server_add_middleware(${address_of_arg(generator, arguments[0])}, (GrayMiddleware)${gen_expr(generator, arguments[1])})" }
        if len(arguments) == 2 && (function_name == "text" || function_name == "json" || function_name == "html" || function_name == "redirect") {
            return "gray_server_${function_name}(gray_default_arena, ${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])})"
        }
    }
    return ""
}

// mem.alloc(arena, value): the value is built in the arena and boxed, so the
// call is a `^T` for every T.
fn gen_mem_alloc(generator ^CodeGen, arena_argument ^ast.AstNode, value_argument ^ast.AstNode) -> string {
    id = next_id(generator)
    value_type = expr_type(generator, value_argument)
    mut c_value_type = "__auto_type"
    if value_type != "" && value_type != "unknown" { c_value_type = ctype(generator, value_type) }
    if value_argument^.kind == ast.NodeKind.ARRAY_VALUE { c_value_type = "GrayArray" }
    mut deep_copied = false
    if value_type != "" && value_type != "unknown" && value_type != "string" {
        mut copied_name = value_type
        if value_argument^.kind == ast.NodeKind.ARRAY_VALUE && is_array_type(value_type) { copied_name = array_element_type(value_type) }
        deep_copied = needs_copy_walk(generator, copied_name, true)
    }
    mut built = ""
    if value_type == "string" {
        built = "({ GrayString _s${id} = ${gen_expr(generator, value_argument)}; gray_string_new(_aa${id}, _s${id}.data, _s${id}.len); })"
    } or deep_copied {
        built = "({ ${c_value_type} _src${id} = ${gen_expr(generator, value_argument)}; GrayArena *_cs${id} = gray_default_arena; gray_default_arena = _aa${id}; ${c_value_type} _cd${id} = ${value_deep_copy(generator, value_type, "_src${id}")}; gray_default_arena = _cs${id}; _cd${id}; })"
    } or value_argument^.kind == ast.NodeKind.ARRAY_VALUE {
        elements = value_argument^.array_value^.elements
        mut element_c = "int64_t"
        if len(elements) > 0 {
            element_type = expr_type(generator, elements[0])
            if element_type == "f64" || element_type == "f32" { element_c = "double" }
            if element_type == "string" { element_c = "GrayString" }
            if element_type == "bool" { element_c = "bool" }
        }
        mut pieces [string] = {}
        for_each element in elements { arrays.append(pieces, gen_expr(generator, element)) }
        built = "gray_array_from(_aa${id}, (${element_c}[${len(elements)}]){${strings.join(pieces, ", ")}}, sizeof(${element_c}), ${len(elements)}, GRAY_ELEM_KIND_OF(${element_c}))"
    } otherwise {
        built = gen_expr(generator, value_argument)
    }
    return "({ GrayArena *_aa${id} = gray_mem_live(${gen_expr(generator, arena_argument)}, \"alloc\"); ${c_value_type} _av${id} = ${built}; __typeof__(_av${id}) *_ap${id} = (__typeof__(_av${id}) *)gray_arena_alloc(_aa${id}, sizeof(_av${id})); *_ap${id} = _av${id}; _ap${id}; })"
}

// The C name of a file-scope variable declaration.
fn global_c_name(generator ^CodeGen, name string) -> string {
    if arrays.contains(generator^.entry_globals, name) { return "gray_g_${name}" }
    return name
}

// The C type a map key or value is stored as: a plain enum is an 8-byte slot there
// (4 bytes as an array element), as the runtime's counts and key tables assume.
fn map_slot_c(generator ^CodeGen, written_type string) -> string {
    type_name = eff(generator, written_type)
    if is_string_enum(generator, type_name) { return "GrayString" }
    if maps.contains_key(generator^.enums, type_name) && !is_tagged_enum(generator, type_name) && !is_string_enum(generator, type_name) && type_name != "ErrorCode" { return "int64_t" }
    return ctype(generator, type_name)
}

// An integer literal, or arithmetic on integer literals only.
fn is_integer_literal_expression(node ^ast.AstNode) -> bool {
    if node^.kind == ast.NodeKind.INT_VALUE { return true }
    if node^.kind == ast.NodeKind.PREFIX_EXPR { return is_integer_literal_expression(node^.prefix^.right) }
    if node^.kind == ast.NodeKind.INFIX_EXPR { return is_integer_literal_expression(node^.infix^.left) && is_integer_literal_expression(node^.infix^.right) }
    return false
}

// The declared function a `ref()` argument names (`f`, or `Type.f` for a struct function), or "".
fn referenced_function_name(generator ^CodeGen, place ^ast.AstNode) -> string {
    if place^.kind == ast.NodeKind.LABEL && maps.contains_key(generator^.funcs, place^.label^.value) { return place^.label^.value }
    if place^.kind == ast.NodeKind.MEMBER_EXPR && place^.member^.object^.kind == ast.NodeKind.LABEL {
        qualified = "${resolve_alias(generator, place^.member^.object^.label^.value)}_${place^.member^.member}"
        if maps.contains_key(generator^.funcs, qualified) { return qualified }
    }
    return ""
}

// True for `p^.items` / `p.items` / `p^`: a place reached through a pointer, whose pointee
// may be a new() object.
fn place_reached_through_pointer(generator ^CodeGen, place ^ast.AstNode) -> bool {
    mut pointer ^ast.AstNode = nil
    if place^.kind == ast.NodeKind.MEMBER_EXPR {
        pointer = place^.member^.object
        if pointer^.kind == ast.NodeKind.POSTFIX_EXPR && pointer^.postfix^.op == token.TokenKind.CARET { pointer = pointer^.postfix^.left }
    } or place^.kind == ast.NodeKind.POSTFIX_EXPR && place^.postfix^.op == token.TokenKind.CARET {
        pointer = place^.postfix^.left
    }
    if pointer == nil { return false }
    if pointer^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, pointer^.label^.value) { return false }
    return strings.starts_with(expr_type(generator, pointer), "^")
}

// --- Heap arena rules ---
//
// A function with no `&` or `^T` parameter runs in an arena of its own that its return
// destroys. Whatever it stores where a longer-lived owner reaches it — through a pointer, into a
// new() object, into a module-level variable — is allocated in the heap arena instead.

// The variable a place expression is rooted at, field and index chains stripped away.
fn place_root(place ^ast.AstNode) -> ^ast.AstNode {
    mut current = place
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            current = current^.index_data^.left
        } otherwise {
            return current
        }
    }
    return current
}

// True when `place` lies inside a module-level variable that holds allocated storage (a
// string, array, map or struct): whatever is stored into one must outlive every function.
fn place_is_module_storage(generator ^CodeGen, place ^ast.AstNode) -> bool {
    root = place_root(place)
    if root == nil || root^.kind != ast.NodeKind.LABEL || !root^.label^.is_file_global_reference { return false }
    root_type = eff(generator, expr_type(generator, root))
    return root_type == "string" || is_array_type(root_type) || is_map_type(root_type) || maps.contains_key(generator^.structs, root_type) || is_handle_type(root_type) || root_type == "UUID" || root_type == "ExecResult"
}

// True when a statement stores into module-level storage: it assigns to a place inside one,
// or passes one to a call that may mutate it.
fn statement_stores_into_module_storage(generator ^CodeGen, statement ^ast.AstNode) -> bool {
    if statement^.kind == ast.NodeKind.ASSIGN_STMT { return place_is_module_storage(generator, statement^.assign^.target) }
    if statement^.kind == ast.NodeKind.EXPR_STMT && statement^.expr_stmt^.expr != nil && statement^.expr_stmt^.expr^.kind == ast.NodeKind.CALL_EXPR {
        for_each call_argument in statement^.expr_stmt^.expr^.call^.args {
            if place_is_module_storage(generator, call_argument) { return true }
        }
    }
    return false
}

// An assignment or expression statement. A store into module-level storage runs in the heap
// arena, which no return rewinds, so the copied key, the grown backing store and the stored
// element all survive. The heap arena is null on a spawned thread, which keeps its own.
fn gen_module_aware(generator ^CodeGen, node ^ast.AstNode) {
    to_module = statement_stores_into_module_storage(generator, node)
    if to_module {
        emit_line(generator, "{ GrayArena *_gray_gsave = gray_default_arena; if (gray_heap_arena) gray_default_arena = gray_heap_arena;")
        generator^.indent = generator^.indent + 1
        if node^.kind == ast.NodeKind.ASSIGN_STMT && node^.assign^.op == token.TokenKind.ASSIGN && node^.assign^.value != nil && (node^.assign^.value^.kind == ast.NodeKind.LABEL || node^.assign^.value^.kind == ast.NodeKind.MEMBER_EXPR || node^.assign^.value^.kind == ast.NodeKind.INDEX_EXPR) && expr_type(generator, node^.assign^.value) == "string" {
            generator^.module_store_value = node^.assign^.value
        }
    }
    generator^.is_module_store = to_module
    if node^.kind == ast.NodeKind.ASSIGN_STMT {
        gen_assign(generator, node)
    } otherwise {
        emit_line(generator, "${gen_expr(generator, node^.expr_stmt^.expr)};")
    }
    generator^.is_module_store = false
    generator^.module_store_value = nil
    if to_module {
        generator^.indent = generator^.indent - 1
        emit_line(generator, "gray_default_arena = _gray_gsave; }")
    }
}

// Is the array argument a container reached through a pointer (`p^.items`, `p^`)? The pointee
// may be a new() object in the heap arena, so growth and copied values must be allocated there,
// not in the function's own arena.
fn array_argument_in_heap(generator ^CodeGen, array_argument ^ast.AstNode) -> bool {
    if place_is_module_storage(generator, array_argument) { return true }
    if array_argument^.kind == ast.NodeKind.LABEL { return generator^.elided_array != "" && generator^.elided_array == array_argument^.label^.value }
    return place_reached_through_pointer(generator, array_argument)
}

// The C type an array function stages a value in, from the value's type.
fn array_value_c_type(generator ^CodeGen, value_type string) -> string {
    if value_type == "" || value_type == "unknown" { return "__auto_type" }
    if is_array_type(value_type) { return "GrayArray" }
    if is_map_type(value_type) { return "GrayMap" }
    if strings.starts_with(value_type, "func") { return "void *" }
    return ctype(generator, value_type)
}

// The statements that copy a staged value into `arena`: not needed for a value that is built fresh
// at the top level of a function, whose target lives in the same arena.
fn staged_escape(generator ^CodeGen, value ^ast.AstNode, element_type string, temporary_name string, arena string, target_in_heap bool) -> string {
    aliases = names_existing_storage(value) && needs_copy_walk(generator, element_type, false)
    if !target_in_heap && generator^.loop_scope_depth == 0 && !aliases { return "" }
    return staged_value_copy(generator, element_type, temporary_name, arena)
}

// The arena an array function allocates its growth and the values it stores in.
fn array_call_arena(generator ^CodeGen, array_argument ^ast.AstNode) -> string {
    if array_argument_in_heap(generator, array_argument) { return "gray_heap_arena" }
    if generator^.loop_scope_depth > 0 { return "_gray_outer_arena" }
    return "gray_default_arena"
}

// The array functions that stage a value in a temporary before the call: remove, contains,
// index_of, count and binary_search keep the value in `_avN`; insert_at, prepend and fill hold
// it, copy it into the arena the array lives in, and then call.
fn gen_arrays_staged_call(generator ^CodeGen, node ^ast.AstNode, function_name string) -> string {
    arguments = node^.call^.args
    if len(arguments) < 2 || !is_array_type(expr_type(generator, arguments[0])) { return "" }
    element = array_element_type(expr_type(generator, arguments[0]))
    if len(arguments) == 2 && arrays.contains({"remove", "contains", "index_of", "count", "binary_search"}, function_name) {
        mut staged_c = "int64_t"
        if element != "" { staged_c = ctype(generator, element) }
        id = next_id(generator)
        mut value_text = gen_expr(generator, arguments[1])
        if is_wide_name(element) { value_text = gen_coerced(generator, element, arguments[1]) }
        return "({ ${staged_c} _av${id} = ${value_text}; gray_arrays_${function_name}(${address_of_arg(generator, arguments[0])}, &_av${id}); })"
    }
    in_heap = array_argument_in_heap(generator, arguments[0])
    arena = array_call_arena(generator, arguments[0])
    if function_name == "insert_at" && len(arguments) == 3 {
        insert_value_type = expr_type(generator, arguments[2])
        mut staged_c = array_value_c_type(generator, insert_value_type)
        if element == "f32" { staged_c = "float" }
        index_text = gen_expr(generator, arguments[1])
        value_text = gen_expr(generator, arguments[2])
        escape = staged_escape(generator, arguments[2], element, "_iv", arena, in_heap)
        return "{ __auto_type _ii = ${index_text}; ${staged_c} _iv = ${value_text}; ${escape}gray_arrays_insert_at(${arena}, ${address_of_arg(generator, arguments[0])}, _ii, &_iv); }"
    }
    if function_name == "prepend" && len(arguments) == 2 {
        mut staged_c = "int64_t"
        if element != "" { staged_c = ctype(generator, element) }
        if element == "f32" { staged_c = "float" }
        value_text = gen_expr(generator, arguments[1])
        escape = staged_escape(generator, arguments[1], element, "_pv", arena, in_heap)
        return "{ ${staged_c} _pv = ${value_text}; ${escape}gray_arrays_prepend(${arena}, ${address_of_arg(generator, arguments[0])}, &_pv); }"
    }
    if function_name == "fill" && len(arguments) == 3 {
        mut staged_c = "int64_t"
        if element != "" { staged_c = ctype(generator, element) }
        mut value_text = gen_expr(generator, arguments[1])
        if is_wide_name(element) { value_text = gen_coerced(generator, element, arguments[1]) }
        escape = staged_escape(generator, arguments[1], element, "_fv", arena, in_heap)
        target_address = address_of_arg(generator, arguments[0])
        count_text = gen_expr(generator, arguments[2])
        mut copies = ""
        if element != "" && type_shares_storage(generator, element) {
            copies = "; { GrayArena *_fs = gray_default_arena; gray_default_arena = ${arena}; for (int32_t _fi = 0; _fi < _fa->len; _fi++) { ((${staged_c} *)_fa->data)[_fi] = ${value_deep_copy(generator, element, "_fv")}; } gray_default_arena = _fs; }"
        }
        return "{ ${staged_c} _fv = ${value_text}; ${escape}GrayArray *_fa = ${target_address}; gray_arrays_fill(${arena}, _fa, &_fv, ${count_text})${copies}; }"
    }
    return ""
}

fn growth_arena(generator ^CodeGen, array_argument ^ast.AstNode) -> string {
    if array_argument_in_heap(generator, array_argument) { return "gray_heap_arena" }
    if generator^.loop_scope_depth > 0 && !generator^.is_module_store { return "_gray_outer_arena" }
    return "gray_default_arena"
}

// A value staged in the temporary `temporary_name` for a container reached through a pointer is
// copied into the heap arena: a string by a plain copy, an array, map or struct by a deep copy.
fn staged_value_escape(generator ^CodeGen, element_type string, temporary_name string, arena string, array_argument ^ast.AstNode) -> string {
    if arena == "gray_default_arena" { return "" }
    return staged_value_copy(generator, element_type, temporary_name, arena)
}

// The statements that copy a staged value into `arena`.
fn staged_value_copy(generator ^CodeGen, element_type string, temporary_name string, arena string) -> string {
    if eff(generator, element_type) == "string" {
        return "${temporary_name} = gray_string_new(${arena}, ${temporary_name}.data, ${temporary_name}.len); "
    }
    if element_type != "" && needs_copy_walk(generator, element_type, true) {
        return "{ GrayArena *_esc = gray_default_arena; gray_default_arena = ${arena}; ${temporary_name} = ${value_deep_copy(generator, element_type, temporary_name)}; gray_default_arena = _esc; } "
    }
    return ""
}

// insert_at, prepend and fill on an array reached through a pointer: the growth and the
// stored value are allocated in the heap arena.
fn gen_heap_array_call(generator ^CodeGen, node ^ast.AstNode, function_name string) -> string {
    arguments = node^.call^.args
    element = array_element_type(expr_type(generator, arguments[0]))
    element_c = ctype(generator, element)
    arena = growth_arena(generator, arguments[0])
    if function_name == "insert_at" {
        escape = staged_value_escape(generator, element, "_iv", arena, arguments[0])
        return "({ __auto_type _ii = ${gen_expr(generator, arguments[1])}; ${element_c} _iv = ${gen_stored(generator, element, arguments[2])}; ${escape}gray_arrays_insert_at(${arena}, ${address_of_arg(generator, arguments[0])}, _ii, &_iv); })"
    }
    if function_name == "prepend" {
        escape = staged_value_escape(generator, element, "_pv", arena, arguments[0])
        return "({ ${element_c} _pv = ${gen_stored(generator, element, arguments[1])}; ${escape}gray_arrays_prepend(${arena}, ${address_of_arg(generator, arguments[0])}, &_pv); })"
    }
    escape = staged_value_escape(generator, element, "_fv", arena, arguments[0])
    mut per_slot_copy = ""
    if element != "" && type_shares_storage(generator, element) {
        // every filled slot needs its own copy of the value, or the slots and the source would share one backing store
        per_slot_copy = " { GrayArena *_fs = gray_default_arena; gray_default_arena = ${arena}; for (int32_t _fi = 0; _fi < _fa->len; _fi++) { ((${element_c} *)_fa->data)[_fi] = ${value_deep_copy(generator, element, "_fv")}; } gray_default_arena = _fs; }"
    }
    return "({ ${element_c} _fv = ${gen_expr(generator, arguments[1])}; ${escape}GrayArray *_fa = ${address_of_arg(generator, arguments[0])}; gray_arrays_fill(${arena}, _fa, &_fv, ${gen_expr(generator, arguments[2])});${per_slot_copy} (void)0; })"
}

// True when `target` is stored through a pointer: `p^`, `p^.field`, or `p.field` with `p` a
// pointer (not a ref variable), at any depth of a member chain.
fn target_stored_through_pointer(generator ^CodeGen, target ^ast.AstNode) -> bool {
    if target^.kind == ast.NodeKind.POSTFIX_EXPR { return target^.postfix^.op == token.TokenKind.CARET }
    mut current = target
    as_long_as current != nil && current^.kind == ast.NodeKind.MEMBER_EXPR {
        member_object = current^.member^.object
        if member_object^.kind == ast.NodeKind.POSTFIX_EXPR && member_object^.postfix^.op == token.TokenKind.CARET { return true }
        is_reference = member_object^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, member_object^.label^.value)
        if !is_reference && strings.starts_with(expr_type(generator, member_object), "^") { return true }
        current = member_object
    }
    return false
}

// A value stored through a pointer: the pointee may live in the heap arena, which outlives every
// scope, so a string, array, map or struct with embedded storage is copied there.
fn store_value_in_arena(generator ^CodeGen, target_type string, node ^ast.AstNode, stored_text string, arena string) -> string {
    if !needs_copy_walk(generator, target_type, true) { return stored_text }
    if node^.kind == ast.NodeKind.LABEL && array_argument_in_heap(generator, node) {
        generator^.elided_array = ""
        return gen_coerced(generator, target_type, node)
    }
    return copy_into_arena(generator, target_type, gen_coerced(generator, target_type, node), arena)
}

// The value text copied into `arena` when the type holds storage a plain C copy would share.
fn copy_into_arena(generator ^CodeGen, type_text string, value_text string, arena string) -> string {
    if !needs_copy_walk(generator, type_text, true) { return value_text }
    id = next_id(generator)
    copied_c_type = ctype(generator, type_text)
    return "({ ${copied_c_type} _cv${id} = ${value_text}; GrayArena *_ca${id} = gray_default_arena; gray_default_arena = ${arena}; ${copied_c_type} _cd${id} = ${value_deep_copy(generator, type_text, "_cv${id}")}; gray_default_arena = _ca${id}; _cd${id}; })"
}

// Where a value stored into `target` must live: the heap arena behind a pointer, the outer arena
// from inside a scoped one, "" when the current arena will do.
fn value_store_arena(generator ^CodeGen, target ^ast.AstNode) -> string {
    if target_stored_through_pointer(generator, target) { return "gray_heap_arena" }
    if generator^.loop_scope_depth > 0 && !generator^.is_module_store { return "_gray_outer_arena" }
    return ""
}

// The arena a map entry stored through a heap pointer variable lives in.
fn map_store_escape(generator ^CodeGen, slot_type string, temporary_name string) -> string {
    if eff(generator, slot_type) == "string" { return "${temporary_name} = gray_string_new(gray_heap_arena, ${temporary_name}.data, ${temporary_name}.len); " }
    if slot_type != "" && needs_copy_walk(generator, slot_type, true) {
        return "{ GrayArena *_esc = gray_default_arena; gray_default_arena = gray_heap_arena; ${temporary_name} = ${value_deep_copy(generator, slot_type, temporary_name)}; gray_default_arena = _esc; } "
    }
    return ""
}

// True when a variable was last assigned the result of new().
fn is_heap_variable(generator ^CodeGen, name string) -> bool {
    return arrays.contains(generator^.heap_variables, name)
}

// Tracks `p = new(T)`: any other declaration or assignment of `p` clears it.
fn track_heap_variable(generator ^CodeGen, name string, value ^ast.AstNode) {
    if value != nil && value^.kind == ast.NodeKind.NEW_EXPR {
        if !is_heap_variable(generator, name) { arrays.append(generator^.heap_variables, name) }
    } or is_heap_variable(generator, name) {
        mut kept [string] = {}
        for_each heap_name in generator^.heap_variables {
            if heap_name != name { arrays.append(kept, heap_name) }
        }
        generator^.heap_variables = kept
    }
}

// The arena a `+=` on a string builds its result in: the heap arena when the target is reached
// through a pointer.
fn string_append_arena(generator ^CodeGen, target ^ast.AstNode) -> string {
    if target_stored_through_pointer(generator, target) { return "gray_heap_arena" }
    if generator^.loop_scope_depth > 0 && !generator^.is_module_store { return "_gray_outer_arena" }
    return "gray_default_arena"
}

// True when the map being stored into is a field of a variable assigned the result of new(): the
// map lives in the heap arena, so the key, the value and the map's growth are allocated there too.
fn map_stored_in_heap_variable(generator ^CodeGen, map_place ^ast.AstNode) -> bool {
    if map_place^.kind != ast.NodeKind.MEMBER_EXPR { return false }
    mut pointer_object ^ast.AstNode = nil
    member_object = map_place^.member^.object
    if strings.starts_with(expr_type(generator, member_object), "^") {
        pointer_object = member_object
    } or member_object^.kind == ast.NodeKind.POSTFIX_EXPR && member_object^.postfix^.op == token.TokenKind.CARET {
        pointer_object = member_object^.postfix^.left
    }
    return pointer_object != nil && pointer_object^.kind == ast.NodeKind.LABEL && is_heap_variable(generator, pointer_object^.label^.value)
}

// A tagged enum copied: switch on the tag and copy the payloads of the live variant that hold
// arena-backed data.
fn enum_deep_copy(generator ^CodeGen, type_name string, source string) -> string {
    if arrays.contains(generator^.copy_walk, type_name) { return source }
    arrays.append(generator^.copy_walk, type_name)
    id = next_id(generator)
    c_enum = ctype(generator, type_name)
    mut text = "({ ${c_enum} _es${id} = ${source}; ${c_enum} _ed${id} = _es${id}; switch (_es${id}.tag) { "
    for_each variant in generator^.enums[type_name]^.enum_decl^.values {
        mut variant_needs_copy = false
        for_each payload_type in variant.payload_types {
            if needs_copy_walk(generator, payload_type, true) { variant_needs_copy = true }
        }
        if !variant_needs_copy { continue }
        text = "${text}case ${c_enum}_TAG_${variant.name}: "
        for payload_index in range(0, len(variant.payload_types)) {
            if !needs_copy_walk(generator, variant.payload_types[payload_index], true) { continue }
            text = "${text}_ed${id}.data.${variant.name}._${payload_index} = ${value_deep_copy(generator, variant.payload_types[payload_index], "_es${id}.data.${variant.name}._${payload_index}")}; "
        }
        text = "${text}break; "
    }
    _ = arrays.remove_last(generator^.copy_walk)
    return "${text}default: break; } _ed${id}; })"
}

// The stdlib HttpResponse has no declaration to walk, but it holds a string and a map, so a copy
// that leaves its function's arena has to take both along.
fn http_response_deep_copy(generator ^CodeGen, source string) -> string {
    id = next_id(generator)
    return "({ GrayHttpResponse _ss${id} = ${source}; GrayHttpResponse _sd${id} = _ss${id}; _sd${id}.body = ${value_deep_copy(generator, "string", "_ss${id}.body")}; _sd${id}.headers = ${value_deep_copy(generator, "map[string:string]", "_ss${id}.headers")}; _sd${id}; })"
}

// --- Scoped arenas for loop bodies and branches ---
//
// A loop body or an `if` that allocates runs in a scratch arena that is reset on each iteration
// or freed with the branch. A function that runs in its caller's arena opens none of these.
// What a body stores where it outlives the scope is allocated in `_gray_outer_arena`, the arena
// that was current when the outermost scope opened.

fn current_function_uses_caller_arena(generator ^CodeGen) -> bool {
    return generator^.current_function != nil && function_uses_caller_arena(generator, generator^.current_function)
}

// Wraps a loop in its own C block so its arena locals are scoped to it.
fn loop_arena_prologue(generator ^CodeGen, no_arena bool) {
    if no_arena || current_function_uses_caller_arena(generator) { return }
    depth = generator^.loop_scope_depth
    emit_line(generator, "{")
    generator^.indent = generator^.indent + 1
    if depth == 0 { emit_line(generator, "GrayArena *_gray_outer_arena = gray_default_arena;") }
    emit_line(generator, "GrayArena *_iter_arena_${depth} = gray_capped_arena_create(16384);")
    emit_line(generator, "GrayArena *_saved_arena_${depth} = gray_default_arena;")
}

fn loop_arena_epilogue(generator ^CodeGen, no_arena bool) {
    if no_arena || current_function_uses_caller_arena(generator) { return }
    depth = generator^.loop_scope_depth
    emit_line(generator, "gray_arena_destroy(_iter_arena_${depth}, __FILE__, __LINE__); free(_iter_arena_${depth});")
    generator^.indent = generator^.indent - 1
    emit_line(generator, "}")
}

fn scope_arena_push(generator ^CodeGen, arena_variable string, saved_variable string) {
    arrays.append(generator^.scope_arena_variables, arena_variable)
    arrays.append(generator^.scope_arena_saved, saved_variable)
}

fn scope_arena_pop(generator ^CodeGen) {
    _ = arrays.remove_last(generator^.scope_arena_variables)
    _ = arrays.remove_last(generator^.scope_arena_saved)
}

// Every scratch arena live at an early exit, innermost first: the current arena goes back to
// what it was and the scratch one is freed.
fn scope_arena_unwind(generator ^CodeGen) -> string {
    mut text = ""
    mut position i64 = len(generator^.scope_arena_variables) - 1
    as_long_as position >= 0 {
        text = "${text}gray_default_arena = ${generator^.scope_arena_saved[position]}; gray_arena_destroy(${generator^.scope_arena_variables[position]}, __FILE__, __LINE__); free(${generator^.scope_arena_variables[position]}); "
        position = position - 1
    }
    return text
}

// Break and continue leave the innermost loop only: restore its arena pointer, but never touch
// the arenas of the loops around it. An `if` inside the loop opened a private arena that goes.
fn loop_exit_unwind(generator ^CodeGen) -> string {
    if generator^.is_in_no_arena_loop { return "" }
    mut text = ""
    mut position i64 = len(generator^.scope_arena_variables) - 1
    as_long_as position >= 0 {
        text = "${text}gray_default_arena = ${generator^.scope_arena_saved[position]}; "
        // the iteration arena is hoisted out of the loop: the next iteration's reset and the
        // destroy after the loop own its lifetime
        if strings.starts_with(generator^.scope_arena_variables[position], "_iter_arena_") { break }
        text = "${text}gray_arena_destroy(${generator^.scope_arena_variables[position]}, __FILE__, __LINE__); free(${generator^.scope_arena_variables[position]}); "
        position = position - 1
    }
    return text
}

// A labeled break or continue leaves every loop inside the target: the scratch arenas opened
// since the target's body began go, except the target's own iteration arena.
fn labeled_exit_unwind(generator ^CodeGen, target LabeledLoop) -> string {
    mut text = ""
    mut position i64 = len(generator^.scope_arena_variables) - 1
    as_long_as position >= target.arena_floor {
        text = "${text}gray_default_arena = ${generator^.scope_arena_saved[position]}; "
        if target.has_iteration_arena && position == target.arena_floor { break }
        text = "${text}gray_arena_destroy(${generator^.scope_arena_variables[position]}, __FILE__, __LINE__); free(${generator^.scope_arena_variables[position]}); "
        position = position - 1
    }
    return text
}

// One loop body: the frame a labeled `break` / `continue` finds, then either the body as is
// (an allocation-free loop, or a function in its caller's arena) or a reset of the iteration
// arena around it.
fn gen_loop_body(generator ^CodeGen, node ^ast.AstNode, body ^ast.AstNode, no_arena bool) {
    saved_raw_names = generator^.raw_names
    gen_loop_body_inner(generator, node, body, no_arena)
    generator^.raw_names = saved_raw_names
}

fn gen_loop_body_inner(generator ^CodeGen, node ^ast.AstNode, body ^ast.AstNode, no_arena bool) {
    has_arena = !(no_arena || current_function_uses_caller_arena(generator))
    begin_loop(generator, node, has_arena)
    if !has_arena {
        was_in_no_arena_loop = generator^.is_in_no_arena_loop
        generator^.is_in_no_arena_loop = true
        gen_block_body(generator, body)
        emit_continue_target(generator, node)
        generator^.is_in_no_arena_loop = was_in_no_arena_loop
        return
    }
    depth = generator^.loop_scope_depth
    emit_line(generator, "gray_arena_reset(_iter_arena_${depth}); gray_default_arena = _iter_arena_${depth};")
    generator^.loop_scope_depth = generator^.loop_scope_depth + 1
    scope_arena_push(generator, "_iter_arena_${depth}", "_saved_arena_${depth}")
    gen_block_body(generator, body)
    emit_continue_target(generator, node)
    generator^.loop_scope_depth = generator^.loop_scope_depth - 1
    scope_arena_pop(generator)
    emit_line(generator, "gray_default_arena = _saved_arena_${depth};")
}

// A call to a function that runs in its caller's arena, made inside a loop body or branch: the
// callee can store what it allocates (or a by-value argument) through a `&` or `^T` parameter, so
// it runs in the outer arena rather than the scratch one that is reset next pass, and an argument
// with embedded storage is copied there first.
fn gen_declared_call_scoped(generator ^CodeGen, node ^ast.AstNode, name string, arguments [^ast.AstNode]) -> string {
    callee = generator^.funcs[name]
    if generator^.loop_scope_depth == 0 || !function_uses_caller_arena(generator, callee) { return gen_declared_call(generator, node, name, arguments) }
    id = next_id(generator)
    declared_params = callee^.func_decl^.params
    mut prefix = ""
    mut rewritten_args [^ast.AstNode] = {}
    for slot in range(0, len(arguments)) {
        argument = arguments[slot]
        arrays.append(rewritten_args, argument)
        if slot >= len(declared_params) || declared_params[slot].is_mutable { continue }
        argument_type = expr_type(generator, argument)
        if argument_type == "" || argument_type == "unknown" || !needs_copy_walk(generator, argument_type, true) { continue }
        copy_c = ctype(generator, argument_type)
        argument_id = next_id(generator)
        source_name = "_gray_as${argument_id}"
        copy_name = "_gray_ac${argument_id}"
        prefix = "${prefix}${copy_c} ${source_name} = ${gen_expr(generator, argument)}; ${copy_c} ${copy_name} = ${value_deep_copy(generator, argument_type, source_name)}; "
        copy_label = ast.ast_alloc(ast.NodeKind.LABEL, argument^.tok)
        copy_label_data = new(ast.LabelData)
        copy_label_data^.value = copy_name
        copy_label^.label = copy_label_data
        copy_label^.resolved_type = argument^.resolved_type
        rewritten_args[slot] = copy_label
    }
    original_args = node^.call^.args
    node^.call^.args = rewritten_args
    call_text = gen_declared_call(generator, node, name, rewritten_args)
    node^.call^.args = original_args
    if len(callee^.func_decl^.return_types) == 0 {
        return "({ GrayArena *_gray_csave${id} = gray_default_arena; gray_default_arena = _gray_outer_arena; ${prefix}${call_text}; gray_default_arena = _gray_csave${id}; })"
    }
    return "({ GrayArena *_gray_csave${id} = gray_default_arena; gray_default_arena = _gray_outer_arena; ${prefix}__auto_type _gray_cval${id} = ${call_text}; gray_default_arena = _gray_csave${id}; _gray_cval${id}; })"
}

// The upper bound of the sized integer an array cast narrows to ("" when the cast needs no range check).
fn array_narrowing_maximum(target_element string, source_element string) -> string {
    if target_element == "char" && source_element != "char" { return "1114111" }
    _, sized_maximum = sized_bounds(target_element)
    return sized_maximum
}

// A C interop value stored into a sized integer, char, i64 or u64 slot: its sign is unseen, so the
// C type decides and a value out of the slot's range panics. "" for any other target.
fn narrow_c_value(generator ^CodeGen, target string, node ^ast.AstNode) -> string {
    line = node^.tok.line
    value = gen_expr(generator, node)
    if target == "u64" { return c_value_as(generator, value, true, line) }
    if target == "i64" { return c_value_as(generator, value, false, line) }
    sized_minimum, sized_maximum = sized_bounds(target)
    mut is_unsigned = is_unsigned_int_name(target)
    if target == "char" {
        sized_maximum = "1114111"
        is_unsigned = true
    }
    if sized_maximum == "" { return "" }
    if is_unsigned { return "((${ctype(generator, target)})gray_ucast_check(${c_value_as(generator, value, true, line)}, ${cast_bounds_arguments(generator, sized_minimum, sized_maximum, true, target, line)}))" }
    return "(${ctype(generator, target)})gray_cast_check(${c_value_as(generator, value, false, line)}, ${cast_bounds_arguments(generator, sized_minimum, sized_maximum, false, target, line)})"
}

// Does the expression name an array reachable from a variable (through fields, indexes, dereferences)?
fn is_real_array_path(node ^ast.AstNode) -> bool {
    mut current ^ast.AstNode = node
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            current = current^.index_data^.left
        } or current^.kind == ast.NodeKind.POSTFIX_EXPR && current^.postfix^.op == token.TokenKind.CARET {
            current = current^.postfix^.left
        } otherwise {
            break
        }
    }
    return current != nil && current^.kind == ast.NodeKind.LABEL
}

// The containers an element write reaches through: `g` in `g[0][1] = v`. Each is checked, so a
// for_each over any enclosing array or map blocks the write. A path with a call or a pointer in it
// is left unchecked.
fn enclosing_iteration_checks(generator ^CodeGen, node ^ast.AstNode, array_expression ^ast.AstNode) -> string {
    if expression_calls_function(array_expression) { return "" }
    mut checks = ""
    mut current ^ast.AstNode = array_expression
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            if strings.starts_with(expr_type(generator, current^.member^.object), "^") { return checks }
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            container = current^.index_data^.left
            container_type = expr_type(generator, container)
            if !is_array_type(container_type) && !is_map_type(container_type) { return checks }
            if container^.kind != ast.NodeKind.LABEL && container^.kind != ast.NodeKind.MEMBER_EXPR && container^.kind != ast.NodeKind.INDEX_EXPR { return checks }
            mut panic_code = "P0034"
            mut panic_text = "cannot modify array during for_each iteration"
            if is_map_type(container_type) {
                panic_code = "P0035"
                panic_text = "cannot modify map during for_each iteration"
            }
            checks = "${checks}if (gray_atomic_load32(&(${gen_expr(generator, container)}).iterating) > 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"${panic_code}\", \"${panic_text}\"); } "
            current = container
        } otherwise {
            return checks
        }
    }
    return checks
}

// The index of the latest mem-tracking entry for the variable, or -1.
fn mem_entry_index(generator ^CodeGen, name string) -> i64 {
    mut index i64 = len(generator^.mem_names) - 1
    as_long_as index >= 0 {
        if generator^.mem_names[index] == name { return index }
        index = index - 1
    }
    return -1
}

// An arena named by a variable, a field path or a dereference can be evaluated a second time at the use.
fn is_stable_arena_expression(node ^ast.AstNode) -> bool {
    if node == nil { return false }
    when node^.kind {
        is ast.NodeKind.LABEL { return true }
        is ast.NodeKind.MEMBER_EXPR { return is_stable_arena_expression(node^.member^.object) }
        is ast.NodeKind.POSTFIX_EXPR { return node^.postfix^.op == token.TokenKind.CARET && is_stable_arena_expression(node^.postfix^.left) }
        default { return false }
    }
}

// A pointer variable bound to `mem.init` / `mem.alloc` is tracked, so a dereference after its arena
// was destroyed or reset through a path the compile-time checker could not trace panics. A local one
// also records the arena's reset count when it is declared.
fn track_mem_variable(generator ^CodeGen, name string, type_name string, value ^ast.AstNode) {
    mut no_arena ^ast.AstNode = nil
    if value == nil || value^.kind != ast.NodeKind.CALL_EXPR { return }
    callee = value^.call^.function
    mem_function = ""
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL && resolve_alias(generator, callee^.member^.object^.label^.value) == "mem" {
        mem_function = callee^.member^.member
    }
    if (mem_function == "init" || mem_function == "alloc") && len(value^.call^.args) >= 1 {
        arena_argument = value^.call^.args[0]
        if is_stable_arena_expression(arena_argument) {
            records_epoch = generator^.indent > 0
            if records_epoch {
                emit_line(generator, "GrayArena *gray_arena_${name} = gray_mem_live(${gen_expr(generator, arena_argument)}, \"${mem_function}\");")
                emit_line(generator, "uint64_t gray_epoch_${name} = gray_arena_${name}->reset_count;")
            }
            arrays.append(generator^.mem_names, name)
            arrays.append(generator^.mem_arenas, arena_argument)
            arrays.append(generator^.mem_has_epoch, records_epoch)
            return
        }
        arrays.append(generator^.mem_names, name)
        arrays.append(generator^.mem_arenas, no_arena)
        arrays.append(generator^.mem_has_epoch, false)
        return
    }
    index = mem_entry_index(generator, name)
    if strings.starts_with(type_name, "^") && index >= 0 && generator^.mem_arenas[index] != nil {
        arrays.append(generator^.mem_names, name)
        arrays.append(generator^.mem_arenas, no_arena)
        arrays.append(generator^.mem_has_epoch, false)
    }
}

// The pointer variable `pointer` dereferenced at `node`, wrapped in the arena-liveness check when it
// is tracked.
fn checked_pointer_text(generator ^CodeGen, pointer ^ast.AstNode, node ^ast.AstNode) -> string {
    text = gen_expr(generator, pointer)
    if pointer^.kind != ast.NodeKind.LABEL { return text }
    index = mem_entry_index(generator, pointer^.label^.value)
    if index < 0 || generator^.mem_arenas[index] == nil { return text }
    name = pointer^.label^.value
    if generator^.mem_has_epoch[index] {
        return "gray_mem_check_live_epoch(gray_arena_${name}, gray_epoch_${name}, (void *)(${text}), ${location_args(generator, node)})"
    }
    return "gray_mem_check_live(${gen_expr(generator, generator^.mem_arenas[index])}, (void *)(${text}), ${location_args(generator, node)})"
}

// The names the program spells as written, in the order the generated C first names them
// (each name is recorded as it is emitted): the pieces from `first_piece` to `last_piece`,
// string and char literals skipped, a deferred global initializer counted where its global is
// declared, a module-level variable named by its prefixed C name at its declaration and by its
// source name at its first use.
fn identifiers_in_emission_order(generator ^CodeGen, first_piece i64, last_piece i64) -> [string] {
    generator^.index_only_words = {}
    mut ordered [string] = {}
    mut seen [string:bool] = {:}
    mut global_used [string:bool] = {:}
    mut deferred_next i64 = 0
    mut recorded_next i64 = 0
    for piece_index in range(first_piece, last_piece) {
        as_long_as recorded_next < len(generator^.recorded_positions) && generator^.recorded_positions[recorded_next] <= piece_index {
            if !maps.contains_key(seen, generator^.recorded_names[recorded_next]) {
                seen[generator^.recorded_names[recorded_next]] = true
                arrays.append(ordered, generator^.recorded_names[recorded_next])
            }
            recorded_next = recorded_next + 1
        }
        as_long_as deferred_next < len(generator^.deferred_positions) && generator^.deferred_positions[deferred_next] <= piece_index {
            scan_identifiers(generator, generator^.deferred_texts[deferred_next], ordered, seen, global_used)
            deferred_next = deferred_next + 1
        }
        mut skipped = false
        for skip_index in range(0, len(generator^.skipped_start)) {
            if piece_index >= generator^.skipped_start[skip_index] && piece_index < generator^.skipped_end[skip_index] { skipped = true }
        }
        if skipped { continue }
        scan_identifiers(generator, generator^.out[piece_index], ordered, seen, global_used)
    }
    as_long_as deferred_next < len(generator^.deferred_positions) {
        scan_identifiers(generator, generator^.deferred_texts[deferred_next], ordered, seen, global_used)
        deferred_next = deferred_next + 1
    }
    if len(generator^.index_only_words) > 0 {
        mut kept [string] = {}
        for_each ordered_word in ordered { if !arrays.contains(generator^.index_only_words, ordered_word) { arrays.append(kept, ordered_word) } }
        return kept
    }
    return ordered
}

fn text_after_is_http_field(text string, start i64) -> bool {
    return strings.starts_with(strings.slice(text, start, len(text)), "body") || strings.starts_with(strings.slice(text, start, len(text)), "headers")
}

// A field name spelled by code written by hand (the escape of an Error out of a
// function) is not one that was sanitized.
fn word_follows_runtime_snippet(text string, start i64) -> bool {
    // the field names of the result struct that arrays.find writes by hand
    mut struct_open i64 = -1
    mut search_from i64 = 0
    as_long_as search_from < start {
        found = strings.index_of(strings.slice(text, search_from, start), "(struct { ")
        if found < 0 { break }
        struct_open = search_from + found
        search_from = struct_open + 1
    }
    if struct_open >= 0 && !strings.contains(strings.slice(text, struct_open, start), "}){") { return true }
    mut window_start i64 = start - ACCESS_WINDOW_LENGTH
    if window_start < 0 { window_start = 0 }
    window = strings.slice(text, window_start, start)
    if strings.ends_with(window, "->") && (strings.contains(window, "_esc_err") || strings.contains(window, "_src_err") || strings.contains(window, "_ret.v")) { return true }
    // the start, stop and step of a held range are spelled by hand
    if strings.ends_with(window, ".") {
        mut range_window_start i64 = start - RANGE_WINDOW_LENGTH
        if range_window_start < 0 { range_window_start = 0 }
        if strings.contains(strings.slice(text, range_window_start, start), "_gray_range_") { return true }
    }
    // the fields of the stdlib HttpResponse copy, which are written by hand
    if strings.ends_with(window, ".") && (strings.contains(window, "_ss") || strings.contains(window, "_sd")) {
        before = strings.slice(window, 0, len(window) - 1)
        mut digits_start = len(before)
        as_long_as digits_start > 0 && strings.char_at(before, digits_start - 1) >= '0' && strings.char_at(before, digits_start - 1) <= '9' { digits_start = digits_start - 1 }
        if digits_start >= TEMPORARY_MARKER_LENGTH {
            marker = strings.slice(before, digits_start - TEMPORARY_MARKER_LENGTH, digits_start)
            if marker == "_ss" || marker == "_sd" { return text_after_is_http_field(text, start) }
        }
    }
    return false
}

fn scan_identifiers(generator ^CodeGen, text string, &ordered [string], &seen map[string:bool], &global_used map[string:bool]) {
    mut ignored_word = ""
    for skip_index in range(0, len(generator^.index_skip_texts)) {
        if generator^.index_skip_texts[skip_index] == text { ignored_word = generator^.index_skip_words[skip_index] }
    }
    // the index of a for_each is written as it is; it is sanitized where the body names it
    if strings.starts_with(text, "for (int32_t ") { return }
    total = len(text)
    mut position i64 = 0
    as_long_as position < total {
        current = text[position]
        if current == '"' || current == '\'' {
            position = position + 1
            as_long_as position < total && text[position] != current {
                if text[position] == '\\' { position = position + 1 }
                position = position + 1
            }
            position = position + 1
            continue
        }
        is_start = (current >= 'a' && current <= 'z') || (current >= 'A' && current <= 'Z') || current == '_'
        if !is_start {
            position = position + 1
            continue
        }
        start = position
        as_long_as position < total && ((text[position] >= 'a' && text[position] <= 'z') || (text[position] >= 'A' && text[position] <= 'Z') || (text[position] >= '0' && text[position] <= '9') || text[position] == '_') { position = position + 1 }
        word = strings.slice(text, start, position)
        if word == "_" { continue }
        if start >= 1 && text[start - 1] == '#' { continue }
        if start >= len(RETURN_FIELD_PREFIX) && strings.slice(text, start - len(RETURN_FIELD_PREFIX), start) == RETURN_FIELD_PREFIX { continue }
        if word_follows_runtime_snippet(text, start) { continue }
        if word == "text" && strings.contains(text, "gray_json_parse_") { continue }
        // The name of an argument or field temporary is written where it is declared; it is sanitized where it is used
        if (strings.starts_with(word, "_gray_na") || strings.starts_with(word, "_gray_sf")) && start >= len(AUTO_TYPE_DECLARATION) && strings.slice(text, start - len(AUTO_TYPE_DECLARATION), start) == AUTO_TYPE_DECLARATION { continue }
        at_ignored_index = ignored_word != "" && word == ignored_word && strings.contains(strings.slice(text, 0, start), "GRAY_ARRAY_GET_AT(")
        if at_ignored_index && !maps.contains_key(seen, word) { arrays.append(generator^.index_only_words, word) }
        if !at_ignored_index && arrays.contains(generator^.index_only_words, word) {
            mut still_only [string] = {}
            for_each only_word in generator^.index_only_words { if only_word != word { arrays.append(still_only, only_word) } }
            generator^.index_only_words = still_only
        }
        if strings.starts_with(word, ENTRY_GLOBAL_PREFIX) && arrays.contains(generator^.entry_globals, strings.slice(word, len(ENTRY_GLOBAL_PREFIX), len(word))) {
            source_name = strings.slice(word, len(ENTRY_GLOBAL_PREFIX), len(word))
            if !maps.contains_key(seen, word) {
                seen[word] = true
                arrays.append(ordered, word)
            } or !maps.contains_key(global_used, source_name) {
                global_used[source_name] = true
                if !maps.contains_key(seen, source_name) {
                    seen[source_name] = true
                    arrays.append(ordered, source_name)
                }
            }
            continue
        }
        if (maps.contains_key(ast.emitted_identifiers, word) || strings.starts_with(word, "_gray_tmp") || strings.starts_with(word, "_gray_wb") || strings.starts_with(word, "_gray_ac") || strings.starts_with(word, "_gray_ix") || strings.starts_with(word, "_gray_na") || strings.starts_with(word, "_gray_sf")) && !maps.contains_key(seen, word) {
            seen[word] = true
            arrays.append(ordered, word)
        }
    }
}

// The arithmetic operator a compound assignment applies (ASSIGN for a plain assignment).
fn compound_operator(operator token.TokenKind) -> token.TokenKind {
    when operator {
        is token.TokenKind.PLUS_ASSIGN { return token.TokenKind.PLUS }
        is token.TokenKind.MINUS_ASSIGN { return token.TokenKind.MINUS }
        is token.TokenKind.ASTERISK_ASSIGN { return token.TokenKind.ASTERISK }
        is token.TokenKind.SLASH_ASSIGN { return token.TokenKind.SLASH }
        is token.TokenKind.PERCENT_ASSIGN { return token.TokenKind.PERCENT }
        default { return token.TokenKind.ASSIGN }
    }
}

fn is_number_type_name(type_name string) -> bool {
    return is_signed_int_name(type_name) || is_unsigned_int_name(type_name) || is_float_name(type_name) || type_name == "char" || is_wide_name(type_name)
}

// The address of the place `target` names (a variable, an element, a field, a pointer's target),
// checked once on the way: a nil pointer, an index out of bounds or written during for_each.
fn place_address(generator ^CodeGen, target ^ast.AstNode) -> string {
    if target^.kind == ast.NodeKind.POSTFIX_EXPR && target^.postfix^.op == token.TokenKind.CARET {
        pointer_node = target^.postfix^.left
        pointee = strings.slice(expr_type(generator, pointer_node), 1, len(expr_type(generator, pointer_node)))
        if pointer_node^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, pointer_node^.label^.value) {
            return "((${ctype(generator, pointee)} *)(${gen_expr(generator, pointer_node)}))"
        }
        return "((${ctype(generator, pointee)} *)gray_ptr_check((void *)(${checked_pointer_text(generator, pointer_node, target)}), ${location_args(generator, target)}))"
    }
    if target^.kind == ast.NodeKind.INDEX_EXPR {
        left = target^.index_data^.left
        left_type = expr_type(generator, left)
        if is_array_type(left_type) {
            return "GRAY_ARRAY_PTR_FOR_WRITE(${place_address(generator, left)}, ${ctype(generator, array_element_type(left_type))}, ${gen_expr(generator, target^.index_data^.index_expr)}, ${location_args(generator, target)})"
        }
        if is_map_type(left_type) {
            place_key_text = gen_coerced(generator, map_key_type(left_type), target^.index_data^.index_expr)
            place_map_text = place_address(generator, left)
            return "({ ${map_slot_c(generator, map_key_type(left_type))} _pk = ${place_key_text}; void *_pv = gray_map_get(${place_map_text}, &_pk); if (!_pv) { gray_panic_code_at(\"${generator^.file}\", ${target^.tok.line}, \"P0081\", \"key not found in map\"); } (${map_slot_c(generator, map_value_type(left_type))} *)_pv; })"
        }
    }
    if target^.kind == ast.NodeKind.MEMBER_EXPR {
        object = target^.member^.object
        object_type = expr_type(generator, object)
        if strings.starts_with(object_type, "^") && !(object^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, object^.label^.value)) {
            struct_c = ctype(generator, strings.slice(object_type, 1, len(object_type)))
            return "(&((${struct_c} *)gray_ptr_check((void *)(${gen_expr(generator, object)}), ${location_args(generator, target)}))->${target^.member^.member})"
        }
        if maps.contains_key(generator^.structs, object_type) {
            return "(&(${place_address(generator, object)})->${target^.member^.member})"
        }
    }
    return "(&(${gen_expr(generator, target)}))"
}

// A decimal literal as the f32 constant it is: `1.5f`.
fn float_literal_f32(node ^ast.AstNode) -> string {
    mut text = fmt.sprintf("%.9g", {cast(cast(node^.float_value^.value, f32), f64)})
    if !strings.contains(text, ".") && !strings.contains(text, "e") { text = "${text}.0" }
    return "${text}f"
}

// A wide integer constant from its decimal text (an optional '-' then digits): the type's words in
// two's complement, little-endian.
fn wide_literal_c(type_name string, text string) -> string {
    mut limbs [i64] = {0, 0, 0, 0, 0, 0, 0, 0}
    mut negative = false
    mut start i64 = 0
    if strings.starts_with(text, "-") {
        negative = true
        start = 1
    }
    for position in range(start, len(text)) {
        mut carry i64 = cast(text[position], i64) - cast('0', i64)
        for limb_index in range(0, WIDE_LITERAL_LIMBS) {
            current = limbs[limb_index] * DECIMAL_BASE + carry
            limbs[limb_index] = current % LIMB_RADIX
            carry = current / LIMB_RADIX
        }
    }
    if negative {
        mut add_carry i64 = 1
        for limb_index in range(0, WIDE_LITERAL_LIMBS) {
            inverted = LIMB_MASK - limbs[limb_index] + add_carry
            limbs[limb_index] = inverted % LIMB_RADIX
            add_carry = inverted / LIMB_RADIX
        }
    }
    mut words [string] = {}
    for word_index in range(0, WIDE_LITERAL_WORDS) {
        high = limbs[word_index * LIMBS_PER_WORD + 1]
        low = limbs[word_index * LIMBS_PER_WORD]
        arrays.append(words, "0x${fmt.sprintf("%x", {cast(high, u64) * cast(LIMB_RADIX, u64) + cast(low, u64)})}ULL")
    }
    if type_name == "i128" { return "((gray_i128){${words[0]}, (int64_t)${words[1]}})" }
    if type_name == "u128" { return "((gray_u128){${words[0]}, ${words[1]}})" }
    return "((gray_${type_name}){{${words[0]}, ${words[1]}, ${words[2]}, ${words[3]}}})"
}

// A parameter whose type came from an enum default is declared int64 in C.
fn param_c_type(generator ^CodeGen, param ast.Param) -> string {
    if param.type_from_default { return "int64_t" }
    return ctype(generator, param.type_name)
}
