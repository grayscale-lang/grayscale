import @strings, @arrays, @fmt, @maps, @io, @strconv, @path
import "../ast/ast"
import "../lexer/token"
import "./stdlib_c"
import "./runtime_macros"

// Offsets within a type name written as text: "[]", "map[]", "map[", "func(", ")->(", "range(", "wrap_".
const ARRAY_BRACKETS_LENGTH i64 = 2
const MAP_BRACKETS_LENGTH i64 = 5
const MAP_PREFIX_LENGTH i64 = 4
const FUNC_OPEN_PAREN_INDEX i64 = 4
const FUNC_PARAMS_START i64 = 5
const RETURN_SEPARATOR_LENGTH i64 = 4
const RANGE_PREFIX_LENGTH i64 = 6
const WRAP_PREFIX_LENGTH i64 = 5
// The "[" and the comma before the size of a fixed-size array type name.
const BRACKET_AND_COMMA_LENGTH i64 = 2
// The longest alias chain followed before it is taken to be a cycle.
const MAX_ALIAS_CHAIN i64 = 32
// The deepest nesting of fields in a path, and of struct zero values.
const MAX_FIELD_PATH_DEPTH i64 = 16
const MAX_STRUCT_ZERO_DEPTH i64 = 8
// A flags enum has one usable bit per variant, at most this many.
const MAX_FLAG_VARIANTS i64 = 63
// The widths of f64 and f32 in bits.
const F64_BITS i64 = 64
const F32_BITS i64 = 32
// An integer literal with more digits than this is kept as written; with more than I64_MAX_DIGITS it needs a suffix.
const MAX_PLAIN_LITERAL_DIGITS i64 = 18
const I64_MAX_DIGITS i64 = 19
const I64_MAX_TEXT string = "9223372036854775807"
// The base of decimal numbers.
const DECIMAL_BASE i64 = 10
// A format precision stops growing past this, so it cannot overflow.
const MAX_PRECISION_BEFORE_DIGIT i64 = 214748364
// The number of distinct byte values; the first printable character and the delete character.
const BYTE_VALUE_COUNT i64 = 256
const FIRST_PRINTABLE_CHARACTER i64 = 32
const DELETE_CHARACTER i64 = 127
// The characters of a backslash escape, of "\\xN", and of "\\x00".
const ESCAPE_LENGTH i64 = 2
const HEX_ESCAPE_ONE_DIGIT_LENGTH i64 = 3
const NUL_HEX_ESCAPE_LENGTH i64 = 4
// The kind tag the runtime uses to print a value in an interpolation.
const INTERPOLATION_KIND_INTEGER i64 = 0
const INTERPOLATION_KIND_FLOAT i64 = 1
const INTERPOLATION_KIND_STRING i64 = 2
const INTERPOLATION_KIND_BOOL i64 = 3
const INTERPOLATION_KIND_CHAR i64 = 6
const INTERPOLATION_KIND_ENUM i64 = 7
// The largest shift of a 128-bit and of a 256-bit integer.
const MAX_SHIFT_128 i64 = 127
const MAX_SHIFT_256 i64 = 255
// The capacity of a map literal: twice the entries once there are more than the threshold, else the minimum.
const MAP_LITERAL_GROWTH_THRESHOLD i64 = 4
const MAP_LITERAL_CAPACITY_FACTOR i64 = 2
const MAP_LITERAL_MIN_CAPACITY i64 = 8
// Whether a function's result is known to allocate nothing: not known, allocation-free, allocating.
const WATERMARK_UNKNOWN i64 = 0
const WATERMARK_ALLOCATION_FREE i64 = 1
const WATERMARK_ALLOCATES i64 = 2
// The bytes of JSON text taken by the braces of an object, by a comma and space, by a quoted key and its colon, and by false; and the longest number.
const JSON_BRACES_LENGTH i64 = 2
const JSON_SEPARATOR_LENGTH i64 = 2
const JSON_KEY_DECORATION_LENGTH i64 = 4
const JSON_FALSE_LENGTH i64 = 5
const MAX_NUMBER_TEXT_LENGTH i64 = 21
// How far back in generated C text to look for the text before a name.
const ACCESS_WINDOW_LENGTH i64 = 14
const RANGE_WINDOW_LENGTH i64 = 20
const TEMPORARY_MARKER_LENGTH i64 = 3
const RETURN_FIELD_PREFIX string = "_ret."
const AUTO_TYPE_DECLARATION string = "__auto_type "
const ENTRY_GLOBAL_PREFIX string = "gray_g_"
// A 256-bit literal is held in eight 32-bit limbs, read as four 64-bit words.
const WIDE_LITERAL_LIMBS i64 = 8
const WIDE_LITERAL_WORDS i64 = 4
const LIMBS_PER_WORD i64 = 2
const LIMB_RADIX i64 = 4294967296
const LIMB_MASK i64 = 4294967295

// A labeled loop being emitted, which `break name` and `continue name` jump out
// of or back into.
const LabeledLoop struct {
    label string
    // Names the C labels `_gray_break_<id>` and `_gray_continue_<id>`
    id i64
    // `iterating` entries below this belong to the loop's enclosers and the loop itself
    guard_floor i64
    is_break_used bool
    is_continue_used bool
    // `scope_arena_variables` entries below this belong to the loop's enclosers; the loop's own iteration arena sits at it
    arena_floor i64
    has_iteration_arena bool
}

const CodeGen struct {
    out [string]
    // The initializer statements of the module-level variables, run at the start of main
    // The enums a stdlib module contributes (io.OpenFlag, os.Platform): their variants carry their position
    stdlib_enum_names [string]
    // Pointer variables bound to raw(): a dereference of one is not nil-checked
    raw_names [string]
    // The temporaries of a composite print are numbered apart from every other temporary
    print_counter i64
    // A statement's iteration checks share its line: the indentation of the next line is already written
    indent_written bool
    global_initializers [string]
    // Where the identifier scan skips the generated text (multi-return typedefs spell their fields unsanitized)
    skipped_start [i64]
    skipped_end [i64]
    index_skip_texts [string]
    index_skip_words [string]
    index_only_words [string]
    recorded_positions [i64]
    recorded_names [string]
    when_line i64
    // The positions in the output at which a deferred global initializer was generated, with its text
    deferred_positions [i64]
    deferred_texts [string]
    indent i64
    file string
    // The file and line the last `#line` directive named
    last_line_file string
    last_line_number i64
    // The function references of the program with the signature each was typed with
    // Pointer variables bound to mem.init / mem.alloc: the latest entry per name wins (a nil arena means not tracked)
    mem_names [string]
    mem_arenas [^ast.AstNode]
    mem_has_epoch [bool]
    function_signature_symbols [string]
    function_signature_types [string]
    // The `ensure` / `defer` statements of the function being emitted, and how many
    // control flow has reached at the point being emitted
    ensures [^ast.AstNode]
    ensure_reached i64
    // The variable whose initializer is being emitted
    current_variable string
    // The array variable that shares a pointer-reached field's storage instead of copying it
    elided_array string
    // While a statement storing into module-level storage is emitted: the string value copied into the heap arena
    module_store_value ^ast.AstNode
    is_module_store bool
    is_element_write_back bool
    // Variables assigned the result of new(): their pointee lives in the heap arena
    heap_variables [string]
    // Scoped arenas open at the point being emitted: how deep, and each one's variable and the variable that saved the arena to restore
    loop_scope_depth i64
    scope_arena_variables [string]
    scope_arena_saved [string]
    // Inside a loop whose body opens no arena of its own
    is_in_no_arena_loop bool
    // The function being emitted, and the user functions whose watermark scan is in progress
    current_function ^ast.AstNode
    watermark_probes [^ast.AstNode]
    watermark_tainted bool
    // File-scope integer constants, for array lengths written as a name
    int_constants map[string:i64]
    // The file-scope variables of the entry file: emitted as gray_g_NAME so they cannot clash with libc
    entry_globals [string]
    // The parameters of the function being emitted: a returned one is shared with the caller's storage
    current_params [string]
    // How deep zero_value_text is inside nested structs
    struct_zero_depth i64
    // Return types of the function being emitted
    return_types [string]
    multi_name string
    // Declared structs and enums by name
    structs map[string:^ast.AstNode]
    enums map[string:^ast.AstNode]
    funcs map[string:^ast.AstNode]
    ref_params [string]
    counter i64
    // Collection headers the generated code needs without importing their module
    needs_arrays_header bool
    needs_strings_header bool
    needs_maps_header bool
    stdlib_calls map[string:stdlib_c.StdlibC]
    // Collections being iterated by enclosing for_each loops, innermost last
    iterating [string]
    // The labeled loops being emitted, innermost last
    labeled_loops [LabeledLoop]
    // The type parameters of the generic instantiation being emitted
    generics ast.GenericBindings
    // Struct types whose printer is being emitted, outermost first
    printing [string]
    // Struct types being walked for storage a copy would share, outermost first
    copy_walk [string]
    // The program's type aliases, `distinct` ones included: codegen only sees
    // the representation
    alias_names [string]
    alias_targets [string]
    // The name runtime.function_name() reports: `Type.func` for a struct function
    function_runtime_name string
    // While a parameter default is emitted at a call site: the callee's runtime name
    default_target_name string
}

// A fresh number for compiler-generated C identifiers.
fn next_id(generator ^CodeGen) -> i64 {
    current_id = generator^.counter
    generator^.counter = generator^.counter + 1
    return current_id
}

fn codegen_create(file string) -> ^CodeGen {
    generator = new(CodeGen)
    generator^.file = file
    return generator
}

// Filled outside codegen_create: inserting structs into a map field of a
// `new()` object inside its creating function copies their strings into the
// function arena.
fn register_stdlib_calls(generator ^CodeGen) {
    for_each entry in stdlib_c.stdlib_c_table() {
        generator^.stdlib_calls["${entry.module}.${entry.name}"] = entry
    }
}

fn emit(generator ^CodeGen, text string) {
    arrays.append(generator^.out, text)
}

fn emit_indent(generator ^CodeGen) {
    if generator^.indent_written {
        generator^.indent_written = false
        return
    }
    emit(generator, strings.repeat("    ", generator^.indent))
}

// Text that starts a statement's line and continues on it: its own indentation is written now and the
// next line emitted does not repeat it.
fn emit_line_prefix(generator ^CodeGen, text string) {
    emit_indent(generator)
    emit(generator, text)
    generator^.indent_written = true
}

// One whole line at the current indentation.
fn emit_line(generator ^CodeGen, text string) {
    emit_indent(generator)
    emit(generator, text)
    emit(generator, "\n")
}

// --- Types ---

// The runtime prefix of a wide integer type ("gray_i128"), or "" for any other type.
fn wide_prefix(type_name string) -> string {
    if type_name == "i128" || type_name == "u128" || type_name == "i256" || type_name == "u256" { return "gray_${type_name}" }
    return ""
}

fn is_wide_name(type_name string) -> bool {
    return wide_prefix(type_name) != ""
}

// True when the runtime has `target_from_source` (the conversions are not a
// full matrix).
fn wide_has_conversion(target string, source string) -> bool {
    when target {
        is "i128" { return source == "i256" || source == "u128" || source == "i64" || source == "u64" }
        is "i256" { return source == "i128" || source == "i64" || source == "u64" }
        is "u128" { return source == "i128" || source == "u256" || source == "u64" }
        is "u256" { return source == "u128" || source == "u64" }
        default { return false }
    }
}

// `value` (of Grayscale type `source`) converted to the wide integer `target`.
fn to_wide(target string, source string, value string) -> string {
    prefix = wide_prefix(target)
    if source == target { return value }
    if is_wide_name(source) {
        if wide_has_conversion(target, source) { return "${prefix}_from_${source}(${value})" }
        return "${prefix}_from_i64(gray_${source}_to_i64(${value}, \"\", 0))"
    }
    if is_unsigned_int_name(source) { return "${prefix}_from_u64((uint64_t)(${value}))" }
    if wide_has_conversion(target, "i64") { return "${prefix}_from_i64((int64_t)(${value}))" }
    return "${prefix}_from_u64((uint64_t)(${value}))"
}

// An integer literal's text when it does not fit in 64 bits, else "".
fn wide_literal_text(node ^ast.AstNode) -> string {
    if node != nil && node^.kind == ast.NodeKind.PREFIX_EXPR && node^.prefix^.op == token.TokenKind.MINUS {
        negated = wide_literal_text(node^.prefix^.right)
        if negated != "" { return "-${negated}" }
        return ""
    }
    if node == nil || node^.kind != ast.NodeKind.INT_VALUE { return "" }
    literal = strings.replace(node^.int_value^.literal, "_", "")
    if len(literal) > MAX_PLAIN_LITERAL_DIGITS && !strings.starts_with(literal, "0x") { return literal }
    return ""
}

// A binary operation on two wide integers, or "" for an operator with no
// wide form.
fn wide_binary(prefix string, operator token.TokenKind, left string, right string, where string) -> string {
    if operator == token.TokenKind.PLUS { return "${prefix}_add_checked(${left}, ${right}, ${where})" }
    if operator == token.TokenKind.MINUS { return "${prefix}_sub_checked(${left}, ${right}, ${where})" }
    if operator == token.TokenKind.ASTERISK { return "${prefix}_mul_checked(${left}, ${right}, ${where})" }
    if operator == token.TokenKind.SLASH { return "${prefix}_div(${left}, ${right}, ${where})" }
    if operator == token.TokenKind.PERCENT { return "${prefix}_mod(${left}, ${right}, ${where})" }
    if operator == token.TokenKind.EQ { return "${prefix}_eq(${left}, ${right})" }
    if operator == token.TokenKind.NOT_EQ { return "${prefix}_ne(${left}, ${right})" }
    if operator == token.TokenKind.LT { return "${prefix}_lt(${left}, ${right})" }
    if operator == token.TokenKind.GT { return "${prefix}_gt(${left}, ${right})" }
    if operator == token.TokenKind.LT_EQ { return "${prefix}_le(${left}, ${right})" }
    if operator == token.TokenKind.GT_EQ { return "${prefix}_ge(${left}, ${right})" }
    return ""
}

// The value of `node` in a place that holds `target_written` (a declaration,
// an assignment, an argument, a return): an integer that is not already the
// wide type is widened.
fn gen_coerced(generator ^CodeGen, target_written string, node ^ast.AstNode) -> string {
    target = eff(generator, target_written)
    // a bare func value stored into a typed func slot is checked against the slot's signature
    if strings.starts_with(target, "func(") && expr_type(generator, node) == "func" {
        return "gray_func_check((void *)(${gen_expr(generator, node)}), \"${strings.replace(target, " ", "")}\", \"${generator^.file}\", ${node^.tok.line})"
    }
    if is_float_name(target) && is_wide_name(expr_type(generator, node)) && wide_literal_text(node) == "" {
        return "(${ctype(generator, target)})${wide_prefix(expr_type(generator, node))}_to_f64(${gen_expr(generator, node)})"
    }
    if expr_type(generator, node) == "a C interop value" {
        narrowed = narrow_c_value(generator, target, node)
        if narrowed != "" { return narrowed }
    }
    if !is_wide_name(target) { return gen_expr(generator, node) }
    huge = wide_literal_text(node)
    if huge != "" { return "${wide_literal_c(target, huge)}" }
    source = expr_type(generator, node)
    if source == target { return gen_expr(generator, node) }
    if is_signed_int_name(source) || is_unsigned_int_name(source) || is_wide_name(source) {
        return to_wide(target, source, gen_expr(generator, node))
    }
    return gen_expr(generator, node)
}

fn is_signed_int_name(name string) -> bool {
    return name == "i8" || name == "i16" || name == "i32" || name == "i64"
}

fn is_unsigned_int_name(name string) -> bool {
    return name == "u8" || name == "u16" || name == "u32" || name == "u64"
}

fn is_float_name(name string) -> bool {
    return name == "f32" || name == "f64"
}

// `type_text` with the type parameters of the instantiation being emitted
// replaced by their types. The single main-pass check types an expression of
// a type parameter as unknown ("?kind"); a plain "unknown" cannot say which
// parameter it comes from, so it takes the only one when there is just one.
fn eff(generator ^CodeGen, type_text string) -> string {
    return resolve_alias(generator, substitute_generics(generator, type_text))
}

// `type_text` with the type parameters substituted and aliases kept, the
// spelling an instantiation is named by: a `distinct alias` is its own type.
fn substitute_generics(generator ^CodeGen, type_text string) -> string {
    if len(generator^.generics.names) == 0 { return type_text }
    if type_text == "unknown" && len(generator^.generics.names) == 1 { return generator^.generics.types[0] }
    return ast.generic_bindings_substitute(generator^.generics, type_text)
}

// Registers the program's type aliases.
fn register_aliases(generator ^CodeGen, program ^ast.AstNode) {
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.ALIAS_DECL { continue }
        arrays.append(generator^.alias_names, statement^.alias_decl^.name)
        arrays.append(generator^.alias_targets, statement^.alias_decl^.target_type)
    }
}

// The index of the first top-level `separator` in `text`, or -1.
fn alias_separator(text string, separator char) -> i64 {
    mut depth i64 = 0
    for position in range(0, len(text)) {
        character = strings.char_at(text, position)
        if character == '[' || character == '(' {
            depth = depth + 1
        } or character == ']' || character == ')' {
            depth = depth - 1
        } or character == separator && depth == 0 {
            return position
        }
    }
    return -1
}

// A type name with every alias erased, inside `^T`, `[T]`, `[T,N]` and
// `map[K:V]` spellings too.
fn resolve_alias(generator ^CodeGen, name string) -> string {
    if len(generator^.alias_names) == 0 || name == "" { return name }
    if strings.starts_with(name, "^") {
        return "^${resolve_alias(generator, strings.slice(name, 1, len(name)))}"
    }
    if strings.starts_with(name, "[") && len(name) > ARRAY_BRACKETS_LENGTH && strings.char_at(name, len(name) - 1) == ']' {
        mut inner = strings.slice(name, 1, len(name) - 1)
        mut size_suffix = ""
        size_comma = alias_separator(inner, ',')
        if size_comma >= 0 {
            size_suffix = strings.slice(inner, size_comma, len(inner))
            inner = strings.slice(inner, 0, size_comma)
        }
        return "[${resolve_alias(generator, inner)}${size_suffix}]"
    }
    if strings.starts_with(name, "map[") && len(name) > MAP_BRACKETS_LENGTH && strings.char_at(name, len(name) - 1) == ']' {
        inner = strings.slice(name, MAP_PREFIX_LENGTH, len(name) - 1)
        colon = alias_separator(inner, ':')
        if colon >= 0 {
            return "map[${resolve_alias(generator, strings.slice(inner, 0, colon))}:${resolve_alias(generator, strings.slice(inner, colon + 1, len(inner)))}]"
        }
        return name
    }
    mut current = name
    for _ in range(0, MAX_ALIAS_CHAIN) {
        mut found = false
        for index in range(0, len(generator^.alias_names)) {
            if generator^.alias_names[index] == current {
                current = generator^.alias_targets[index]
                found = true
                break
            }
        }
        if !found { break }
        // A target that is itself a container goes back through the branches above
        if strings.starts_with(current, "^") || strings.starts_with(current, "[") || strings.starts_with(current, "map[") {
            return resolve_alias(generator, current)
        }
    }
    return current
}

// The type an expression has in the instantiation being emitted.
// The type the checker recorded for `node`, with a type parameter left as written: the check for
// whether code allocates reads the type table of the generic body, not of one instantiation.
fn table_type(generator ^CodeGen, node ^ast.AstNode) -> string {
    if node^.resolved_type == "" { return expr_type(generator, node) }
    return node^.resolved_type
}

fn expr_type(generator ^CodeGen, node ^ast.AstNode) -> string {
    if node^.resolved_type == "" {
        // code the checker never reached (after a return) still has a literal's own type
        #strict
        when node^.kind {
            is ast.NodeKind.STRING_VALUE, ast.NodeKind.INTERPOLATED_STRING { return "string" }
            is ast.NodeKind.INT_VALUE { return "i64" }
            is ast.NodeKind.FLOAT_VALUE { return "f64" }
            is ast.NodeKind.BOOL_VALUE { return "bool" }
            is ast.NodeKind.CHAR_VALUE { return "char" }
            is ast.NodeKind.LABEL, ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
            ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
            ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
            ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR,
            ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM,
            ast.NodeKind.WHEN_PATTERN, ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT,
            ast.NodeKind.RETURN_STMT, ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT,
            ast.NodeKind.BLOCK_STMT, ast.NodeKind.IF_STMT, ast.NodeKind.WHEN_STMT, ast.NodeKind.FOR_STMT,
            ast.NodeKind.FOR_EACH_STMT, ast.NodeKind.WHILE_STMT, ast.NodeKind.LOOP_STMT,
            ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL,
            ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL,
            ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL, ast.NodeKind.MODULE_DECL,
            ast.NodeKind.PROGRAM {}
        }
    }
    if len(generator^.generics.names) > 0 && (node^.resolved_type == "unknown" || strings.starts_with(node^.resolved_type, "?")) {
        derived = derived_generic_type(generator, node)
        if derived != "" { return derived }
    }
    return eff(generator, node^.resolved_type)
}

// In a generic body the single main-pass check types a field read or an
// index of a type-parameter value as unknown; the instantiation's type
// follows from the (bound) type of the object read.
fn derived_generic_type(generator ^CodeGen, node ^ast.AstNode) -> string {
    if node^.kind == ast.NodeKind.MEMBER_EXPR {
        mut object_type = expr_type(generator, node^.member^.object)
        if strings.starts_with(object_type, "^") { object_type = strings.slice(object_type, 1, len(object_type)) }
        if !maps.contains_key(generator^.structs, object_type) { return "" }
        for_each declared in generator^.structs[object_type]^.struct_decl^.struct_fields {
            if declared.name == node^.member^.member { return eff(generator, declared.type_name) }
        }
        return ""
    }
    if node^.kind == ast.NodeKind.INDEX_EXPR {
        collection_type = expr_type(generator, node^.index_data^.left)
        if strings.starts_with(collection_type, "map[") { return map_value_type(collection_type) }
        if strings.starts_with(collection_type, "[") { return array_element_type(collection_type) }
        if collection_type == "string" { return "char" }
    }
    return ""
}

// The C spelling of a Grayscale type.
fn ctype(generator ^CodeGen, written_type string) -> string {
    type_name = eff(generator, written_type)
    if maps.contains_key(generator^.enums, type_name) { return "GrayEnum_${type_name}" }
    if maps.contains_key(generator^.structs, type_name) { return "GrayStruct_${type_name}" }
    if strings.starts_with(type_name, "^") {
        return "${ctype(generator, strings.slice(type_name, 1, len(type_name)))} *"
    }
    return c_type(type_name)
}

fn c_type(type_name string) -> string {
    when type_name {
        is "i8" { return "int8_t" }
        is "i16" { return "int16_t" }
        is "i32" { return "int32_t" }
        is "i64" { return "int64_t" }
        is "u8" { return "uint8_t" }
        is "u16" { return "uint16_t" }
        is "u32" { return "uint32_t" }
        is "u64" { return "uint64_t" }
        is "f32" { return "float" }
        is "f64" { return "double" }
        is "string" { return "GrayString" }
        is "bool" { return "bool" }
        is "char" { return "int32_t" }
        is "i128" { return "gray_i128" }
        is "u128" { return "gray_u128" }
        is "i256" { return "gray_i256" }
        is "u256" { return "gray_u256" }
        is "Error" { return "GrayError *" }
        is "ErrorCode" { return "GrayErrorCode" }
        is "void" { return "void" }
    }
    if strings.starts_with(type_name, "^") {
        return "${c_type(strings.slice(type_name, 1, len(type_name)))} *"
    }
    if strings.starts_with(type_name, "[") { return "GrayArray" }
    if strings.starts_with(type_name, "map[") { return "GrayMap" }
    if is_func_type(type_name) { return "void *" }
    // a range kept in a variable
    if strings.starts_with(type_name, "Range<") { return "GrayRange_${range_element(type_name)}" }
    // `mem.Arena`, `threads.Thread`: a type reached through its module
    if strings.contains(type_name, ".") && !strings.contains(type_name, "[") && !strings.contains(type_name, "(") {
        return c_type(strings.slice(type_name, strings.last_index_of(type_name, ".") + 1, len(type_name)))
    }
    // The structs the stdlib returns are declared by the runtime headers
    if type_name == "FileInfo" { return "GrayIoFileInfo" }
    if type_name == "ExecResult" { return "GrayOsExecResult" }
    if type_name == "HttpRequest" { return "GrayRequest" }
    if type_name == "HttpResponse" { return "GrayHttpResponse" }
    if type_name == "Thread" { return "GrayThread" }
    if type_name == "Mutex" { return "GrayMutex" }
    if type_name == "SpinLock" { return "GraySpinLock" }
    if type_name == "Channel" { return "GrayChannel" }
    if type_name == "Socket" || type_name == "Listener" { return "GraySocket" }
    if type_name == "Database" { return "GraySqlite *" }
    if type_name == "Router" { return "GrayRouter" }
    if type_name == "UUID" { return "GrayUUID" }
    if type_name == "Arena" { return "GrayArena *" }
    if type_name == "Builder" { return "GrayStringsBuilder *" }
    return "GrayStruct_${type_name}"
}

// `[T]` or `[T,N]` -> T
fn array_element_type(type_name string) -> string {
    inner = strings.slice(type_name, 1, len(type_name) - 1)
    comma = last_top_level_comma(inner)
    if comma >= 0 { return strings.slice(inner, 0, comma) }
    return inner
}

fn last_top_level_comma(text string) -> i64 {
    mut depth i64 = 0
    mut found i64 = -1
    for i in range(0, len(text)) {
        character = strings.char_at(text, i)
        if character == '[' || character == '(' { depth = depth + 1 }
        if character == ']' || character == ')' { depth = depth - 1 }
        if character == ',' && depth == 0 { found = i }
    }
    return found
}

// The index of the ':' separating a map's key and value types.
fn map_colon(inner string) -> i64 {
    mut depth i64 = 0
    for i in range(0, len(inner)) {
        character = strings.char_at(inner, i)
        if character == '[' { depth = depth + 1 }
        if character == ']' { depth = depth - 1 }
        if character == ':' && depth == 0 { return i }
    }
    return -1
}

fn map_key_type(type_name string) -> string {
    inner = strings.slice(type_name, MAP_PREFIX_LENGTH, len(type_name) - 1)
    return strings.slice(inner, 0, map_colon(inner))
}

fn map_value_type(type_name string) -> string {
    inner = strings.slice(type_name, MAP_PREFIX_LENGTH, len(type_name) - 1)
    return strings.slice(inner, map_colon(inner) + 1, len(inner))
}

// A function type spelling: bare `func` or `func(...) -> ...`.
fn is_func_type(type_name string) -> bool {
    return type_name == "func" || strings.starts_with(type_name, "func(")
}

fn is_array_type(type_name string) -> bool {
    return strings.starts_with(type_name, "[")
}

fn is_map_type(type_name string) -> bool {
    return strings.starts_with(type_name, "map[")
}

// --- Expressions ---

fn op_text(operator token.TokenKind) -> string {
    when operator {
        is token.TokenKind.PLUS { return "+" }
        is token.TokenKind.MINUS { return "-" }
        is token.TokenKind.ASTERISK { return "*" }
        is token.TokenKind.SLASH { return "/" }
        is token.TokenKind.PERCENT { return "%" }
        is token.TokenKind.LT { return "<" }
        is token.TokenKind.GT { return ">" }
        is token.TokenKind.LT_EQ { return "<=" }
        is token.TokenKind.GT_EQ { return ">=" }
        is token.TokenKind.EQ { return "==" }
        is token.TokenKind.NOT_EQ { return "!=" }
        is token.TokenKind.AND { return "&&" }
        is token.TokenKind.OR { return "||" }
        is token.TokenKind.BIT_AND { return "&" }
        is token.TokenKind.BIT_OR { return "|" }
        is token.TokenKind.BIT_XOR { return "^" }
        is token.TokenKind.BIT_SHIFT_LEFT { return "<<" }
        is token.TokenKind.BIT_SHIFT_RIGHT { return ">>" }
        default { return "?" }
    }
}

// The source location argument pair the runtime's checked operations take.
fn location_args(generator ^CodeGen, node ^ast.AstNode) -> string {
    return "\"${generator^.file}\", ${node^.tok.line}"
}

fn gen_expr(generator ^CodeGen, node ^ast.AstNode) -> string {
    if node == nil { return "0" }
    if node == generator^.module_store_value {
        generator^.module_store_value = nil
        return "({ GrayString _store_source = ${gen_expr(generator, node)}; gray_string_new(gray_default_arena, _store_source.data, _store_source.len); })"
    }
    if node^.runtime_fixed_length > 0 {
        expected_length = node^.runtime_fixed_length
        node^.runtime_fixed_length = 0
        fixed_source = gen_expr(generator, node)
        node^.runtime_fixed_length = expected_length
        return "({ GrayArray _fixed_arr = ${fixed_source}; if (_fixed_arr.len != ${expected_length}) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0131\", \"fixed-size array field needs exactly %d elements, but the assigned array has %d\", ${expected_length}, (int)_fixed_arr.len); } _fixed_arr; })"
    }
    if node^.zero_fill_length > 0 {
        fixed_length = node^.zero_fill_length
        node^.zero_fill_length = 0
        short_source = gen_expr(generator, node)
        node^.zero_fill_length = fixed_length
        padded_element = array_element_type(expr_type(generator, node))
        padding = "memset((char *)_padded_arr.data + _short_bytes, 0, (size_t)${fixed_length} * (size_t)_short_arr.elem_size - _short_bytes); "
        padding_zero = zero_value_text(generator, padded_element)
        if padding_zero != "" {
            padding = "for (int64_t _slot = _short_arr.len; _slot < ${fixed_length}; _slot++) ((${ctype(generator, padded_element)} *)_padded_arr.data)[_slot] = ${padding_zero}; "
        }
        return "({ GrayArray _short_arr = ${short_source}; GrayArray _padded_arr = gray_array_new(gray_default_arena, _short_arr.elem_size, ${fixed_length}, _short_arr.elem_kind); size_t _short_bytes = (size_t)_short_arr.len * (size_t)_short_arr.elem_size; if (_short_bytes) memcpy(_padded_arr.data, _short_arr.data, _short_bytes); ${padding}_padded_arr.len = ${fixed_length}; _padded_arr; })"
    }
    // A number literal expression that took a wide integer type from its slot is
    // emitted as the wide value it folds to.
    if node^.is_literal_typed && node^.folded_literal != "" {
        literal_type = eff(generator, node^.resolved_type)
        if is_wide_name(literal_type) { return "${wide_literal_c(literal_type, node^.folded_literal)}" }
    }
    if node^.folded_literal != "" && is_float_name(eff(generator, node^.resolved_type)) {
        // a constant expression of literals that folded to a float
        folded_value, folded_error = strconv.to_f64(node^.folded_literal)
        if folded_error == nil {
            mut float_text = ""
            if eff(generator, node^.resolved_type) == "f32" {
                float_text = fmt.sprintf("%.9g", {cast(cast(folded_value, f32), f64)})
            } otherwise {
                float_text = fmt.sprintf("%.17g", {folded_value})
            }
            if !strings.contains(float_text, ".") && !strings.contains(float_text, "e") { float_text = "${float_text}.0" }
            if eff(generator, node^.resolved_type) == "f32" { float_text = "${float_text}f" }
            return float_text
        }
    }
    if node^.folded_literal != "" && !is_float_name(eff(generator, node^.resolved_type)) && !is_wide_name(eff(generator, node^.resolved_type)) {
        // a constant expression of literals is its folded value
        folded_text = node^.folded_literal
        if folded_text == "-9223372036854775808" { return "(-9223372036854775807LL - 1)" }
        if strings.starts_with(folded_text, "-") { return "(${folded_text}LL)" }
        if len(folded_text) > I64_MAX_DIGITS || (len(folded_text) == I64_MAX_DIGITS && strings.compare(folded_text, I64_MAX_TEXT) > 0) { return "${folded_text}ULL" }
        return folded_text
    }
    when node^.kind {
        is ast.NodeKind.INT_VALUE { return gen_int_literal(node) }
        is ast.NodeKind.FLOAT_VALUE { return gen_float_literal(node) }
        is ast.NodeKind.STRING_VALUE {
            return gen_string_value(generator, node^.string_value)
        }
        is ast.NodeKind.BOOL_VALUE {
            if node^.bool_value^.value { return "true" }
            return "false"
        }
        is ast.NodeKind.CHAR_VALUE { return "((int32_t)${cast(node^.char_value^.value, i64)})" }
        is ast.NodeKind.NIL_VALUE { return "NULL" }
        is ast.NodeKind.LABEL {
            if node^.label^.stdlib_constant_module != "" && !node^.label^.is_local_reference {
                bare_constant = stdlib_constant_text(node^.label^.stdlib_constant_module, node^.label^.value)
                if bare_constant != "" {
                    // The name is sanitized before the constant is written in its place
                    arrays.append(generator^.recorded_positions, len(generator^.out))
                    arrays.append(generator^.recorded_names, node^.label^.value)
                    return bare_constant
                }
            }
            if arrays.contains(generator^.ref_params, node^.label^.value) { return "(*${node^.label^.value})" }
            if node^.label^.is_file_global_reference && arrays.contains(generator^.entry_globals, node^.label^.value) { return "gray_g_${node^.label^.value}" }
            return node^.label^.value
        }
        is ast.NodeKind.INTERPOLATED_STRING { return gen_interpolation(generator, node) }
        is ast.NodeKind.PREFIX_EXPR { return gen_prefix(generator, node) }
        is ast.NodeKind.INFIX_EXPR { return gen_infix(generator, node) }
        is ast.NodeKind.CALL_EXPR { return gen_call(generator, node) }
        is ast.NodeKind.MEMBER_EXPR { return gen_member(generator, node) }
        is ast.NodeKind.FUNC_REF { return gen_func_ref(generator, node) }
        is ast.NodeKind.IMPLICIT_ENUM {
            // the enum the typechecker resolved the selector against
            mut enum_name = node^.implicit_enum^.resolved_enum
            if enum_name == "" { enum_name = expr_type(generator, node) }
            if is_tagged_enum(generator, enum_name) { return unit_variant_value(enum_name, node^.implicit_enum^.variant) }
            if enum_name == "ErrorCode" { return "GrayErrorCode_${node^.implicit_enum^.variant}" }
            return "GrayEnum_${enum_name}_${node^.implicit_enum^.variant}"
        }
        is ast.NodeKind.STRUCT_VALUE { return gen_struct_literal(generator, node) }
        is ast.NodeKind.ARRAY_VALUE { return gen_array_literal(generator, node) }
        is ast.NodeKind.MAP_VALUE { return gen_map_literal(generator, node) }
        is ast.NodeKind.INDEX_EXPR { return gen_index(generator, node) }
        is ast.NodeKind.POSTFIX_EXPR { return gen_postfix(generator, node) }
        is ast.NodeKind.NEW_EXPR { return gen_new(generator, node) }
        is ast.NodeKind.CAST_EXPR { return gen_cast(generator, node) }
        is ast.NodeKind.RANGE_EXPR { return gen_range_value(generator, node) }
        default { return "0 /* unsupported expression kind ${cast(node^.kind, i64)} at ${node^.tok.file}:${node^.tok.line} */" }
    }
}

// `()name` and `()Type.name`: the function's address.
fn gen_func_ref(generator ^CodeGen, node ^ast.AstNode) -> string {
    target = node^.func_ref^.function
    mut symbol = ""
    if target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind == ast.NodeKind.LABEL {
        symbol = "gray_fn_${target^.member^.object^.label^.value}_${target^.member^.member}"
    } otherwise {
        symbol = "gray_fn_${target^.label^.value}"
    }
    register_function_signature(generator, symbol, expr_type(generator, node))
    return symbol
}

// Notes that `symbol` is a function whose references have the canonical type `type_name`, once.
fn register_function_signature(generator ^CodeGen, symbol string, type_name string) {
    if !strings.starts_with(type_name, "func(") || arrays.contains(generator^.function_signature_symbols, symbol) { return }
    arrays.append(generator^.function_signature_symbols, symbol)
    arrays.append(generator^.function_signature_types, type_name)
}

// A call through a func-typed value: the value is cast to the function type the
// call's own argument and result types spell.
fn gen_func_value_call(generator ^CodeGen, node ^ast.AstNode, callee string) -> string {
    arguments = node^.call^.args
    mut return_c = "int64_t"
    result_type = expr_type(generator, node)
    if result_type == "void" {
        return_c = "void"
    } or result_type != "" && result_type != "unknown" {
        return_c = ctype(generator, result_type)
    }
    // a func value that returns several values: the result is a struct of them
    function_type = expr_type(generator, node^.call^.function)
    arrow = strings.index_of(function_type, ")->(")
    if is_func_type(function_type) && arrow >= 0 {
        returns_text = strings.slice(function_type, arrow + RETURN_SEPARATOR_LENGTH, len(function_type) - 1)
        mut slots [string] = {}
        mut slot_index i64 = 0
        for_each part in split_top_level(returns_text) {
            arrays.append(slots, "${ctype(generator, strings.trim(part))} v${slot_index};")
            slot_index = slot_index + 1
        }
        return_c = "struct { ${strings.join(slots, " ")} }"
    }
    mut parameter_types [string] = {}
    mut argument_texts [string] = {}
    // `&T` parameters of the function type take their argument by address
    mut declared_parameters [string] = {}
    if is_func_type(function_type) && strings.starts_with(function_type, "func(") {
        close = matching_paren(function_type, FUNC_OPEN_PAREN_INDEX)
        if close > FUNC_PARAMS_START { declared_parameters = split_top_level(strings.slice(function_type, FUNC_PARAMS_START, close)) }
    }
    for i in range(0, len(arguments)) {
        if i < len(declared_parameters) && strings.starts_with(strings.trim(declared_parameters[i]), "&") {
            mutable_type = strings.slice(strings.trim(declared_parameters[i]), 1, len(strings.trim(declared_parameters[i])))
            arrays.append(parameter_types, "${ctype(generator, mutable_type)} *")
            if strings.starts_with(expr_type(generator, arguments[i]), "^") {
                arrays.append(argument_texts, gen_expr(generator, arguments[i]))
            } otherwise {
                arrays.append(argument_texts, "&${gen_expr(generator, arguments[i])}")
            }
        } or i < len(declared_parameters) && strings.trim(declared_parameters[i]) != "" && len(generator^.generics.names) == 0 {
            // the function type's own parameter type, which the argument is converted to
            declared_type = strings.trim(declared_parameters[i])
            arrays.append(parameter_types, ctype(generator, declared_type))
            arrays.append(argument_texts, gen_coerced(generator, declared_type, arguments[i]))
        } otherwise {
            arrays.append(parameter_types, ctype(generator, expr_type(generator, arguments[i])))
            arrays.append(argument_texts, gen_expr(generator, arguments[i]))
        }
    }
    mut parameter_list = strings.join(parameter_types, ", ")
    if len(parameter_types) == 0 { parameter_list = "void" }
    return "((${return_c} (*)(${parameter_list}))${callee})(${strings.join(argument_texts, ", ")})"
}

// `value.field`, `Enum.VARIANT`
// The C text of the stdlib constant `module.name`, or "" when there is none.
fn stdlib_constant_text(module_name string, name string) -> string {
    if module_name == "math" {
        when name {
            is "PI" { return "3.14159265358979323846" }
            is "E" { return "2.71828182845904523536" }
            is "TAU" { return "6.28318530717958647692" }
            is "PHI" { return "1.61803398874989484820" }
            is "SQRT2" { return "1.41421356237309504880" }
            is "LN2" { return "0.69314718055994530942" }
            is "LN10" { return "2.30258509299404568402" }
            is "INF" { return "(1.0/0.0)" }
            is "NEG_INF" { return "(-1.0/0.0)" }
            is "EPSILON" { return "2.2204460492503131e-16" }
            is "MAX_I64" { return "9223372036854775807LL" }
            is "MIN_I64" { return "(-9223372036854775807LL - 1)" }
            is "MAX_F64" { return "1.7976931348623157e308" }
            is "MIN_F64" { return "-1.7976931348623157e308" }
        }
    }
    if module_name == "os" && (name == "MAC_OS" || name == "LINUX" || name == "WINDOWS" || name == "OTHER") { return "GrayEnum_Platform_${name}" }
    if module_name == "io" && (name == "O_RDONLY" || name == "O_WRONLY" || name == "O_RDWR") { return "GrayEnum_OpenFlag_${name}" }
    if module_name == "strconv" {
        when name {
            is "BASE_2" { return "2" }
            is "BASE_8" { return "8" }
            is "BASE_10" { return "10" }
            is "BASE_16" { return "16" }
            is "BASE_36" { return "36" }
        }
    }
    if module_name == "uuid" && name == "NIL_UUID" { return "gray_uuid_nil()" }
    return ""
}

fn gen_member(generator ^CodeGen, node ^ast.AstNode) -> string {
    object = node^.member^.object
    member = node^.member^.member
    // math.PI, os.LINUX, ...: a stdlib constant reached through its module
    if object^.kind == ast.NodeKind.LABEL {
        qualified_constant = stdlib_constant_text(object^.label^.value, member)
        if qualified_constant != "" && !object^.label^.is_local_reference { return qualified_constant }
    }
    // a multi-value call's temporary: its slots are v0, v1, ...
    if object^.kind == ast.NodeKind.LABEL && strings.starts_with(object^.label^.value, "_gray_tmp") && strings.starts_with(member, "v") { return "${object^.label^.value}.${member}" }
    // extern.NAME: a constant or variable of a C header
    if object^.kind == ast.NodeKind.LABEL && object^.label^.value == "extern" { return member }
    // ErrorCode.VARIANT: a slot of the program-wide open enum
    if object^.kind == ast.NodeKind.LABEL && object^.label^.value == "ErrorCode" && !maps.contains_key(generator^.enums, "ErrorCode") {
        return "GrayErrorCode_${member}"
    }
    // An Error is a GrayError * that is NULL on the success path: reading a field is guarded
    if expr_type(generator, object) == "Error" {
        mut field = member
        if member == "message" { field = "msg" }
        return "({ __auto_type _err_v = ${gen_expr(generator, object)}; if (!_err_v) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0115\", \"read of '%s' on a nil Error; check the error is non-nil before reading its fields\", \"${member}\"); } _err_v->${field}; })"
    }
    if object^.kind == ast.NodeKind.LABEL && is_tagged_enum(generator, object^.label^.value) {
        return unit_variant_value(object^.label^.value, member)
    }
    if object^.kind == ast.NodeKind.LABEL && maps.contains_key(generator^.enums, object^.label^.value) {
        return "GrayEnum_${object^.label^.value}_${member}"
    }
    // io.O_RDONLY, os.MAC_OS: a stdlib enum's variant spelled through its module
    if object^.kind == ast.NodeKind.LABEL && expr_type(generator, node) != "" && maps.contains_key(generator^.enums, expr_type(generator, node)) && (object^.label^.value == "io" || object^.label^.value == "os") {
        return "GrayEnum_${expr_type(generator, node)}_${member}"
    }
    // A pointer reached with `.` dereferences implicitly
    if strings.starts_with(expr_type(generator, object), "^") && !is_deref(object) {
        pointer_text = gen_expr(generator, object)
        if object^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, object^.label^.value) { return "${pointer_text}->${member}" }
        pointee_c = ctype(generator, strings.slice(expr_type(generator, object), 1, len(expr_type(generator, object))))
        return "((${pointee_c} *)gray_ptr_check((void *)(${pointer_text}), ${location_args(generator, node)}))->${member}"
    }
    // ExecResult's stdout and stderr are spelled `_gray_` in C: the names are macros there
    if expr_type(generator, object) == "ExecResult" && (member == "stdout" || member == "stderr") {
        return "${gen_expr(generator, object)}._gray_${member}"
    }
    return "${gen_expr(generator, object)}.${member}"
}

fn is_deref(node ^ast.AstNode) -> bool {
    return node^.kind == ast.NodeKind.POSTFIX_EXPR && node^.postfix^.op == token.TokenKind.CARET
}

// `(*(T *)gray_ptr_check((void *)(p), file, line))`: a nil-checked dereference.
fn deref_text(generator ^CodeGen, pointer string, pointer_type string, node ^ast.AstNode) -> string {
    pointee = ctype(generator, strings.slice(pointer_type, 1, len(pointer_type)))
    return "(*(${pointee} *)gray_ptr_check((void *)(${pointer}), ${location_args(generator, node)}))"
}

fn gen_postfix(generator ^CodeGen, node ^ast.AstNode) -> string {
    inner = node^.postfix^.left
    if node^.postfix^.op == token.TokenKind.CARET {
        if inner^.kind == ast.NodeKind.CALL_EXPR && inner^.call^.function^.kind == ast.NodeKind.LABEL && inner^.call^.function^.label^.value == "raw" { return "(*${gen_expr(generator, inner)})" }
        if inner^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, inner^.label^.value) { return "(*${gen_expr(generator, inner)})" }
        written_pointer = table_type(generator, inner)
        written_pointee = ""
        if strings.starts_with(written_pointer, "^") { written_pointee = strings.slice(written_pointer, 1, len(written_pointer)) }
        // a pointer to a pointer, or to a type parameter, is read through a held copy of the pointer
        if strings.starts_with(written_pointee, "^") || strings.contains(written_pointee, "?") {
            return "({ __auto_type _dp = ${checked_pointer_text(generator, inner, node)}; if (!_dp) { gray_panic_code_at(${location_args(generator, node)}, \"P0080\", \"nil pointer dereference\"); } *_dp; })"
        }
        return deref_text(generator, checked_pointer_text(generator, inner, node), expr_type(generator, inner), node)
    }
    if node^.postfix^.op == token.TokenKind.INCREMENT || node^.postfix^.op == token.TokenKind.DECREMENT {
        step_name = "add"
        step_op = "+"
        if node^.postfix^.op == token.TokenKind.DECREMENT {
            step_name = "sub"
            step_op = "-"
        }
        mut step_kind = token.TokenKind.PLUS
        if node^.postfix^.op == token.TokenKind.DECREMENT { step_kind = token.TokenKind.MINUS }
        step_result = checked_arithmetic(generator, node, expr_type(generator, inner), step_kind, "(*_lv)", "1")
        if step_result != "" {
            return "({ ${ctype(generator, expr_type(generator, inner))} *_lv = ${place_address(generator, inner)}; *_lv = ${step_result}; })"
        }
        if is_wide_name(expr_type(generator, inner)) {
            wide_inner = expr_type(generator, inner)
            // in a generic body the checker has not fixed the width: the step goes through a held address
            if strings.contains(table_type(generator, inner), "?") {
                return "({ ${ctype(generator, wide_inner)} *_lv = ${place_address(generator, inner)}; *_lv = ${wide_prefix(wide_inner)}_${step_name}_checked((*_lv), ${wide_prefix(wide_inner)}_from_u64(1), ${location_args(generator, node)}); })"
            }
            return "((${gen_expr(generator, inner)}) = ${wide_prefix(wide_inner)}_${step_name}_checked(${gen_expr(generator, inner)}, ${wide_prefix(wide_inner)}_from_u64(1), ${location_args(generator, node)}))"
        }
        return "((${gen_expr(generator, inner)}) ${step_op}= 1)"
    }
    return gen_expr(generator, inner)
}

// new(T): zeroed heap memory; array and map fields start allocated on the heap.
fn gen_new(generator ^CodeGen, node ^ast.AstNode) -> string {
    type_name = node^.new_expr^.type_name
    c_name = ctype(generator, type_name)
    mut inits [string] = {}
    // new(map[K:V]) and new([T]) hold an empty, ready collection
    if is_map_type(type_name) {
        arrays.append(inits, "*_np = GRAY_MAP_NEW_OF(gray_heap_arena, ${map_slot_c(generator, map_key_type(type_name))}, ${map_slot_c(generator, map_value_type(type_name))}, 8);")
    }
    if is_array_type(type_name) {
        arrays.append(inits, "*_np = GRAY_ARRAY_NEW_OF(gray_heap_arena, ${ctype(generator, array_element_type(type_name))}, 4);")
    }
    if enum_has_default_variant(generator, type_name) {
        arrays.append(inits, "*_np = GrayEnum_${type_name}_${generator^.enums[type_name]^.enum_decl^.values[0].name};")
    }
    if maps.contains_key(generator^.structs, type_name) {
        new_field_inits(generator, type_name, "_np->", inits)
    }
    if len(inits) == 0 { return "((${c_name} *)gray_arena_alloc(gray_heap_arena, sizeof(${c_name})))" }
    return "({ ${c_name} *_np = (${c_name} *)gray_arena_alloc(gray_heap_arena, sizeof(${c_name})); ${strings.join(inits, " ")} _np; })"
}

// The statements that give every collection, enum and defaulted field of a struct (and of
// the structs nested in it by value) its starting value.
fn new_field_inits(generator ^CodeGen, struct_name string, field_path string, &inits [string]) {
    for_each field in generator^.structs[struct_name]^.struct_decl^.struct_fields {
        if is_array_type(field.type_name) {
            arrays.append(inits, "${field_path}${field.name} = ${strings.replace(empty_array_text(generator, field.type_name), "gray_default_arena", "gray_heap_arena")};")
        }
        if is_map_type(field.type_name) {
            arrays.append(inits, "${field_path}${field.name} = GRAY_MAP_NEW_OF(gray_heap_arena, ${map_slot_c(generator, map_key_type(field.type_name))}, ${map_slot_c(generator, map_value_type(field.type_name))}, 8);")
        }
        if field.default_value == nil && maps.contains_key(generator^.enums, field.type_name) && !is_tagged_enum(generator, field.type_name) && len(generator^.enums[field.type_name]^.enum_decl^.values) > 0 {
            arrays.append(inits, "${field_path}${field.name} = GrayEnum_${field.type_name}_${generator^.enums[field.type_name]^.enum_decl^.values[0].name};")
        }
        if maps.contains_key(generator^.structs, field.type_name) && field.type_name != struct_name {
            new_field_inits(generator, field.type_name, "${field_path}${field.name}.", inits)
        }
        if field.default_value != nil {
            expect_type(field.default_value, field.type_name)
            arrays.append(inits, "${field_path}${field.name} = ${gen_expr(generator, field.default_value)};")
        }
    }
}

// cast(array, [type]): a new array with every element converted.
fn gen_array_cast(generator ^CodeGen, node ^ast.AstNode) -> string {
    source_node = node^.cast_data^.value
    source_element = array_element_type(expr_type(generator, source_node))
    target_element = eff(generator, node^.cast_data^.element_type)
    source_c = ctype(generator, source_element)
    target_c = ctype(generator, target_element)
    id = next_id(generator)
    mut conversion string = "(${target_c})_cv${id}"
    if is_wide_name(target_element) {
        // into a wide integer: a wide source is range-checked, a float truncated, a scalar widened
        wide_place = "${generator^.file}\", ${node^.tok.line}"
        if is_wide_name(source_element) {
            conversion = "_cv${id}"
            if source_element != target_element { conversion = "gray_cast_${source_element}_to_${target_element}(_cv${id}, \"${wide_place})" }
        } or is_float_name(source_element) {
            conversion = "gray_f64_to_${target_element}((double)_cv${id}, \"${wide_place})"
        } or strings.starts_with(target_element, "u") && is_signed_int_name(source_element) {
            conversion = "gray_cast_i64_to_${target_element}((int64_t)_cv${id}, \"${wide_place})"
        } or is_unsigned_int_name(source_element) {
            conversion = "${wide_prefix(target_element)}_from_u64((uint64_t)_cv${id})"
        } otherwise {
            conversion = "${wide_prefix(target_element)}_from_i64((int64_t)_cv${id})"
        }
    } or is_wide_name(source_element) {
        // out of a wide integer: range-checked extraction
        source_prefix = wide_prefix(source_element)
        if is_float_name(target_element) {
            conversion = "(${target_c})${source_prefix}_to_f64(_cv${id})"
        } or target_element == "u64" || target_element == "i64" {
            conversion = "(${target_c})${source_prefix}_to_${target_element}(_cv${id}, \"${generator^.file}\", ${node^.tok.line})"
        } or is_unsigned_int_name(target_element) {
            conversion = "(${target_c})gray_ucast_check_u64(${source_prefix}_to_u64(_cv${id}, \"${generator^.file}\", ${node^.tok.line}), ${array_cast_bounds(target_element, generator^.file, node^.tok.line)})"
        } otherwise {
            conversion = "(${target_c})gray_cast_check(${source_prefix}_to_i64(_cv${id}, \"${generator^.file}\", ${node^.tok.line}), ${array_cast_bounds(target_element, generator^.file, node^.tok.line)})"
        }
    } or array_narrowing_maximum(target_element, source_element) != "" {
        narrow_minimum, narrow_maximum = sized_bounds(target_element)
        mut narrow_unsigned = is_unsigned_int_name(target_element)
        if target_element == "char" {
            narrow_minimum = ""
            narrow_maximum = "1114111"
            narrow_unsigned = true
        }
        mut narrow_suffix = ""
        mut narrow_cast = ""
        if is_float_name(source_element) {
            narrow_suffix = "_f64"
            narrow_cast = "(double)"
        } or source_element == "u64" {
            narrow_suffix = "_u64"
            narrow_cast = "(uint64_t)"
        }
        mut narrow_check = "gray_cast_check"
        if narrow_unsigned { narrow_check = "gray_ucast_check" }
        conversion = "(${target_c})${narrow_check}${narrow_suffix}(${narrow_cast}(_cv${id}), ${cast_bounds_arguments(generator, narrow_minimum, narrow_maximum, narrow_unsigned, target_element, node^.tok.line)})"
    } or is_float_name(source_element) && !is_float_name(target_element) {
        helper = "gray_f64_to_i64"
        if target_element == "u64" { helper = "gray_f64_to_u64" }
        conversion = "(${target_c})${helper}((double)_cv${id}, \"${generator^.file}\", ${node^.tok.line})"
    }
    return "({ GrayArray _ca${id} = ${gen_expr(generator, source_node)}; GrayArray _cr${id} = GRAY_ARRAY_NEW_OF(gray_default_arena, ${target_c}, _ca${id}.len); for (int32_t _ci${id} = 0; _ci${id} < _ca${id}.len; _ci${id}++) { ${source_c} _cv${id} = ((${source_c}*)_ca${id}.data)[_ci${id}]; ((${target_c}*)_cr${id}.data)[_ci${id}] = ${conversion}; } _cr${id}.len = _ca${id}.len; _cr${id}; })"
}

fn gen_cast(generator ^CodeGen, node ^ast.AstNode) -> string {
    if node^.cast_data^.is_array { return gen_array_cast(generator, node) }
    target = eff(generator, node^.cast_data^.target_type)
    value_node = node^.cast_data^.value
    source = expr_type(generator, value_node)
    if source == "" && (value_node^.kind == ast.NodeKind.STRING_VALUE || value_node^.kind == ast.NodeKind.INTERPOLATED_STRING) { source = "string" }
    if source == "string" && is_string_enum(generator, target) {
        string_variant_count = len(generator^.enums[target]^.enum_decl^.values)
        return "gray_enum_cast_check_string(${gen_expr(generator, value_node)}, (const GrayString[${string_variant_count}]){${enum_variant_constants(generator, target)}}, ${string_variant_count}, \"${display_type_name(generator, target)}\", \"${generator^.file}\", ${node^.tok.line})"
    }
    if source == "string" && target != "string" && !maps.contains_key(generator^.enums, target) {
        // string -> number: parsed, and range-checked at run time
        text = gen_expr(generator, value_node)
        if is_wide_name(target) { return "gray_builtin_string_to_${target}(${text}, ${location_args(generator, node)})" }
        if target == "i64" { return "gray_builtin_string_to_i64(${text})" }
        if target == "u64" { return "gray_builtin_string_to_u64(${text})" }
        if target == "f64" { return "gray_builtin_string_to_f64(${text})" }
        if target == "f32" { return "(float)gray_builtin_string_to_f64(${text})" }
        string_minimum, string_maximum = sized_bounds(target)
        if string_maximum != "" {
            mut string_check = "gray_cast_check"
            if is_unsigned_int_name(target) { string_check = "gray_ucast_check" }
            return "(${ctype(generator, target)})${string_check}(gray_builtin_string_to_i64(${text}), ${cast_bounds_arguments(generator, string_minimum, string_maximum, is_unsigned_int_name(target), target, node^.tok.line)})"
        }
    }
    if is_wide_name(target) && is_wide_name(source) && source != target {
        return "gray_cast_${source}_to_${target}(${gen_expr(generator, value_node)}, ${location_args(generator, node)})"
    }
    if is_wide_name(target) && !is_wide_name(source) && !is_float_name(source) && strings.starts_with(target, "u") && is_signed_int_name(source) {
        return "gray_cast_i64_to_${target}((int64_t)(${gen_expr(generator, value_node)}), ${location_args(generator, node)})"
    }
    return gen_conversion(generator, node, target, value_node)
}

// The type-named conversion builtins: i128(x), f64(x), char(x), string(x), bool(x).
fn is_conversion_name(name string) -> bool {
    return is_signed_int_name(name) || is_unsigned_int_name(name) || is_float_name(name) || is_wide_name(name) || name == "char" || name == "string" || name == "bool"
}

// The checked-cast bounds arguments: `max, "T", "file", line` when unsigned, else `min, max, ...`.
fn cast_bounds_arguments(generator ^CodeGen, minimum_text string, maximum_text string, is_unsigned bool, type_name string, line i64) -> string {
    if is_unsigned { return "${maximum_text}, \"${type_name}\", \"${generator^.file}\", ${line}" }
    return "${minimum_text}, ${maximum_text}, \"${type_name}\", \"${generator^.file}\", ${line}"
}

// The value of a C interop expression as an i64 or u64: its C type decides the sign.
fn c_value_as(generator ^CodeGen, value string, is_unsigned_target bool, line i64) -> string {
    if is_unsigned_target {
        return "({ __auto_type _c_value = (${value}); (__typeof__(_c_value))-1 < 0 ? gray_ucast_check(_c_value, 18446744073709551615ULL, \"u64\", \"${generator^.file}\", ${line}) : (uint64_t)_c_value; })"
    }
    return "({ __auto_type _c_value = (${value}); (__typeof__(_c_value))-1 < 0 ? (int64_t)_c_value : gray_u64_to_i64_check((uint64_t)_c_value, \"${generator^.file}\", ${line}); })"
}

// The variant constants of a plain or string enum as a C initializer list.
fn enum_variant_constants(generator ^CodeGen, enum_name string) -> string {
    mut constants [string] = {}
    for_each variant in generator^.enums[enum_name]^.enum_decl^.values { arrays.append(constants, "GrayEnum_${enum_name}_${variant.name}") }
    return strings.join(constants, ", ")
}

// `cast(value, target)` between number types, chars and enums, range-checked where the target
// is narrower or differently signed. Returns "" when the conversion needs no check.
fn gen_checked_numeric_cast(generator ^CodeGen, node ^ast.AstNode, target string, source string, value_node ^ast.AstNode) -> string {
    line = node^.tok.line
    is_c_value = source == "a C interop value" || source == "unknown" || source == ""
    if source == "string" || source == "bool" { return "" }
    value = gen_expr(generator, value_node)
    if target == "i64" && is_float_name(source) { return "gray_f64_to_i64((double)(${value}), \"${generator^.file}\", ${line})" }
    if target == "u64" && is_float_name(source) { return "gray_f64_to_u64((double)(${value}), \"${generator^.file}\", ${line})" }
    sized_minimum, sized_maximum = sized_bounds(target)
    mut is_unsigned = is_unsigned_int_name(target)
    if target == "char" && source != "char" {
        sized_minimum = ""
        sized_maximum = "1114111"
        is_unsigned = true
    }
    if sized_maximum != "" {
        mut suffix = ""
        mut value_cast = ""
        if is_float_name(source) {
            suffix = "_f64"
            value_cast = "(double)"
        } or source == "u64" {
            suffix = "_u64"
            value_cast = "(uint64_t)"
        }
        mut check_name = "gray_cast_check"
        if is_unsigned { check_name = "gray_ucast_check" }
        return "(${ctype(generator, target)})${check_name}${suffix}(${value_cast}(${value}), ${cast_bounds_arguments(generator, sized_minimum, sized_maximum, is_unsigned, target, line)})"
    }
    if target == "u64" && is_c_value { return c_value_as(generator, value, true, line) }
    if target == "i64" && is_c_value { return c_value_as(generator, value, false, line) }
    if target == "u64" && is_signed_int_name(source) {
        return "(uint64_t)gray_ucast_check((int64_t)(${value}), 18446744073709551615ULL, \"u64\", \"${generator^.file}\", ${line})"
    }
    if target == "i64" && source == "u64" { return "(int64_t)gray_u64_to_i64_check((uint64_t)(${value}), \"${generator^.file}\", ${line})" }
    if maps.contains_key(generator^.enums, target) && !is_string_enum(generator, target) && !is_tagged_enum(generator, target) {
        mut flags_text = "false"
        if generator^.enums[target]^.enum_decl^.is_flags { flags_text = "true" }
        variant_count = len(generator^.enums[target]^.enum_decl^.values)
        return "(${ctype(generator, target)})gray_enum_cast_check((int64_t)(${value}), (const int64_t[${variant_count}]){${enum_variant_constants(generator, target)}}, ${variant_count}, ${flags_text}, \"${display_type_name(generator, target)}\", \"${generator^.file}\", ${line})"
    }
    return ""
}

// `string(x)` and `cast(x, string)`: the builtin that renders a value of its type as a string.
fn gen_to_string(generator ^CodeGen, source string, source_node ^ast.AstNode) -> string {
    if source == "string" || source == "UUID" || is_string_enum(generator, source) { return gen_value_as_string(generator, source, gen_expr(generator, source_node)) }
    if is_wide_name(source) { return "${wide_prefix(source)}_to_string(gray_default_arena, ${gen_expr(generator, source_node)})" }
    if source == "Error" {
        id = next_id(generator)
        return "({ GrayError *_gray_str_err${id} = (${gen_expr(generator, source_node)}); _gray_str_err${id} ? _gray_str_err${id}->msg : gray_c_string_dup(gray_default_arena, \"nil\"); })"
    }
    if is_error_code_type(generator, source) { return "gray_string_lit(gray_error_code_name((int64_t)(${gen_expr(generator, source_node)})))" }
    if source == "char" { return "gray_builtin_char_to_utf8(gray_default_arena, ${gen_expr(generator, source_node)})" }
    if is_float_name(source) {
        bits = F64_BITS
        if source == "f32" { bits = F32_BITS }
        return "gray_builtin_to_string_floating_point(gray_default_arena, ${gen_expr(generator, source_node)}, ${bits})"
    }
    if source == "bool" { return "gray_builtin_to_string_bool(gray_default_arena, ${gen_expr(generator, source_node)})" }
    if is_unsigned_int_name(source) { return "gray_builtin_to_string_u64(gray_default_arena, ${gen_expr(generator, source_node)})" }
    return "gray_builtin_to_string_i64(gray_default_arena, ${gen_expr(generator, source_node)})"
}

fn gen_conversion(generator ^CodeGen, node ^ast.AstNode, target string, source_node ^ast.AstNode) -> string {
    source = expr_type(generator, source_node)
    if target == "string" { return gen_to_string(generator, source, source_node) }
    if target == "bool" { return "((bool)(${gen_expr(generator, source_node)}))" }
    if is_wide_name(target) {
        huge = wide_literal_text(source_node)
        if huge != "" { return "${wide_literal_c(target, huge)}" }
        if is_float_name(source) { return "gray_f64_to_${target}((double)(${gen_expr(generator, source_node)}), ${location_args(generator, node)})" }
        if strings.starts_with(target, "u") && is_signed_int_name(source) { return "gray_cast_i64_to_${target}((int64_t)(${gen_expr(generator, source_node)}), ${location_args(generator, node)})" }
        return to_wide(target, source, gen_expr(generator, source_node))
    }
    if !is_wide_name(source) {
        checked_cast = gen_checked_numeric_cast(generator, node, target, source, source_node)
        // the char builtin wraps its checked conversion
        if checked_cast != "" && target == "char" && node^.kind == ast.NodeKind.CALL_EXPR { return "(${checked_cast})" }
        if checked_cast != "" { return checked_cast }
    }
    mut value = gen_expr(generator, source_node)
    if (target == "f32" || target == "f64") && source_node^.kind == ast.NodeKind.INT_VALUE { value = int_literal_as_float(source_node^.int_value^.value, target) }
    if target == "f32" && source_node^.kind == ast.NodeKind.FLOAT_VALUE { value = float_literal_f32(source_node) }
    if is_wide_name(source) {
        prefix = wide_prefix(source)
        if is_float_name(target) { return "(${ctype(generator, target)})${prefix}_to_f64(${value})" }
        narrow_minimum, narrow_maximum = sized_bounds(target)
        if narrow_maximum != "" {
            if is_unsigned_int_name(target) { return "(${ctype(generator, target)})gray_ucast_check_u64(${prefix}_to_u64(${value}, ${location_args(generator, node)}), ${cast_bounds_arguments(generator, narrow_minimum, narrow_maximum, true, target, node^.tok.line)})" }
            return "(${ctype(generator, target)})gray_cast_check(${prefix}_to_i64(${value}, ${location_args(generator, node)}), ${cast_bounds_arguments(generator, narrow_minimum, narrow_maximum, false, target, node^.tok.line)})"
        }
        if is_unsigned_int_name(target) { return "(${ctype(generator, target)})${prefix}_to_u64(${value}, ${location_args(generator, node)})" }
        return "(${ctype(generator, target)})${prefix}_to_i64(${value}, ${location_args(generator, node)})"
    }
    return "((${ctype(generator, target)})(${value}))"
}

// An integer literal spelled as the f32 or f64 it converts to.
fn int_literal_as_float(value i64, float_type string) -> string {
    if float_type == "f32" {
        mut single_text = fmt.sprintf("%.9g", {cast(cast(value, f32), f64)})
        if !strings.contains(single_text, ".") && !strings.contains(single_text, "e") { single_text = "${single_text}.0" }
        return "${single_text}f"
    }
    mut double_text = fmt.sprintf("%.17g", {cast(value, f64)})
    if !strings.contains(double_text, ".") && !strings.contains(double_text, "e") { double_text = "${double_text}.0" }
    return double_text
}

fn gen_int_literal(node ^ast.AstNode) -> string {
    // an integer literal that took a float type from its slot is the float it converts to
    if node^.resolved_type == "f32" || node^.resolved_type == "f64" { return int_literal_as_float(node^.int_value^.value, node^.resolved_type) }
    literal = node^.int_value^.literal
    if literal == "" { return "${node^.int_value^.value}" }
    return strings.replace(literal, "_", "")
}

fn gen_float_literal(node ^ast.AstNode) -> string {
    if node^.resolved_type == "f32" { return float_literal_f32(node) }
    text = fmt.sprintf("%.17g", {node^.float_value^.value})
    if !strings.contains(text, ".") && !strings.contains(text, "e") { return "${text}.0" }
    return text
}

// A string literal as a C string literal wrapped in gray_string_lit.
// A string holding a NUL byte carries its explicit length: strlen would truncate it.
// The text of a string literal between the quotes of the C literal, from the source text as
// written: its escapes pass through, and bytes outside ASCII stay as they are.
fn c_string_body(data ^ast.StringValueData) -> string {
    text = data^.value
    total = len(text)
    mut pieces [string] = {}
    mut cursor i64 = 0
    as_long_as cursor < total {
        character = strings.char_at(text, cursor)
        next_char = ' '
        if cursor + 1 < total { next_char = strings.char_at(text, cursor + 1) }
        if data^.is_raw {
            if character == '\\' {
                arrays.append(pieces, "\\\\")
            } or character == '"' {
                arrays.append(pieces, "\\\"")
            } or character == '\n' {
                arrays.append(pieces, "\\n")
            } or character == '\r' {
                arrays.append(pieces, "\\r")
            } or character == '\t' {
                arrays.append(pieces, "\\t")
            } or character == '?' {
                arrays.append(pieces, "\\?")
            } otherwise {
                arrays.append(pieces, strings.slice(text, cursor, cursor + 1))
            }
            cursor = cursor + 1
            continue
        }
        if character == '\\' && next_char == 'x' && cursor + 2 < total && is_hex_digit(strings.char_at(text, cursor + 2)) {
            // \xNN, then a break in the C literal when a hex digit follows
            arrays.append(pieces, strings.slice(text, cursor, cursor + HEX_ESCAPE_ONE_DIGIT_LENGTH))
            cursor = cursor + HEX_ESCAPE_ONE_DIGIT_LENGTH
            if cursor < total && is_hex_digit(strings.char_at(text, cursor)) {
                arrays.append(pieces, strings.slice(text, cursor, cursor + 1))
                cursor = cursor + 1
            }
            if cursor < total && is_hex_digit(strings.char_at(text, cursor)) { arrays.append(pieces, "\" \"") }
        } or character == '\\' && next_char == '\\' {
            arrays.append(pieces, "\\\\")
            cursor = cursor + ESCAPE_LENGTH
        } or character == '\\' && next_char == '$' {
            arrays.append(pieces, "$")
            cursor = cursor + ESCAPE_LENGTH
        } or character == '\n' {
            arrays.append(pieces, "\\n")
            cursor = cursor + 1
        } or character == '\r' {
            arrays.append(pieces, "\\r")
            cursor = cursor + 1
        } or character == '?' {
            arrays.append(pieces, "\\?")
            cursor = cursor + 1
        } otherwise {
            arrays.append(pieces, strings.slice(text, cursor, cursor + 1))
            cursor = cursor + 1
        }
    }
    return strings.join(pieces, "")
}

fn is_hex_digit(character char) -> bool {
    return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

// A string literal expression: `gray_string_lit`, the macro form at file scope, and the form
// carrying an explicit length when the text holds a NUL byte.
fn gen_string_value(generator ^CodeGen, data ^ast.StringValueData) -> string {
    text = data^.value
    total = len(text)
    mut has_null = false
    mut byte_count i64 = 0
    mut cursor i64 = 0
    as_long_as cursor < total {
        character = strings.char_at(text, cursor)
        next_char = ' '
        if cursor + 1 < total { next_char = strings.char_at(text, cursor + 1) }
        third = ' '
        if cursor + 2 < total { third = strings.char_at(text, cursor + 2) }
        fourth = ' '
        if cursor + 3 < total { fourth = strings.char_at(text, cursor + 3) }
        if character == '\\' && next_char == 'x' && third == '0' && fourth == '0' {
            has_null = true
            byte_count = byte_count + 1
            cursor = cursor + NUL_HEX_ESCAPE_LENGTH
        } or character == '\\' && next_char == '0' {
            has_null = true
            byte_count = byte_count + 1
            cursor = cursor + ESCAPE_LENGTH
        } or character == '\\' && cursor + 1 < total {
            byte_count = byte_count + 1
            cursor = cursor + ESCAPE_LENGTH
        } otherwise {
            byte_count = byte_count + 1
            cursor = cursor + 1
        }
    }
    body = c_string_body(data)
    if has_null && generator^.indent > 0 { return "gray_string_lit_len(\"${body}\", ${byte_count})" }
    if generator^.indent == 0 { return "GRAY_STRING_LIT(\"${body}\")" }
    return "gray_string_lit(\"${body}\")"
}

fn gen_string_literal(text string) -> string {
    for byte_index in range(0, len(text)) {
        if cast(strings.char_at(text, byte_index), i64) == 0 { return "gray_string_lit_len(${c_quote(text)}, ${len(text)})" }
    }
    return "gray_string_lit(${c_quote(text)})"
}

// A byte below 0x20 or 0x7f as a three-digit C octal escape, which never reads on into the next character.
fn c_octal_escape(code i64) -> string {
    return "\\${code / 64}${(code / 8) % 8}${code % 8}"
}

fn c_quote(text string) -> string {
    mut quoted = "\""
    // byte by byte: a string may hold bytes that are not valid UTF-8
    for byte_index in range(0, len(text)) {
        character = strings.char_at(text, byte_index)
        when character {
            is '\n' { quoted = "${quoted}\\n" }
            is '\t' { quoted = "${quoted}\\t" }
            is '\r' { quoted = "${quoted}\\r" }
            is '"' { quoted = "${quoted}\\\"" }
            is '\\' { quoted = "${quoted}\\\\" }
            is '?' { quoted = "${quoted}\\?" }
            default {
                mut code i64 = cast(character, i64)
                if code < 0 { code = code + BYTE_VALUE_COUNT }
                if code < FIRST_PRINTABLE_CHARACTER || code >= DELETE_CHARACTER {
                    quoted = "${quoted}${c_octal_escape(code)}"
                } otherwise {
                    quoted = "${quoted}${character}"
                }
            }
        }
    }
    return "${quoted}\""
}

// printf conversion for one interpolated value, or "" when it needs a helper.
fn format_spec(type_name string) -> string {
    if type_name == "bool" { return "" }
    if is_signed_int_name(type_name) { return "%lld" }
    if is_unsigned_int_name(type_name) { return "%llu" }
    if is_float_name(type_name) { return "%g" }
    return ""
}

// The string form of one interpolated part.
fn gen_part_as_string(generator ^CodeGen, part ^ast.AstNode) -> string {
    if part^.kind == ast.NodeKind.NIL_VALUE { return "gray_string_lit(\"nil\")" }
    part_type = expr_type(generator, part)
    if is_wide_name(part_type) { return "${wide_prefix(part_type)}_to_string(gray_default_arena, ${gen_expr(generator, part)})" }
    if part_type == "string" || is_string_enum(generator, part_type) { return gen_expr(generator, part) }
    if part_type == "bool" { return "(${gen_expr(generator, part)}) ? gray_string_lit(\"true\") : gray_string_lit(\"false\")" }
    if is_float_name(part_type) {
        bits = F64_BITS
        if part_type == "f32" { bits = F32_BITS }
        return "gray_builtin_format_floating_point(gray_default_arena, ${gen_expr(generator, part)}, ${bits})"
    }
    if part_type == "char" { return "gray_builtin_char_to_utf8(gray_default_arena, ${gen_expr(generator, part)})" }
    if is_array_type(part_type) || is_map_type(part_type) {
        if interpolated_container_needs_value_print(generator, part_type) {
            // printed the way println prints it, collected into a string
            id = next_print_id(generator)
            mut container_c = "GrayArray"
            if is_map_type(part_type) { container_c = "GrayMap" }
            first_line = "({ GrayFmtOut _gray_fo${id} = {0}; ${container_c} _gray_pv${id} = ${gen_expr(generator, part)};\n"
            return "${first_line}${indent_print_block(generator, value_print(generator, "_gray_pv${id}", part_type, "&_gray_fo${id}", false), 0)}gray_fmt_out_finish(gray_default_arena, &_gray_fo${id}); })"
        }
        mut element = array_element_type(part_type)
        if is_map_type(part_type) { element = map_value_type(part_type) }
        mut kind_tag i64 = INTERPOLATION_KIND_INTEGER
        if is_float_name(element) {
            kind_tag = INTERPOLATION_KIND_FLOAT
        } or element == "string" {
            kind_tag = INTERPOLATION_KIND_STRING
        } or element == "bool" {
            kind_tag = INTERPOLATION_KIND_BOOL
        } or element == "char" {
            kind_tag = INTERPOLATION_KIND_CHAR
        } or maps.contains_key(generator^.enums, eff(generator, element)) {
            kind_tag = INTERPOLATION_KIND_ENUM
            if is_string_enum(generator, element) { kind_tag = INTERPOLATION_KIND_STRING }
        }
        if is_map_type(part_type) { return "({ GrayMap _interp_map = ${gen_expr(generator, part)}; gray_builtin_map_to_string(gray_default_arena, &_interp_map, ${kind_tag}); })" }
        return "({ GrayArray _interp_arr = ${gen_expr(generator, part)}; gray_builtin_array_to_string(gray_default_arena, &_interp_arr, ${kind_tag}); })"
    }
    if part_type == "Error" {
        first = gen_expr(generator, part)
        second = gen_expr(generator, part)
        return "${first} ? ${second}->msg : gray_string_lit(\"nil\")"
    }
    if is_unsigned_int_name(part_type) { return "gray_string_format(gray_default_arena, \"%llu\", (unsigned long long)(${gen_expr(generator, part)}))" }
    if part_type == "UUID" { return "${gen_expr(generator, part)}.value" }
    if is_error_code_type(generator, part_type) { return "gray_string_lit(gray_error_code_name((int64_t)(${gen_expr(generator, part)})))" }
    return "gray_string_format(gray_default_arena, \"%lld\", (long long)(${gen_expr(generator, part)}))"
}

// True when an array or map interpolated into a string needs the statement-sequence printer: it
// holds structs, arrays, maps or pointers, or it is a map with a key that is not a string.
fn interpolated_container_needs_value_print(generator ^CodeGen, type_name string) -> bool {
    mut nested = ""
    if is_array_type(type_name) {
        nested = array_element_type(type_name)
    } or is_map_type(type_name) {
        nested = map_value_type(type_name)
        key_type = map_key_type(type_name)
        if key_type != "string" && !is_string_enum(generator, key_type) { return true }
    } otherwise {
        return false
    }
    inner = eff(generator, nested)
    if inner == "" { return false }
    if maps.contains_key(generator^.structs, inner) { return true }
    return is_array_type(inner) || is_map_type(inner) || strings.starts_with(inner, "^")
}

// True for an enum whose variants are string values: a GrayString at the C level.
fn is_string_enum(generator ^CodeGen, type_name string) -> bool {
    name = eff(generator, type_name)
    if !maps.contains_key(generator^.enums, name) { return false }
    for_each value in generator^.enums[name]^.enum_decl^.values {
        if value.value != nil && value.value^.kind == ast.NodeKind.STRING_VALUE { return true }
    }
    return false
}

// True for the open ErrorCode enum and for any `#error_code` enum: their values
// share one global slot space, and print as the variant name.
fn is_error_code_type(generator ^CodeGen, type_name string) -> bool {
    name = eff(generator, type_name)
    if name == "ErrorCode" { return true }
    return maps.contains_key(generator^.enums, name) && generator^.enums[name]^.enum_decl^.is_error_code
}

// `value` of Grayscale type `type_name` as a GrayString.
fn gen_value_as_string(generator ^CodeGen, type_name string, value string) -> string {
    if type_name == "string" { return value }
    if is_error_code_type(generator, type_name) { return "gray_string_lit(gray_error_code_name((int64_t)(${value})))" }
    if is_string_enum(generator, type_name) { return value }
    if type_name == "UUID" { return "(${value}).value" }
    if type_name == "Error" { return "({ GrayError *_gray_se = (${value}); _gray_se ? _gray_se->msg : gray_string_lit(\"nil\"); })" }
    if type_name == "bool" { return "(${value} ? gray_string_lit(\"true\") : gray_string_lit(\"false\"))" }
    if is_wide_name(type_name) { return "${wide_prefix(type_name)}_to_string(gray_default_arena, ${value})" }
    if is_signed_int_name(type_name) { return "gray_string_format(gray_default_arena, \"%lld\", (long long)(${value}))" }
    if is_unsigned_int_name(type_name) { return "gray_string_format(gray_default_arena, \"%llu\", (unsigned long long)(${value}))" }
    if is_float_name(type_name) {
        bits = F64_BITS
        if type_name == "f32" { bits = F32_BITS }
        return "gray_builtin_format_floating_point(gray_default_arena, ${value}, ${bits})"
    }
    if type_name == "char" { return "gray_builtin_char_to_utf8(gray_default_arena, ${value})" }
    // a number-valued enum prints as its value
    if maps.contains_key(generator^.enums, eff(generator, type_name)) { return "gray_string_format(gray_default_arena, \"%lld\", (long long)(${value}))" }
    return "gray_string_lit(\"?\")"
}

fn gen_interpolation(generator ^CodeGen, node ^ast.AstNode) -> string {
    parts = node^.interp_string^.parts
    if len(parts) == 0 { return "gray_string_lit(\"\")" }
    mut pieces [string] = {}
    for_each part in parts {
        arrays.append(pieces, gen_part_as_string(generator, part))
    }
    if len(pieces) == 1 { return pieces[0] }
    return "gray_string_concat_n(gray_default_arena, ${len(pieces)}, ${strings.join(pieces, ", ")})"
}

// The overflow-checked negation of `operand` for a signed non-wide integer type.
fn checked_negation(generator ^CodeGen, type_name string, operand string, line i64) -> string {
    sized_minimum, sized_maximum = sized_bounds(type_name)
    if sized_minimum != "" { return "gray_sized_neg_check(${operand}, ${sized_minimum}, ${sized_maximum}, \"${type_name}\", \"${generator^.file}\", ${line})" }
    return "gray_neg_check(${operand}, \"${generator^.file}\", ${line})"
}

fn gen_prefix(generator ^CodeGen, node ^ast.AstNode) -> string {
    mut right = gen_expr(generator, node^.prefix^.right)
    if node^.prefix^.right^.kind == ast.NodeKind.INFIX_EXPR { right = "(${right})" }
    when node^.prefix^.op {
        is token.TokenKind.BANG { return "(!${right})" }
        is token.TokenKind.MINUS {
            // the one literal whose magnitude does not fit an i64
            if node^.prefix^.right^.kind == ast.NodeKind.INT_VALUE && node^.prefix^.right^.int_value^.literal == "9223372036854775808" { return "(-9223372036854775807LL - 1)" }
            if is_wide_name(expr_type(generator, node)) { return "${wide_prefix(expr_type(generator, node))}_neg_checked(${right}, ${location_args(generator, node)})" }
            if is_signed_int_name(expr_type(generator, node)) { return checked_negation(generator, expr_type(generator, node), right, node^.tok.line) }
            return "(-${right})"
        }
        is token.TokenKind.BIT_NOT {
            operand_type = expr_type(generator, node^.prefix^.right)
            if is_wide_name(operand_type) { return "${wide_prefix(operand_type)}_not(${right})" }
            if table_type(generator, node^.prefix^.right) == "u8" || table_type(generator, node^.prefix^.right) == "u16" { return "((${c_type(operand_type)})(~(${right})))" }
            return "(~(${right}))"
        }
        default { return right }
    }
}

// `left bit_and right` and the other bitwise operators. A wide result makes
// the operation wide; a narrower operand is widened to it.
fn gen_bitwise(generator ^CodeGen, node ^ast.AstNode, operator token.TokenKind) -> string {
    left_node = node^.infix^.left
    right_node = node^.infix^.right
    result_type = expr_type(generator, node)
    if is_wide_name(result_type) {
        mut name = "xor"
        if operator == token.TokenKind.BIT_AND { name = "and" }
        if operator == token.TokenKind.BIT_OR { name = "or" }
        return "${wide_prefix(result_type)}_${name}(${gen_coerced(generator, result_type, left_node)}, ${gen_coerced(generator, result_type, right_node)})"
    }
    return "(${gen_expr(generator, left_node)} ${op_text(operator)} ${gen_expr(generator, right_node)})"
}

// The shift amount as the runtime's checked shifts take it.
fn shift_amount(generator ^CodeGen, amount ^ast.AstNode, maximum i64) -> string {
    amount_type = expr_type(generator, amount)
    if is_wide_name(amount_type) {
        return "${wide_prefix(amount_type)}_shift_amount(${gen_expr(generator, amount)}, ${maximum}, ${location_args(generator, amount)})"
    }
    return "(int64_t)(${gen_expr(generator, amount)})"
}

// A shift is done at the left operand's width, with the amount range-checked.
fn gen_shift(generator ^CodeGen, node ^ast.AstNode, operator token.TokenKind) -> string {
    left_node = node^.infix^.left
    right_node = node^.infix^.right
    left_type = expr_type(generator, left_node)
    if is_wide_name(left_type) {
        mut name = "shr"
        if operator == token.TokenKind.BIT_SHIFT_LEFT { name = "shl" }
        mut maximum = MAX_SHIFT_128
        if strings.contains(left_type, "256") { maximum = MAX_SHIFT_256 }
        return "${wide_prefix(left_type)}_${name}(${gen_expr(generator, left_node)}, ${shift_amount(generator, right_node, maximum)}, ${location_args(generator, node)})"
    }
    mut shift_name = left_type
    if left_type == "char" { shift_name = "i32" }
    mut bits = F64_BITS
    mut c_name = "int64_t"
    if is_unsigned_int_name(left_type) { c_name = "uint64_t" }
    mut unsigned_name = "uint64_t"
    when shift_name {
        is "i8" { bits = 8; c_name = "int8_t"; unsigned_name = "uint8_t" }
        is "u8" { bits = 8; c_name = "uint8_t"; unsigned_name = "uint8_t" }
        is "i16" { bits = 16; c_name = "int16_t"; unsigned_name = "uint16_t" }
        is "u16" { bits = 16; c_name = "uint16_t"; unsigned_name = "uint16_t" }
        is "i32" { bits = 32; c_name = "int32_t"; unsigned_name = "uint32_t" }
        is "u32" { bits = 32; c_name = "uint32_t"; unsigned_name = "uint32_t" }
    }
    mut width_type = c_name
    if operator == token.TokenKind.BIT_SHIFT_LEFT { width_type = unsigned_name }
    return "({ int64_t _sa = ${shift_amount(generator, right_node, bits - 1)}; if (_sa < 0 || _sa >= ${bits}) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0092\", \"shift amount %lld is out of range; must be in [0, %d] for this operand type\", (long long)_sa, ${bits - 1}); } (${c_name})((${width_type})(${gen_expr(generator, left_node)}) ${op_text(operator)} (int)_sa); })"
}

// The wide integer type an operation on operands of these types runs in, or ""
// when neither operand is wide.
fn wider_wide_type(left_type string, right_type string) -> string {
    if !is_wide_name(left_type) && !is_wide_name(right_type) { return "" }
    if !is_wide_name(right_type) { return left_type }
    if !is_wide_name(left_type) { return right_type }
    if strings.contains(right_type, "256") { return right_type }
    return left_type
}

// `x in collection` and `x not_in collection`: a range, map, string or array membership test.
fn gen_membership(generator ^CodeGen, node ^ast.AstNode) -> string {
    mut negation string = ""
    if node^.infix^.op == token.TokenKind.NOT_IN { negation = "!" }
    left_node = node^.infix^.left
    right_node = node^.infix^.right
    inline_wide = ""
    if right_node^.kind == ast.NodeKind.RANGE_EXPR {
        inline_wide = range_wide_type(generator, expr_type(generator, left_node), right_node^.range_expr)
    }
    if right_node^.kind == ast.NodeKind.RANGE_EXPR && inline_wide != "" {
        return "${negation}${in_wide_range_text(generator, left_node, inline_wide, right_node^.range_expr, node)}"
    }
    if right_node^.kind == ast.NodeKind.RANGE_EXPR && right_node^.range_expr^.step == nil {
        test = "(${gen_expr(generator, left_node)} >= ${range_start_or_zero(generator, right_node^.range_expr)} && ${gen_expr(generator, left_node)} < ${gen_expr(generator, right_node^.range_expr^.end_expr)})"
        if negation != "" { return "!(${test})" }
        return test
    }
    right_type = expr_type(generator, right_node)
    if strings.starts_with(right_type, "Range<") {
        // a range kept in a variable: a zero step panics where the range is used
        element = range_element(right_type)
        range_c = "GrayRange_${element}"
        id = next_id(generator)
        mut subject_c = "int64_t"
        if element != "i64" { subject_c = "gray_${element}" }
        return "${negation}({ ${subject_c} _gray_subject_${id} = ${gen_expr(generator, left_node)}; ${range_c} _gray_range_${id} = ${gen_expr(generator, right_node)}; if (${range_c}_has_zero_step(_gray_range_${id})) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0090\", \"range step cannot be zero\"); } ${range_c}_contains(_gray_range_${id}, _gray_subject_${id}, ${location_args(generator, node)}); })"
    }
    if strings.starts_with(right_type, "map[") {
        generator^.needs_maps_header = true
        key_c = map_slot_c(generator, map_key_type(right_type))
        membership_id = next_id(generator)
        map_text = gen_expr(generator, right_node)
        key_text = gen_coerced(generator, map_key_type(right_type), left_node)
        return "${negation}({ __auto_type _im${membership_id} = ${map_text}; ${key_c} _ik${membership_id} = ${key_text}; gray_maps_contains_key(&_im${membership_id}, &_ik${membership_id}); })"
    }
    if right_type == "string" {
        if expr_type(generator, left_node) == "char" {
            return "${negation}(memchr(${gen_expr(generator, right_node)}.data, ${gen_expr(generator, left_node)}, (size_t)${gen_expr(generator, right_node)}.len) != NULL)"
        }
        generator^.needs_strings_header = true
        return "${negation}gray_strings_contains(${gen_expr(generator, right_node)}, ${gen_expr(generator, left_node)})"
    }
    generator^.needs_arrays_header = true
    if strings.starts_with(right_type, "[") {
        id = next_id(generator)
        element_c = ctype(generator, array_element_type(right_type))
        return "${negation}({ ${element_c} _av${id} = ${gen_expr(generator, left_node)}; gray_arrays_contains(${address_of_arg(generator, right_node)}, &_av${id}); })"
    }
    return "${negation}gray_arrays_contains(${address_of_arg(generator, right_node)}, ${address_of_arg(generator, left_node)})"
}

// The sized integer bounds as C literals: minimum and maximum, or "" for a type with no sized check.
fn sized_bounds(type_name string) -> (string, string) {
    if type_name == "i8" { return "-128", "127" }
    if type_name == "i16" { return "-32768", "32767" }
    if type_name == "i32" { return "-2147483648LL", "2147483647LL" }
    if type_name == "u8" { return "", "255" }
    if type_name == "u16" { return "", "65535" }
    if type_name == "u32" { return "", "4294967295ULL" }
    return "", ""
}

// `left operator right` for + - * / % computed in the number type `type_name`: overflow checks on
// + - *, division by zero and MIN / -1 on / and %. Returns "" for a type with no check.
fn checked_arithmetic(generator ^CodeGen, node ^ast.AstNode, type_name string, operator token.TokenKind, left string, right string) -> string {
    is_division = operator == token.TokenKind.SLASH || operator == token.TokenKind.PERCENT
    if !is_division && operator != token.TokenKind.PLUS && operator != token.TokenKind.MINUS && operator != token.TokenKind.ASTERISK { return "" }
    line = node^.tok.line
    if is_float_name(type_name) {
        if !is_division { return "" }
        mut float_c_name = "double"
        if type_name == "f32" { float_c_name = "float" }
        return "({ ${float_c_name} _dv = ${right}; if (_dv == 0) { gray_panic_code_at(\"${generator^.file}\", ${line}, \"P0078\", \"division by zero\"); } (${float_c_name})${left} / _dv; })"
    }
    is_unsigned = is_unsigned_int_name(type_name) && !is_wide_name(type_name)
    is_signed = (is_signed_int_name(type_name) && !is_wide_name(type_name)) || type_name == "char"
    if !is_unsigned && !is_signed { return "" }
    sized_minimum, sized_maximum = sized_bounds(type_name)
    is_sized = sized_maximum != ""
    if is_division {
        what = "modulo"
        c_operator = "%"
        if operator == token.TokenKind.SLASH {
            what = "division"
            c_operator = "/"
        }
        if is_unsigned {
            return "({ __auto_type _dv = ${right}; if (!_dv) { gray_panic_code_at(\"${generator^.file}\", ${line}, \"P0078\", \"division by zero\"); } ${left} ${c_operator} _dv; })"
        }
        mut minimum_text = "(-9223372036854775807LL - 1)"
        if is_sized { minimum_text = sized_minimum }
        return "({ __auto_type _dv = ${right}; if (!_dv) { gray_panic_code_at(\"${generator^.file}\", ${line}, \"P0078\", \"division by zero\"); } __auto_type _dn = ${left}; if ((int64_t)_dn == ${minimum_text} && _dv == -1) { gray_panic_code_at(\"${generator^.file}\", ${line}, \"P0079\", \"%s result is too large; value exceeds the range of this type\", \"${what}\"); } _dn ${c_operator} _dv; })"
    }
    mut verb = "mul"
    if operator == token.TokenKind.PLUS { verb = "add" }
    if operator == token.TokenKind.MINUS { verb = "sub" }
    if is_sized {
        if is_unsigned { return "gray_usized_${verb}_check(${left}, ${right}, ${sized_maximum}, \"${type_name}\", \"${generator^.file}\", ${line})" }
        return "gray_sized_${verb}_check(${left}, ${right}, ${sized_minimum}, ${sized_maximum}, \"${type_name}\", \"${generator^.file}\", ${line})"
    }
    if is_unsigned { return "gray_u${verb}_check(${left}, ${right}, \"${generator^.file}\", ${line})" }
    return "gray_${verb}_check(${left}, ${right}, \"${generator^.file}\", ${line})"
}

fn gen_infix(generator ^CodeGen, node ^ast.AstNode) -> string {
    bit_op = node^.infix^.op
    if bit_op == token.TokenKind.IN || bit_op == token.TokenKind.NOT_IN { return gen_membership(generator, node) }
    if bit_op == token.TokenKind.BIT_AND || bit_op == token.TokenKind.BIT_OR || bit_op == token.TokenKind.BIT_XOR {
        return gen_bitwise(generator, node, bit_op)
    }
    if bit_op == token.TokenKind.BIT_SHIFT_LEFT || bit_op == token.TokenKind.BIT_SHIFT_RIGHT {
        return gen_shift(generator, node, bit_op)
    }
    mut left = gen_expr(generator, node^.infix^.left)
    mut right = gen_expr(generator, node^.infix^.right)
    operator = node^.infix^.op
    operand_type = expr_type(generator, node^.infix^.left)
    // a decimal literal takes the f32 type of the value it meets
    if operand_type == "f32" && node^.infix^.right^.kind == ast.NodeKind.FLOAT_VALUE { right = float_literal_f32(node^.infix^.right) }
    if expr_type(generator, node^.infix^.right) == "f32" && node^.infix^.left^.kind == ast.NodeKind.FLOAT_VALUE { left = float_literal_f32(node^.infix^.left) }

    if is_string_enum(generator, operand_type) {
        if operator == token.TokenKind.EQ { return "gray_string_eq(${left}, ${right})" }
        if operator == token.TokenKind.NOT_EQ { return "!gray_string_eq(${left}, ${right})" }
    }
    if operand_type == "string" {
        if operator == token.TokenKind.PLUS { return "gray_string_concat(gray_default_arena, ${left}, ${right})" }
        if operator == token.TokenKind.EQ { return "gray_string_eq(${left}, ${right})" }
        if operator == token.TokenKind.NOT_EQ { return "!gray_string_eq(${left}, ${right})" }
    }

    // an operation with a wide operand runs at the wider of the operand types;
    // the narrower operand is widened to it
    wide_type = wider_wide_type(operand_type, expr_type(generator, node^.infix^.right))
    if wide_type != "" {
        wide_result = wide_binary(wide_prefix(wide_type), operator, gen_coerced(generator, wide_type, node^.infix^.left), gen_coerced(generator, wide_type, node^.infix^.right), location_args(generator, node))
        if wide_result != "" { return wide_result }
    }

    mut result_type = expr_type(generator, node)
    if result_type == "" { result_type = operand_type }
    checked_result = checked_arithmetic(generator, node, result_type, operator, "(${left})", "(${right})")
    if checked_result != "" { return checked_result }

    if operator == token.TokenKind.PLUS || operator == token.TokenKind.MINUS || operator == token.TokenKind.ASTERISK || operator == token.TokenKind.SLASH || operator == token.TokenKind.PERCENT {
        return "((${left}) ${op_text(operator)} (${right}))"
    }
    // a nested infix keeps the precedence the parser gave it
    if node^.infix^.left^.kind == ast.NodeKind.INFIX_EXPR { left = "(${left})" }
    if node^.infix^.right^.kind == ast.NodeKind.INFIX_EXPR { right = "(${right})" }
    return "${left} ${op_text(operator)} ${right}"
}

// Division and modulo trap on a zero divisor and on MIN / -1.
fn gen_division(generator ^CodeGen, node ^ast.AstNode, left string, right string, operator string, what string) -> string {
    line = node^.tok.line
    return "({ __auto_type _dv = (${right}); if (!_dv) { gray_panic_code_at(\"${generator^.file}\", ${line}, \"P0078\", \"division by zero\"); } __auto_type _dn = (${left}); if ((int64_t)_dn == (-9223372036854775807LL - 1) && _dv == -1) { gray_panic_code_at(\"${generator^.file}\", ${line}, \"P0079\", \"%s result is too large; value exceeds the range of this type\", \"${what}\"); } _dn ${operator} _dv; })"
}

fn gen_struct_literal(generator ^CodeGen, node ^ast.AstNode) -> string {
    data = node^.struct_value
    mut field_inits [string] = {}
    mut given [string:bool] = {:}
    // field values that call functions run in the order written: when that is not declaration order they are bound to temporaries first
    mut hoist_text = ""
    mut hoisted_names [string] = {}
    for i in range(0, len(data^.field_names)) { arrays.append(hoisted_names, "") }
    if maps.contains_key(generator^.structs, data^.name) {
        mut hoistable_count i64 = 0
        mut previous_index i64 = -1
        mut is_out_of_order = false
        for i in range(0, len(data^.field_names)) {
            if !expression_can_be_hoisted(data^.field_values[i]) { continue }
            hoistable_count = hoistable_count + 1
            mut declared_index i64 = -1
            declared_fields_list = generator^.structs[data^.name]^.struct_decl^.struct_fields
            for field_index in range(0, len(declared_fields_list)) {
                if declared_index < 0 && declared_fields_list[field_index].name == data^.field_names[i] { declared_index = field_index }
            }
            if declared_index < previous_index { is_out_of_order = true }
            previous_index = declared_index
        }
        if hoistable_count >= 2 && is_out_of_order {
            hoist_id = next_id(generator)
            for i in range(0, len(data^.field_names)) {
                if !expression_can_be_hoisted(data^.field_values[i]) { continue }
                hoisted_names[i] = "_gray_sf${hoist_id}_${i}"
                hoist_text = "${hoist_text}__auto_type ${hoisted_names[i]} = ${gen_expr(generator, data^.field_values[i])}; "
            }
        }
    }
    for i in range(0, len(data^.field_names)) {
        given[data^.field_names[i]] = true
        if maps.contains_key(generator^.structs, data^.name) {
            for_each declared in generator^.structs[data^.name]^.struct_decl^.struct_fields {
                if declared.name == data^.field_names[i] { expect_type(data^.field_values[i], declared.type_name) }
            }
        }
        // a short array literal written into a fixed-size field is padded inside the literal
        saved_fill = data^.field_values[i]^.zero_fill_length
        if data^.field_values[i]^.kind == ast.NodeKind.ARRAY_VALUE { data^.field_values[i]^.zero_fill_length = 0 }
        mut declared_field_type = ""
        if maps.contains_key(generator^.structs, data^.name) {
            for_each declared in generator^.structs[data^.name]^.struct_decl^.struct_fields {
                if declared.name == data^.field_names[i] { declared_field_type = declared.type_name }
            }
        }
        mut field_value = ""
        if hoisted_names[i] != "" {
            field_value = hoisted_names[i]
        } or declared_field_type != "" {
            field_value = gen_stored(generator, declared_field_type, data^.field_values[i])
        } otherwise {
            field_value = gen_expr(generator, data^.field_values[i])
        }
        data^.field_values[i]^.zero_fill_length = saved_fill
        arrays.append(field_inits, ".${data^.field_names[i]} = ${field_value}")
    }
    // Declared defaults fill the fields the literal leaves out
    if maps.contains_key(generator^.structs, data^.name) {
        declaration = generator^.structs[data^.name]
        declared_fields = declaration^.struct_decl^.struct_fields
        for_each field in declared_fields {
            if field.default_value != nil && !maps.contains_key(given, field.name) {
                expect_type(field.default_value, field.type_name)
                arrays.append(field_inits, ".${field.name} = ${gen_expr(generator, field.default_value)}")
            } or !maps.contains_key(given, field.name) {
                zero_text = zero_value_text(generator, field.type_name)
                if zero_text != "" { arrays.append(field_inits, ".${field.name} = ${zero_text}") }
            }
        }
    }
    literal_text = "((${ctype(generator, data^.name)}){${strings.join(field_inits, ", ")}})"
    if hoist_text != "" { return "({ ${hoist_text}${literal_text}; })" }
    return literal_text
}

// An array or map literal takes the type its context declares.
fn expect_type(node ^ast.AstNode, type_name string) {
    if node == nil || type_name == "" || type_name == "unknown" { return }
    if node^.kind == ast.NodeKind.ARRAY_VALUE || node^.kind == ast.NodeKind.MAP_VALUE {
        node^.resolved_type = type_name
    }
    // `json.parse(text)` parses into the type the place it is stored in declares
    if node^.kind == ast.NodeKind.CALL_EXPR && node^.call^.function^.kind == ast.NodeKind.MEMBER_EXPR && node^.call^.function^.member^.object^.kind == ast.NodeKind.LABEL && node^.call^.function^.member^.object^.label^.value == "json" && node^.call^.function^.member^.member == "parse" {
        node^.resolved_type = type_name
    }
    // A nested literal takes the element type of the array around it
    if node^.kind == ast.NodeKind.ARRAY_VALUE && strings.starts_with(type_name, "[") {
        element_written = array_element_type(type_name)
        for_each element in node^.array_value^.elements {
            if element^.kind == ast.NodeKind.ARRAY_VALUE { expect_type(element, element_written) }
        }
    }
    // `.Variant(payload)` takes the enum the place expects
    if node^.kind == ast.NodeKind.CALL_EXPR && node^.call^.function^.kind == ast.NodeKind.IMPLICIT_ENUM {
        node^.resolved_type = type_name
    }
}

fn gen_array_literal(generator ^CodeGen, node ^ast.AstNode) -> string {
    element_type = ctype(generator, array_element_type(expr_type(generator, node)))
    // a string-backed enum is stored as its string
    if is_string_enum(generator, array_element_type(expr_type(generator, node))) { element_type = "GrayString" }
    elements = node^.array_value^.elements
    if len(elements) == 0 {
        // a fixed-size array written {} leaves every slot to C's zero fill
        if fixed_array_size(generator, expr_type(generator, node)) > 0 && zero_value_text(generator, array_element_type(expr_type(generator, node))) == "" {
            literal_size = fixed_array_size(generator, expr_type(generator, node))
            return "gray_array_from(gray_default_arena, (${element_type}[${literal_size}]){}, sizeof(${element_type}), ${literal_size}, GRAY_ELEM_KIND_OF(${element_type}))"
        }
        return empty_array_text(generator, expr_type(generator, node))
    }
    element_written = array_element_type(expr_type(generator, node))
    mut pieces [string] = {}
    for_each element in elements { arrays.append(pieces, gen_stored(generator, element_written, element)) }
    // [T, N] with fewer than N elements: the slots past the written ones are zero
    mut count = len(elements)
    array_text = expr_type(generator, node)
    declared_size = fixed_array_size(generator, array_text)
    if declared_size > count {
        slot_zero = zero_value_text(generator, element_written)
        if slot_zero != "" {
            for slot in range(count, declared_size) { arrays.append(pieces, slot_zero) }
        }
        count = declared_size
    }
    mut element_kind = "GRAY_ELEM_KIND_OF(${element_type})"
    // rows that are themselves literals, and maps, have kinds of their own
    if elements[0]^.kind == ast.NodeKind.ARRAY_VALUE { element_kind = "GRAY_ELEM_ARRAY" }
    if elements[0]^.kind == ast.NodeKind.MAP_VALUE { element_kind = "GRAY_ELEM_MAP" }
    return "gray_array_from(gray_default_arena, (${element_type}[${count}]){${strings.join(pieces, ", ")}}, sizeof(${element_type}), ${count}, ${element_kind})"
}

// The initial capacity of a map literal with this many entries.
fn map_literal_capacity(count i64) -> i64 {
    if count > MAP_LITERAL_GROWTH_THRESHOLD { return count * MAP_LITERAL_CAPACITY_FACTOR }
    return MAP_LITERAL_MIN_CAPACITY
}

fn gen_map_literal(generator ^CodeGen, node ^ast.AstNode) -> string {
    key_c = map_slot_c(generator, map_key_type(expr_type(generator, node)))
    value_c = map_slot_c(generator, map_value_type(expr_type(generator, node)))
    id = next_id(generator)
    mut sets [string] = {}
    keys = node^.map_value^.keys
    values = node^.map_value^.values
    for i in range(0, len(keys)) {
        arrays.append(sets, "{ ${key_c} _mk = ${gen_stored(generator, map_key_type(expr_type(generator, node)), keys[i])}; ${value_c} _mv = ${gen_stored(generator, map_value_type(expr_type(generator, node)), values[i])}; gray_map_set(gray_default_arena, &_ml${id}, &_mk, &_mv, \"${generator^.file}\", ${node^.tok.line}); }")
    }
    mut joined_sets = strings.join(sets, " ")
    if joined_sets != "" { joined_sets = "${joined_sets} " }
    return "({ GrayMap _ml${id} = GRAY_MAP_NEW_OF(gray_default_arena, ${key_c}, ${value_c}, ${map_literal_capacity(len(keys))}); ${joined_sets}_ml${id}; })"
}

// A subscript base that is built where it stands: a call, an array or map literal, or a member of one.
fn index_base_is_temporary(left ^ast.AstNode) -> bool {
    if left == nil { return false }
    when left^.kind {
        is ast.NodeKind.CALL_EXPR, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE { return true }
        is ast.NodeKind.MEMBER_EXPR { return index_base_is_temporary(left^.member^.object) }
        default { return false }
    }
}

// True when `left` is itself a map lookup, which lowers to a value with no address.
fn index_left_is_map_lookup(generator ^CodeGen, left ^ast.AstNode) -> bool {
    if left == nil || left^.kind != ast.NodeKind.INDEX_EXPR { return false }
    return is_map_type(expr_type(generator, left^.index_data^.left))
}

// True when subscripting `node` lowers to a statement expression, whose value has no address.
fn index_lowers_to_rvalue(generator ^CodeGen, node ^ast.AstNode) -> bool {
    if node == nil || node^.kind != ast.NodeKind.INDEX_EXPR { return false }
    left = node^.index_data^.left
    if index_base_is_temporary(left) { return true }
    if index_left_is_map_lookup(generator, left) { return true }
    if is_deref(left) { return true }
    if left^.kind == ast.NodeKind.MEMBER_EXPR {
        object = left^.member^.object
        if strings.starts_with(expr_type(generator, object), "^") { return true }
        if is_deref(object) { return true }
    }
    if left^.kind == ast.NodeKind.INDEX_EXPR { return index_lowers_to_rvalue(generator, left) }
    return false
}

// The C type a GrayArray stores an element of this type as.
fn array_slot_c(generator ^CodeGen, element_type string) -> string {
    resolved = eff(generator, element_type)
    if is_string_enum(generator, resolved) { return "GrayString" }
    return ctype(generator, element_type)
}

fn gen_index(generator ^CodeGen, node ^ast.AstNode) -> string {
    left = node^.index_data^.left
    left_type = expr_type(generator, left)
    if is_array_type(left_type) {
        element_c = array_slot_c(generator, array_element_type(left_type))
        panic_text = "gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0080\", \"nil pointer dereference\")"
        // an array held in a field of a pointee, or a pointee itself: the nil check is hoisted and
        // the element's address taken off the pointer
        mut pointer_object ^ast.AstNode = nil
        mut pointer_field = ""
        if left^.kind == ast.NodeKind.MEMBER_EXPR {
            member_object = left^.member^.object
            if strings.starts_with(expr_type(generator, member_object), "^") {
                pointer_object = member_object
                pointer_field = left^.member^.member
            } or is_deref(member_object) {
                pointer_object = member_object^.postfix^.left
                pointer_field = left^.member^.member
            }
        }
        if pointer_object != nil {
            is_raw = pointer_object^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, pointer_object^.label^.value)
            id = next_id(generator)
            pointer_text = gen_expr(generator, pointer_object)
            mut guard = "; if (!_adp${id}) { ${panic_text}; } "
            if is_raw { guard = "; " }
            return "(*(${element_c} *)({ __auto_type _adp${id} = ${pointer_text}${guard}gray_array_get_ptr(&_adp${id}->${pointer_field}, ${gen_expr(generator, node^.index_data^.index_expr)}, ${location_args(generator, node)}); }))"
        }
        if is_deref(left) {
            array_pointer = left^.postfix^.left
            is_raw = array_pointer^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, array_pointer^.label^.value)
            id = next_id(generator)
            pointer_text = gen_expr(generator, array_pointer)
            mut guard = "; if (!_adp${id}) { ${panic_text}; } "
            if is_raw { guard = "; " }
            return "(*(${element_c} *)({ __auto_type _adp${id} = ${pointer_text}${guard}gray_array_get_ptr(_adp${id}, ${gen_expr(generator, node^.index_data^.index_expr)}, ${location_args(generator, node)}); }))"
        }
        // an array that is a temporary has no address: it is held first
        if index_base_is_temporary(left) || index_left_is_map_lookup(generator, left) || (left^.kind == ast.NodeKind.INDEX_EXPR && index_lowers_to_rvalue(generator, left)) {
            id = next_id(generator)
            left_text = gen_expr(generator, left)
            return "({ GrayArray _ea${id} = ${left_text}; GRAY_ARRAY_GET_AT(_ea${id}, ${element_c}, ${gen_expr(generator, node^.index_data^.index_expr)}, ${location_args(generator, node)}); })"
        }
        left_text = gen_expr(generator, left)
        return "GRAY_ARRAY_GET_AT(${left_text}, ${element_c}, ${gen_expr(generator, node^.index_data^.index_expr)}, ${location_args(generator, node)})"
    }
    if is_map_type(left_type) {
        key_c = map_slot_c(generator, map_key_type(left_type))
        value_c = map_slot_c(generator, map_value_type(left_type))
        mut map_is_rvalue = left^.kind == ast.NodeKind.INDEX_EXPR || index_base_is_temporary(left)
        if !map_is_rvalue && left^.kind == ast.NodeKind.MEMBER_EXPR {
            member_object = left^.member^.object
            if strings.starts_with(expr_type(generator, member_object), "^") || is_deref(member_object) { map_is_rvalue = true }
        }
        if !map_is_rvalue && is_deref(left) { map_is_rvalue = true }
        panic_text = "gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0081\", \"key not found in map\")"
        if map_is_rvalue {
            left_text = gen_expr(generator, left)
            key_text = gen_coerced(generator, map_key_type(left_type), node^.index_data^.index_expr)
            return "(*(${value_c} *)({ GrayMap _mt = ${left_text}; ${key_c} _mk = ${key_text}; void *_mv = gray_map_get(&_mt, &_mk); if (!_mv) { ${panic_text}; } _mv; }))"
        }
        key_text = gen_coerced(generator, map_key_type(left_type), node^.index_data^.index_expr)
        return "(*(${value_c} *)({ ${key_c} _mk = ${key_text}; void *_mv = gray_map_get(&${gen_expr(generator, left)}, &_mk); if (!_mv) { ${panic_text}; } _mv; }))"
    }
    index = gen_expr(generator, node^.index_data^.index_expr)
    if left_type == "string" {
        return "({ GrayString _es = ${gen_expr(generator, left)}; int64_t _ei = (int64_t)(${index}); if (_ei < 0 || _ei >= _es.len) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0082\", \"string index %lld out of bounds (length %d)\", (long long)_ei, _es.len); } (int32_t)(unsigned char)_es.data[_ei]; })"
    }
    return "${gen_expr(generator, left)}[${index}]"
}

// A pointer to the value of `arg`, which may be a temporary.
fn address_of_arg(generator ^CodeGen, arg ^ast.AstNode) -> string {
    // Anything reached through a pointer is held and nil-checked first, and the address is
    // taken off the pointer itself, which is already an assignable target.
    mut pointer_expression ^ast.AstNode = nil
    mut field_path [string] = {}
    if arg^.kind == ast.NodeKind.MEMBER_EXPR {
        mut current = arg
        as_long_as current^.kind == ast.NodeKind.MEMBER_EXPR && len(field_path) < MAX_FIELD_PATH_DEPTH {
            object = current^.member^.object
            arrays.append(field_path, current^.member^.member)
            object_is_reference = object^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, object^.label^.value)
            if !object_is_reference && strings.starts_with(expr_type(generator, object), "^") {
                pointer_expression = object
                break
            }
            if is_deref(object) {
                pointer_expression = object^.postfix^.left
                break
            }
            current = object
        }
        if pointer_expression == nil { field_path = {} }
    } or is_deref(arg) {
        pointer_expression = arg^.postfix^.left
    }
    if pointer_expression != nil {
        is_raw = pointer_expression^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.raw_names, pointer_expression^.label^.value)
        if is_raw && len(field_path) == 0 { return gen_expr(generator, pointer_expression) }
        id = next_id(generator)
        mut held = "({ __auto_type _ap${id} = ${gen_expr(generator, pointer_expression)}; "
        if !is_raw { held = "${held}if (!_ap${id}) { gray_panic_code_at(\"${generator^.file}\", ${arg^.tok.line}, \"P0080\", \"nil pointer dereference\"); } " }
        if len(field_path) > 0 {
            mut path_text = "&_ap${id}"
            mut position = len(field_path) - 1
            as_long_as position >= 0 {
                separator = "."
                if position == len(field_path) - 1 { separator = "->" }
                path_text = "${path_text}${separator}${field_path[position]}"
                position = position - 1
            }
            return "${held}${path_text}; })"
        }
        return "${held}_ap${id}; })"
    }
    value = gen_expr(generator, arg)
    // `Color.BLUE` is a constant, not a place
    names_constant = arg^.kind == ast.NodeKind.MEMBER_EXPR && arg^.member^.object^.kind == ast.NodeKind.LABEL && maps.contains_key(generator^.enums, arg^.member^.object^.label^.value)
    if !names_constant && (arg^.kind == ast.NodeKind.LABEL || arg^.kind == ast.NodeKind.MEMBER_EXPR || arg^.kind == ast.NodeKind.INDEX_EXPR || arg^.kind == ast.NodeKind.POSTFIX_EXPR) && !is_rvalue_container(arg) {
        return "&${value}"
    }
    // a value with no address of its own is staged as a one-element array, which decays to the
    // pointer the callee wants and lives as long as the enclosing block
    return "(__typeof__(${value})[]){${value}}"
}

// --- Calls ---

fn gen_args(generator ^CodeGen, arguments [^ast.AstNode]) -> string {
    mut pieces [string] = {}
    for_each arg in arguments { arrays.append(pieces, gen_expr(generator, arg)) }
    return strings.join(pieces, ", ")
}

// --- Copy semantics ---
//
// A value "needs a deep copy" when a plain C copy of it would share mutable
// backing storage with the source: arrays, maps, and structs holding either.
// Pointers alias on purpose.

fn needs_copy_walk(generator ^CodeGen, written_type string, count_strings bool) -> bool {
    type_name = eff(generator, written_type)
    if type_name == "" { return false }
    if is_array_type(type_name) || is_map_type(type_name) { return true }
    if type_name == "string" { return count_strings }
    if strings.starts_with(type_name, "^") { return false }
    if !maps.contains_key(generator^.structs, type_name) {
        // a tagged enum holds whatever its variants' payloads hold
        if is_tagged_enum(generator, type_name) {
            if arrays.contains(generator^.copy_walk, type_name) { return false }
            arrays.append(generator^.copy_walk, type_name)
            mut enum_found = false
            for_each variant in generator^.enums[type_name]^.enum_decl^.values {
                for_each payload_type in variant.payload_types {
                    if needs_copy_walk(generator, payload_type, count_strings) { enum_found = true }
                }
            }
            _ = arrays.remove_last(generator^.copy_walk)
            return enum_found
        }
        // the stdlib HttpResponse holds a string and a headers map
        return type_name == "HttpResponse"
    }
    if arrays.contains(generator^.copy_walk, type_name) { return false }
    arrays.append(generator^.copy_walk, type_name)
    mut found = false
    for_each field in generator^.structs[type_name]^.struct_decl^.struct_fields {
        if needs_copy_walk(generator, field.type_name, count_strings) { found = true }
    }
    _ = arrays.remove_last(generator^.copy_walk)
    return found
}

fn type_shares_storage(generator ^CodeGen, type_name string) -> bool {
    return needs_copy_walk(generator, type_name, false)
}

fn names_existing_storage(node ^ast.AstNode) -> bool {
    if node == nil { return false }
    when node^.kind {
        is ast.NodeKind.LABEL { return true }
        is ast.NodeKind.MEMBER_EXPR { return true }
        is ast.NodeKind.INDEX_EXPR { return true }
        is ast.NodeKind.POSTFIX_EXPR { return node^.postfix^.op == token.TokenKind.CARET }
        default { return false }
    }
}

// A C expression for an independent copy of `source` (a C variable) of this type.
fn value_deep_copy(generator ^CodeGen, written_type string, source string) -> string {
    type_name = eff(generator, written_type)
    if !needs_copy_walk(generator, type_name, true) { return source }
    if type_name == "string" { return "gray_string_new(gray_default_arena, ${source}.data, ${source}.len)" }
    if is_array_type(type_name) { return array_deep_copy(generator, type_name, source) }
    if is_map_type(type_name) { return map_deep_copy(generator, type_name, source) }
    if !maps.contains_key(generator^.structs, type_name) && is_tagged_enum(generator, type_name) { return enum_deep_copy(generator, type_name, source) }
    if !maps.contains_key(generator^.structs, type_name) && type_name == "HttpResponse" { return http_response_deep_copy(generator, source) }
    return struct_deep_copy(generator, type_name, source)
}

fn array_deep_copy(generator ^CodeGen, type_name string, source string) -> string {
    element = array_element_type(type_name)
    if !needs_copy_walk(generator, element, true) { return "gray_array_copy(gray_default_arena, &${source})" }
    id = next_id(generator)
    c_element = ctype(generator, element)
    element_source = "((${c_element} *)_ds${id}.data)[_di${id}]"
    return "({ GrayArray _ds${id} = ${source}; GrayArray _dd${id} = GRAY_ARRAY_NEW_OF(gray_default_arena, ${c_element}, _ds${id}.len); _dd${id}.len = _ds${id}.len; for (int32_t _di${id} = 0; _di${id} < _ds${id}.len; _di${id}++) { ${c_element} _de${id} = ${value_deep_copy(generator, element, element_source)}; ((${c_element} *)_dd${id}.data)[_di${id}] = _de${id}; } _dd${id}; })"
}

fn map_deep_copy(generator ^CodeGen, type_name string, source string) -> string {
    key_type = map_key_type(type_name)
    value_type = map_value_type(type_name)
    if !needs_copy_walk(generator, value_type, true) { return "gray_map_copy(gray_default_arena, &${source})" }
    id = next_id(generator)
    c_key = ctype(generator, key_type)
    c_value = ctype(generator, value_type)
    mut key_copy = ""
    if key_type == "string" { key_copy = "_mk${id} = gray_string_new(gray_default_arena, _mk${id}.data, _mk${id}.len); " }
    return "({ GrayMap _ms${id} = ${source}; GrayMap _md${id} = gray_map_new_kind(gray_default_arena, _ms${id}.key_size, _ms${id}.value_size, _ms${id}.order_len > 4 ? _ms${id}.order_len * 2 : 8, _ms${id}.key_kind, _ms${id}.value_kind); for (int32_t _mi${id} = 0; _mi${id} < _ms${id}.order_len; _mi${id}++) { int32_t _mslot${id} = _ms${id}.order[_mi${id}]; if (_mslot${id} < 0) continue; ${c_key} _mk${id} = *(${c_key} *)gray_map_key_at(&_ms${id}, _mslot${id}); ${c_value} _mvs${id} = *(${c_value} *)gray_map_value_at(&_ms${id}, _mslot${id}); ${c_value} _mvd${id} = ${value_deep_copy(generator, value_type, "_mvs${id}")}; ${key_copy}gray_map_set(gray_default_arena, &_md${id}, &_mk${id}, &_mvd${id}, __FILE__, __LINE__); } _md${id}; })"
}

fn struct_deep_copy(generator ^CodeGen, type_name string, source string) -> string {
    if arrays.contains(generator^.copy_walk, type_name) { return source }
    arrays.append(generator^.copy_walk, type_name)
    id = next_id(generator)
    c_struct = ctype(generator, type_name)
    mut text = "({ ${c_struct} _ss${id} = ${source}; ${c_struct} _sd${id} = _ss${id}; "
    for_each field in generator^.structs[type_name]^.struct_decl^.struct_fields {
        if !needs_copy_walk(generator, field.type_name, true) { continue }
        text = "${text}_sd${id}.${field.name} = ${value_deep_copy(generator, field.type_name, "_ss${id}.${field.name}")}; "
    }
    _ = arrays.remove_last(generator^.copy_walk)
    return "${text}_sd${id}; })"
}

// `node` as an independent copy for a store into a container: held in `_cvN` and copied, into
// the outer arena when the store happens inside a loop.
fn deep_copy_operand(generator ^CodeGen, written_type string, node ^ast.AstNode) -> string {
    id = next_id(generator)
    copied_c = ctype(generator, written_type)
    value_text = gen_expr(generator, node)
    if generator^.loop_scope_depth > 0 {
        return "({ ${copied_c} _cv${id} = ${value_text}; GrayArena *_cva${id} = gray_default_arena; gray_default_arena = _gray_outer_arena; __auto_type _cvd${id} = ${value_deep_copy(generator, written_type, "_cv${id}")}; gray_default_arena = _cva${id}; _cvd${id}; })"
    }
    return "({ ${copied_c} _cv${id} = ${value_text}; ${value_deep_copy(generator, written_type, "_cv${id}")}; })"
}

// `node` as an independent copy of a value of this type.
fn deep_copy_of(generator ^CodeGen, written_type string, node ^ast.AstNode) -> string {
    id = next_id(generator)
    return "({ ${ctype(generator, written_type)} _dtop${id} = ${gen_expr(generator, node)}; ${value_deep_copy(generator, written_type, "_dtop${id}")}; })"
}

// The value of `node` stored into a place of this type: copied when it names
// storage that already exists and would otherwise be shared.
fn gen_stored(generator ^CodeGen, written_type string, node ^ast.AstNode) -> string {
    if names_existing_storage(node) && type_shares_storage(generator, written_type) { return deep_copy_operand(generator, written_type, node) }
    return gen_coerced(generator, written_type, node)
}

// --- Composite value printing ---

// True when the printer for a value of this type is a statement sequence
// rather than a single runtime call.
fn is_composite_print_type(generator ^CodeGen, type_name string) -> bool {
    if type_name == "UUID" { return false }
    if is_array_type(type_name) || is_map_type(type_name) || strings.starts_with(type_name, "^") { return true }
    return maps.contains_key(generator^.structs, type_name) || type_name == "SourceLocation" || is_handle_type(type_name)
}

// The runtime handle types, which print as an empty struct.
fn is_handle_type(type_name string) -> bool {
    return arrays.contains({"Builder", "Channel", "Mutex", "SpinLock", "Thread", "Database", "Router", "Socket", "Listener", "Arena"}, type_name)
}

// C statements writing `value` (a C expression of Grayscale type `type_name`)
// to `stream`.
fn value_print(generator ^CodeGen, value string, written_name string, stream string, in_container bool) -> string {
    type_name = eff(generator, written_name)
    if type_name == "" || type_name == "unknown" { return "gray_out_printf(${stream}, \"%lld\", (long long)(${value}));\n" }
    if is_wide_name(type_name) {
        return "{ GrayString _bs = ${wide_prefix(type_name)}_to_string(gray_default_arena, ${value}); gray_out_printf(${stream}, \"%.*s\", (int)_bs.len, _bs.data); }\n"
    }
    if type_name == "string" {
        if in_container { return "gray_out_printf(${stream}, \"\\\"%.*s\\\"\", (int)(${value}).len, (${value}).data);\n" }
        return "gray_out_printf(${stream}, \"%.*s\", (int)(${value}).len, (${value}).data);\n"
    }
    if type_name == "bool" { return "gray_out_printf(${stream}, \"%s\", (${value}) ? \"true\" : \"false\");\n" }
    if type_name == "char" {
        convert = "GrayString _cs = gray_builtin_char_to_utf8(gray_default_arena, ${value});"
        if in_container {
            return "{ ${convert} gray_out_printf(${stream}, \"'\"); gray_out_write(_cs.data, 1, (size_t)_cs.len, ${stream}); gray_out_printf(${stream}, \"'\"); }\n"
        }
        return "{ ${convert} gray_out_write(_cs.data, 1, (size_t)_cs.len, ${stream}); }\n"
    }
    if type_name == "nil" { return "gray_out_printf(${stream}, \"nil\");\n" }
    if is_string_enum(generator, type_name) { return "gray_out_printf(${stream}, \"%.*s\", (int)(${value}).len, (${value}).data);\n" }
    if is_error_code_type(generator, type_name) { return "gray_out_printf(${stream}, \"%s\", gray_error_code_name((int64_t)(${value})));\n" }
    if type_name == "Error" {
        id = next_id(generator)
        return "{ GrayError *_pe${id} = (${value}); if (_pe${id}) gray_out_printf(${stream}, \"%.*s\", (int)_pe${id}->msg.len, _pe${id}->msg.data); else gray_out_printf(${stream}, \"nil\"); }\n"
    }
    if is_float_name(type_name) {
        bits = F64_BITS
        if type_name == "f32" { bits = F32_BITS }
        return "{ GrayString _fs = gray_builtin_format_floating_point(gray_default_arena, ${value}, ${bits}); gray_out_printf(${stream}, \"%.*s\", (int)_fs.len, _fs.data); }\n"
    }
    if is_unsigned_int_name(type_name) { return "gray_out_printf(${stream}, \"%llu\", (unsigned long long)(${value}));\n" }
    if is_array_type(type_name) { return array_print(generator, value, type_name, stream) }
    if is_map_type(type_name) { return map_print(generator, value, type_name, stream) }
    if strings.starts_with(type_name, "^") {
        return "if ((${value}) == NULL) {\ngray_out_printf(${stream}, \"nil\");\n} else {\ngray_out_printf(${stream}, \"0x%\" PRIxPTR, (uintptr_t)(${value}));\n}\n"
    }
    if maps.contains_key(generator^.structs, type_name) || type_name == "SourceLocation" || type_name == "UUID" || is_handle_type(type_name) { return struct_print(generator, value, type_name, stream) }
    return "gray_out_printf(${stream}, \"%lld\", (long long)(${value}));\n"
}

fn array_print(generator ^CodeGen, value string, type_name string, stream string) -> string {
    id = next_print_id(generator)
    element = array_element_type(type_name)
    c_element = ctype(generator, element)
    mut element_value = "GRAY_ARRAY_GET((${value}), ${c_element}, _gray_pi${id})"
    mut capture = ""
    if is_composite_print_type(generator, eff(generator, element)) {
        element_id = next_print_id(generator)
        capture = "${c_element} _gray_pv${element_id} = ${element_value};\n"
        element_value = "_gray_pv${element_id}"
    }
    return "gray_out_printf(${stream}, \"{\");\nfor (int32_t _gray_pi${id} = 0; _gray_pi${id} < (${value}).len; _gray_pi${id}++) {\nif (_gray_pi${id} > 0) gray_out_printf(${stream}, \", \");\n${capture}${value_print(generator, element_value, element, stream, true)}}\ngray_out_printf(${stream}, \"}\");\n"
}

fn map_print(generator ^CodeGen, value string, type_name string, stream string) -> string {
    id = next_print_id(generator)
    key_type = map_key_type(type_name)
    value_type = map_value_type(type_name)
    key_value = "*(${ctype(generator, key_type)} *)gray_map_key_at(&(${value}), _gray_sl${id})"
    entry_value = "*(${ctype(generator, value_type)} *)gray_map_value_at(&(${value}), _gray_sl${id})"
    return "gray_out_printf(${stream}, \"{\");\nif ((${value}).count == 0) gray_out_printf(${stream}, \":\");\nbool _gray_fst${id} = true;\nfor (int32_t _gray_mi${id} = 0; _gray_mi${id} < (${value}).order_len; _gray_mi${id}++) {\nint32_t _gray_sl${id} = (${value}).order[_gray_mi${id}];\nif (_gray_sl${id} < 0) continue;\nif (!_gray_fst${id}) gray_out_printf(${stream}, \", \");\n_gray_fst${id} = false;\n${value_print(generator, key_value, key_type, stream, true)}gray_out_printf(${stream}, \": \");\n${value_print(generator, entry_value, value_type, stream, true)}}\ngray_out_printf(${stream}, \"}\");\n"
}

fn struct_print(generator ^CodeGen, value string, type_name string, stream string) -> string {
    if arrays.contains(generator^.printing, type_name) { return "gray_out_printf(${stream}, \"${display_type_name(generator, type_name)}{...}\");\n" }
    arrays.append(generator^.printing, type_name)
    mut names [string] = {}
    mut field_types [string] = {}
    if maps.contains_key(generator^.structs, type_name) {
        for_each declared in generator^.structs[type_name]^.struct_decl^.struct_fields {
            arrays.append(names, declared.name)
            arrays.append(field_types, declared.type_name)
        }
    } or type_name == "SourceLocation" {
        names = {"file", "line", "column"}
        field_types = {"string", "i64", "i64"}
    }
    mut text = "gray_out_printf(${stream}, \"${display_type_name(generator, type_name)}{\");\n"
    for i in range(0, len(names)) {
        if i > 0 { text = "${text}gray_out_printf(${stream}, \", \");\n" }
        // a field named like a C keyword is spelled `_gray_NAME` in C and printed by its own name
        mut shown_name = names[i]
        if strings.starts_with(shown_name, ast.SYNTH_PREFIX) { shown_name = strings.slice(shown_name, len(ast.SYNTH_PREFIX), len(shown_name)) }
        text = "${text}gray_out_printf(${stream}, \"${shown_name}: \");\n${value_print(generator, "(${value}).${names[i]}", field_types[i], stream, true)}"
    }
    _ = arrays.remove_last(generator^.printing)
    return "${text}gray_out_printf(${stream}, \"}\");\n"
}

// A print of a struct, array, map or pointer: a block that evaluates the
// argument once and writes it to the stream.
fn composite_print(generator ^CodeGen, variant string, arg ^ast.AstNode) -> string {
    type_name = expr_type(generator, arg)
    mut stream = "stdout"
    if strings.starts_with(variant, "e") { stream = "stderr" }
    id = next_print_id(generator)
    inner_indent = strings.repeat("    ", generator^.indent + 1)
    mut body = "${inner_indent}${ctype(generator, type_name)} _gray_pv${id} = ${gen_expr(generator, arg)};\n"
    body = "${body}${indent_print_block(generator, value_print(generator, "_gray_pv${id}", type_name, stream, false), 1)}"
    if strings.ends_with(variant, "ln") { body = "${body}${inner_indent}fprintf(${stream}, \"\\n\");\n" }
    outer_indent = strings.repeat("    ", generator^.indent)
    return "{\n${body}${outer_indent}}\n${outer_indent}(void)0"
}

// The next number for the temporaries of a composite print.
fn next_print_id(generator ^CodeGen) -> i64 {
    id = generator^.print_counter
    generator^.print_counter = id + 1
    return id
}

// The lines of a printed value, indented one level inside the print's block and one more for
// each block they open.
fn indent_print_block(generator ^CodeGen, text string, extra_level i64) -> string {
    mut depth i64 = 0
    mut pieces [string] = {}
    for_each line in strings.split(text, "\n") {
        if line == "" { continue }
        if strings.starts_with(line, "}") { depth = depth - 1 }
        arrays.append(pieces, "${strings.repeat("    ", generator^.indent + extra_level + depth)}${line}\n")
        if strings.ends_with(line, "{") { depth = depth + 1 }
    }
    return strings.join(pieces, "")
}

// The runtime print function for a value of this type.
fn print_call(generator ^CodeGen, variant string, arg string, type_name string) -> string {
    if type_name == "Error" { return "gray_builtin_${variant}_str((${arg}) ? (${arg})->msg : gray_string_lit(\"nil\"))" }
    if is_error_code_type(generator, type_name) { return "gray_builtin_${variant}_str(gray_string_lit(gray_error_code_name((int64_t)(${arg}))))" }
    if is_string_enum(generator, type_name) { return "gray_builtin_${variant}_str(${arg})" }
    if type_name == "UUID" { return "gray_builtin_${variant}_str(gray_string_lit(\"UUID{}\"))" }
    if is_wide_name(type_name) { return "gray_builtin_${variant}_str(${wide_prefix(type_name)}_to_string(gray_default_arena, ${arg}))" }
    if type_name == "string" { return "gray_builtin_${variant}_str(${arg})" }
    if type_name == "bool" { return "gray_builtin_${variant}_bool(${arg})" }
    if type_name == "char" { return "gray_builtin_${variant}_char(${arg})" }
    if is_float_name(type_name) {
        bits = F64_BITS
        if type_name == "f32" { bits = F32_BITS }
        return "gray_builtin_${variant}_floating_point(${arg}, ${bits})"
    }
    if is_unsigned_int_name(type_name) { return "gray_builtin_${variant}_u64(${arg})" }
    return "gray_builtin_${variant}_i64(${arg})"
}

// The instantiation a call to generic function `callee_decl` selects: the type
// each of its type arguments names, joined as the typechecker spells an
// instantiation. A type parameter of the instantiation being emitted that is
// passed on resolves to what it is bound to here.
fn call_binding(generator ^CodeGen, callee_decl ^ast.FuncDeclData, arguments [^ast.AstNode]) -> string {
    declared_params = callee_decl^.params
    mut bound [string] = {}
    for i in range(0, len(declared_params)) {
        if !declared_params[i].is_type_param { continue }
        mut type_text = "unknown"
        if i < len(arguments) && arguments[i]^.kind == ast.NodeKind.LABEL {
            type_text = substitute_generics(generator, arguments[i]^.label^.value)
        }
        arrays.append(bound, type_text)
    }
    return strings.join(bound, ast.GENERIC_BINDING_SEPARATOR)
}

// The name a type is written with, for type_of(): array sizes are not part of it.
fn type_spelling(generator ^CodeGen, type_name string) -> string {
    if strings.starts_with(type_name, "^") { return "^${type_spelling(generator, strings.slice(type_name, 1, len(type_name)))}" }
    if is_array_type(type_name) { return "[${type_spelling(generator, array_element_type(type_name))}]" }
    if is_map_type(type_name) { return "map[${type_spelling(generator, map_key_type(type_name))}:${type_spelling(generator, map_value_type(type_name))}]" }
    // an expression of untyped literals has its default type
    if type_name == "integer literal" { return "i64" }
    if type_name == "decimal literal" { return "f64" }
    return display_type_name(generator, type_name)
}

// The name a struct or enum is written with where it is declared: a module member is stored under a module-prefixed name.
fn display_type_name(generator ^CodeGen, type_name string) -> string {
    if maps.contains_key(generator^.structs, type_name) && generator^.structs[type_name]^.struct_decl^.original_name != "" { return generator^.structs[type_name]^.struct_decl^.original_name }
    if maps.contains_key(generator^.enums, type_name) && generator^.enums[type_name]^.enum_decl^.original_name != "" { return generator^.enums[type_name]^.enum_decl^.original_name }
    return type_name
}

// type_of, fields and size_of read their argument's type at compile time; the
// argument still runs, so its calls and runtime panics are kept. A bare label
// or a literal has nothing to run.
fn type_builtin_value(generator ^CodeGen, arg ^ast.AstNode, value string) -> string {
    when arg^.kind {
        is ast.NodeKind.LABEL { return value }
        is ast.NodeKind.INT_VALUE { return value }
        is ast.NodeKind.FLOAT_VALUE { return value }
        is ast.NodeKind.BOOL_VALUE { return value }
        is ast.NodeKind.STRING_VALUE { return value }
        is ast.NodeKind.CHAR_VALUE { return value }
        default { return "({ (void)(${gen_expr(generator, arg)}); ${value}; })" }
    }
}

fn gen_type_of(generator ^CodeGen, arg ^ast.AstNode) -> string {
    // a `distinct alias` value reports its own type's name
    return type_builtin_value(generator, arg, gen_string_literal(type_spelling(generator, substitute_generics(generator, arg^.resolved_type))))
}

fn gen_fields(generator ^CodeGen, arg ^ast.AstNode) -> string {
    mut struct_name = expr_type(generator, arg)
    if strings.starts_with(struct_name, "^") { struct_name = strings.slice(struct_name, 1, len(struct_name)) }
    mut names [string] = {}
    if maps.contains_key(generator^.structs, struct_name) {
        for_each declared in generator^.structs[struct_name]^.struct_decl^.struct_fields {
            arrays.append(names, gen_string_literal(declared.name))
        }
    }
    mut array_value = "gray_array_from(gray_default_arena, (GrayString[]){gray_string_lit(\"\")}, sizeof(GrayString), 0, GRAY_ELEM_STRING)"
    if len(names) > 0 {
        array_value = "gray_array_from(gray_default_arena, (GrayString[${len(names)}]){${strings.join(names, ", ")}}, sizeof(GrayString), ${len(names)}, GRAY_ELEM_STRING)"
    }
    return type_builtin_value(generator, arg, array_value)
}

fn gen_size_of(generator ^CodeGen, arg ^ast.AstNode) -> string {
    mut c_name = ""
    when arg^.kind {
        is ast.NodeKind.LABEL { c_name = ctype(generator, arg^.label^.value) }
        is ast.NodeKind.INT_VALUE { c_name = "int64_t" }
        is ast.NodeKind.FLOAT_VALUE { c_name = "double" }
        is ast.NodeKind.BOOL_VALUE { c_name = "bool" }
        is ast.NodeKind.STRING_VALUE { c_name = "GrayString" }
        is ast.NodeKind.INTERPOLATED_STRING { c_name = "GrayString" }
        is ast.NodeKind.CHAR_VALUE { c_name = "int32_t" }
        default { c_name = ctype(generator, expr_type(generator, arg)) }
    }
    return type_builtin_value(generator, arg, "(int64_t)sizeof(${c_name})")
}

// `here()`: the position of the `here` identifier itself, known at compile time.
fn gen_here(callee ^ast.AstNode) -> string {
    return "(GrayStruct_SourceLocation){.file = gray_string_lit(${c_quote(callee^.tok.file)}), .line = ${callee^.tok.line}, .column = ${callee^.tok.col}}"
}

// `embed(path)`: the file's bytes as a string literal, the path resolved
// relative to the source file.
fn gen_embed(generator ^CodeGen, arg ^ast.AstNode) -> string {
    embed_path = ast.ast_string_decode(arg^.string_value)
    mut resolved = embed_path
    // The argument's own token names the file holding the call; a file-scope
    // initializer of an imported module is generated with generator^.file on the entry file.
    source_file = arg^.tok.file
    slash = strings.last_index_of(source_file, "/")
    if !strings.starts_with(embed_path, "/") && slash >= 0 {
        resolved = "${strings.slice(source_file, 0, slash + 1)}${embed_path}"
    }
    data [u8], read_err = io.read_bytes(resolved)
    if read_err != nil {
        eprintln("graysh: embed(): cannot read '${resolved}'")
        exit(1)
    }
    mut escaped [string] = {}
    for_each byte in data {
        arrays.append(escaped, fmt.sprintf("\\x%02x", {byte}))
    }
    return "GRAY_STRING_LIT(\"${strings.join(escaped, "")}\")"
}

// The builtins that read their argument's type or position at compile time,
// or hand a value across the C boundary; "" for any other call.
fn gen_compile_time_call(generator ^CodeGen, node ^ast.AstNode, name string) -> string {
    arguments = node^.call^.args
    if name == "type_of" && len(arguments) == 1 { return gen_type_of(generator, arguments[0]) }
    if name == "fields" && len(arguments) == 1 { return gen_fields(generator, arguments[0]) }
    if name == "size_of" && len(arguments) == 1 { return gen_size_of(generator, arguments[0]) }
    if name == "here" && len(arguments) == 0 { return gen_here(node^.call^.function) }
    if name == "embed" && len(arguments) == 1 { return gen_embed(generator, arguments[0]) }
    if name == "to_char" && len(arguments) == 2 { return "gray_builtin_to_char(${gen_expr(generator, arguments[0])}, ${gen_expr(generator, arguments[1])}, ${location_args(generator, node)})" }
    if name == "from_c_string" && len(arguments) == 1 { return "gray_c_string_dup(gray_default_arena, (const char *)${gen_expr(generator, arguments[0])})" }
    if name == "to_c_string" && len(arguments) == 1 {
        return "({ GrayString _cs = ${gen_expr(generator, arguments[0])}; (uint8_t *)gray_string_new(gray_heap_arena, _cs.data, _cs.len).data; })"
    }
    if name == "copy" && len(arguments) == 1 {
        copied_type = expr_type(generator, arguments[0])
        if is_array_type(copied_type) || is_map_type(copied_type) || maps.contains_key(generator^.structs, copied_type) {
            copy_id = next_id(generator)
            return "({ ${ctype(generator, copied_type)} _cpy${copy_id} = ${gen_expr(generator, arguments[0])}; ${value_deep_copy(generator, copied_type, "_cpy${copy_id}")}; })"
        }
        return gen_expr(generator, arguments[0])
    }
    if name == "ref" && len(arguments) == 1 {
        if referenced_function_name(generator, arguments[0]) != "" {
            referenced_symbol = "gray_fn_${referenced_function_name(generator, arguments[0])}"
            register_function_signature(generator, referenced_symbol, expr_type(generator, node))
            return referenced_symbol
        }
        return "&${gen_expr(generator, arguments[0])}"
    }
    return ""
}

// A call to the declared function `name` (a struct function is `Type_name`).
fn gen_declared_call(generator ^CodeGen, node ^ast.AstNode, name string, arguments [^ast.AstNode]) -> string {
    callee_decl = generator^.funcs[name]^.func_decl
    declared_params = callee_decl^.params
    mut callee_name = name
    mut callee_bindings ast.GenericBindings = ast.GenericBindings{}
    if ast.func_has_generic_params(callee_decl) {
        binding_text = call_binding(generator, callee_decl, arguments)
        callee_name = mangle_generic_name(name, binding_text)
        callee_bindings = ast.generic_bindings_init(callee_decl, binding_text)
    }
    for i in range(0, len(arguments)) {
        if i < len(declared_params) { expect_type(arguments[i], ast.generic_bindings_substitute(callee_bindings, declared_params[i].type_name)) }
    }
    mut pieces [string] = {}
    for i in range(0, len(arguments)) {
        // type arguments are baked into the instantiation's name
        if i < len(declared_params) && declared_params[i].is_type_param { continue }
        if i < len(declared_params) && declared_params[i].is_mutable {
            if arguments[i]^.kind == ast.NodeKind.LABEL && arrays.contains(generator^.ref_params, arguments[i]^.label^.value) {
                arrays.append(pieces, arguments[i]^.label^.value)
            } or strings.starts_with(expr_type(generator, arguments[i]), "^") {
                arrays.append(pieces, gen_expr(generator, arguments[i]))
            } or arguments[i]^.kind == ast.NodeKind.POSTFIX_EXPR && arguments[i]^.postfix^.op == token.TokenKind.CARET {
                // &(p^) is p
                arrays.append(pieces, gen_expr(generator, arguments[i]^.postfix^.left))
            } otherwise {
                arrays.append(pieces, address_of_arg(generator, arguments[i]))
            }
        } or i < len(declared_params) && strings.starts_with(eff(generator, declared_params[i].type_name), "^") && !strings.starts_with(expr_type(generator, arguments[i]), "^") && maps.contains_key(generator^.structs, expr_type(generator, arguments[i])) && arguments[i]^.kind == ast.NodeKind.POSTFIX_EXPR && arguments[i]^.postfix^.op == token.TokenKind.CARET {
            // a dereferenced pointer passed to a pointer-to-struct parameter is the pointer itself (instance dispatch)
            arrays.append(pieces, gen_expr(generator, arguments[i]^.postfix^.left))
        } or i < len(declared_params) && strings.starts_with(eff(generator, declared_params[i].type_name), "^") && !strings.starts_with(expr_type(generator, arguments[i]), "^") && maps.contains_key(generator^.structs, expr_type(generator, arguments[i])) && (arguments[i]^.kind == ast.NodeKind.LABEL || arguments[i]^.kind == ast.NodeKind.MEMBER_EXPR || arguments[i]^.kind == ast.NodeKind.INDEX_EXPR) {
            // a struct value passed to a pointer-to-struct parameter is addressed (instance dispatch)
            arrays.append(pieces, "&${gen_expr(generator, arguments[i])}")        } or i < len(declared_params) && strings.starts_with(expr_type(generator, arguments[i]), "^") && !strings.starts_with(eff(generator, declared_params[i].type_name), "^") && maps.contains_key(generator^.structs, strings.slice(expr_type(generator, arguments[i]), 1, len(expr_type(generator, arguments[i])))) {
            // a pointer passed to a by-value struct parameter is dereferenced
            arrays.append(pieces, deref_text(generator, gen_expr(generator, arguments[i]), expr_type(generator, arguments[i]), arguments[i]))
        } or i < len(declared_params) {
            arrays.append(pieces, gen_coerced(generator, ast.generic_bindings_substitute(callee_bindings, declared_params[i].type_name), arguments[i]))
        } otherwise {
            arrays.append(pieces, gen_expr(generator, arguments[i]))
        }
    }
    // a default may read an earlier parameter: the given arguments are bound to locals named
    // after their parameters, in a statement expression around the call
    mut default_bindings = ""
    // arguments written out of parameter order are still evaluated in the order written: the ones that
    // run calls are bound to temporaries first
    mut order_text = ""
    mut order_id i64 = -1
    if len(node^.call^.written_arguments) > 1 {
        mut ordered_slots [i64] = {}
        mut previous_slot i64 = -1
        mut slots_out_of_order = false
        for_each written in node^.call^.written_arguments {
            for k in range(0, len(arguments)) {
                if arguments[k] != written || k >= len(declared_params) || declared_params[k].is_type_param || declared_params[k].is_mutable || k >= len(pieces) { continue }
                if !expression_can_be_hoisted(arguments[k]) { continue }
                if k < previous_slot { slots_out_of_order = true }
                previous_slot = k
                arrays.append(ordered_slots, k)
            }
        }
        if len(ordered_slots) >= 2 && slots_out_of_order {
            order_id = next_id(generator)
            for ordered_position in range(0, len(ordered_slots)) {
                slot = ordered_slots[ordered_position]
                order_text = "${order_text}__auto_type _gray_na${order_id}_${ordered_position} = ${pieces[slot]}; "
                pieces[slot] = "_gray_na${order_id}_${ordered_position}"
            }
        }
    }
    mut uses_defaults = false
    for i in range(len(arguments), len(declared_params)) {
        if declared_params[i].default_value != nil && !declared_params[i].is_type_param { uses_defaults = true }
    }
    mut has_mutable_parameter = false
    for_each declared_param in declared_params {
        if declared_param.is_mutable { has_mutable_parameter = true }
    }
    if has_mutable_parameter || node^.call^.function^.kind != ast.NodeKind.LABEL { uses_defaults = false }
    if uses_defaults {
        mut piece_index i64 = 0
        for i in range(0, len(arguments)) {
            if i >= len(declared_params) || declared_params[i].is_type_param { continue }
            if !declared_params[i].is_mutable && piece_index < len(pieces) {
                bound_type = ctype(generator, ast.generic_bindings_substitute(callee_bindings, declared_params[i].type_name))
                default_bindings = "${default_bindings}${bound_type} ${declared_params[i].name} = ${pieces[piece_index]}; "
                pieces[piece_index] = declared_params[i].name
            }
            piece_index = piece_index + 1
        }
    }
    // omitted trailing arguments take the parameter's default value
    for i in range(len(arguments), len(declared_params)) {
        if declared_params[i].default_value == nil || declared_params[i].is_type_param { continue }
        expect_type(declared_params[i].default_value, ast.generic_bindings_substitute(callee_bindings, declared_params[i].type_name))
        // A default belongs to the callee: function_name() in it is the callee, and
        // the caller is the frame running now.
        saved_target = generator^.default_target_name
        generator^.default_target_name = declared_runtime_name(generator, name)
        arrays.append(pieces, gen_coerced(generator, ast.generic_bindings_substitute(callee_bindings, declared_params[i].type_name), declared_params[i].default_value))
        generator^.default_target_name = saved_target
    }
    // an array or map element passed to a `&` parameter is lent as a local and stored back:
    // the callee may grow the container, which moves the slot
    mut write_back_declarations = ""
    mut write_back_stores = ""
    mut write_back_index i64 = 0
    mut write_back_id i64 = -1
    mut piece_cursor i64 = 0
    for i in range(0, len(arguments)) {
        if i < len(declared_params) && declared_params[i].is_type_param { continue }
        if i < len(declared_params) && declared_params[i].is_mutable && arguments[i]^.kind == ast.NodeKind.INDEX_EXPR && !is_rvalue_container(arguments[i]^.index_data^.left) {
            element_left = arguments[i]^.index_data^.left
            left_kind_type = expr_type(generator, element_left)
            if is_array_type(left_kind_type) || is_map_type(left_kind_type) {
                if write_back_id < 0 { write_back_id = id_for_write_back(generator) }
                local_name = "_gray_wb${write_back_id}_${write_back_index}"
                write_back_index = write_back_index + 1
                if is_array_type(left_kind_type) {
                    element_c = ctype(generator, array_element_type(left_kind_type))
                    write_back_declarations = "${write_back_declarations}__auto_type ${local_name} = ${gen_expr(generator, arguments[i])}; "
                    write_back_stores = "${write_back_stores}${strings.repeat("    ", generator^.indent)}GRAY_ARRAY_STORE_BACK_AT(${gen_expr(generator, element_left)}, ${element_c}, ${gen_expr(generator, arguments[i]^.index_data^.index_expr)}, ${local_name}, ${location_args(generator, node)});\n"
                } otherwise {
                    key_c = map_slot_c(generator, map_key_type(left_kind_type))
                    value_c = map_slot_c(generator, map_value_type(left_kind_type))
                    write_back_declarations = "${write_back_declarations}__auto_type ${local_name} = ${gen_expr(generator, arguments[i])}; "
                    write_back_stores = "${write_back_stores}${strings.repeat("    ", generator^.indent)}{ ${key_c} _mk = ${gen_coerced(generator, map_key_type(left_kind_type), arguments[i]^.index_data^.index_expr)}; ${value_c} _mv = ${local_name}; gray_map_set(gray_default_arena, &${gen_expr(generator, element_left)}, &_mk, &_mv, ${location_args(generator, node)}); }\n"
                }
                pieces[piece_cursor] = "&${local_name}"
            }
        }
        piece_cursor = piece_cursor + 1
    }
    mut call_text = "gray_fn_${callee_name}(${strings.join(pieces, ", ")})"
    if default_bindings != "" || uses_defaults { call_text = "({ ${default_bindings}${call_text}; })" }
    if order_text != "" {
        if len(callee_decl^.return_types) > 0 {
            call_text = "({ ${order_text}__auto_type _gray_nr${order_id} = ${call_text}; _gray_nr${order_id}; })"
        } otherwise {
            call_text = "({ ${order_text}${call_text}; })"
        }
    }
    if write_back_stores != "" {
        if expr_type(generator, node) == "void" || expr_type(generator, node) == "" {
            call_text = "({ ${write_back_declarations}${call_text}; ${write_back_stores}})"
        } otherwise {
            call_text = "({ ${write_back_declarations}__auto_type _gray_wr${write_back_id} = ${call_text}; ${write_back_stores}_gray_wr${write_back_id}; })"
        }
    }
    // `recv.f()` where f takes no instance: the receiver is still evaluated, before the call
    if node^.call^.ignored_receiver != nil && node^.call^.ignored_receiver^.kind != ast.NodeKind.LABEL {
        return "({ (void)(${gen_expr(generator, node^.call^.ignored_receiver)}); ${call_text}; })"
    }
    return call_text
}

fn gen_call(generator ^CodeGen, node ^ast.AstNode) -> string {
    // A call in a generic body is dispatched once per instantiation: emit the shape
    // this instantiation's bindings gave it
    if len(generator^.generics.names) > 0 && len(node^.call^.instantiation_keys) > 0 {
        key = ast.generic_bindings_join(generator^.generics)
        for slot in range(0, len(node^.call^.instantiation_keys)) {
            if node^.call^.instantiation_keys[slot] != key { continue }
            written = ast.ast_call_form_capture(node)
            saved_keys = node^.call^.instantiation_keys
            node^.call^.instantiation_keys = {}
            ast.ast_call_form_apply(node, node^.call^.instantiation_forms[slot])
            emitted = gen_call(generator, node)
            ast.ast_call_form_apply(node, written)
            node^.call^.instantiation_keys = saved_keys
            return emitted
        }
    }
    callee = node^.call^.function
    arguments = node^.call^.args
    if callee^.kind == ast.NodeKind.LABEL {
        name = callee^.label^.value
        if name == "println" || name == "print" || name == "eprintln" || name == "eprint" {
            if arguments[0]^.kind == ast.NodeKind.NIL_VALUE { return "gray_builtin_${name}_str(gray_string_lit(\"nil\"))" }
            if (is_composite_print_type(generator, expr_type(generator, arguments[0])) || expr_type(generator, arguments[0]) == "UUID") && !maps.contains_key(generator^.enums, expr_type(generator, arguments[0])) {
                return composite_print(generator, name, arguments[0])
            }
            return print_call(generator, name, gen_expr(generator, arguments[0]), expr_type(generator, arguments[0]))
        }
        if (name == "addr" || name == "raw") && len(arguments) == 1 { return gen_address_call(generator, node, name, arguments[0]) }
        if (name == "wrap_add" || name == "wrap_sub" || name == "wrap_mult" || name == "wrap_div") && len(arguments) == 2 && !maps.contains_key(generator^.funcs, name) {
            return gen_wrapping_call(generator, node, name)
        }
        if is_conversion_name(name) && len(arguments) == 1 && !maps.contains_key(generator^.funcs, name) {
            return gen_conversion(generator, node, name, arguments[0])
        }
        compile_time = gen_compile_time_call(generator, node, name)
        if compile_time != "" { return compile_time }
        if name == "len" && len(arguments) == 1 && strings.starts_with(expr_type(generator, arguments[0]), "Range<") {
            return "GrayRange_${range_element(expr_type(generator, arguments[0]))}_len(${gen_expr(generator, arguments[0])}, ${location_args(generator, node)})"
        }
        if name == "len" && len(arguments) == 1 {
            if expr_type(generator, arguments[0]) == "Channel" { return "gray_channels_len(${gen_expr(generator, arguments[0])})" }
            if expr_type(generator, arguments[0]) == "Builder" { return "gray_strings_builder_len(${gen_expr(generator, arguments[0])})" }
            if is_map_type(expr_type(generator, arguments[0])) { return "(int64_t)(${gen_expr(generator, arguments[0])}).count" }
            return "(int64_t)(${gen_expr(generator, arguments[0])}).len"
        }
        if name == "exit" || name == "system" || name == "sleep_s" || name == "sleep_ms" || name == "sleep_ns" || name == "char_count" {
            return "gray_builtin_${name}(${gen_args(generator, arguments)})"
        }
        if name == "panic" && len(arguments) == 1 { return "gray_builtin_panic_msg(${gen_expr(generator, arguments[0])})" }
        if name == "input" && len(arguments) == 0 { return "gray_builtin_input(gray_default_arena)" }
        if name == "flush" && len(arguments) == 0 { return "gray_builtin_flush()" }
        if name == "assert" && len(arguments) >= 1 {
            mut message = "gray_string_lit(\"\")"
            if len(arguments) >= 2 { message = gen_expr(generator, arguments[1]) }
            return "gray_builtin_assert(${gen_expr(generator, arguments[0])}, ${message}, ${location_args(generator, node)})"
        }
        if name == "error" && len(arguments) >= 1 && !maps.contains_key(generator^.funcs, name) {
            mut error_message = "gray_string_lit(\"\")"
            if len(arguments) == 2 { error_message = gen_expr(generator, arguments[1]) }
            mut error_code = gen_expr(generator, arguments[0])
            if arguments[0]^.kind == ast.NodeKind.IMPLICIT_ENUM { error_code = "GrayErrorCode_${arguments[0]^.implicit_enum^.variant}" }
            return "gray_error_new(gray_default_arena, (int64_t)(${error_code}), ${error_message})"
        }
        if maps.contains_key(generator^.funcs, name) { return gen_declared_call_scoped(generator, node, name, arguments) }
        // not a declared function: a func-typed variable, parameter or field
        return gen_func_value_call(generator, node, gen_expr(generator, callee))
    }
    if callee^.kind == ast.NodeKind.IMPLICIT_ENUM && is_tagged_enum(generator, expr_type(generator, node)) {
        return gen_tagged_value(generator, expr_type(generator, node), callee^.implicit_enum^.variant, arguments)
    }
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL && is_tagged_enum(generator, callee^.member^.object^.label^.value) {
        return gen_tagged_value(generator, callee^.member^.object^.label^.value, callee^.member^.member, arguments)
    }
    // a call through a func-typed struct field: `operator.callback(3, 4)`, `p^.callback()`
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && is_func_field(generator, callee) {
        // a pointer receiver is read with an arrow and no nil check of its own: the call checks the function
        mut field_text = gen_expr(generator, callee)
        field_object = callee^.member^.object
        if strings.starts_with(expr_type(generator, field_object), "^") && !is_deref(field_object) {
            field_text = "${gen_expr(generator, field_object)}->${callee^.member^.member}"
        }
        // the type table has no pointer type for the dereferenced name here: it is read through a held copy
        if is_deref(field_object) && field_object^.postfix^.left^.kind == ast.NodeKind.LABEL && !arrays.contains(generator^.raw_names, field_object^.postfix^.left^.label^.value) {
            field_text = "({ __auto_type _dp = ${checked_pointer_text(generator, field_object^.postfix^.left, field_object)}; if (!_dp) { gray_panic_code_at(${location_args(generator, field_object)}, \"P0080\", \"nil pointer dereference\"); } *_dp; }).${callee^.member^.member}"
        }
        return gen_func_value_call(generator, node, "({ void *_fp = (void *)(${field_text}); if (!_fp) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0118\", \"call through a nil function value\"); } _fp; })")
    }
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        struct_function = "${resolve_alias(generator, callee^.member^.object^.label^.value)}_${callee^.member^.member}"
        if maps.contains_key(generator^.funcs, struct_function) { return gen_declared_call_scoped(generator, node, struct_function, arguments) }
        return gen_module_call(generator, node, callee^.member^.object^.label^.value, callee^.member^.member)
    }
    return "0 /* unsupported call at ${node^.tok.file}:${node^.tok.line} */"
}

// --- printf-family calls ---

// One printf directive as the values are emitted against it.
const FormatDirective struct {
    // "" for a NUL byte of the format text, written by %character
    specifier string
    width i64
    left_align bool
    precision i64
    // byte offset of the directive's '%' (or of the NUL byte) in the format text
    start i64
    // byte offset just past the directive
    end i64
}

// The values a printf call formats: an array literal's elements, or an array
// held in a variable and staged as _gray_format_values<id>.
const FormatValues struct {
    elements [^ast.AstNode]
    is_literal bool
    array_element string
    id i64
}

// Each directive and each NUL byte of `text`, in the order the emitted C format reads its arguments.
fn scan_format_directives(text string) -> [FormatDirective] {
    mut directives [FormatDirective] = {}
    n i64 = len(text)
    mut cursor i64 = 0
    as_long_as cursor < n {
        character = strings.char_at(text, cursor)
        if cast(character, i64) == 0 {
            arrays.append(directives, FormatDirective{specifier: "", width: 0, left_align: false, precision: -1, start: cursor, end: cursor + 1})
            cursor = cursor + 1
            continue
        }
        if character != '%' {
            cursor = cursor + 1
            continue
        }
        directive_start = cursor
        cursor = cursor + 1
        if cursor >= n { break }
        if strings.char_at(text, cursor) == '%' {
            cursor = cursor + 1
            continue
        }
        mut left_align = false
        mut width i64 = 0
        mut precision i64 = -1
        as_long_as cursor < n && strings.contains("-+ 0#", strings.slice(text, cursor, cursor + 1)) {
            if strings.char_at(text, cursor) == '-' { left_align = true }
            cursor = cursor + 1
        }
        as_long_as cursor < n && strings.char_at(text, cursor) >= '0' && strings.char_at(text, cursor) <= '9' {
            width = width * DECIMAL_BASE + (cast(strings.char_at(text, cursor), i64) - cast('0', i64))
            cursor = cursor + 1
        }
        if cursor < n && strings.char_at(text, cursor) == '.' {
            cursor = cursor + 1
            precision = 0
            as_long_as cursor < n && strings.char_at(text, cursor) >= '0' && strings.char_at(text, cursor) <= '9' {
                if precision < MAX_PRECISION_BEFORE_DIGIT { precision = precision * DECIMAL_BASE + (cast(strings.char_at(text, cursor), i64) - cast('0', i64)) }
                cursor = cursor + 1
            }
        }
        if cursor < n && strings.char_at(text, cursor) == 'h' {
            cursor = cursor + 1
            if cursor < n && strings.char_at(text, cursor) == 'h' { cursor = cursor + 1 }
        } or cursor < n && strings.char_at(text, cursor) == 'l' {
            cursor = cursor + 1
            if cursor < n && strings.char_at(text, cursor) == 'l' { cursor = cursor + 1 }
        } or cursor < n && strings.char_at(text, cursor) == 'L' {
            cursor = cursor + 1
        }
        if cursor >= n { break }
        specifier = strings.slice(text, cursor, cursor + 1)
        cursor = cursor + 1
        arrays.append(directives, FormatDirective{specifier: specifier, width: width, left_align: left_align, precision: precision, start: directive_start, end: cursor})
    }
    return directives
}

// The type of the printf value at `index`.
fn format_value_type(generator ^CodeGen, values FormatValues, index i64) -> string {
    if values.is_literal {
        if index < len(values.elements) { return format_operand_type(generator, values.elements[index]) }
        return ""
    }
    return values.array_element
}

fn format_operand_type(generator ^CodeGen, element ^ast.AstNode) -> string {
    type_name = expr_type(generator, element)
    if type_name == "integer literal" { return "i64" }
    if type_name == "decimal literal" { return "f64" }
    return type_name
}

// The C expression of the printf value at `index`.
fn format_operand(generator ^CodeGen, node ^ast.AstNode, values FormatValues, index i64) -> string {
    if values.is_literal { return gen_expr(generator, values.elements[index]) }
    return "(*(${ctype(generator, values.array_element)} *)gray_array_get_ptr(&_gray_format_values${values.id}, ${index}, ${location_args(generator, node)}))"
}

// The format text as a C string literal, with %d/%i/%u widened for 64-bit
// integers and %b, %character and wide integers read back through %s.
fn format_normalized(generator ^CodeGen, values FormatValues, text string, append_newline bool, first_value_index i64) -> string {
    mut normalized string = ""
    n i64 = len(text)
    mut cursor i64 = 0
    mut directive_index i64 = first_value_index
    as_long_as cursor < n {
        character = strings.char_at(text, cursor)
        if cast(character, i64) == 0 {
            // C would end the format string here; %character with a 0 argument writes the NUL byte instead
            normalized = "${normalized}%c"
            cursor = cursor + 1
            continue
        }
        if character != '%' {
            normalized = "${normalized}${strings.slice(text, cursor, cursor + 1)}"
            cursor = cursor + 1
            continue
        }
        cursor = cursor + 1
        if cursor >= n { break }
        if strings.char_at(text, cursor) == '%' {
            normalized = "${normalized}%%"
            cursor = cursor + 1
            continue
        }
        normalized = "${normalized}%"
        mut flags string = ""
        mut width_text string = ""
        mut precision_text string = ""
        as_long_as cursor < n && strings.contains("-+ 0#", strings.slice(text, cursor, cursor + 1)) {
            flags = "${flags}${strings.slice(text, cursor, cursor + 1)}"
            cursor = cursor + 1
        }
        as_long_as cursor < n && strings.char_at(text, cursor) >= '0' && strings.char_at(text, cursor) <= '9' {
            width_text = "${width_text}${strings.slice(text, cursor, cursor + 1)}"
            cursor = cursor + 1
        }
        if cursor < n && strings.char_at(text, cursor) == '.' {
            precision_text = "."
            cursor = cursor + 1
            as_long_as cursor < n && strings.char_at(text, cursor) >= '0' && strings.char_at(text, cursor) <= '9' {
                precision_text = "${precision_text}${strings.slice(text, cursor, cursor + 1)}"
                cursor = cursor + 1
            }
        }
        mut length_modifier string = ""
        if cursor < n && (strings.char_at(text, cursor) == 'h' || strings.char_at(text, cursor) == 'l' || strings.char_at(text, cursor) == 'L') {
            first_modifier = strings.slice(text, cursor, cursor + 1)
            length_modifier = first_modifier
            cursor = cursor + 1
            if cursor < n && ((first_modifier == "h" && strings.char_at(text, cursor) == 'h') || (first_modifier == "l" && strings.char_at(text, cursor) == 'l')) {
                length_modifier = "${length_modifier}${first_modifier}"
                cursor = cursor + 1
            }
        }
        has_length bool = length_modifier != ""
        if cursor >= n { break }
        specifier = strings.slice(text, cursor, cursor + 1)
        cursor = cursor + 1
        directive_type = format_value_type(generator, values, directive_index)
        is_argument_wide bool = is_wide_name(directive_type)
        mut emitted_specifier = specifier
        mut downgraded_to_string = false
        if specifier == "b" || specifier == "c" {
            emitted_specifier = "s"
            downgraded_to_string = true
        } or is_argument_wide && (specifier == "d" || specifier == "i" || specifier == "u" || specifier == "x" || specifier == "X" || specifier == "o") {
            emitted_specifier = "s"
            downgraded_to_string = true
        }
        // a %s of a string with a width or precision is laid out by gray_fmt_string_field
        is_string_field bool = specifier == "s" && directive_type == "string" && (width_text != "" || precision_text != "")
        if specifier != "c" && !is_string_field {
            for flag_index in range(0, len(flags)) {
                flag = strings.slice(flags, flag_index, flag_index + 1)
                if downgraded_to_string && flag != "-" { continue }
                normalized = "${normalized}${flag}"
            }
            normalized = "${normalized}${width_text}"
        }
        if !downgraded_to_string && !is_string_field {
            normalized = "${normalized}${precision_text}${length_modifier}"
        }
        if !downgraded_to_string && !has_length && directive_type != "" {
            is_signed bool = is_signed_int_name(directive_type)
            is_unsigned bool = is_unsigned_int_name(directive_type)
            if (specifier == "d" || specifier == "i") && is_signed {
                normalized = "${normalized}ll"
            } or specifier == "u" && is_unsigned {
                normalized = "${normalized}ll"
            } or (specifier == "x" || specifier == "X" || specifier == "o") && (is_signed || is_unsigned) {
                normalized = "${normalized}ll"
            }
        }
        normalized = "${normalized}${emitted_specifier}"
        directive_index = directive_index + 1
    }
    if append_newline { normalized = "${normalized}\n" }
    return c_quote(normalized)
}

// One printf value converted to what its (normalized) directive reads.
fn format_value(generator ^CodeGen, value_type string, directive FormatDirective, operand string) -> string {
    specifier = directive.specifier
    mut left_text = "false"
    if directive.left_align { left_text = "true" }
    if specifier == "c" {
        // %character was rewritten to a bare %s: the codepoint's UTF-8 encoding padded to the width
        mut codepoint = operand
        if value_type != "char" {
            id = next_id(generator)
            codepoint = "({ int64_t _gray_format_codepoint${id} = (int64_t)(${operand}); _gray_format_codepoint${id} < 0 || _gray_format_codepoint${id} > 0x10FFFF ? 0xFFFD : (int32_t)_gray_format_codepoint${id}; })"
        }
        return "gray_fmt_char_field(gray_default_arena, ${codepoint}, ${directive.width}, ${left_text}).data"
    }
    if is_wide_name(value_type) {
        prefix = wide_prefix(value_type)
        if specifier == "x" || specifier == "X" {
            mut upper = "false"
            if specifier == "X" { upper = "true" }
            return "${prefix}_to_hex_string(gray_default_arena, ${operand}, ${upper}).data"
        }
        if specifier == "o" { return "${prefix}_to_octal_string(gray_default_arena, ${operand}).data" }
        return "${prefix}_to_string(gray_default_arena, ${operand}).data"
    }
    if value_type == "string" {
        if specifier == "s" && (directive.width > 0 || directive.precision >= 0) {
            return "gray_fmt_string_field(gray_default_arena, ${operand}, ${directive.width}, ${left_text}, ${directive.precision}).data"
        }
        return "${operand}.data"
    }
    if value_type == "bool" { return "${operand} ? \"true\" : \"false\"" }
    is_float_directive bool = specifier == "f" || specifier == "F" || specifier == "e" || specifier == "E" || specifier == "g" || specifier == "G"
    if is_float_directive && (is_signed_int_name(value_type) || is_unsigned_int_name(value_type)) {
        // an integer literal given to a float directive is a float
        return "(double)(${operand})"
    }
    if is_signed_int_name(value_type) && (specifier == "x" || specifier == "X" || specifier == "o") && (value_type == "i8" || value_type == "i16" || value_type == "i32") {
        // hex and octal show a negative value's two's-complement bits at the type's own width
        return "(unsigned long long)(uint${strings.slice(value_type, 1, len(value_type))}_t)(${operand})"
    }
    if is_signed_int_name(value_type) { return "(long long)(${operand})" }
    if is_unsigned_int_name(value_type) { return "(unsigned long long)(${operand})" }
    return operand
}

// The printf values after the format string, one per directive.
fn format_arguments(generator ^CodeGen, node ^ast.AstNode, values FormatValues, text string, has_text bool, first_value_index i64) -> string {
    mut directives [FormatDirective] = {}
    if has_text { directives = scan_format_directives(text) }
    mut tail string = ""
    mut value_index i64 = first_value_index
    for_each directive in directives {
        if directive.specifier == "" {
            tail = "${tail}, 0"
            continue
        }
        if values.is_literal && value_index >= len(values.elements) { break }
        mut operand_type = format_value_type(generator, values, value_index)
        mut operand = format_operand(generator, node, values, value_index)
        is_float_directive bool = directive.specifier == "f" || directive.specifier == "F" || directive.specifier == "e" || directive.specifier == "E" || directive.specifier == "g" || directive.specifier == "G"
        if is_float_directive && values.is_literal {
            literal = values.elements[value_index]
            if is_integer_literal_expression(literal) {
                // an integer literal given to a float directive is a float
                operand = "(double)(${operand})"
                operand_type = "f64"
            }
        }
        tail = "${tail}, ${format_value(generator, operand_type, directive, operand)}"
        value_index = value_index + 1
    }
    return tail
}

// A %s directive that prints a string argument: its bytes are written as they are,
// because C's %s would stop at an embedded NUL.
fn format_directive_is_string(generator ^CodeGen, values FormatValues, directive FormatDirective, value_index i64) -> bool {
    return directive.specifier == "s" && format_value_type(generator, values, value_index) == "string"
}

// The string printed by the directive at `value_index` (its width and precision applied).
fn format_string_value(generator ^CodeGen, node ^ast.AstNode, values FormatValues, directive FormatDirective, value_index i64) -> string {
    operand = format_operand(generator, node, values, value_index)
    if directive.width > 0 || directive.precision >= 0 {
        mut left_text = "false"
        if directive.left_align { left_text = "true" }
        return "gray_fmt_string_field(gray_default_arena, ${operand}, ${directive.width}, ${left_text}, ${directive.precision})"
    }
    return operand
}

// A format with a %s of a string argument: the text between those directives goes
// through C's printf, and each string is written as raw bytes.
fn format_segmented(generator ^CodeGen, node ^ast.AstNode, values FormatValues, prefix string, newline bool, text string, directives [FormatDirective]) -> string {
    to_string bool = prefix == "gray_string_format(gray_default_arena, "
    mut stream = "stdout"
    if prefix == "fprintf(stderr, " { stream = "stderr" }
    unique_id = next_id(generator)
    mut out string = "({ "
    if to_string { out = "({ GrayFmtOut _gray_fs${unique_id} = {0}; " }
    mut segment_start i64 = 0
    mut segment_first_value i64 = 0
    mut value_index i64 = 0
    for index in range(0, len(directives) + 1) {
        is_last bool = index == len(directives)
        mut is_string = false
        if !is_last && directives[index].specifier != "" { is_string = format_directive_is_string(generator, values, directives[index], value_index) }
        if !is_last && !is_string {
            if directives[index].specifier != "" { value_index = value_index + 1 }
            continue
        }
        mut segment_end = len(text)
        if !is_last { segment_end = directives[index].start }
        if segment_end > segment_start || (is_last && newline) {
            segment = strings.slice(text, segment_start, segment_end)
            if to_string {
                out = "${out}gray_fmt_out_printf(&_gray_fs${unique_id}, "
            } otherwise {
                out = "${out}fprintf(${stream}, "
            }
            out = "${out}${format_normalized(generator, values, segment, is_last && newline, segment_first_value)}${format_arguments(generator, node, values, segment, true, segment_first_value)}); "
        }
        if is_last { break }
        out = "${out}{ GrayString _gray_fv = ${format_string_value(generator, node, values, directives[index], value_index)}"
        if to_string {
            out = "${out}; gray_fmt_out_write(_gray_fv.data, 1, (size_t)_gray_fv.len, &_gray_fs${unique_id}); } "
        } otherwise {
            out = "${out}; fwrite(_gray_fv.data, 1, (size_t)_gray_fv.len, ${stream}); } "
        }
        value_index = value_index + 1
        segment_start = directives[index].end
        segment_first_value = value_index
    }
    if to_string { return "${out}gray_fmt_out_finish(gray_default_arena, &_gray_fs${unique_id}); })" }
    return "${out}(void)0; })"
}

fn gen_format_call(generator ^CodeGen, node ^ast.AstNode, prefix string, newline bool) -> string {
    arguments = node^.call^.args
    if len(arguments) != 2 { return "0 /* unsupported format call */" }
    mut values FormatValues = FormatValues{}
    values.id = 0
    values.is_literal = arguments[1]^.kind == ast.NodeKind.ARRAY_VALUE
    mut staged_prefix string = ""
    if values.is_literal {
        values.elements = arguments[1]^.array_value^.elements
    } otherwise {
        // an array variable is evaluated once; each directive then reads one element of it
        if !is_array_type(expr_type(generator, arguments[1])) { return "0 /* unsupported format call */" }
        values.array_element = array_element_type(expr_type(generator, arguments[1]))
        values.id = next_id(generator)
        staged_prefix = "({ GrayArray _gray_format_values${values.id} = ${gen_expr(generator, arguments[1])}; "
    }
    mut body string = ""
    if arguments[0]^.kind == ast.NodeKind.STRING_VALUE {
        text = ast.ast_string_decode(arguments[0]^.string_value)
        directives = scan_format_directives(text)
        mut has_string_directive = false
        mut value_index i64 = 0
        for_each directive in directives {
            if directive.specifier == "" { continue }
            if format_directive_is_string(generator, values, directive, value_index) {
                has_string_directive = true
                break
            }
            value_index = value_index + 1
        }
        if has_string_directive {
            body = format_segmented(generator, node, values, prefix, newline, text, directives)
        } otherwise {
            body = "${prefix}${format_normalized(generator, values, text, newline, 0)}${format_arguments(generator, node, values, text, true, 0)})"
        }
    } otherwise {
        body = "${prefix}${gen_expr(generator, arguments[0])}.data${format_arguments(generator, node, values, "", false, 0)})"
    }
    if staged_prefix != "" { return "${staged_prefix}${body}; })" }
    return body
}

// A call to a stdlib module function.
// wrap_add, wrap_sub, wrap_mult and wrap_div. Narrow types compute in unsigned
// 64-bit arithmetic and truncate; wide types use the runtime's operations.
fn gen_wrapping_call(generator ^CodeGen, node ^ast.AstNode, name string) -> string {
    operation = strings.slice(name, WRAP_PREFIX_LENGTH, len(name))
    operation_type = expr_type(generator, node)
    left = node^.call^.args[0]
    right = node^.call^.args[1]
    is_division = operation == "div"
    if is_wide_name(operation_type) {
        mut wide_operation = operation
        if operation == "mult" { wide_operation = "mul" }
        mut location = ""
        if is_division { location = ", \"${generator^.file}\", ${node^.tok.line}" }
        return "${wide_prefix(operation_type)}_${wide_operation}(${gen_coerced(generator, operation_type, left)}, ${gen_coerced(generator, operation_type, right)}${location})"
    }
    width = integer_bit_width(operation_type)
    c_name = ctype(generator, operation_type)
    if !is_division {
        mut symbol = "*"
        if operation == "add" { symbol = "+" } or operation == "sub" { symbol = "-" }
        return "((${c_name})(uint${width}_t)((uint64_t)(uint${width}_t)(${gen_expr(generator, left)}) ${symbol} (uint64_t)(uint${width}_t)(${gen_expr(generator, right)})))"
    }
    mut tail = "(${c_name})(_wn / _wd)"
    if is_signed_int_name(operation_type) { tail = "_wd == -1 ? (${c_name})(uint${width}_t)(0 - (uint64_t)(uint${width}_t)_wn) : (${c_name})(_wn / _wd)" }
    return "({ ${c_name} _wd = (${gen_expr(generator, right)}); if (!_wd) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0078\", \"division by zero\"); } ${c_name} _wn = (${gen_expr(generator, left)}); ${tail}; })"
}

// The name function_name() reports for the declared function `name`: `Type.func`
// for a struct function.
fn declared_runtime_name(generator ^CodeGen, name string) -> string {
    mut shown = name
    if maps.contains_key(generator^.funcs, name) && generator^.funcs[name]^.func_decl^.original_name != "" { shown = generator^.funcs[name]^.func_decl^.original_name }
    for_each struct_name, _ in generator^.structs {
        if strings.starts_with(shown, "${struct_name}_") {
            return "${struct_name}.${strings.slice(shown, len(struct_name) + 1, len(shown))}"
        }
    }
    return shown
}

// The compiler version runtime.version() reports.
fn runtime_version() -> string {
    return "0.13.0"
}

// The bit width of a sized integer type name.
fn integer_bit_width(type_name string) -> i64 {
    when strings.slice(type_name, 1, len(type_name)) {
        is "8" { return 8 }
        is "16" { return 16 }
        is "32" { return 32 }
        default { return 64 }
    }
}

// arrays.map, filter, any, all, reduce, find_index, find and sort_by: loops over the
// array that call the function value on each element.
fn gen_array_closure_call(generator ^CodeGen, node ^ast.AstNode, function_name string) -> string {
    arguments = node^.call^.args
    mut element_type string = array_element_type(expr_type(generator, arguments[0]))
    if element_type == "" { element_type = "i64" }
    element_c = ctype(generator, element_type)
    source = gen_expr(generator, arguments[0])
    callback = gen_expr(generator, arguments[1])
    when function_name {
        is "map" {
            return "({ GrayArray _m_src = ${source}; ${element_c} (*_m_fn)(${element_c}) = (void *)${callback}; GrayArray _m_res = GRAY_ARRAY_NEW_OF(gray_default_arena, ${element_c}, _m_src.len);for (int32_t _m_i = 0; _m_i < _m_src.len; _m_i++) { ${element_c} _m_v = _m_fn(((${element_c} *)_m_src.data)[_m_i]); gray_arrays_append(gray_default_arena, &_m_res, &_m_v); } _m_res; })"
        }
        is "filter" {
            return "({ GrayArray _f_src = ${source}; bool (*_f_fn)(${element_c}) = (void *)${callback}; GrayArray _f_res = GRAY_ARRAY_NEW_OF(gray_default_arena, ${element_c}, _f_src.len);for (int32_t _f_i = 0; _f_i < _f_src.len; _f_i++) { ${element_c} _f_v = ((${element_c} *)_f_src.data)[_f_i]; if (_f_fn(_f_v)) { gray_arrays_append(gray_default_arena, &_f_res, &_f_v); } } _f_res; })"
        }
        is "any" {
            return "({ GrayArray _a_src = ${source}; bool (*_a_fn)(${element_c}) = (void *)${callback}; bool _a_res = false; for (int32_t _a_i = 0; _a_i < _a_src.len; _a_i++) { if (_a_fn(((${element_c} *)_a_src.data)[_a_i])) { _a_res = true; break; } } _a_res; })"
        }
        is "all" {
            return "({ GrayArray _l_src = ${source}; bool (*_l_fn)(${element_c}) = (void *)${callback}; bool _l_res = true; for (int32_t _l_i = 0; _l_i < _l_src.len; _l_i++) { if (!_l_fn(((${element_c} *)_l_src.data)[_l_i])) { _l_res = false; break; } } _l_res; })"
        }
        is "find_index" {
            return "({ GrayArray _fi_src = ${source}; bool (*_fi_fn)(${element_c}) = (void *)${callback}; int64_t _fi_res = -1; for (int32_t _fi_i = 0; _fi_i < _fi_src.len; _fi_i++) { if (_fi_fn(((${element_c} *)_fi_src.data)[_fi_i])) { _fi_res = _fi_i; break; } } _fi_res; })"
        }
        is "find" {
            return "({ GrayArray _fd_src = ${source}; bool (*_fd_fn)(${element_c}) = (void *)${callback}; ${element_c} _fd_v0 = (${element_c}){0}; bool _fd_ok = false; for (int32_t _fd_i = 0; _fd_i < _fd_src.len; _fd_i++) { ${element_c} _fd_e = ((${element_c} *)_fd_src.data)[_fd_i]; if (_fd_fn(_fd_e)) { _fd_v0 = _fd_e; _fd_ok = true; break; } } (struct { ${element_c} v0; bool v1; }){ _fd_v0, _fd_ok }; })"
        }
        is "sort_by" {
            return "({ GrayArray *_sb_arr = ${address_of_arg(generator, arguments[0])}; if (gray_atomic_load32(&_sb_arr->iterating) > 0) { gray_panic_code_at(\"${generator^.file}\", ${node^.tok.line}, \"P0034\", \"cannot modify array during for_each iteration\"); } bool (*_sb_fn)(${element_c}, ${element_c}) = (void *)${callback}; int32_t _sb_n = _sb_arr->len; if (_sb_n > 1) { ${element_c} *_sb_d = (${element_c} *)gray_arena_alloc_uninitialized(gray_default_arena, 2 * sizeof(${element_c}) * (size_t)_sb_n); ${element_c} *_sb_t = _sb_d + _sb_n; memcpy(_sb_d, _sb_arr->data, sizeof(${element_c}) * (size_t)_sb_n); for (int32_t _sb_w = 1; _sb_w < _sb_n; _sb_w *= 2) { for (int32_t _sb_lo = 0; _sb_lo < _sb_n; _sb_lo += 2 * _sb_w) { int32_t _sb_mid = _sb_lo + _sb_w < _sb_n ? _sb_lo + _sb_w : _sb_n; int32_t _sb_hi = _sb_lo + 2 * _sb_w < _sb_n ? _sb_lo + 2 * _sb_w : _sb_n; int32_t _sb_i = _sb_lo, _sb_j = _sb_mid, _sb_k = _sb_lo; while (_sb_i < _sb_mid && _sb_j < _sb_hi) _sb_t[_sb_k++] = _sb_fn(_sb_d[_sb_j], _sb_d[_sb_i]) ? _sb_d[_sb_j++] : _sb_d[_sb_i++]; while (_sb_i < _sb_mid) _sb_t[_sb_k++] = _sb_d[_sb_i++]; while (_sb_j < _sb_hi) _sb_t[_sb_k++] = _sb_d[_sb_j++]; } memcpy(_sb_d, _sb_t, sizeof(*_sb_d) * (size_t)_sb_n); } memcpy(_sb_arr->data, _sb_d, sizeof(${element_c}) * (size_t)(_sb_arr->len < _sb_n ? _sb_arr->len : _sb_n)); } })"
        }
    }
    return ""
}

// Calls the stdlib table lacks that map directly onto a runtime function, or "".
fn gen_direct_module_call(generator ^CodeGen, node ^ast.AstNode, module_name string, function_name string) -> string {
    arguments = node^.call^.args
    c_arguments = gen_args(generator, arguments)
    if module_name == "chars" { return "gray_chars_${function_name}(${c_arguments})" }
    if module_name == "time" {
        if function_name == "from_parts" { return "gray_time_from_parts_result(${c_arguments})" }
        return "gray_time_${function_name}(${c_arguments})"
    }
    if module_name == "random" {
        if function_name == "rand_string" && len(arguments) == 2 { return "gray_random_string(gray_default_arena, ${c_arguments})" }
        if function_name == "rand_f64" && len(arguments) == 0 { return "gray_random_f64_unit()" }
        if function_name == "rand_f64" && len(arguments) == 2 { return "gray_random_f64_range(${c_arguments})" }
        if function_name == "rand_i64" && len(arguments) == 2 { return "gray_random_i64_range(${c_arguments})" }
        if function_name == "rand_bool" && len(arguments) == 0 { return "gray_random_bool()" }
        if function_name == "roll_dice" && len(arguments) == 2 { return "gray_random_roll_dice(${c_arguments})" }
        if function_name == "rand_u8" && len(arguments) == 0 { return "gray_random_u8()" }
        if function_name == "rand_char" && len(arguments) == 0 { return "gray_random_char()" }
        if function_name == "rand_char" && len(arguments) == 2 { return "gray_random_char_range(${c_arguments})" }
    }
    if module_name == "regex" && function_name == "is_match" { return "gray_regex_match(${c_arguments})" }
    return ""
}

// The numeric flavour a math helper is named for: f64, u64 or i64.
fn math_suffix(type_name string) -> string {
    if is_float_name(type_name) { return "f64" }
    if type_name == "u64" || type_name == "u32" || type_name == "u16" || type_name == "u8" { return "u64" }
    return "i64"
}

// A call to a math function that is not in the stdlib table.
fn gen_math_call(generator ^CodeGen, node ^ast.AstNode, function_name string) -> string {
    arguments = node^.call^.args
    if (function_name == "neg" || function_name == "abs") && len(arguments) == 1 && is_wide_name(expr_type(generator, arguments[0])) {
        wide_argument = expr_type(generator, arguments[0])
        // an unsigned wide value is its own absolute value
        if function_name == "abs" && !strings.starts_with(wide_argument, "i") { return gen_expr(generator, arguments[0]) }
        return "${wide_prefix(wide_argument)}_${function_name}_checked(${gen_expr(generator, arguments[0])}, ${location_args(generator, node)})"
    }
    if function_name == "neg" && len(arguments) == 1 {
        if is_signed_int_name(expr_type(generator, arguments[0])) { return checked_negation(generator, expr_type(generator, arguments[0]), gen_expr(generator, arguments[0]), node^.tok.line) }
        return "(-(${gen_expr(generator, arguments[0])}))"
    }
    if function_name == "abs" && len(arguments) == 1 {
        if is_signed_int_name(expr_type(generator, arguments[0])) {
            abs_id = next_id(generator)
            return "({ ${ctype(generator, expr_type(generator, arguments[0]))} _abs${abs_id} = ${gen_expr(generator, arguments[0])}; _abs${abs_id} < 0 ? ${checked_negation(generator, expr_type(generator, arguments[0]), "_abs${abs_id}", node^.tok.line)} : _abs${abs_id}; })"
        }
        return "gray_math_abs_${math_suffix(expr_type(generator, arguments[0]))}(${gen_expr(generator, arguments[0])})"
    }
    if function_name == "min" || function_name == "max" || function_name == "clamp" {
        // the result has the type of the operands: a float anywhere makes it a float
        mut result_type = expr_type(generator, arguments[0])
        for_each argument in arguments {
            if is_float_name(expr_type(generator, argument)) { result_type = "f64" }
        }
        // the typechecker's common type, which a wide operand anywhere decides
        if !is_float_name(result_type) && is_wide_name(expr_type(generator, node)) { result_type = expr_type(generator, node) }
        if is_wide_name(result_type) {
            // a wide operand compares with the wide helpers
            prefix = wide_prefix(result_type)
            id = next_id(generator)
            c_wide = ctype(generator, result_type)
            mut declared = ""
            for i in range(0, len(arguments)) { declared = "${declared}${c_wide} _mm${id}_${i} = ${gen_coerced(generator, result_type, arguments[i])}; " }
            if function_name == "clamp" { return "({ ${declared}${prefix}_lt(_mm${id}_0, _mm${id}_1) ? _mm${id}_1 : ${prefix}_lt(_mm${id}_2, _mm${id}_0) ? _mm${id}_2 : _mm${id}_0; })" }
            if function_name == "min" { return "({ ${declared}${prefix}_lt(_mm${id}_1, _mm${id}_0) ? _mm${id}_1 : _mm${id}_0; })" }
            return "({ ${declared}${prefix}_lt(_mm${id}_0, _mm${id}_1) ? _mm${id}_1 : _mm${id}_0; })"
        }
        return "gray_math_${function_name}_${math_suffix(result_type)}(${gen_args(generator, arguments)})"
    }
    // a wide integer argument converts to the float the function takes
    mut math_pieces [string] = {}
    for_each math_arg in arguments {
        if is_wide_name(expr_type(generator, math_arg)) { arrays.append(math_pieces, gen_coerced(generator, "f64", math_arg)) } otherwise { arrays.append(math_pieces, gen_expr(generator, math_arg)) }
    }
    return "gray_math_${function_name}(${strings.join(math_pieces, ", ")})"
}

fn gen_module_call(generator ^CodeGen, node ^ast.AstNode, module_name string, function_name string) -> string {
    arguments = node^.call^.args
    more_text = gen_more_module_call(generator, node, module_name, function_name)
    if more_text != "" { return more_text }
    if module_name == "json" {
        json_text = gen_json_call(generator, node, function_name)
        if json_text != "" { return json_text }
    }
    // Color.names() and Color.variants() on a plain enum: a fresh array in declaration order
    if (function_name == "names" || function_name == "variants") && len(arguments) == 0 && maps.contains_key(generator^.enums, eff(generator, module_name)) && !is_tagged_enum(generator, eff(generator, module_name)) {
        enum_name = eff(generator, module_name)
        mut element_c = "GrayEnum_${enum_name}"
        if function_name == "names" { element_c = "GrayString" }
        values = generator^.enums[enum_name]^.enum_decl^.values
        mut pushes = ""
        for_each value in values {
            if function_name == "names" {
                pushes = "${pushes}{ GrayString _en_v = gray_string_lit(\"${value.name}\"); GRAY_ARRAY_PUSH(gray_default_arena, &_en_arr, &_en_v); } "
            } otherwise {
                pushes = "${pushes}{ ${element_c} _en_v = GrayEnum_${enum_name}_${value.name}; GRAY_ARRAY_PUSH(gray_default_arena, &_en_arr, &_en_v); } "
            }
        }
        return "({ GrayArray _en_arr = GRAY_ARRAY_NEW_OF(gray_default_arena, ${element_c}, ${len(values)}); ${pushes}_en_arr; })"
    }
