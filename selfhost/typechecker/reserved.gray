/*
 * reserved.gray:  Canonical lists of reserved identifiers (type names,
 * builtins, stdlib modules) that user declarations may not shadow. Lookups are
 * plain linear scans.
 *
 * Author:  Marshall A Burns <marshallbcodes@gmail.com>
 * GitHub: @SchoolyB
 * Copyright (c) 2026-Present Marshall A Burns
 * Licensed under the MIT License. See LICENSE for details.
 */

import @arrays

fn reserved_type_names() -> [string] {
    names [string] = {
        "Error", "ErrorCode", "SourceLocation", "bool", "char", "f32", "f64",
        "func", "i128", "i16", "i256", "i32", "i64", "i8",
        "map", "nil", "string", "u128", "u16", "u256", "u32", "u64", "u8",
        "void"
    }
    return names
}

fn is_reserved_type_name(name string) -> bool {
    return arrays.contains(reserved_type_names(), name)
}

fn builtin_func_names() -> [string] {
    names [string] = {
        "addr", "assert", "cast", "char_count", "copy", "embed",
        "eprint", "eprintln", "error", "exit", "fields", "flush",
        "from_c_string", "here", "input", "len", "new", "panic", "print",
        "println", "range", "raw", "ref", "size_of", "sleep_ms",
        "sleep_ns", "sleep_s", "system", "to_c_string", "to_char", "type_of",
        "wrap_add", "wrap_div", "wrap_mult", "wrap_sub"
    }
    return names
}

fn is_reserved_builtin_func_name(name string) -> bool {
    return arrays.contains(builtin_func_names(), name)
}

fn stdlib_module_names() -> [string] {
    names [string] = {
        "arrays", "atomic", "binary", "channels", "chars", "crypto", "csv",
        "encoding", "fmt", "http", "io", "json", "maps", "math", "mem",
        "net", "os", "path", "random", "regex", "runtime", "server", "sqlite", "strconv",
        "strings", "sync", "threads", "time", "uuid"
    }
    return names
}

fn is_stdlib_module_name(name string) -> bool {
    return arrays.contains(stdlib_module_names(), name)
}

fn is_reserved_name(name string) -> bool {
    if is_reserved_type_name(name) { return true }
    if is_reserved_builtin_func_name(name) { return true }
    return is_stdlib_module_name(name)
}

fn reserved_stdlib_struct_names() -> [string] {
    names [string] = {
        "Arena", "Builder", "Channel", "Database", "ExecResult", "FileInfo",
        "HttpRequest", "HttpResponse", "Listener", "Mutex", "Router", "Socket",
        "SourceLocation", "SpinLock", "Thread", "UUID"
    }
    return names
}

fn is_reserved_stdlib_struct_name(name string) -> bool {
    return arrays.contains(reserved_stdlib_struct_names(), name)
}
