import @maps, @arrays, @fmt, @strings, @io, @path
import "../ast/ast"
import "./scope"
import "./types"
import "../lexer/token"
import "./folding"
import "../util/suggest"
import "./reserved"
import "./stdlib_sigs"
import "../util/error_registry"

// Errors past this many are dropped.
const MAX_ERRORS i64 = 20
// A flags enum has one usable bit per variant, at most this many.
const MAX_FLAG_VARIANTS i64 = 63
// The most parameters whose effect is tracked in a bit mask.
const MAX_TRACKED_PARAMETERS i64 = 63
// The progress of the per-function summary passes.
const ANALYSIS_NOT_STARTED i64 = 0
const ANALYSIS_IN_PROGRESS i64 = 1
const ANALYSIS_DONE i64 = 2
// The longest alias chain followed before it is taken to be a cycle.
const MAX_ALIAS_CHAIN i64 = 32
// The deepest type spelled out when showing a type in a message.
const MAX_TYPE_DISPLAY_DEPTH i64 = 8
// A suggestion must be closer than this many edits.
const SUGGESTION_DISTANCE_LIMIT i64 = 3
// Offsets within a type name written as text: "[]", "map[]", "map[", "func(", "->", "range(".
const ARRAY_BRACKETS_LENGTH i64 = 2
const MAP_BRACKETS_LENGTH i64 = 5
const MAP_PREFIX_LENGTH i64 = 4
const FUNC_OPEN_PAREN_INDEX i64 = 4
const FUNC_PARAMS_START i64 = 5
const RETURN_ARROW_LENGTH i64 = 2
const RANGE_PREFIX_LENGTH i64 = 6
const VOID_KEYWORD_LENGTH i64 = 4
// The length of "encode_" in the name of a binary encoder.
const ENCODE_PREFIX_LENGTH i64 = 7
// The functions of tuple-returning stdlib calls return a value and one more.
const RESULT_PAIR_COUNT i64 = 2
// Integer limits.
const I64_MAX i64 = 9223372036854775807
const MAX_VALUE_BEFORE_NEXT_DIGIT i64 = 922337203685477579
const LARGEST_POWER_OF_TWO_I64 i64 = 4611686018427387904
const MAX_FORMAT_AMOUNT i64 = 2147483647
// Unicode: the highest codepoint and the UTF-16 surrogates; the first printable ASCII character.
const MAX_CODEPOINT i64 = 1114111
const SURROGATE_MIN i64 = 55296
const SURROGATE_MAX i64 = 57343
const FIRST_PRINTABLE_CHARACTER i64 = 32
// The base of decimal numbers, and the bases an integer parse or format accepts.
const DECIMAL_BASE i64 = 10
const MIN_NUMBER_BASE i64 = 2
const MAX_NUMBER_BASE i64 = 36

// A single compiler diagnostic. Accumulated on the checker rather than
// printed immediately, matching the ParseError pattern already used by
// parser.gray — the driver decides how/when to render them.
const Diagnostic struct {
    code string
    message string
    file string
    line i64
    col i64
    // The underline's last column (0 for a single caret) and the suggestion printed under it
    end_col i64
    help string
}

const StructInfo struct {
    struct_name string
    display_name string
    field_names [string]
    field_types [^types.GrayType]
    is_deprecated bool
    deprecated_message string
    is_json bool
    // Declared by the program itself, never provided by the compiler or a stdlib module
    is_user_declared bool
    // The written type of each field, `[T,N]` keeping its size
    field_spellings [string]
}

const FuncSig struct {
    name string
    param_types [^types.GrayType]
    return_types [^types.GrayType]
    used bool
    is_private bool
    is_discard bool
    param_mutable [bool]
    min_args i64
    is_generic bool
    decl ^ast.FuncDeclData
    // The file the function was declared in
    file string
    // The line it was declared on, for the never-called warning
    definition_line i64
    instantiations [string]
    instantiation_calls [^ast.AstNode]
    // Escape summary (computed on demand by ensure_escape_summary): 0 not
    // started, 1 in progress, 2 done
    escape_state i64
    // Bit i: the result may carry the address held by parameter i
    returns_parameter_address i64
    // For each parameter: ESCAPE_NONE, ESCAPE_GLOBAL, or the index of the
    // parameter whose storage its address is stored into
    parameter_escape_into [i64]
    parameter_escape_global_name [string]
    // When a parameter's global escape is only a forward into an indirect call through one
    // of this function's func-typed parameters: that parameter's index and the argument
    // position of the call; -1 when the escape is anything else
    parameter_escape_via_function [i64]
    parameter_escape_via_position [i64]
    // The function can return a pointer to a module-level constant
    can_return_const_pointer bool
    // Bit i: the function writes through its pointer parameter i
    writes_through_parameter i64
    // Bit i: parameter i reaches an extern call (the callee half of the extern call check)
    passes_parameter_to_extern i64
    // @mem summary (computed on demand by ensure_mem_summary): 0 not started, 1 in
    // progress, 2 done. Bit i: the function destroys / resets the arena its parameter i
    // names, or the arena at the field path recorded in mem_parameter_field[i]; and
    // returns a @mem pointer allocated from it, directly or buried in a returned aggregate
    mem_state i64
    destroys_parameter_arena i64
    resets_parameter_arena i64
    mem_parameter_field [string]
    returns_parameter_mem_allocation i64
    returns_parameter_mem_allocation_field i64
}

const EnumInfo struct {
    name string
    display_name string
    is_string bool
    is_tagged bool
    is_flags bool
    values [string]
    variant_payload_types [[string]]
    is_deprecated bool
    deprecated_message string
}

// Import tracking. Unlike the struct/func/enum registries, these are
// accumulate-only records with no need for keyed lookup, so they're plain
// value arrays rather than maps — no need for the pointer-based
// copy-out/modify/copy-back dance those registries use.
const ImportEntry struct {
    mod_name string
    file string
    line i64
    used bool
    is_stdlib bool
}

const AliasEntry struct {
    import_alias string
    mod_name string
}

const TypeAlias struct {
    name string
    target string
    file string
    is_private bool
    is_distinct bool
    line i64
    col i64
}

// One `extern.NAME` use, recorded for the driver, which asks the real C header about it.
const ExternCallSite struct {
    function_name string
    argument_count i64
    is_call bool
    file string
    line i64
    col i64
    node ^ast.AstNode
    // The Grayscale function passed as the callback argument at each position, or ""
    callback_names [string]
    // The type of each argument, as resolved
    argument_types [^types.GrayType]
    // The type a declaration or cast asserts for the call's result, or nil
    asserted_type ^types.GrayType
    is_asserted_via_cast bool
}

const TypeChecker struct {
    pool ^types.TypePool
    global_scope ^scope.Scope
    current_scope ^scope.Scope
    structs map[string:^StructInfo]
    funcs map[string:^FuncSig]
    // A function a same-named later declaration replaced; nothing can call it
    shadowed_functions [^FuncSig]
    enums map[string:^EnumInfo]
    diagnostics [Diagnostic]
    imports [ImportEntry]
    import_aliases [AliasEntry]
    // The file whose declaration is being checked: an import is in scope only there
    current_check_file string
    // True while a `when` case value is resolved: a payload variant may be named bare there
    allows_payloadless_variant bool
    // @mem arena lifetime state of the function being checked, and the arena field
    // paths assigned since it started
    arenas [ArenaLifetime]
    reassigned_arena_paths [string]
    // True while a cross-function summary is built: an alias name stays literal then
    is_in_mem_summary bool
    // Calls whose helper-destroys-arena effect was already applied
    applied_mem_effects map[string:bool]
    type_aliases [TypeAlias]
    current_struct_name string
    current_return_types [^types.GrayType]
    has_named_returns bool
    current_return_names [string]
    is_main_function bool
    // The label of each enclosing loop, innermost last; "" for an unlabeled one.
    loop_labels [string]
    function_depth i64
    // Names a file-scope multi-name declaration binds later than the initializer being checked
    hidden_group_names [string]
    // The variable whose initializer is being checked, and whether that initializer read an outer variable of the same name
    initialized_variable_name string
    // The common number type of the stdlib call last checked (math.min / max / clamp), nil when it has none
    last_common_number_type ^types.GrayType
    is_initializer_reading_own_name bool
    stdlib_signatures [string:stdlib_sigs.StdlibSig]
    using_modules [string]
    generics ast.GenericBindings
    // set during the per-instantiation re-check, which must not overwrite the
    // types the unbound pass recorded: codegen resolves those per instantiation
    suppress_type_writes bool
    // Number literal expressions read without a type: they take their default type when their statement ends
    pending_literals [^ast.AstNode]
    // The file-scope const integers a name may fold to
    const_integers ^folding.ConstantTable
    // registry spellings of the valid #error_code enums
    error_code_enums [string]
    // the type the expression being resolved is expected to have, or nil; a
    // bare `.VARIANT` resolves against it
    expected_type ^types.GrayType
    // The expression of the statement being checked, so an undefined name that
    // is the whole statement can be reported as a misspelled statement word.
    statement_expression ^ast.AstNode
    // The json.parse() call whose #json target a declaration or return slot supplies
    json_parse_target_call ^ast.AstNode
    // An error was reported: the missing-main check stays quiet
    was_main_name_misused bool
    // True while declarations are being registered: forward references to types not yet
    // registered must still resolve
    is_registering bool
    // `check` accepts a file with no main(): a library module
    is_main_optional bool
    // Open `unsafe` blocks and functions around the code being checked
    unsafe_depth i64
    // The function being checked and the scope depth (biased by +1) of its own
    // scope: a pointer origin at least this deep dies when the function returns
    current_function ^ast.AstNode
    current_function_scope_depth i64
    // The one range() call or range-holding name allowed to appear here as a
    // value; anywhere else a range is an error
    range_use ^ast.AstNode
    // Every `extern.NAME` use seen, in source order
    extern_calls [ExternCallSite]
}

// The number of error diagnostics reported so far.
fn diagnostic_error_count(checker ^TypeChecker) -> i64 {
    mut count i64 = 0
    for_each diagnostic in checker^.diagnostics {
        if !strings.starts_with(diagnostic.code, "W") { count += 1 }
    }
    return count
}

fn add_diagnostic(checker ^TypeChecker, code string, message string, file string, line i64, col i64) {
    // Errors past the twentieth are dropped
    if !strings.starts_with(code, "W") && diagnostic_error_count(checker) >= MAX_ERRORS { return }
    mut ds [Diagnostic] = checker^.diagnostics
    arrays.append(ds, Diagnostic{code: code, message: message, file: file, line: line, col: col, help: default_help(code, message)})
    checker^.diagnostics = ds
}

// A diagnostic with a suggestion printed under it.
fn add_diagnostic_help(checker ^TypeChecker, code string, message string, help string, file string, line i64, col i64) {
    if !strings.starts_with(code, "W") && diagnostic_error_count(checker) >= MAX_ERRORS { return }
    mut ds [Diagnostic] = checker^.diagnostics
    arrays.append(ds, Diagnostic{code: code, message: message, file: file, line: line, col: col, help: help})
    checker^.diagnostics = ds
}

fn typechecker_create() -> ^TypeChecker {
    checker = new(TypeChecker)
    checker^.pool = types.create_type_pool()
    mut no_parent ^scope.Scope = nil
    root = scope.scope_create(no_parent)
    checker^.global_scope = root
    checker^.current_scope = root
    checker^.const_integers = new(folding.ConstantTable)
    for_each signature in stdlib_sigs.stdlib_sig_table() {
        checker^.stdlib_signatures["${signature.module}.${signature.name}"] = signature
    }
    return checker
}

// Makes the `generic` parameters of `function_data` the active type parameters, so the
// types written in its signature and body resolve through them. With a
// `binding_text` they stand for those types; without one they are unbound and
// stand for unknown types.
fn checker_enter_generics(checker ^TypeChecker, function_data ^ast.FuncDeclData, binding_text string) {
    checker^.generics = ast.generic_bindings_init(function_data, binding_text)
}

fn checker_leave_generics(checker ^TypeChecker) {
    mut none ast.GenericBindings = ast.GenericBindings{}
    checker^.generics = none
}

// `type_text` with the active type parameters replaced by what they stand for.
fn checker_substitute_generics(checker ^TypeChecker, type_text string) -> string {
    if len(checker^.generics.names) == 0 { return type_text }
    return ast.generic_bindings_substitute(checker^.generics, type_text)
}

// A written type name resolved against the checker's registries: the pool
// alone cannot tell an enum name from a struct name, so it types both as a
// struct.
// A stdlib opaque type written with its module (`mem.Arena`, `[sync.Mutex]`) is
// the bare type (`Arena`): the module-qualified spelling only says where it comes
// from.
fn strip_stdlib_qualifiers(checker ^TypeChecker, written_name string) -> string {
    if !strings.contains(written_name, ".") { return written_name }
    mut result string = written_name
    for_each opaque_name in {"Arena", "Builder", "Thread", "Mutex", "SpinLock", "Channel", "Socket", "Listener", "Database", "Router", "HttpRequest", "HttpResponse", "ExecResult", "FileInfo", "UUID"} {
        for_each owner in stdlib_opaque_modules(opaque_name) {
            result = strings.replace(result, "${owner}.${opaque_name}", opaque_name)
            for_each alias_entry in checker^.import_aliases {
                if alias_entry.mod_name == owner {
                    result = strings.replace(result, "${alias_entry.import_alias}.${opaque_name}", opaque_name)
                }
            }
        }
    }
    return result
}

fn checker_type_from_name(checker ^TypeChecker, written_name string) -> ^types.GrayType {
    name = resolve_type_alias_keeping_distinct(checker, strip_stdlib_qualifiers(checker, checker_substitute_generics(checker, written_name)))
    t = types.type_from_name(checker^.pool, name)
    if t^.kind == types.TypeKind.STRUCT && is_enum_name(checker, name) {
        return types.type_enum_type(checker^.pool, name)
    }
    // Once registration is done, a capitalized name that is no struct, enum, Error or
    // imported stdlib opaque type names nothing
    if t^.kind == types.TypeKind.STRUCT && !checker^.is_registering && name != "" && strings.char_at(name, 0) >= 'A' && strings.char_at(name, 0) <= 'Z' && name != "Error" && !is_struct_name(checker, name) && !is_enum_name(checker, name) {
        if !stdlib_opaque_type_available(checker, name) { return checker^.pool^.type_unknown }
        mark_type_module_used(checker, name)
    }
    return t
}

// --- Struct registry ---

fn register_struct(checker ^TypeChecker, name string, display_name string, field_names [string], field_types [^types.GrayType]) {
    si = new(StructInfo)
    si^.struct_name = name
    if display_name == "" {
        si^.display_name = name
    } otherwise {
        si^.display_name = display_name
    }
    // Appended in place: assigning the caller's local arrays would leave the
    // heap record pointing at freed memory.
    for_each field_name in field_names { arrays.append(si^.field_names, field_name) }
    for_each field_type in field_types { arrays.append(si^.field_types, field_type) }

    mut m = checker^.structs
    m[name] = si
    checker^.structs = m
}

fn find_struct(checker ^TypeChecker, name string) -> ^StructInfo {
    m = checker^.structs
    if maps.contains_key(m, name) {
        return m[name]
    }
    return nil
}

fn is_struct_name(checker ^TypeChecker, name string) -> bool {
    return find_struct(checker, name) != nil
}

// The name the programmer wrote for a struct, never a module-prefixed
// lookup key. Diagnostics and namespace-collision checks must use this.
fn struct_display_name(checker ^TypeChecker, name string) -> string {
    si = find_struct(checker, name)
    if si != nil {
        return si^.display_name
    }
    return name
}

// --- Function signature registry ---

fn register_func(checker ^TypeChecker, name string, param_types [^types.GrayType], return_types [^types.GrayType]) {
    fs = new(FuncSig)
    fs^.name = name
    fs^.param_types = param_types
    fs^.return_types = return_types
    fs^.used = false
    fs^.is_private = false
    fs^.is_discard = false
    fs^.min_args = len(param_types)

    mut m = checker^.funcs
    m[name] = fs
    checker^.funcs = m
}

fn find_func(checker ^TypeChecker, name string) -> ^FuncSig {
    m = checker^.funcs
    if maps.contains_key(m, name) {
        return m[name]
    }
    return nil
}

// --- Enum registry ---

fn register_enum(checker ^TypeChecker, name string, display_name string, is_string bool, values [string], variant_payload_types [[string]], is_tagged bool, is_flags bool) {
    ei = new(EnumInfo)
    ei^.name = name
    if display_name == "" {
        ei^.display_name = name
    } otherwise {
        ei^.display_name = display_name
    }
    ei^.is_string = is_string
    ei^.is_tagged = is_tagged
    ei^.is_flags = is_flags
    ei^.values = values
    ei^.variant_payload_types = variant_payload_types

    mut m = checker^.enums
    m[name] = ei
    checker^.enums = m
}

fn find_enum(checker ^TypeChecker, name string) -> ^EnumInfo {
    m = checker^.enums
    if maps.contains_key(m, name) {
        return m[name]
    }
    return nil
}

fn is_enum_name(checker ^TypeChecker, name string) -> bool {
    return find_enum(checker, name) != nil
}

// As struct_display_name, for enums.
fn enum_display_name(checker ^TypeChecker, name string) -> string {
    ei = find_enum(checker, name)
    if ei != nil {
        return ei^.display_name
    }
    return name
}

fn enum_is_string(checker ^TypeChecker, name string) -> bool {
    ei = find_enum(checker, name)
    if ei != nil {
        return ei^.is_string
    }
    return false
}

fn enum_is_tagged(checker ^TypeChecker, name string) -> bool {
    ei = find_enum(checker, name)
    if ei != nil {
        return ei^.is_tagged
    }
    return false
}

fn enum_is_flags(checker ^TypeChecker, name string) -> bool {
    ei = find_enum(checker, name)
    if ei != nil {
        return ei^.is_flags
    }
    return false
}

// --- Cross-module type identity ---
// Compare type names by their user-facing display names, so a module-
// prefixed internal name (e.g. lib_Foo) matches the same type imported
// under a different module alias (e.g. objects_Foo).

fn same_struct_type(checker ^TypeChecker, a string, b string) -> bool {
    return a == b
}

fn same_enum_type(checker ^TypeChecker, a string, b string) -> bool {
    if a == b { return true }
    // A #error_code enum value is interchangeable with an ErrorCode value, but
    // only with ErrorCode: each concrete #error_code enum stays its own type.
    if enum_is_error_code(checker, a) && enum_is_error_code(checker, b) {
        return a == "ErrorCode" || b == "ErrorCode"
    }
    return false
}

// Compare array element type names accounting for module-prefixed
// struct/enum aliases (e.g. "Item" vs "utils_Item" should match).
fn same_array_element(checker ^TypeChecker, a string, b string) -> bool {
    if a == b { return true }
    at = checker_type_from_name(checker, a)
    bt = checker_type_from_name(checker, b)
    if at^.kind == types.TypeKind.STRUCT && bt^.kind == types.TypeKind.STRUCT {
        return same_struct_type(checker, a, b)
    }
    if at^.kind == types.TypeKind.ENUM && bt^.kind == types.TypeKind.ENUM {
        return same_enum_type(checker, a, b)
    }
    return false
}

// True for the builtin open enum "ErrorCode" and for any valid #error_code enum.
fn enum_is_error_code(checker ^TypeChecker, name string) -> bool {
    if name == "ErrorCode" { return true }
    return arrays.contains(checker^.error_code_enums, name)
}

// The compiler-owned ErrorCode variants, in slot order (error_code_builtins.h).
fn builtin_error_codes() -> [string] {
    return {"Unknown", "NotFound", "AlreadyExists", "PermissionDenied", "InvalidInput", "OutOfRange", "Unsupported", "Timeout", "Interrupted", "Closed", "WouldBlock", "Unavailable", "IoFailure", "ParseFailure", "EncodingFailure", "ConversionFailure", "NotAuthenticated", "ConnectionRefused", "ConnectionReset", "AddressInUse", "BrokenPipe", "WriteZero"}
}

// Assembles the program-wide open ErrorCode enum: the builtin variants first,
// then the variants of every #error_code enum in source order. Validates each
// #error_code enum and rejects duplicate variant names across the whole set.
fn register_error_code_set(checker ^TypeChecker, program ^ast.AstNode) {
    mut names [string] = builtin_error_codes()
    mut enum_names [string] = {}
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.ENUM_DECL || !statement^.enum_decl^.is_error_code { continue }
        display = enum_display_name_for(statement)
        file = statement^.tok.file
        line = statement^.tok.line
        col = statement^.tok.col
        mut is_bad = false
        if statement^.enum_decl^.is_tagged {
            add_diagnostic(checker, "E3147", error_registry.registry_message_formatted("E3147", {display}), file, line, col)
            is_bad = true
        }
        if statement^.enum_decl^.is_flags {
            add_diagnostic(checker, "E3152", error_registry.registry_message_formatted("E3152", {display}), file, line, col)
            is_bad = true
        }
        for_each v in statement^.enum_decl^.values {
            if v.value == nil { continue }
            if v.value^.kind == ast.NodeKind.STRING_VALUE {
                add_diagnostic(checker, "E3145", error_registry.registry_message_formatted("E3145", {display}), file, line, col)
            } otherwise {
                add_diagnostic(checker, "E3146", error_registry.registry_message_formatted("E3146", {display, v.name}), file, line, col)
            }
            is_bad = true
            break
        }
        if is_bad { continue }
        arrays.append(enum_names, statement^.enum_decl^.name)
        for_each v in statement^.enum_decl^.values {
            if arrays.contains(names, v.name) {
                add_diagnostic(checker, "E3148", error_registry.registry_message_formatted("E3148", {v.name}), file, line, col)
                continue
            }
            arrays.append(names, v.name)
        }
    }
    checker^.error_code_enums = enum_names
    mut no_payloads [[string]] = {}
    register_enum(checker, "ErrorCode", "ErrorCode", false, names, no_payloads, false, false)
}

// --- Declaration registration: enums ---
// Walks the program's top-level enum declarations, validates them, and
// populates the enum registry. Enums are registered before structs so that
// struct field types referencing enums resolve correctly.

fn enum_display_name_for(statement ^ast.AstNode) -> string {
    if statement^.enum_decl^.original_name != "" {
        return statement^.enum_decl^.original_name
    }
    return statement^.enum_decl^.name
}

fn register_decl_enums(checker ^TypeChecker, program ^ast.AstNode) {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind != ast.NodeKind.ENUM_DECL { continue }

        en = enum_display_name_for(statement)
        ed_name = statement^.enum_decl^.name
        file = statement^.tok.file
        line = statement^.tok.line
        col = statement^.tok.col

        check_declaration_name(checker, ed_name, en, "an enum", file, line, col)
        check_reserved_main(checker, ed_name, file, line, col)

        values = statement^.enum_decl^.values
        if len(values) == 0 {
            message = error_registry.registry_message_formatted("E2016", {en})
            add_diagnostic(checker, "E2016", message, file, line, col)
        }

        // A flags enum has one usable bit per variant, at most MAX_TRACKED_PARAMETERS
        if statement^.enum_decl^.is_flags && len(values) > MAX_FLAG_VARIANTS {
            add_diagnostic(checker, "E3143", error_registry.registry_message_formatted("E3143", {en, "${len(values)}"}), file, line, col)
        }
        // A #flags variant with an explicit value must occupy exactly one usable bit.
        // 0 is allowed as a "none" sentinel; a literal above INT64_MAX reaches the sign bit.
        if statement^.enum_decl^.is_flags {
            for_each flag_variant in values {
                flag_value = flag_variant.value
                if flag_value == nil { continue }
                is_negated = flag_value^.kind == ast.NodeKind.PREFIX_EXPR && flag_value^.prefix^.op == token.TokenKind.MINUS && flag_value^.prefix^.right^.kind == ast.NodeKind.INT_VALUE
                mut flag_literal = flag_value
                if is_negated { flag_literal = flag_value^.prefix^.right }
                if flag_literal^.kind != ast.NodeKind.INT_VALUE { continue }
                literal_value = flag_literal^.int_value^.value
                is_single_bit = !is_negated && !flag_literal^.int_value^.overflow && (literal_value == 0 || (literal_value bit_and (literal_value - 1)) == 0)
                if is_single_bit { continue }
                mut shown = flag_literal^.int_value^.literal
                if is_negated { shown = "-${shown}" }
                add_diagnostic(checker, "E3176", error_registry.registry_message_formatted("E3176", {en, flag_variant.name, shown}), flag_value^.tok.file, flag_value^.tok.line, flag_value^.tok.col)
            }
        }

        // The value each variant ends up with: an explicit value, or what its
        // position gives it. An integer enum's values are i64: an explicit value
        // must fit it, and a variant without one takes the previous
        // value plus one, which must fit too. Two variants with the same
        // value are an error.
        if !statement^.enum_decl^.is_error_code && !statement^.enum_decl^.is_tagged && len(values) > 0 {
            is_flags_enum = statement^.enum_decl^.is_flags
            mut is_string_enum = false
            for_each variant in values {
                if variant.value != nil && variant.value^.kind == ast.NodeKind.STRING_VALUE { is_string_enum = true }
            }
            mut value_is_known [bool] = {}
            mut numbers [i64] = {}
            mut texts [string] = {}
            mut next_is_known = true
            mut next_overflows = false
            mut next_value i64 = 0
            for j in range(0, len(values)) {
                variant_value = values[j].value
                arrays.append(value_is_known, false)
                arrays.append(numbers, 0)
                arrays.append(texts, "")
                if is_string_enum {
                    if variant_value == nil {
                        texts[j] = values[j].name
                        value_is_known[j] = true
                    } or variant_value^.kind == ast.NodeKind.STRING_VALUE {
                        texts[j] = ast.ast_string_decode(variant_value^.string_value)
                        value_is_known[j] = true
                    }
                    continue
                }
                if variant_value != nil {
                    if folding.is_literal_expression(variant_value) && !folding.literal_expression_is_decimal(variant_value) {
                        folded, is_constant = folding.constant_fold(checker^.const_integers, variant_value)
                        if is_constant && !folded.is_too_large {
                            as_i64, fits_i64 = folding.literal_value_as_i64(folded)
                            // A value past i64 is reported when the declaration is checked
                            if fits_i64 {
                                numbers[j] = as_i64
                                value_is_known[j] = true
                            }
                        }
                    }
                } or is_flags_enum {
                    if j < MAX_FLAG_VARIANTS {
                        numbers[j] = 1 bit_shift_left j
                        value_is_known[j] = true
                    }
                } or next_overflows {
                    add_diagnostic(checker, "E3213", error_registry.registry_message_formatted("E3213", {en, values[j].name}), file, line, col)
                } or next_is_known {
                    numbers[j] = next_value
                    value_is_known[j] = true
                }
                next_is_known = value_is_known[j] && numbers[j] != I64_MAX
                next_overflows = value_is_known[j] && numbers[j] == I64_MAX
                if next_is_known { next_value = numbers[j] + 1 }
            }
            for j in range(0, len(values)) {
                if !value_is_known[j] { continue }
                for index in range(0, j) {
                    if !value_is_known[index] { continue }
                    mut is_same = numbers[index] == numbers[j]
                    if is_string_enum { is_same = texts[index] == texts[j] }
                    if !is_same { continue }
                    add_diagnostic(checker, "E3033", error_registry.registry_message_formatted("E3033", {en, values[index].name, values[j].name}), file, line, col)
                    break
                }
            }
        }

        // Per-variant reserved-name checks, and string-enum detection
        mut is_str = false
        for j in range(0, len(values)) {
            vname = values[j].name

            if vname == ed_name {
                message = error_registry.registry_message_formatted("E2065", {vname, en})
                add_diagnostic(checker, "E2065", message, file, line, col)
            }
            if reserved.is_reserved_type_name(vname) {
                message = fmt.sprintf("'%s' is a reserved type name and cannot be used as an enum variant name", {vname})
                add_diagnostic(checker, "E2038", message, file, line, col)
            }
            if reserved.is_reserved_builtin_func_name(vname) {
                message = fmt.sprintf("'%s' is a builtin function and cannot be used as an enum variant name", {vname})
                add_diagnostic(checker, "E5016", message, file, line, col)
            }
            if reserved.is_stdlib_module_name(vname) {
                message = fmt.sprintf("'%s' is a standard library module and cannot be used as an enum variant name", {vname})
                add_diagnostic(checker, "E5035", message, file, line, col)
            }
            for k in range(0, j) {
                if values[k].name == vname {
                    message = error_registry.registry_message_formatted("E2014", {vname, en})
                    add_diagnostic(checker, "E2014", message, file, line, col)
                    break
                }
            }

            v = values[j].value
            if v != nil {
                if v^.kind == ast.NodeKind.STRING_VALUE {
                    is_str = true
                }
            }
        }

        if ed_name != "main" && type_name_is_duplicate(checker, program, statement, is_enum_name(checker, ed_name) || is_struct_name(checker, ed_name)) {
            message = fmt.sprintf("a type named '%s' is already declared", {en})
            add_diagnostic(checker, "E4007", message, file, line, col)
        }

        mut vnames [string] = {}
        mut vpayloads [[string]] = {}
        for_each v in values {
            arrays.append(vnames, v.name)
            arrays.append(vpayloads, v.payload_types)
        }

        has_tagged = statement^.enum_decl^.is_tagged
        if is_str && has_tagged {
            add_diagnostic(checker, "E3111", error_registry.registry_message("E3111"), file, line, col)
        }
        if statement^.enum_decl^.is_flags && has_tagged {
            add_diagnostic(checker, "E3112", error_registry.registry_message("E3112"), file, line, col)
        }

        // A payload cannot be the enum itself by value, directly or through another enum or struct
        mut enum_cycle = false
        mut enum_cycle_type = ""
        for_each variant_payloads in vpayloads {
            for_each payload in variant_payloads {
                member_type = by_value_member_type(checker, payload)
                if member_type == "" { continue }
                mut visited [string] = {}
                if member_type == ed_name || struct_contains_by_value(checker, program, find_struct_or_enum_in_program(program, member_type), ed_name, visited) {
                    enum_cycle = true
                    enum_cycle_type = member_type
                    break
                }
            }
            if enum_cycle {
                mut enum_cycle_help = "break the cycle through '${enum_cycle_type}' with a pointer payload '^${enum_cycle_type}'"
                if enum_cycle_type == ed_name { enum_cycle_help = "use a pointer payload '^${en}' for recursive types" }
                add_diagnostic_help(checker, "E3061", error_registry.registry_message_formatted("E3061", {"enum", en}), enum_cycle_help, file, line, col)
                break
            }
        }

        register_enum(checker, ed_name, en, is_str, vnames, vpayloads, has_tagged, statement^.enum_decl^.is_flags)
        find_enum(checker, ed_name)^.is_deprecated = statement^.enum_decl^.is_deprecated
        find_enum(checker, ed_name)^.deprecated_message = statement^.enum_decl^.deprecated_message
    }
}

// --- Declaration registration: structs ---

// The element spelling under every fixed-size array layer (`[T,N]` -> `T`): a
// fixed array stores its elements inline, so by-value containment sees through
// it where a dynamic `[T]` breaks the chain.
fn fixed_array_innermost_element(spelling string) -> string {
    mut current = spelling
    for current != "" && strings.starts_with(current, "[") && strings.ends_with(current, "]") {
        inner = strings.slice(current, 1, len(current) - 1)
        comma = types.type_top_level_comma(inner)
        if comma < 0 { break }
        current = strings.slice(inner, 0, comma)
    }
    return current
}

fn find_struct_or_enum_in_program(program ^ast.AstNode, name string) -> ^ast.AstNode {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind == ast.NodeKind.STRUCT_DECL {
            if statement^.struct_decl^.name == name {
                return statement
            }
        }
        if statement^.kind == ast.NodeKind.ENUM_DECL {
            if statement^.enum_decl^.name == name {
                return statement
            }
        }
    }
    return nil
}

fn struct_name_declared(program ^ast.AstNode, name string) -> bool {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind == ast.NodeKind.STRUCT_DECL && statement^.struct_decl^.name == name {
            return true
        }
    }
    return false
}

// The member type a by-value walk follows: aliases erased, fixed-size arrays
// seen through. "" when the member is a pointer, dynamic array or map, which
// break the chain.
fn by_value_member_type(checker ^TypeChecker, written string) -> string {
    if written == "" { return "" }
    member = resolve_type_alias(checker, fixed_array_innermost_element(resolve_type_alias(checker, written)))
    if member == "" { return "" }
    first = strings.char_at(member, 0)
    if first == '^' || first == '[' || strings.starts_with(member, "map[") { return "" }
    return member
}

// Depth-first walk of a struct's or tagged enum's by-value member graph
// (fields, or variant payloads), testing whether `target` appears
// transitively. Pointer members (^T), arrays ([T]), and maps (map[K:V]) are
// heap-indirected and break the chain. Grayscale arrays copy on assignment,
// so each recursive call gets its own extended copy of `visited`.
fn struct_contains_by_value(checker ^TypeChecker, program ^ast.AstNode, decl ^ast.AstNode, target string, visited [string]) -> bool {
    if decl == nil { return false }
    mut members [string] = {}
    mut declaration_name = ""
    if decl^.kind == ast.NodeKind.STRUCT_DECL {
        declaration_name = decl^.struct_decl^.name
        for_each field in decl^.struct_decl^.struct_fields {
            arrays.append(members, field.type_name)
        }
    } or decl^.kind == ast.NodeKind.ENUM_DECL {
        declaration_name = decl^.enum_decl^.name
        for_each variant in decl^.enum_decl^.values {
            for_each payload in variant.payload_types {
                arrays.append(members, payload)
            }
        }
    } otherwise {
        return false
    }
    if arrays.contains(visited, declaration_name) { return false }
    if len(visited) >= MAX_ALIAS_CHAIN { return false }

    mut next_visited [string] = visited
    arrays.append(next_visited, declaration_name)

    for_each written in members {
        member = by_value_member_type(checker, written)
        if member == "" { continue }
        if member == target { return true }
        if struct_contains_by_value(checker, program, find_struct_or_enum_in_program(program, member), target, next_visited) {
            return true
        }
    }
    return false
}

// Recursively validate that every named type inside a field's type string
// (array element types, map key/value types, pointer pointees, and
// arbitrarily nested combinations) refers to a known type. Emits an error for
// every unknown leaf type found.
fn validate_field_type_recursive(checker ^TypeChecker, program ^ast.AstNode, written_type_name string, field_name string, statement ^ast.AstNode, nested bool) {
    type_name = strip_stdlib_qualifiers(checker, written_type_name)
    if type_name == "" { return }

    if strings.starts_with(type_name, "^") {
        mut pointee = strings.slice(type_name, 1, len(type_name))
        as_long_as strings.starts_with(pointee, "^") {
            pointee = strings.slice(pointee, 1, len(pointee))
        }
        validate_field_type_recursive(checker, program, pointee, field_name, statement, true)
        return
    }

    if strings.starts_with(type_name, "[") {
        n = len(type_name)
        if n > ARRAY_BRACKETS_LENGTH && strings.char_at(type_name, n - 1) == ']' {
            mut elem = strings.slice(type_name, 1, n - 1)
            comma_idx = strings.index_of(elem, ",")
            if comma_idx >= 0 {
                elem = strings.slice(elem, 0, comma_idx)
            }
            validate_field_type_recursive(checker, program, elem, field_name, statement, true)
        }
        return
    }

    if strings.starts_with(type_name, "map[") {
        n = len(type_name)
        if n > MAP_BRACKETS_LENGTH && strings.char_at(type_name, n - 1) == ']' {
            inner = strings.slice(type_name, MAP_PREFIX_LENGTH, n - 1)
            mut depth = 0
            mut colon_pos = -1
            for i in range(0, len(inner)) {
                character = strings.char_at(inner, i)
                if character == '[' { depth = depth + 1 }
                if character == ']' { depth = depth - 1 }
                if character == ':' && depth == 0 {
                    colon_pos = i
                    break
                }
            }
            if colon_pos >= 0 {
                key_t = strings.slice(inner, 0, colon_pos)
                val_t = strings.slice(inner, colon_pos + 1, len(inner))
                validate_field_type_recursive(checker, program, key_t, field_name, statement, true)
                validate_field_type_recursive(checker, program, val_t, field_name, statement, true)
            }
        }
        return
    }

    // Leaf: must be a known primitive, enum, struct, or wildcard '?'
    if strings.contains(type_name, "?") { return }

    // Bare func is rejected only as a direct field type; as a container element
    // ([func], map[string:func]) it is the documented spelling
    if type_name == "func" && nested { return }
    if type_name == "func" {
        add_diagnostic(checker, "E3130", error_registry.registry_message("E3130"), statement^.tok.file, statement^.tok.line, statement^.tok.col)
        return
    }

    resolved = checker_type_from_name(checker, type_name)
    if resolved^.kind != types.TypeKind.STRUCT && resolved^.kind != types.TypeKind.UNKNOWN { return }
    if is_enum_name(checker, type_name) { return }
    if is_struct_name(checker, type_name) { return }
    if struct_name_declared(program, type_name) { return }
    if resolve_type_alias(checker, type_name) != type_name { return }
    if reserved.is_reserved_stdlib_struct_name(type_name) { return }

    message = error_registry.registry_message_formatted("E4016", {unqualified_display_name(type_name)})
    add_diagnostic_help(checker, "E4016", message, "", statement^.tok.file, statement^.tok.line, statement^.tok.col)
}

fn struct_display_name_for(statement ^ast.AstNode) -> string {
    if statement^.struct_decl^.original_name != "" {
        return statement^.struct_decl^.original_name
    }
    return statement^.struct_decl^.name
}

// Walks the program's top-level struct declarations, validates them,
// populates the struct registry, and registers struct-namespaced functions
// (StructName_funcName).
fn register_decl_structs(checker ^TypeChecker, program ^ast.AstNode) {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind != ast.NodeKind.STRUCT_DECL { continue }

        file = statement^.tok.file
        line = statement^.tok.line
        col = statement^.tok.col
        sd = statement^.struct_decl
        sn = struct_display_name_for(statement)

        if len(sd^.struct_fields) == 0 {
            message = error_registry.registry_message_formatted("E2067", {sn})
            add_diagnostic(checker, "E2067", message, file, line, col)
        }

        mut fnames [string] = {}
        mut ftypes [^types.GrayType] = {}
        // Workaround: for_each over a struct-array field reached through a
        // pointer (sd^.struct_fields) mistypes the loop variable as the
        // pointer's pointee struct instead of the array element.
        // Copying to a local first sidesteps it.
        // A fixed-size array field names its size as a number (an error for a non-positive
        // one) or a const integer, which is written back as its number
        mut resolved_fields = sd^.struct_fields
        mut any_size_resolved = false
        for position in range(0, len(resolved_fields)) {
            field_type_text = resolved_fields[position].type_name
            if strings.starts_with(field_type_text, "[") && type_has_array_size(field_type_text) {
                resolved_field_type = resolve_array_size_text(checker, field_type_text, file, line, col)
                if resolved_field_type != field_type_text {
                    resolved_fields[position].type_name = resolved_field_type
                    any_size_resolved = true
                }
            }
        }
        if any_size_resolved { sd^.struct_fields = resolved_fields }
        struct_fields_local = sd^.struct_fields
        for_each field in struct_fields_local {
            arrays.append(fnames, field.name)
            arrays.append(ftypes, checker_type_from_name(checker, field.type_name))
            warn_if_type_name_deprecated(checker, statement, field.type_name, "")
            mark_written_type_module_used(checker, field.type_name)

            if field.type_name == "void" {
                message = error_registry.registry_message_formatted("E3038", {"a struct field type"})
                add_diagnostic(checker, "E3038", message, file, line, col)
            }
            if field.name == sd^.name {
                message = error_registry.registry_message_formatted("E2066", {field.name, sn})
                add_diagnostic(checker, "E2066", message, file, line, col)
            }
            if reserved.is_reserved_builtin_func_name(field.name) {
                message = fmt.sprintf("'%s' is a builtin function and cannot be used as a struct field name", {field.name})
                add_diagnostic(checker, "E5016", message, file, line, col)
            }
            if reserved.is_stdlib_module_name(field.name) {
                message = fmt.sprintf("'%s' is a standard library module and cannot be used as a struct field name", {field.name})
                add_diagnostic(checker, "E5035", message, file, line, col)
            }
            report_shadowed_module(checker, statement, field.name, field.name)

            // Field cannot contain the enclosing struct by value
            ftn = field.type_name
            member_type = by_value_member_type(checker, ftn)
            if member_type != "" {
                mut visited [string] = {}
                is_cycle = member_type == sd^.name || struct_contains_by_value(checker, program, find_struct_or_enum_in_program(program, member_type), sd^.name, visited)
                if is_cycle {
                    mut struct_cycle_help = "break the cycle through '${member_type}' with a pointer field '^${member_type}'"
                    if member_type == sd^.name { struct_cycle_help = "use a pointer field '^${sn}' for recursive types" }
                    add_diagnostic_help(checker, "E3061", error_registry.registry_message_formatted("E3061", {"struct", sn}), struct_cycle_help, file, line, col)
                }
            }

            if len(ftn) > 0 {
                validate_field_type_recursive(checker, program, ftn, field.name, statement, false)
            }
        }

        for j in range(0, len(fnames)) {
            for k in range(0, j) {
                if fnames[k] == fnames[j] {
                    message = error_registry.registry_message_formatted("E2013", {fnames[j], sn})
                    add_diagnostic(checker, "E2013", message, file, line, col)
                    break
                }
            }
        }

        check_declaration_name(checker, sd^.name, sn, "a struct", file, line, col)
        report_shadowed_module(checker, statement, sd^.name, sn)
        check_reserved_main(checker, sd^.name, file, line, col)
        // a struct named `main` collides with the entry point, but an error already says so
        if sd^.name != "main" && type_name_is_duplicate(checker, program, statement, is_struct_name(checker, sd^.name) || is_enum_name(checker, sd^.name)) {
            message = fmt.sprintf("a type named '%s' is already declared", {sn})
            add_diagnostic(checker, "E4007", message, file, line, col)
        }

        register_struct(checker, sd^.name, sn, fnames, ftypes)
        find_struct(checker, sd^.name)^.is_json = sd^.is_json
        find_struct(checker, sd^.name)^.is_deprecated = sd^.is_deprecated
        find_struct(checker, sd^.name)^.deprecated_message = sd^.deprecated_message
        find_struct(checker, sd^.name)^.is_user_declared = true
        for_each declared_field in sd^.struct_fields { arrays.append(find_struct(checker, sd^.name)^.field_spellings, declared_field.type_name) }

        // Struct-namespaced functions: StructName_funcName
        funcs = sd^.funcs
        for j in range(0, len(funcs)) {
            fdecl = funcs[j].func_decl
            if fdecl == nil { continue }
            if fdecl^.kind != ast.NodeKind.FUNC_DECL { continue }
            function_data = fdecl^.func_decl

            for k in range(0, j) {
                prev = funcs[k].func_decl
                if prev != nil {
                    if prev^.kind == ast.NodeKind.FUNC_DECL {
                        if prev^.func_decl^.name == function_data^.name {
                            message = fmt.sprintf("duplicate function '%s' in struct '%s'", {function_data^.name, sn})
                            add_diagnostic(checker, "E2037", message, fdecl^.tok.file, fdecl^.tok.line, fdecl^.tok.col)
                            break
                        }
                    }
                }
            }

            // A bare call inside the struct resolves to the top-level function of that
            // name, leaving the struct function reachable only as Struct.func
            for_each top_statement in program^.program^.stmts {
                if top_statement^.kind == ast.NodeKind.FUNC_DECL && top_statement^.func_decl^.name == function_data^.name {
                    add_diagnostic(checker, "E4022", error_registry.registry_message_formatted("E4022", {sn, function_data^.name, function_data^.name}), fdecl^.tok.file, fdecl^.tok.line, fdecl^.tok.col)
                    break
                }
            }

            for k in range(0, len(fnames)) {
                if fnames[k] == function_data^.name {
                    message = fmt.sprintf("function '%s' conflicts with field '%s' in struct '%s'", {function_data^.name, fnames[k], sn})
                    add_diagnostic(checker, "E2064", message, fdecl^.tok.file, fdecl^.tok.line, fdecl^.tok.col)
                    break
                }
            }

            mut ptypes [^types.GrayType] = {}
            checker_enter_generics(checker, function_data, "")
            // Same workaround as in register_decl_structs: copy the array field to a local first.
            params_local = function_data^.params
            for_each p in params_local {
                arrays.append(ptypes, checker_type_from_name(checker, p.type_name))
                warn_if_type_name_deprecated(checker, fdecl, p.type_name, sd^.name)
            }
            mut rtypes [^types.GrayType] = {}
            for_each rt in function_data^.return_types {
                arrays.append(rtypes, checker_type_from_name(checker, rt))
                warn_if_type_name_deprecated(checker, fdecl, rt, sd^.name)
            }
            checker_leave_generics(checker)

            prefixed = fmt.sprintf("%s_%s", {sd^.name, function_data^.name})
            register_func(checker, prefixed, ptypes, rtypes)
            registered = find_func(checker, prefixed)
            registered^.is_private = function_data^.is_private
            registered^.is_discard = function_data^.is_discard
            registered^.param_mutable = param_mutable_flags(function_data)
            registered^.min_args = min_arg_count(function_data)
            registered^.is_generic = ast.func_has_generic_params(function_data)
            registered^.decl = function_data
            registered^.file = fdecl^.tok.file
            registered^.definition_line = fdecl^.tok.line

            if function_data^.is_discard && len(rtypes) == 0 {
                message = error_registry.registry_message_formatted("E5042", {function_data^.name})
                add_diagnostic(checker, "E5042", message, fdecl^.tok.file, fdecl^.tok.line, fdecl^.tok.col)
            }
        }
    }
}

// --- Declaration registration: top-level functions ---

// Number of leading parameters a call must supply: those without a default.
fn min_arg_count(function_data ^ast.FuncDeclData) -> i64 {
    mut n = 0
    for_each p in function_data^.params {
        if p.default_value == nil { n = n + 1 }
    }
    return n
}

fn param_mutable_flags(function_data ^ast.FuncDeclData) -> [bool] {
    mut flags [bool] = {}
    for_each p in function_data^.params {
        arrays.append(flags, p.is_mutable)
    }
    return flags
}

fn func_display_name_for(statement ^ast.AstNode) -> string {
    if statement^.func_decl^.original_name != "" {
        return statement^.func_decl^.original_name
    }
    return statement^.func_decl^.name
}

// 'main' names only the top-level entry-point function.
fn check_reserved_main(checker ^TypeChecker, name string, file string, line i64, col i64) {
    if name != "main" { return }
    add_diagnostic(checker, "E4026", error_registry.registry_message("E4026"), file, line, col)
    checker^.was_main_name_misused = true
}

// A declared name that is a built-in type, a builtin
// function or a standard library module. `role` is the phrase the message ends
// with ("a struct", "a variable", ...); returns true when one was reported.
fn check_declaration_name(checker ^TypeChecker, name string, display string, role string, file string, line i64, col i64) {
    if reserved.is_reserved_type_name(name) {
        add_diagnostic(checker, "E2038", error_registry.registry_message_formatted("E2038", {display, role}), file, line, col)
        return
    }
    if reserved.is_reserved_builtin_func_name(name) {
        add_diagnostic(checker, "E5016", error_registry.registry_message_formatted("E5016", {display, role}), file, line, col)
        return
    }
    if reserved.is_stdlib_module_name(name) {
        add_diagnostic(checker, "E5035", error_registry.registry_message_formatted("E5035", {display, role}), file, line, col)
        return
    }
}

fn check_reserved_name(checker ^TypeChecker, name string, file string, line i64, col i64) {
    if name == "" { return }
    mut reserved_prefix = false
    if strings.starts_with(name, "gray_") { reserved_prefix = true }
    if strings.starts_with(name, "_gray_") { reserved_prefix = true }
    if strings.starts_with(name, "Gray") { reserved_prefix = true }
    if reserved_prefix {
        message = error_registry.registry_message_formatted("E4006", {name})
        add_diagnostic(checker, "E4006", message, file, line, col)
    }
}

// Walks the program's top-level function declarations, validates them, and
// populates the function registry.
fn register_decl_functions(checker ^TypeChecker, program ^ast.AstNode) {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind != ast.NodeKind.FUNC_DECL { continue }

        file = statement^.tok.file
        line = statement^.tok.line
        col = statement^.tok.col
        function_data = statement^.func_decl
        fn_name = func_display_name_for(statement)

        mut ptypes [^types.GrayType] = {}
        checker_enter_generics(checker, function_data, "")
        // Same workaround as in register_decl_structs: copy the array field to a local first.
        params_local = function_data^.params
        for_each p in params_local {
            arrays.append(ptypes, checker_type_from_name(checker, p.type_name))
            warn_if_type_name_deprecated(checker, statement, p.type_name, "")
            mark_written_type_module_used(checker, p.type_name)
        }
        mut rtypes [^types.GrayType] = {}
        for_each rt in function_data^.return_types {
            arrays.append(rtypes, checker_type_from_name(checker, rt))
            warn_if_type_name_deprecated(checker, statement, rt, "")
            mark_written_type_module_used(checker, rt)
        }
        checker_leave_generics(checker)

        // Main() cannot have parameters or return types
        if function_data^.name == "main" {
            if len(ptypes) > 0 {
                add_diagnostic(checker, "E4008", error_registry.registry_message("E4008"), file, line, col)
            }
            if len(rtypes) > 0 {
                add_diagnostic(checker, "E4008", error_registry.registry_message("E4008"), file, line, col)
            }
        }

        // #test functions take no parameters and return nothing
        if function_data^.is_test && (len(ptypes) > 0 || len(rtypes) > 0) {
            add_diagnostic(checker, "E5046", error_registry.registry_message_formatted("E5046", {fn_name}), file, line, col)
        }

        check_reserved_name(checker, function_data^.name, file, line, col)

        // A global variable of another file of the same module already holds the name
        for_each earlier in stmts {
            if earlier == statement { break }
            if earlier^.kind == ast.NodeKind.VAR_DECL && earlier^.var_decl^.name == function_data^.name && earlier^.tok.file != file {
                mut earlier_file_name = earlier^.tok.file
                for position in range(0, len(earlier_file_name)) {
                    if strings.char_at(earlier^.tok.file, position) == '/' || strings.char_at(earlier^.tok.file, position) == '\\' { earlier_file_name = strings.slice(earlier^.tok.file, position + 1, len(earlier^.tok.file)) }
                }
                add_diagnostic(checker, "E4044", error_registry.registry_message_formatted("E4044", {fn_name, "a global variable", earlier_file_name, "${earlier^.tok.line}"}), file, line, col)
                break
            }
        }
        existing_function = find_func(checker, function_data^.name)
        if existing_function != nil {
            // Modules mangle to `<module>_<name>`, so two modules can produce one compiled
            // name; that is an error, not a duplicate within one module
            mut existing_prefix = ""
            if existing_function^.decl != nil && existing_function^.decl^.original_name != "" {
                existing_prefix = strings.slice(existing_function^.decl^.name, 0, len(existing_function^.decl^.name) - len(existing_function^.decl^.original_name))
            }
            mut own_prefix = ""
            if function_data^.original_name != "" { own_prefix = strings.slice(function_data^.name, 0, len(function_data^.name) - len(function_data^.original_name)) }
            if existing_prefix != own_prefix {
                self_spelling = qualified_declaration_spelling(own_prefix, fn_name)
                other_spelling = qualified_declaration_spelling(existing_prefix, existing_function^.decl^.original_name)
                add_diagnostic(checker, "E6009", error_registry.registry_message_formatted("E6009", {self_spelling, other_spelling}), file, line, col)
                existing_function^.used = true
            } otherwise {
                message = error_registry.registry_message_formatted("E4004", {fn_name})
                add_diagnostic(checker, "E4004", message, file, line, col)
                arrays.append(checker^.shadowed_functions, existing_function)
            }
        }

        // `do main()` paired with a type named main already got an error on the type
        if function_data^.name != "main" && (is_struct_name(checker, function_data^.name) || is_enum_name(checker, function_data^.name)) {
            add_diagnostic(checker, "E4036", error_registry.registry_message_formatted("E4036", {fn_name}), file, line, col)
        }

        register_func(checker, function_data^.name, ptypes, rtypes)
        registered = find_func(checker, function_data^.name)
        registered^.is_private = function_data^.is_private
        registered^.is_discard = function_data^.is_discard
        registered^.param_mutable = param_mutable_flags(function_data)
        registered^.min_args = min_arg_count(function_data)
        registered^.is_generic = ast.func_has_generic_params(function_data)
        registered^.decl = function_data
        registered^.file = file
        registered^.definition_line = line

        if function_data^.is_discard && len(rtypes) == 0 {
            message = error_registry.registry_message_formatted("E5042", {fn_name})
            add_diagnostic(checker, "E5042", message, file, line, col)
        }
    }
}

// --- Declaration registration: imports ---

fn register_decl_imports(checker ^TypeChecker, program ^ast.AstNode) {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind == ast.NodeKind.USING_STMT {
            for_each used_module in statement^.using_stmt^.modules {
                arrays.append(checker^.using_modules, resolve_import_alias(checker, used_module))
            }
        }
        if statement^.kind != ast.NodeKind.IMPORT_STMT { continue }
        file = statement^.tok.file
        line = statement^.tok.line
        col = statement^.tok.col

        items = statement^.import_stmt^.items
        for_each item in items {
            if statement^.import_stmt^.auto_use && item.is_stdlib && item.mod_name != "" {
                arrays.append(checker^.using_modules, item.mod_name)
            }
            if item.is_stdlib && item.mod_name != "" {
                if !reserved.is_stdlib_module_name(item.mod_name) {
                    message = error_registry.registry_message_formatted("E6001", {item.mod_name})
                    add_diagnostic(checker, "E6001", message, file, line, col)
                }
            }

            // Record the import for unused-import tracking. Store the
            // ALIAS as the tracked name (so using/dot notation matches it).
            if item.mod_name != "" || item.import_alias != "" || (!item.is_stdlib && !item.is_c_import && item.source_path != "") {
                mut entry_name = item.mod_name
                if item.import_alias != "" {
                    entry_name = item.import_alias
                }
                entry = ImportEntry{mod_name: entry_name, file: file, line: line, used: item.is_c_import, is_stdlib: item.is_stdlib}
                mut imps [ImportEntry] = checker^.imports
                arrays.append(imps, entry)
                checker^.imports = imps
            }

            // Track alias -> module mapping
            if item.import_alias != "" && item.mod_name != "" && item.import_alias != item.mod_name {
                aentry = AliasEntry{import_alias: item.import_alias, mod_name: item.mod_name}
                mut aliases [AliasEntry] = checker^.import_aliases
                arrays.append(aliases, aentry)
                checker^.import_aliases = aliases
            }
        }
    }
}

// A merged module declaration's name as written: without its `module_` prefix.
fn module_member_display_name(mangled string) -> string {
    for_each module_name in maps.get_keys(user_module_names) {
        if strings.starts_with(mangled, "${module_name}_") { return strings.slice(mangled, len(module_name) + 1, len(mangled)) }
    }
    return mangled
}

// The first private struct, enum or alias a written alias target names, at any depth of
// containers and pointers; "" when none.
fn private_target_leaf(checker ^TypeChecker, program ^ast.AstNode, written string) -> string {
    mut position i64 = 0
    n = len(written)
    as_long_as position < n {
        character = strings.char_at(written, position)
        is_identifier_start bool = (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_'
        if !is_identifier_start {
            position += 1
            continue
        }
        start = position
        as_long_as position < n && (is_identifier_byte(strings.char_at(written, position)) || strings.char_at(written, position) == '.') { position += 1 }
        leaf = strings.slice(written, start, position)
        for_each statement in program^.program^.stmts {
            if statement^.kind == ast.NodeKind.STRUCT_DECL && statement^.struct_decl^.name == leaf && statement^.struct_decl^.is_private { return leaf }
            if statement^.kind == ast.NodeKind.ENUM_DECL && statement^.enum_decl^.name == leaf && statement^.enum_decl^.is_private { return leaf }
            if statement^.kind == ast.NodeKind.ALIAS_DECL && statement^.alias_decl^.name == leaf && statement^.alias_decl^.is_private { return leaf }
        }
    }
    return ""
}

// True when following an alias's target through other aliases leads back to it.
fn alias_forms_cycle(checker ^TypeChecker, start TypeAlias) -> bool {
    mut current = start.target
    for _ in range(0, MAX_ALIAS_CHAIN) {
        if current == start.name { return true }
        mut found = false
        for_each other in checker^.type_aliases {
            if other.name == current {
                current = other.target
                found = true
                break
            }
        }
        if !found { return false }
    }
    return false
}

// --- Declaration registration: type aliases ---
// Registered before enums/structs so alias names can be used in struct
// fields and enum payloads.

fn register_decl_aliases(checker ^TypeChecker, program ^ast.AstNode) {
    stmts = program^.program^.stmts
    for_each statement in stmts {
        if statement^.kind != ast.NodeKind.ALIAS_DECL { continue }

        ad = statement^.alias_decl
        aname = ad^.name
        target = ad^.target_type
        file = statement^.tok.file
        line = statement^.tok.line
        col = statement^.tok.col

        mut is_dup = false
        // Same workaround as in register_decl_structs: copy the array field to a local first.
        type_aliases_local = checker^.type_aliases
        for_each existing in type_aliases_local {
            if existing.name == aname { is_dup = true }
        }
        if is_dup {
            message = fmt.sprintf("type alias '%s' is already declared", {aname})
            add_diagnostic(checker, "E4020", message, file, line, col)
            continue
        }

        // a built-in name stays what the language says it is: skip registration
        if reserved.is_reserved_type_name(aname) || reserved.is_reserved_builtin_func_name(aname) {
            check_declaration_name(checker, aname, aname, "an alias", file, line, col)
            continue
        }
        if aname == "main" {
            check_reserved_main(checker, aname, file, line, col)
            continue
        }

        if type_name_is_duplicate(checker, program, statement, is_struct_name(checker, aname) || is_enum_name(checker, aname)) {
            message = fmt.sprintf("a type named '%s' is already declared", {aname})
            add_diagnostic(checker, "E4007", message, file, line, col)
        }

        if target == "?" {
            message = fmt.sprintf("cannot alias the wildcard type '?' (alias '%s')", {aname})
            add_diagnostic(checker, "E3135", message, file, line, col)
            continue
        }

        entry = TypeAlias{name: aname, target: target, file: file, is_private: ad^.is_private, is_distinct: ad^.is_distinct, line: line, col: col}
        mut aliases2 [TypeAlias] = checker^.type_aliases
        arrays.append(aliases2, entry)
        checker^.type_aliases = aliases2
    }

    // Cycle detection over the fully-registered alias set. Target existence
    // is deliberately not checked here: that validation must wait until
    // after enums/structs are registered, to avoid false positives on aliases
    // to not-yet-registered user types.
    // Same workaround as in register_decl_structs: copy the array field to a local first.
    type_aliases_local2 = checker^.type_aliases
    for_each a in type_aliases_local2 {
        mut cur = a.target
        mut cycle = false
        for depth in range(0, MAX_ALIAS_CHAIN) {
            if cur == a.name {
                cycle = true
                break
            }
            mut found = false
            for_each b in type_aliases_local2 {
                if b.name == cur {
                    cur = b.target
                    found = true
                    break
                }
            }
            if !found { break }
        }
        if cycle {
            add_diagnostic(checker, "E3133", error_registry.registry_message_formatted("E3133", {a.name}), a.file, a.line, a.col)
        }
    }

    // A `distinct alias` becomes its own type once its target is known to be a
    // primitive; any other target is an error and the alias stays plain.
    for index in range(0, len(checker^.type_aliases)) {
        current_alias = checker^.type_aliases[index]
        if !current_alias.is_distinct { continue }
        resolved = resolve_type_alias(checker, current_alias.target)
        mut is_circular = false
        for_each other in checker^.type_aliases {
            if other.name == resolved { is_circular = true }
        }
        if is_circular {
            checker^.type_aliases[index].is_distinct = false
        } or is_distinct_primitive_name(resolved) {
            types.register_distinct(checker^.pool, current_alias.name, resolved)
        } otherwise {
            checker^.type_aliases[index].is_distinct = false
            add_diagnostic(checker, "E3215", error_registry.registry_message_formatted("E3215", {current_alias.name, resolved}), current_alias.file, current_alias.line, current_alias.col)
        }
    }
}

// The primitive types a `distinct alias` may target.
fn is_distinct_primitive_name(name string) -> bool {
    return types.is_any_int_type(name) || name == "f32" || name == "f64" || name == "bool" || name == "char" || name == "string"
}

// --- Expression type checking ---

fn is_int_kind(k types.TypeKind) -> bool {
    if k == types.TypeKind.INT { return true }
    if k == types.TypeKind.UINT { return true }
    return false
}

// Best-effort constant-fold of a literal integer expression (including
// unary minus and +,-,*,/ over other literal-foldable subexpressions).
fn try_get_literal_int(node ^ast.AstNode) -> (i64, bool) {
    if node == nil { return 0, false }
    if node^.kind == ast.NodeKind.INT_VALUE {
        return node^.int_value^.value, true
    }
    if node^.kind == ast.NodeKind.PREFIX_EXPR {
        if node^.prefix^.op == token.TokenKind.MINUS {
            r = node^.prefix^.right
            if r != nil {
                if r^.kind == ast.NodeKind.INT_VALUE {
                    return -r^.int_value^.value, true
                }
            }
        }
    }
    if node^.kind == ast.NodeKind.INFIX_EXPR {
        left_v, left_ok = try_get_literal_int(node^.infix^.left)
        right_v, right_ok = try_get_literal_int(node^.infix^.right)
        if left_ok && right_ok {
            if node^.infix^.op == token.TokenKind.PLUS { return left_v + right_v, true }
            if node^.infix^.op == token.TokenKind.MINUS { return left_v - right_v, true }
            if node^.infix^.op == token.TokenKind.ASTERISK { return left_v * right_v, true }
            if node^.infix^.op == token.TokenKind.SLASH {
                if right_v != 0 { return left_v / right_v, true }
            }
        }
    }
    return 0, false
}

fn assignment_target_root_name(e ^ast.AstNode) -> string {
    if e == nil { return "" }
    if e^.kind == ast.NodeKind.LABEL { return e^.label^.value }
    if e^.kind == ast.NodeKind.MEMBER_EXPR { return assignment_target_root_name(e^.member^.object) }
    if e^.kind == ast.NodeKind.INDEX_EXPR { return assignment_target_root_name(e^.index_data^.left) }
    return ""
}

fn resolve_import_alias(checker ^TypeChecker, name string) -> string {
    // Same workaround as in register_decl_structs: copy the array field to a local first.
    import_aliases_local = checker^.import_aliases
    for_each a in import_aliases_local {
        if a.import_alias == name { return a.mod_name }
    }
    return name
}

// The index of the first `separator` outside any brackets or parentheses, or -1.
fn alias_top_level_separator(text string, separator char) -> i64 {
    mut depth i64 = 0
    for position in range(0, len(text)) {
        character = strings.char_at(text, position)
        if character == '[' || character == '(' {
            depth += 1
        } or character == ']' || character == ')' {
            depth -= 1
        } or character == separator && depth == 0 {
            return position
        }
    }
    return -1
}

// Resolves each top-level comma-separated type of a func parameter list, keeping
// a leading `&`.
fn alias_resolve_type_list(checker ^TypeChecker, list string, keep_distinct bool) -> string {
    mut resolved_parts [string] = {}
    mut segment_start i64 = 0
    mut position i64 = 0
    mut depth i64 = 0
    as_long_as position <= len(list) {
        mut is_end bool = position == len(list)
        mut character char = ','
        if !is_end { character = strings.char_at(list, position) }
        if character == '[' || character == '(' { depth += 1 }
        if character == ']' || character == ')' { depth -= 1 }
        if is_end || (character == ',' && depth == 0) {
            mut part = strings.slice(list, segment_start, position)
            mut ampersand = ""
            if strings.starts_with(part, "&") {
                ampersand = "&"
                part = strings.slice(part, 1, len(part))
            }
            arrays.append(resolved_parts, "${ampersand}${resolve_alias_impl(checker, part, keep_distinct)}")
            segment_start = position + 1
        }
        position += 1
    }
    return strings.join(resolved_parts, ",")
}

// Follows `type_aliases` chains to their final targets, recursing into
// `^T`, `[T]`, `[T,N]`, `map[K:V]` and `func(...)->R` spellings. With
// `keep_distinct`, a `distinct alias` name stays as its own type's name.
fn resolve_alias_impl(checker ^TypeChecker, name string, keep_distinct bool) -> string {
    if name == "" { return name }

    if strings.starts_with(name, "^") {
        return "^${resolve_alias_impl(checker, strings.slice(name, 1, len(name)), keep_distinct)}"
    }

    if strings.starts_with(name, "[") {
        if len(name) > ARRAY_BRACKETS_LENGTH && strings.char_at(name, len(name) - 1) == ']' {
            mut inner = strings.slice(name, 1, len(name) - 1)
            mut size_suffix = ""
            size_comma = alias_top_level_separator(inner, ',')
            if size_comma >= 0 {
                size_suffix = strings.slice(inner, size_comma, len(inner))
                inner = strings.slice(inner, 0, size_comma)
            }
            return "[${resolve_alias_impl(checker, inner, keep_distinct)}${size_suffix}]"
        }
        return name
    }

    if strings.starts_with(name, "map[") {
        if len(name) > MAP_BRACKETS_LENGTH && strings.char_at(name, len(name) - 1) == ']' {
            inner = strings.slice(name, MAP_PREFIX_LENGTH, len(name) - 1)
            colon = alias_top_level_separator(inner, ':')
            if colon >= 0 {
                key_part = resolve_alias_impl(checker, strings.slice(inner, 0, colon), keep_distinct)
                value_part = resolve_alias_impl(checker, strings.slice(inner, colon + 1, len(inner)), keep_distinct)
                return "map[${key_part}:${value_part}]"
            }
        }
        return name
    }

    if strings.starts_with(name, "func(") {
        close = types.find_matching_paren(name, FUNC_OPEN_PAREN_INDEX)
        if close >= 0 {
            parameter_list = strings.slice(name, FUNC_PARAMS_START, close)
            tail = strings.slice(name, close + 1, len(name))
            rebuilt = alias_resolve_type_list(checker, parameter_list, keep_distinct)
            if strings.starts_with(tail, "->") {
                return "func(${rebuilt})->${resolve_alias_impl(checker, strings.slice(tail, RETURN_ARROW_LENGTH, len(tail)), keep_distinct)}"
            }
            return "func(${rebuilt})"
        }
        return name
    }

    // Same workaround as in register_decl_structs: copy the array field to a local first.
    type_aliases_local3 = checker^.type_aliases
    mut cur = name
    for depth in range(0, MAX_ALIAS_CHAIN) {
        mut found = false
        for_each a in type_aliases_local3 {
            if a.name == cur {
                if keep_distinct && a.is_distinct { return cur }
                cur = a.target
                found = true
                break
            }
        }
        if !found { break }
        // A target that is itself a container has to go back through the
        // branches above, or the alias nested inside it never gets followed.
        if strings.starts_with(cur, "^") || strings.starts_with(cur, "[") || strings.starts_with(cur, "map[") || strings.starts_with(cur, "func(") {
            return resolve_alias_impl(checker, cur, keep_distinct)
        }
    }
    return cur
}

// Every alias erased, `distinct alias` ones included: the spelling codegen and
// every rule that only needs the representation see.
fn resolve_type_alias(checker ^TypeChecker, name string) -> string {
    return resolve_alias_impl(checker, name, false)
}

// Aliases erased except `distinct alias` names, which stay as their own type's
// name: the spelling that gives a value its distinct type.
fn resolve_type_alias_keeping_distinct(checker ^TypeChecker, name string) -> string {
    return resolve_alias_impl(checker, name, true)
}

fn reject_void_in_context(checker ^TypeChecker, expr ^ast.AstNode, t ^types.GrayType, context string) {
    if t == nil || t^.kind != types.TypeKind.VOID || expr == nil { return }
    mut void_help = ""
    if expr^.kind == ast.NodeKind.CALL_EXPR && expr^.call^.function != nil && expr^.call^.function^.kind == ast.NodeKind.LABEL { void_help = "'${expr^.call^.function^.label^.value}' does not return a value" }
    add_diagnostic_help(checker, "E3187", error_registry.registry_message_formatted("E3187", {context}), void_help, expr^.tok.file, expr^.tok.line, expr^.tok.col)
}

// Resolve a bare call name to the stdlib module supplying it through
// `import and use` / `using`, or "" when no using-module provides it.
fn find_using_stdlib_module(checker ^TypeChecker, function_name string) -> string {
    for_each used_module in checker^.using_modules {
        if maps.contains_key(checker^.stdlib_signatures, "${used_module}.${function_name}") { return used_module }
    }
    return ""
}

// True for a stdlib function that returns several values without being fallible.
fn stdlib_multi_return_count(module_name string, function_name string) -> i64 {
    if module_name == "channels" && function_name == "try_receive" { return RESULT_PAIR_COUNT }
    if module_name == "math" && function_name == "modf" { return RESULT_PAIR_COUNT }
    if module_name == "uuid" && function_name == "timestamp" { return RESULT_PAIR_COUNT }
    if module_name == "os" && function_name == "lookup_env" { return RESULT_PAIR_COUNT }
    if module_name == "os" && function_name == "find_executable" { return RESULT_PAIR_COUNT }
    if module_name == "path" && function_name == "split_dir_file" { return RESULT_PAIR_COUNT }
    return 0
}

// True when a call returns several values: a user function with more than one
// return, a fallible stdlib function (T, Error), or one of the stdlib
// multi-return functions.
fn call_returns_multiple_values(checker ^TypeChecker, signature ^FuncSig, module_name string, name string) -> bool {
    if signature != nil && len(signature^.return_types) > 1 { return true }
    if name == "" || signature != nil { return false }
    stdlib_key = "${module_name}.${name}"
    if module_name != "" && maps.contains_key(checker^.stdlib_signatures, stdlib_key) && checker^.stdlib_signatures[stdlib_key].fallible { return true }
    if module_name == "arrays" && name == "find" { return true }
    if module_name == "maps" && (name == "get_and_remove" || name == "find_key") { return true }
    return stdlib_multi_return_count(module_name, name) > 0
}

// Classifies a call whose result is multiple values and reports the right
// diagnostic at `report_node`: an error for a user-defined multi-return or a
// non-fallible multi-value stdlib function, an error for a fallible stdlib
// function's (T, Error); with `is_discarded`, an error for a result that is not
// used. A no-operator for a single-value call.
fn reject_multi_value_call(checker ^TypeChecker, call_expression ^ast.AstNode, report_node ^ast.AstNode, is_discarded bool) {
    if call_expression == nil || call_expression^.kind != ast.NodeKind.CALL_EXPR { return }
    callee = call_expression^.call^.function
    if callee == nil { return }
    mut name = ""
    mut module_name = ""
    mut signature ^FuncSig = nil
    if callee^.kind == ast.NodeKind.LABEL {
        name = callee^.label^.value
        signature = find_func(checker, name)
        // A bare call carries no module qualifier; resolve it through the
        // using-modules so the stdlib checks below consult the module that
        // actually supplies it.
        if signature == nil { module_name = find_using_stdlib_module(checker, name) }
    } or callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        raw_module_name = callee^.member^.object^.label^.value
        module_name = resolve_import_alias(checker, raw_module_name)
        name = callee^.member^.member
        signature = find_func(checker, "${module_name}_${name}")
    } otherwise {
        return
    }
    file = report_node^.tok.file
    line = report_node^.tok.line
    column = report_node^.tok.col
    if is_discarded {
        if call_returns_multiple_values(checker, signature, module_name, name) {
            mut message = "return value of '${name}()' is not used"
            if module_name != "" { message = "return value of '${module_name}.${name}()' is not used" }
            add_diagnostic_help(checker, "E5011", message, "assign the result to a variable, or use 'mut _ = ...' to discard it", file, line, column)
        }
        return
    }
    if signature != nil && len(signature^.return_types) > 1 {
        add_diagnostic(checker, "E3040", error_registry.registry_message_formatted("E3040", {name, "${len(signature^.return_types)}", name}), file, line, column)
    } or name != "" && signature == nil && module_name != "" {
        stdlib_key = "${module_name}.${name}"
        if maps.contains_key(checker^.stdlib_signatures, stdlib_key) && checker^.stdlib_signatures[stdlib_key].fallible {
            // or_panic needs a single-variable declaration, so a call that
            // returns a used/total pair is offered or_default instead.
            is_pair = module_name == "os" && (name == "memory_usage" || name == "disk_usage")
            mut handle_text = "mut val, err = ${name}()"
            mut discard_text = "mut val, _ = ${name}()"
            mut options_text = "'or_return' to propagate it, 'or_panic' to abort, or 'or_default' to substitute a fallback value"
            if is_pair {
                handle_text = "mut first, second, err = ${name}()"
                discard_text = "mut first, second, _ = ${name}()"
                options_text = "'or_return' to propagate it or 'or_default' to substitute fallback values"
            }
            add_diagnostic(checker, "E3089", error_registry.registry_message_formatted("E3089", {name, handle_text, discard_text, options_text}), file, line, column)
        } or (module_name == "arrays" && name == "find") || (module_name == "maps" && (name == "get_and_remove" || name == "find_key")) {
            add_diagnostic(checker, "E3040", error_registry.registry_message_formatted("E3040", {name, "${RESULT_PAIR_COUNT}", name}), file, line, column)
        } otherwise {
            multi_return_count = stdlib_multi_return_count(module_name, name)
            if multi_return_count > 0 {
                add_diagnostic(checker, "E3040", error_registry.registry_message_formatted("E3040", {name, "${multi_return_count}", name}), file, line, column)
            }
        }
    }
}

// Reject a multi-value call in a single-value position (call
// argument, operand, array element, map value, return/if/when position).
fn reject_multi_return_in_single_position(checker ^TypeChecker, expr ^ast.AstNode) {
    reject_multi_value_call(checker, expr, expr, false)
}

// Basic pointer/struct/enum/array/int-family assignability. Does not cover the
// context-specific exceptions its callers handle separately (ref->ptr,
// struct<->int). Nil is assignable to any pointer type.
fn types_assignable(checker ^TypeChecker, dest ^types.GrayType, src ^types.GrayType) -> bool {
    if dest == nil { return false }
    if src == nil { return false }
    // A C function result has no Grayscale type: it is incompatible with everything
    if src^.kind == types.TypeKind.C_FUNCTION || dest^.kind == types.TypeKind.C_FUNCTION { return false }
    // A distinct type converts to nothing and takes nothing but itself; a value
    // with no type of its own yet (a literal, nil) takes the slot's.
    if !types.type_same_distinct(dest, src) && src^.kind != types.TypeKind.LITERAL && src^.kind != types.TypeKind.UNKNOWN && src^.kind != types.TypeKind.NIL_TYPE {
        return false
    }
    if dest^.kind == types.TypeKind.POINTER && src^.kind == types.TypeKind.POINTER {
        if dest^.element_type != "" && src^.element_type != "" {
            return dest^.element_type == src^.element_type
        }
        return true
    }
    if dest^.kind == types.TypeKind.STRUCT && src^.kind == types.TypeKind.STRUCT {
        if dest^.name != "" && src^.name != "" {
            return same_struct_type(checker, dest^.name, src^.name)
        }
        return true
    }
    if dest^.kind == types.TypeKind.ENUM && src^.kind == types.TypeKind.ENUM {
        if dest^.name != "" && src^.name != "" {
            return same_enum_type(checker, dest^.name, src^.name)
        }
        return true
    }
    if dest^.kind == types.TypeKind.ARRAY && src^.kind == types.TypeKind.ARRAY {
        if dest^.element_type != "" && src^.element_type != "" {
            if dest^.element_type == src^.element_type { return true }
            if same_array_element(checker, dest^.element_type, src^.element_type) { return true }
            det = checker_type_from_name(checker, dest^.element_type)
            set = checker_type_from_name(checker, src^.element_type)
            if det^.kind != types.TypeKind.UNKNOWN && set^.kind != types.TypeKind.UNKNOWN {
                // An array never converts its elements: numbers must match exactly
                if types.type_kind_is_number(det^.kind) || types.type_kind_is_number(set^.kind) { return false }
                return types_assignable(checker, det, set)
            }
        }
        return true
    }
    if types.type_kind_is_number(dest^.kind) && types.type_kind_is_number(src^.kind) {
        // A narrowing or signedness crossing is assignable here; the caller reports it
        return types.type_conversion(src, dest) != types.Conversion.MISMATCH
    }
    if dest^.kind == types.TypeKind.RANGE && src^.kind == types.TypeKind.RANGE { return dest^.name == src^.name }
    if dest^.kind == src^.kind { return true }
    return false
}

fn resolve_label(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    name = node^.label^.value

    // A name the same multi-name declaration binds is not visible to its initializers
    if arrays.contains(checker^.hidden_group_names, name) {
        add_diagnostic(checker, "E4001", fmt.sprintf("undefined variable '%s'", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }

    symbol = scope.scope_lookup(checker^.current_scope, name)
    if symbol != nil && checker^.initialized_variable_name == name { checker^.is_initializer_reading_own_name = true }
    if symbol != nil {
        // a file-scope variable gets a collision-proof C name in codegen; anything nearer is a local
        mut declaration_scope = checker^.current_scope
        as_long_as declaration_scope^.parent != nil && scope.scope_lookup_local(declaration_scope, name) == nil {
            declaration_scope = declaration_scope^.parent
        }
        if declaration_scope^.parent == nil {
            node^.label^.is_file_global_reference = true
        } otherwise {
            node^.label^.is_local_reference = true
        }
    }
    if symbol != nil {
        symbol^.used = true
        mut result = symbol^.sym_type
        if result^.kind == types.TypeKind.RANGE && node != checker^.range_use {
            add_diagnostic(checker, "E3205", error_registry.registry_message("E3205"), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }
        if symbol^.is_ref && result^.kind == types.TypeKind.POINTER && result^.element_type != "" {
            result = checker_type_from_name(checker, result^.element_type)
        }
        return result
    }

    fs = find_func(checker, name)
    if fs != nil {
        if !is_enum_name(checker, name) && !is_struct_name(checker, name) { fs^.used = true }
        message = error_registry.registry_message_formatted("E3031", {written_function_name(node, name), written_function_name(node, name), written_function_name(node, name)})
        add_diagnostic(checker, "E3031", message, node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }

    for_each used_module in checker^.using_modules {
        constant_type = stdlib_constant_type(checker, used_module, name)
        if constant_type != nil {
            node^.label^.stdlib_constant_module = used_module
            return constant_type
        }
    }

    if types.is_builtin_type_name(name) {
        // A builtin type name (i64, i128, f64, ...) in a value position. The
        // builtins that take one, size_of() and type_of(), resolve their own
        // argument, so anything arriving here is a name used as a value.
        base_type = checker_type_from_name(checker, name)
        add_diagnostic(checker, "E3100", error_registry.registry_message_formatted("E3100", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return base_type
    }
    if reserved.is_reserved_builtin_func_name(name) {
        // A bare builtin function name used as a value (`input` instead of `input()`)
        add_diagnostic(checker, "E3031", error_registry.registry_message_formatted("E3031", {name, name, name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }

    // A name that names a type but no value; a generic parameter stands for a type
    if ast.generic_bindings_find(checker^.generics, name) >= 0 {
        add_diagnostic(checker, "E3100", error_registry.registry_message_formatted("E3100", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    if !is_imported_module_name(checker, name) && type_name_as_value(checker, name) {
        resolved_type_name = resolve_type_alias(checker, name)
        mut value_help = ""
        if is_enum_name(checker, resolved_type_name) {
            value_help = "use '${name}.VARIANT' to access an enum value"
        } or is_struct_name(checker, resolved_type_name) {
            value_help = "use '${name}{...}' or 'new(${name})' to create an instance"
        }
        add_diagnostic_help(checker, "E3100", error_registry.registry_message_formatted("E3100", {name}), value_help, node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }

    // The parser's own temporaries are never reported by name
    if strings.starts_with(name, "_gray_") { return checker^.pool^.type_unknown }
    if report_misspelled_statement(checker, node, node, name) { return checker^.pool^.type_unknown }
    // A leading underscore on a number: `_1000`
    if len(name) > 1 && strings.char_at(name, 0) == '_' && strings.char_at(name, 1) >= '0' && strings.char_at(name, 1) <= '9' {
        add_diagnostic(checker, "E1012", error_registry.registry_message_formatted("E1012", {strings.slice(name, 1, len(name))}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    message = fmt.sprintf("undefined variable '%s'", {name})
    // A name the signature gives a return value, never declared in the body, is the likelier mistake
    mut named_return_index i64 = -1
    if checker^.has_named_returns {
        for position in range(0, len(checker^.current_return_names)) {
            if checker^.current_return_names[position] == name { named_return_index = position }
        }
    }
    if named_return_index >= 0 {
        mut returned_type = "?"
        if named_return_index < len(checker^.current_return_types) { returned_type = shown_type(checker, checker^.current_return_types[named_return_index]) }
        add_diagnostic_help(checker, "E4001", message, "'${name}' is a named return value in the function signature. Did you forget to declare 'mut ${name} ${returned_type}' at function scope?", node^.tok.file, node^.tok.line, node^.tok.col)
    } otherwise {
        suggestion = suggest_similar_name(checker, name)
        mut suggestion_help = ""
        if suggestion != "" { suggestion_help = "did you mean '${suggestion}'?" }
        add_diagnostic_help(checker, "E4001", message, suggestion_help, node^.tok.file, node^.tok.line, node^.tok.col)
    }
    return checker^.pool^.type_unknown
}

// Does a bare name name a struct or enum type, its own spelling or the one an
// alias reaches, and so no value?
fn type_name_as_value(checker ^TypeChecker, name string) -> bool {
    if name == "" { return false }
    if is_struct_name(checker, name) || is_enum_name(checker, name) { return true }
    resolved = resolve_type_alias(checker, name)
    if resolved == name { return false }
    // Only a name that actually resolved to something else is judged by what it
    // reached: the pool reads any capitalized name as a struct.
    return is_struct_name(checker, resolved) || is_enum_name(checker, resolved) || types.type_from_name(checker^.pool, resolved)^.kind != types.TypeKind.UNKNOWN
}

// An error for an undefined name or function at statement position that is a near
// miss of a statement word. `expression` is the expression being resolved and
// `site` the node the error points at.
fn report_misspelled_statement(checker ^TypeChecker, expression ^ast.AstNode, site ^ast.AstNode, name string) -> bool {
    if checker^.statement_expression != expression { return false }
    suggested_statement = suggest.suggest_statement_name(name)
    if suggested_statement == "" { return false }
    add_diagnostic(checker, "E4041", error_registry.registry_message_formatted("E4041", {name, suggested_statement}), site^.tok.file, site^.tok.line, site^.tok.col)
    return true
}

// The text an operator is shown as in a diagnostic.
fn operator_display_name(operator token.TokenKind) -> string {
    when operator {
        is token.TokenKind.PLUS { return "+" }
        is token.TokenKind.MINUS { return "-" }
        is token.TokenKind.ASTERISK { return "*" }
        is token.TokenKind.SLASH { return "/" }
        is token.TokenKind.PERCENT { return "%" }
        is token.TokenKind.EQ { return "==" }
        is token.TokenKind.NOT_EQ { return "!=" }
        is token.TokenKind.LT { return "<" }
        is token.TokenKind.GT { return ">" }
        is token.TokenKind.LT_EQ { return "<=" }
        is token.TokenKind.GT_EQ { return ">=" }
        is token.TokenKind.AND { return "&&" }
        is token.TokenKind.OR { return "||" }
        is token.TokenKind.BANG { return "!" }
        is token.TokenKind.BIT_AND { return "bit_and" }
        is token.TokenKind.BIT_OR { return "bit_or" }
        is token.TokenKind.BIT_XOR { return "bit_xor" }
        is token.TokenKind.BIT_NOT { return "bit_not" }
        is token.TokenKind.BIT_SHIFT_LEFT { return "bit_shift_left" }
        is token.TokenKind.BIT_SHIFT_RIGHT { return "bit_shift_right" }
        is token.TokenKind.INCREMENT { return "++" }
        is token.TokenKind.DECREMENT { return "--" }
        is token.TokenKind.CARET { return "^" }
        is token.TokenKind.ASSIGN { return "=" }
        is token.TokenKind.PLUS_ASSIGN { return "+=" }
        is token.TokenKind.MINUS_ASSIGN { return "-=" }
        is token.TokenKind.ASTERISK_ASSIGN { return "*=" }
        is token.TokenKind.SLASH_ASSIGN { return "/=" }
        is token.TokenKind.PERCENT_ASSIGN { return "%=" }
        default { return token.token_kind_name(operator) }
    }
}

// A compile-time i64 constant: a literal expression, a name bound to a const
// integer, or arithmetic on those, folded at full width. Returns the value,
// whether the expression folded, and whether a step overflowed or the value
// does not fit i64.
fn fold_const_integer(checker ^TypeChecker, node ^ast.AstNode) -> (i64, bool, bool) {
    folded, is_constant = folding.constant_fold(checker^.const_integers, node)
    if !is_constant || folded.is_decimal { return 0, false, false }
    if folded.is_too_large { return 0, false, true }
    value, fits = folding.literal_value_as_i64(folded)
    if !fits { return 0, false, true }
    return value, true, false
}

// The element type of a Range<T> type's name.
fn range_element_name(range_type ^types.GrayType) -> string {
    return strings.slice(range_type^.name, RANGE_PREFIX_LENGTH, len(range_type^.name) - 1)
}

// True when the integer `value_type` is checked against a range held in a
// variable without conversion: a wide range takes only its own wide type, a u64
// range an unsigned value that is not wide, an i64 range only a value that is
// neither wide nor u64.
fn range_holds_integer(range_type ^types.GrayType, value_type ^types.GrayType) -> bool {
    element_name = range_element_name(range_type)
    value_is_wide = types.is_bigint_type(value_type^.name)
    if element_name == "u64" { return value_type^.kind == types.TypeKind.UINT && !value_is_wide }
    if !types.is_bigint_type(element_name) { return !value_is_wide && value_type^.name != "u64" }
    return value_is_wide && value_type^.name == element_name
}

// Both operands of an infix expression and the type it yields.
fn resolve_infix_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    operator = node^.infix^.op
    left_node = node^.infix^.left
    right_node = node^.infix^.right
    mut left = resolve_untyped(checker, left_node)
    // For == and !=, a bare `.VARIANT` on the right resolves against the left enum
    saved_infix_expected = checker^.expected_type
    if (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) && left^.kind == types.TypeKind.ENUM && left^.name != "" {
        checker^.expected_type = left
    }
    if operator == token.TokenKind.IN || operator == token.TokenKind.NOT_IN { allow_range_use(checker, right_node) }
    mut right = resolve_untyped(checker, right_node)
    checker^.expected_type = saved_infix_expected

    // Number operands type themselves through type_binary_result: a literal
    // takes the other operand's type, same-family operands of different widths
    // give the wider type, and any other pair needs a cast.
    is_comparison = operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ || operator == token.TokenKind.LT || operator == token.TokenKind.GT || operator == token.TokenKind.LT_EQ || operator == token.TokenKind.GT_EQ
    is_shift = operator == token.TokenKind.BIT_SHIFT_LEFT || operator == token.TokenKind.BIT_SHIFT_RIGHT
    is_bitwise = is_shift || operator == token.TokenKind.BIT_AND || operator == token.TokenKind.BIT_OR || operator == token.TokenKind.BIT_XOR
    is_arithmetic = operator == token.TokenKind.PLUS || operator == token.TokenKind.MINUS || operator == token.TokenKind.ASTERISK || operator == token.TokenKind.SLASH || operator == token.TokenKind.PERCENT
    is_ordering = operator == token.TokenKind.LT || operator == token.TokenKind.GT || operator == token.TokenKind.LT_EQ || operator == token.TokenKind.GT_EQ
    left_is_number = left^.kind == types.TypeKind.LITERAL || types.type_kind_is_number(left^.kind)
    right_is_number = right^.kind == types.TypeKind.LITERAL || types.type_kind_is_number(right^.kind)
    numeric_pair = (is_comparison || is_bitwise || is_arithmetic) && left_is_number && right_is_number
    mut numeric_result ^types.GrayType = nil
    if numeric_pair {
        numeric_result = types.type_binary_result(checker^.pool, operator, left, right)
        if numeric_result == nil {
            mut left_shown = left
            if left^.kind == types.TypeKind.LITERAL { left_shown = check_expression_as(checker, left_node, nil) }
            mut right_shown = right
            if right^.kind == types.TypeKind.LITERAL { right_shown = check_expression_as(checker, right_node, nil) }
            if operator == token.TokenKind.PERCENT && (left_shown^.kind == types.TypeKind.FLOAT || right_shown^.kind == types.TypeKind.FLOAT) {
                add_diagnostic(checker, "E3181", error_registry.registry_message("E3181"), node^.tok.file, node^.tok.line, node^.tok.col)
            } or is_bitwise {
                add_diagnostic(checker, "E8001", error_registry.registry_message_formatted("E8001", {operator_display_name(operator), shown_type(checker, left_shown), shown_type(checker, right_shown)}), node^.tok.file, node^.tok.line, node^.tok.col)
            } or is_comparison {
                add_cast_help_diagnostic(checker, "E3156", error_registry.registry_message_formatted("E3156", {shown_type(checker, left_shown), shown_type(checker, right_shown)}), node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                add_cast_help_diagnostic(checker, "E3002", error_registry.registry_message_formatted("E3002", {operator_display_name(operator), shown_type(checker, left_shown), shown_type(checker, right_shown)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            return checker^.pool^.type_unknown
        }
        left_literal = left^.kind == types.TypeKind.LITERAL
        right_literal = right^.kind == types.TypeKind.LITERAL
        if is_shift {
            // The count keeps its own type; a literal count is an i64.
            if right_literal { right = check_expression_as(checker, right_node, nil) }
        } or left_literal && right_literal {
            if is_comparison {
                mut common = checker^.pool^.type_i64
                if left^.is_decimal || right^.is_decimal { common = checker^.pool^.type_f64 }
                left = check_expression_as(checker, left_node, common)
                right = check_expression_as(checker, right_node, common)
            }
        } or left_literal {
            left = check_expression_as(checker, left_node, right)
        } or right_literal {
            right = check_expression_as(checker, right_node, left)
        }
    } otherwise {
        // A value looked up in a collection is checked as its element or key
        // type; nothing else here gives a literal operand a type.
        if operator == token.TokenKind.IN || operator == token.TokenKind.NOT_IN {
            mut slot ^types.GrayType = nil
            if right^.kind == types.TypeKind.ARRAY && right^.element_type != "" {
                slot = checker_type_from_name(checker, right^.element_type)
            } or right^.kind == types.TypeKind.MAP && right^.key_type != "" {
                slot = checker_type_from_name(checker, right^.key_type)
            }
            left = check_expression_as(checker, left_node, slot)
        }
        if left^.kind == types.TypeKind.LITERAL { left = check_expression_as(checker, left_node, nil) }
        if right^.kind == types.TypeKind.LITERAL { right = check_expression_as(checker, right_node, nil) }

        // Two bool, char or string operands of which one is a distinct type and
        // the other is not (or is another distinct type): only a literal on the
        // plain side is accepted, as it takes the distinct type.
        is_scalar_pair = left^.kind == right^.kind && (left^.kind == types.TypeKind.STRING || left^.kind == types.TypeKind.BOOL || left^.kind == types.TypeKind.CHAR)
        if is_scalar_pair && !types.type_same_distinct(left, right) {
            mut plain_node = left_node
            if left^.distinct_name != "" { plain_node = right_node }
            if left^.distinct_name != "" && right^.distinct_name != "" { plain_node = nil }
            if plain_node == nil || !is_scalar_literal_node(plain_node) {
                if is_comparison {
                    add_cast_help_diagnostic(checker, "E3156", error_registry.registry_message_formatted("E3156", {shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
                } otherwise {
                    add_cast_help_diagnostic(checker, "E3002", error_registry.registry_message_formatted("E3002", {operator_display_name(operator), shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
                return checker^.pool^.type_unknown
            }
        }
    }

    // Whether any operator-specific check has rejected the expression, so the result
    // collapses to unknown instead of one operand's type and the declaration
    // that takes it does not cascade a second diagnostic.
    mut infix_errored = false

    // A void operand makes no sense in any binary operator.
    if left^.kind == types.TypeKind.VOID { infix_errored = true }
    if right^.kind == types.TypeKind.VOID { infix_errored = true }
    reject_void_in_context(checker, left_node, left, "binary operand")
    reject_void_in_context(checker, right_node, right, "binary operand")

    // Multi-return calls cannot appear as operands
    reject_multi_return_in_single_position(checker, left_node)
    reject_multi_return_in_single_position(checker, right_node)

    // A C interop result has no Grayscale type to check the operator against
    if left^.kind == types.TypeKind.C_FUNCTION || right^.kind == types.TypeKind.C_FUNCTION {
        mut bad_operand = right_node
        if left^.kind == types.TypeKind.C_FUNCTION { bad_operand = left_node }
        add_diagnostic(checker, "E3168", error_registry.registry_message("E3168"), bad_operand^.tok.file, bad_operand^.tok.line, bad_operand^.tok.col)
        return checker^.pool^.type_unknown
    }

    // String ordering operators are not supported; use strings.compare()
    if (left^.kind == types.TypeKind.STRING || right^.kind == types.TypeKind.STRING) && is_ordering {
        add_diagnostic_help(checker, "E3180", error_registry.registry_message_formatted("E3180", {operator_display_name(operator)}), "use strings.compare() instead", node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_bool
    }

    // Compile-time divide/modulo by zero: the right operand folds to an
    // integer zero (a literal, a literal expression, or a const binding) or is
    // a floating-point literal zero, including a prefix -0.
    if operator == token.TokenKind.SLASH || operator == token.TokenKind.PERCENT {
        mut is_zero = false
        integer_value, is_right_integer_literal, _ = fold_const_integer(checker, right_node)
        if is_right_integer_literal && integer_value == 0 {
            is_zero = true
        } or right_node != nil && right_node^.kind == ast.NodeKind.FLOAT_VALUE && right_node^.float_value^.value == 0.0 {
            is_zero = true
        } or right_node != nil && right_node^.kind == ast.NodeKind.PREFIX_EXPR && right_node^.prefix^.op == token.TokenKind.MINUS && right_node^.prefix^.right != nil && right_node^.prefix^.right^.kind == ast.NodeKind.FLOAT_VALUE && right_node^.prefix^.right^.float_value^.value == 0.0 {
            is_zero = true
        }
        if is_zero {
            mut division_word = "division"
            if operator == token.TokenKind.PERCENT { division_word = "modulo" }
            add_diagnostic(checker, "E3201", error_registry.registry_message_formatted("E3201", {division_word}), right_node^.tok.file, right_node^.tok.line, right_node^.tok.col)
            infix_errored = true
        } or operator == token.TokenKind.SLASH {
            // INT64_MIN / -1 is the one division C leaves undefined at the
            // int64 boundary.
            left_value, is_left_constant, _ = fold_const_integer(checker, left_node)
            if is_right_integer_literal && integer_value == -1 && is_left_constant && left_value == -I64_MAX - 1 {
                mut shown = left
                if numeric_result != nil { shown = numeric_result }
                add_diagnostic(checker, "E3137", error_registry.registry_message_formatted("E3137", {"${left_value}", "${integer_value}", shown_type(checker, shown)}), node^.tok.file, node^.tok.line, node^.tok.col)
                infix_errored = true
            }
        }
    }

    // Bool used in arithmetic (e.g. 1 + true)
    if (left^.kind == types.TypeKind.BOOL || right^.kind == types.TypeKind.BOOL) && is_arithmetic && left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN {
        add_diagnostic(checker, "E3002", error_registry.registry_message_formatted("E3002", {operator_display_name(operator), shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Nil in any operator other than equality
    if (left^.kind == types.TypeKind.NIL_TYPE || right^.kind == types.TypeKind.NIL_TYPE) && operator != token.TokenKind.EQ && operator != token.TokenKind.NOT_EQ {
        add_diagnostic(checker, "E3182", error_registry.registry_message_formatted("E3182", {operator_display_name(operator)}), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Nil compared to a non-nullable type
    if !infix_errored && (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) {
        mut non_nil ^types.GrayType = nil
        if left^.kind == types.TypeKind.NIL_TYPE && right^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.NIL_TYPE && right^.kind != types.TypeKind.POINTER && right^.kind != types.TypeKind.ERROR {
            non_nil = right
        } or right^.kind == types.TypeKind.NIL_TYPE && left^.kind != types.TypeKind.UNKNOWN && left^.kind != types.TypeKind.NIL_TYPE && left^.kind != types.TypeKind.POINTER && left^.kind != types.TypeKind.ERROR {
            non_nil = left
        }
        if non_nil != nil {
            add_diagnostic(checker, "E3092", error_registry.registry_message_formatted("E3092", {shown_type(checker, non_nil)}), node^.tok.file, node^.tok.line, node^.tok.col)
            infix_errored = true
        }
    }

    // String concatenation with '+' needs two strings
    if operator == token.TokenKind.PLUS && (left^.kind == types.TypeKind.STRING || right^.kind == types.TypeKind.STRING) && left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN && (left^.kind != types.TypeKind.STRING || right^.kind != types.TypeKind.STRING) {
        add_diagnostic(checker, "E3048", error_registry.registry_message_formatted("E3048", {shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // '&&' and '||' require bool operands, matching '!'
    if operator == token.TokenKind.AND || operator == token.TokenKind.OR {
        mut operand_nodes [^ast.AstNode] = {left_node, right_node}
        mut operand_types [^types.GrayType] = {left, right}
        for operand_index in range(0, 2) {
            operand_type = operand_types[operand_index]
            if operand_type^.kind == types.TypeKind.BOOL || operand_type^.kind == types.TypeKind.UNKNOWN { continue }
            operand_node = operand_nodes[operand_index]
            add_diagnostic(checker, "E3212", error_registry.registry_message_formatted("E3212", {operator_display_name(operator), shown_type(checker, operand_type)}), operand_node^.tok.file, operand_node^.tok.line, operand_node^.tok.col)
            infix_errored = true
        }
    }

    // Arithmetic on strings other than '+'
    if (left^.kind == types.TypeKind.STRING || right^.kind == types.TypeKind.STRING) && operator != token.TokenKind.PLUS && operator != token.TokenKind.AND && operator != token.TokenKind.OR && operator != token.TokenKind.EQ && operator != token.TokenKind.NOT_EQ && operator != token.TokenKind.IN && operator != token.TokenKind.NOT_IN {
        add_diagnostic(checker, "E3180", error_registry.registry_message_formatted("E3180", {operator_display_name(operator)}), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Arithmetic on map, array, or struct
    if !infix_errored && is_arithmetic {
        mut bad_operand_type ^types.GrayType = nil
        if left^.kind == types.TypeKind.MAP || left^.kind == types.TypeKind.ARRAY || left^.kind == types.TypeKind.STRUCT {
            bad_operand_type = left
        } or right^.kind == types.TypeKind.MAP || right^.kind == types.TypeKind.ARRAY || right^.kind == types.TypeKind.STRUCT {
            bad_operand_type = right
        }
        if bad_operand_type != nil && bad_operand_type^.kind != types.TypeKind.UNKNOWN {
            add_diagnostic(checker, "E3093", error_registry.registry_message_formatted("E3093", {operator_display_name(operator), shown_type(checker, bad_operand_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
            infix_errored = true
        }
    }

    // Pointer arithmetic is not supported
    if (left^.kind == types.TypeKind.POINTER || right^.kind == types.TypeKind.POINTER) && is_arithmetic {
        add_diagnostic(checker, "E3078", error_registry.registry_message("E3078"), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Pointer ordering comparisons are not supported
    if !infix_errored && (left^.kind == types.TypeKind.POINTER || right^.kind == types.TypeKind.POINTER) && is_ordering {
        add_diagnostic(checker, "E3120", error_registry.registry_message("E3120"), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Different enum types in a comparison
    if !infix_errored && (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) && left^.kind == types.TypeKind.ENUM && right^.kind == types.TypeKind.ENUM && left^.name != "" && right^.name != "" && !same_enum_type(checker, left^.name, right^.name) {
        add_diagnostic(checker, "E3032", error_registry.registry_message_formatted("E3032", {shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // == / != on tagged enums
    if !infix_errored && (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) && left^.kind == types.TypeKind.ENUM && right^.kind == types.TypeKind.ENUM && left^.name != "" && enum_is_tagged(checker, left^.name) {
        add_diagnostic(checker, "E3124", error_registry.registry_message_formatted("E3124", {operator_display_name(operator), enum_display_name(checker, left^.name)}), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Arithmetic and ordering on enum values. Ordering is allowed when
    // one side is an integer variable (the user has unboxed the enum value).
    if !infix_errored && (is_arithmetic || is_ordering) {
        left_is_enum = left^.kind == types.TypeKind.ENUM
        right_is_enum = right^.kind == types.TypeKind.ENUM
        has_integer_side = left^.kind == types.TypeKind.INT || right^.kind == types.TypeKind.INT
        if (left_is_enum || right_is_enum) && !(is_ordering && has_integer_side) {
            add_diagnostic(checker, "E3049", error_registry.registry_message_formatted("E3049", {operator_display_name(operator)}), node^.tok.file, node^.tok.line, node^.tok.col)
            infix_errored = true
        }
    }

    // Enum vs integer comparison
    if (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) && left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN {
        if left^.kind == types.TypeKind.ENUM && is_int_kind(right^.kind) {
            add_diagnostic(checker, "E3117", error_registry.registry_message_formatted("E3117", {shown_type(checker, left), shown_type(checker, right), shown_type(checker, left)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if is_int_kind(left^.kind) && right^.kind == types.TypeKind.ENUM {
            add_diagnostic(checker, "E3117", error_registry.registry_message_formatted("E3117", {shown_type(checker, right), shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }

    // Comparison of incompatible types (e.g. i64 == string)
    if (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) && !numeric_pair && equality_operand_kinds_mismatch(left, right) {
        add_diagnostic(checker, "E3156", error_registry.registry_message_formatted("E3156", {shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    // A bool ordered against a non-bool (n < flag): the C compiler would
    // compare it as 1 or 0.
    if is_ordering && left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN && (left^.kind == types.TypeKind.BOOL) != (right^.kind == types.TypeKind.BOOL) {
        add_diagnostic(checker, "E3156", error_registry.registry_message_formatted("E3156", {shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    // Pointer-to-pointer: pointee types differ in == / !=
    if (operator == token.TokenKind.EQ || operator == token.TokenKind.NOT_EQ) && left^.kind == types.TypeKind.POINTER && right^.kind == types.TypeKind.POINTER && left^.name != "" && right^.name != "" && left^.name != right^.name && left^.name != "nil" && right^.name != "nil" {
        add_diagnostic(checker, "E3156", error_registry.registry_message_formatted("E3156", {shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    // Arrays, maps and structs cannot be compared directly
    if (is_comparison) && left^.kind == types.TypeKind.ARRAY && right^.kind == types.TypeKind.ARRAY {
        add_diagnostic(checker, "E3074", error_registry.registry_message("E3074"), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }
    if (is_comparison) && left^.kind == types.TypeKind.MAP && right^.kind == types.TypeKind.MAP {
        add_diagnostic(checker, "E3076", error_registry.registry_message("E3076"), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }
    if (is_comparison) && left^.kind == types.TypeKind.STRUCT && right^.kind == types.TypeKind.STRUCT {
        add_diagnostic(checker, "E3077", error_registry.registry_message("E3077"), node^.tok.file, node^.tok.line, node^.tok.col)
        infix_errored = true
    }

    // Type compatibility for in / not_in
    if (operator == token.TokenKind.IN || operator == token.TokenKind.NOT_IN) && !infix_errored && left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN {
        mut mismatch = false
        left_type_name = types.type_display_name(left)
        right_type_name = types.type_display_name(right)
        if right^.kind == types.TypeKind.ARRAY && right^.element_type != "" {
            element_type = checker_type_from_name(checker, right^.element_type)
            if element_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, element_type, left) && left^.name != right^.element_type {
                mismatch = true
            }
        } or right^.kind == types.TypeKind.MAP && right^.key_type != "" {
            key_type_of_right = checker_type_from_name(checker, right^.key_type)
            if key_type_of_right^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, key_type_of_right, left) && left^.name != right^.key_type {
                mismatch = true
            }
        } or right^.kind == types.TypeKind.STRING {
            // char in string and string in string are valid
            if left^.kind != types.TypeKind.CHAR && left^.kind != types.TypeKind.STRING { mismatch = true }
        } or right^.kind == types.TypeKind.RANGE {
            // only integer types can be checked against a range
            if !is_int_kind(left^.kind) || (node^.infix^.right^.kind != ast.NodeKind.RANGE_EXPR && !range_holds_integer(right, left)) { mismatch = true }
        } otherwise {
            add_diagnostic(checker, "E3095", error_registry.registry_message_formatted("E3095", {right_type_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            infix_errored = true
        }
        if mismatch {
            add_diagnostic(checker, "E3085", error_registry.registry_message_formatted("E3085", {left_type_name, right_type_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            infix_errored = true
        }
    }

    // Binary bitwise operators require integer operands
    mut result = checker^.pool^.type_unknown
    if is_bitwise && !numeric_pair && !infix_errored && left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN {
        is_left_valid = is_int_kind(left^.kind) || left^.kind == types.TypeKind.CHAR || (left^.kind == types.TypeKind.ENUM && left^.name != "" && enum_is_flags(checker, left^.name))
        is_right_valid = is_int_kind(right^.kind) || right^.kind == types.TypeKind.CHAR || (right^.kind == types.TypeKind.ENUM && right^.name != "" && enum_is_flags(checker, right^.name))
        if !is_left_valid || !is_right_valid {
            add_diagnostic(checker, "E8001", error_registry.registry_message_formatted("E8001", {operator_display_name(operator), shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
            infix_errored = true
        } otherwise {
            result = left
        }
    }

    if numeric_pair {
        result = numeric_result
    } or is_comparison || operator == token.TokenKind.AND || operator == token.TokenKind.OR || operator == token.TokenKind.IN || operator == token.TokenKind.NOT_IN {
        is_logical = operator == token.TokenKind.AND || operator == token.TokenKind.OR
        result = checker^.pool^.type_bool
        if is_logical && (left^.distinct_name != "" || right^.distinct_name != "") {
            if left^.distinct_name != "" { result = left } otherwise { result = right }
        }
    } or left^.kind == types.TypeKind.STRING && right^.kind == types.TypeKind.STRING && operator == token.TokenKind.PLUS {
        result = checker^.pool^.type_string
        if left^.distinct_name != "" { result = left } or right^.distinct_name != "" { result = right }
    } or left^.kind == types.TypeKind.ENUM || right^.kind == types.TypeKind.ENUM {
        // #flags enum bitwise ops produce i64
        result = checker^.pool^.type_i64
    } otherwise {
        result = left
    }
    // Any operator-level check that rejected the expression drops the result to
    // unknown, so downstream checks that skip unknown do not cascade a second
    // diagnostic off one of the invalid operand types.
    if infix_errored { result = checker^.pool^.type_unknown }
    return result
}

fn equality_operand_kinds_mismatch(left ^types.GrayType, right ^types.GrayType) -> bool {
    return left^.kind != types.TypeKind.UNKNOWN && right^.kind != types.TypeKind.UNKNOWN && left^.kind != right^.kind && left^.kind != types.TypeKind.NIL_TYPE && right^.kind != types.TypeKind.NIL_TYPE && !(is_int_kind(left^.kind) && is_int_kind(right^.kind)) && !(left^.kind == types.TypeKind.STRUCT && is_int_kind(right^.kind)) && !(is_int_kind(left^.kind) && right^.kind == types.TypeKind.STRUCT) && !(left^.kind == types.TypeKind.ENUM && is_int_kind(right^.kind)) && !(is_int_kind(left^.kind) && right^.kind == types.TypeKind.ENUM)
}

// The type of `node`, which stays LITERAL for a number literal expression that
// has not taken a type yet. Contexts that can give a literal its type
// (check_expression_as, binary operators, casts) resolve through this.
fn resolve_untyped(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    if node == nil { return checker^.pool^.type_unknown }
    if !folding.is_literal_expression(node) { return resolve_expression_inner(checker, node) }
    if node^.is_literal_typed && !checker^.suppress_type_writes {
        return checker_type_from_name(checker, node^.resolved_type)
    }
    inner = resolve_expression_inner(checker, node)
    if inner^.kind == types.TypeKind.UNKNOWN { return inner }
    if folding.literal_expression_is_decimal(node) { return checker^.pool^.type_literal_decimal }
    return checker^.pool^.type_literal_integer
}

// The type of `node`. A number literal expression read here, where nothing
// gives it a type, is reported as its default type, i64 or f64, unless a
// context types it first.
#[discard]
fn resolve_expression(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    resolved = resolve_untyped(checker, node)
    if resolved^.kind != types.TypeKind.LITERAL { return resolved }
    if !checker^.suppress_type_writes { arrays.append(checker^.pending_literals, node) }
    if resolved^.is_decimal { return checker^.pool^.type_f64 }
    return checker^.pool^.type_i64
}

// Records `taken` on every node of the literal expression `node`, and its
// folded value on every node that is a constant. Returns the value of `node`
// and whether it is a constant.
#[discard]
fn literal_take_type(checker ^TypeChecker, node ^ast.AstNode, taken ^types.GrayType) -> (folding.LiteralValue, bool) {
    value, is_constant = folding.constant_fold(checker^.const_integers, node)
    if checker^.suppress_type_writes { return value, is_constant }
    node^.resolved_type = types.type_display_name(taken)
    node^.is_literal_typed = true
    node^.folded_literal = ""
    if is_constant { node^.folded_literal = folding.literal_text(value) }
    if node^.kind == ast.NodeKind.PREFIX_EXPR {
        literal_take_type(checker, node^.prefix^.right, taken)
    } or node^.kind == ast.NodeKind.INFIX_EXPR {
        literal_take_type(checker, node^.infix^.left, taken)
        is_shift = node^.infix^.op == token.TokenKind.BIT_SHIFT_LEFT || node^.infix^.op == token.TokenKind.BIT_SHIFT_RIGHT
        // A shift count is not part of the shifted value; a literal count stays
        // i64 whatever the value's type.
        if !is_shift {
            literal_take_type(checker, node^.infix^.right, taken)
        } or folding.is_literal_expression(node^.infix^.right) {
            literal_take_type(checker, node^.infix^.right, checker^.pool^.type_i64)
        }
    }
    return value, is_constant
}

// Checks `value` as a value stored into a slot of type `target`. A number
// literal takes the slot's type, and an error reports one that does not fit it.
// Any other number converts under type_conversion: an error when it narrows,
// an error when it crosses signedness. A mismatch of any other kind is left to the
// caller, which reports it with its own code. A nil or unknown `target` gives a
// literal its default type. A bare `.VARIANT` inside `value` resolves against
// `target`. Returns the value's type.
//
// This is the only function that emits errors.
#[discard]
fn check_expression_as(checker ^TypeChecker, value ^ast.AstNode, target ^types.GrayType) -> ^types.GrayType {
    if value == nil { return checker^.pool^.type_unknown }
    is_typed_target = target != nil && target^.kind != types.TypeKind.UNKNOWN && target^.kind != types.TypeKind.LITERAL

    if folding.is_literal_expression(value) {
        literal_type = resolve_untyped(checker, value)
        if literal_type^.kind == types.TypeKind.UNKNOWN { return literal_type }
        is_decimal = folding.literal_expression_is_decimal(value)
        mut taken = checker^.pool^.type_i64
        if is_decimal { taken = checker^.pool^.type_f64 }
        if is_typed_target && types.type_kind_is_number(target^.kind) && (!is_decimal || target^.kind == types.TypeKind.FLOAT) {
            taken = target
        }
        folded, is_constant = literal_take_type(checker, value, taken)
        if is_constant {
            is_float = taken^.kind == types.TypeKind.FLOAT
            if !folding.literal_fits(folded, taken^.name, is_float, taken^.kind == types.TypeKind.UINT) {
                text = folding.literal_text(folded)
                if !folded.is_decimal && !folding.literal_fits_some_integer(folded) {
                    add_diagnostic(checker, "E3046", error_registry.registry_message_formatted("E3046", {text}), value^.tok.file, value^.tok.line, value^.tok.col)
                } or is_float {
                    mut limit f64 = 1.7976931348623157e308
                    if taken^.name == "f32" { limit = 3.4028234663852886e38 }
                    maximum_text = folding.decimal_text(limit)
                    add_diagnostic(checker, "E3036", error_registry.registry_message_formatted("E3036", {text, taken^.name, "-${maximum_text}", maximum_text}), value^.tok.file, value^.tok.line, value^.tok.col)
                } otherwise {
                    minimum_text, maximum_bound_text = folding.integer_type_range(taken^.name)
                    if minimum_text != "" {
                        mut negative_help = ""
                        if taken^.kind == types.TypeKind.UINT && strings.starts_with(text, "-") { negative_help = "unsigned types cannot hold negative values" }
                        add_diagnostic_help(checker, "E3036", error_registry.registry_message_formatted("E3036", {text, taken^.name, minimum_text, maximum_bound_text}), negative_help, value^.tok.file, value^.tok.line, value^.tok.col)
                    }
                }
            }
        }
        return taken
    }

    mut result ^types.GrayType = nil
    if is_typed_target && value^.kind == ast.NodeKind.ARRAY_VALUE && len(value^.array_value^.elements) == 0 && target^.kind == types.TypeKind.MAP {
        // `{}` is an empty array. Where a map is expected it is typed as one, so
        // the position's own mismatch check rejects it.
        mut empty_element = "unknown"
        if target^.value_type != "" { empty_element = target^.value_type }
        result = types.type_array(checker^.pool, empty_element)
        if !checker^.suppress_type_writes { value^.resolved_type = types.type_display_name(result) }
    } or is_typed_target && value^.kind == ast.NodeKind.ARRAY_VALUE && target^.kind == types.TypeKind.ARRAY && target^.element_type != "" {
        result = check_array_literal_as(checker, value, target)
    } or is_typed_target && value^.kind == ast.NodeKind.MAP_VALUE && target^.kind == types.TypeKind.MAP && target^.key_type != "" && target^.value_type != "" {
        result = check_map_literal_as(checker, value, target)
    } otherwise {
        saved = checker^.expected_type
        if is_typed_target { checker^.expected_type = target }
        result = resolve_expression(checker, value)
        checker^.expected_type = saved
    }

    // A bool, char or string literal is accepted by a distinct slot of its kind.
    if is_typed_target && target^.distinct_name != "" && result^.distinct_name == "" && result^.kind == target^.kind && is_scalar_literal_node(value) {
        return target
    }

    if is_typed_target && types.type_kind_is_number(result^.kind) && types.type_kind_is_number(target^.kind) {
        conversion = types.type_conversion(result, target)
        if conversion == types.Conversion.NARROW {
            add_diagnostic(checker, "E3155", error_registry.registry_message_formatted("E3155", {result^.name, target^.name, target^.name}), value^.tok.file, value^.tok.line, value^.tok.col)
        } or conversion == types.Conversion.SIGN_CROSS {
            add_diagnostic(checker, "E3019", error_registry.registry_message_formatted("E3019", {result^.name, target^.name}), value^.tok.file, value^.tok.line, value^.tok.col)
        }
    }
    return result
}

fn is_literal_operand(node ^ast.AstNode) -> bool {
    if node^.kind == ast.NodeKind.INT_VALUE { return true }
    return node^.kind == ast.NodeKind.PREFIX_EXPR && node^.prefix^.right^.kind == ast.NodeKind.INT_VALUE
}

// True when an element of type `actual` cannot be stored as `expected` in an
// array or map literal. A narrowing or signedness-crossing number has been
// reported by check_expression_as already.
fn literal_entry_mismatches(checker ^TypeChecker, expected ^types.GrayType, actual ^types.GrayType) -> bool {
    if expected^.kind == types.TypeKind.UNKNOWN || actual^.kind == types.TypeKind.UNKNOWN || actual^.kind == types.TypeKind.VOID { return false }
    if expected^.kind == types.TypeKind.ENUM && is_int_kind(actual^.kind) { return false }
    if expected^.kind == types.TypeKind.POINTER && actual^.kind == types.TypeKind.POINTER {
        return expected^.element_type != "" && actual^.element_type != "" && expected^.element_type != actual^.element_type
    }
    if expected^.kind == types.TypeKind.ENUM && actual^.kind == types.TypeKind.ENUM {
        return expected^.name != "" && actual^.name != "" && !same_enum_type(checker, expected^.name, actual^.name)
    }
    return !types_assignable(checker, expected, actual)
}

// The value a map key or `when` case denotes when it is a compile-time
// constant, as text that is equal exactly when the values are: a string, char
// or bool literal, an enum variant, or a constant number expression. "" when
// `node` is not one.
fn constant_case_key(checker ^TypeChecker, node ^ast.AstNode) -> string {
    if node == nil { return "" }
    when node^.kind {
        is ast.NodeKind.STRING_VALUE { return "s:${node^.string_value^.value}" }
        is ast.NodeKind.CHAR_VALUE { return "c:${cast(node^.char_value^.value, i64)}" }
        is ast.NodeKind.BOOL_VALUE {
            if node^.bool_value^.value { return "b:1" }
            return "b:0"
        }
        is ast.NodeKind.IMPLICIT_ENUM { return "e:${node^.implicit_enum^.variant}" }
        is ast.NodeKind.MEMBER_EXPR {
            if node^.member^.object != nil && node^.member^.object^.kind == ast.NodeKind.LABEL && is_enum_name(checker, resolve_type_alias(checker, node^.member^.object^.label^.value)) {
                return "e:${node^.member^.member}"
            }
            return ""
        }
        default {
            folded, is_constant = folding.constant_fold(checker^.const_integers, node)
            if !is_constant || folded.is_too_large { return "" }
            return "n:${folding.literal_text(folded)}"
        }
    }
}

// A map literal that repeats a key.
fn check_map_literal_duplicate_keys(checker ^TypeChecker, node ^ast.AstNode) {
    keys = node^.map_value^.keys
    for left_index in range(0, len(keys)) {
        left_key_text = constant_case_key(checker, keys[left_index])
        if left_key_text == "" { continue }
        for right_index in range(left_index + 1, len(keys)) {
            right_key = keys[right_index]
            if constant_case_key(checker, right_key) == left_key_text {
                add_diagnostic(checker, "E12006", error_registry.registry_message("E12006"), right_key^.tok.file, right_key^.tok.line, right_key^.tok.col)
            }
        }
    }
}

// An array literal stored into a slot of array type `target`: each element is
// checked as the element type. An error for an element of another type.
fn check_array_literal_as(checker ^TypeChecker, node ^ast.AstNode, target ^types.GrayType) -> ^types.GrayType {
    element_type = checker_type_from_name(checker, target^.element_type)
    for_each element in node^.array_value^.elements {
        entry_type = check_expression_as(checker, element, element_type)
        warn_short_fixed_array_element(checker, target^.element_type, element)
        reject_multi_return_in_single_position(checker, element)
        reject_void_in_context(checker, element, entry_type, "array element")
        if literal_entry_mismatches(checker, element_type, entry_type) {
            add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a collection literal", shown_type(checker, element_type), shown_type(checker, entry_type)}), element^.tok.file, element^.tok.line, element^.tok.col)
        }
    }
    if !checker^.suppress_type_writes { node^.resolved_type = types.type_display_name(target) }
    return target
}

// A map literal stored into a slot of map type `target`: each key and value is
// checked as the key and value type. An error for an entry of another type.
fn check_map_literal_as(checker ^TypeChecker, node ^ast.AstNode, target ^types.GrayType) -> ^types.GrayType {
    key_type = checker_type_from_name(checker, target^.key_type)
    value_type = checker_type_from_name(checker, target^.value_type)
    keys = node^.map_value^.keys
    values = node^.map_value^.values
    for index in range(0, len(keys)) {
        key_node = keys[index]
        value_node = values[index]
        checked_key_type = check_expression_as(checker, key_node, key_type)
        checked_value_type = check_expression_as(checker, value_node, value_type)
        reject_void_in_context(checker, key_node, checked_key_type, "map key")
        reject_void_in_context(checker, value_node, checked_value_type, "map value")
        reject_multi_return_in_single_position(checker, key_node)
        reject_multi_return_in_single_position(checker, value_node)
        if literal_entry_mismatches(checker, key_type, checked_key_type) {
            add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a map literal key", shown_type(checker, key_type), shown_type(checker, checked_key_type)}), key_node^.tok.file, key_node^.tok.line, key_node^.tok.col)
        }
        if literal_entry_mismatches(checker, value_type, checked_value_type) {
            add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a map literal value", shown_type(checker, value_type), shown_type(checker, checked_value_type)}), value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
        }
    }
    check_map_literal_duplicate_keys(checker, node)
    if !checker^.suppress_type_writes { node^.resolved_type = types.type_display_name(target) }
    return target
}

// A bool, char or string literal: the values a distinct type of its kind accepts.
fn is_scalar_literal_node(node ^ast.AstNode) -> bool {
    return node^.kind == ast.NodeKind.BOOL_VALUE || node^.kind == ast.NodeKind.CHAR_VALUE || node^.kind == ast.NodeKind.STRING_VALUE || node^.kind == ast.NodeKind.INTERPOLATED_STRING
}

// A bare `.VARIANT`: the variant must belong to the expected enum, and
// without an expected enum there is nothing to resolve it against.
fn resolve_implicit_enum(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    variant = node^.implicit_enum^.variant
    expected = checker^.expected_type
    if expected == nil || expected^.kind != types.TypeKind.ENUM || expected^.name == "" {
        add_diagnostic(checker, "E3110", error_registry.registry_message_formatted("E3110", {variant, variant}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    info = find_enum(checker, expected^.name)
    if info == nil || enum_variant_index(info, variant) < 0 {
        add_diagnostic(checker, "E3047", error_registry.registry_message_formatted("E3047", {enum_display_name(checker, expected^.name), variant}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    node^.implicit_enum^.resolved_enum = expected^.name
    reject_payload_variant_without_payload(checker, node, info, variant)
    return expected
}

// A payload variant named without its payload, outside a `when` case.
fn reject_payload_variant_without_payload(checker ^TypeChecker, node ^ast.AstNode, info ^EnumInfo, variant string) {
    if checker^.allows_payloadless_variant || info == nil || !info^.is_tagged { return }
    variant_index = enum_variant_index(info, variant)
    if variant_index < 0 { return }
    payload_count = len(info^.variant_payload_types[variant_index])
    if payload_count > 0 {
        add_diagnostic(checker, "E3113", error_registry.registry_message_formatted("E3113", {variant, enum_display_name(checker, info^.name), "${payload_count}", "0"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// True when `enum_name` names a tagged enum.
fn enum_name_is_tagged(checker ^TypeChecker, enum_name string) -> bool {
    info = find_enum(checker, enum_name)
    return info != nil && info^.is_tagged
}

// An interpolated value codegen cannot print: a tagged enum (or a
// container of one), a struct, a pointer or a function reference.
fn report_unprintable_interpolation(checker ^TypeChecker, node ^ast.AstNode, part_type ^types.GrayType) {
    mut subject = ""
    mut tagged_enum = ""
    if part_type^.kind == types.TypeKind.ENUM && part_type^.name != "" && enum_name_is_tagged(checker, part_type^.name) {
        subject = "a value"
        tagged_enum = part_type^.name
    } or part_type^.kind == types.TypeKind.ARRAY && part_type^.element_type != "" && enum_name_is_tagged(checker, part_type^.element_type) {
        subject = "an array"
        tagged_enum = part_type^.element_type
    } or part_type^.kind == types.TypeKind.MAP && part_type^.value_type != "" && enum_name_is_tagged(checker, part_type^.value_type) {
        subject = "a map"
        tagged_enum = part_type^.value_type
    }
    if tagged_enum != "" {
        add_diagnostic(checker, "E3041", error_registry.registry_message_formatted("E3041", {subject, enum_display_name(checker, tagged_enum)}), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    if part_type^.kind == types.TypeKind.STRUCT && part_type^.name != "" {
        subject = "a struct value of type '${shown_type(checker, part_type)}'"
    } or part_type^.kind == types.TypeKind.POINTER {
        subject = "a pointer value"
    } or part_type^.kind == types.TypeKind.FUNCTION {
        subject = "a function reference"
    } or part_type^.kind == types.TypeKind.STRUCT {
        subject = "a function reference"
    }
    if subject != "" {
        mut subject_help = "call the function or format its result"
        if part_type^.kind == types.TypeKind.STRUCT && part_type^.name != "" { subject_help = "format fields individually (e.g. \"\${v.field}\")" }
        if part_type^.kind == types.TypeKind.POINTER { subject_help = "dereference with ^ or format the pointee explicitly" }
        add_diagnostic_help(checker, "E3202", error_registry.registry_message_formatted("E3202", {subject}), subject_help, node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

fn resolve_expression_inner(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    if node == nil { return checker^.pool^.type_unknown }

    mut result = checker^.pool^.type_unknown

    #strict
    when node^.kind {
        is ast.NodeKind.INT_VALUE { result = checker^.pool^.type_i64 }
        is ast.NodeKind.FLOAT_VALUE { result = checker^.pool^.type_f64 }
        is ast.NodeKind.STRING_VALUE { result = checker^.pool^.type_string }
        is ast.NodeKind.INTERPOLATED_STRING {
            for_each part in node^.interp_string^.parts {
                part_type = resolve_expression(checker, part)
                reject_multi_return_in_single_position(checker, part)
                // The part's position is relative to the sub-stream, so the
                // diagnostic anchors at the string literal
                if part^.kind != ast.NodeKind.STRING_VALUE && part_type^.kind == types.TypeKind.VOID {
                    add_diagnostic(checker, "E3187", error_registry.registry_message_formatted("E3187", {"a string interpolation value"}), node^.tok.file, node^.tok.line, node^.tok.col)
                } or part^.kind != ast.NodeKind.STRING_VALUE && part_type^.kind == types.TypeKind.C_FUNCTION {
                    // Codegen would fall back to a long-long cast, silently truncating a real double or pointer
                    add_diagnostic(checker, "E3168", error_registry.registry_message("E3168"), node^.tok.file, node^.tok.line, node^.tok.col)
                } or part^.kind != ast.NodeKind.STRING_VALUE {
                    report_unprintable_interpolation(checker, node, part_type)
                }
            }
            result = checker^.pool^.type_string
        }
        is ast.NodeKind.BOOL_VALUE { result = checker^.pool^.type_bool }
        is ast.NodeKind.CHAR_VALUE { result = checker^.pool^.type_char }
        is ast.NodeKind.NIL_VALUE { result = checker^.pool^.type_nil }
        is ast.NodeKind.LABEL { result = resolve_label(checker, node) }
        is ast.NodeKind.PREFIX_EXPR { result = resolve_prefix_expr(checker, node) }
        is ast.NodeKind.INFIX_EXPR { result = resolve_infix_expr(checker, node) }
        is ast.NodeKind.POSTFIX_EXPR { result = resolve_postfix_expr(checker, node) }
        is ast.NodeKind.INDEX_EXPR { result = resolve_index_expr(checker, node) }
        is ast.NodeKind.ARRAY_VALUE { result = resolve_array_value(checker, node) }
        is ast.NodeKind.MAP_VALUE { result = resolve_map_value(checker, node) }
        is ast.NodeKind.STRUCT_VALUE { result = resolve_struct_value(checker, node) }
        is ast.NodeKind.CAST_EXPR { result = resolve_cast_expr(checker, node) }
        is ast.NodeKind.NEW_EXPR { result = resolve_new_expr(checker, node) }
        is ast.NodeKind.RANGE_EXPR { result = resolve_range_expr(checker, node) }
        is ast.NodeKind.MEMBER_EXPR { result = resolve_member_expr(checker, node) }
        is ast.NodeKind.FUNC_REF { result = resolve_func_ref(checker, node) }
        is ast.NodeKind.CALL_EXPR { result = resolve_call_expr(checker, node) }
        is ast.NodeKind.IMPLICIT_ENUM { result = resolve_implicit_enum(checker, node) }
        is ast.NodeKind.WHEN_PATTERN, ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT,
        ast.NodeKind.RETURN_STMT, ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT,
        ast.NodeKind.BLOCK_STMT, ast.NodeKind.IF_STMT, ast.NodeKind.WHEN_STMT, ast.NodeKind.FOR_STMT,
        ast.NodeKind.FOR_EACH_STMT, ast.NodeKind.WHILE_STMT, ast.NodeKind.LOOP_STMT,
        ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL,
        ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL,
        ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL, ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }

    if !checker^.suppress_type_writes { node^.resolved_type = types.type_display_name(result) }
    return result
}

// True when a struct literal's field value cannot be stored in a field of `expected_type`.
fn struct_literal_value_mismatches_field(checker ^TypeChecker, expected_type ^types.GrayType, value_type ^types.GrayType) -> bool {
    if value_type^.kind == types.TypeKind.UNKNOWN || expected_type^.kind == types.TypeKind.UNKNOWN { return false }
    if expected_type^.kind == types.TypeKind.ENUM && is_int_kind(value_type^.kind) { return false }
    if is_int_kind(expected_type^.kind) && value_type^.kind == types.TypeKind.STRUCT { return false }
    if value_type^.kind == types.TypeKind.NIL_TYPE && (expected_type^.kind == types.TypeKind.POINTER || expected_type^.kind == types.TypeKind.ERROR) { return false }
    if !types_assignable(checker, expected_type, value_type) { return true }
    if expected_type^.kind == types.TypeKind.POINTER && expected_type^.name != "" && value_type^.name != "" && expected_type^.name != value_type^.name { return true }
    if expected_type^.kind == types.TypeKind.STRUCT && value_type^.kind == types.TypeKind.STRUCT && expected_type^.name != "" && value_type^.name != "" && expected_type^.name != value_type^.name { return true }
    return expected_type^.kind == types.TypeKind.ENUM && value_type^.kind == types.TypeKind.ENUM && expected_type^.name != "" && value_type^.name != "" && expected_type^.name != value_type^.name
}

// Struct literal.
fn resolve_struct_value(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    struct_name = resolve_type_alias(checker, checker_substitute_generics(checker, node^.struct_value^.name))

    mark_written_type_module_used(checker, struct_name)
    si = find_struct(checker, struct_name)
    warn_if_struct_deprecated(checker, node, si)
    // A type parameter that is still unbound stands for any type
    if si == nil && (strings.starts_with(struct_name, "?") || ast.generic_bindings_find(checker^.generics, struct_name) >= 0) {
        for_each field_value in node^.struct_value^.field_values { resolve_expression(checker, field_value) }
        return checker^.pool^.type_unknown
    }
    // A stdlib opaque type (UUID, Mutex, ...) has no literal form, and SourceLocation is
    // compiler-provided: only here() makes one
    if (stdlib_opaque_type_available(checker, struct_name) && (si == nil || !si^.is_user_declared)) || struct_name == "SourceLocation" {
        add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {struct_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    if si == nil && !is_struct_name(checker, struct_name) {
        // The binding names a real type, just not a struct one; reported once per literal
        written_generic_index = ast.generic_bindings_find(checker^.generics, node^.struct_value^.name)
        if written_generic_index >= 0 {
            if !node^.struct_value^.was_type_parameter_rejected {
                node^.struct_value^.was_type_parameter_rejected = true
                add_diagnostic(checker, "E3127", error_registry.registry_message_formatted("E3127", {node^.struct_value^.name, struct_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        } otherwise {
            add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {struct_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return checker^.pool^.type_unknown
    }

    field_names = node^.struct_value^.field_names
    field_values = node^.struct_value^.field_values

    // Duplicate field names in the literal
    for i in range(0, len(field_names)) {
        if field_names[i] == "" { continue }
        for j in range(0, i) {
            if field_names[j] == "" { continue }
            if field_names[j] == field_names[i] {
                message = error_registry.registry_message_formatted("E2015", {field_names[i]})
                add_diagnostic(checker, "E2015", message, node^.tok.file, node^.tok.line, node^.tok.col)
                break
            }
        }
    }

    for i in range(0, len(field_names)) {
        fname = field_names[i]
        mut found = false
        mut expected_t = checker^.pool^.type_unknown
        if si != nil && fname != "" {
            for j in range(0, len(si^.field_names)) {
                if si^.field_names[j] == fname {
                    found = true
                    expected_t = si^.field_types[j]
                    break
                }
            }
        }
        val_t = check_expression_as(checker, field_values[i], expected_t)
        reject_multi_return_in_single_position(checker, field_values[i])
        if fname == "" { continue }

        if !found {
            message = fmt.sprintf("struct '%s' has no field '%s'", {struct_display_name(checker, struct_name), fname})
            add_diagnostic(checker, "E3010", message, node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            if expected_t^.kind == types.TypeKind.MAP && field_values[i]^.kind == ast.NodeKind.ARRAY_VALUE {
                mut map_literal_help = "map literals use '{key: value, ...}' syntax"
                if len(field_values[i]^.array_value^.elements) == 0 { map_literal_help = "use '{:}' for an empty map" }
                add_diagnostic_help(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a struct field", shown_type(checker, expected_t), "an array literal"}), map_literal_help, field_values[i]^.tok.file, field_values[i]^.tok.line, field_values[i]^.tok.col)
            } or struct_literal_value_mismatches_field(checker, expected_t, val_t) {
                add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a struct field", shown_type(checker, expected_t), shown_type(checker, val_t)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            if val_t^.kind != types.TypeKind.UNKNOWN && expected_t^.kind != types.TypeKind.UNKNOWN {
                check_function_signature(checker, field_values[i], expected_t, val_t)
                if si != nil {
                    for field_index in range(0, len(si^.field_names)) {
                        if si^.field_names[field_index] == fname && field_index < len(si^.field_spellings) {
                            check_fixed_array_slot_size(checker, si^.field_spellings[field_index], "field '${fname}'", field_values[i])
                        }
                    }
                }
            }
        }
    }

    return types.type_struct(checker^.pool, struct_name)
}

// cast(value, T): primitive, enum, string and array conversions. An undefined capitalized
// target reports "cannot cast" rather than "undefined type", because an undefined struct
// name cannot be told from a forward reference.
fn resolve_cast_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    // A number literal operand takes the cast's target type, so cast(300, u8) is range-checked like
    // any other literal. Every other operand keeps its own type: the cast is the explicit conversion.
    mut src_t ^types.GrayType = nil
    if !folding.is_literal_expression(node^.cast_data^.value) { src_t = resolve_expression(checker, node^.cast_data^.value) }
    reject_multi_return_in_single_position(checker, node^.cast_data^.value)

    written_target = node^.cast_data^.target_type
    resolved_target = written_target
    target = resolve_type_alias(checker, resolved_target)
    node^.cast_data^.target_type = target

    mut dst_t = checker_type_from_name(checker, resolved_target)
    if is_enum_name(checker, target) {
        dst_t = types.type_enum_type(checker^.pool, target)
    }

    if dst_t^.kind == types.TypeKind.UNKNOWN && ast.generic_bindings_find(checker^.generics, written_target) >= 0 {
        // A type parameter that is still unbound stands for any type
        if src_t == nil { check_expression_as(checker, node^.cast_data^.value, nil) }
        return dst_t
    }
    // A target that names no type, at any depth
    undefined_target = undefined_type_leaf(checker, written_target)
    if undefined_target != "" {
        add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {unqualified_display_name(undefined_target)}), node^.tok.file, node^.tok.line, node^.tok.col)
        if src_t == nil { check_expression_as(checker, node^.cast_data^.value, nil) }
        return checker^.pool^.type_unknown
    }
    if dst_t^.kind == types.TypeKind.UNKNOWN {
        add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {unqualified_display_name(target)}), node^.tok.file, node^.tok.line, node^.tok.col)
        if src_t == nil { check_expression_as(checker, node^.cast_data^.value, nil) }
        return checker^.pool^.type_unknown
    }

    if src_t == nil { src_t = check_expression_as(checker, node^.cast_data^.value, dst_t) }

    if src_t^.kind == types.TypeKind.POINTER && dst_t^.kind == types.TypeKind.POINTER {
        message = fmt.sprintf("cast() cannot reinterpret pointer types ('%s' to '%s'); pointer casts are not supported", {shown_type(checker, src_t), written_target})
        add_diagnostic(checker, "E3167", message, node^.tok.file, node^.tok.line, node^.tok.col)
        return dst_t
    }

    if src_t^.kind != types.TypeKind.UNKNOWN && dst_t^.kind != types.TypeKind.UNKNOWN {
        mut allowed = false
        if src_t^.kind == dst_t^.kind && src_t^.kind != types.TypeKind.ARRAY && src_t^.kind != types.TypeKind.MAP && src_t^.kind != types.TypeKind.STRUCT && src_t^.kind != types.TypeKind.STRING { allowed = true }
        if types.type_is_numeric(src_t) && types.type_is_numeric(dst_t) { allowed = true }
        // A C interop result carries no Grayscale type; cast() to a C-representable scalar is
        // the inline form of the annotated-declaration assertion
        if src_t^.kind == types.TypeKind.C_FUNCTION && c_function_result_fits(dst_t) {
            allowed = true
            extern_call_assert_type(checker, node^.cast_data^.value, dst_t, true)
        }
        if src_t^.kind == types.TypeKind.BOOL && types.type_is_numeric(dst_t) { allowed = true }
        if types.type_is_numeric(src_t) && dst_t^.kind == types.TypeKind.BOOL { allowed = true }
        if (types.type_is_numeric(src_t) || src_t^.kind == types.TypeKind.BOOL) && dst_t^.kind == types.TypeKind.STRING { allowed = true }
        // A string parses into a number at runtime, panicking on bad input
        if src_t^.kind == types.TypeKind.STRING && (dst_t^.kind == types.TypeKind.INT || dst_t^.kind == types.TypeKind.UINT || dst_t^.kind == types.TypeKind.FLOAT) { allowed = true }
        // A distinct type converts to and from its own kind only by cast.
        if (src_t^.distinct_name != "" || dst_t^.distinct_name != "") && src_t^.kind == dst_t^.kind { allowed = true }

        mut src_str_enum = false
        if src_t^.kind == types.TypeKind.ENUM && enum_is_string(checker, src_t^.name) { src_str_enum = true }
        mut dst_str_enum = false
        if dst_t^.kind == types.TypeKind.ENUM && enum_is_string(checker, dst_t^.name) { dst_str_enum = true }

        if src_t^.kind == types.TypeKind.ENUM && !src_str_enum && (dst_t^.kind == types.TypeKind.INT || dst_t^.kind == types.TypeKind.UINT) { allowed = true }
        if (src_t^.kind == types.TypeKind.INT || src_t^.kind == types.TypeKind.UINT) && dst_t^.kind == types.TypeKind.ENUM && !dst_str_enum { allowed = true }
        if src_t^.kind == types.TypeKind.STRING && dst_str_enum { allowed = true }
        if src_str_enum && dst_t^.kind == types.TypeKind.STRING { allowed = true }

        if src_t^.kind == types.TypeKind.ARRAY && dst_t^.kind == types.TypeKind.ARRAY {
            if src_t^.element_type != "" && dst_t^.element_type != "" {
                src_elem = checker_type_from_name(checker, src_t^.element_type)
                dst_elem = checker_type_from_name(checker, dst_t^.element_type)
                if types.type_is_numeric(src_elem) && types.type_is_numeric(dst_elem) { allowed = true }
            } otherwise {
                allowed = true
            }
        }

        // A tagged enum is a struct in C: it converts to no other type, and nothing converts to it
        is_source_tagged = src_t^.kind == types.TypeKind.ENUM && enum_is_tagged(checker, src_t^.name)
        is_destination_tagged = dst_t^.kind == types.TypeKind.ENUM && enum_is_tagged(checker, dst_t^.name)
        if (is_source_tagged || is_destination_tagged) && !(src_t^.kind == dst_t^.kind && src_t^.name == dst_t^.name) { allowed = false }

        if !allowed {
            mut tn = shown_type(checker, src_t)
            if src_t^.kind == types.TypeKind.ARRAY && src_t^.element_type != "" {
                tn = fmt.sprintf("[%s]", {src_t^.element_type})
            }
            message = fmt.sprintf("cannot cast '%s' to '%s'", {tn, unqualified_display_name(written_target)})
            add_diagnostic_help(checker, "E3043", message, "only primitive-to-primitive casts are supported (e.g. cast(x, i64), cast(x, string))", node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }

    return dst_t
}

// new(T).
fn resolve_new_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    // A type written with a type parameter allocates whatever it is bound to
    // in each instantiation; the node keeps the spelling for codegen.
    written_type = node^.new_expr^.type_name
    if checker_substitute_generics(checker, written_type) != written_type {
        return checker_type_from_name(checker, "^${written_type}")
    }
    reject_error_in_container(checker, node, written_type)
    reject_void_type(checker, node, written_type, "a type argument of 'new()'")
    qualified_type = strip_stdlib_qualifiers(checker, written_type)
    pointee_type = resolve_type_alias_keeping_distinct(checker, qualified_type)
    new_type = resolve_type_alias(checker, qualified_type)
    node^.new_expr^.type_name = new_type

    nt = types.type_from_name(checker^.pool, new_type)
    // A stdlib opaque type (Thread, Mutex, ...) types as a bare-name struct, so it is
    // checked against the allowlist of the modules the program imports
    mut known = is_struct_name(checker, new_type) || is_enum_name(checker, new_type) || stdlib_opaque_type_available(checker, new_type)
    if nt^.kind != types.TypeKind.UNKNOWN && nt^.kind != types.TypeKind.STRUCT { known = true }

    if !known {
        add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {new_type}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    mark_type_module_used(checker, new_type)
    warn_if_type_name_deprecated(checker, node, new_type, "")

    return types.type_pointer(checker^.pool, pointee_type)
}

// Map literal. The empty literal resolves to map[:].
fn resolve_map_value(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    keys = node^.map_value^.keys
    values = node^.map_value^.values

    mut first_kt = checker^.pool^.type_unknown
    mut first_vt = checker^.pool^.type_unknown
    // under an expected map type, keys and values resolve against its key and value types
    mut key_expected ^types.GrayType = nil
    mut value_expected ^types.GrayType = nil
    expected_map = checker^.expected_type
    if expected_map != nil && expected_map^.kind == types.TypeKind.MAP && expected_map^.key_type != "" && expected_map^.value_type != "" {
        key_expected = checker_type_from_name(checker, expected_map^.key_type)
        value_expected = checker_type_from_name(checker, expected_map^.value_type)
    }
    // With no map type to take, the keys are one type and the values another: the first
    // key (value) that has a type, which every literal key (value) takes too; i64 (f64
    // with a decimal literal) when all are literals
    if key_expected == nil && len(keys) > 0 {
        mut inferred_key ^types.GrayType = nil
        mut inferred_value ^types.GrayType = nil
        mut key_decimal = false
        mut value_decimal = false
        for i in range(0, len(keys)) {
            checked_key = resolve_untyped(checker, keys[i])
            checked_value = resolve_untyped(checker, values[i])
            if checked_key^.kind == types.TypeKind.LITERAL {
                key_decimal = key_decimal || checked_key^.is_decimal
            } or inferred_key == nil {
                inferred_key = checked_key
            }
            if checked_value^.kind == types.TypeKind.LITERAL {
                value_decimal = value_decimal || checked_value^.is_decimal
            } or inferred_value == nil {
                inferred_value = checked_value
            }
            reject_void_in_context(checker, keys[i], checked_key, "map key")
            reject_void_in_context(checker, values[i], checked_value, "map value")
            reject_multi_return_in_single_position(checker, keys[i])
            reject_multi_return_in_single_position(checker, values[i])
        }
        if inferred_key == nil {
            inferred_key = checker^.pool^.type_i64
            if key_decimal { inferred_key = checker^.pool^.type_f64 }
        }
        if inferred_value == nil {
            inferred_value = checker^.pool^.type_i64
            if value_decimal { inferred_value = checker^.pool^.type_f64 }
        }
        if inferred_key^.kind == types.TypeKind.ERROR || inferred_value^.kind == types.TypeKind.ERROR {
            add_diagnostic(checker, "E3153", error_registry.registry_message("E3153"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        for i in range(0, len(keys)) {
            if folding.is_literal_expression(keys[i]) && literal_entry_mismatches(checker, inferred_key, check_expression_as(checker, keys[i], inferred_key)) {
                add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a map literal key", shown_type(checker, inferred_key), shown_type(checker, resolve_expression(checker, keys[i]))}), keys[i]^.tok.file, keys[i]^.tok.line, keys[i]^.tok.col)
            }
            if folding.is_literal_expression(values[i]) && literal_entry_mismatches(checker, inferred_value, check_expression_as(checker, values[i], inferred_value)) {
                add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a map literal value", shown_type(checker, inferred_value), shown_type(checker, resolve_expression(checker, values[i]))}), values[i]^.tok.file, values[i]^.tok.line, values[i]^.tok.col)
            }
        }
        check_map_literal_duplicate_keys(checker, node)
        inferred_key_name = types.type_display_name(inferred_key)
        if inferred_key^.kind == types.TypeKind.UNKNOWN { inferred_key_name = "unknown" }
        inferred_value_name = types.type_display_name(inferred_value)
        if inferred_value^.kind == types.TypeKind.UNKNOWN { inferred_value_name = "unknown" }
        return types.type_map(checker^.pool, inferred_key_name, inferred_value_name)
    }
    for i in range(0, len(keys)) {
        kt = check_expression_as(checker, keys[i], key_expected)
        vt = check_expression_as(checker, values[i], value_expected)
        if i == 0 {
            first_kt = kt
            first_vt = vt
        }
        reject_void_in_context(checker, keys[i], kt, "map key")
        reject_void_in_context(checker, values[i], vt, "map value")
        reject_multi_return_in_single_position(checker, keys[i])
        reject_multi_return_in_single_position(checker, values[i])
    }

    if len(keys) > 0 && (first_kt^.kind == types.TypeKind.ERROR || first_vt^.kind == types.TypeKind.ERROR) {
        add_diagnostic(checker, "E3153", error_registry.registry_message("E3153"), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    check_map_literal_duplicate_keys(checker, node)

    mut kt_name = ""
    mut vt_name = ""
    if len(keys) > 0 {
        kt_name = types.type_display_name(first_kt)
        if first_kt^.kind == types.TypeKind.UNKNOWN { kt_name = "unknown" }
        vt_name = types.type_display_name(first_vt)
        if first_vt^.kind == types.TypeKind.UNKNOWN { vt_name = "unknown" }
    }
    return types.type_map(checker^.pool, kt_name, vt_name)
}

// Array literal.
fn resolve_array_value(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    mut result = checker^.pool^.type_unknown
    elements = node^.array_value^.elements
    if len(elements) > 0 {
        // With no array type to take, the elements are one type: the first element that has
        // one, which every literal element takes too; i64 (f64 with a decimal literal) when
        // all are literals
        mut first ^types.GrayType = nil
        mut any_decimal = false
        for_each element in elements {
            element_kind_type = resolve_untyped(checker, element)
            reject_multi_return_in_single_position(checker, element)
            reject_void_in_context(checker, element, element_kind_type, "array element")
            if element_kind_type^.kind == types.TypeKind.LITERAL {
                any_decimal = any_decimal || element_kind_type^.is_decimal
            } or first == nil {
                first = element_kind_type
            }
        }
        if first == nil {
            first = checker^.pool^.type_i64
            if any_decimal { first = checker^.pool^.type_f64 }
        }
        if first^.kind == types.TypeKind.ERROR {
            add_diagnostic(checker, "E3153", error_registry.registry_message("E3153"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        mut elem_name = types.type_display_name(first)
        if first^.kind == types.TypeKind.UNKNOWN { elem_name = "unknown" }
        result = types.type_array(checker^.pool, elem_name)

        for_each element in elements {
            mut element_resolved = checker^.pool^.type_unknown
            if folding.is_literal_expression(element) {
                element_resolved = check_expression_as(checker, element, first)
            } otherwise {
                element_resolved = resolve_expression(checker, element)
            }
            if element_resolved^.kind == types.TypeKind.UNKNOWN || first^.kind == types.TypeKind.UNKNOWN { continue }
            if first^.kind == types.TypeKind.C_FUNCTION || element_resolved^.kind == types.TypeKind.C_FUNCTION { continue }

            // Strict type equality for array elements: no coercions
            mut compatible = first^.kind == element_resolved^.kind
            if compatible && first^.name != "" && element_resolved^.name != "" {
                compatible = first^.name == element_resolved^.name
            }
            if compatible && first^.element_type != "" && element_resolved^.element_type != "" {
                compatible = first^.element_type == element_resolved^.element_type
            }
            if !compatible {
                add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"an array literal", shown_type(checker, first), shown_type(checker, element_resolved)}), element^.tok.file, element^.tok.line, element^.tok.col)
                break
            }
        }
    }
    return result
}

// Array/map/string subscript. A literal `.VARIANT` index resolves as unknown.
fn resolve_index_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    reject_multi_return_in_single_position(checker, node^.index_data^.left)
    reject_multi_return_in_single_position(checker, node^.index_data^.index_expr)

    left = resolve_expression(checker, node^.index_data^.left)
    // a map's declared key type is what a bare `.VARIANT` index resolves against
    // An array or string index is an i64; a map index is the key type
    mut key_expected ^types.GrayType = nil
    if left^.kind == types.TypeKind.ARRAY || left^.kind == types.TypeKind.STRING { key_expected = checker^.pool^.type_i64 }
    if left^.kind == types.TypeKind.MAP && left^.key_type != "" { key_expected = checker_type_from_name(checker, left^.key_type) }
    idx_t = check_expression_as(checker, node^.index_data^.index_expr, key_expected)

    if left^.kind == types.TypeKind.ARRAY && idx_t^.kind != types.TypeKind.UNKNOWN && !is_int_kind(idx_t^.kind) {
        add_diagnostic(checker, "E3003", error_registry.registry_message_formatted("E3003", {"array", shown_type(checker, idx_t)}), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    // Reject a negative literal index at compile time (arrays and strings)
    idx_node = node^.index_data^.index_expr
    if (left^.kind == types.TypeKind.ARRAY || left^.kind == types.TypeKind.STRING) && idx_node^.kind == ast.NodeKind.PREFIX_EXPR {
        if idx_node^.prefix^.op == token.TokenKind.MINUS {
            r = idx_node^.prefix^.right
            if r != nil {
                if r^.kind == ast.NodeKind.INT_VALUE {
                    mut what = "array"
                    if left^.kind == types.TypeKind.STRING { what = "string" }
                    add_diagnostic(checker, "E3203", error_registry.registry_message_formatted("E3203", {what}), idx_node^.tok.file, idx_node^.tok.line, idx_node^.tok.col)
                }
            }
        }
    }

    mut result = checker^.pool^.type_unknown
    if left^.kind == types.TypeKind.ARRAY && left^.element_type != "" {
        result = checker_type_from_name(checker, left^.element_type)
    } otherwise {
        if left^.kind == types.TypeKind.MAP && left^.value_type != "" {
            result = checker_type_from_name(checker, left^.value_type)
            if left^.key_type != "" && idx_t^.kind != types.TypeKind.UNKNOWN {
                key_t = checker_type_from_name(checker, left^.key_type)
                declared_is_enum = is_enum_name(checker, left^.key_type)
                mut compatible = false
                if key_t^.kind == types.TypeKind.UNKNOWN { compatible = true }
                if types_assignable(checker, key_t, idx_t) { compatible = true }
                if declared_is_enum && is_int_kind(idx_t^.kind) { compatible = true }
                if !compatible {
                    add_diagnostic(checker, "E3053", error_registry.registry_message_formatted("E3053", {"a map index", left^.key_type, shown_type(checker, idx_t)}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        } otherwise {
            if left^.kind == types.TypeKind.STRING {
                if idx_t^.kind != types.TypeKind.UNKNOWN && !is_int_kind(idx_t^.kind) {
                    add_diagnostic(checker, "E3003", error_registry.registry_message_formatted("E3003", {"string", shown_type(checker, idx_t)}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
                result = checker^.pool^.type_char
            } otherwise {
                if left^.kind != types.TypeKind.UNKNOWN {
                    message = fmt.sprintf("type '%s' does not support indexing; only arrays, maps, and strings can be indexed", {shown_type(checker, left)})
                    add_diagnostic(checker, "E3008", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }
    }
    return result
}

fn resolve_prefix_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    right = resolve_expression(checker, node^.prefix^.right)
    reject_multi_return_in_single_position(checker, node^.prefix^.right)
    operator = node^.prefix^.op

    if operator == token.TokenKind.BANG {
        if right^.kind != types.TypeKind.BOOL && right^.kind != types.TypeKind.UNKNOWN {
            message = error_registry.registry_message_formatted("E3090", {shown_type(checker, right)})
            add_diagnostic(checker, "E3090", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if right^.distinct_name != "" && right^.kind == types.TypeKind.BOOL { return right }
        return checker^.pool^.type_bool
    }

    if operator == token.TokenKind.MINUS {
        if right^.kind != types.TypeKind.UNKNOWN {
            if !types.type_is_numeric(right) {
                message = error_registry.registry_message_formatted("E3007", {shown_type(checker, right)})
                add_diagnostic(checker, "E3007", message, node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                if right^.name != "" && types.is_unsigned_type(right^.name) {
                    message = error_registry.registry_message_formatted("E3096", {right^.name})
                    add_diagnostic(checker, "E3096", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }
        return right
    }

    if operator == token.TokenKind.BIT_NOT {
        if right^.kind != types.TypeKind.UNKNOWN && !is_int_kind(right^.kind) && right^.kind != types.TypeKind.CHAR {
            message = error_registry.registry_message_formatted("E8002", {shown_type(checker, right)})
            add_diagnostic(checker, "E8002", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return right
    }

    return right
}

fn resolve_postfix_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    left_t = resolve_expression(checker, node^.postfix^.left)
    operator = node^.postfix^.op

    if operator == token.TokenKind.CARET {
        // Dereferencing a pointer into a @mem arena that was destroyed or reset
        check_mem_deref(checker, node^.postfix^.left, node)
        if left_t^.kind == types.TypeKind.POINTER {
            return checker_type_from_name(checker, left_t^.element_type)
        }
        if left_t^.kind != types.TypeKind.UNKNOWN {
            message = error_registry.registry_message_formatted("E3016", {shown_type(checker, left_t)})
            add_diagnostic(checker, "E3016", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return left_t
    }

    if operator == token.TokenKind.INCREMENT || operator == token.TokenKind.DECREMENT {
        mut is_valid_target = false
        if node^.postfix^.left^.kind == ast.NodeKind.LABEL { is_valid_target = true }
        if node^.postfix^.left^.kind == ast.NodeKind.INDEX_EXPR { is_valid_target = true }
        if node^.postfix^.left^.kind == ast.NodeKind.MEMBER_EXPR { is_valid_target = true }
        if node^.postfix^.left^.kind == ast.NodeKind.POSTFIX_EXPR {
            if node^.postfix^.left^.postfix^.op == token.TokenKind.CARET { is_valid_target = true }
        }
        if !is_valid_target || chain_rooted_at_temporary(node^.postfix^.left) {
            add_diagnostic(checker, "E5015", "++ and -- require a variable; you cannot increment a literal or expression", node^.tok.file, node^.tok.line, node^.tok.col)
        }

        report_write_to_module_variable(checker, node, node^.postfix^.left)
        root = assignment_target_root_name(node^.postfix^.left)
        if root != "" {
            symbol = scope.scope_lookup(checker^.current_scope, root)
            if symbol != nil {
                if symbol_is_const_write_target(symbol) {
                    message = error_registry.registry_message_formatted("E3005", {assignment_target_root_display(node^.postfix^.left)})
                    add_diagnostic(checker, "E3005", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }

        if left_t^.kind != types.TypeKind.UNKNOWN && !types.type_is_integer(left_t) {
            message = error_registry.registry_message_formatted("E5023", {operator_display_name(operator), shown_type(checker, left_t)})
            add_diagnostic(checker, "E5023", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return left_t
    }

    return left_t
}

// A range() call or a name holding a range may appear only where a range is
// consumed; marking it here lets exactly that node through.
fn allow_range_use(checker ^TypeChecker, node ^ast.AstNode) {
    if node != nil && (node^.kind == ast.NodeKind.LABEL || node^.kind == ast.NodeKind.RANGE_EXPR) { checker^.range_use = node }
}

// Rank of a wide integer type name (0 for any other).
fn wide_integer_rank(name string) -> i64 {
    if name == "i128" || name == "u128" { return 2 }
    if name == "i256" || name == "u256" { return 3 }
    return 1
}

// range(start, end[, step]). The range runs in i64, in u64 when a bound is u64, or in the widest
// wide integer type among its bounds; every bound and the step are checked as that type.
fn resolve_range_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    if node != checker^.range_use {
        add_diagnostic(checker, "E3205", error_registry.registry_message("E3205"), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    parts [^ast.AstNode] = {node^.range_expr^.start_expr, node^.range_expr^.end_expr, node^.range_expr^.step}
    mut range_type = checker^.pool^.type_i64
    for i in range(0, 3) {
        if parts[i] == nil { continue }
        reject_multi_return_in_single_position(checker, parts[i])
        parameter_type = resolve_untyped(checker, parts[i])
        if types.is_bigint_type(parameter_type^.name) && wide_integer_rank(parameter_type^.name) > wide_integer_rank(range_type^.name) {
            range_type = parameter_type
        } or parameter_type^.name == "u64" && range_type == checker^.pool^.type_i64 {
            range_type = parameter_type
        }
    }
    for i in range(0, 3) {
        if parts[i] == nil { continue }
        parameter_type = check_expression_as(checker, parts[i], range_type)
        if parameter_type^.kind != types.TypeKind.UNKNOWN && (!is_int_kind(parameter_type^.kind) || parameter_type^.distinct_name != "") {
            report_argument_type(checker, parts[i], i + 1, "range", "an integer", shown_type(checker, parameter_type))
        }
    }
    if parts[2] != nil && folding.is_literal_expression(parts[2]) {
        step_value, step_folded, _ = fold_const_integer(checker, parts[2])
        if step_folded && step_value == 0 {
            add_diagnostic(checker, "E3206", error_registry.registry_message("E3206"), parts[2]^.tok.file, parts[2]^.tok.line, parts[2]^.tok.col)
        }
    }
    return checker_type_from_name(checker, "Range<${range_type^.name}>")
}

// Field lookup on a registered struct.
fn struct_field_type(checker ^TypeChecker, struct_name string, field string) -> ^types.GrayType {
    si = find_struct(checker, struct_name)
    if si == nil { return checker^.pool^.type_unknown }
    for i in range(0, len(si^.field_names)) {
        if si^.field_names[i] == field { return si^.field_types[i] }
    }
    return checker^.pool^.type_unknown
}

// True for the multi-return accessors `.v0` .. `.v9` (the parser desugars
// `a, b = f()` into reads of these).
fn is_multi_return_member(member string) -> bool {
    if len(member) < 2 { return false }
    return member[0] == 'v' && member[1] >= '0' && member[1] <= '9'
}

fn multi_return_index(member string) -> i64 {
    return cast(member[1], i64) - cast('0', i64)
}

fn resolve_error_field(checker ^TypeChecker, node ^ast.AstNode, member string) -> ^types.GrayType {
    if member == "msg" || member == "message" { return checker^.pool^.type_string }
    if member == "code" { return checker_type_from_name(checker, "ErrorCode") }
    add_diagnostic(checker, "E3191", error_registry.registry_message_formatted("E3191", {member}), node^.tok.file, node^.tok.line, node^.tok.col)
    return checker^.pool^.type_unknown
}

// Field access on an already-resolved object type, shared by the three object shapes
// (label-bound variable, nested member chain, arbitrary expression), which all end in the same
// struct / pointer-to-struct / Error / not-dot-accessible ladder.
fn member_of_type(checker ^TypeChecker, node ^ast.AstNode, obj_t ^types.GrayType, member string) -> ^types.GrayType {
    mut result = checker^.pool^.type_unknown
    if obj_t^.kind == types.TypeKind.STRUCT {
        result = struct_field_type(checker, obj_t^.name, member)
        if result^.kind == types.TypeKind.UNKNOWN && !(len(member) > 0 && member[0] == 'v') {
            message = fmt.sprintf("struct '%s' has no field '%s'", {struct_display_name(checker, obj_t^.name), member})
            add_diagnostic(checker, "E3010", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    } otherwise {
        if obj_t^.kind == types.TypeKind.POINTER {
            result = struct_field_type(checker, obj_t^.element_type, member)
            if result^.kind == types.TypeKind.UNKNOWN && !(len(member) > 0 && member[0] == 'v') {
                // The pointee has no such field: an error for a struct, an error when it is not a struct
                pointee_type = checker_type_from_name(checker, obj_t^.element_type)
                if pointee_type^.kind != types.TypeKind.STRUCT && pointee_type^.kind != types.TypeKind.UNKNOWN {
                    add_diagnostic(checker, "E3013", error_registry.registry_message_formatted("E3013", {shown_type(checker, pointee_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
                } otherwise {
                    message = fmt.sprintf("struct '%s' has no field '%s'", {obj_t^.element_type, member})
                    add_diagnostic(checker, "E3010", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        } otherwise {
            if obj_t^.kind == types.TypeKind.ERROR {
                result = resolve_error_field(checker, node, member)
            } or obj_t^.kind == types.TypeKind.VOID {
                reject_void_in_context(checker, node^.member^.object, obj_t, "the base of a member access")
            } otherwise {
                if obj_t^.kind != types.TypeKind.UNKNOWN && obj_t^.kind != types.TypeKind.VOID {
                    message = fmt.sprintf("type '%s' does not support access via dot notation", {shown_type(checker, obj_t)})
                    add_diagnostic(checker, "E3013", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }
    }
    return result
}

fn enum_has_variant(ei ^EnumInfo, variant string) -> bool {
    for i in range(0, len(ei^.values)) {
        if ei^.values[i] == variant { return true }
    }
    return false
}

// The type of the stdlib constant `module.name`, or nil when there is none.
fn stdlib_constant_type(checker ^TypeChecker, module_name string, name string) -> ^types.GrayType {
    if module_name == "math" {
        if arrays.contains({"PI", "E", "TAU", "PHI", "SQRT2", "LN2", "LN10", "INF", "NEG_INF", "EPSILON", "MAX_F64", "MIN_F64"}, name) { return checker^.pool^.type_f64 }
        if name == "MAX_I64" || name == "MIN_I64" { return checker^.pool^.type_i64 }
    }
    if module_name == "os" && arrays.contains({"MAC_OS", "LINUX", "WINDOWS", "OTHER"}, name) { return types.type_enum_type(checker^.pool, "Platform") }
    if module_name == "io" && arrays.contains({"O_RDONLY", "O_WRONLY", "O_RDWR"}, name) { return types.type_enum_type(checker^.pool, "OpenFlag") }
    if module_name == "strconv" && arrays.contains({"BASE_2", "BASE_8", "BASE_10", "BASE_16", "BASE_36"}, name) { return checker^.pool^.type_i64 }
    if module_name == "uuid" && name == "NIL_UUID" { return types.type_struct(checker^.pool, "UUID") }
    return nil
}

// obj.member: enum variant access (`Color.RED`), struct and pointer-to-struct field access,
// multi-return `.vN` access, Error fields, dot access on a non-struct, and a struct *type* named
// as a value.
fn resolve_member_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    mut result = checker^.pool^.type_unknown
    obj = node^.member^.object
    reject_multi_return_in_single_position(checker, obj)
    mut member = node^.member^.member

    if obj^.kind == ast.NodeKind.LABEL {
        mut obj_name = obj^.label^.value
        symbol = scope.scope_lookup(checker^.current_scope, obj_name)

        // An alias of a type names that type: `Hue.RED` for `alias Hue = Color`
        if symbol == nil {
            aliased_name = resolve_type_alias(checker, obj_name)
            if aliased_name != obj_name && (is_enum_name(checker, aliased_name) || is_struct_name(checker, aliased_name)) {
                obj_name = aliased_name
                obj^.label^.value = aliased_name
            }
        }

        // `math.PI`, `os.LINUX`, ...: a stdlib constant reached through its module
        if symbol == nil {
            constant_type = stdlib_constant_type(checker, resolve_import_alias(checker, obj_name), member)
            if constant_type != nil {
                mark_import_used(checker, obj_name)
                return constant_type
            }
        }

        // `extern.EOF`, `extern.M_PI`: a C constant or macro has no Grayscale type the compiler
        // can know, like a C call result; the driver checks the name against the real header
        if obj_name == "extern" && is_imported_module_name(checker, "extern") {
            no_callbacks [string] = {}
            no_argument_types [^types.GrayType] = {}
            record_extern_site(checker, node, member, 0, false, no_callbacks, no_argument_types)
            return checker^.pool^.type_c_function
        }

        // A label naming a type is the qualifier of an enum variant or struct
        // function, so it must not be resolved as a value first.
        obj_is_type_name = symbol == nil && (is_enum_name(checker, obj_name) || is_struct_name(checker, obj_name))
        obj_is_stdlib_module = symbol == nil && !obj_is_type_name && is_imported_module_name(checker, obj_name) && reserved.is_stdlib_module_name(resolve_import_alias(checker, obj_name))
        if !obj_is_type_name && !obj_is_stdlib_module { resolve_expression(checker, obj) }
        // An imported stdlib module whose member matches nothing: the member does not exist
        if obj_is_stdlib_module {
            mark_import_used(checker, obj_name)
            written = "${obj_name}.${member}"
            if maps.contains_key(checker^.stdlib_signatures, "${resolve_import_alias(checker, obj_name)}.${member}") {
                add_diagnostic(checker, "E3031", error_registry.registry_message_formatted("E3031", {written, written, written}), node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                add_diagnostic(checker, "E4024", error_registry.registry_message_formatted("E4024", {obj_name, member}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            return checker^.pool^.type_unknown
        }

        if symbol == nil && is_enum_name(checker, obj_name) {
            ei = find_enum(checker, obj_name)
            warn_if_enum_deprecated(checker, node, ei)
            if ei == nil || !enum_has_variant(ei, member) {
                message = fmt.sprintf("enum '%s' has no member '%s'", {obj_name, member})
                add_diagnostic(checker, "E3047", message, node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                reject_payload_variant_without_payload(checker, node, ei, member)
            }
            return types.type_enum_type(checker^.pool, obj_name)
        }

        if symbol != nil {
            // `_gray_orN.verr` names the call's trailing Error slot, whose index
            // is only known now; rewrite it to the concrete `.vN`.
            if member == "verr" && strings.starts_with(obj_name, ast.SYNTH_OR) {
                slot_count = len(symbol^.ret_types)
                if slot_count >= 1 && symbol^.ret_types[slot_count - 1]^.kind == types.TypeKind.ERROR {
                    member = "v${slot_count - 1}"
                    node^.member^.member = member
                } otherwise {
                    return checker^.pool^.type_unknown
                }
            }
            if len(symbol^.ret_types) > 0 && is_multi_return_member(member) {
                idx = multi_return_index(member)
                if idx < len(symbol^.ret_types) {
                    result = symbol^.ret_types[idx]
                } otherwise {
                    message = fmt.sprintf("too many variables; the function returns %d value(s) but variable %d was requested", {len(symbol^.ret_types), idx + 1})
                    add_diagnostic(checker, "E3006", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            } otherwise {
                if is_multi_return_member(member) && symbol^.sym_type^.kind != types.TypeKind.STRUCT && symbol^.sym_type^.kind != types.TypeKind.POINTER {
                    idx = multi_return_index(member)
                    if strings.starts_with(obj_name, ast.SYNTH_TMP) {
                        // A call returning one value, given to several names
                        // (`a, b = f()`): the value goes to every name
                        ast.ast_convert_to_label(node, obj_name)
                        result = symbol^.sym_type
                    } or idx == 0 {
                        result = symbol^.sym_type
                    } otherwise {
                        add_diagnostic(checker, "E3006", "too many variables; the function returns only 1 value", node^.tok.file, node^.tok.line, node^.tok.col)
                    }
                } otherwise {
                    result = member_of_type(checker, node, symbol^.sym_type, member)
                }
            }
            return result
        }

        // Struct-namespaced function access: Type.func(). A struct field named
        // on the type itself is an error; anything that isn't a registered
        // struct function is an error.
        if is_struct_name(checker, obj_name) {
            ft = struct_field_type(checker, obj_name, member)
            if ft^.kind != types.TypeKind.UNKNOWN {
                message = fmt.sprintf("cannot access field '%s' on type '%s'; use an instance variable instead", {member, obj_name})
                add_diagnostic(checker, "E3044", message, node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                struct_function = find_func(checker, fmt.sprintf("%s_%s", {obj_name, member}))
                if struct_function != nil {
                    struct_function^.used = true
                    mut written = "${struct_display_name(checker, obj_name)}.${member}"
                    if obj^.kind == ast.NodeKind.LABEL && obj^.label^.qualifier != "" { written = "${obj^.label^.qualifier}.${obj^.label^.qualified_member}.${member}" }
                    add_diagnostic(checker, "E3031", error_registry.registry_message_formatted("E3031", {written, written, written}), node^.tok.file, node^.tok.line, node^.tok.col)
                    return checker^.pool^.type_unknown
                }
                if struct_function == nil {
                    if struct_display_name(checker, obj_name) != obj_name {
                        // Written through its module (`mod.Type.member`)
                        add_diagnostic(checker, "E4018", error_registry.registry_message_formatted("E4018", {struct_display_name(checker, obj_name), member}), node^.tok.file, node^.tok.line, node^.tok.col)
                    } otherwise {
                        message = fmt.sprintf("'%s' is a struct, not an enum; it has no variant or member '%s'", {struct_display_name(checker, obj_name), member})
                        add_diagnostic(checker, "E3141", message, node^.tok.file, node^.tok.line, node^.tok.col)
                    }
                }
            }
        }
        return result
    }

    // Nested chain (a.b.character) or arbitrary expression (f().x, arr[i].x, p^.x):
    // resolve the object, then look the member up on its type.
    obj_t = resolve_expression(checker, obj)
    return member_of_type(checker, node, obj_t, member)
}

fn struct_has_field(checker ^TypeChecker, struct_name string, field_name string) -> bool {
    info = find_struct(checker, struct_name)
    if info == nil { return false }
    return arrays.contains(info^.field_names, field_name)
}

fn is_declared_type_alias(checker ^TypeChecker, name string) -> bool {
    for_each declared in checker^.type_aliases {
        if declared.name == name { return true }
    }
    return false
}

// Marks the import tracked under `name` (its alias if it has one) as used.
// Returns whether an import by that name exists.
// An import is in scope only in the file that wrote it.
fn import_in_current_file(checker ^TypeChecker, entry ImportEntry) -> bool {
    // C headers are collected for the whole program, so `extern` is not scoped to a file
    return checker^.current_check_file == "" || entry.mod_name == "extern" || entry.file == checker^.current_check_file
}

#[discard]
fn mark_import_used(checker ^TypeChecker, name string) -> bool {
    for i in range(0, len(checker^.imports)) {
        if checker^.imports[i].mod_name == name && import_in_current_file(checker, checker^.imports[i]) {
            mut imps = checker^.imports
            imps[i].used = true
            checker^.imports = imps
            return true
        }
    }
    return false
}

// Builds the canonical typed-func spelling for a registered signature:
// "func(p1,&p2)" with no "->R" suffix when nothing is returned,
// "func(...)->R" for one return, "func(...)->(R1,R2)" for several. A
// parameter declared `mut` is spelled with a leading `&`.
fn func_sig_type_name(signature ^FuncSig) -> string {
    mut params [string] = {}
    for i in range(0, len(signature^.param_types)) {
        mut prefix = ""
        if i < len(signature^.param_mutable) && signature^.param_mutable[i] { prefix = "&" }
        arrays.append(params, prefix + types.type_display_name(signature^.param_types[i]))
    }
    mut spelled = "func(" + strings.join(params, ",") + ")"

    if len(signature^.return_types) == 1 {
        ret = types.type_display_name(signature^.return_types[0])
        if ret != "void" { spelled = spelled + "->" + ret }
    } otherwise {
        if len(signature^.return_types) > 1 {
            mut rets [string] = {}
            for_each rt in signature^.return_types {
                arrays.append(rets, types.type_display_name(rt))
            }
            spelled = spelled + "->(" + strings.join(rets, ",") + ")"
        }
    }
    return spelled
}

// &func / &Struct.func. Rejects builtins and stdlib module functions (not first-class values), a
// private struct function referenced from outside its struct, and an unknown target; otherwise
// yields the typed func result.
fn resolve_func_ref(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    target = node^.func_ref^.function
    mut ref_name = ""
    mut ref_struct_name = ""
    mut ref_member_name = ""

    if target^.kind == ast.NodeKind.LABEL {
        lname = target^.label^.value
        if reserved.is_reserved_builtin_func_name(lname) {
            add_diagnostic(checker, "E4019", error_registry.registry_message_formatted("E4019", {lname, "builtin"}), node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            ref_name = lname
        }
    } otherwise {
        if target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind == ast.NodeKind.LABEL {
            obj_name = target^.member^.object^.label^.value
            member = target^.member^.member
            mod_name = resolve_import_alias(checker, obj_name)
            if !mark_import_used(checker, obj_name) {
                mark_import_used(checker, mod_name)
            }
            if reserved.is_stdlib_module_name(mod_name) {
                add_diagnostic(checker, "E4038", error_registry.registry_message_formatted("E4038", {obj_name, member}), node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                ref_struct_name = obj_name
                ref_member_name = member
                ref_name = fmt.sprintf("%s_%s", {obj_name, member})
            }
        }
    }

    mut ref_sig ^FuncSig = nil
    if ref_name != "" { ref_sig = find_func(checker, ref_name) }

    if ref_sig != nil {
        ref_sig^.used = true
        warn_if_function_deprecated(checker, node, ref_sig)
        // A generic function has no single C symbol for a reference to name
        if ref_sig^.is_generic {
            mut reference_display = ref_name
            if ref_struct_name != "" && ref_member_name != "" { reference_display = "${ref_struct_name}.${ref_member_name}" }
            add_diagnostic(checker, "E4032", error_registry.registry_message_formatted("E4032", {reference_display}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if ref_sig^.is_private && ref_struct_name != "" && checker^.current_struct_name != ref_struct_name {
            message = error_registry.registry_message_formatted("E4017", {struct_display_name(checker, ref_struct_name), ref_member_name})
            add_diagnostic(checker, "E4017", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
        reject_test_function_reference(checker, node, ref_sig)
        return checker_type_from_name(checker, func_sig_type_name(ref_sig))
    }

    if ref_name != "" {
        // `import and use` / `using` brings a stdlib function in by its bare name
        mut found_in_using = false
        for_each used_module in checker^.using_modules {
            real_module = resolve_import_alias(checker, used_module)
            if reserved.is_stdlib_module_name(real_module) && maps.contains_key(checker^.stdlib_signatures, "${real_module}.${ref_name}") {
                found_in_using = true
                mark_import_used(checker, real_module)
                add_diagnostic(checker, "E4019", error_registry.registry_message_formatted("E4019", {ref_name, "stdlib"}), node^.tok.file, node^.tok.line, node^.tok.col)
                break
            }
        }
        if !found_in_using {
            message = error_registry.registry_message_formatted("E4002", {ref_name})
            add_diagnostic(checker, "E4002", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    return checker_type_from_name(checker, "func")
}

fn arg_type_error(checker ^TypeChecker, arg ^ast.AstNode, message string) {
    add_diagnostic(checker, "E5026", message, arg^.tok.file, arg^.tok.line, arg^.tok.col)
}

// Argument-vs-parameter checks shared by every user-function call shape.
// Do two function types disagree? A typed reference carries its signature in its
// encoded name ("func(i64)->i64"), so any difference is a mismatch. The bare
// `func` names no signature and matches every function type; a signature naming
// an undefined type was already reported and matches too.
fn function_types_mismatch(checker ^TypeChecker, left ^types.GrayType, right ^types.GrayType) -> bool {
    if left == nil || right == nil || left^.kind != types.TypeKind.FUNCTION || right^.kind != types.TypeKind.FUNCTION { return false }
    if left^.name == "" || right^.name == "" || left^.name == "func" || right^.name == "func" { return false }
    if undefined_type_leaf(checker, left^.name) != "" || undefined_type_leaf(checker, right^.name) != "" { return false }
    return left^.name != right^.name
}

// An error at `at` when a function reference's signature differs from the expected one.
fn check_function_signature(checker ^TypeChecker, at ^ast.AstNode, expected ^types.GrayType, got ^types.GrayType) {
    if function_types_mismatch(checker, expected, got) {
        add_diagnostic(checker, "E3066", error_registry.registry_message_formatted("E3066", {shown_type(checker, expected), shown_type(checker, got)}), at^.tok.file, at^.tok.line, at^.tok.col)
    }
}

// Per-argument checks of a direct call: general assignability (with the int/bool/nil/enum/struct
// leniencies), then the enum, struct, pointer, array-element and map-key/value mismatches.
fn check_call_argument(checker ^TypeChecker, arg ^ast.AstNode, index i64, function_name string, param_t ^types.GrayType, arg_t ^types.GrayType) {
    if arg_t^.kind == types.TypeKind.UNKNOWN || param_t^.kind == types.TypeKind.UNKNOWN { return }
    // The coercions every call path accepts: an integer for an enum, nil for a pointer or Error
    if param_t^.kind == types.TypeKind.ENUM && is_int_kind(arg_t^.kind) { return }
    if arg_t^.kind == types.TypeKind.NIL_TYPE && (param_t^.kind == types.TypeKind.POINTER || param_t^.kind == types.TypeKind.ERROR) { return }
    if !types_assignable(checker, param_t, arg_t) {
        report_argument_type(checker, arg, index + 1, function_name, shown_type(checker, param_t), shown_type(checker, arg_t))
    } or arg_t^.kind == types.TypeKind.MAP && param_t^.kind == types.TypeKind.MAP && !map_types_match(param_t, arg_t) {
        report_argument_type(checker, arg, index + 1, function_name, shown_type(checker, param_t), shown_type(checker, arg_t))
    }
    check_function_signature(checker, arg, param_t, arg_t)
}

// Checks a call's arity and arguments against a registered signature and
// yields its first return type (void for none). `first_param` is 1 for an
// instance call (`obj.f(x)`), where the receiver already fills parameter 0.
// Resolves named arguments: validates the names, checks ordering, and
// reorders the call's arguments in place so everything downstream sees
// arguments.
fn resolve_named_arguments(checker ^TypeChecker, node ^ast.AstNode, function_data ^ast.FuncDeclData, display_name string, first_param i64) {
    names = node^.call^.arg_names
    arguments = node^.call^.args
    mut any_named = false
    for_each arg_name in names {
        if arg_name != "" { any_named = true }
    }
    if !any_named { return }

    // A positional argument after a named one
    mut seen_named = false
    for i in range(0, len(arguments)) {
        if names[i] != "" {
            seen_named = true
        } or seen_named {
            message = fmt.sprintf("positional argument after named argument in call to '%s'", {display_name})
            add_diagnostic(checker, "E5033", message, arguments[i]^.tok.file, arguments[i]^.tok.line, arguments[i]^.tok.col)
            return
        }
    }
    if function_data == nil { return }

    params_local = function_data^.params
    parameter_count = len(params_local) - first_param
    mut slots [^ast.AstNode] = {}
    for _ in range(0, parameter_count) {
        mut empty ^ast.AstNode = nil
        arrays.append(slots, empty)
    }

    // Positional arguments are contiguous at the front
    mut positional_count i64 = 0
    for i in range(0, len(arguments)) {
        if names[i] != "" { break }
        if i < parameter_count { slots[i] = arguments[i] }
        positional_count += 1
    }

    for i in range(positional_count, len(arguments)) {
        arg_name = names[i]
        mut slot i64 = -1
        for parameter_index in range(0, parameter_count) {
            if params_local[parameter_index + first_param].name == arg_name {
                slot = parameter_index
                break
            }
        }
        if slot < 0 {
            message = fmt.sprintf("unknown parameter name '%s' in call to '%s'", {arg_name, display_name})
            add_diagnostic(checker, "E5031", message, arguments[i]^.tok.file, arguments[i]^.tok.line, arguments[i]^.tok.col)
            return
        }
        if slots[slot] != nil {
            message = fmt.sprintf("parameter '%s' is already provided positionally (argument %d) in call to '%s'", {arg_name, slot + 1, display_name})
            add_diagnostic(checker, "E5032", message, arguments[i]^.tok.file, arguments[i]^.tok.line, arguments[i]^.tok.col)
            return
        }
        slots[slot] = arguments[i]
    }

    // Everything up to the last filled slot is passed on; unfilled interior
    // slots take the parameter's default value expression
    mut filled i64 = 0
    for i in range(0, parameter_count) {
        if slots[i] != nil { filled = i + 1 }
    }
    if filled < positional_count { filled = positional_count }
    mut resolved [^ast.AstNode] = {}
    for i in range(0, filled) {
        mut argument = slots[i]
        if argument == nil && i < parameter_count { argument = params_local[i + first_param].default_value }
        arrays.append(resolved, argument)
    }
    node^.call^.written_arguments = node^.call^.args
    node^.call^.args = resolved
    node^.call^.arg_names = {}
}

// The type spelling a `generic` parameter's argument names: validated as a
// type name, resolved through aliases and, for a type parameter of the
// enclosing generic function, to what it is bound to (or its "?name"
// placeholder while the enclosing body is checked unbound). Empty once an
// error was reported.
fn resolve_type_argument(checker ^TypeChecker, type_argument ^ast.AstNode) -> string {
    if type_argument^.kind != ast.NodeKind.LABEL {
        add_diagnostic(checker, "E3128", "a 'generic' parameter takes a type name, but got a non-type expression; pass a type name like 'MyStruct' or 'i64'", type_argument^.tok.file, type_argument^.tok.line, type_argument^.tok.col)
        return ""
    }
    label_text = type_argument^.label^.value
    outer_index = ast.generic_bindings_find(checker^.generics, label_text)
    if outer_index >= 0 {
        bound = checker^.generics.types[outer_index]
        if bound != "" { return bound }
        return "?${label_text}"
    }
    if scope.scope_lookup(checker^.current_scope, label_text) != nil {
        add_diagnostic(checker, "E3128", "a 'generic' parameter takes a type name, but got a non-type expression; pass a type name like 'MyStruct' or 'i64'", type_argument^.tok.file, type_argument^.tok.line, type_argument^.tok.col)
        return ""
    }
    bad_leaf = undefined_type_leaf(checker, label_text)
    if bad_leaf != "" {
        message = fmt.sprintf("undefined type '%s'; check the spelling or import the module that defines it", {bad_leaf})
        add_diagnostic(checker, "E4016", message, type_argument^.tok.file, type_argument^.tok.line, type_argument^.tok.col)
        return ""
    }
    target = resolve_type_alias_keeping_distinct(checker, label_text)
    if target != label_text { type_argument^.label^.value = target }
    warn_if_type_name_deprecated(checker, type_argument, target, "")
    return target
}

// Records a concrete instantiation of a generic function so the per-
// instantiation re-check and codegen see it. An instantiation that still
// mentions an unbound type parameter comes from the unbound walk of a
// generic body and is skipped; the real ones are recorded during the re-check.
fn record_instantiation(signature ^FuncSig, concrete string, call_site ^ast.AstNode) {
    if strings.contains(concrete, "?") { return }
    for_each existing in signature^.instantiations {
        if existing == concrete { return }
    }
    mut names = signature^.instantiations
    arrays.append(names, concrete)
    signature^.instantiations = names
    mut calls = signature^.instantiation_calls
    arrays.append(calls, call_site)
    signature^.instantiation_calls = calls
    mut declared = signature^.decl^.instantiations
    arrays.append(declared, concrete)
    signature^.decl^.instantiations = declared
}

// True when parameter `index` is written in terms of one of the function's
// own type parameters, so its type depends on the call.
fn parameter_depends_on_generic(function_data ^ast.FuncDeclData, index i64) -> bool {
    params_local = function_data^.params
    unbound = ast.generic_bindings_init(function_data, "")
    return strings.contains(ast.generic_bindings_substitute(unbound, params_local[index].type_name), "?")
}

// `type_text` as the type it names when the type parameters in `bindings`
// stand for the types they are bound to.
fn checker_type_with_generics(checker ^TypeChecker, bindings ast.GenericBindings, type_text string) -> ^types.GrayType {
    saved = checker^.generics
    checker^.generics = bindings
    result = checker_type_from_name(checker, type_text)
    checker^.generics = saved
    return result
}

// Generic-call handling: take the types named for the callee's `generic`
// parameters, record the instantiation, check the arguments whose parameter
// types depend on them, and produce the substituted return type. The
// arguments for type parameters are consumed here; `handled[i]` is true for
// every argument this already checked.
fn call_handled_flags(signature ^FuncSig, arg_count i64, first_param i64) -> [bool] {
    mut flags [bool] = {}
    if !signature^.is_generic {
        for i in range(0, arg_count) { arrays.append(flags, false) }
        return flags
    }
    return generic_handled_flags(signature^.decl, arg_count, first_param)
}

fn generic_handled_flags(function_data ^ast.FuncDeclData, arg_count i64, first_param i64) -> [bool] {
    params_local = function_data^.params
    mut flags [bool] = {}
    for i in range(0, arg_count) {
        param_index = i + first_param
        mut is_handled = false
        if param_index < len(params_local) {
            is_handled = params_local[param_index].is_type_param || parameter_depends_on_generic(function_data, param_index)
        }
        arrays.append(flags, is_handled)
    }
    return flags
}

// The type arguments a call to generic function `signature` names, read without
// re-validating them: a type parameter of the enclosing generic function
// stands for what it is bound to, or its "?name" placeholder while unbound.
fn generic_call_bindings(checker ^TypeChecker, signature ^FuncSig, call ^ast.AstNode) -> ast.GenericBindings {
    params_local = signature^.decl^.params
    arguments = call^.call^.args
    mut bindings = ast.generic_bindings_init(signature^.decl, "")
    mut bound_types [string] = bindings.types
    mut bound_count i64 = 0
    for i in range(0, len(arguments)) {
        if i >= len(params_local) { break }
        if !params_local[i].is_type_param { continue }
        mut type_text = "unknown"
        if arguments[i]^.kind == ast.NodeKind.LABEL {
            type_text = arguments[i]^.label^.value
            outer_index = ast.generic_bindings_find(checker^.generics, type_text)
            if outer_index >= 0 {
                if checker^.generics.types[outer_index] != "" {
                    type_text = checker^.generics.types[outer_index]
                } otherwise {
                    type_text = "?${type_text}"
                }
            }
        }
        if bound_count < len(bound_types) { bound_types[bound_count] = type_text }
        bound_count += 1
    }
    bindings.types = bound_types
    return bindings
}

fn check_generic_call(checker ^TypeChecker, node ^ast.AstNode, function_name string, signature ^FuncSig, first_param i64) -> ^types.GrayType {
    function_data = signature^.decl
    arguments = node^.call^.args
    params_local = function_data^.params
    mut bindings = ast.generic_bindings_init(function_data, "")
    mut bound_types [string] = bindings.types
    mut bound_count i64 = 0
    mut is_fully_bound = true
    for i in range(0, len(arguments)) {
        param_index = i + first_param
        if param_index >= len(params_local) { break }
        if !params_local[param_index].is_type_param { continue }
        type_text = resolve_type_argument(checker, arguments[i])
        if type_text != "" && bound_count < len(bound_types) {
            bound_types[bound_count] = type_text
        } otherwise {
            is_fully_bound = false
        }
        bound_count += 1
    }
    bindings.types = bound_types
    if bound_count < len(bound_types) { is_fully_bound = false }
    if is_fully_bound {
        record_instantiation(signature, ast.generic_bindings_join(bindings), node)
    }

    for i in range(0, len(arguments)) {
        param_index = i + first_param
        if param_index >= len(params_local) { break }
        param = params_local[param_index]
        if param.is_type_param || !parameter_depends_on_generic(function_data, param_index) { continue }
        expected = checker_type_with_generics(checker, bindings, param.type_name)
        arg_t = check_expression_as(checker, arguments[i], expected)
        reject_multi_return_in_single_position(checker, arguments[i])
        if arg_t^.kind == types.TypeKind.C_FUNCTION {
            report_argument_type(checker, arguments[i], i + 1, function_name, "a typed value", "a C interop value")
            continue
        }
        if arg_t^.kind == types.TypeKind.UNKNOWN || expected^.kind == types.TypeKind.UNKNOWN { continue }
        if function_types_mismatch(checker, expected, arg_t) {
            check_function_signature(checker, arguments[i], expected, arg_t)
            continue
        }
        if !types_assignable(checker, expected, arg_t) || (expected^.kind == types.TypeKind.MAP && arg_t^.kind == types.TypeKind.MAP && !map_types_match(expected, arg_t)) {
            generic_index = ast.generic_bindings_find(bindings, param.type_name)
            mut message = ""
            if generic_index >= 0 {
                is_struct_function = len(signature^.name) > 0 && strings.char_at(signature^.name, 0) >= 'A' && strings.char_at(signature^.name, 0) <= 'Z' && strings.contains(signature^.name, "_")
                mut conflict_code = "E3159"
                if is_struct_function { conflict_code = "E3200" }
                message = error_registry.registry_message_formatted(conflict_code, {param.type_name, function_name, bindings.types[generic_index], "${i + first_param + 1}", shown_type(checker, arg_t)})
                add_diagnostic(checker, conflict_code, message, arguments[i]^.tok.file, arguments[i]^.tok.line, arguments[i]^.tok.col)
            } otherwise {
                message = fmt.sprintf("argument %d of '%s' does not match its generic parameter type '%s' (got %s)", {i + 1, function_name, shown_type(checker, expected), shown_type(checker, arg_t)})
                add_diagnostic(checker, "E3199", message, arguments[i]^.tok.file, arguments[i]^.tok.line, arguments[i]^.tok.col)
            }
        }
    }

    if len(function_data^.return_types) > 0 {
        return checker_type_with_generics(checker, bindings, function_data^.return_types[0])
    }
    return checker^.pool^.type_void
}

// True when a member/index chain is rooted at a call result or struct literal
// with no pointer along the way: the field or element is a copy inside a
// temporary, so a write through it is lost.
fn chain_rooted_at_temporary(expression ^ast.AstNode) -> bool {
    mut current = expression
    as_long_as current^.kind == ast.NodeKind.MEMBER_EXPR || current^.kind == ast.NodeKind.INDEX_EXPR {
        if current^.kind == ast.NodeKind.MEMBER_EXPR { current = current^.member^.object } otherwise { current = current^.index_data^.left }
        if strings.starts_with(current^.resolved_type, "^") { return false }
    }
    return current != expression && (current^.kind == ast.NodeKind.CALL_EXPR || current^.kind == ast.NodeKind.STRUCT_VALUE || current^.kind == ast.NodeKind.ARRAY_VALUE || current^.kind == ast.NodeKind.MAP_VALUE)
}

// The variable a member/index chain is rooted at, or nil when the chain passes
// through a pointer dereference (the pointed-to memory is independent of the
// pointer variable's mutability).
fn mutable_chain_root(expression ^ast.AstNode) -> ^ast.AstNode {
    mut current = expression
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            current = current^.index_data^.left
        } or current^.kind == ast.NodeKind.LABEL {
            return current
        } otherwise {
            break
        }
    }
    mut none ^ast.AstNode = nil
    return none
}

// An argument passed to a mutable (&) parameter must be a mutable
// assignment target: not a constant, an enum constant, a literal or expression,
// nor a field or element of a constant or a temporary.
fn check_mutable_argument(checker ^TypeChecker, argument ^ast.AstNode, parameter_description string, function_display string) {
    if report_write_through_const_pointer(checker, argument, argument) { return }
    if argument^.kind == ast.NodeKind.LABEL {
        symbol = scope.scope_lookup(checker^.current_scope, argument^.label^.value)
        if symbol != nil && !symbol^.mutable {
            add_diagnostic(checker, "E3027", error_registry.registry_message_formatted("E3027", {"a constant", parameter_description, function_display}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
        }
    } or argument^.kind == ast.NodeKind.MEMBER_EXPR && argument^.member^.object^.kind == ast.NodeKind.LABEL && scope.scope_lookup(checker^.current_scope, argument^.member^.object^.label^.value) == nil && is_enum_name(checker, resolve_type_alias(checker, argument^.member^.object^.label^.value)) {
        add_diagnostic(checker, "E3027", error_registry.registry_message_formatted("E3027", {"an enum constant", parameter_description, function_display}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
    } or argument^.kind == ast.NodeKind.MEMBER_EXPR || argument^.kind == ast.NodeKind.INDEX_EXPR {
        // A field or element of a const is as immutable as the const itself. A
        // pointer root auto-derefs, so the pointer variable's const-ness does not
        // carry to the pointee.
        root = mutable_chain_root(argument)
        if root != nil {
            symbol = scope.scope_lookup(checker^.current_scope, root^.label^.value)
            if symbol != nil && !symbol^.mutable && symbol^.sym_type^.kind != types.TypeKind.POINTER {
                add_diagnostic(checker, "E3027", error_registry.registry_message_formatted("E3027", {"a field or element of a constant", parameter_description, function_display}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
            }
        } or chain_rooted_at_temporary(argument) {
            add_diagnostic(checker, "E3027", error_registry.registry_message_formatted("E3027", {"a field or element of a temporary", parameter_description, function_display}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
        }
    } or argument^.kind == ast.NodeKind.POSTFIX_EXPR && argument^.postfix^.op == token.TokenKind.CARET {
        // A pointer dereference is a mutable place
    } otherwise {
        // Anything else, a literal, an arithmetic or logical expression, a prefix
        // expression, is not a mutable target.
        add_diagnostic(checker, "E3027", error_registry.registry_message_formatted("E3027", {"a literal or expression", parameter_description, function_display}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
    }
}

fn check_call_against_sig(checker ^TypeChecker, node ^ast.AstNode, function_name_as_called string, signature ^FuncSig, first_param i64) -> ^types.GrayType {
    if !is_denied_reference(node) { signature^.used = true }
    warn_if_function_deprecated(checker, node, signature)
    mut function_name = shown_function_name(signature, function_name_as_called)
    // A module function called by its bare name (`using`) is shown as the program wrote it
    if node^.call^.function^.kind == ast.NodeKind.LABEL && node^.call^.function^.label^.written_name != "" && node^.call^.function^.label^.qualifier == "" { function_name = node^.call^.function^.label^.written_name }
    if len(node^.call^.arg_names) > 0 && signature^.decl != nil {
        resolve_named_arguments(checker, node, signature^.decl, function_name, first_param)
    }
    arguments = node^.call^.args
    total = len(signature^.param_types) - first_param
    mut min_args = signature^.min_args - first_param
    if min_args < 0 { min_args = 0 }

    if len(arguments) < min_args || len(arguments) > total {
        mut expected_count = "${total}"
        if min_args != total { expected_count = "${min_args} to ${total}" }
        message = error_registry.registry_message_formatted("E5008", {function_name, expected_count, "${len(arguments)}"})
        add_diagnostic(checker, "E5008", message, node^.tok.file, node^.tok.line, node^.tok.col)
    }

    handled = call_handled_flags(signature, len(arguments), first_param)
    mut generic_return ^types.GrayType = nil
    if signature^.is_generic {
        generic_return = check_generic_call(checker, node, function_name, signature, first_param)
    }

    for i in range(0, len(arguments)) {
        if handled[i] { continue }
        mut param_expected ^types.GrayType = nil
        if i < total { param_expected = signature^.param_types[i + first_param] }
        arg_t = check_expression_as(checker, arguments[i], param_expected)
        reject_multi_return_in_single_position(checker, arguments[i])
        if i < total {
            check_call_argument(checker, arguments[i], i + first_param, function_name, signature^.param_types[i + first_param], arg_t)
            if i + first_param < len(signature^.param_mutable) && signature^.param_mutable[i + first_param] && signature^.decl != nil {
                check_mutable_argument(checker, arguments[i], "mutable parameter '${signature^.decl^.params[i + first_param].name}'", function_name)
                // A fixed-size struct field passed by mutable reference into a plain `[T]`
                // parameter loses its fixed-ness there; checked one level deep, by whether the
                // callee runs a length-changing arrays call directly on that parameter
                if arguments[i]^.kind == ast.NodeKind.MEMBER_EXPR && member_expression_fixed_array_field_size(checker, arguments[i]) > 0 {
                    offending_function = body_mutates_array_parameter(checker, signature^.decl^.body, signature^.decl^.params[i + first_param].name)
                    if offending_function != "" {
                        add_diagnostic(checker, "E5051", error_registry.registry_message_formatted("E5051", {offending_function, arguments[i]^.member^.member}), arguments[i]^.tok.file, arguments[i]^.tok.line, arguments[i]^.tok.col)
                    }
                }
            }
        }
    }

    if generic_return != nil { return generic_return }
    if len(signature^.return_types) > 0 { return signature^.return_types[0] }
    return checker^.pool^.type_void
}

// Resolves every argument for its own diagnostics and yields `unknown`; used for call shapes
// whose signature is not checked (builtins, stdlib and module functions).
fn is_printf_function_name(name string) -> bool {
    return name == "printf" || name == "printfln" || name == "eprintf" || name == "eprintfln" ||
           name == "sprintf" || name == "sprintfln"
}

// True for `fmt.sprintf(...)` and the other printf-family calls, whose braced
// argument list is one value per directive and so may mix types.
fn is_printf_call(checker ^TypeChecker, node ^ast.AstNode) -> bool {
    callee = node^.call^.function
    // A bare printf-family name reached through `using fmt`
    if callee^.kind == ast.NodeKind.LABEL {
        return is_printf_function_name(callee^.label^.value) && arrays.contains(checker^.using_modules, "fmt") && find_func(checker, callee^.label^.value) == nil
    }
    if callee^.kind != ast.NodeKind.MEMBER_EXPR || callee^.member^.object^.kind != ast.NodeKind.LABEL { return false }
    if resolve_import_alias(checker, callee^.member^.object^.label^.value) != "fmt" { return false }
    return is_printf_function_name(callee^.member^.member)
}

// Resolves every argument and yields their types. A printf-family call's
// braced value list is checked element by element and contributes an unknown.
#[discard]
fn resolve_call_arg_types(checker ^TypeChecker, node ^ast.AstNode) -> [^types.GrayType] {
    printf_call = is_printf_call(checker, node)
    callee_node = node^.call^.function
    takes_range_argument = callee_node^.kind == ast.NodeKind.LABEL && (callee_node^.label^.value == "type_of" || callee_node^.label^.value == "len")
    mut arg_types [^types.GrayType] = {}
    for_each arg in node^.call^.args {
        if takes_range_argument { allow_range_use(checker, arg) }
        if printf_call && arg^.kind == ast.NodeKind.ARRAY_VALUE {
            for_each element in arg^.array_value^.elements {
                resolve_expression(checker, element)
            }
            arrays.append(arg_types, checker^.pool^.type_unknown)
            continue
        }
        arrays.append(arg_types, resolve_expression(checker, arg))
    }
    return arg_types
}

fn is_conversion_builtin_name(name string) -> bool {
    return arrays.contains({"bool", "char", "string", "f32", "f64", "i8", "i16", "i32", "i64", "i128", "i256", "u8", "u16", "u32", "u64", "u128", "u256"}, name)
}

// True when a value of this type can never be converted by string(), bool() or a
// wide-integer constructor: aggregates, pointers, nil and tagged enums.
fn is_unconvertible_kind(checker ^TypeChecker, source_type ^types.GrayType) -> bool {
    kind = source_type^.kind
    if kind == types.TypeKind.ARRAY || kind == types.TypeKind.MAP || kind == types.TypeKind.STRUCT || kind == types.TypeKind.POINTER || kind == types.TypeKind.NIL_TYPE { return true }
    return kind == types.TypeKind.ENUM && enum_is_tagged(checker, source_type^.name)
}

// The conversion builtins named after their result type: string(x), bool(x), the
// wide-integer constructors, and the narrow ones that are only casts
//.
fn resolve_conversion_call(checker ^TypeChecker, node ^ast.AstNode, name string) -> ^types.GrayType {
    result = checker_type_from_name(checker, name)
    arguments = node^.call^.args
    is_wide = name == "i128" || name == "u128" || name == "i256" || name == "u256"
    if len(arguments) == 1 && is_wide {
        mut source_type ^types.GrayType = nil
        if folding.is_literal_expression(arguments[0]) {
            source_type = check_expression_as(checker, arguments[0], result)
        } otherwise {
            source_type = resolve_expression(checker, arguments[0])
        }
        if is_unconvertible_kind(checker, source_type) || source_type^.kind == types.TypeKind.STRING || source_type^.kind == types.TypeKind.BOOL {
            add_diagnostic_help(checker, "E3043", "cannot convert ${shown_type(checker, source_type)} to ${name}; only numeric types can be converted", "only numeric conversions are supported", node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return result
    }
    if len(arguments) == 1 && name == "string" {
        source_type = resolve_expression(checker, arguments[0])
        reject_void_in_context(checker, arguments[0], source_type, "a 'string()' argument")
        if source_type^.kind == types.TypeKind.STRING || is_unconvertible_kind(checker, source_type) {
            mut string_help = "use string interpolation or access individual elements"
            if source_type^.kind == types.TypeKind.STRING { string_help = "value is already a string" }
            add_diagnostic_help(checker, "E3043", error_registry.registry_message_formatted("E3043", {shown_type(checker, source_type), "string"}), string_help, node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return result
    }
    if len(arguments) == 1 && name == "bool" {
        source_type = resolve_expression(checker, arguments[0])
        if source_type^.kind == types.TypeKind.STRING || is_unconvertible_kind(checker, source_type) {
            add_diagnostic_help(checker, "E3043", error_registry.registry_message_formatted("E3043", {shown_type(checker, source_type), "bool"}), "only numeric types and bools can be converted", node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return result
    }
    if !is_wide && name != "string" && name != "bool" {
        add_diagnostic(checker, "E5036", error_registry.registry_message_formatted("E5036", {name, name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return result
    }
    add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {name, "1", "${len(arguments)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
    return result
}

// The nearest module this file imports, within an edit distance of 2, or "".
fn suggest_similar_module(checker ^TypeChecker, name string) -> string {
    mut best = ""
    mut best_distance i64 = SUGGESTION_DISTANCE_LIMIT
    for_each entry in checker^.imports {
        if !import_in_current_file(checker, entry) { continue }
        distance = suggest.edit_distance(name, entry.mod_name)
        if distance > 0 && distance < best_distance {
            best_distance = distance
            best = entry.mod_name
        }
    }
    return best
}

// True when the file being checked imports the module `name`.
fn is_imported_module_name(checker ^TypeChecker, name string) -> bool {
    for_each entry in checker^.imports {
        if entry.mod_name == name && import_in_current_file(checker, entry) { return true }
    }
    return false
}

// True when `name` is how this program spells an imported stdlib module.
fn is_stdlib_module_reference(checker ^TypeChecker, name string) -> bool {
    module_name = resolve_import_alias(checker, name)
    return reserved.is_stdlib_module_name(module_name) && is_imported_module_name(checker, module_name)
}

// The spelling of the type a size_of() argument names, or "" when it is a value:
// a name bound to a variable is a value, not a type.
fn size_of_type_spelling(checker ^TypeChecker, argument ^ast.AstNode) -> string {
    if argument == nil { return "" }
    if argument^.kind == ast.NodeKind.LABEL {
        if scope.scope_lookup(checker^.current_scope, argument^.label^.value) != nil { return "" }
        return argument^.label^.value
    }
    if argument^.kind == ast.NodeKind.MEMBER_EXPR && argument^.member^.object != nil && argument^.member^.object^.kind == ast.NodeKind.LABEL && is_imported_module_name(checker, argument^.member^.object^.label^.value) {
        return "${argument^.member^.object^.label^.value}.${argument^.member^.member}"
    }
    return ""
}

// Raw(), the whole mem and threads modules, and extern calls are the
// unsafe opt-ins; each must sit inside an `unsafe` block or an unsafe function.
// `operation` is the name as the user wrote it.
fn require_unsafe_context(checker ^TypeChecker, node ^ast.AstNode, operation string) {
    if checker^.unsafe_depth > 0 { return }
    add_diagnostic(checker, "E5065", error_registry.registry_message_formatted("E5065", {operation}), node^.tok.file, node^.tok.line, node^.tok.col)
}

// wrap_add, wrap_sub, wrap_mult and wrap_div: integer arithmetic that wraps
// instead of panicking.
fn is_wrapping_builtin_name(name string) -> bool {
    return name == "wrap_add" || name == "wrap_sub" || name == "wrap_mult" || name == "wrap_div"
}

// The operands type like those of a binary operator: a literal takes the other
// operand's type, and the result is the common type. Only integers wrap, so
// anything else is an error.
fn resolve_wrapping_call(checker ^TypeChecker, node ^ast.AstNode, display_name string) -> ^types.GrayType {
    left_node = node^.call^.args[0]
    right_node = node^.call^.args[1]
    mut left = resolve_untyped(checker, left_node)
    mut right = resolve_untyped(checker, right_node)
    if left^.kind == types.TypeKind.UNKNOWN || right^.kind == types.TypeKind.UNKNOWN { return checker^.pool^.type_unknown }
    left_is_number = left^.kind == types.TypeKind.LITERAL || types.type_kind_is_number(left^.kind)
    right_is_number = right^.kind == types.TypeKind.LITERAL || types.type_kind_is_number(right^.kind)
    mut common ^types.GrayType = nil
    if left_is_number && right_is_number { common = types.type_binary_result(checker^.pool, token.TokenKind.PLUS, left, right) }
    if common != nil {
        if left^.kind == types.TypeKind.LITERAL && right^.kind == types.TypeKind.LITERAL {
            left = check_expression_as(checker, left_node, nil)
            right = check_expression_as(checker, right_node, nil)
        } or left^.kind == types.TypeKind.LITERAL {
            left = check_expression_as(checker, left_node, right)
        } or right^.kind == types.TypeKind.LITERAL {
            right = check_expression_as(checker, right_node, left)
        }
        common = types.type_binary_result(checker^.pool, token.TokenKind.PLUS, left, right)
    }
    if common == nil {
        mut left_shown = left
        if left^.kind == types.TypeKind.LITERAL { left_shown = check_expression_as(checker, left_node, nil) }
        mut right_shown = right
        if right^.kind == types.TypeKind.LITERAL { right_shown = check_expression_as(checker, right_node, nil) }
        if types.type_kind_is_number(left_shown^.kind) && types.type_kind_is_number(right_shown^.kind) {
            add_cast_help_diagnostic(checker, "E3002", error_registry.registry_message_formatted("E3002", {display_name, shown_type(checker, left_shown), shown_type(checker, right_shown)}), node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            add_diagnostic(checker, "E5068", error_registry.registry_message_formatted("E5068", {display_name, shown_type(checker, left_shown), shown_type(checker, right_shown)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return checker^.pool^.type_unknown
    }
    if common^.kind != types.TypeKind.INT && common^.kind != types.TypeKind.UINT {
        add_diagnostic(checker, "E5068", error_registry.registry_message_formatted("E5068", {display_name, shown_type(checker, left), shown_type(checker, right)}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    return common
}

// True when `expression` names a place that has an address: a variable (not a
// type name), or a member, element or dereference of one.
fn is_assignment_target(checker ^TypeChecker, expression ^ast.AstNode) -> bool {
    if expression == nil { return false }
    when expression^.kind {
        is ast.NodeKind.LABEL {
            name = expression^.label^.value
            if types.is_builtin_type_name(name) || is_struct_name(checker, name) || is_enum_name(checker, name) { return false }
            return true
        }
        is ast.NodeKind.MEMBER_EXPR { return is_assignment_target(checker, expression^.member^.object) }
        is ast.NodeKind.INDEX_EXPR { return is_assignment_target(checker, expression^.index_data^.left) }
        is ast.NodeKind.POSTFIX_EXPR { return expression^.postfix^.op == token.TokenKind.CARET }
        default { return false }
    }
}

// Addr()/raw()/ref() of a map or string index has no stable address to
// point at. The container of each index is resolved once, here.
fn reject_unstable_address_target(checker ^TypeChecker, node ^ast.AstNode, argument ^ast.AstNode, builtin_name string) {
    mut action = "take the address of"
    if builtin_name == "ref" { action = "take a reference to" }
    mut has_map_index = false
    mut has_dynamic_array_index = false
    mut has_string_index = false
    mut current = argument
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.POSTFIX_EXPR {
            current = current^.postfix^.left
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            container_type = resolve_expression(checker, current^.index_data^.left)
            if container_type^.kind == types.TypeKind.MAP { has_map_index = true }
            if container_type^.kind == types.TypeKind.STRING { has_string_index = true }
            if container_type^.kind == types.TypeKind.ARRAY && array_index_left_is_dynamic(checker, current^.index_data^.left) { has_dynamic_array_index = true }
            current = current^.index_data^.left
        } otherwise {
            break
        }
    }
    if has_map_index {
        add_diagnostic(checker, "E3161", error_registry.registry_message_formatted("E3161", {builtin_name, action, "a map index expression"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    if has_dynamic_array_index {
        add_diagnostic(checker, "E3161", error_registry.registry_message_formatted("E3161", {builtin_name, action, "a dynamic array index expression"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    if has_string_index {
        add_diagnostic(checker, "E3161", error_registry.registry_message_formatted("E3161", {builtin_name, action, "a string index expression"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// True when `left` indexes a dynamic '[T]' array. A dynamic array's backing store
// relocates on grow, so a pointer to an element dangles after any such call. Fixed-size
// '[T,N]' storage never moves. Only a plain variable reference is inspected for its
// written type; any other index target is treated as dynamic.
fn array_index_left_is_dynamic(checker ^TypeChecker, left ^ast.AstNode) -> bool {
    left_type = resolve_expression(checker, left)
    if left_type^.kind != types.TypeKind.ARRAY { return false }
    if left^.kind == ast.NodeKind.LABEL {
        symbol = scope.scope_lookup(checker^.current_scope, left^.label^.value)
        if symbol != nil && type_has_array_size(symbol^.declared_type) { return false }
    }
    return true
}

// addr(place) and raw(place): a pointer to the place's type.
fn resolve_address_call(checker ^TypeChecker, node ^ast.AstNode, name string) -> ^types.GrayType {
    argument = node^.call^.args[0]
    if name == "raw" { require_unsafe_context(checker, node, "raw()") }
    reject_unstable_address_target(checker, node, argument, name)
    mut argument_type = checker^.pool^.type_unknown
    mut is_resolved = false
    if !is_assignment_target(checker, argument) {
        // A type name used as the operand is reported as a value before the address is refused
        argument_type = resolve_expression(checker, argument)
        is_resolved = true
        add_diagnostic(checker, "E3012", error_registry.registry_message_formatted("E3012", {name, "the address"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    if name == "addr" { report_write_to_module_variable(checker, node, argument) }
    if !is_resolved { argument_type = resolve_expression(checker, argument) }
    return types.type_pointer(checker^.pool, types.type_display_name(argument_type))
}

// type_of(x): one argument, a value or a builtin type name.
fn resolve_type_of_call(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    // Type_of() requires exactly 1 argument
    if len(node^.call^.args) != 1 {
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"type_of", "1", "${len(node^.call^.args)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        resolve_call_args_only(checker, node)
        return checker^.pool^.type_string
    }
    argument = node^.call^.args[0]
    allow_range_use(checker, argument)
    if argument^.kind == ast.NodeKind.LABEL {
        argument_name = argument^.label^.value
        // Type_of() with a type name instead of a value
        if scope.scope_lookup(checker^.current_scope, argument_name) == nil && (is_struct_name(checker, argument_name) || is_enum_name(checker, argument_name)) {
            add_diagnostic(checker, "E3084", error_registry.registry_message_formatted("E3084", {argument_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_string
        }
        // A bare builtin type name is answered from the name itself: resolving it
        // as an expression would report it as a type name used as a value.
        if scope.scope_lookup(checker^.current_scope, argument_name) == nil && types.is_builtin_type_name(argument_name) {
            base_type = checker_type_from_name(checker, argument_name)
            if base_type^.kind != types.TypeKind.UNKNOWN {
                argument^.resolved_type = types.type_display_name(base_type)
                return checker^.pool^.type_string
            }
        }
    }
    argument_type = resolve_expression(checker, argument)
    if argument_type^.kind == types.TypeKind.VOID {
        add_diagnostic(checker, "E3187", error_registry.registry_message_formatted("E3187", {"the argument of type_of()"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    return checker^.pool^.type_string
}

// A builtin call: arguments are resolved, and the builtins whose result type
// does not depend on their arguments report it. The rest stay unknown.
// True for the builtins whose arguments are plain scalars checked one by one.
fn is_scalar_argument_builtin(name string) -> bool {
    return name == "to_char" || name == "char_count" || name == "to_c_string" || name == "char" ||
           name == "exit" || name == "panic" || name == "assert" || name == "system" ||
           name == "sleep_s" || name == "sleep_ms" || name == "sleep_ns"
}

// True for an integer literal expression: a number, a sign, or arithmetic on those.
fn is_integer_literal_expression(node ^ast.AstNode) -> bool {
    if node^.kind == ast.NodeKind.INT_VALUE { return true }
    if node^.kind == ast.NodeKind.PREFIX_EXPR { return is_integer_literal_expression(node^.prefix^.right) }
    if node^.kind == ast.NodeKind.INFIX_EXPR { return is_integer_literal_expression(node^.infix^.left) && is_integer_literal_expression(node^.infix^.right) }
    return false
}

// Reports an error unless argument `index` (1-based) of `callee` has the kind `want`:
// "string", "bool" or "integer"; `expected` is how the message spells it.
fn check_scalar_argument(checker ^TypeChecker, argument ^ast.AstNode, argument_type ^types.GrayType, index i64, callee string, want string, expected string) {
    if argument_type^.kind == types.TypeKind.UNKNOWN { return }
    mut matches bool = false
    when want {
        is "string" { matches = argument_type^.kind == types.TypeKind.STRING }
        is "bool" { matches = argument_type^.kind == types.TypeKind.BOOL }
        default { matches = is_int_kind(argument_type^.kind) }
    }
    if !matches || argument_type^.distinct_name != "" {
        report_argument_type(checker, argument, index, callee, expected, shown_type(checker, argument_type))
    }
}

// from_c_string(pointer): copies a C string into a Grayscale string.
fn resolve_from_c_string(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    arguments = node^.call^.args
    if len(arguments) != 1 {
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"from_c_string", "1", "${len(arguments)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        for_each argument in arguments { resolve_expression(checker, argument) }
        return checker^.pool^.type_string
    }
    argument_type = resolve_expression(checker, arguments[0])
    if argument_type^.kind != types.TypeKind.POINTER && argument_type^.kind != types.TypeKind.UNKNOWN && argument_type^.kind != types.TypeKind.C_FUNCTION {
        add_diagnostic(checker, "E3083", error_registry.registry_message_formatted("E3083", {shown_type(checker, argument_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    // A C call result has no Grayscale type, so it passes the check above. Assert it is a
    // pointer for the driver to verify against the C function's real return type, directly
    // or through a variable inferred from the call.
    if argument_type^.kind == types.TypeKind.C_FUNCTION {
        c_argument = arguments[0]
        mut origin ^ast.AstNode = c_argument
        if c_argument^.kind == ast.NodeKind.LABEL {
            c_symbol = scope.scope_lookup(checker^.current_scope, c_argument^.label^.value)
            origin = nil
            if c_symbol != nil { origin = c_symbol^.c_call }
        }
        if origin != nil { extern_call_assert_type(checker, origin, types.type_pointer(checker^.pool, "u8"), false) }
    }
    return checker^.pool^.type_string
}

// to_char, char_count, to_c_string, char, exit, panic, assert, system and the
// sleeps: argument count and type, plus the constant ranges of
// char() and the to_char() index.
fn resolve_scalar_argument_builtin(checker ^TypeChecker, node ^ast.AstNode, name string) -> ^types.GrayType {
    arguments = node^.call^.args
    count i64 = len(arguments)
    arity i64 = -1
    if name == "to_char" { arity = 2 }
    if name == "char_count" || name == "to_c_string" || name == "system" || name == "char" { arity = 1 }
    mut result ^types.GrayType = checker^.pool^.type_void
    if name == "to_char" || name == "char" { result = checker^.pool^.type_char }
    if name == "char_count" || name == "system" { result = checker^.pool^.type_i64 }
    if name == "to_c_string" { result = types.type_pointer(checker^.pool, "u8") }
    if arity >= 0 && count != arity {
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {name, "${arity}", "${count}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        for_each argument in arguments { resolve_expression(checker, argument) }
        return result
    }
    if count == 0 { return result }

    if name == "char" {
        if is_integer_literal_expression(arguments[0]) {
            value, folded, _ = fold_const_integer(checker, arguments[0])
            if folded && (value < 0 || value > MAX_CODEPOINT || (value >= SURROGATE_MIN && value <= SURROGATE_MAX)) {
                add_diagnostic(checker, "E7014", error_registry.registry_message_formatted("E7014", {"${value}"}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
        argument_type = resolve_expression(checker, arguments[0])
        if !is_int_kind(argument_type^.kind) && argument_type^.kind != types.TypeKind.CHAR {
            report_argument_type(checker, node, 1, "char", "an integer codepoint", shown_type(checker, argument_type))
        }
        return result
    }
    if name == "exit" || name == "sleep_s" || name == "sleep_ms" || name == "sleep_ns" {
        argument_type = check_expression_as(checker, arguments[0], checker^.pool^.type_i64)
        check_scalar_argument(checker, node, argument_type, 1, name, "integer", "an integer")
        return result
    }
    if name == "assert" {
        condition_type = resolve_expression(checker, arguments[0])
        check_scalar_argument(checker, node, condition_type, 1, "assert", "bool", "a bool")
        if count >= 2 {
            message_type = resolve_expression(checker, arguments[1])
            check_scalar_argument(checker, node, message_type, 2, "assert", "string", "a string")
        }
        return result
    }
    first_type = resolve_expression(checker, arguments[0])
    check_scalar_argument(checker, node, first_type, 1, name, "string", "a string")
    if name == "to_char" {
        second_type = resolve_expression(checker, arguments[1])
        if !is_int_kind(second_type^.kind) {
            report_argument_type(checker, node, 2, "to_char", "an integer", shown_type(checker, second_type))
        } otherwise {
            index_value, folded, _ = fold_const_integer(checker, arguments[1])
            if folded {
                mut characters i64 = -1
                if arguments[0]^.kind == ast.NodeKind.STRING_VALUE && !strings.contains(arguments[0]^.string_value^.value, "\\") {
                    characters = char_count(arguments[0]^.string_value^.value)
                }
                if index_value < 0 || (characters >= 0 && index_value >= characters) {
                    mut index_help = "the index cannot be negative"
                    if characters >= 0 { index_help = "the string has ${characters} characters" }
                    add_diagnostic_help(checker, "E5063", error_registry.registry_message_formatted("E5063", {"${index_value}"}), index_help, arguments[1]^.tok.file, arguments[1]^.tok.line, arguments[1]^.tok.col)
                }
            }
        }
    }
    return result
}

fn resolve_builtin_call(checker ^TypeChecker, node ^ast.AstNode, name string) -> ^types.GrayType {
    // Named arguments are not supported for builtins
    for_each argument_name in node^.call^.arg_names {
        if argument_name != "" {
            add_diagnostic(checker, "E5034", error_registry.registry_message_formatted("E5034", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
            break
        }
    }
    // Here() takes no arguments
    if name == "here" && len(node^.call^.args) != 0 {
        add_diagnostic(checker, "E5014", error_registry.registry_message("E5014"), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    if name == "size_of" {
        if len(node^.call^.args) != 1 {
            add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"size_of", "1", "${len(node^.call^.args)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_i64
        }
        argument = node^.call^.args[0]
        mut argument_symbol ^scope.Symbol = nil
        if argument^.kind == ast.NodeKind.LABEL { argument_symbol = scope.scope_lookup(checker^.current_scope, argument^.label^.value) }
        if argument_symbol != nil && argument_symbol^.sym_type^.kind == types.TypeKind.RANGE {
            add_diagnostic(checker, "E3205", error_registry.registry_message("E3205"), argument^.tok.file, argument^.tok.line, argument^.tok.col)
            return checker^.pool^.type_i64
        }
        written = size_of_type_spelling(checker, argument)
        if written == "" {
            add_diagnostic(checker, "E5069", error_registry.registry_message("E5069"), argument^.tok.file, argument^.tok.line, argument^.tok.col)
            resolve_quietly(checker, argument)
            return checker^.pool^.type_i64
        }
        // A type parameter is checked where its argument is named; codegen sizes
        // whatever it is bound to in each instantiation.
        if ast.generic_bindings_find(checker^.generics, written) < 0 {
            reject_error_in_container(checker, argument, written)
            reject_void_type(checker, argument, written, "a type argument of 'size_of()'")
            undefined_leaf = undefined_type_leaf(checker, written)
            if undefined_leaf != "" {
                add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {unqualified_display_name(undefined_leaf)}), node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                // Normalize every spelling to the one shape codegen's type path
                // understands: a label holding the registry name.
                resolved = resolve_type_alias(checker, written)
                warn_if_type_name_deprecated(checker, argument, resolved, "")
                if argument^.kind != ast.NodeKind.LABEL || resolved != written {
                    label_data = new(ast.LabelData)
                    label_data^.value = resolved
                    label_node = ast.ast_alloc(ast.NodeKind.LABEL, argument^.tok)
                    label_node^.label = label_data
                    node^.call^.args[0] = label_node
                }
            }
        }
        return checker^.pool^.type_i64
    }
    // `ref(place)` is a transparent reference: it has the place's own type
    if name == "ref" && len(node^.call^.args) == 1 {
        place = node^.call^.args[0]
        is_function_label bool = place^.kind == ast.NodeKind.LABEL && scope.scope_lookup(checker^.current_scope, place^.label^.value) == nil && find_func(checker, place^.label^.value) != nil
        // ref(Struct.function)
        is_struct_function bool = place^.kind == ast.NodeKind.MEMBER_EXPR && place^.member^.object^.kind == ast.NodeKind.LABEL && scope.scope_lookup(checker^.current_scope, place^.member^.object^.label^.value) == nil && is_struct_name(checker, place^.member^.object^.label^.value) && find_func(checker, "${place^.member^.object^.label^.value}_${place^.member^.member}") != nil
        if is_function_label || is_struct_function {
            // ref(function) is the function reference, typed like `()function`
            reference_data = new(ast.FuncRefData)
            reference_data^.function = place
            reference_node = ast.ast_alloc(ast.NodeKind.FUNC_REF, node^.tok)
            reference_node^.func_ref = reference_data
            return resolve_func_ref(checker, reference_node)
        }
        // Same assignment target requirement as addr(): no literals, call
        // results or arithmetic.
        reject_unstable_address_target(checker, node, place, "ref")
        if !is_assignment_target(checker, place) {
            add_diagnostic(checker, "E3012", error_registry.registry_message_formatted("E3012", {"ref", "a reference"}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        // A pointer type that keeps the full source type; a variable bound to it reads
        // through it again (Symbol.is_ref)
        place_type = resolve_expression(checker, place)
        mut pointee_name = types.type_display_name(place_type)
        if place_type^.kind == types.TypeKind.ARRAY {
            pointee_name = "[${place_type^.element_type}]"
        } or place_type^.kind == types.TypeKind.MAP {
            pointee_name = place_type^.name
        }
        return types.type_pointer(checker^.pool, pointee_name)
    }
    if name == "error" { return resolve_error_call(checker, node) }
    if name == "type_of" { return resolve_type_of_call(checker, node) }
    if (name == "addr" || name == "raw") && len(node^.call^.args) == 1 { return resolve_address_call(checker, node, name) }
    if is_wrapping_builtin_name(name) {
        require_unsafe_context(checker, node, "${name}()")
        if len(node^.call^.args) != 2 {
            add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {name, "2", "${len(node^.call^.args)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }
        return resolve_wrapping_call(checker, node, "${name}()")
    }
    if name == "len" { return resolve_len_call(checker, node) }
    if name == "fields" {
        if len(node^.call^.args) != 1 {
            resolve_call_args_only(checker, node)
            add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"fields", "1", "${len(node^.call^.args)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
            return types.type_array(checker^.pool, "string")
        }
        // A type name, bare or written through a module (`mod.Type`), where an
        // instance is needed. A local named like the module makes `x.f` a field access.
        fields_argument = node^.call^.args[0]
        mut argument_name = ""
        mut registry_name = ""
        if fields_argument^.kind == ast.NodeKind.LABEL {
            argument_name = fields_argument^.label^.value
            registry_name = argument_name
            if fields_argument^.label^.qualifier != "" {
                argument_name = "${fields_argument^.label^.qualifier}.${fields_argument^.label^.qualified_member}"
            }
        }
        if argument_name != "" {
            argument_symbol = scope.scope_lookup(checker^.current_scope, registry_name)
            resolved_name = resolve_type_alias(checker, registry_name)
            if argument_symbol == nil && (is_struct_name(checker, resolved_name) || is_enum_name(checker, resolved_name)) {
                add_diagnostic_help(checker, "E5043", error_registry.registry_message_formatted("E5043", {argument_name}), "a type name was passed; use 'fields(instance)' instead", node^.tok.file, node^.tok.line, node^.tok.col)
                return types.type_array(checker^.pool, "string")
            }
        }
        mut argument_type = resolve_expression(checker, fields_argument)
        // A pointer to a struct reads through
        if argument_type^.kind == types.TypeKind.POINTER && argument_type^.element_type != "" && is_struct_name(checker, argument_type^.element_type) {
            argument_type = checker_type_from_name(checker, argument_type^.element_type)
        }
        if argument_type^.kind != types.TypeKind.STRUCT && argument_type^.kind != types.TypeKind.UNKNOWN {
            add_diagnostic(checker, "E5043", error_registry.registry_message_formatted("E5043", {shown_type(checker, argument_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return types.type_array(checker^.pool, "string")
    }
    if name == "copy" && len(node^.call^.args) == 1 {
        copied_type = resolve_expression(checker, node^.call^.args[0])
        if copied_type^.kind == types.TypeKind.FUNCTION {
            add_diagnostic(checker, "E5029", error_registry.registry_message("E5029"), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }
        if copied_type^.kind == types.TypeKind.POINTER {
            add_diagnostic(checker, "E5037", error_registry.registry_message("E5037"), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }
        handle_name = handle_type_in_copied_type(checker, copied_type, 0)
        if handle_name != "" {
            add_diagnostic(checker, "E5070", error_registry.registry_message_formatted("E5070", {handle_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }
        return copied_type
    }    if is_scalar_argument_builtin(name) { return resolve_scalar_argument_builtin(checker, node, name) }
    if name == "from_c_string" { return resolve_from_c_string(checker, node) }
    if name == "flush" {
        if len(node^.call^.args) != 0 {
            add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"flush", "0", "${len(node^.call^.args)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        resolve_call_args_only(checker, node)
        return checker^.pool^.type_void
    }
    if (name == "print" || name == "println" || name == "eprint" || name == "eprintln") && len(node^.call^.args) == 1 {
        print_type = resolve_expression(checker, node^.call^.args[0])
        reject_multi_return_in_single_position(checker, node^.call^.args[0])
        if print_type^.kind == types.TypeKind.C_FUNCTION {
            add_diagnostic(checker, "E3168", error_registry.registry_message("E3168"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if print_type^.kind == types.TypeKind.FUNCTION {
            add_diagnostic(checker, "E5028", error_registry.registry_message_formatted("E5028", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if print_type^.kind == types.TypeKind.ENUM && print_type^.name != "" && enum_is_tagged(checker, print_type^.name) {
            add_diagnostic(checker, "E5038", error_registry.registry_message_formatted("E5038", {enum_display_name(checker, print_type^.name), name}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if print_type^.kind != types.TypeKind.ENUM {
            nested_tagged_enum = tagged_enum_in_printed_type(checker, print_type, 0)
            if nested_tagged_enum != "" {
                add_diagnostic(checker, "E5038", error_registry.registry_message_formatted("E5038", {enum_display_name(checker, nested_tagged_enum), name}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
        reject_void_in_context(checker, node^.call^.args[0], print_type, "'${name}()' argument")
        return checker^.pool^.type_void
    }
    if name == "embed" { return resolve_embed_call(checker, node) }
    resolve_call_args_only(checker, node)
    if name == "len" || name == "char_count" || name == "size_of" { return checker^.pool^.type_i64 }
    if name == "type_of" || name == "input" { return checker^.pool^.type_string }
    if name == "to_char" { return checker^.pool^.type_char }
    if name == "fields" { return types.type_array(checker^.pool, "string") }
    if name == "here" { return checker_type_from_name(checker, "SourceLocation") }
    return checker^.pool^.type_unknown
}

// The handle type a copied value reaches through struct fields, array elements or map
// values, or "". A handle shares its state with every copy; a pointer is not followed,
// as copy() leaves it aliased.
fn handle_type_in_copied_type(checker ^TypeChecker, copied_type ^types.GrayType, depth i64) -> string {
    if copied_type == nil || depth > MAX_TYPE_DISPLAY_DEPTH { return "" }
    if copied_type^.kind == types.TypeKind.ARRAY && copied_type^.element_type != "" {
        return handle_type_in_copied_type(checker, checker_type_from_name(checker, copied_type^.element_type), depth + 1)
    }
    if copied_type^.kind == types.TypeKind.MAP && copied_type^.value_type != "" {
        return handle_type_in_copied_type(checker, checker_type_from_name(checker, copied_type^.value_type), depth + 1)
    }
    if copied_type^.kind != types.TypeKind.STRUCT || copied_type^.name == "" { return "" }
    handle_names [string] = {"Builder", "Channel", "Mutex", "SpinLock", "Thread", "Database", "Router", "Socket", "Listener", "Arena"}
    for_each handle_name in handle_names {
        if copied_type^.name == handle_name { return handle_name }
    }
    struct_info = find_struct(checker, copied_type^.name)
    if struct_info == nil { return "" }
    for_each field_type in struct_info^.field_types {
        found = handle_type_in_copied_type(checker, field_type, depth + 1)
        if found != "" { return found }
    }
    return ""
}

// error(code ErrorCode, message string = ""): the code is an ErrorCode or a
// #error_code enum value, the message a string. Returns Error.
fn resolve_error_call(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    result = checker_type_from_name(checker, "Error")
    arguments = node^.call^.args
    if len(arguments) < 1 || len(arguments) > 2 {
        resolve_call_args_only(checker, node)
        add_diagnostic(checker, "E5008", "'error()' expects 1 or 2 argument(s), got ${len(arguments)}", node^.tok.file, node^.tok.line, node^.tok.col)
        return result
    }
    code_arg = arguments[0]
    code_type = check_expression_as(checker, code_arg, checker_type_from_name(checker, "ErrorCode"))
    is_code = code_type^.kind == types.TypeKind.ENUM && enum_is_error_code(checker, code_type^.name)
    is_extern = code_arg^.kind == ast.NodeKind.MEMBER_EXPR && ast.ast_member_qualifier(code_arg) == "extern"
    if is_extern || (!is_code && code_type^.kind != types.TypeKind.UNKNOWN) {
        mut actual = "'${shown_type(checker, code_type)}'"
        if is_extern { actual = "'extern.${code_arg^.member^.member}', a C interop constant" }
        arg_type_error(checker, code_arg, fmt.sprintf("argument 1 of 'error': expected an ErrorCode, got %s", {actual}))
    }
    if len(arguments) == 2 {
        message_type = resolve_expression(checker, arguments[1])
        if message_type^.kind != types.TypeKind.STRING && message_type^.kind != types.TypeKind.UNKNOWN {
            arg_type_error(checker, arguments[1], fmt.sprintf("argument 2 of 'error': expected a string, got '%s'", {shown_type(checker, message_type)}))
        }
    }
    return result
}

#[discard]
fn resolve_call_args_only(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    resolve_call_arg_types(checker, node)
    return checker^.pool^.type_unknown
}

// The registry entry for `module.function(...)` when the callee names a
// stdlib module that is not shadowed by a local, otherwise nil.
fn stdlib_call_sig(checker ^TypeChecker, node ^ast.AstNode) -> ^stdlib_sigs.StdlibSig {
    callee = node^.call^.function
    if callee^.kind != ast.NodeKind.MEMBER_EXPR || callee^.member^.object^.kind != ast.NodeKind.LABEL { return nil }
    obj_name = callee^.member^.object^.label^.value
    if scope.scope_lookup(checker^.current_scope, obj_name) != nil { return nil }
    module_name = resolve_import_alias(checker, obj_name)
    if !reserved.is_stdlib_module_name(module_name) { return nil }
    key = "${module_name}.${callee^.member^.member}"
    if !maps.contains_key(checker^.stdlib_signatures, key) { return nil }
    entry = checker^.stdlib_signatures[key]
    found = new(stdlib_sigs.StdlibSig)
    found^ = entry
    return found
}

// True when two map types name the same key and value types.
fn map_types_match(left ^types.GrayType, right ^types.GrayType) -> bool {
    return left^.key_type == right^.key_type && left^.value_type == right^.value_type
}

// True when an argument kind is checked against a type derived from argument 0.
fn kind_is_slot_of_first(kind string) -> bool {
    return kind == "ELEMENT_OF_FIRST" || kind == "SAME_AS_FIRST" || kind == "KEY_OF_FIRST" || kind == "VALUE_OF_FIRST"
}

// True when an argument of type `actual` is accepted where the registry expects
// `kind`.
fn argument_kind_matches(kind string, actual ^types.GrayType) -> bool {
    if actual^.kind == types.TypeKind.UNKNOWN { return true }
    // A distinct type is not its target: a primitive parameter takes only the
    // plain type. A slot taken from another argument is checked against that
    // argument's type instead.
    is_distinct_allowed = kind == "ANY" || kind == "COMMON_NUMBER" || kind == "GENERIC_NUMBER"
    if actual^.distinct_name != "" && !is_distinct_allowed && !kind_is_slot_of_first(kind) { return false }
    is_number = actual^.kind == types.TypeKind.INT || actual^.kind == types.TypeKind.UINT || actual^.kind == types.TypeKind.FLOAT
    when kind {
        is "STRING" { return actual^.kind == types.TypeKind.STRING }
        is "I64", "U64" { return actual^.kind == types.TypeKind.INT || actual^.kind == types.TypeKind.UINT }
        is "F64" { return actual^.kind == types.TypeKind.FLOAT }
        is "BOOL" { return actual^.kind == types.TypeKind.BOOL }
        is "ARRAY" { return actual^.kind == types.TypeKind.ARRAY }
        is "MAP" { return actual^.kind == types.TypeKind.MAP }
        is "ANY" { return true }
        is "NUMBER", "F64_NUMBER", "GENERIC_NUMBER", "COMMON_NUMBER" { return is_number }
        is "CHAR" { return actual^.kind == types.TypeKind.CHAR }
        is "CHANNEL" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Channel" }
        is "BUILDER" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Builder" }
        is "UUID" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "UUID" }
        is "MUTEX" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Mutex" }
        is "THREAD" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Thread" }
        is "SPINLOCK" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "SpinLock" }
        is "ARENA" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Arena" }
        is "DATABASE" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Database" }
        is "ROUTER" { return actual^.kind == types.TypeKind.STRUCT && actual^.name == "Router" }
        is "POINTER" { return actual^.kind == types.TypeKind.POINTER }
        is "U8_ARRAY" { return actual^.kind == types.TypeKind.ARRAY && actual^.element_type == "u8" }
        is "STRING_MAP" { return actual^.kind == types.TypeKind.MAP && actual^.key_type == "string" && actual^.value_type == "string" }
        is "STRING_ARRAY" { return actual^.kind == types.TypeKind.ARRAY && actual^.element_type == "string" }
        is "CHAR_ARRAY" { return actual^.kind == types.TypeKind.ARRAY && actual^.element_type == "char" }
        is "STRING_GRID" { return actual^.kind == types.TypeKind.ARRAY && actual^.element_type == "[string]" }
        is "STRING_MAP_ARRAY" { return actual^.kind == types.TypeKind.ARRAY && actual^.element_type == "map[string:string]" }
        // The atomic operations read and write exactly 8 bytes as an int64.
        is "I64_POINTER" { return actual^.kind == types.TypeKind.POINTER && actual^.element_type == "i64" }
        default { return true }
    }
}

// How an expected argument kind is spelled in an error.
fn expected_kind_name(kind string) -> string {
    when kind {
        is "STRING" { return "string" }
        is "I64" { return "integer" }
        is "U64" { return "u64" }
        is "F64" { return "f64" }
        is "BOOL" { return "bool" }
        is "ARRAY" { return "array" }
        is "MAP" { return "map" }
        is "ANY" { return "any" }
        is "NUMBER", "F64_NUMBER", "GENERIC_NUMBER", "COMMON_NUMBER" { return "number" }
        is "CHAR" { return "char" }
        is "CHANNEL" { return "Channel" }
        is "BUILDER" { return "Builder" }
        is "UUID" { return "UUID" }
        is "U8_ARRAY" { return "[u8]" }
        is "STRING_MAP" { return "map[string:string]" }
        is "STRING_ARRAY" { return "[string]" }
        is "CHAR_ARRAY" { return "[char]" }
        is "STRING_GRID" { return "[[string]]" }
        is "STRING_MAP_ARRAY" { return "[map[string:string]]" }
        is "MUTEX" { return "Mutex" }
        is "THREAD" { return "Thread" }
        is "SPINLOCK" { return "SpinLock" }
        is "ARENA" { return "Arena" }
        is "DATABASE" { return "Database" }
        is "ROUTER" { return "Router" }
        is "POINTER" { return "a pointer" }
        is "I64_POINTER" { return "^i64" }
        is "TYPE" { return "a type name" }
        is "ELEMENT_OF_FIRST" { return "an element of the array" }
        is "SAME_AS_FIRST" { return "an array of the same type" }
        is "KEY_OF_FIRST" { return "a key of the map" }
        is "VALUE_OF_FIRST" { return "a value of the map" }
        default { return "unknown" }
    }
}

// Does `name` name a type that exists? A `generic` or type argument has to name
// one: value resolution is skipped for type arguments, so this is the only thing
// standing between a mistyped name and codegen.
fn type_argument_names_a_type(checker ^TypeChecker, name string) -> bool {
    if name == "" { return false }
    if is_struct_name(checker, name) || is_enum_name(checker, name) { return true }
    if types.is_builtin_type_name(name) && checker_type_from_name(checker, name)^.kind != types.TypeKind.UNKNOWN { return true }
    resolved = resolve_type_alias(checker, name)
    if resolved == name { return false }
    return is_struct_name(checker, resolved) || is_enum_name(checker, resolved) || checker_type_from_name(checker, resolved)^.kind != types.TypeKind.UNKNOWN
}

// The array type a stdlib call's elements are checked against: argument 0's
// element type, or unknown.
fn array_element_of(checker ^TypeChecker, array_type ^types.GrayType) -> ^types.GrayType {
    if array_type^.kind == types.TypeKind.ARRAY && array_type^.element_type != "" { return checker_type_from_name(checker, array_type^.element_type) }
    return checker^.pool^.type_unknown
}

fn map_key_of(checker ^TypeChecker, map_type ^types.GrayType) -> ^types.GrayType {
    if map_type^.kind == types.TypeKind.MAP && map_type^.key_type != "" { return checker_type_from_name(checker, map_type^.key_type) }
    return checker^.pool^.type_unknown
}

fn map_value_of(checker ^TypeChecker, map_type ^types.GrayType) -> ^types.GrayType {
    if map_type^.kind == types.TypeKind.MAP && map_type^.value_type != "" { return checker_type_from_name(checker, map_type^.value_type) }
    return checker^.pool^.type_unknown
}

// Argument `argument_number` of `callee` has the wrong type.
fn report_argument_type(checker ^TypeChecker, argument ^ast.AstNode, argument_number i64, callee string, expected string, got string) {
    add_diagnostic(checker, "E5026", error_registry.registry_message_formatted("E5026", {"${argument_number}", callee, expected, got}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
}

// The stdlib call's arguments, each resolved exactly once: the count against the
// registry's range, then every argument the registry types checked as its
// expected kind. Returns the type of each argument.
fn check_stdlib_arguments(checker ^TypeChecker, node ^ast.AstNode, signature ^stdlib_sigs.StdlibSig) -> [^types.GrayType] {
    arguments = node^.call^.args
    if signature^.module == "mem" || signature^.module == "threads" { require_unsafe_context(checker, node, "${signature^.module}.${signature^.name}()") }
    callee_name = "${signature.module}.${signature.name}"
    argument_count i64 = len(arguments)

    // Named arguments are not supported for stdlib functions
    for_each argument_name in node^.call^.arg_names {
        if argument_name != "" {
            add_diagnostic(checker, "E5034", error_registry.registry_message_formatted("E5034", {callee_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            break
        }
    }

    // Validate argument count
    mut arg_types [^types.GrayType] = {}
    mut is_resolved [bool] = {}
    for _ in range(0, argument_count) {
        arrays.append(arg_types, checker^.pool^.type_unknown)
        arrays.append(is_resolved, false)
    }
    if argument_count < signature^.min_args || argument_count > signature^.max_args {
        mut expected_count = "${signature^.min_args}"
        if signature^.min_args != signature^.max_args { expected_count = "${signature^.min_args} to ${signature^.max_args}" }
        // An extra argument that names a type is reported as a value before the count
        for extra_index in range(signature^.max_args, argument_count) {
            if argument_count > signature^.max_args && arguments[extra_index]^.kind == ast.NodeKind.LABEL && type_argument_names_a_type(checker, arguments[extra_index]^.label^.value) {
                arg_types[extra_index] = resolve_expression(checker, arguments[extra_index])
                is_resolved[extra_index] = true
            }
        }
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {callee_name, expected_count, "${argument_count}"}), node^.tok.file, node^.tok.line, node^.tok.col)
    } or argument_count == 1 && signature^.module == "random" && (signature^.name == "rand_f64" || signature^.name == "rand_char") {
        // These take no bounds or both bounds, never one.
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {callee_name, "0 or 2", "1"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    // The common number type of the COMMON_NUMBER arguments: their types
    // combined as a binary operator combines its operands, or a literal's
    // default when every one is a literal. nil when two of them have no common
    // type.
    mut common_type ^types.GrayType = nil
    mut has_common_arguments = false
    mut is_common_conflict = false
    mut any_decimal = false
    for position in range(0, len(signature^.argument_indexes)) {
        index = signature^.argument_indexes[position]
        if signature^.argument_kinds[position] != "COMMON_NUMBER" || index >= argument_count { continue }
        has_common_arguments = true
        operand_type = resolve_untyped(checker, arguments[index])
        arg_types[index] = operand_type
        is_resolved[index] = true
        if operand_type^.kind == types.TypeKind.LITERAL {
            any_decimal = any_decimal || operand_type^.is_decimal
            continue
        }
        if !types.type_kind_is_number(operand_type^.kind) { continue }
        if common_type == nil {
            common_type = operand_type
            continue
        }
        combined = types.type_binary_result(checker^.pool, token.TokenKind.PLUS, common_type, operand_type)
        if combined == nil {
            is_common_conflict = true
            break
        }
        common_type = combined
    }
    if has_common_arguments && !is_common_conflict && common_type == nil {
        if any_decimal { common_type = checker^.pool^.type_f64 } otherwise { common_type = checker^.pool^.type_i64 }
    }
    checker^.last_common_number_type = nil
    if has_common_arguments && !is_common_conflict { checker^.last_common_number_type = common_type }

    // A binary encoder's value is checked as the encoder's own type
    is_encoder_value = signature^.module == "binary" && strings.starts_with(signature^.name, "encode_")
    if is_encoder_value && argument_count == 1 {
        encoded_name = strings.slice(signature^.name, ENCODE_PREFIX_LENGTH, len(signature^.name))
        underscore = strings.index_of(encoded_name, "_")
        if underscore >= 0 { encoded_name = strings.slice(encoded_name, 0, underscore) }
        if arrays.contains({"i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "i128", "u128", "i256", "u256", "f32"}, encoded_name) {
            arg_types[0] = check_expression_as(checker, arguments[0], checker_type_from_name(checker, encoded_name))
            is_resolved[0] = true
        }
    }

    mut was_common_number_reported = false
    for position in range(0, len(signature^.argument_indexes)) {
        argument_index = signature^.argument_indexes[position]
        kind = signature^.argument_kinds[position]
        if argument_index >= argument_count { continue }
        argument = arguments[argument_index]
        // A type position is validated by name. Resolving it as a value would
        // report the type name as one; skipping it without validating
        // would put a mistyped name into the generated C.
        if kind == "TYPE" {
            if argument^.kind != ast.NodeKind.LABEL || !type_argument_names_a_type(checker, argument^.label^.value) {
                mut removed_help = ""
                if argument^.kind == ast.NodeKind.LABEL {
                    removed_replacement = removed_type_replacement(argument^.label^.value)
                    if removed_replacement != "" { removed_help = "use '${removed_replacement}', or declare 'alias ${argument^.label^.value} = ${removed_replacement}'" }
                }
                add_diagnostic_help(checker, "E4037", error_registry.registry_message_formatted("E4037", {signature^.module, signature^.name, "${argument_index + 1}"}), removed_help, argument^.tok.file, argument^.tok.line, argument^.tok.col)
            }
            is_resolved[argument_index] = true
            continue
        }
        mut slot ^types.GrayType = nil
        if is_encoder_value {
            slot = nil
        } or kind == "I64" {
            slot = checker^.pool^.type_i64
        } or kind == "U64" {
            slot = checker^.pool^.type_u64
        } or kind == "F64" || kind == "F64_NUMBER" {
            slot = checker^.pool^.type_f64
        } or kind == "U8_ARRAY" {
            slot = types.type_array(checker^.pool, "u8")
        } or kind == "STRING_ARRAY" && argument^.kind == ast.NodeKind.ARRAY_VALUE && len(argument^.array_value^.elements) == 0 {
            // an empty literal takes its element type from the parameter
            slot = types.type_array(checker^.pool, "string")
        } or kind == "STRING_MAP" && argument^.kind == ast.NodeKind.MAP_VALUE && len(argument^.map_value^.keys) == 0 {
            // an empty map literal takes its key and value types from the parameter
            slot = types.type_map(checker^.pool, "string", "string")
        } or kind_is_slot_of_first(kind) {
            first_type = checker^.pool^.type_unknown
            if argument_count > 0 {
                if !is_resolved[0] {
                    arg_types[0] = resolve_expression(checker, arguments[0])
                    is_resolved[0] = true
                }
                first_type = arg_types[0]
            }
            if kind == "ELEMENT_OF_FIRST" {
                slot = array_element_of(checker, first_type)
            } or kind == "SAME_AS_FIRST" {
                slot = first_type
            } or kind == "KEY_OF_FIRST" {
                slot = map_key_of(checker, first_type)
            } otherwise {
                slot = map_value_of(checker, first_type)
            }
        } or kind == "COMMON_NUMBER" {
            slot = common_type
            if slot == nil || is_common_conflict {
                if !was_common_number_reported {
                    add_diagnostic(checker, "E5057", error_registry.registry_message_formatted("E5057", {signature^.module, signature^.name}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
                }
                was_common_number_reported = true
                slot = checker^.pool^.type_unknown
            }
        }
        mut argument_type ^types.GrayType = arg_types[argument_index]
        if kind == "COMMON_NUMBER" && is_resolved[argument_index] && !folding.is_literal_expression(argument) {
            // Already resolved to find the common type; apply the conversion
            // the slot's type puts on it without resolving a second time.
            report_number_conversion(checker, argument, argument_type, slot)
        } or slot != nil {
            argument_type = check_expression_as(checker, argument, slot)
        } or !is_resolved[argument_index] {
            argument_type = resolve_expression(checker, argument)
        } or argument_type^.kind == types.TypeKind.LITERAL {
            argument_type = check_expression_as(checker, argument, nil)
        }
        arg_types[argument_index] = argument_type
        is_resolved[argument_index] = true
        // An argument of any type (or one typed by the first) must produce a value
        if kind == "ANY" || kind == "ELEMENT_OF_FIRST" || kind == "SAME_AS_FIRST" || kind == "KEY_OF_FIRST" || kind == "VALUE_OF_FIRST" {
            reject_void_in_context(checker, argument, argument_type, "a '${signature^.module}.${signature^.name}()' argument")
        }

        is_slot_mismatch =kind_is_slot_of_first(kind) && slot != nil && (literal_entry_mismatches(checker, slot, argument_type) || (slot^.kind == types.TypeKind.MAP && ((argument_type^.kind == types.TypeKind.MAP && !map_types_match(slot, argument_type)) || argument_type^.kind == types.TypeKind.ARRAY)))
        if is_slot_mismatch {
            report_argument_type(checker, argument, argument_index + 1, callee_name, shown_type(checker, slot), shown_type(checker, argument_type))
            continue
        }
        // A literal takes a distinct slot type; only the other arguments are at fault.
        is_literal_in_distinct_slot = slot != nil && slot^.distinct_name != "" && folding.is_literal_expression(argument)
        if !is_literal_in_distinct_slot && !argument_kind_matches(kind, argument_type) {
            report_argument_type(checker, argument, argument_index + 1, callee_name, expected_kind_name(kind), shown_type(checker, argument_type))
        }
    }

    // Everything the registry does not type is resolved as a plain value
    printf_call = is_printf_call(checker, node)
    if printf_call && signature^.module == "fmt" && argument_count == 2 && !is_resolved[1] {
        check_printf_call(checker, node, signature^.name)
        is_resolved[1] = true
    }
    for index in range(0, argument_count) {
        if is_resolved[index] { continue }
        argument = arguments[index]
        if printf_call && argument^.kind == ast.NodeKind.ARRAY_VALUE {
            for_each element in argument^.array_value^.elements {
                resolve_expression(checker, element)
            }
            continue
        }
        arg_types[index] = resolve_expression(checker, argument)
    }
    // fmt: every value after the format must be a primitive
    if signature^.module == "fmt" && !printf_call {
        for index in range(1, argument_count) { check_format_value_is_primitive(checker, signature^.name, arguments[index], arg_types[index]) }
    }

    // strconv.to_i64/to_u64/format_i64/format_u64: a literal base must be 2..36
    if signature^.module == "strconv" && (signature^.name == "to_i64" || signature^.name == "to_u64" || signature^.name == "format_i64" || signature^.name == "format_u64") && argument_count >= 2 {
        base_argument = arguments[1]
        if base_argument^.kind == ast.NodeKind.INT_VALUE {
            base_value = base_argument^.int_value^.value
            if base_value < MIN_NUMBER_BASE || base_value > MAX_NUMBER_BASE {
                add_diagnostic(checker, "E5009", error_registry.registry_message_formatted("E5009", {"${base_value}", signature^.name}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }
    // io.read_lines: a literal negative limit is rejected outright
    if signature^.module == "io" && signature^.name == "read_lines" && argument_count >= 2 {
        limit_argument = arguments[1]
        mut limit i64 = 0
        mut has_limit = false
        if limit_argument^.kind == ast.NodeKind.INT_VALUE {
            limit = limit_argument^.int_value^.value
            has_limit = true
        } or limit_argument^.kind == ast.NodeKind.PREFIX_EXPR && limit_argument^.prefix^.op == token.TokenKind.MINUS && limit_argument^.prefix^.right != nil && limit_argument^.prefix^.right^.kind == ast.NodeKind.INT_VALUE {
            limit = -limit_argument^.prefix^.right^.int_value^.value
            has_limit = true
        }
        if has_limit && limit < 0 {
            add_diagnostic(checker, "E3150", error_registry.registry_message("E3150"), limit_argument^.tok.file, limit_argument^.tok.line, limit_argument^.tok.col)
        }
    }
    check_const_domain(checker, signature^.module, signature^.name, node)
    check_stdlib_module_arguments(checker, node, signature, arg_types)
    return arg_types
}

// A function-typed stdlib argument must have exactly the signature the function
// stores and calls it with: an error for another function signature, an error for a
// value that is not a function at all.
fn check_function_argument_signature(checker ^TypeChecker, argument ^ast.AstNode, argument_type ^types.GrayType, callee string, argument_number i64, expected_signature string) {
    if argument_type^.kind == types.TypeKind.UNKNOWN { return }
    if argument_type^.kind != types.TypeKind.FUNCTION {
        report_argument_type(checker, argument, argument_number, callee, expected_signature, shown_type(checker, argument_type))
        return
    }
    if argument_type^.name != "" && argument_type^.name != "func" && argument_type^.name != expected_signature {
        add_diagnostic(checker, "E3066", error_registry.registry_message_formatted("E3066", {expected_signature, shown_type(checker, argument_type)}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
    }
}

fn json_encodable_scalar(scalar_type ^types.GrayType) -> bool {
    kind = scalar_type^.kind
    if kind == types.TypeKind.FLOAT || kind == types.TypeKind.BOOL || kind == types.TypeKind.STRING || kind == types.TypeKind.CHAR { return true }
    if kind == types.TypeKind.INT || kind == types.TypeKind.UINT {
        return scalar_type^.name != "i128" && scalar_type^.name != "u128" && scalar_type^.name != "i256" && scalar_type^.name != "u256"
    }
    return false
}

fn struct_has_json_attribute(checker ^TypeChecker, struct_name string) -> bool {
    if struct_name == "" { return false }
    info = find_struct(checker, struct_name)
    return info != nil && info^.is_json
}

// What json.encode() accepts: a primitive, a flat array of primitives, a
// string-keyed map of primitives, or a #json struct or an array of one.
fn type_is_json_encodable(checker ^TypeChecker, encoded_type ^types.GrayType) -> bool {
    if encoded_type^.kind == types.TypeKind.UNKNOWN { return true }
    if json_encodable_scalar(encoded_type) { return true }
    if encoded_type^.kind == types.TypeKind.STRUCT { return struct_has_json_attribute(checker, encoded_type^.name) }
    if encoded_type^.kind == types.TypeKind.ARRAY {
        if encoded_type^.element_type == "" { return false }
        element_type = checker_type_from_name(checker, encoded_type^.element_type)
        if element_type^.kind == types.TypeKind.STRUCT { return struct_has_json_attribute(checker, element_type^.name) }
        return json_encodable_scalar(element_type)
    }
    if encoded_type^.kind == types.TypeKind.MAP {
        return encoded_type^.key_type == "string" && encoded_type^.value_type != "" && json_encodable_scalar(checker_type_from_name(checker, encoded_type^.value_type))
    }
    return false
}

// csv.encode() / write_file() take [[string]] (rows of fields) or [string].
fn csv_array_element_is_valid(array_type ^types.GrayType, checker ^TypeChecker) -> bool {
    if array_type^.kind != types.TypeKind.ARRAY || array_type^.element_type == "" { return true }
    if array_type^.element_type == "string" { return true }
    inner = checker_type_from_name(checker, array_type^.element_type)
    return inner^.kind == types.TypeKind.ARRAY && inner^.element_type == "string"
}

// The per-module argument checks that sit beside the registry: callback
// signatures (threads, server), socket arguments (net), and what json.encode
// and csv.encode can serialize.
fn check_stdlib_module_arguments(checker ^TypeChecker, node ^ast.AstNode, signature ^stdlib_sigs.StdlibSig, arg_types [^types.GrayType]) {
    arguments = node^.call^.args
    callee = "${signature^.module}.${signature^.name}"
    argument_count = len(arguments)
    if signature^.module == "threads" {
        if (signature^.name == "spawn" || signature^.name == "spawn_arg") && argument_count >= 1 && len(arg_types) >= 1 {
            mut expected_signature = "func()"
            if signature^.name == "spawn_arg" { expected_signature = "func(i64)" }
            check_function_argument_signature(checker, arguments[0], arg_types[0], callee, 1, expected_signature)
        }
    } or signature^.module == "server" {
        if signature^.name == "add_route" && argument_count == 4 && len(arg_types) >= 4 {
            check_function_argument_signature(checker, arguments[3], arg_types[3], callee, 4, "func(HttpRequest)->HttpResponse")
        } or signature^.name == "add_middleware" && argument_count == 2 && len(arg_types) >= 2 {
            check_function_argument_signature(checker, arguments[1], arg_types[1], callee, 2, "func(^HttpRequest,^HttpResponse)")
        }
    } or signature^.module == "net" {
        if (signature^.name == "send" || signature^.name == "receive" || signature^.name == "receive_line" || signature^.name == "close" || signature^.name == "set_timeout" || signature^.name == "accept") && argument_count >= 1 && len(arg_types) >= 1 {
            first_type = arg_types[0]
            if first_type^.kind != types.TypeKind.STRUCT {
                mut expected = "Socket"
                if signature^.name == "accept" { expected = "Listener" }
                mut got = "non-struct type"
                if first_type^.name != "" { got = first_type^.name }
                report_argument_type(checker, arguments[0], 1, callee, expected, got)
            }
        }
    } or signature^.module == "json" {
        if signature^.name == "parse" && node != checker^.json_parse_target_call {
            add_diagnostic(checker, "E3210", error_registry.registry_message("E3210"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if signature^.name == "encode" && argument_count >= 1 && len(arg_types) >= 1 && !type_is_json_encodable(checker, arg_types[0]) {
            report_argument_type(checker, arguments[0], 1, "json.encode", "a primitive, a flat array of primitives, a string-keyed map of primitives, or a #json struct (or an array of one)", shown_type(checker, arg_types[0]))
        }
    } or signature^.module == "csv" {
        if (signature^.name == "encode" && argument_count >= 1) || (signature^.name == "write_file" && argument_count >= 2) {
            mut data_index i64 = 0
            if signature^.name == "write_file" { data_index = 1 }
            if len(arg_types) > data_index && arg_types[data_index]^.kind == types.TypeKind.ARRAY && !csv_array_element_is_valid(arg_types[data_index], checker) {
                report_argument_type(checker, arguments[data_index], data_index + 1, callee, "[[string]]", shown_type(checker, arg_types[data_index]))
            }
        }
        // Filter_rows takes a function reference taking one row and returning a bool
        if signature^.name == "filter_rows" && argument_count >= 2 {
            callback_argument = arguments[1]
            is_reference_call = callback_argument^.kind == ast.NodeKind.CALL_EXPR && callback_argument^.call^.function^.kind == ast.NodeKind.LABEL && callback_argument^.call^.function^.label^.value == "ref"
            if callback_argument^.kind != ast.NodeKind.FUNC_REF && !is_reference_call {
                add_diagnostic(checker, "E5060", error_registry.registry_message("E5060"), callback_argument^.tok.file, callback_argument^.tok.line, callback_argument^.tok.col)
            } or callback_argument^.kind == ast.NodeKind.FUNC_REF && callback_argument^.func_ref^.function^.kind == ast.NodeKind.LABEL {
                callback_signature = find_func(checker, callback_argument^.func_ref^.function^.label^.value)
                if callback_signature != nil && (len(callback_signature^.param_types) != 1 || len(callback_signature^.return_types) != 1 || callback_signature^.return_types[0]^.kind != types.TypeKind.BOOL || types.type_display_name(callback_signature^.param_types[0]) != "[string]") {
                    add_diagnostic(checker, "E5061", error_registry.registry_message("E5061"), callback_argument^.tok.file, callback_argument^.tok.line, callback_argument^.tok.col)
                }
            }
        }
    }
}

// A compile-time numeric value: a float literal or a folded integer constant, each
// optionally negated. False when the argument is not decidable.
fn const_number_value(checker ^TypeChecker, number_node ^ast.AstNode) -> (f64, bool) {
    if number_node == nil { return 0.0, false }
    if number_node^.kind == ast.NodeKind.FLOAT_VALUE { return number_node^.float_value^.value, true }
    if number_node^.kind == ast.NodeKind.PREFIX_EXPR && number_node^.prefix^.op == token.TokenKind.MINUS && number_node^.prefix^.right != nil && number_node^.prefix^.right^.kind == ast.NodeKind.FLOAT_VALUE {
        return -number_node^.prefix^.right^.float_value^.value, true
    }
    integer_value, folded, overflowed = fold_const_integer(checker, number_node)
    if folded && !overflowed { return cast(integer_value, f64), true }
    return 0.0, false
}

// Integer domain of a stdlib argument, as [low, high] inclusive: which argument,
// the bounds, and the phrase for an error. `index` is -1 when the function has none.
const IntegerDomain struct {
    argument_index i64
    low i64
    high i64
    needs string
}

fn integer_domain_of(module_name string, function_name string) -> IntegerDomain {
    maximum i64 = I64_MAX
    minimum i64 = -I64_MAX - 1
    if module_name == "math" && function_name == "factorial" { return IntegerDomain{argument_index: 0, low: 0, high: maximum, needs: "a non-negative integer"} }
    if module_name == "math" && function_name == "next_power_of_two" { return IntegerDomain{argument_index: 0, low: minimum, high: LARGEST_POWER_OF_TWO_I64, needs: "a value whose next power of two fits in i64"} }
    if module_name == "strings" && function_name == "repeat" { return IntegerDomain{argument_index: 1, low: 0, high: maximum, needs: "a non-negative count"} }
    if module_name == "crypto" && function_name == "random_hex" { return IntegerDomain{argument_index: 0, low: 0, high: maximum, needs: "a non-negative length"} }
    if module_name == "random" && function_name == "sample" { return IntegerDomain{argument_index: 1, low: 0, high: maximum, needs: "a non-negative count"} }
    return IntegerDomain{argument_index: -1, low: 0, high: 0, needs: ""}
}

// A stdlib call whose constant argument is provably outside the
// domain the implementation guards with a runtime panic.
fn check_const_domain(checker ^TypeChecker, module_name string, function_name string, node ^ast.AstNode) {
    arguments = node^.call^.args
    domain = integer_domain_of(module_name, function_name)
    if domain.argument_index >= 0 {
        if domain.argument_index >= len(arguments) { return }
        value, folded, overflowed = fold_const_integer(checker, arguments[domain.argument_index])
        if !folded || overflowed { return }
        if value < domain.low || value > domain.high {
            argument = arguments[domain.argument_index]
            add_diagnostic(checker, "E5045", error_registry.registry_message_formatted("E5045", {module_name, function_name, domain.needs, "${value}"}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
        }
        return
    }
    if module_name != "math" || len(arguments) < 1 { return }
    number_value, is_decidable = const_number_value(checker, arguments[0])
    if !is_decidable { return }
    mut needs = ""
    if function_name == "sqrt" {
        if number_value < 0.0 { needs = "a non-negative number" }
    } or function_name == "log" || function_name == "log2" || function_name == "log10" {
        if number_value <= 0.0 { needs = "a positive number" }
    } or function_name == "asin" || function_name == "acos" {
        if number_value < -1.0 || number_value > 1.0 { needs = "a value in [-1, 1]" }
    }
    if needs != "" {
        first_argument = arguments[0]
        add_diagnostic(checker, "E5056", fmt.sprintf("'math.%s' requires %s; got %g", {function_name, needs, number_value}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
    }
}

// What a printf directive expects when `value_type` does not satisfy it, or "" when
// it does (or the directive places no constraint).
fn format_directive_mismatch(specifier char, value_type ^types.GrayType) -> string {
    kind = value_type^.kind
    when specifier {
        is 'd', 'i' {
            if kind == types.TypeKind.INT || kind == types.TypeKind.CHAR { return "" }
            return "signed integer or char"
        }
        is 'u' {
            if kind == types.TypeKind.UINT { return "" }
            return "unsigned integer"
        }
        is 'x', 'X', 'o' {
            if kind == types.TypeKind.INT || kind == types.TypeKind.UINT { return "" }
            return "integer"
        }
        is 'f', 'g', 'e', 'G', 'E' {
            if kind == types.TypeKind.FLOAT { return "" }
            return "f32 or f64"
        }
        is 's' {
            if kind == types.TypeKind.STRING { return "" }
            return "string"
        }
        is 'c' {
            if kind == types.TypeKind.CHAR { return "" }
            if kind == types.TypeKind.INT && value_type^.name != "i128" && value_type^.name != "i256" { return "" }
            return "char"
        }
        is 'b' {
            if kind == types.TypeKind.BOOL { return "" }
            return "bool"
        }
        default { return "" }
    }
}

// A struct, array, map or pointer, which no format directive can print.
fn is_composite_format_value(value_type ^types.GrayType) -> bool {
    kind = value_type^.kind
    return kind == types.TypeKind.STRUCT || kind == types.TypeKind.ARRAY || kind == types.TypeKind.MAP || kind == types.TypeKind.POINTER
}

// A formatted value must be a primitive.
fn check_format_value_is_primitive(checker ^TypeChecker, function_name string, value ^ast.AstNode, value_type ^types.GrayType) {
    if !is_composite_format_value(value_type) { return }
    mut type_text = types.type_display_name(value_type)
    if value_type^.kind == types.TypeKind.ARRAY && value_type^.element_type != "" {
        type_text = "[${value_type^.element_type}]"
    } or value_type^.kind == types.TypeKind.MAP {
        mut key_text = "?"
        mut value_text = "?"
        if value_type^.key_type != "" { key_text = value_type^.key_type }
        if value_type^.value_type != "" { value_text = value_type^.value_type }
        type_text = "map[${key_text}:${value_text}]"
    } or value_type^.kind == types.TypeKind.POINTER && value_type^.element_type != "" {
        type_text = "^${value_type^.element_type}"
    }
    add_diagnostic(checker, "E3017", error_registry.registry_message_formatted("E3017", {function_name, type_text}), value^.tok.file, value^.tok.line, value^.tok.col)
}

fn format_error(checker ^TypeChecker, at ^ast.AstNode, code string, arguments [string]) {
    add_diagnostic(checker, code, error_registry.registry_message_formatted(code, arguments), at^.tok.file, at^.tok.line, at^.tok.col)
}

// printf family: fmt.printf(format string, arguments [T]). The format string must be a
// literal; each directive takes one element of `arguments`. An array literal is checked
// element by element, so its elements may differ in type; an array variable's
// element type must satisfy every directive.
fn check_printf_call(checker ^TypeChecker, node ^ast.AstNode, function_name string) {
    arguments = node^.call^.args
    if len(arguments) != 2 { return }
    format_argument = arguments[0]
    values_argument = arguments[1]
    is_literal = values_argument^.kind == ast.NodeKind.ARRAY_VALUE
    mut element_count = 0
    if is_literal { element_count = len(values_argument^.array_value^.elements) }

    is_format_literal = format_argument^.kind == ast.NodeKind.STRING_VALUE
    mut format_text = ""
    if is_format_literal { format_text = ast.ast_string_decode(format_argument^.string_value) }
    format_length = len(format_text)
    mut specifiers [string] = {}
    if !is_format_literal { format_error(checker, format_argument, "E3086", {function_name}) }

    mut cursor = 0
    as_long_as cursor < format_length {
        if strings.char_at(format_text, cursor) != '%' {
            cursor = cursor + 1
            continue
        }
        cursor = cursor + 1
        if cursor >= format_length {
            format_error(checker, format_argument, "E3106", {function_name})
            continue
        }
        if strings.char_at(format_text, cursor) == '%' {
            cursor = cursor + 1
            continue
        }
        if strings.char_at(format_text, cursor) == 'n' {
            format_error(checker, format_argument, "E3087", {})
            cursor = cursor + 1
            continue
        }
        // Flags, width, precision, length modifier
        mut flags [char] = {}
        as_long_as cursor < format_length && arrays.contains({'-', '+', ' ', '0', '#'}, strings.char_at(format_text, cursor)) {
            arrays.append(flags, strings.char_at(format_text, cursor))
            cursor = cursor + 1
        }
        mut has_precision = false
        for part in range(0, 2) {
            if part == 1 {
                if cursor >= format_length || strings.char_at(format_text, cursor) != '.' { break }
                has_precision = true
                cursor = cursor + 1
            }
            digits_start = cursor
            mut amount i64 = 0
            as_long_as cursor < format_length && strings.char_at(format_text, cursor) >= '0' && strings.char_at(format_text, cursor) <= '9' {
                if amount <= MAX_FORMAT_AMOUNT { amount = amount * DECIMAL_BASE + cast(strings.char_at(format_text, cursor), i64) - cast('0', i64) }
                cursor = cursor + 1
            }
            if amount > MAX_FORMAT_AMOUNT {
                mut part_name = "width"
                if part == 1 { part_name = "precision" }
                format_error(checker, format_argument, "E3179", {function_name, part_name, strings.slice(format_text, digits_start, cursor)})
            }
        }
        modifier_start = cursor
        if cursor < format_length && strings.char_at(format_text, cursor) == 'h' {
            cursor = cursor + 1
            if cursor < format_length && strings.char_at(format_text, cursor) == 'h' { cursor = cursor + 1 }
        } or cursor < format_length && strings.char_at(format_text, cursor) == 'l' {
            cursor = cursor + 1
            if cursor < format_length && strings.char_at(format_text, cursor) == 'l' { cursor = cursor + 1 }
        } or cursor < format_length && strings.char_at(format_text, cursor) == 'L' {
            cursor = cursor + 1
        }
        modifier_length = cursor - modifier_start
        if cursor >= format_length {
            format_error(checker, format_argument, "E3106", {function_name})
            continue
        }
        specifier = strings.char_at(format_text, cursor)
        cursor = cursor + 1
        mut recorded = "${specifier}"
        if !strings.contains("diuxXofgeGEscb", "${specifier}") {
            format_error(checker, format_argument, "E3105", {function_name, "${specifier}"})
            recorded = ""
        } or modifier_length > 0 {
            format_error(checker, format_argument, "E3177", {function_name, strings.slice(format_text, modifier_start, modifier_start + modifier_length)})
        } otherwise {
            // Flags and precision a conversion gives no meaning to are rejected
            mut allowed_flags = "-"
            if specifier == 'd' || specifier == 'i' {
                allowed_flags = "-+ 0"
            } or specifier == 'u' {
                allowed_flags = "-0"
            } or specifier == 'x' || specifier == 'X' || specifier == 'o' {
                allowed_flags = "-0#"
            } or strings.contains("fgeGE", "${specifier}") {
                allowed_flags = "-+ 0#"
            }
            allows_precision = specifier != 'c' && specifier != 'b'
            for_each flag in flags {
                if strings.contains(allowed_flags, "${flag}") { continue }
                format_error(checker, format_argument, "E3178", {function_name, "the '${flag}' flag", "${specifier}"})
                break
            }
            if has_precision && !allows_precision {
                format_error(checker, format_argument, "E3178", {function_name, "a precision", "${specifier}"})
            }
        }
        arrays.append(specifiers, recorded)
    }
    directive_count = len(specifiers)

    // Resolve the values. A bare number literal takes the type its directive reads
    mut element_types [^types.GrayType] = {}
    mut variable_element_type ^types.GrayType = nil
    if is_literal {
        elements = values_argument^.array_value^.elements
        for index in range(0, element_count) {
            element = elements[index]
            mut specifier_text = ""
            if index < directive_count { specifier_text = specifiers[index] }
            mut literal_target ^types.GrayType = nil
            if specifier_text == "u" {
                literal_target = checker^.pool^.type_u64
            } or specifier_text != "" && strings.contains("fgeGE", specifier_text) {
                literal_target = checker^.pool^.type_f64
            }
            mut element_type ^types.GrayType = nil
            if literal_target != nil && folding.is_literal_expression(element) {
                element_type = check_expression_as(checker, element, literal_target)
            } otherwise {
                element_type = resolve_expression(checker, element)
            }
            reject_multi_return_in_single_position(checker, element)
            check_format_value_is_primitive(checker, function_name, element, element_type)
            arrays.append(element_types, element_type)
        }
    } otherwise {
        values_type = resolve_expression(checker, values_argument)
        if values_type^.kind == types.TypeKind.ARRAY && values_type^.element_type != "" {
            variable_element_type = checker_type_from_name(checker, values_type^.element_type)
            check_format_value_is_primitive(checker, function_name, values_argument, variable_element_type)
        } or values_type^.kind != types.TypeKind.UNKNOWN {
            report_argument_type(checker, values_argument, 2, "fmt.${function_name}", "an array of values", shown_type(checker, values_type))
        }
    }
    if !is_format_literal { return }

    // Check each directive against its element
    for element_index in range(0, directive_count) {
        specifier_text = specifiers[element_index]
        if specifier_text == "" { continue }
        mut value = values_argument
        mut value_type = variable_element_type
        if is_literal {
            if element_index >= element_count { break }
            value = values_argument^.array_value^.elements[element_index]
            value_type = element_types[element_index]
        }
        // An unknown type was reported where it arose; a composite value was an error
        if value_type == nil || value_type^.kind == types.TypeKind.UNKNOWN || is_composite_format_value(value_type) { continue }
        expected = format_directive_mismatch(strings.char_at(specifier_text, 0), value_type)
        if expected != "" {
            format_error(checker, value, "E3088", {function_name, specifier_text, expected, "${element_index}", value_type^.name})
        }
    }
    // A literal's element count must match the directive count
    if is_literal && element_count < directive_count {
        format_error(checker, format_argument, "E3107", {function_name, "${directive_count}", "${element_count}"})
    } or is_literal && element_count > directive_count {
        format_error(checker, format_argument, "E3108", {function_name, "${directive_count}", "${element_count}"})
    }
}

// Len() works only on strings, arrays, maps, ranges, and the Channel and
// Builder of an imported module; codegen emits from the same table.
fn resolve_len_call(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    arguments = node^.call^.args
    if len(arguments) != 1 {
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"len", "1", "${len(arguments)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        for_each argument in arguments { resolve_expression(checker, argument) }
        return checker^.pool^.type_i64
    }
    allow_range_use(checker, arguments[0])
    argument_type = resolve_expression(checker, arguments[0])
    reject_void_in_context(checker, arguments[0], argument_type, "'len()' argument")
    kind = argument_type^.kind
    mut is_measurable = kind == types.TypeKind.STRING || kind == types.TypeKind.ARRAY || kind == types.TypeKind.MAP || kind == types.TypeKind.RANGE
    // A struct row matches by name; without the owning module imported the name is a user struct
    if kind == types.TypeKind.STRUCT && (argument_type^.name == "Channel" || argument_type^.name == "Builder") {
        is_measurable = stdlib_opaque_type_available(checker, argument_type^.name)
    }
    if !is_measurable && kind != types.TypeKind.UNKNOWN && kind != types.TypeKind.VOID {
        add_diagnostic_help(checker, "E7015", error_registry.registry_message_formatted("E7015", {shown_type(checker, argument_type)}), "'len()' works on string, array, map, Channel, Builder, and range types", arguments[0]^.tok.file, arguments[0]^.tok.line, arguments[0]^.tok.col)
    }
    return checker^.pool^.type_i64
}

// The conversion diagnostics check_expression_as would report for an operand
// that is already resolved: an error when `operand_type` narrows into `slot`, an error
// when it crosses signedness.
fn report_number_conversion(checker ^TypeChecker, operand ^ast.AstNode, operand_type ^types.GrayType, slot ^types.GrayType) {
    if slot == nil || slot^.kind == types.TypeKind.UNKNOWN || slot^.kind == types.TypeKind.LITERAL { return }
    if !types.type_kind_is_number(operand_type^.kind) || !types.type_kind_is_number(slot^.kind) { return }
    conversion = types.type_conversion(operand_type, slot)
    if conversion == types.Conversion.NARROW {
        add_diagnostic(checker, "E3155", error_registry.registry_message_formatted("E3155", {operand_type^.name, slot^.name, slot^.name}), operand^.tok.file, operand^.tok.line, operand^.tok.col)
    } or conversion == types.Conversion.SIGN_CROSS {
        add_diagnostic(checker, "E3019", error_registry.registry_message_formatted("E3019", {operand_type^.name, slot^.name}), operand^.tok.file, operand^.tok.line, operand^.tok.col)
    }
}

// The per-function rules of the maps module: not a map, sorted_keys
// ordering by the key, is_equal, and a value that cannot be compared.
fn check_maps_call(checker ^TypeChecker, node ^ast.AstNode, function_name string, arg_types [^types.GrayType]) {
    arguments = node^.call^.args
    if len(arguments) == 0 || len(arg_types) == 0 { return }
    first_argument = arguments[0]
    first_type = arg_types[0]
    if first_type^.kind == types.TypeKind.ARRAY {
        add_diagnostic(checker, "E12001", error_registry.registry_message_formatted("E12001", {function_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
    }
    if first_type^.kind != types.TypeKind.MAP { return }
    if function_name == "sorted_keys" && first_type^.key_type != "" {
        key_type = types.type_from_name(checker^.pool, resolve_type_alias(checker, first_type^.key_type))
        is_orderable = key_type^.kind == types.TypeKind.STRING || key_type^.kind == types.TypeKind.CHAR || key_type^.kind == types.TypeKind.INT || key_type^.kind == types.TypeKind.UINT
        // An unbound generic key is checked at each instantiation
        if key_type^.kind != types.TypeKind.UNKNOWN && (!is_orderable || is_enum_name(checker, first_type^.key_type)) {
            add_diagnostic(checker, "E12008", error_registry.registry_message_formatted("E12008", {first_type^.key_type}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
        }
    }
    if function_name == "is_equal" && len(arguments) >= 2 && len(arg_types) >= 2 && arg_types[1]^.kind == types.TypeKind.MAP {
        second_type = arg_types[1]
        key_match = first_type^.key_type != "" && second_type^.key_type != "" && first_type^.key_type == second_type^.key_type
        value_match = first_type^.value_type != "" && second_type^.value_type != "" && first_type^.value_type == second_type^.value_type
        if !key_match || !value_match {
            first_key = first_type^.key_type
            if first_key == "" { first_key = "?" }
            first_value = first_type^.value_type
            if first_value == "" { first_value = "?" }
            second_key = second_type^.key_type
            if second_key == "" { second_key = "?" }
            second_value = second_type^.value_type
            if second_value == "" { second_value = "?" }
            add_diagnostic(checker, "E3195", error_registry.registry_message_formatted("E3195", {first_key, first_value, second_key, second_value}), arguments[1]^.tok.file, arguments[1]^.tok.line, arguments[1]^.tok.col)
        }
        if first_type^.value_type != "" {
            value_kind = types.type_from_name(checker^.pool, first_type^.value_type)^.kind
            if value_kind == types.TypeKind.ARRAY || value_kind == types.TypeKind.MAP || value_kind == types.TypeKind.STRUCT {
                add_diagnostic(checker, "E5058", error_registry.registry_message_formatted("E5058", {"maps", "map values", first_type^.value_type}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
            }
        }
    }
    if (function_name == "contains_value" || function_name == "find_key") && first_type^.value_type != "" {
        value_kind = types.type_from_name(checker^.pool, first_type^.value_type)^.kind
        if value_kind == types.TypeKind.ARRAY || value_kind == types.TypeKind.MAP || value_kind == types.TypeKind.STRUCT {
            add_diagnostic(checker, "E12007", error_registry.registry_message_formatted("E12007", {function_name, first_type^.value_type}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
        }
    }
}

// The type a stdlib call yields: the registry's fixed return type, one derived
// from the arguments (`$0`, `$elem0`, `[$0]`), or the success type of a
// fallible function.
fn resolve_stdlib_call(checker ^TypeChecker, node ^ast.AstNode, signature ^stdlib_sigs.StdlibSig) -> ^types.GrayType {
    arg_types = check_stdlib_arguments(checker, node, signature)
    check_stdlib_mutation(checker, node, signature)
    if signature^.module == "maps" { check_maps_call(checker, node, signature^.name, arg_types) }
    // Negating an unsigned value has no result of its type
    if signature^.module == "math" && signature^.name == "neg" && len(arg_types) > 0 && arg_types[0]^.kind == types.TypeKind.UINT {
        add_diagnostic(checker, "E3096", error_registry.registry_message_formatted("E3096", {arg_types[0]^.name}), node^.call^.args[0]^.tok.file, node^.call^.args[0]^.tok.line, node^.call^.args[0]^.tok.col)
    }
    if signature^.fallible && signature^.success_type != "" { return checker_type_from_name(checker, signature^.success_type) }
    if signature^.module == "maps" && len(arg_types) > 0 {
        map_type = arg_types[0]
        when signature^.name {
            is "get_keys" {
                if map_type^.key_type != "" { return types.type_array(checker^.pool, map_type^.key_type) }
                return types.type_array(checker^.pool, "string")
            }
            is "sorted_keys" {
                if map_type^.key_type != "" { return types.type_array(checker^.pool, map_type^.key_type) }
                return types.type_array(checker^.pool, "string")
            }
            is "get_values" {
                if map_type^.value_type != "" { return types.type_array(checker^.pool, map_type^.value_type) }
                return types.type_array(checker^.pool, "string")
            }
            is "merge" { return map_type }
            is "get_or_default" {
                if map_type^.kind == types.TypeKind.MAP && map_type^.value_type != "" { return checker_type_from_name(checker, map_type^.value_type) }
                if len(arg_types) >= 3 { return arg_types[2] }
                return checker^.pool^.type_unknown
            }
        }
    }
    // mem.init(arena, T) -> ^T and mem.alloc(arena, value) -> ^T
    if signature^.module == "mem" && signature^.name == "init" && len(node^.call^.args) == 2 {
        type_argument = node^.call^.args[1]
        // A name that reaches no type was already reported; stay unknown so the
        // assignment does not report it a second time
        if type_argument^.kind == ast.NodeKind.LABEL && type_argument_names_a_type(checker, type_argument^.label^.value) { return checker_type_from_name(checker, "^${resolve_alias_impl(checker, type_argument^.label^.value, false)}") }
        return checker^.pool^.type_unknown
    }
    if signature^.module == "mem" && signature^.name == "alloc" && len(node^.call^.args) == 2 && len(arg_types) == 2 && arg_types[1]^.kind != types.TypeKind.UNKNOWN {
        return checker_type_from_name(checker, "^${types.type_display_name(arg_types[1])}")
    }
    ret = signature^.return_type
    if ret == `$common` {
        // math.min / max / clamp: the type of the operands; a literal takes the other operands' type
        if len(arg_types) == 0 { return checker^.pool^.type_unknown }
        if checker^.last_common_number_type != nil && types.type_kind_is_number(checker^.last_common_number_type^.kind) && checker^.last_common_number_type^.kind != types.TypeKind.LITERAL { return checker^.last_common_number_type }
        mut common_type = arg_types[0]
        for i in range(0, len(arg_types)) {
            argument_node = node^.call^.args[i]
            mut is_literal = argument_node^.kind == ast.NodeKind.INT_VALUE || argument_node^.kind == ast.NodeKind.FLOAT_VALUE
            if argument_node^.kind == ast.NodeKind.PREFIX_EXPR && (argument_node^.prefix^.right^.kind == ast.NodeKind.INT_VALUE || argument_node^.prefix^.right^.kind == ast.NodeKind.FLOAT_VALUE) { is_literal = true }
            if !is_literal && arg_types[i]^.kind != types.TypeKind.UNKNOWN {
                common_type = arg_types[i]
                break
            }
        }
        return common_type
    }
    if ret == "" { return checker^.pool^.type_unknown }
    if ret == "void" { return checker^.pool^.type_void }
    if ret == `$0` || ret == `$elem0` || ret == `[$0]` {
        if len(arg_types) == 0 { return checker^.pool^.type_unknown }
        mut first = arg_types[0]
        // an empty literal has no element type: a later argument that must match it supplies one
        if node^.call^.args[0]^.kind == ast.NodeKind.ARRAY_VALUE && len(node^.call^.args[0]^.array_value^.elements) == 0 {
            mut found_later_array = false
            for later_index in range(1, len(arg_types)) {
                if arg_types[later_index]^.kind == types.TypeKind.ARRAY && arg_types[later_index]^.element_type != "" && arg_types[later_index]^.element_type != "unknown" {
                    first = arg_types[later_index]
                    found_later_array = true
                    break
                }
            }
            // an empty literal with nothing to match leaves no type to infer
            if !found_later_array {
                add_diagnostic(checker, "E3136", error_registry.registry_message("E3136"), node^.call^.args[0]^.tok.file, node^.call^.args[0]^.tok.line, node^.call^.args[0]^.tok.col)
                return checker^.pool^.type_unknown
            }
        }
        if first^.kind == types.TypeKind.UNKNOWN { return first }
        if ret == `$0` { return first }
        if ret == `[$0]` { return types.type_array(checker^.pool, types.type_display_name(first)) }
        if first^.kind == types.TypeKind.ARRAY && first^.element_type != "" { return checker_type_from_name(checker, first^.element_type) }
        return checker^.pool^.type_unknown
    }
    // map[$elem0:i64]: arrays.counts keys the tally by the array's element type
    if ret == `map[$elem0:i64]` {
        if len(arg_types) == 0 || arg_types[0]^.kind != types.TypeKind.ARRAY || arg_types[0]^.element_type == "" { return checker^.pool^.type_unknown }
        return types.type_map(checker^.pool, arg_types[0]^.element_type, "i64")
    }
    return checker_type_from_name(checker, ret)
}

// The parameter and return type spellings of a callback handed to an arrays
// function.
const CallbackShape struct {
    parameter_names [string]
    return_names [string]
}

fn e9004(checker ^TypeChecker, callback ^ast.AstNode, function_name string, message string) {
    add_diagnostic(checker, "E9004", error_registry.registry_message_formatted("E9004", {function_name, message}), callback^.tok.file, callback^.tok.line, callback^.tok.col)
}

// The callback of map, filter, reduce, any, all, find, find_index
// and sort_by must be a function reference whose signature fits the array.
fn check_arrays_callback(checker ^TypeChecker, node ^ast.AstNode, function_name string) {
    arguments = node^.call^.args
    mut callback_index i64 = 1
    if function_name == "reduce" { callback_index = 2 }
    if callback_index >= len(arguments) { return }
    callback = arguments[callback_index]

    mut shape CallbackShape = CallbackShape{}
    mut has_shape bool = false
    mut is_typed_callback bool = false
    if callback^.kind != ast.NodeKind.FUNC_REF {
        callback_type = resolve_quietly(checker, callback)
        if callback_type^.kind == types.TypeKind.FUNCTION && callback_type^.func_sig != nil {
            shape.parameter_names = callback_type^.func_sig^.param_types
            shape.return_names = callback_type^.func_sig^.return_types
            has_shape = true
            is_typed_callback = true
        }
    }
    is_ref_call = callback^.kind == ast.NodeKind.CALL_EXPR && callback^.call^.function^.kind == ast.NodeKind.LABEL && callback^.call^.function^.label^.value == "ref"
    if !is_typed_callback && callback^.kind != ast.NodeKind.FUNC_REF && !is_ref_call {
        add_diagnostic(checker, "E9003", error_registry.registry_message_formatted("E9003", {function_name}), callback^.tok.file, callback^.tok.line, callback^.tok.col)
        return
    }
    if !has_shape {
        reference_name = function_reference_target_name(callback)
        if reference_name == "" { return }
        callback_signature = find_func(checker, reference_name)
        if callback_signature == nil { return }
        for_each parameter_type in callback_signature^.param_types { arrays.append(shape.parameter_names, types.type_display_name(parameter_type)) }
        for_each return_type in callback_signature^.return_types { arrays.append(shape.return_names, types.type_display_name(return_type)) }
    }
    parameter_count = len(shape.parameter_names)
    return_count = len(shape.return_names)

    array_type = resolve_quietly(checker, arguments[0])
    element_name = array_type^.element_type

    if function_name == "map" {
        if parameter_count != 1 {
            e9004(checker, callback, function_name, "map callback must take 1 parameter, got ${parameter_count}")
        } or return_count < 1 {
            e9004(checker, callback, function_name, "map callback must return a value")
        } or return_count > 1 {
            e9004(checker, callback, function_name, "map callback must return a single value")
        } or element_name != "" && shape.parameter_names[0] != element_name {
            e9004(checker, callback, function_name, "map callback takes '${shape.parameter_names[0]}' but array element type is '${element_name}'")
        } or element_name != "" && shape.return_names[0] != element_name {
            e9004(checker, callback, function_name, "map callback must return the same type as the array element type (${element_name}), got '${shape.return_names[0]}'")
        }
    } or function_name == "filter" || function_name == "any" || function_name == "all" || function_name == "find" || function_name == "find_index" {
        if parameter_count != 1 {
            e9004(checker, callback, function_name, "${function_name} callback must take 1 parameter, got ${parameter_count}")
        } or return_count < 1 || shape.return_names[0] != "bool" {
            e9004(checker, callback, function_name, "${function_name} callback must return bool")
        } or element_name != "" && shape.parameter_names[0] != element_name {
            e9004(checker, callback, function_name, "${function_name} callback takes '${shape.parameter_names[0]}' but array element type is '${element_name}'")
        }
    } or function_name == "sort_by" {
        if parameter_count != 2 {
            e9004(checker, callback, function_name, "sort_by callback must take 2 parameters, got ${parameter_count}")
        } or return_count < 1 || shape.return_names[0] != "bool" {
            e9004(checker, callback, function_name, "sort_by callback must return bool")
        } or element_name != "" && (shape.parameter_names[0] != element_name || shape.parameter_names[1] != element_name) {
            e9004(checker, callback, function_name, "sort_by callback must take two '${element_name}' parameters to match the array element type")
        }
    } otherwise {
        // reduce
        if parameter_count != 2 {
            e9004(checker, callback, function_name, "reduce callback must take 2 parameters, got ${parameter_count}")
        } or return_count < 1 {
            e9004(checker, callback, function_name, "reduce callback must return a value")
        } or element_name != "" && shape.parameter_names[1] != element_name {
            e9004(checker, callback, function_name, "reduce callback's element parameter takes '${shape.parameter_names[1]}' but array element type is '${element_name}'")
        } or len(arguments) > 1 {
            initializer = arguments[1]
            mut initializer_name = types.type_display_name(resolve_quietly(checker, initializer))
            // A bare literal keeps its literal type in the type table
            if initializer^.kind == ast.NodeKind.INT_VALUE { initializer_name = "integer literal" }
            if initializer^.kind == ast.NodeKind.FLOAT_VALUE { initializer_name = "decimal literal" }
            return_kind = checker_type_from_name(checker, shape.return_names[0])^.kind
            // A bare literal always types as plain i64/f64, so one of the right numeric
            // family is coercible to any return type in that family
            is_loose_literal_valid = (initializer^.kind == ast.NodeKind.INT_VALUE && (return_kind == types.TypeKind.INT || return_kind == types.TypeKind.UINT)) || (initializer^.kind == ast.NodeKind.FLOAT_VALUE && return_kind == types.TypeKind.FLOAT)
            if shape.return_names[0] != initializer_name && !is_loose_literal_valid {
                e9004(checker, callback, function_name, "reduce callback must return the same type as the accumulator (${initializer_name})")
            }
        }
    }
}

// The checks on an arrays call beyond its argument kinds: element types the
// numeric, ordering and hashing functions accept (the element type errors),
// the callback of the higher-order ones, and the array argument itself.
fn check_arrays_call_extras(checker ^TypeChecker, node ^ast.AstNode, name string) {
    arguments = node^.call^.args
    if len(arguments) == 0 { return }
    first_argument = arguments[0]
    first_type = resolve_quietly(checker, first_argument)
    mut element_name string = ""
    mut element_type ^types.GrayType = checker^.pool^.type_unknown
    if first_type^.kind == types.TypeKind.ARRAY && first_type^.element_type != "" {
        element_name = first_type^.element_type
        element_type = checker_type_from_name(checker, element_name)
    }
    if element_name != "" {
        if name == "sum" || name == "min" || name == "max" || name == "get_sum" || name == "get_min" || name == "get_max" || name == "min_index" || name == "max_index" {
            is_integer_enum = element_type^.kind == types.TypeKind.ENUM && !enum_is_string(checker, element_type^.name)
            if !types.type_is_numeric(element_type) && !is_integer_enum {
                add_diagnostic(checker, "E9002", error_registry.registry_message_formatted("E9002", {name, element_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
            }
        }
        if name == "binary_search" || name == "sort_asc" || name == "sort_desc" || name == "is_sorted" {
            orderable = types.type_is_numeric(element_type) || element_type^.kind == types.TypeKind.STRING || element_type^.kind == types.TypeKind.BOOL || element_type^.kind == types.TypeKind.ENUM
            if !orderable {
                add_diagnostic(checker, "E9007", error_registry.registry_message_formatted("E9007", {name, element_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
            }
        }
        if name == "counts" {
            resolved_name = resolve_type_alias(checker, element_name)
            resolved_element = checker_type_from_name(checker, resolved_name)
            is_struct = resolved_element^.kind == types.TypeKind.STRUCT && !is_enum_name(checker, resolved_name)
            if is_struct || resolved_element^.kind == types.TypeKind.ARRAY || resolved_element^.kind == types.TypeKind.MAP || resolved_element^.kind == types.TypeKind.POINTER {
                add_diagnostic(checker, "E3057", error_registry.registry_message_formatted("E3057", {resolved_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
            }
        }
        if name == "average" && !types.type_is_numeric(element_type) {
            add_diagnostic(checker, "E9002", error_registry.registry_message_formatted("E9002", {name, element_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
        }
        if (name == "is_equal" && len(arguments) >= 2) || (name == "contains" && len(arguments) >= 1) {
            if element_type^.kind == types.TypeKind.ARRAY || element_type^.kind == types.TypeKind.MAP || element_type^.kind == types.TypeKind.STRUCT {
                if name == "is_equal" {
                    add_diagnostic(checker, "E5058", error_registry.registry_message_formatted("E5058", {"arrays", "array elements", element_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
                } otherwise {
                    add_diagnostic(checker, "E9006", error_registry.registry_message_formatted("E9006", {element_name}), first_argument^.tok.file, first_argument^.tok.line, first_argument^.tok.col)
                }
            }
        }
    }
    if (name == "map" || name == "filter" || name == "reduce" || name == "any" || name == "all" || name == "find" || name == "find_index" || name == "sort_by") && len(arguments) >= 2 {
        check_arrays_callback(checker, node, name)
    }
    // All arrays functions expect an array as the first argument
    if first_type^.kind != types.TypeKind.ARRAY && first_type^.kind != types.TypeKind.UNKNOWN {
        report_argument_type(checker, first_argument, 1, "arrays.${name}", "an array", shown_type(checker, first_type))
    }
}

// A private struct function called from outside its struct.
fn reject_private_struct_function(checker ^TypeChecker, node ^ast.AstNode, signature ^FuncSig, struct_name string, member string) {
    if signature == nil || !signature^.is_private || checker^.current_struct_name == struct_name { return }
    add_diagnostic(checker, "E4017", error_registry.registry_message_formatted("E4017", {struct_display_name(checker, struct_name), member}), node^.tok.file, node^.tok.line, node^.tok.col)
}

// The tagged enum a printed value contains: itself, an array element, a map value,
// or a struct field, at any depth, or "". A pointer prints as an address and is not
// followed; the depth bound ends a struct that contains itself by value.
fn tagged_enum_in_printed_type(checker ^TypeChecker, printed_type ^types.GrayType, depth i64) -> string {
    if printed_type == nil || depth > MAX_TYPE_DISPLAY_DEPTH { return "" }
    if printed_type^.kind == types.TypeKind.ENUM {
        if printed_type^.name != "" && enum_is_tagged(checker, printed_type^.name) { return printed_type^.name }
        return ""
    }
    if printed_type^.kind == types.TypeKind.ARRAY && printed_type^.element_type != "" {
        return tagged_enum_in_printed_type(checker, checker_type_from_name(checker, printed_type^.element_type), depth + 1)
    }
    if printed_type^.kind == types.TypeKind.MAP && printed_type^.value_type != "" {
        return tagged_enum_in_printed_type(checker, checker_type_from_name(checker, printed_type^.value_type), depth + 1)
    }
    if printed_type^.kind == types.TypeKind.STRUCT && printed_type^.name != "" {
        info = find_struct(checker, printed_type^.name)
        if info == nil { return "" }
        for_each field_type in info^.field_types {
            found = tagged_enum_in_printed_type(checker, field_type, depth + 1)
            if found != "" { return found }
        }
    }
    return ""
}

// The module variable or constant a qualified `mod.NAME` reference names: the
// resolver rewrote it to a label holding the mangled name and kept the qualifier.
fn qualified_module_symbol(checker ^TypeChecker, expression ^ast.AstNode) -> ^scope.Symbol {
    if expression == nil || expression^.kind != ast.NodeKind.LABEL || expression^.label^.qualifier == "" { return nil }
    return scope.scope_lookup(checker^.current_scope, expression^.label^.value)
}

// The `mod.NAME` reference a member/index chain starts from, or nil when it starts
// from anything else (a dereference ends the walk).
fn target_root_module_reference(checker ^TypeChecker, target ^ast.AstNode) -> ^ast.AstNode {
    mut current = target
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.LABEL {
            if qualified_module_symbol(checker, current) != nil { return current }
            return nil
        }
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            current = current^.index_data^.left
        } otherwise {
            return nil
        }
    }
    return nil
}

// A write that changes a `mut` module variable through a qualified path: a
// reassignment, a write to one of its fields or elements, a mutating array or map
// function, or its address. The variable is read-only from outside its module.
#[discard]
fn report_write_to_module_variable(checker ^TypeChecker, report_node ^ast.AstNode, place ^ast.AstNode) -> bool {
    reference = target_root_module_reference(checker, place)
    if reference == nil { return false }
    symbol = qualified_module_symbol(checker, reference)
    if symbol == nil || !symbol^.mutable { return false }
    add_diagnostic(checker, "E6008", error_registry.registry_message_formatted("E6008", {reference^.label^.qualifier, reference^.label^.qualified_member, "variable"}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
    return true
}

// A mutating array, map or string-builder function whose container is
// reached through an immutable binding (a constant or a by-value parameter),
// directly or through a field or index. A chain rooted at a pointer is left
// alone: the pointee is independent of the binding.
fn report_write_to_const_container(checker ^TypeChecker, report_node ^ast.AstNode, container ^ast.AstNode, kind string) {
    if report_write_to_module_variable(checker, report_node, container) { return }
    root = assignment_target_root_name(container)
    if root == "" { return }
    symbol = scope.scope_lookup(checker^.current_scope, root)
    if symbol == nil || symbol^.mutable { return }
    if container^.kind != ast.NodeKind.LABEL && symbol^.sym_type != nil && symbol^.sym_type^.kind == types.TypeKind.POINTER { return }
    add_diagnostic(checker, "E5007", error_registry.registry_message_formatted("E5007", {kind, assignment_target_root_display(container)}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
}

// A literal or call result passed to a stdlib function's mutable (&) parameter.
// The mutation lands on a temporary and is lost. A named place is left to the const
// checks the stdlib call path already runs.
fn report_temporary_for_stdlib_mutable_parameter(checker ^TypeChecker, argument ^ast.AstNode, parameter_name string, module_name string, function_name string) {
    if argument^.kind == ast.NodeKind.LABEL { return }
    if argument^.kind == ast.NodeKind.POSTFIX_EXPR && argument^.postfix^.op == token.TokenKind.CARET { return }
    if (argument^.kind == ast.NodeKind.MEMBER_EXPR || argument^.kind == ast.NodeKind.INDEX_EXPR) && !chain_rooted_at_temporary(argument) { return }
    check_mutable_argument(checker, argument, "mutable parameter '${parameter_name}'", "${module_name}.${function_name}")
}

// The name of the length-changing `arrays.*` function `node` calls with `parameter_name`
// as its first argument, or "".
fn length_changing_call_on_name(checker ^TypeChecker, node ^ast.AstNode, parameter_name string) -> string {
    if node^.kind != ast.NodeKind.CALL_EXPR { return "" }
    function_node = node^.call^.function
    if function_node == nil || function_node^.kind != ast.NodeKind.MEMBER_EXPR || function_node^.member^.object^.kind != ast.NodeKind.LABEL { return "" }
    if resolve_import_alias(checker, function_node^.member^.object^.label^.value) != "arrays" { return "" }
    name = function_node^.member^.member
    if !(name == "append" || name == "prepend" || name == "insert_at" || name == "remove" || name == "remove_at" || name == "remove_first" || name == "remove_last" || name == "clear" || name == "deduplicate") { return "" }
    if len(node^.call^.args) == 0 { return "" }
    first_argument = node^.call^.args[0]
    if first_argument^.kind != ast.NodeKind.LABEL || first_argument^.label^.value != parameter_name { return "" }
    return name
}

// The first length-changing `arrays.*` call made directly on `parameter_name` anywhere in
// a function body, or "".
fn body_mutates_array_parameter(checker ^TypeChecker, node ^ast.AstNode, parameter_name string) -> string {
    if node == nil { return "" }
    mut children [^ast.AstNode] = {}
    #strict
    when node^.kind {
        is ast.NodeKind.CALL_EXPR {
            found = length_changing_call_on_name(checker, node, parameter_name)
            if found != "" { return found }
            children = node^.call^.args
        }
        is ast.NodeKind.VAR_DECL { arrays.append(children, node^.var_decl^.value) }
        is ast.NodeKind.ASSIGN_STMT { arrays.append(children, node^.assign^.value) }
        is ast.NodeKind.BLOCK_STMT { children = node^.block^.stmts }
        is ast.NodeKind.IF_STMT {
            arrays.append(children, node^.if_stmt^.consequence)
            arrays.append(children, node^.if_stmt^.alternative)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { arrays.append(children, case_entry.body) }
            arrays.append(children, node^.when_stmt^.default_body)
        }
        is ast.NodeKind.FOR_STMT { arrays.append(children, node^.for_stmt^.body) }
        is ast.NodeKind.FOR_EACH_STMT { arrays.append(children, node^.for_each_stmt^.body) }
        is ast.NodeKind.WHILE_STMT { arrays.append(children, node^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { arrays.append(children, node^.loop_stmt^.body) }
        is ast.NodeKind.EXPR_STMT { arrays.append(children, node^.expr_stmt^.expr) }
        is ast.NodeKind.ENSURE_STMT { arrays.append(children, node^.ensure_stmt^.expr) }
        is ast.NodeKind.RETURN_STMT { children = node^.return_stmt^.values }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.INDEX_EXPR, ast.NodeKind.MEMBER_EXPR,
        ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF,
        ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN, ast.NodeKind.BREAK_STMT,
        ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT,
        ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
    for_each child in children {
        found_in_child = body_mutates_array_parameter(checker, child, parameter_name)
        if found_in_child != "" { return found_in_child }
    }
    return ""
}

// The declared size of the fixed-size struct field a member expression names (`w.items`
// where `items` is `[i64,3]` gives 3), reached through any member chain or a pointer;
// 0 for anything else.
fn member_expression_fixed_array_field_size(checker ^TypeChecker, expression ^ast.AstNode) -> i64 {
    if expression == nil || expression^.kind != ast.NodeKind.MEMBER_EXPR { return 0 }
    object_type = resolve_expression(checker, expression^.member^.object)
    mut struct_name = ""
    if object_type^.kind == types.TypeKind.STRUCT { struct_name = object_type^.name }
    if object_type^.kind == types.TypeKind.POINTER { struct_name = object_type^.element_type }
    if struct_name == "" { return 0 }
    info = find_struct(checker, struct_name)
    if info == nil { return 0 }
    for index in range(0, len(info^.field_names)) {
        if info^.field_names[index] == expression^.member^.member && index < len(info^.field_spellings) {
            return fixed_array_declared_size(info^.field_spellings[index])
        }
    }
    return 0
}

fn check_stdlib_mutation(checker ^TypeChecker, node ^ast.AstNode, signature ^stdlib_sigs.StdlibSig) {
    if len(node^.call^.args) == 0 { return }
    first_argument = node^.call^.args[0]
    name = signature^.name
    if signature^.module == "arrays" {
        check_arrays_call_extras(checker, node, name)
        if name == "append" || name == "insert_at" || name == "remove" || name == "remove_at" || name == "remove_last" || name == "remove_first" || name == "prepend" || name == "fill" || name == "swap" || name == "sort_asc" || name == "sort_desc" || name == "sort_by" || name == "clear" {
            report_write_to_const_container(checker, node, first_argument, "array")
            report_temporary_for_stdlib_mutable_parameter(checker, first_argument, "arr", "arrays", name)
        }
        // A length-changing function on a fixed-size struct field, which never
        // changes length whether or not the instance is mut
        if (name == "append" || name == "prepend" || name == "insert_at" || name == "remove" || name == "remove_at" || name == "remove_first" || name == "remove_last" || name == "clear" || name == "deduplicate") && first_argument^.kind == ast.NodeKind.MEMBER_EXPR && member_expression_fixed_array_field_size(checker, first_argument) > 0 {
            add_diagnostic(checker, "E5051", error_registry.registry_message_formatted("E5051", {name, first_argument^.member^.member}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        // `fill` is length-changing too, but a count equal to the field's declared size is a
        // legitimate in-place refill
        if name == "fill" && len(node^.call^.args) >= 3 {
            fixed_size = member_expression_fixed_array_field_size(checker, first_argument)
            if fixed_size > 0 {
                count_argument = node^.call^.args[2]
                count_matches bool = count_argument^.kind == ast.NodeKind.INT_VALUE && count_argument^.int_value^.value == fixed_size
                if !count_matches {
                    add_diagnostic(checker, "E5051", error_registry.registry_message_formatted("E5051", {name, first_argument^.member^.member}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }
    } or signature^.module == "maps" {
        if name == "clear" || name == "remove_key" || name == "get_or_insert" || name == "get_and_remove" {
            report_write_to_const_container(checker, node, first_argument, "map")
            report_temporary_for_stdlib_mutable_parameter(checker, first_argument, "m", "maps", name)
        }
    } or signature^.module == "strings" {
        if name == "builder_reserve" || name == "builder_append" || name == "builder_append_char" || name == "builder_append_bytes" || name == "builder_append_i64" || name == "builder_append_line" || name == "builder_clear" {
            report_temporary_for_stdlib_mutable_parameter(checker, first_argument, "b", "strings", name)
            if first_argument^.kind == ast.NodeKind.LABEL {
                symbol = scope.scope_lookup(checker^.current_scope, first_argument^.label^.value)
                if symbol != nil && !symbol^.mutable {
                    add_diagnostic(checker, "E5007", error_registry.registry_message_formatted("E5007", {"string builder", first_argument^.label^.value}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }
    }
}

// Call through a variable that holds a typed func reference
// (`f(x)` where `f` was bound from `()name` or declared `func(int)->int`).
fn resolve_func_variable_call(checker ^TypeChecker, node ^ast.AstNode, name string, symbol ^scope.Symbol) -> ^types.GrayType {
    symbol^.used = true
    // The signature is parsed again here: the cached one holds strings that
    // dangle by now.
    fsig = types.parse_func_sig(symbol^.sym_type^.name)
    if fsig == nil { return resolve_call_args_only(checker, node) }
    // codegen casts the called value to this signature
    node^.call^.function^.resolved_type = symbol^.sym_type^.name

    arguments = node^.call^.args
    // A call through a reference names the referenced function in its diagnostics
    mut called_name = name
    if symbol^.func_ref_name != "" {
        named_function = find_func(checker, symbol^.func_ref_name)
        if named_function != nil { called_name = shown_function_name(named_function, named_function^.name) }
    }
    // A reference to a function with default parameters may be called with fewer arguments
    mut minimum_arguments i64 = fsig^.param_count
    if symbol^.func_ref_name != "" {
        referenced = find_func(checker, symbol^.func_ref_name)
        if referenced != nil && referenced^.min_args < minimum_arguments { minimum_arguments = referenced^.min_args }
    }
    if len(arguments) < minimum_arguments || len(arguments) > fsig^.param_count {
        mut expected_count = "${fsig^.param_count}"
        if minimum_arguments != fsig^.param_count { expected_count = "${minimum_arguments} to ${fsig^.param_count}" }
        message = error_registry.registry_message_formatted("E5008", {called_name, expected_count, "${len(arguments)}"})
        add_diagnostic(checker, "E5008", message, node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    for i in range(0, len(arguments)) {
        param_t = checker_type_from_name(checker, fsig^.param_types[i])
        arg_t = check_expression_as(checker, arguments[i], param_t)
        if arg_t^.kind != types.TypeKind.UNKNOWN && param_t^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, param_t, arg_t) && !(arg_t^.kind == types.TypeKind.NIL_TYPE && (param_t^.kind == types.TypeKind.POINTER || param_t^.kind == types.TypeKind.ERROR)) {
            message = error_registry.registry_message_formatted("E5026", {"${i + 1}", called_name, shown_type(checker, param_t), shown_type(checker, arg_t)})
            arg_type_error(checker, arguments[i], message)
        }
        // An `&` parameter needs an assignment target, whether the signature comes
        // from the referenced function or from the variable's annotated type
        mut referenced_for_mutation ^FuncSig = nil
        if symbol^.func_ref_name != "" { referenced_for_mutation = find_func(checker, symbol^.func_ref_name) }
        if referenced_for_mutation != nil && referenced_for_mutation^.decl != nil {
            if i < len(referenced_for_mutation^.decl^.params) && referenced_for_mutation^.decl^.params[i].is_mutable {
                check_mutable_argument(checker, arguments[i], "mutable parameter '${referenced_for_mutation^.decl^.params[i].name}'", referenced_for_mutation^.name)
            }
        } or i < len(fsig^.param_mutable) && fsig^.param_mutable[i] {
            check_mutable_argument(checker, arguments[i], "'&' parameter ${i + 1}", name)
        }
    }
    // omitted trailing arguments take the referenced function's defaults
    if symbol^.func_ref_name != "" && len(arguments) < fsig^.param_count {
        referenced_function = find_func(checker, symbol^.func_ref_name)
        if referenced_function != nil && referenced_function^.decl != nil {
            declared_parameters = referenced_function^.decl^.params
            mut filled [^ast.AstNode] = {}
            for_each given in arguments { arrays.append(filled, given) }
            for slot in range(len(arguments), len(declared_parameters)) {
                if declared_parameters[slot].default_value != nil { arrays.append(filled, declared_parameters[slot].default_value) }
            }
            node^.call^.args = filled
        }
    }
    if fsig^.return_count > 0 { return checker_type_from_name(checker, fsig^.return_types[0]) }
    return checker^.pool^.type_void
}

// True when `value` names a variable bound from `ref(...)`, which reads through the
// pointer it holds and so may be stored into a pointer slot.
fn is_ref_variable(checker ^TypeChecker, value ^ast.AstNode) -> bool {
    if value == nil || value^.kind != ast.NodeKind.LABEL { return false }
    value_symbol = scope.scope_lookup(checker^.current_scope, value^.label^.value)
    return value_symbol != nil && value_symbol^.is_ref
}

// A `&self` struct function called on a constant. A dereferenced pointer receiver
// mutates the pointee, so the binding itself may be const; that case is left to the
// pointer-to-const check.
fn check_mutable_receiver(checker ^TypeChecker, node ^ast.AstNode, signature ^FuncSig, receiver_symbol ^scope.Symbol, receiver ^ast.AstNode, struct_name string, function_member string) {
    if signature^.decl == nil || len(signature^.decl^.params) == 0 || !signature^.decl^.params[0].is_mutable { return }
    is_dereferenced_receiver bool = receiver^.kind == ast.NodeKind.POSTFIX_EXPR || receiver_symbol != nil && receiver_symbol^.sym_type^.kind == types.TypeKind.POINTER
    if receiver_symbol != nil && !receiver_symbol^.mutable && !is_dereferenced_receiver {
        add_diagnostic(checker, "E3027", error_registry.registry_message_formatted("E3027", {"a constant", "the mutable self parameter", "${struct_display_name(checker, struct_name)}.${function_member}"}), node^.tok.file, node^.tok.line, node^.tok.col)
    } otherwise {
        // A pointer receiver is passed dereferenced, so the write goes through it
        mut written_place = receiver
        if receiver_symbol != nil && receiver_symbol^.sym_type^.kind == types.TypeKind.POINTER && receiver^.kind != ast.NodeKind.POSTFIX_EXPR {
            deref_data = new(ast.PostfixData)
            deref_data^.left = receiver
            deref_data^.op = token.TokenKind.CARET
            written_place = ast.ast_alloc(ast.NodeKind.POSTFIX_EXPR, node^.tok)
            written_place^.postfix = deref_data
        }
        report_write_through_const_pointer(checker, node, written_place)
    }
}

// `instance.f(arguments)` becomes `Type.f(instance, arguments)`, the form codegen emits:
// the instance leads the arguments and the callee names the struct.
fn retarget_instance_call(node ^ast.AstNode, instance ^ast.AstNode, struct_name string, instance_type string) {
    instance^.resolved_type = instance_type
    type_label = ast.ast_alloc(ast.NodeKind.LABEL, instance^.tok)
    type_label_data = new(ast.LabelData)
    type_label_data^.value = struct_name
    type_label^.label = type_label_data
    node^.call^.function^.member^.object = type_label
    mut leading [^ast.AstNode] = {instance}
    for_each arg in node^.call^.args { arrays.append(leading, arg) }
    node^.call^.args = leading
    node^.call^.arg_names = {}
}

// f(arguments) / Type.f(arguments) / obj.f(arguments): registered functions (including the enclosing struct's
// namespace for a bare name inside a struct function), calls through func-reference variables,
// `Type.f()` and instance dispatch to a struct function, a call to a non-function variable and a
// call to an undefined function.
fn resolve_call_expr(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    // Dispatching a call rewrites it in place: `x.f()` becomes `Struct.f(x)`. A generic
    // body is checked once per instantiation on the same tree, so the first
    // instantiation's rewrite would stand for all of them. Each rewrite is kept under
    // its instantiation's bindings and the call put back as written.
    if len(checker^.generics.names) == 0 { return resolve_call_expr_once(checker, node) }
    written = ast.ast_call_form_capture(node)
    result = resolve_call_expr_once(checker, node)
    dispatched = ast.ast_call_form_capture(node)
    if call_forms_match(dispatched, written) { return result }
    if checker^.generics.types[0] == "" {
        ast.ast_call_form_apply(node, written)
        return result
    }
    key = ast.generic_bindings_join(checker^.generics)
    mut slot i64 = 0
    keys = node^.call^.instantiation_keys
    for slot < len(keys) && keys[slot] != key { slot += 1 }
    if slot == len(keys) {
        arrays.append(node^.call^.instantiation_keys, key)
        arrays.append(node^.call^.instantiation_forms, dispatched)
    } otherwise {
        node^.call^.instantiation_forms[slot] = dispatched
    }
    ast.ast_call_form_apply(node, written)
    return result
}

// True when two call shapes are the same call.
fn call_forms_match(left ast.CallForm, right ast.CallForm) -> bool {
    if left.function != right.function || left.object != right.object || left.object_label != right.object_label || left.ignored_receiver != right.ignored_receiver { return false }
    if len(left.arguments) != len(right.arguments) { return false }
    for index in range(0, len(left.arguments)) {
        if left.arguments[index] != right.arguments[index] { return false }
    }
    return true
}

fn resolve_call_expr_once(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    result = resolve_call_expr_unchecked(checker, node)
    check_call_escape(checker, node)
    apply_call_parameter_write_effects(checker, node)
    apply_call_parameter_extern_effects(checker, node)
    apply_call_mem_effects(checker, node)
    return result
}

// An error at a call: a pointer to a const-declared variable passed where the callee
// writes through it. Covers the stdlib writers (atomic.*, mem.*) and a user
// function whose summary writes through the parameter.
fn apply_call_parameter_write_effects(checker ^TypeChecker, node ^ast.AstNode) {
    writer_module, writer_parameter, writer_is_container = pointer_writer_parameter(checker, node)
    if writer_module != "" && !writer_is_container {
        argument = node^.call^.args[0]
        if expression_points_to_const(checker, argument) {
            display_name = "${writer_module}.${node^.call^.function^.member^.member}"
            add_diagnostic(checker, "E3193", error_registry.registry_message_formatted("E3193", {writer_parameter, display_name}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
        }
    }
    signature = resolve_call_signature(checker, node)
    if signature == nil || signature^.decl == nil { return }
    ensure_escape_summary(checker, signature)
    if signature^.writes_through_parameter == 0 { return }
    arguments = node^.call^.args
    for index in range(0, len(signature^.param_types)) {
        if index >= len(arguments) || index >= MAX_TRACKED_PARAMETERS { break }
        if signature^.writes_through_parameter bit_and (1 bit_shift_left index) == 0 { continue }
        argument = arguments[index]
        if is_pointer_to_pointer(const_walk_expression_type(checker, argument)) { continue }
        // Instance dispatch passes the receiver by address: `cb.grow()` is `Box.grow(addr(cb))`
        mut is_const_argument = expression_points_to_const(checker, argument)
        mut report_at ^ast.AstNode = argument
        if index == 0 && signature^.param_types[0]^.kind == types.TypeKind.POINTER && const_walk_expression_type(checker, argument)^.kind != types.TypeKind.POINTER {
            is_const_argument = address_of_place_points_to_const(checker, argument)
            report_at = node
        }
        if !is_const_argument { continue }
        add_diagnostic(checker, "E3193", error_registry.registry_message_formatted("E3193", {signature^.decl^.params[index].name, signature^.decl^.name}), report_at^.tok.file, report_at^.tok.line, report_at^.tok.col)
    }
}

// The place an `addr(x)` / `raw(x)` argument takes the address of; any other argument as is.
fn unwrap_address_argument(argument ^ast.AstNode) -> ^ast.AstNode {
    if argument != nil && argument^.kind == ast.NodeKind.CALL_EXPR && argument^.call^.function != nil && argument^.call^.function^.kind == ast.NodeKind.LABEL && (argument^.call^.function^.label^.value == "addr" || argument^.call^.function^.label^.value == "raw") && len(argument^.call^.args) == 1 {
        return argument^.call^.args[0]
    }
    return argument
}

// --- @mem arena lifetime tracking ---
//
// checker^.arenas holds one ArenaLifetime per @mem arena variable seen in the
// function being checked. mem.destroy() marks it destroyed; mem.reset() bumps its
// epoch. A pointer bound from mem.init()/mem.alloc() records the arena and the
// epoch at binding on its Symbol; dereferencing it after the arena is destroyed is
// an error, after a reset past that epoch another error. A destroy or reset of an
// already-destroyed arena is an error. The state is flow-sensitive: an `if`/`when`
// snapshots it, checks each arm from the snapshot, then joins (destroyed on any
// path wins, the epoch is the larger). Loops pre-mark the arenas their body
// destroys or resets.

const ArenaLifetime struct {
    name string
    is_destroyed bool
    // Destroyed or reset by a loop body: a dereference on a later iteration is caught
    is_premarked_destroyed bool
    // `ensure mem.destroy(a)` runs at scope exit, whatever happens before
    is_ensure_destroy_pending bool
    // Torn down anywhere in the function body (for the escape check)
    is_destroyed_in_function bool
    epoch i64
}

fn arena_index(checker ^TypeChecker, name string) -> i64 {
    arenas = checker^.arenas
    for index in range(0, len(arenas)) {
        if arenas[index].name == name { return index }
    }
    return -1
}

fn arena_ensure_index(checker ^TypeChecker, name string) -> i64 {
    found = arena_index(checker, name)
    if found >= 0 { return found }
    mut arenas [ArenaLifetime] = checker^.arenas
    arrays.append(arenas, ArenaLifetime{name: name})
    checker^.arenas = arenas
    return len(arenas) - 1
}

// A stable key for an arena-handle expression: a bare variable name, or a dotted
// field chain reaching one buried in a struct ("h.a"). "" when the expression is
// not one of those.
fn arena_path_key(checker ^TypeChecker, expression ^ast.AstNode) -> string {
    if expression == nil { return "" }
    if expression^.kind == ast.NodeKind.LABEL {
        // An alias resolves to the arena it was copied from, so a lifecycle call
        // through any name reaches the one shared state
        // (not while a summary is built: the scope is the caller's then)
        symbol = scope.scope_lookup(checker^.current_scope, expression^.label^.value)
        if !checker^.is_in_mem_summary && symbol != nil && symbol^.arena_identifier != "" { return symbol^.arena_identifier }
        return expression^.label^.value
    }
    // See through `addr(a)` / `ref(a)` and a `h^` dereference
    if expression^.kind == ast.NodeKind.POSTFIX_EXPR && expression^.postfix^.op == token.TokenKind.CARET {
        return arena_path_key(checker, expression^.postfix^.left)
    }
    if expression^.kind == ast.NodeKind.CALL_EXPR {
        function_node = expression^.call^.function
        if function_node != nil && function_node^.kind == ast.NodeKind.LABEL && len(expression^.call^.args) == 1 && (function_node^.label^.value == "addr" || function_node^.label^.value == "ref") {
            return arena_path_key(checker, expression^.call^.args[0])
        }
        return ""
    }
    if expression^.kind == ast.NodeKind.MEMBER_EXPR {
        base = arena_path_key(checker, expression^.member^.object)
        if base == "" || expression^.member^.member == "" { return "" }
        path = "${base}.${expression^.member^.member}"
        mut generation i64 = 0
        for_each reassigned in checker^.reassigned_arena_paths {
            if reassigned == path { generation += 1 }
        }
        if generation > 0 { return "${path}#${generation}" }
        return path
    }
    return ""
}

// An assignment to an arena field path makes the path name a different arena from
// here on
fn retire_arena_path(checker ^TypeChecker, target ^ast.AstNode) {
    if target^.kind != ast.NodeKind.MEMBER_EXPR { return }
    key = arena_path_key(checker, target)
    if key == "" { return }
    mut paths [string] = checker^.reassigned_arena_paths
    arrays.append(paths, key)
    checker^.reassigned_arena_paths = paths
}

// A @mem lifecycle call on an arena named by a bare variable or field path:
// mem.arena / mem.init / mem.alloc / mem.reset / mem.destroy, written `mem.fn(a, ...)`
// or bare `fn(a, ...)` under `using mem`. Returns the function name, the arena key
// ("" for mem.arena, whose first argument is a size) and whether it is one.
fn mem_call_parts(checker ^TypeChecker, call ^ast.AstNode) -> (string, string, bool) {
    if call == nil || call^.kind != ast.NodeKind.CALL_EXPR || len(call^.call^.args) < 1 { return "", "", false }
    function_node = call^.call^.function
    mut function_name = ""
    if function_node^.kind == ast.NodeKind.MEMBER_EXPR && function_node^.member^.object != nil && function_node^.member^.object^.kind == ast.NodeKind.LABEL && function_node^.member^.object^.label^.value == "mem" {
        function_name = function_node^.member^.member
    } or function_node^.kind == ast.NodeKind.LABEL {
        if arrays.contains(checker^.using_modules, "mem") { function_name = function_node^.label^.value }
    }
    if function_name != "arena" && function_name != "init" && function_name != "alloc" && function_name != "reset" && function_name != "destroy" { return "", "", false }
    if function_name == "arena" { return function_name, "", true }
    arena_key = arena_path_key(checker, call^.call^.args[0])
    if arena_key == "" { return "", "", false }
    return function_name, arena_key, true
}

// Applies a destroy or reset to the arena's state, reporting an error when it is already
// destroyed. `display_text` is the call spelling for the message.
fn apply_arena_lifecycle(checker ^TypeChecker, arena_name string, is_destroy bool, report_node ^ast.AstNode, display_text string) {
    index = arena_ensure_index(checker, arena_name)
    mut arenas [ArenaLifetime] = checker^.arenas
    // A destroy scheduled by `ensure` still runs at scope exit, so an explicit destroy
    // after it is a second destroy; a reset is unaffected
    if arenas[index].is_destroyed || is_destroy && arenas[index].is_ensure_destroy_pending {
        add_diagnostic(checker, "E3166", error_registry.registry_message_formatted("E3166", {display_text, arena_name, arena_name}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
        return
    }
    if is_destroy {
        arenas[index].is_destroyed = true
    } otherwise {
        arenas[index].epoch += 1
    }
    checker^.arenas = arenas
}

// `ensure mem.destroy(a)`: the destroy is pending rather than applied, since the
// arena stays usable until the function returns; only a second destroy is the
// double free.
fn apply_ensure_mem_call(checker ^TypeChecker, call ^ast.AstNode, report_node ^ast.AstNode) {
    function_name, arena, is_mem_call = mem_call_parts(checker, call)
    if !is_mem_call || arena == "" || function_name != "destroy" { return }
    index = arena_ensure_index(checker, arena)
    mut arenas [ArenaLifetime] = checker^.arenas
    mut display_text = function_name
    if call^.call^.function^.kind == ast.NodeKind.MEMBER_EXPR { display_text = "mem.destroy" }
    if arenas[index].is_destroyed || arenas[index].is_ensure_destroy_pending {
        add_diagnostic(checker, "E3166", error_registry.registry_message_formatted("E3166", {display_text, arena, arena}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
        return
    }
    arenas[index].is_ensure_destroy_pending = true
    checker^.arenas = arenas
}

// A @mem lifecycle call used as a statement or assigned to `bind_name`.
fn apply_mem_call(checker ^TypeChecker, call ^ast.AstNode, report_node ^ast.AstNode, bind_name string) {
    function_name, arena, is_mem_call = mem_call_parts(checker, call)
    if !is_mem_call { return }
    if function_name == "arena" {
        if bind_name != "" {
            index = arena_ensure_index(checker, bind_name)
            mut arenas [ArenaLifetime] = checker^.arenas
            arenas[index].is_destroyed = false
            arenas[index].epoch = 0
            checker^.arenas = arenas
        }
        return
    }
    if arena == "" { return }
    if function_name == "destroy" || function_name == "reset" {
        mut display_text = function_name
        if call^.call^.function^.kind == ast.NodeKind.MEMBER_EXPR { display_text = "mem.${function_name}" }
        apply_arena_lifecycle(checker, arena, function_name == "destroy", report_node, display_text)
    }
}

// The @mem arena an expression's pointer is bound to: a direct mem.init()/mem.alloc()
// call, a variable already bound to one, or a literal with such a value buried in a
// field or element. Returns the arena key, the epoch at binding, whether the pointer
// is buried in a field, and whether there was a match.
fn mem_pointer_in_expression(checker ^TypeChecker, value ^ast.AstNode) -> (string, i64, bool, bool) {
    if value == nil { return "", 0, false, false }
    if value^.kind == ast.NodeKind.CALL_EXPR {
        function_name, arena, is_mem_call = mem_call_parts(checker, value)
        if is_mem_call && arena != "" && (function_name == "init" || function_name == "alloc") {
            index = arena_ensure_index(checker, arena)
            return arena, checker^.arenas[index].epoch, false, true
        }
        if is_tagged_enum_variant_call(checker, value) {
            for_each argument in value^.call^.args {
                inner_arena, inner_epoch, _, inner_found = mem_pointer_in_expression(checker, argument)
                if inner_found { return inner_arena, inner_epoch, true, true }
            }
            return "", 0, false, false
        }
        callee_arena, callee_epoch, callee_via_field, callee_found = mem_pointer_from_callee(checker, value)
        return callee_arena, callee_epoch, callee_via_field, callee_found
    }
    if value^.kind == ast.NodeKind.LABEL {
        source_symbol = scope.scope_lookup(checker^.current_scope, value^.label^.value)
        if source_symbol == nil { return "", 0, false, false }
        if source_symbol^.mem_arena != "" { return source_symbol^.mem_arena, source_symbol^.mem_epoch, false, true }
        if source_symbol^.field_mem_arena != "" { return source_symbol^.field_mem_arena, source_symbol^.field_mem_epoch, true, true }
        return "", 0, false, false
    }
    if value^.kind == ast.NodeKind.INDEX_EXPR || value^.kind == ast.NodeKind.MEMBER_EXPR {
        // An element or field read out of a tracked aggregate carries its buried arena,
        // but only when the slot itself is a pointer
        root = assignment_target_root_name(value)
        if root != "" {
            symbol = scope.scope_lookup(checker^.current_scope, root)
            if symbol != nil && symbol^.field_mem_arena != "" {
                value_type = resolve_expression(checker, value)
                if value_type^.kind == types.TypeKind.POINTER { return symbol^.field_mem_arena, symbol^.field_mem_epoch, false, true }
            }
        }
        return "", 0, false, false
    }
    // A struct, array or map literal: anything found inside it is buried in a field
    mut parts [^ast.AstNode] = {}
    when value^.kind {
        is ast.NodeKind.STRUCT_VALUE { parts = value^.struct_value^.field_values }
        is ast.NodeKind.ARRAY_VALUE { parts = value^.array_value^.elements }
        is ast.NodeKind.MAP_VALUE { parts = value^.map_value^.values }
        default { return "", 0, false, false }
    }
    for_each part in parts {
        inner_arena, inner_epoch, _, inner_found = mem_pointer_in_expression(checker, part)
        if inner_found { return inner_arena, inner_epoch, true, true }
    }
    return "", 0, false, false
}

// Records on a freshly declared symbol that it points into a @mem arena, or that it is
// an aggregate carrying such a pointer in a field or element.
fn bind_mem_pointer(checker ^TypeChecker, symbol ^scope.Symbol, value ^ast.AstNode) {
    if symbol == nil || value == nil { return }
    arena, epoch, via_field, found = mem_pointer_in_expression(checker, value)
    if !found { return }
    // A call's result is ambiguous here: a single-return call's result is the symbol
    // itself, a multi-return call's is a temp whose slots are read as fields. Bind both.
    if value^.kind == ast.NodeKind.CALL_EXPR {
        symbol^.mem_arena = arena
        symbol^.mem_epoch = epoch
        symbol^.field_mem_arena = arena
        symbol^.field_mem_epoch = epoch
        return
    }
    if via_field {
        symbol^.field_mem_arena = arena
        symbol^.field_mem_epoch = epoch
    } otherwise {
        symbol^.mem_arena = arena
        symbol^.mem_epoch = epoch
    }
}

// Records an arena handle identity on a freshly bound symbol: a fresh
// `mut a = mem.arena(n)`, or an alias of an existing handle (`mut b mem.Arena = a`,
// `mut h ^mem.Arena = addr(a)`, `mut b = holder.a`).
fn bind_arena_handle(checker ^TypeChecker, symbol ^scope.Symbol, value ^ast.AstNode, bind_name string) {
    if symbol == nil || value == nil || bind_name == "" { return }
    function_name, _, is_mem_call = mem_call_parts(checker, value)
    if value^.kind == ast.NodeKind.CALL_EXPR && is_mem_call && function_name == "arena" {
        symbol^.arena_identifier = bind_name
        return
    }
    source_name = arena_path_key(checker, value)
    if source_name != "" && arena_index(checker, source_name) >= 0 { symbol^.arena_identifier = source_name }
}

// A dereference `pointer^` (also `p^.field`, `p^[i]`): when the pointer roots at a
// @mem-bound one, its arena must still be alive.
fn check_mem_deref(checker ^TypeChecker, pointer_expression ^ast.AstNode, report_node ^ast.AstNode) {
    mut inner ^ast.AstNode = pointer_expression
    as_long_as inner != nil && inner^.kind == ast.NodeKind.POSTFIX_EXPR && inner^.postfix^.op == token.TokenKind.CARET {
        inner = inner^.postfix^.left
    }
    is_bare bool = inner != nil && inner^.kind == ast.NodeKind.LABEL
    mut root = ""
    if is_bare {
        root = inner^.label^.value
    } otherwise {
        root = assignment_target_root_name(inner)
    }
    if root == "" { return }
    symbol = scope.scope_lookup(checker^.current_scope, root)
    if symbol == nil { return }
    mut arena = symbol^.field_mem_arena
    mut bound_epoch = symbol^.field_mem_epoch
    if is_bare {
        arena = symbol^.mem_arena
        bound_epoch = symbol^.mem_epoch
    }
    if arena == "" { return }
    index = arena_index(checker, arena)
    if index < 0 { return }
    lifetime = checker^.arenas[index]
    if lifetime.is_destroyed || lifetime.is_premarked_destroyed {
        add_diagnostic(checker, "E3164", error_registry.registry_message_formatted("E3164", {root, arena}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
    } or lifetime.epoch > bound_epoch {
        add_diagnostic(checker, "E3165", error_registry.registry_message_formatted("E3165", {root, arena}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
    }
}

// Merges `other` into the live state: an arena is destroyed after the join if it is
// destroyed on either path; its epoch is the higher of the two.
fn join_arena_state(checker ^TypeChecker, other [ArenaLifetime]) {
    mut live [ArenaLifetime] = checker^.arenas
    for index in range(0, len(other)) {
        if index >= len(live) { break }
        if other[index].is_destroyed && !live[index].is_destroyed { live[index].is_destroyed = true }
        if other[index].epoch > live[index].epoch { live[index].epoch = other[index].epoch }
    }
    checker^.arenas = live
}

// Restores the live state to a snapshot. Arena rows are append-only and any handle a
// branch declared is block-scoped, so truncating back to the snapshot is correct.
fn restore_arena_state(checker ^TypeChecker, snapshot [ArenaLifetime]) {
    checker^.arenas = snapshot
}

// Pre-marks every arena a loop body destroys or resets, so a dereference on a later
// iteration is caught. A handle declared inside the body is fresh each iteration.
fn premark_loop_body(checker ^TypeChecker, node ^ast.AstNode, body ^ast.AstNode) {
    if node == nil { return }
    #strict
    when node^.kind {
        is ast.NodeKind.CALL_EXPR {
            function_name, arena, is_mem_call = mem_call_parts(checker, node)
            if is_mem_call && arena != "" && (function_name == "destroy" || function_name == "reset") && !declared_in_subtree(body, arena) {
                index = arena_ensure_index(checker, arena)
                mut arenas [ArenaLifetime] = checker^.arenas
                if function_name == "destroy" {
                    arenas[index].is_premarked_destroyed = true
                } otherwise {
                    arenas[index].epoch += 1
                }
                checker^.arenas = arenas
            } otherwise {
                // A helper whose summary says it destroys or resets an arena passed to it
                callee = resolve_call_signature(checker, node)
                if callee != nil {
                    ensure_mem_summary(checker, callee)
                    effect = callee^.destroys_parameter_arena bit_or callee^.resets_parameter_arena
                    for argument_index in range(0, len(callee^.param_types)) {
                        if argument_index >= len(node^.call^.args) || argument_index >= MAX_TRACKED_PARAMETERS || effect == 0 { break }
                        if effect bit_and (1 bit_shift_left argument_index) == 0 { continue }
                        argument = node^.call^.args[argument_index]
                        mut root = assignment_target_root_name(argument)
                        if argument^.kind == ast.NodeKind.LABEL { root = argument^.label^.value }
                        if root == "" || declared_in_subtree(body, root) { continue }
                        arena_key = mem_forward_key(checker, argument, callee^.mem_parameter_field[argument_index])
                        if arena_key == "" { continue }
                        arena_slot = arena_ensure_index(checker, arena_key)
                        mut slot_arenas [ArenaLifetime] = checker^.arenas
                        if callee^.destroys_parameter_arena bit_and (1 bit_shift_left argument_index) != 0 {
                            slot_arenas[arena_slot].is_premarked_destroyed = true
                        } otherwise {
                            slot_arenas[arena_slot].epoch += 1
                        }
                        checker^.arenas = slot_arenas
                    }
                }
            }
            for_each argument in node^.call^.args { premark_loop_body(checker, argument, body) }
        }
        is ast.NodeKind.VAR_DECL { premark_loop_body(checker, node^.var_decl^.value, body) }
        is ast.NodeKind.ASSIGN_STMT { premark_loop_body(checker, node^.assign^.value, body) }
        is ast.NodeKind.EXPR_STMT { premark_loop_body(checker, node^.expr_stmt^.expr, body) }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts { premark_loop_body(checker, statement, body) }
        }
        is ast.NodeKind.IF_STMT {
            premark_loop_body(checker, node^.if_stmt^.consequence, body)
            premark_loop_body(checker, node^.if_stmt^.alternative, body)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { premark_loop_body(checker, case_entry.body, body) }
            premark_loop_body(checker, node^.when_stmt^.default_body, body)
        }
        is ast.NodeKind.FOR_STMT { premark_loop_body(checker, node^.for_stmt^.body, body) }
        is ast.NodeKind.FOR_EACH_STMT { premark_loop_body(checker, node^.for_each_stmt^.body, body) }
        is ast.NodeKind.WHILE_STMT { premark_loop_body(checker, node^.while_stmt^.body, body) }
        is ast.NodeKind.LOOP_STMT { premark_loop_body(checker, node^.loop_stmt^.body, body) }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.INDEX_EXPR, ast.NodeKind.MEMBER_EXPR,
        ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF,
        ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN, ast.NodeKind.RETURN_STMT,
        ast.NodeKind.ENSURE_STMT, ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT,
        ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT,
        ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

// Flags every @mem arena any statement of a function body destroys or resets, so the
// escape check does not depend on statement order.
fn premark_function_destroys(checker ^TypeChecker, node ^ast.AstNode) {
    if node == nil { return }
    #strict
    when node^.kind {
        is ast.NodeKind.CALL_EXPR {
            function_name, arena, is_mem_call = mem_call_parts(checker, node)
            if is_mem_call && arena != "" && (function_name == "destroy" || function_name == "reset") {
                index = arena_ensure_index(checker, arena)
                mut arenas [ArenaLifetime] = checker^.arenas
                arenas[index].is_destroyed_in_function = true
                checker^.arenas = arenas
            } otherwise {
                callee = resolve_call_signature(checker, node)
                if callee != nil {
                    ensure_mem_summary(checker, callee)
                    effect = callee^.destroys_parameter_arena bit_or callee^.resets_parameter_arena
                    for argument_index in range(0, len(callee^.param_types)) {
                        if argument_index >= len(node^.call^.args) || argument_index >= MAX_TRACKED_PARAMETERS || effect == 0 { break }
                        if effect bit_and (1 bit_shift_left argument_index) == 0 { continue }
                        arena_key = mem_forward_key(checker, node^.call^.args[argument_index], callee^.mem_parameter_field[argument_index])
                        if arena_key == "" { continue }
                        arena_slot = arena_ensure_index(checker, arena_key)
                        mut slot_arenas [ArenaLifetime] = checker^.arenas
                        slot_arenas[arena_slot].is_destroyed_in_function = true
                        checker^.arenas = slot_arenas
                    }
                }
            }
            for_each argument in node^.call^.args { premark_function_destroys(checker, argument) }
        }
        is ast.NodeKind.VAR_DECL { premark_function_destroys(checker, node^.var_decl^.value) }
        is ast.NodeKind.ASSIGN_STMT { premark_function_destroys(checker, node^.assign^.value) }
        is ast.NodeKind.EXPR_STMT { premark_function_destroys(checker, node^.expr_stmt^.expr) }
        is ast.NodeKind.ENSURE_STMT { premark_function_destroys(checker, node^.ensure_stmt^.expr) }
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values { premark_function_destroys(checker, value) }
        }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts { premark_function_destroys(checker, statement) }
        }
        is ast.NodeKind.IF_STMT {
            premark_function_destroys(checker, node^.if_stmt^.consequence)
            premark_function_destroys(checker, node^.if_stmt^.alternative)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { premark_function_destroys(checker, case_entry.body) }
            premark_function_destroys(checker, node^.when_stmt^.default_body)
        }
        is ast.NodeKind.FOR_STMT { premark_function_destroys(checker, node^.for_stmt^.body) }
        is ast.NodeKind.FOR_EACH_STMT { premark_function_destroys(checker, node^.for_each_stmt^.body) }
        is ast.NodeKind.WHILE_STMT { premark_function_destroys(checker, node^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { premark_function_destroys(checker, node^.loop_stmt^.body) }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.INDEX_EXPR, ast.NodeKind.MEMBER_EXPR,
        ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF,
        ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN, ast.NodeKind.BREAK_STMT,
        ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT,
        ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

// A pointer leaving the function (`return`, or a store into a global or caller-visible
// memory) that roots at a @mem pointer whose arena this function tears down dangles
// once the arena is freed.
fn check_mem_escape(checker ^TypeChecker, expression ^ast.AstNode, report_node ^ast.AstNode) {
    if expression == nil { return }
    arena, bound_epoch, _, found = mem_pointer_in_expression(checker, expression)
    if !found { return }
    index = arena_index(checker, arena)
    if index < 0 { return }
    lifetime = checker^.arenas[index]
    if !(lifetime.is_destroyed || lifetime.is_premarked_destroyed || lifetime.is_ensure_destroy_pending || lifetime.is_destroyed_in_function || lifetime.epoch > bound_epoch) { return }
    mut root = assignment_target_root_name(expression)
    if root == "" { root = arena }
    add_diagnostic(checker, "E3169", error_registry.registry_message_formatted("E3169", {root, arena}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
}

// --- Cross-function @mem summaries ---
//
// Which of a function's own arena parameters it destroys or resets (so a call to it
// applies that effect to the caller's arena state), and which of its parameters a
// returned @mem pointer was allocated from. Computed structurally from the body, like
// the escape summary.

// Index of the parameter of `signature` that `arena_key` is rooted at, and the field
// path beyond it ("h.a" against parameter "h" gives ".a"); -1 when it roots at none.
fn mem_parameter_index_for_key(signature ^FuncSig, arena_key string) -> (i64, string) {
    if signature^.decl == nil || arena_key == "" { return -1, "" }
    params = signature^.decl^.params
    for index in range(0, len(params)) {
        if index >= MAX_TRACKED_PARAMETERS { break }
        name = params[index].name
        if name == "" { continue }
        if name == arena_key { return index, "" }
        if strings.starts_with(arena_key, "${name}.") { return index, strings.slice(arena_key, len(name), len(arena_key)) }
    }
    return -1, ""
}

// The key an arena reference resolves to at a call site, given the callee's
// arena-carrying parameter's recorded field suffix.
fn mem_forward_key(checker ^TypeChecker, argument ^ast.AstNode, suffix string) -> string {
    base = arena_path_key(checker, argument)
    if base == "" { return "" }
    return "${base}${suffix}"
}

// The `signature` parameter, when `call` calls one of its own func-typed parameters.
fn call_function_typed_parameter_index(signature ^FuncSig, call ^ast.AstNode) -> i64 {
    function_node = call^.call^.function
    if function_node == nil || function_node^.kind != ast.NodeKind.LABEL || signature^.decl == nil { return -1 }
    params = signature^.decl^.params
    for index in range(0, len(params)) {
        if index >= MAX_TRACKED_PARAMETERS { break }
        if params[index].name == function_node^.label^.value {
            if strings.starts_with(params[index].type_name, "func(") { return index }
            return -1
        }
    }
    return -1
}

// A call whose target is a func value that cannot be pinned to one declaration: a func
// read from an array or map element, or one of the function's own func-typed parameters.
fn call_target_is_opaque_function(signature ^FuncSig, call ^ast.AstNode) -> bool {
    function_node = call^.call^.function
    if function_node != nil && function_node^.kind == ast.NodeKind.INDEX_EXPR { return true }
    return call_function_typed_parameter_index(signature, call) >= 0
}

fn record_mem_parameter_field(signature ^FuncSig, index i64, suffix string) {
    if suffix == "" { return }
    mut parameter_fields [string] = signature^.mem_parameter_field
    parameter_fields[index] = suffix
    signature^.mem_parameter_field = parameter_fields
}

fn mem_walk(checker ^TypeChecker, signature ^FuncSig, node ^ast.AstNode) {
    if node == nil || signature^.decl == nil { return }
    #strict
    when node^.kind {
        is ast.NodeKind.CALL_EXPR {
            function_name, arena, is_mem_call = mem_call_parts(checker, node)
            if is_mem_call && arena != "" && (function_name == "destroy" || function_name == "reset") {
                index, suffix = mem_parameter_index_for_key(signature, arena)
                if index >= 0 {
                    if function_name == "destroy" {
                        signature^.destroys_parameter_arena = signature^.destroys_parameter_arena bit_or (1 bit_shift_left index)
                    } otherwise {
                        signature^.resets_parameter_arena = signature^.resets_parameter_arena bit_or (1 bit_shift_left index)
                    }
                    record_mem_parameter_field(signature, index, suffix)
                }
            } otherwise {
                callee = resolve_call_signature_in_body(checker, signature^.decl^.body, node)
                if callee != nil && callee != signature {
                    ensure_mem_summary(checker, callee)
                    for index in range(0, len(callee^.param_types)) {
                        if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
                        bit = 1 bit_shift_left index
                        if (callee^.destroys_parameter_arena bit_or callee^.resets_parameter_arena) bit_and bit == 0 { continue }
                        arena_key = mem_forward_key(checker, node^.call^.args[index], callee^.mem_parameter_field[index])
                        if arena_key == "" { continue }
                        own_index, suffix = mem_parameter_index_for_key(signature, arena_key)
                        if own_index < 0 { continue }
                        if callee^.destroys_parameter_arena bit_and bit != 0 {
                            signature^.destroys_parameter_arena = signature^.destroys_parameter_arena bit_or (1 bit_shift_left own_index)
                        }
                        if callee^.resets_parameter_arena bit_and bit != 0 {
                            signature^.resets_parameter_arena = signature^.resets_parameter_arena bit_or (1 bit_shift_left own_index)
                        }
                        record_mem_parameter_field(signature, own_index, suffix)
                    }
                } or callee == nil && call_target_is_opaque_function(signature, node) {
                    // An indirect call: the real callee is unknown, so assume any arena
                    // handle it receives is destroyed
                    for index in range(0, len(node^.call^.args)) {
                        if index >= MAX_TRACKED_PARAMETERS { break }
                        own_index, suffix = mem_parameter_index_for_key(signature, arena_path_key(checker, node^.call^.args[index]))
                        if own_index < 0 { continue }
                        if !strings.contains(signature^.decl^.params[own_index].type_name, "Arena") { continue }
                        signature^.destroys_parameter_arena = signature^.destroys_parameter_arena bit_or (1 bit_shift_left own_index)
                        record_mem_parameter_field(signature, own_index, suffix)
                    }
                }
            }
            for_each argument in node^.call^.args { mem_walk(checker, signature, argument) }
        }
        is ast.NodeKind.VAR_DECL { mem_walk(checker, signature, node^.var_decl^.value) }
        is ast.NodeKind.ASSIGN_STMT { mem_walk(checker, signature, node^.assign^.value) }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts { mem_walk(checker, signature, statement) }
        }
        is ast.NodeKind.IF_STMT {
            mem_walk(checker, signature, node^.if_stmt^.consequence)
            mem_walk(checker, signature, node^.if_stmt^.alternative)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { mem_walk(checker, signature, case_entry.body) }
            mem_walk(checker, signature, node^.when_stmt^.default_body)
        }
        is ast.NodeKind.FOR_STMT { mem_walk(checker, signature, node^.for_stmt^.body) }
        is ast.NodeKind.FOR_EACH_STMT { mem_walk(checker, signature, node^.for_each_stmt^.body) }
        is ast.NodeKind.WHILE_STMT { mem_walk(checker, signature, node^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { mem_walk(checker, signature, node^.loop_stmt^.body) }
        is ast.NodeKind.EXPR_STMT { mem_walk(checker, signature, node^.expr_stmt^.expr) }
        is ast.NodeKind.ENSURE_STMT { mem_walk(checker, signature, node^.ensure_stmt^.expr) }
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values { mem_walk(checker, signature, value) }
        }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.INDEX_EXPR, ast.NodeKind.MEMBER_EXPR,
        ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF,
        ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN, ast.NodeKind.BREAK_STMT,
        ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT,
        ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

// Which parameters' arenas a returned expression's @mem pointer was allocated from:
// the first result has the bits where the expression itself is the pointer, the second
// where it is an aggregate with such a pointer buried inside.
fn return_expression_mem_bits(checker ^TypeChecker, signature ^FuncSig, node ^ast.AstNode) -> (i64, i64) {
    if node == nil || signature^.decl == nil { return 0, 0 }
    if node^.kind == ast.NodeKind.LABEL {
        initializer = local_initializer(signature^.decl^.body, node^.label^.value)
        if initializer != nil && initializer != node {
            initializer_direct, initializer_field = return_expression_mem_bits(checker, signature, initializer)
            return initializer_direct, initializer_field
        }
        return 0, 0
    }
    mut buried_parts [^ast.AstNode] = {}
    #strict
    when node^.kind {
        is ast.NodeKind.STRUCT_VALUE { buried_parts = node^.struct_value^.field_values }
        is ast.NodeKind.ARRAY_VALUE { buried_parts = node^.array_value^.elements }
        is ast.NodeKind.MAP_VALUE { buried_parts = node^.map_value^.values }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
        ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT, ast.NodeKind.RETURN_STMT,
        ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT, ast.NodeKind.BLOCK_STMT, ast.NodeKind.IF_STMT,
        ast.NodeKind.WHEN_STMT, ast.NodeKind.FOR_STMT, ast.NodeKind.FOR_EACH_STMT, ast.NodeKind.WHILE_STMT,
        ast.NodeKind.LOOP_STMT, ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT,
        ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT,
        ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
    if node^.kind == ast.NodeKind.STRUCT_VALUE || node^.kind == ast.NodeKind.ARRAY_VALUE || node^.kind == ast.NodeKind.MAP_VALUE {
        mut field_bits i64 = 0
        for_each part in buried_parts {
            direct_bits, nested_bits = return_expression_mem_bits(checker, signature, part)
            field_bits = field_bits bit_or direct_bits bit_or nested_bits
        }
        return 0, field_bits
    }
    if node^.kind != ast.NodeKind.CALL_EXPR { return 0, 0 }
    if is_tagged_enum_variant_call(checker, node) {
        mut field_bits i64 = 0
        for_each argument in node^.call^.args {
            direct_bits, nested_bits = return_expression_mem_bits(checker, signature, argument)
            field_bits = field_bits bit_or direct_bits bit_or nested_bits
        }
        return 0, field_bits
    }
    function_name, arena, is_mem_call = mem_call_parts(checker, node)
    params = signature^.decl^.params
    if is_mem_call && arena != "" && (function_name == "init" || function_name == "alloc") {
        mut direct_bits i64 = 0
        for index in range(0, len(params)) {
            if index >= MAX_TRACKED_PARAMETERS { break }
            if params[index].name == arena { direct_bits = direct_bits bit_or (1 bit_shift_left index) }
        }
        return direct_bits, 0
    }
    callee = resolve_call_signature_in_body(checker, signature^.decl^.body, node)
    if callee == nil || callee == signature { return 0, 0 }
    ensure_mem_summary(checker, callee)
    mut direct_bits i64 = 0
    mut field_bits i64 = 0
    for index in range(0, len(callee^.param_types)) {
        if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
        callee_bit = 1 bit_shift_left index
        if (callee^.returns_parameter_mem_allocation bit_or callee^.returns_parameter_mem_allocation_field) bit_and callee_bit == 0 { continue }
        argument = node^.call^.args[index]
        if argument^.kind != ast.NodeKind.LABEL { continue }
        via_field bool = callee^.returns_parameter_mem_allocation_field bit_and callee_bit != 0
        for own_index in range(0, len(params)) {
            if own_index >= MAX_TRACKED_PARAMETERS { break }
            if params[own_index].name != argument^.label^.value { continue }
            if via_field {
                field_bits = field_bits bit_or (1 bit_shift_left own_index)
            } otherwise {
                direct_bits = direct_bits bit_or (1 bit_shift_left own_index)
            }
        }
    }
    return direct_bits, field_bits
}

// The bits of every `return` reachable in a statement subtree.
fn return_statement_mem_bits(checker ^TypeChecker, signature ^FuncSig, node ^ast.AstNode) -> (i64, i64) {
    if node == nil { return 0, 0 }
    mut direct_bits i64 = 0
    mut field_bits i64 = 0
    mut children [^ast.AstNode] = {}
    #strict
    when node^.kind {
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values {
                value_direct, value_field = return_expression_mem_bits(checker, signature, value)
                direct_bits = direct_bits bit_or value_direct
                field_bits = field_bits bit_or value_field
            }
        }
        is ast.NodeKind.BLOCK_STMT { children = node^.block^.stmts }
        is ast.NodeKind.IF_STMT {
            arrays.append(children, node^.if_stmt^.consequence)
            arrays.append(children, node^.if_stmt^.alternative)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { arrays.append(children, case_entry.body) }
            arrays.append(children, node^.when_stmt^.default_body)
        }
        is ast.NodeKind.FOR_STMT { arrays.append(children, node^.for_stmt^.body) }
        is ast.NodeKind.FOR_EACH_STMT { arrays.append(children, node^.for_each_stmt^.body) }
        is ast.NodeKind.WHILE_STMT { arrays.append(children, node^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { arrays.append(children, node^.loop_stmt^.body) }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
        ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT, ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT,
        ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL,
        ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL,
        ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL, ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
    for_each child in children {
        child_direct, child_field = return_statement_mem_bits(checker, signature, child)
        direct_bits = direct_bits bit_or child_direct
        field_bits = field_bits bit_or child_field
    }
    return direct_bits, field_bits
}

// Lazily computes and memoises a function's cross-function @mem summary. A function
// caught mid-computation (recursion) keeps the partial summary it has.
fn ensure_mem_summary(checker ^TypeChecker, signature ^FuncSig) {
    if signature == nil || signature^.mem_state != ANALYSIS_NOT_STARTED { return }
    signature^.mem_state = ANALYSIS_IN_PROGRESS
    signature^.destroys_parameter_arena = 0
    signature^.resets_parameter_arena = 0
    mut summary_fields [string] = {}
    for _ in range(0, len(signature^.param_types)) { arrays.append(summary_fields, "") }
    signature^.mem_parameter_field = summary_fields
    signature^.returns_parameter_mem_allocation = 0
    signature^.returns_parameter_mem_allocation_field = 0
    if signature^.decl != nil && signature^.decl^.body != nil && len(signature^.decl^.params) <= MAX_TRACKED_PARAMETERS {
        saved = checker^.is_in_mem_summary
        checker^.is_in_mem_summary = true
        mem_walk(checker, signature, signature^.decl^.body)
        direct_bits, field_bits = return_statement_mem_bits(checker, signature, signature^.decl^.body)
        signature^.returns_parameter_mem_allocation = direct_bits
        signature^.returns_parameter_mem_allocation_field = field_bits
        checker^.is_in_mem_summary = saved
    }
    signature^.mem_state = ANALYSIS_DONE
}

// A call to a user function that returns a @mem pointer forwarded from one of its own
// arena parameters, directly or buried in a returned aggregate. The result binds to
// that argument's own live epoch.
fn mem_pointer_from_callee(checker ^TypeChecker, value ^ast.AstNode) -> (string, i64, bool, bool) {
    callee = resolve_call_signature(checker, value)
    if callee == nil { return "", 0, false, false }
    ensure_mem_summary(checker, callee)
    for index in range(0, len(callee^.param_types)) {
        if index >= len(value^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
        parameter_bit = 1 bit_shift_left index
        if (callee^.returns_parameter_mem_allocation bit_or callee^.returns_parameter_mem_allocation_field) bit_and parameter_bit == 0 { continue }
        argument = value^.call^.args[index]
        if argument^.kind != ast.NodeKind.LABEL { continue }
        arena_index_found = arena_index(checker, argument^.label^.value)
        mut epoch i64 = 0
        if arena_index_found >= 0 { epoch = checker^.arenas[arena_index_found].epoch }
        return argument^.label^.value, epoch, callee^.returns_parameter_mem_allocation_field bit_and parameter_bit != 0, true
    }
    return "", 0, false, false
}

// A call to a helper that destroys or resets one of its own @mem arena parameters (or a
// field of it) applies that effect to the caller's arena state at the call site.
fn apply_call_mem_effects(checker ^TypeChecker, node ^ast.AstNode) {
    signature = resolve_call_signature(checker, node)
    if signature == nil || signature^.decl == nil { return }
    ensure_mem_summary(checker, signature)
    effect = signature^.destroys_parameter_arena bit_or signature^.resets_parameter_arena
    if effect == 0 { return }
    // The same call can be resolved more than once; its effect applies once
    applied_key = "${node^.tok.file}:${node^.tok.line}:${node^.tok.col}"
    if maps.contains_key(checker^.applied_mem_effects, applied_key) { return }
    mut applied [string:bool] = checker^.applied_mem_effects
    applied[applied_key] = true
    checker^.applied_mem_effects = applied
    for index in range(0, len(signature^.param_types)) {
        if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
        if effect bit_and (1 bit_shift_left index) == 0 { continue }
        arena_key = mem_forward_key(checker, node^.call^.args[index], signature^.mem_parameter_field[index])
        if arena_key == "" { continue }
        destroys bool = signature^.destroys_parameter_arena bit_and (1 bit_shift_left index) != 0
        apply_arena_lifecycle(checker, arena_key, destroys, node, func_display_name_of(signature))
    }
}

// The name a function is reported under: as the user wrote it.
fn func_display_name_of(signature ^FuncSig) -> string {
    if signature^.decl == nil { return "" }
    if signature^.decl^.original_name != "" { return signature^.decl^.original_name }
    return signature^.decl^.name
}

// An error at a call: an inner-scope address that reaches longer-lived memory. Two
// shapes: `addr(x)` of a local passed beside an outer variable (the classic
// `arrays.append(outer, addr(x))`), and a stdlib container insert whose value
// carries an origin deeper than the container's own scope.
fn check_call_escape(checker ^TypeChecker, node ^ast.AstNode) {
    arguments = node^.call^.args
    mut reported [bool] = {}
    for _ in range(0, len(arguments)) { arrays.append(reported, false) }
    for index in range(0, len(arguments)) {
        argument = arguments[index]
        if argument^.kind != ast.NodeKind.CALL_EXPR || argument^.call^.function == nil || argument^.call^.function^.kind != ast.NodeKind.LABEL { continue }
        argument_callee = argument^.call^.function^.label^.value
        if (argument_callee != "addr" && argument_callee != "raw") || len(argument^.call^.args) != 1 || argument^.call^.args[0]^.kind != ast.NodeKind.LABEL { continue }
        address_variable = argument^.call^.args[0]^.label^.value
        if scope.scope_lookup_local(checker^.current_scope, address_variable) == nil { continue }
        for other_index in range(0, len(arguments)) {
            if other_index == index { continue }
            other = arguments[other_index]
            if other^.kind != ast.NodeKind.LABEL { continue }
            other_name = other^.label^.value
            if scope.scope_lookup_local(checker^.current_scope, other_name) == nil && scope.scope_lookup(checker^.current_scope, other_name) != nil {
                add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {other_name, address_variable}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
                reported[index] = true
                break
            }
        }
    }

    value_index, container_index = container_sink_arguments(checker, node)
    if value_index >= 0 && len(arguments) > value_index && len(arguments) > container_index && !reported[value_index] {
        destination_root = assignment_target_root_name(arguments[container_index])
        mut destination_depth i64 = 0
        if destination_root != "" { destination_depth = symbol_scope_depth(checker, destination_root) }
        argument = arguments[value_index]
        origin_depth, original_name = expression_origin(checker, argument)
        if origin_depth > 0 && origin_depth > destination_depth {
            mut sink_name string = destination_root
            if destination_root == "" { sink_name = original_name }
            add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {sink_name, original_name}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
        } or origin_depth > 0 && assign_target_outlives_locals(checker, arguments[container_index]) {
            // A container reached through a pointer or &ref parameter is the caller's
            // memory: it outlives every local of this function
            if origin_depth >= checker^.current_function_scope_depth {
                mut sink_name string = destination_root
                if destination_root == "" { sink_name = original_name }
                add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {sink_name, original_name}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
            }
        } or origin_depth > 0 && destination_root != "" {
            // A local container now holds the address, so returning or storing it carries
            // the address out of scope
            container_symbol = scope.scope_lookup(checker^.current_scope, destination_root)
            if container_symbol != nil && origin_depth > container_symbol^.field_origin_depth {
                container_symbol^.field_origin_depth = origin_depth
                container_symbol^.field_origin_name = original_name
            }
        }
    }

    // A user helper whose summary stores one of its parameters into a global or
    // another parameter's storage
    signature = resolve_call_signature(checker, node)
    if signature == nil {
        // An opaque call target (a func value read from an array or map element, or a
        // func-typed variable pinned to no declaration) could stash any pointer argument
        // anywhere: every argument whose address roots at a local escapes to a global
        callee_function = node^.call^.function
        mut opaque = false
        if callee_function != nil && callee_function^.kind == ast.NodeKind.INDEX_EXPR {
            // An element of a [func] array or map has no signature to check the call against
            add_diagnostic(checker, "E5064", error_registry.registry_message("E5064"), node^.tok.file, node^.tok.line, node^.tok.col)
        } or callee_function != nil && callee_function^.kind == ast.NodeKind.LABEL {
            callee_symbol = scope.scope_lookup(checker^.current_scope, callee_function^.label^.value)
            opaque = callee_symbol != nil && callee_symbol^.sym_type != nil && callee_symbol^.sym_type^.kind == types.TypeKind.FUNCTION && callee_symbol^.func_ref_name == ""
            // So does a bare func variable, such as a for_each variable over a [func] array
            if opaque && callee_symbol^.sym_type^.func_sig == nil {
                add_diagnostic(checker, "E5064", error_registry.registry_message("E5064"), node^.tok.file, node^.tok.line, node^.tok.col)
                opaque = false
            }
        }
        if opaque {
            for index in range(0, len(arguments)) {
                if index >= MAX_TRACKED_PARAMETERS { break }
                if reported[index] { continue }
                origin_depth, original_name = expression_origin(checker, arguments[index])
                if origin_depth > 0 && origin_depth >= checker^.current_function_scope_depth {
                    add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {"a global", original_name}), arguments[index]^.tok.file, arguments[index]^.tok.line, arguments[index]^.tok.col)
                    reported[index] = true
                }
            }
        }
        return
    }
    ensure_escape_summary(checker, signature)
    for index in range(0, len(signature^.param_types)) {
        if index >= len(arguments) || index >= MAX_TRACKED_PARAMETERS { break }
        parameter_escape = signature^.parameter_escape_into[index]
        if parameter_escape == ESCAPE_NONE || reported[index] { continue }
        argument = arguments[index]
        origin_depth, original_name = expression_origin(checker, argument)
        if origin_depth <= 0 {
            // Not a stack pointer, but maybe a @mem arena pointer laundered into
            // caller-visible storage by this helper: the same error as a direct `g = p`
            check_mem_escape(checker, argument, argument)
            continue
        }
        mut sink_depth i64 = 0
        mut sink_name string = original_name
        mut via_global_name = ""
        if parameter_escape == ESCAPE_GLOBAL && signature^.parameter_escape_via_function[index] >= 0 {
            // The escape is only a forward into an indirect call through one of the callee's
            // func-typed parameters. When this call supplies a known function for it, that
            // function's own summary decides.
            function_parameter_index = signature^.parameter_escape_via_function[index]
            position = signature^.parameter_escape_via_position[index]
            mut target = ""
            if function_parameter_index < len(arguments) { target = function_reference_target_name(arguments[function_parameter_index]) }
            mut callback_signature ^FuncSig = nil
            if target != "" { callback_signature = find_func(checker, target) }
            if callback_signature != nil && position < len(callback_signature^.param_types) && position < MAX_TRACKED_PARAMETERS {
                ensure_escape_summary(checker, callback_signature)
                if callback_signature^.parameter_escape_into[position] == ESCAPE_NONE { continue }
                via_global_name = callback_signature^.parameter_escape_global_name[position]
            }
        }
        if parameter_escape == ESCAPE_GLOBAL {
            // A global outlives the program, so only an origin local to this function escapes it
            if checker^.current_function_scope_depth > 0 { sink_depth = checker^.current_function_scope_depth - 1 }
            sink_name = signature^.parameter_escape_global_name[index]
            if via_global_name != "" { sink_name = via_global_name }
            if sink_name == "" { sink_name = "a global" }
        } otherwise {
            mut destination_root string = ""
            // The destination is the memory an `addr(x)` / `raw(x)` argument points at, so
            // its lifetime is x's
            if parameter_escape < len(arguments) { destination_root = assignment_target_root_name(unwrap_address_argument(arguments[parameter_escape])) }
            if destination_root != "" {
                sink_depth = symbol_scope_depth(checker, destination_root)
                sink_name = destination_root
            }
        }
        if origin_depth > sink_depth {
            add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {sink_name, original_name}), argument^.tok.file, argument^.tok.line, argument^.tok.col)
        } or parameter_escape != ESCAPE_GLOBAL {
            // The destination now holds the address, so returning or storing it carries the
            // address out of scope, as a direct `heap^.next = addr(local)` does
            mut recorded_root string = ""
            if parameter_escape < len(arguments) { recorded_root = assignment_target_root_name(unwrap_address_argument(arguments[parameter_escape])) }
            if recorded_root != "" {
                destination_symbol = scope.scope_lookup(checker^.current_scope, recorded_root)
                if destination_symbol != nil && origin_depth > destination_symbol^.field_origin_depth {
                    destination_symbol^.field_origin_depth = origin_depth
                    destination_symbol^.field_origin_name = original_name
                }
            }
        }
    }
}

// For a stdlib call that stores one argument into a container argument
// (arrays.append, prepend, insert_at, fill): the value's and the container's
// argument positions; -1, -1 for any other call.
fn container_sink_arguments(checker ^TypeChecker, call ^ast.AstNode) -> (i64, i64) {
    callee = call^.call^.function
    if callee == nil || callee^.kind != ast.NodeKind.MEMBER_EXPR || callee^.member^.object^.kind != ast.NodeKind.LABEL { return -1, -1 }
    if resolve_import_alias(checker, callee^.member^.object^.label^.value) != "arrays" { return -1, -1 }
    member_name = callee^.member^.member
    if member_name == "append" || member_name == "prepend" { return 1, 0 }
    if member_name == "insert_at" || member_name == "fill" { return 2, 0 }
    return -1, -1
}

// C library functions that keep a `char *` argument after they return: a Grayscale
// string's storage is reclaimed with its scope, so the kept pointer would dangle.
fn extern_retains_string_argument(function_name string, argument_index i64) -> bool {
    if function_name == "putenv" || function_name == "strtok" { return argument_index == 0 }
    if function_name == "setbuf" || function_name == "setbuffer" || function_name == "setvbuf" { return argument_index == 1 }
    return false
}

// A string literal is static data, a file-scope string is not reclaimed with any
// function, and to_c_string() copies onto the heap arena. Anything else may be freed when
// its scope ends. Only a string-typed argument is checked.
fn string_outlives_extern_call(checker ^TypeChecker, argument ^ast.AstNode) -> bool {
    argument_type = const_walk_expression_type(checker, argument)
    if argument_type == nil || argument_type^.kind != types.TypeKind.STRING { return true }
    if argument^.kind == ast.NodeKind.STRING_VALUE { return true }
    if argument^.kind == ast.NodeKind.LABEL {
        variable_name = argument^.label^.value
        return is_module_level_variable(checker, variable_name) && scope.scope_lookup_local(checker^.current_scope, variable_name) == nil
    }
    if argument^.kind == ast.NodeKind.CALL_EXPR && argument^.call^.function != nil && argument^.call^.function^.kind == ast.NodeKind.LABEL {
        return argument^.call^.function^.label^.value == "to_c_string"
    }
    return false
}

// Records an `extern.NAME` use for the driver's checks against the real C header.
fn record_extern_site(checker ^TypeChecker, node ^ast.AstNode, function_name string, argument_count i64, is_call bool, callback_names [string], argument_types [^types.GrayType]) {
    mut sites [ExternCallSite] = checker^.extern_calls
    // The same node can be resolved more than once; it is one site
    for_each recorded in sites {
        if recorded.node == node { return }
    }
    arrays.append(sites, ExternCallSite{function_name: function_name, argument_count: argument_count, is_call: is_call, file: node^.tok.file, line: node^.tok.line, col: node^.tok.col, node: node, callback_names: callback_names, argument_types: argument_types, asserted_type: nil, is_asserted_via_cast: false})
    checker^.extern_calls = sites
}

// The kind word errors name for a callback parameter or return type that has no
// C-compatible layout, or "".
fn callback_bad_kind(checker ^TypeChecker, callback_type ^types.GrayType) -> string {
    if callback_type == nil { return "" }
    if callback_type^.kind == types.TypeKind.STRING { return "string" }
    if callback_type^.kind == types.TypeKind.ARRAY { return "array" }
    if callback_type^.kind == types.TypeKind.MAP { return "map" }
    if callback_type^.kind == types.TypeKind.STRUCT && callback_type^.name != "" && is_struct_name(checker, callback_type^.name) { return "struct" }
    return ""
}

// Whether `name` is declared in a scope below the file scope.
fn is_function_local_name(from_scope ^scope.Scope, name string) -> bool {
    mut declaring ^scope.Scope = from_scope
    as_long_as declaring^.parent != nil && scope.scope_lookup_local(declaring, name) == nil {
        declaring = declaring^.parent
    }
    return declaring^.parent != nil
}

// `extern.NAME(arguments)`: the C function's signature is unknown here, so its arguments are
// checked only for what cannot cross into C, and the result has no Grayscale type.
fn resolve_extern_call(checker ^TypeChecker, node ^ast.AstNode, function_name string) -> ^types.GrayType {
    require_unsafe_context(checker, node, "extern.${function_name}()")
    // C functions have no parameter names, so a label would be silently dropped
    for_each argument_name in node^.call^.arg_names {
        if argument_name != "" {
            add_diagnostic(checker, "E5055", error_registry.registry_message_formatted("E5055", {function_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            break
        }
    }
    // Codegen emits the C function unqualified, so a local of the same name shadows it
    shadow = scope.scope_lookup(checker^.current_scope, function_name)
    if shadow != nil && is_function_local_name(checker^.current_scope, function_name) {
        add_diagnostic(checker, "E4030", error_registry.registry_message_formatted("E4030", {function_name, function_name}), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    mut callback_names [string] = {}
    mut argument_types [^types.GrayType] = {}
    arguments = node^.call^.args
    for argument_index in range(0, len(arguments)) {
        call_argument = arguments[argument_index]
        arrays.append(callback_names, "")
        // A stack address cannot cross into C
        if checker^.current_function_scope_depth > 0 {
            origin_depth, root = expression_origin(checker, call_argument)
            if origin_depth > 0 && origin_depth >= checker^.current_function_scope_depth && root != "" {
                add_diagnostic(checker, "E3154", error_registry.registry_message_formatted("E3154", {root}), call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
            }
        }
        if extern_retains_string_argument(function_name, argument_index) && !string_outlives_extern_call(checker, call_argument) {
            add_diagnostic(checker, "E3216", error_registry.registry_message_formatted("E3216", {function_name}), call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
        }

        // A Grayscale function passed as a C callback must lower to a C-compatible pointer
        mut callback_target string = function_reference_target_name(call_argument)
        if callback_target == "" && call_argument^.kind == ast.NodeKind.LABEL && checker^.current_function != nil {
            callback_target = function_reference_target_name(local_initializer(checker^.current_function^.func_decl^.body, call_argument^.label^.value))
        }
        if callback_target != "" {
            callback_names[argument_index] = callback_target
            callback_signature = find_func(checker, callback_target)
            if callback_signature != nil && callback_signature^.decl != nil { callback_signature^.decl^.is_c_callback = true }
            if callback_signature != nil {
                for_each callback_parameter in callback_signature^.param_types {
                    bad_kind = callback_bad_kind(checker, callback_parameter)
                    if bad_kind != "" {
                        add_diagnostic(checker, "E3197", error_registry.registry_message_formatted("E3197", {callback_target, bad_kind}), call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
                        break
                    }
                }
                if len(callback_signature^.return_types) >= 1 {
                    bad_return_kind = callback_bad_kind(checker, callback_signature^.return_types[0])
                    if bad_return_kind != "" {
                        add_diagnostic(checker, "E3198", error_registry.registry_message_formatted("E3198", {callback_target, bad_return_kind}), call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
                    }
                }
            }
        }

        argument_type = resolve_expression(checker, call_argument)
        arrays.append(argument_types, argument_type)
        if argument_type == nil || argument_type^.kind == types.TypeKind.UNKNOWN || argument_type^.kind == types.TypeKind.C_FUNCTION { continue }
        // Values whose layout C cannot read
        if argument_type^.name == "i128" || argument_type^.name == "i256" || argument_type^.name == "u128" || argument_type^.name == "u256" {
            add_diagnostic_help(checker, "E3158", error_registry.registry_message_formatted("E3158", {argument_type^.name}), "C has no 128/256-bit integer types", call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
        }
        if argument_type^.kind == types.TypeKind.ARRAY || argument_type^.kind == types.TypeKind.MAP {
            mut container_word = "a map"
            if argument_type^.kind == types.TypeKind.ARRAY { container_word = "an array" }
            add_diagnostic_help(checker, "E3158", error_registry.registry_message_formatted("E3158", {container_word}), "use individual elements instead", call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
        }
        if argument_type^.kind == types.TypeKind.STRUCT && argument_type^.name != "" && is_struct_name(checker, argument_type^.name) {
            add_diagnostic_help(checker, "E3158", error_registry.registry_message_formatted("E3158", {shown_type(checker, argument_type)}), "pass individual fields instead", call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
        }
        if argument_type^.kind == types.TypeKind.ENUM && argument_type^.name != "" && enum_is_tagged(checker, argument_type^.name) {
            add_diagnostic_help(checker, "E3158", error_registry.registry_message_formatted("E3158", {enum_display_name(checker, argument_type^.name)}), "destructure it with when/is and pass the payload", call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
        }
        if argument_type^.kind == types.TypeKind.ERROR {
            add_diagnostic_help(checker, "E3158", error_registry.registry_message_formatted("E3158", {"an Error value"}), "pass 'err.code' or 'err.msg' instead", call_argument^.tok.file, call_argument^.tok.line, call_argument^.tok.col)
        }
    }
    record_extern_site(checker, node, function_name, len(arguments), true, callback_names, argument_types)
    return checker^.pool^.type_c_function
}

// A tagged enum built through a call: `Enum.Variant(arguments)` or, against an expected enum,
// `.Variant(arguments)`. A plain enum variant cannot be called; the argument count
// must match the payload and each argument its payload type.
fn check_enum_construction(checker ^TypeChecker, node ^ast.AstNode, info ^EnumInfo, variant_index i64, variant string) {
    display = enum_display_name(checker, info^.name)
    arguments = node^.call^.args
    if !info^.is_tagged {
        resolve_call_args_only(checker, node)
        add_diagnostic(checker, "E3115", error_registry.registry_message_formatted("E3115", {display, variant}), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    payload = info^.variant_payload_types[variant_index]
    if len(payload) == 0 && len(arguments) > 0 {
        resolve_call_args_only(checker, node)
        add_diagnostic(checker, "E3114", error_registry.registry_message_formatted("E3114", {variant, display}), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    if len(payload) != len(arguments) {
        resolve_call_args_only(checker, node)
        add_diagnostic(checker, "E3113", error_registry.registry_message_formatted("E3113", {variant, display, "${len(payload)}", "${len(arguments)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    for index in range(0, len(arguments)) {
        expected_type = checker_type_from_name(checker, payload[index])
        argument_type = check_expression_as(checker, arguments[index], expected_type)
        if argument_type^.kind != types.TypeKind.UNKNOWN && expected_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, expected_type, argument_type) {
            report_argument_type(checker, arguments[index], index + 1, "${display}.${variant}", shown_type(checker, expected_type), shown_type(checker, argument_type))
        }
    }
}

// `.Variant(arguments)` resolves against the expected enum.
fn resolve_implicit_enum_call(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    callee = node^.call^.function
    variant = callee^.implicit_enum^.variant
    expected = checker^.expected_type
    if expected == nil || expected^.kind != types.TypeKind.ENUM || expected^.name == "" {
        resolve_call_args_only(checker, node)
        add_diagnostic(checker, "E3110", error_registry.registry_message_formatted("E3110", {variant, variant}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }
    callee^.implicit_enum^.resolved_enum = expected^.name
    info = find_enum(checker, expected^.name)
    if info != nil {
        variant_index = enum_variant_index(info, variant)
        if variant_index < 0 {
            add_diagnostic(checker, "E3047", error_registry.registry_message_formatted("E3047", {enum_display_name(checker, expected^.name), variant}), node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            check_enum_construction(checker, node, info, variant_index, variant)
        }
    }
    return checker_type_from_name(checker, expected^.name)
}

fn resolve_call_expr_unchecked(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    callee = node^.call^.function

    if callee^.kind == ast.NodeKind.IMPLICIT_ENUM { return resolve_implicit_enum_call(checker, node) }

    // A call result is never directly callable (`get_fn()(5)`); func references
    // must be made with `()name` or `ref(name)` first
    if callee^.kind == ast.NodeKind.CALL_EXPR {
        resolve_expression(checker, callee)
        inner_function = callee^.call^.function
        mut inner_name = "function"
        if inner_function^.kind == ast.NodeKind.LABEL {
            inner_name = inner_function^.label^.value
        } or ast.ast_member_qualifier(inner_function) != "" {
            inner_name = "${ast.ast_member_qualifier(inner_function)}.${inner_function^.member^.member}"
        }
        add_diagnostic(checker, "E5030", error_registry.registry_message_formatted("E5030", {inner_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_unknown
    }

    if callee^.kind == ast.NodeKind.LABEL {
        name = callee^.label^.value
        mut signature = find_func(checker, name)
        // A builtin type constructor wins over a user function of the same (reserved) name
        if signature != nil && reserved.is_reserved_type_name(name) { signature = nil }
        if signature == nil && checker^.current_struct_name != "" {
            mangled = fmt.sprintf("%s_%s", {checker^.current_struct_name, name})
            signature = find_func(checker, mangled)
            if signature != nil { callee^.label^.value = mangled }
        }
        if signature != nil {
            reject_test_function_reference(checker, node, signature)
            return check_call_against_sig(checker, node, name, signature, 0)
        }

        symbol = scope.scope_lookup(checker^.current_scope, name)
        if symbol != nil {
            if symbol^.sym_type^.kind == types.TypeKind.FUNCTION || symbol^.sym_type^.name == "func" {
                return resolve_func_variable_call(checker, node, name, symbol)
            }
            message = fmt.sprintf("'%s' is a %s, not a function; it cannot be called", {name, shown_type(checker, symbol^.sym_type)})
            add_diagnostic(checker, "E3015", message, node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }

        if reserved.is_reserved_builtin_func_name(name) { return resolve_builtin_call(checker, node, name) }

        // A stdlib function reached unqualified through `using` / `import and use`
        for_each used_module in checker^.using_modules {
            key = "${used_module}.${name}"
            if maps.contains_key(checker^.stdlib_signatures, key) {
                found = new(stdlib_sigs.StdlibSig)
                found^ = checker^.stdlib_signatures[key]
                mark_import_used(checker, used_module)
                // Another in-scope module provides the name too, so the pick was
                // import order and the other one is unreachable
                for_each other_module in checker^.using_modules {
                    if other_module == used_module || !maps.contains_key(checker^.stdlib_signatures, "${other_module}.${name}") { continue }
                    add_diagnostic(checker, "E4031", error_registry.registry_message_formatted("E4031", {name, used_module, other_module, used_module, name}), callee^.tok.file, callee^.tok.line, callee^.tok.col)
                    mark_import_used(checker, other_module)
                    // Which module the call means is unknown, so its arguments are not
                    // checked against either signature
                    resolve_call_args_only(checker, node)
                    return checker^.pool^.type_unknown
                }
                // Written as `module.name` from here on, so codegen sees an ordinary module call
                module_label = ast.ast_alloc(ast.NodeKind.LABEL, callee^.tok)
                module_label_data = new(ast.LabelData)
                module_label_data^.value = used_module
                module_label^.label = module_label_data
                member_data = new(ast.MemberData)
                member_data^.object = module_label
                member_data^.member = name
                qualified_callee = ast.ast_alloc(ast.NodeKind.MEMBER_EXPR, callee^.tok)
                qualified_callee^.member = member_data
                node^.call^.function = qualified_callee
                return resolve_stdlib_call(checker, node, found)
            }
        }

        // Conversion builtins named after their result type: i128(x), bool(x), string(x)
        if name == "char" { return resolve_scalar_argument_builtin(checker, node, name) }
        if is_conversion_builtin_name(name) {
            return resolve_conversion_call(checker, node, name)
        }

        mut argument_result = checker^.pool^.type_unknown
        mut arguments_checked = false
        if callee^.label^.qualifier != "" {
            // `module.name()` where the module declares no such function
            add_diagnostic(checker, "E4023", error_registry.registry_message_formatted("E4023", {callee^.label^.qualifier, callee^.label^.qualified_member}), node^.tok.file, node^.tok.line, node^.tok.col)
        } or !report_misspelled_statement(checker, node, callee, name) {
            // The arguments are checked before the callee is reported; the error points at the function name
            argument_result = resolve_call_args_only(checker, node)
            arguments_checked = true
            add_diagnostic(checker, "E4002", error_registry.registry_message_formatted("E4002", {name}), callee^.tok.file, callee^.tok.line, callee^.tok.col)
        }
        if !arguments_checked { argument_result = resolve_call_args_only(checker, node) }
        return argument_result
    }

    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        obj_name = callee^.member^.object^.label^.value
        member = callee^.member^.member
        symbol = scope.scope_lookup(checker^.current_scope, obj_name)

        // C interop: extern.NAME(...)
        if obj_name == "extern" {
            if mark_import_used(checker, "extern") { return resolve_extern_call(checker, node, member) }
            if symbol == nil {
                add_diagnostic(checker, "E4034", error_registry.registry_message("E4034"), node^.tok.file, node^.tok.line, node^.tok.col)
                return checker^.pool^.type_unknown
            }
        }

        // `Enum.Variant(payload)` builds a value of the enum
        if symbol == nil && !is_enum_name(checker, obj_name) && is_declared_type_alias(checker, obj_name) && (member == "names" || member == "variants") {
            // an alias of an enum: names() / variants() are the enum's
            aliased_name = resolve_alias_impl(checker, obj_name, false)
            if aliased_name != obj_name && is_enum_name(checker, aliased_name) {
                aliased_info = find_enum(checker, aliased_name)
                if member == "names" { return types.type_array(checker^.pool, "string") }
                return types.type_array(checker^.pool, aliased_info^.name)
            }
        }
        if symbol == nil && is_enum_name(checker, obj_name) {
            variant_info = find_enum(checker, obj_name)
            if enum_variant_index(variant_info, member) >= 0 {
                check_enum_construction(checker, node, variant_info, enum_variant_index(variant_info, member), member)
                return checker_type_from_name(checker, obj_name)
            }
            // Every plain enum has names() -> [string] and variants() -> [Enum], both in
            // declaration order
            if member == "names" || member == "variants" {
                display_name = variant_info^.display_name
                if len(node^.call^.args) != 0 {
                    add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"${display_name}.${member}", "0", "${len(node^.call^.args)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
                } or variant_info^.is_flags || variant_info^.is_tagged {
                    mut enum_kind = "tagged"
                    if variant_info^.is_flags { enum_kind = "flags" }
                    add_diagnostic(checker, "E3209", error_registry.registry_message_formatted("E3209", {display_name, member, enum_kind}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
                if member == "names" { return types.type_array(checker^.pool, "string") }
                return types.type_array(checker^.pool, variant_info^.name)
            }
            add_diagnostic(checker, "E3047", error_registry.registry_message_formatted("E3047", {obj_name, member}), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }

        if symbol == nil && is_struct_name(checker, obj_name) {
            signature = find_func(checker, fmt.sprintf("%s_%s", {obj_name, member}))
            reject_private_struct_function(checker, node, signature, obj_name, member)
            if signature != nil { return check_call_against_sig(checker, node, fmt.sprintf("%s.%s", {obj_name, member}), signature, 0) }
            if signature == nil && !struct_has_field(checker, obj_name, member) {
                add_diagnostic(checker, "E4018", error_registry.registry_message_formatted("E4018", {struct_display_name(checker, obj_name), member}), node^.tok.file, node^.tok.line, node^.tok.col)
                resolve_call_args_only(checker, node)
                return checker^.pool^.type_unknown
            }
        }

        if symbol != nil {
            sym_was_used = symbol^.used
            symbol^.used = true
            mut struct_name = ""
            if symbol^.sym_type^.kind == types.TypeKind.STRUCT { struct_name = symbol^.sym_type^.name }
            if symbol^.sym_type^.kind == types.TypeKind.POINTER { struct_name = symbol^.sym_type^.element_type }
            if struct_name != "" {
                signature = find_func(checker, fmt.sprintf("%s_%s", {struct_name, member}))
                reject_private_struct_function(checker, node, signature, struct_name, member)
                if signature == nil && is_struct_name(checker, struct_name) && !struct_has_field(checker, struct_name, member) {
                    symbol^.used = sym_was_used
                    add_diagnostic(checker, "E4018", error_registry.registry_message_formatted("E4018", {struct_display_name(checker, struct_name), member}), node^.tok.file, node^.tok.line, node^.tok.col)
                    resolve_call_args_only(checker, node)
                    return checker^.pool^.type_unknown
                }
                // `instance.f(arguments)` where f takes no instance: the call is `Struct.f(arguments)`
                if signature != nil && !(len(signature^.param_types) > 0 && signature^.param_types[0]^.name == struct_name) {
                    result = check_call_against_sig(checker, node, fmt.sprintf("%s.%s", {struct_display_name(checker, struct_name), member}), signature, 0)
                    node^.call^.ignored_receiver = callee^.member^.object
                    type_label = ast.ast_alloc(ast.NodeKind.LABEL, callee^.member^.object^.tok)
                    type_label_data = new(ast.LabelData)
                    type_label_data^.value = struct_name
                    type_label^.label = type_label_data
                    node^.call^.function^.member^.object = type_label
                    return result
                }
                // a call through a func-typed field: the object is a value codegen needs typed
                if signature == nil && struct_has_field(checker, struct_name, member) {
                    resolve_expression(checker, callee^.member^.object)
                    field_call_type = func_field_call_type(checker, struct_name, member)
                    if field_call_type != nil {
                        resolve_call_args_only(checker, node)
                        return field_call_type
                    }
                }
                if signature != nil && len(signature^.param_types) > 0 && signature^.param_types[0]^.name == struct_name {
                    result = check_call_against_sig(checker, node, fmt.sprintf("%s.%s", {struct_display_name(checker, struct_name), member}), signature, 1)
                    receiver = callee^.member^.object
                    retarget_instance_call(node, receiver, struct_name, types.type_display_name(symbol^.sym_type))
                    check_mutable_receiver(checker, node, signature, symbol, receiver, struct_name, member)
                    return result
                }
            } or symbol^.sym_type^.kind != types.TypeKind.UNKNOWN && symbol^.sym_type^.kind != types.TypeKind.VOID && symbol^.sym_type^.kind != types.TypeKind.STRUCT && symbol^.sym_type^.kind != types.TypeKind.POINTER && !is_imported_module_name(checker, obj_name) {
                // A variable of this type has no functions to call
                symbol^.used = sym_was_used
                add_diagnostic(checker, "E3186", error_registry.registry_message_formatted("E3186", {shown_type(checker, symbol^.sym_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
                resolve_call_args_only(checker, node)
                return checker^.pool^.type_unknown
            }
        }
    }

    // `pointer^.f(arguments)`: the dereferenced struct is the instance
    // `items[i].f(arguments)` and `outer.inner.f(arguments)` dispatch the same way
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && ((callee^.member^.object^.kind == ast.NodeKind.POSTFIX_EXPR && callee^.member^.object^.postfix^.op == token.TokenKind.CARET) || callee^.member^.object^.kind == ast.NodeKind.INDEX_EXPR || callee^.member^.object^.kind == ast.NodeKind.MEMBER_EXPR || callee^.member^.object^.kind == ast.NodeKind.STRUCT_VALUE) {
        instance = callee^.member^.object
        instance_type = resolve_quietly(checker, instance)
        if instance_type^.kind == types.TypeKind.STRUCT && find_func(checker, fmt.sprintf("%s_%s", {instance_type^.name, callee^.member^.member})) == nil {
            // not a struct function: a field (a func-typed one is called through it)
            resolve_expression(checker, instance)
            instance_call_type = func_field_call_type(checker, instance_type^.name, callee^.member^.member)
            if instance_call_type != nil {
                resolve_call_args_only(checker, node)
                return instance_call_type
            }
        }
        if instance_type^.kind == types.TypeKind.STRUCT {
            signature = find_func(checker, fmt.sprintf("%s_%s", {instance_type^.name, callee^.member^.member}))
            reject_private_struct_function(checker, node, signature, instance_type^.name, callee^.member^.member)
            // an instance that takes no self: the receiver is only evaluated
            if signature != nil && !(len(signature^.param_types) > 0 && signature^.param_types[0]^.name == instance_type^.name) {
                result = check_call_against_sig(checker, node, fmt.sprintf("%s.%s", {struct_display_name(checker, instance_type^.name), callee^.member^.member}), signature, 0)
                node^.call^.ignored_receiver = instance
                type_label = ast.ast_alloc(ast.NodeKind.LABEL, instance^.tok)
                type_label_data = new(ast.LabelData)
                type_label_data^.value = instance_type^.name
                type_label^.label = type_label_data
                node^.call^.function^.member^.object = type_label
                resolve_expression(checker, instance)
                return result
            }
            if signature != nil && len(signature^.param_types) > 0 && signature^.param_types[0]^.name == instance_type^.name {
                result = check_call_against_sig(checker, node, fmt.sprintf("%s.%s", {struct_display_name(checker, instance_type^.name), callee^.member^.member}), signature, 1)
                retarget_instance_call(node, instance, instance_type^.name, types.type_display_name(instance_type))
                // A struct value given to a pointer receiver is passed by address
                if signature^.param_types[0]^.kind == types.TypeKind.POINTER { reject_unstable_address_target(checker, instance, instance, "addr") }
                mut no_symbol ^scope.Symbol = nil
                check_mutable_receiver(checker, node, signature, no_symbol, instance, instance_type^.name, callee^.member^.member)
                return result
            }
        }
    }

    // A stdlib module is in scope only in the file that imports it
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        raw_qualifier = callee^.member^.object^.label^.value
        qualified_module = resolve_import_alias(checker, raw_qualifier)
        if scope.scope_lookup(checker^.current_scope, raw_qualifier) == nil && reserved.is_stdlib_module_name(qualified_module) && !is_imported_module_name(checker, raw_qualifier) && !is_imported_module_name(checker, qualified_module) && raw_qualifier != "extern" && find_struct(checker, raw_qualifier) == nil && find_enum(checker, raw_qualifier) == nil {
            add_diagnostic_help(checker, "E4033", error_registry.registry_message_formatted("E4033", {qualified_module}), "add 'import @${qualified_module}' at the top of the file", node^.tok.file, node^.tok.line, node^.tok.col)
            qualifier_node = callee^.member^.object
            add_diagnostic(checker, "E6010", error_registry.registry_message_formatted("E6010", {raw_qualifier}), qualifier_node^.tok.file, qualifier_node^.tok.line, qualifier_node^.tok.col)
            resolve_call_args_only(checker, node)
            return checker^.pool^.type_unknown
        }
    }

    stdlib_sig = stdlib_call_sig(checker, node)
    if stdlib_sig != nil {
        mark_import_used(checker, callee^.member^.object^.label^.value)
        return resolve_stdlib_call(checker, node, stdlib_sig)
    }

    // An imported stdlib module has no such function
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        raw_module_name = callee^.member^.object^.label^.value
        // A variable named like an imported module still counts the call as a use of the import
        if scope.scope_lookup(checker^.current_scope, raw_module_name) != nil && is_imported_module_name(checker, raw_module_name) { mark_import_used(checker, raw_module_name) }
        module_name = resolve_import_alias(checker, raw_module_name)
        if scope.scope_lookup(checker^.current_scope, raw_module_name) == nil && reserved.is_stdlib_module_name(module_name) && is_imported_module_name(checker, raw_module_name) {
            mark_import_used(checker, raw_module_name)
            // A maps function takes a map, whatever the function is called
            if module_name == "maps" && len(node^.call^.args) > 0 && resolve_quietly(checker, node^.call^.args[0])^.kind == types.TypeKind.ARRAY {
                add_diagnostic(checker, "E12001", error_registry.registry_message_formatted("E12001", {callee^.member^.member}), node^.call^.args[0]^.tok.file, node^.call^.args[0]^.tok.line, node^.call^.args[0]^.tok.col)
            }
            resolve_call_args_only(checker, node)
            // The arrays checks run whatever the function is called
            if module_name == "arrays" { check_arrays_call_extras(checker, node, callee^.member^.member) }
            add_diagnostic(checker, "E4005", error_registry.registry_message_formatted("E4005", {module_name, callee^.member^.member}), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_unknown
        }
        // Nothing by the qualifier's name is in scope, so the module name is the mistake
        if raw_module_name != "extern" && !maps.contains_key(user_module_names, raw_module_name) && scope.scope_lookup(checker^.current_scope, raw_module_name) == nil && !is_imported_module_name(checker, raw_module_name) && find_struct(checker, raw_module_name) == nil && find_enum(checker, raw_module_name) == nil && !is_declared_type_alias(checker, raw_module_name) {
            qualifier = callee^.member^.object
            near_module = suggest_similar_module(checker, raw_module_name)
            mut near_module_help = ""
            if near_module != "" { near_module_help = "did you mean '${near_module}'?" }
            add_diagnostic_help(checker, "E6010", error_registry.registry_message_formatted("E6010", {raw_module_name}), near_module_help, qualifier^.tok.file, qualifier^.tok.line, qualifier^.tok.col)
            resolve_call_args_only(checker, node)
            return checker^.pool^.type_unknown
        }
    }

    // A member call on an expression result: `foo().bar()`
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind != ast.NodeKind.LABEL && callee^.member^.object^.kind != ast.NodeKind.MEMBER_EXPR {
        receiver_node = callee^.member^.object
        receiver_type = resolve_expression(checker, receiver_node)
        if receiver_type^.kind != types.TypeKind.STRUCT && receiver_type^.kind != types.TypeKind.POINTER && receiver_type^.kind != types.TypeKind.UNKNOWN && receiver_type^.kind != types.TypeKind.VOID {
            add_diagnostic(checker, "E3186", error_registry.registry_message_formatted("E3186", {shown_type(checker, receiver_type)}), callee^.tok.file, callee^.tok.line, callee^.tok.col)
        } or receiver_type^.kind == types.TypeKind.VOID {
            reject_void_in_context(checker, receiver_node, receiver_type, "the receiver of a struct function call")
        } or (receiver_type^.kind == types.TypeKind.STRUCT || receiver_type^.kind == types.TypeKind.POINTER) && receiver_node^.kind == ast.NodeKind.CALL_EXPR {
            // Calling a struct function on the result of another is not supported
            add_diagnostic(checker, "E3075", error_registry.registry_message("E3075"), callee^.tok.file, callee^.tok.line, callee^.tok.col)
        }
    }

    return resolve_call_args_only(checker, node)
}

// --- Statement checking ---

fn is_side_effect_call(name string) -> bool {
    return name == "println" || name == "print" || name == "eprintln" || name == "eprint" ||
           name == "panic" || name == "assert" || name == "exit" || name == "sleep_s" ||
           name == "sleep_ms" || name == "sleep_ns" || name == "system"
}

fn check_expression_statement(checker ^TypeChecker, node ^ast.AstNode) {
    expr = node^.expr_stmt^.expr
    mut step_name = ""
    if expr != nil && expr^.kind == ast.NodeKind.POSTFIX_EXPR && (expr^.postfix^.op == token.TokenKind.INCREMENT || expr^.postfix^.op == token.TokenKind.DECREMENT) {
        step_name = whole_variable_write_name(expr^.postfix^.left)
    }
    step_was_used = symbol_was_used_before_write(checker, step_name)
    checker^.statement_expression = expr
    expr_type = resolve_expression(checker, expr)
    checker^.statement_expression = nil
    restore_symbol_used_flag(checker, step_name, step_was_used)
    if expr == nil { return }
    // A bare @mem lifecycle call: mem.destroy(a) / mem.reset(a)
    if expr^.kind == ast.NodeKind.CALL_EXPR { apply_mem_call(checker, expr, node, "") }

    // Bare function name used as a statement without a call
    if expr^.kind == ast.NodeKind.LABEL {
        name = expr^.label^.value
        if reserved.is_reserved_builtin_func_name(name) || find_func(checker, name) != nil {
            message = fmt.sprintf("function '%s' used as a statement without being called; did you mean '%s()'?", {name, name})
            add_diagnostic(checker, "E3081", message, expr^.tok.file, expr^.tok.line, expr^.tok.col)
        }
        return
    }

    check_discarded_call_result(checker, node, expr, expr_type)
}

// A call whose result is dropped, a bare call statement or the call under
// defer/ensure, must not return a value.
fn check_discarded_call_result(checker ^TypeChecker, node ^ast.AstNode, expression ^ast.AstNode, expression_type ^types.GrayType) {
    if expression == nil || expression^.kind != ast.NodeKind.CALL_EXPR { return }
    // A stdlib tuple result with no table return type resolves to unknown; classify it by name
    if expression_type^.kind == types.TypeKind.UNKNOWN { reject_multi_value_call(checker, expression, node, true) }
    if expression_type^.kind == types.TypeKind.VOID || expression_type^.kind == types.TypeKind.UNKNOWN { return }
    // An extern. C call as a statement is a side-effect call: C code routinely ignores return values
    if expression_type^.kind == types.TypeKind.C_FUNCTION { return }
    callee = expression^.call^.function
    if callee^.kind == ast.NodeKind.LABEL {
        name = callee^.label^.value
        if !is_side_effect_call(name) {
            signature = find_func(checker, name)
            if signature == nil || !signature^.is_discard {
                add_diagnostic_help(checker, "E5011", "return value of '${name}()' is not used", "assign the result to a variable, or use 'mut _ = ...' to discard it", node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    } or callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        object_name = callee^.member^.object^.label^.value
        member_name = callee^.member^.member
        signature = find_func(checker, "${resolve_import_alias(checker, object_name)}_${member_name}")
        if signature == nil || !signature^.is_discard {
            mut called_text = "${struct_display_name(checker, object_name)}.${member_name}"
            if callee^.member^.object^.label^.qualifier != "" { called_text = "${callee^.member^.object^.label^.qualifier}.${callee^.member^.object^.label^.qualified_member}.${member_name}" }
            add_diagnostic_help(checker, "E5011", "return value of '${called_text}()' is not used", "assign the result to a variable, or use 'mut _ = ...' to discard it", node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
}

fn check_condition(checker ^TypeChecker, cond ^ast.AstNode, cond_type ^types.GrayType, keyword string) {
    // A void call used as a condition
    mut condition_context string = "an 'if' condition"
    if keyword == "as_long_as" { condition_context = "an 'as_long_as' condition" }
    reject_void_in_context(checker, cond, cond_type, condition_context)
    // A multi-return call cannot be a condition
    if keyword == "if" { reject_multi_return_in_single_position(checker, cond) }
    // A value of a known non-bool type used as a condition. A void call is reported
    // on its own, and a C function result has no Grayscale type to check.
    k = cond_type^.kind
    if k != types.TypeKind.BOOL && k != types.TypeKind.VOID && k != types.TypeKind.UNKNOWN && k != types.TypeKind.C_FUNCTION {
        add_diagnostic(checker, "E3091", error_registry.registry_message_formatted("E3091", {shown_type(checker, cond_type)}), cond^.tok.file, cond^.tok.line, cond^.tok.col)
    }
}

fn check_if_statement(checker ^TypeChecker, node ^ast.AstNode) {
    cond = node^.if_stmt^.condition
    check_condition(checker, cond, resolve_expression(checker, cond), "if")

    outer = checker^.current_scope
    // Each arm is checked from the arena state before the branch; the state after is the join
    arenas_before = checker^.arenas
    then_scope = scope.scope_create(outer)
    checker^.current_scope = then_scope
    check_block(checker, node^.if_stmt^.consequence)
    report_unused_in_scope(checker, then_scope)
    checker^.current_scope = outer
    arenas_then = checker^.arenas
    restore_arena_state(checker, arenas_before)

    alt = node^.if_stmt^.alternative
    if alt != nil {
        else_scope = scope.scope_create(outer)
        checker^.current_scope = else_scope
        check_statement(checker, alt)
        report_unused_in_scope(checker, else_scope)
        checker^.current_scope = outer
    }
    join_arena_state(checker, arenas_then)
}

// A range whose literal bounds run the wrong way for its step.
fn check_range_bounds(checker ^TypeChecker, node ^ast.AstNode) {
    range_node = node^.for_stmt^.iterable
    if range_node == nil || range_node^.kind != ast.NodeKind.RANGE_EXPR { return }
    step = range_node^.range_expr^.step
    mut negative_step bool = false
    mut step_direction_known bool = step == nil
    if step != nil {
        if folding.is_literal_expression(step) {
            step_value, step_folded, _ = fold_const_integer(checker, step)
            if step_folded {
                step_direction_known = true
                negative_step = step_value < 0
            }
        } or step^.kind == ast.NodeKind.PREFIX_EXPR && step^.prefix^.op == token.TokenKind.MINUS {
            step_direction_known = true
            negative_step = true
        }
    }
    start_node = range_node^.range_expr^.start_expr
    end_node = range_node^.range_expr^.end_expr
    if !step_direction_known || start_node == nil || end_node == nil { return }
    if !folding.is_literal_expression(start_node) || !folding.is_literal_expression(end_node) { return }
    start_value, start_folded, _ = fold_const_integer(checker, start_node)
    end_value, end_folded, _ = fold_const_integer(checker, end_node)
    if !start_folded || !end_folded { return }
    mut is_reversed bool = start_value > end_value
    mut relation string = "less than or equal to"
    if negative_step {
        is_reversed = start_value < end_value
        relation = "greater than or equal to"
    }
    if is_reversed {
        add_diagnostic(checker, "E9005", error_registry.registry_message_formatted("E9005", {"${start_value}", relation, "${end_value}"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

fn check_for_statement(checker ^TypeChecker, node ^ast.AstNode) {
    outer = checker^.current_scope
    loop_scope = scope.scope_create(outer)
    checker^.current_scope = loop_scope
    // A stdlib module name as the loop variable
    if reserved.is_stdlib_module_name(node^.for_stmt^.var_name) {
        add_diagnostic(checker, "E5035", error_registry.registry_message_formatted("E5035", {node^.for_stmt^.var_name, "a variable"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    // The loop variable shadows an outer variable
    if node^.for_stmt^.var_name != "" && node^.for_stmt^.var_name != "_" {
        outer_symbol = scope.scope_lookup(outer, node^.for_stmt^.var_name)
        if outer_symbol != nil {
            add_diagnostic(checker, "W2002", error_registry.registry_message_formatted("W2002", {"for variable", node^.for_stmt^.var_name, "${symbol_shadow_line(outer_symbol)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    allow_range_use(checker, node^.for_stmt^.iterable)
    iterable_type = resolve_expression(checker, node^.for_stmt^.iterable)
    // The loop variable has the integer type the range runs in
    mut loop_variable_type = checker^.pool^.type_i64
    if iterable_type^.kind == types.TypeKind.RANGE {
        loop_variable_type = checker_type_from_name(checker, range_element_name(iterable_type))
    } or iterable_type^.kind != types.TypeKind.UNKNOWN {
        add_diagnostic(checker, "E3204", error_registry.registry_message_formatted("E3204", {node^.for_stmt^.var_name, node^.for_stmt^.var_name}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    report_shadowed_module(checker, node, node^.for_stmt^.var_name, node^.for_stmt^.var_name)
    report_shadowed_function(checker, node, node^.for_stmt^.var_name, node^.for_stmt^.var_name)
    scope.scope_define(loop_scope, node^.for_stmt^.var_name, loop_variable_type, false)
    set_binding_line(loop_scope, node^.for_stmt^.var_name, node^.tok.line)
    check_range_bounds(checker, node)
    enter_loop(checker, node)
    premark_loop_body(checker, node^.for_stmt^.body, node^.for_stmt^.body)    check_block(checker, node^.for_stmt^.body)
    leave_loop(checker)
    report_unused_in_scope(checker, loop_scope)
    checker^.current_scope = outer
}

// The first leaf of a written type that names nothing — the element of an
// array, either half of a map, a pointee — or "" when every leaf resolves.
// Unlike validate_field_type_recursive this needs no program: by the time a
// statement is checked the registries already hold every declared type.
fn undefined_type_leaf(checker ^TypeChecker, written_type_name string) -> string {
    type_name = strip_stdlib_qualifiers(checker, checker_substitute_generics(checker, written_type_name))
    if type_name == "" { return "" }
    // A type parameter names a type, bound or not
    if ast.generic_bindings_find(checker^.generics, type_name) >= 0 { return "" }

    if strings.starts_with(type_name, "^") {
        return undefined_type_leaf(checker, strings.slice(type_name, 1, len(type_name)))
    }

    if strings.starts_with(type_name, "[") {
        n = len(type_name)
        if n > ARRAY_BRACKETS_LENGTH && strings.char_at(type_name, n - 1) == ']' {
            mut elem = strings.slice(type_name, 1, n - 1)
            comma_idx = strings.index_of(elem, ",")
            if comma_idx >= 0 { elem = strings.slice(elem, 0, comma_idx) }
            return undefined_type_leaf(checker, elem)
        }
        return ""
    }

    if strings.starts_with(type_name, "map[") {
        n = len(type_name)
        if n > MAP_BRACKETS_LENGTH && strings.char_at(type_name, n - 1) == ']' {
            inner = strings.slice(type_name, MAP_PREFIX_LENGTH, n - 1)
            mut depth = 0
            mut colon_pos = -1
            for i in range(0, len(inner)) {
                character = strings.char_at(inner, i)
                if character == '[' { depth = depth + 1 }
                if character == ']' { depth = depth - 1 }
                if character == ':' && depth == 0 {
                    colon_pos = i
                    break
                }
            }
            if colon_pos >= 0 {
                bad_key = undefined_type_leaf(checker, strings.slice(inner, 0, colon_pos))
                if bad_key != "" { return bad_key }
                return undefined_type_leaf(checker, strings.slice(inner, colon_pos + 1, len(inner)))
            }
        }
        return ""
    }

    if strings.contains(type_name, "?") { return "" }
    // A func(...) type is a function whatever its parameter and return types name,
    // so each of those is a leaf too
    if strings.starts_with(type_name, "func(") {
        function_signature = checker_type_from_name(checker, type_name)^.func_sig
        if function_signature == nil { return "" }
        for_each parameter_name in function_signature^.param_types {
            bad_parameter = undefined_type_leaf(checker, parameter_name)
            if bad_parameter != "" { return bad_parameter }
        }
        for_each return_name in function_signature^.return_types {
            bad_return = undefined_type_leaf(checker, return_name)
            if bad_return != "" { return bad_return }
        }
        return ""
    }
    if strings.starts_with(type_name, "func") { return "" }

    resolved = checker_type_from_name(checker, type_name)
    if resolved^.kind != types.TypeKind.STRUCT && resolved^.kind != types.TypeKind.UNKNOWN { return "" }
    if is_enum_name(checker, type_name) { return "" }
    if is_struct_name(checker, type_name) { return "" }
    if reserved.is_reserved_stdlib_struct_name(type_name) && (type_name == "SourceLocation" || stdlib_opaque_type_available(checker, type_name)) { return "" }
    for_each type_alias in checker^.type_aliases {
        if type_alias.name == type_name { return "" }
    }
    return type_name
}

// The component type names of a written container: the pointee of ^T, the element
// of [T] or [T,N], the key and value of map[K:V]. `is_container` is false for a
// leaf name.
const TypeComponents struct {
    is_container bool
    names [string]
}

fn type_name_components(written string) -> TypeComponents {
    mut result TypeComponents = TypeComponents{is_container: false, names: {}}
    if written == "" { return result }
    if strings.starts_with(written, "^") {
        result.is_container = true
        mut pointee = written
        as_long_as strings.starts_with(pointee, "^") { pointee = strings.slice(pointee, 1, len(pointee)) }
        if pointee != "" { result.names = {pointee} }
        return result
    }
    length = len(written)
    if strings.starts_with(written, "[") {
        result.is_container = true
        if length > ARRAY_BRACKETS_LENGTH && strings.char_at(written, length - 1) == ']' {
            element = strings.slice(written, 1, length - 1)
            mut depth = 0
            for position in range(0, len(element)) {
                character = strings.char_at(element, position)
                if character == '[' { depth = depth + 1 }
                if character == ']' { depth = depth - 1 }
                if character == ',' && depth == 0 {
                    element = strings.slice(element, 0, position)
                    break
                }
            }
            result.names = {element}
        }
        return result
    }
    if strings.starts_with(written, "map[") {
        result.is_container = true
        if length > MAP_BRACKETS_LENGTH && strings.char_at(written, length - 1) == ']' {
            inner = strings.slice(written, MAP_PREFIX_LENGTH, length - 1)
            mut depth = 0
            mut colon_position = -1
            for position in range(0, len(inner)) {
                character = strings.char_at(inner, position)
                if character == '[' { depth = depth + 1 }
                if character == ']' { depth = depth - 1 }
                if character == ':' && depth == 0 {
                    colon_position = position
                    break
                }
            }
            if colon_position >= 0 { result.names = {strings.slice(inner, 0, colon_position), strings.slice(inner, colon_position + 1, len(inner))} }
        }
        return result
    }
    return result
}

// True when a written `func(...) -> ...` type has a container of Error among its
// parameter or return types; a bare Error there is fine.
fn error_type_in_func_signature(written string) -> bool {
    mut cursor = FUNC_PARAMS_START
    mut piece_start = FUNC_PARAMS_START
    mut depth = 1
    as_long_as cursor < len(written) && depth > 0 {
        character = strings.char_at(written, cursor)
        if character == '(' || character == '[' { depth = depth + 1 }
        if character == ')' || character == ']' { depth = depth - 1 }
        is_separator = (character == ',' && depth == 1) || (character == ')' && depth == 0)
        if is_separator {
            if error_type_in_container(strings.trim_left(strings.slice(written, piece_start, cursor)), false) { return true }
            piece_start = cursor + 1
        }
        cursor = cursor + 1
    }
    arrow_position = strings.index_of(strings.slice(written, cursor, len(written)), "->")
    if arrow_position < 0 { return false }
    returns = strings.trim_left(strings.slice(written, cursor + arrow_position + RETURN_ARROW_LENGTH, len(written)))
    if !strings.starts_with(returns, "(") { return error_type_in_container(returns, false) }
    return error_type_in_func_signature("func${returns}")
}

// True when a written type spells Error as an array element or a map key/value, at
// any nesting depth. A bare Error scalar is fine; no container element type maps to it.
fn error_type_in_container(written string, in_container bool) -> bool {
    if written == "" { return false }
    if in_container && (written == "Error" || written == "error") { return true }
    if strings.starts_with(written, "func(") { return error_type_in_func_signature(written) }
    components = type_name_components(written)
    is_array_or_map = strings.starts_with(written, "[") || strings.starts_with(written, "map[")
    for_each component in components.names {
        if error_type_in_container(component, in_container || is_array_or_map) { return true }
    }
    return false
}

// An error for a written type that is bare 'void' or holds it as an array element or
// map value. '^void' and a typed-func return stay legal.
fn reject_void_type(checker ^TypeChecker, node ^ast.AstNode, written string, context string) {
    if written == "" { return }
    if written == "void" {
        add_diagnostic(checker, "E3038", error_registry.registry_message_formatted("E3038", {context}), node^.tok.file, node^.tok.line, node^.tok.col)
    } or !strings.starts_with(written, "func(") && !strings.starts_with(written, "[func(") && type_name_has_value_void(written) {
        add_diagnostic(checker, "E3038", error_registry.registry_message_formatted("E3038", {"an element type in arrays or maps"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// An error when a written annotation nests Error in an array or map. Aliases resolve
// first so `alias Errors = [Error]` cannot hide the spelling.
fn reject_error_in_container(checker ^TypeChecker, node ^ast.AstNode, written string) {
    if error_type_in_container(resolve_type_alias(checker, written), false) {
        add_diagnostic(checker, "E3153", error_registry.registry_message("E3153"), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// True when a resolved array or map literal is non-empty and built only from
// primitive element (and, for a map, key and value) types, so a `mut`
// declaration can infer its type without an annotation.
fn literal_type_inferable(checker ^TypeChecker, literal ^ast.AstNode, t ^types.GrayType) -> bool {
    if literal^.kind != ast.NodeKind.ARRAY_VALUE && literal^.kind != ast.NodeKind.MAP_VALUE { return false }
    if t^.kind == types.TypeKind.ARRAY {
        if len(literal^.array_value^.elements) == 0 || t^.element_type == "" { return false }
        return is_primitive_kind(checker_type_from_name(checker, t^.element_type)^.kind)
    }
    if t^.kind == types.TypeKind.MAP {
        if len(literal^.map_value^.keys) == 0 || t^.key_type == "" || t^.value_type == "" { return false }
        return is_primitive_kind(checker_type_from_name(checker, t^.key_type)^.kind) && is_primitive_kind(checker_type_from_name(checker, t^.value_type)^.kind)
    }
    return false
}

fn is_primitive_kind(k types.TypeKind) -> bool {
    return k == types.TypeKind.INT || k == types.TypeKind.UINT || k == types.TypeKind.FLOAT ||
           k == types.TypeKind.BOOL || k == types.TypeKind.CHAR || k == types.TypeKind.STRING
}

// A name bound here (a variable, parameter, loop variable or `when` binding)
// shadows a function callable by that same name. Display names are compared so a
// local like `mod_size`, the internal name of `mod.size`, never fires.
fn report_shadowed_function(checker ^TypeChecker, node ^ast.AstNode, name string, display_name string) {
    if name == "" || name == "_" || name == "main" { return }
    shadowed = find_func(checker, name)
    if shadowed != nil && shadowed^.decl != nil && shadowed^.file == node^.tok.file {
        mut shadowed_display = shadowed^.decl^.name
        if shadowed^.decl^.original_name != "" { shadowed_display = shadowed^.decl^.original_name }
        if shadowed_display == display_name {
            add_diagnostic(checker, "E4013", error_registry.registry_message_formatted("E4013", {display_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            return
        }
    }
    // Inside a struct, a bare call also reaches the struct's own functions
    if checker^.current_struct_name != "" && find_func(checker, "${checker^.current_struct_name}_${name}") != nil {
        add_diagnostic(checker, "E4013", error_registry.registry_message_formatted("E4013", {display_name}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// A name bound at `node` shadows a module its own file imports.
fn report_shadowed_module(checker ^TypeChecker, node ^ast.AstNode, name string, display_name string) {
    if name == "" { return }
    for_each import_entry in checker^.imports {
        if import_entry.file != node^.tok.file { continue }
        if import_entry.mod_name == name {
            add_diagnostic(checker, "E4014", error_registry.registry_message_formatted("E4014", {display_name}), node^.tok.file, node^.tok.line, node^.tok.col)
            return
        }
    }
}

// A variable named like a struct or enum usable by that same name.
fn report_shadowed_type(checker ^TypeChecker, node ^ast.AstNode, name string, display_name string) {
    mut shadows_type = false
    if is_struct_name(checker, name) && struct_display_name(checker, name) == display_name { shadows_type = true }
    if is_enum_name(checker, name) && enum_display_name(checker, name) == display_name { shadows_type = true }
    if shadows_type {
        add_diagnostic(checker, "E4012", error_registry.registry_message_formatted("E4012", {display_name}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// Binds a declared variable in the current scope. Reports a redeclaration in
// the same scope and a shadowed outer variable (a warning, or a warning when
// the outer one is file-scope). `_` binds nothing.
fn declare_variable_symbol(checker ^TypeChecker, node ^ast.AstNode, declared ^types.GrayType) {
    name = node^.var_decl^.name
    if name == "_" { return }

    if !node^.var_decl^.is_synthetic {
        check_reserved_name(checker, name, node^.tok.file, node^.tok.line, node^.tok.col)
    }

    existing = scope.scope_lookup_local(checker^.current_scope, name)
    if existing != nil && (existing^.def_line != 0 || existing^.param_line != 0) {
        mut declared_line = existing^.def_line
        if declared_line == 0 { declared_line = existing^.param_line }
        mut shown_name = name
        if node^.var_decl^.original_name != "" { shown_name = node^.var_decl^.original_name }
        message = fmt.sprintf("variable '%s' already declared in this scope (line %d)", {shown_name, declared_line})
        if existing^.def_file != "" && existing^.def_file != node^.tok.file {
            other_file = existing^.def_file
            other_name = strings.slice(other_file, strings.last_index_of(other_file, "/") + 1, len(other_file))
            add_diagnostic_help(checker, "E4003", message, "the other declaration is in ${other_name}", node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            add_diagnostic(checker, "E4003", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    // A loop or `when` body shares its scope with the variable the statement binds, so this declaration shadows it
    if existing != nil && existing^.binding_line > 0 && existing^.def_line == 0 && existing^.param_line == 0 {
        add_diagnostic(checker, "W2002", error_registry.registry_message_formatted("W2002", {"variable", name, "${existing^.binding_line}"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    // A `generic` parameter is not a scope symbol, but its name is as taken at the top
    // level of the body as an ordinary parameter's
    if existing == nil && checker^.current_function != nil && checker^.current_scope^.depth + 1 == checker^.current_function_scope_depth && ast.generic_bindings_find(checker^.generics, name) >= 0 {
        add_diagnostic(checker, "E4003", "variable '${name}' already declared in this scope (line ${checker^.current_function^.tok.line})", node^.tok.file, node^.tok.line, node^.tok.col)
    }

    parent = checker^.current_scope^.parent
    if existing == nil && parent != nil {
        outer = scope.scope_lookup(parent, name)
        if outer != nil && symbol_shadow_line(outer) > 0 {
            // Walk up to the scope that owns the outer symbol: file scope has no parent.
            mut owner = parent
            as_long_as owner^.parent != nil && scope.scope_lookup_local(owner, name) == nil {
                owner = owner^.parent
            }
            if owner^.parent == nil {
                message = fmt.sprintf("variable '%s' shadows a global constant or variable declared on line %d", {name, symbol_shadow_line(outer)})
                add_diagnostic(checker, "W2007", message, node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                message = fmt.sprintf("variable '%s' shadows a variable declared on line %d", {name, symbol_shadow_line(outer)})
                add_diagnostic(checker, "W2002", message, node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }

    if name != "main" {
        mut variable_display = name
        if node^.var_decl^.original_name != "" { variable_display = node^.var_decl^.original_name }
        report_shadowed_type(checker, node, name, variable_display)
        report_shadowed_function(checker, node, name, variable_display)
        report_shadowed_module(checker, node, name, variable_display)
    }

    // A variable with an unresolved type is not registered: an error was already
    // reported upstream, and declaring it would cascade. A call or member value, or
    // a value derived from a generic-typed one, is declared anyway.
    initial_value = node^.var_decl^.value
    if declared^.kind == types.TypeKind.UNKNOWN && !strings.contains(declared^.name, "?") && !(initial_value != nil && (initial_value^.kind == ast.NodeKind.CALL_EXPR || initial_value^.kind == ast.NodeKind.MEMBER_EXPR || (initial_value^.kind == ast.NodeKind.LABEL && initial_value^.label^.qualifier != ""))) {
        mut generic_propagation = false
        if initial_value != nil && initial_value^.kind == ast.NodeKind.LABEL {
            source = scope.scope_lookup(checker^.current_scope, initial_value^.label^.value)
            if source != nil && source^.sym_type^.kind == types.TypeKind.UNKNOWN { generic_propagation = true }
        }
        if initial_value != nil && initial_value^.kind == ast.NodeKind.INDEX_EXPR && initial_value^.index_data^.left^.kind == ast.NodeKind.LABEL {
            source = scope.scope_lookup(checker^.current_scope, initial_value^.index_data^.left^.label^.value)
            if source != nil && source^.sym_type^.kind == types.TypeKind.ARRAY && strings.contains(source^.sym_type^.element_type, "?") { generic_propagation = true }
        }
        if !generic_propagation { return }
    }

    scope.scope_define(checker^.current_scope, name, declared, node^.var_decl^.is_mutable)
    symbol = scope.scope_lookup_local(checker^.current_scope, name)
    symbol^.def_line = node^.tok.line
    symbol^.def_file = node^.tok.file
    symbol^.def_column = node^.tok.col
    symbol^.declared_type = node^.var_decl^.type_name
    symbol^.func_ref_name = function_reference_target_name(node^.var_decl^.value)
    if declared^.kind == types.TypeKind.C_FUNCTION && node^.var_decl^.value != nil && node^.var_decl^.value^.kind == ast.NodeKind.CALL_EXPR {
        symbol^.c_call = node^.var_decl^.value
    }
    // A new() result (or an alias of one) lives in the heap arena, which outlives
    // every function scope
    initializer = node^.var_decl^.value
    // A variable bound from ref() is a transparent reference
    if initializer != nil && initializer^.kind == ast.NodeKind.CALL_EXPR && initializer^.call^.function^.kind == ast.NodeKind.LABEL && initializer^.call^.function^.label^.value == "ref" {
        symbol^.is_ref = true
        // A mutable reference to a const source contradicts the source's immutability
        if node^.var_decl^.is_mutable && len(initializer^.call^.args) == 1 {
            source_argument = initializer^.call^.args[0]
            if source_argument^.kind == ast.NodeKind.LABEL {
                source_symbol = scope.scope_lookup(checker^.current_scope, source_argument^.label^.value)
                if source_symbol != nil && !source_symbol^.mutable && find_func(checker, source_argument^.label^.value) == nil {
                    add_diagnostic(checker, "E3079", error_registry.registry_message_formatted("E3079", {source_argument^.label^.value, node^.var_decl^.name}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
            } or source_argument^.kind == ast.NodeKind.MEMBER_EXPR || source_argument^.kind == ast.NodeKind.INDEX_EXPR {
                if !report_write_through_const_pointer(checker, node, source_argument) {
                    root_node = mutable_chain_root(source_argument)
                    if root_node != nil {
                        root_symbol = scope.scope_lookup(checker^.current_scope, root_node^.label^.value)
                        if root_symbol != nil && !root_symbol^.mutable && root_symbol^.sym_type^.kind != types.TypeKind.POINTER {
                            add_diagnostic(checker, "E3079", error_registry.registry_message_formatted("E3079", {root_node^.label^.value, node^.var_decl^.name}), node^.tok.file, node^.tok.line, node^.tok.col)
                        }
                    }
                }
            }
        }
    }
    if initializer != nil && initializer^.kind == ast.NodeKind.NEW_EXPR {
        symbol^.is_heap = true
    } or initializer != nil && initializer^.kind == ast.NodeKind.LABEL {
        heap_source = scope.scope_lookup(checker^.current_scope, initializer^.label^.value)
        if heap_source != nil && heap_source^.is_heap { symbol^.is_heap = true }
    }
    // The origin of the pointer the initializer carries, so a later return or
    // store of this name is still an escape
    record_symbol_origin(checker, symbol, initializer)
    // A @mem arena handle (mut a = mem.arena(n)), or a pointer into one (mut p = mem.init(a, T))
    if initializer != nil {
        apply_mem_call(checker, initializer, node, node^.var_decl^.name)
        bind_mem_pointer(checker, symbol, initializer)
        bind_arena_handle(checker, symbol, initializer, node^.var_decl^.name)
    }
    // The declared variable holds a pointer to a const-declared variable when its
    // initializer does, so writes through it are caught
    if initializer != nil { propagate_const_source(checker, symbol, initializer) }

    // A multi-return call initializer records every slot type on the temp so
    // `.vN` accesses (the parser's destructuring desugar) resolve.
    value = node^.var_decl^.value
    if value != nil && value^.kind == ast.NodeKind.CALL_EXPR && value^.call^.function^.kind == ast.NodeKind.LABEL {
        signature = find_func(checker, value^.call^.function^.label^.value)
        if signature != nil && signature^.is_generic && len(signature^.decl^.return_types) > 1 {
            call_bindings = generic_call_bindings(checker, signature, value)
            for_each slot_text in signature^.decl^.return_types {
                arrays.append(symbol^.ret_types, checker_type_with_generics(checker, call_bindings, slot_text))
            }
        } or signature != nil && len(signature^.return_types) > 1 {
            symbol^.ret_types = signature^.return_types
        }
        if signature == nil {
            callee_sym = scope.scope_lookup(checker^.current_scope, value^.call^.function^.label^.value)
            if callee_sym != nil && callee_sym^.sym_type^.func_sig != nil && callee_sym^.sym_type^.func_sig^.return_count > 1 {
                for_each slot_name in callee_sym^.sym_type^.func_sig^.return_types {
                    arrays.append(symbol^.ret_types, checker_type_from_name(checker, slot_name))
                }
            }
        }
    }
    if value != nil && value^.kind == ast.NodeKind.CALL_EXPR {
        record_stdlib_return_slots(checker, symbol, value)
        record_struct_function_return_slots(checker, symbol, value)
    }
}

// The stdlib functions that return several values without being fallible.
fn stdlib_multi_return_types(checker ^TypeChecker, module_name string, function_name string) -> [^types.GrayType] {
    pool = checker^.pool
    key = "${module_name}.${function_name}"
    when key {
        is "channels.try_receive" { return {pool^.type_i64, pool^.type_bool} }
        is "math.modf" { return {pool^.type_f64, pool^.type_f64} }
        is "uuid.timestamp" { return {pool^.type_i64, pool^.type_bool} }
        is "os.exec" { return {pool^.type_i64, pool^.type_string, pool^.type_string, pool^.type_bool} }
        is "os.lookup_env" { return {pool^.type_string, pool^.type_bool} }
        is "os.find_executable" { return {pool^.type_string, pool^.type_bool} }
        is "path.split_dir_file" { return {pool^.type_string, pool^.type_string} }
        default { return {} }
    }
}

// Records the slot types of a stdlib call on the destructuring temp: the
// fallible `(T, Error)` shape, the fixed multi-returns, and `arrays.find`.
fn record_stdlib_return_slots(checker ^TypeChecker, symbol ^scope.Symbol, value ^ast.AstNode) {
    mut module_name = ""
    mut function_name = ""
    callee = value^.call^.function
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        obj_name = callee^.member^.object^.label^.value
        if scope.scope_lookup(checker^.current_scope, obj_name) != nil { return }
        module_name = resolve_import_alias(checker, obj_name)
        function_name = callee^.member^.member
    }
    if callee^.kind == ast.NodeKind.LABEL && find_func(checker, callee^.label^.value) == nil && scope.scope_lookup(checker^.current_scope, callee^.label^.value) == nil {
        for_each used_module in checker^.using_modules {
            if maps.contains_key(checker^.stdlib_signatures, "${used_module}.${callee^.label^.value}") {
                module_name = used_module
                function_name = callee^.label^.value
                break
            }
        }
    }
    if module_name == "" || !reserved.is_stdlib_module_name(module_name) { return }

    if module_name == "arrays" && function_name == "find" {
        mut element_type = checker^.pool^.type_i64
        if len(value^.call^.args) > 0 {
            array_type = resolve_expression(checker, value^.call^.args[0])
            if array_type^.element_type != "" { element_type = checker_type_from_name(checker, array_type^.element_type) }
        }
        arrays.append(symbol^.ret_types, element_type)
        arrays.append(symbol^.ret_types, checker^.pool^.type_bool)
        return
    }

    // maps.get_and_remove(m, key) -> (V, bool) and maps.find_key(m, value) -> (K, bool)
    if module_name == "maps" && (function_name == "get_and_remove" || function_name == "find_key") {
        mut slot_type = checker^.pool^.type_i64
        if len(value^.call^.args) > 0 {
            map_type = resolve_expression(checker, value^.call^.args[0])
            slot_name = map_type^.value_type
            if function_name == "find_key" { slot_name = map_type^.key_type }
            if slot_name != "" { slot_type = checker_type_from_name(checker, slot_name) }
        }
        arrays.append(symbol^.ret_types, slot_type)
        arrays.append(symbol^.ret_types, checker^.pool^.type_bool)
        return
    }

    key = "${module_name}.${function_name}"
    if maps.contains_key(checker^.stdlib_signatures, key) {
        entry = checker^.stdlib_signatures[key]
        if entry.fallible {
            arrays.append(symbol^.ret_types, checker_type_from_name(checker, entry.success_type))
            // The used/total pair is (i64, i64, Error)
            if module_name == "os" && (function_name == "memory_usage" || function_name == "disk_usage") {
                arrays.append(symbol^.ret_types, checker_type_from_name(checker, entry.success_type))
            }
            arrays.append(symbol^.ret_types, checker_type_from_name(checker, "Error"))
            return
        }
    }
    for_each slot_type in stdlib_multi_return_types(checker, module_name, function_name) {
        arrays.append(symbol^.ret_types, slot_type)
    }
}

// `a, b = value.func()` where func is a struct function with several returns.
fn record_struct_function_return_slots(checker ^TypeChecker, symbol ^scope.Symbol, value ^ast.AstNode) {
    callee = value^.call^.function
    if callee^.kind != ast.NodeKind.MEMBER_EXPR || callee^.member^.object^.kind != ast.NodeKind.LABEL { return }
    receiver = scope.scope_lookup(checker^.current_scope, callee^.member^.object^.label^.value)
    if receiver == nil {
        // dispatch already rewrote `value.func()` to `Struct.func(value)`
        qualifier = callee^.member^.object^.label^.value
        if !is_struct_name(checker, qualifier) { return }
        qualified_signature = find_func(checker, "${qualifier}_${callee^.member^.member}")
        if qualified_signature != nil && len(qualified_signature^.return_types) > 1 { symbol^.ret_types = qualified_signature^.return_types }
        return
    }
    mut struct_name = ""
    if receiver^.sym_type^.kind == types.TypeKind.STRUCT { struct_name = receiver^.sym_type^.name }
    if receiver^.sym_type^.kind == types.TypeKind.POINTER { struct_name = receiver^.sym_type^.element_type }
    if struct_name == "" { return }
    signature = find_func(checker, "${struct_name}_${callee^.member^.member}")
    if signature != nil && len(signature^.return_types) > 1 { symbol^.ret_types = signature^.return_types }
}

// True when a call appears anywhere inside `node`. Builtins that map directly to
// C constructs (new, ref, len, ...) are not runtime calls.
fn expression_contains_call(node ^ast.AstNode) -> bool {
    if node == nil { return false }
    when node^.kind {
        is ast.NodeKind.CALL_EXPR {
            callee = node^.call^.function
            if callee != nil && callee^.kind == ast.NodeKind.LABEL {
                name = callee^.label^.value
                if name == "embed" || name == "here" || name == "new" || name == "ref" || name == "copy" || name == "addr" || name == "raw" || name == "make_size" || name == "len" || name == "type_of" || name == "size_of" {
                    return false
                }
            }
            return true
        }
        is ast.NodeKind.PREFIX_EXPR { return expression_contains_call(node^.prefix^.right) }
        is ast.NodeKind.INFIX_EXPR { return expression_contains_call(node^.infix^.left) || expression_contains_call(node^.infix^.right) }
        is ast.NodeKind.POSTFIX_EXPR { return expression_contains_call(node^.postfix^.left) }
        is ast.NodeKind.INDEX_EXPR { return expression_contains_call(node^.index_data^.left) || expression_contains_call(node^.index_data^.index_expr) }
        is ast.NodeKind.MEMBER_EXPR { return expression_contains_call(node^.member^.object) }
        is ast.NodeKind.RANGE_EXPR {
            return expression_contains_call(node^.range_expr^.start_expr) || expression_contains_call(node^.range_expr^.end_expr) || expression_contains_call(node^.range_expr^.step)
        }
        is ast.NodeKind.CAST_EXPR { return expression_contains_call(node^.cast_data^.value) }
        is ast.NodeKind.ARRAY_VALUE {
            for_each element in node^.array_value^.elements {
                if expression_contains_call(element) { return true }
            }
            return false
        }
        is ast.NodeKind.MAP_VALUE {
            for_each key in node^.map_value^.keys {
                if expression_contains_call(key) { return true }
            }
            for_each value in node^.map_value^.values {
                if expression_contains_call(value) { return true }
            }
            return false
        }
        is ast.NodeKind.STRUCT_VALUE {
            for_each value in node^.struct_value^.field_values {
                if expression_contains_call(value) { return true }
            }
            return false
        }
        is ast.NodeKind.INTERPOLATED_STRING {
            for_each part in node^.interp_string^.parts {
                if expression_contains_call(part) { return true }
            }
            return false
        }
        default { return false }
    }
}

// The keyword a synthetic `_gray_or...` temporary stands for.
fn or_temporary_keyword(temporary_name string) -> string {
    if strings.starts_with(temporary_name, ast.SYNTH_OR_PANIC) { return "or_panic" }
    if strings.starts_with(temporary_name, ast.SYNTH_OR_DEFAULT) { return "or_default" }
    return "or_return"
}

// Checks on a declaration that need no resolved type: the annotation itself
// (void, any, array sizing), the name (reserved, builtin, module), and the
// const/mut/private rules.
// True if `type_name` spells `void` anywhere other than directly behind a `^`:
// `^void` is a C `void *`, but `[void]` and `map[string:void]` hold nothing.
fn type_name_has_value_void(type_name string) -> bool {
    mut search_from i64 = 0
    as_long_as search_from <= len(type_name) - VOID_KEYWORD_LENGTH {
        found = strings.index_of(strings.slice(type_name, search_from, len(type_name)), "void")
        if found < 0 { return false }
        position = search_from + found
        starts_word = position == 0 || !(is_identifier_byte(strings.char_at(type_name, position - 1)))
        ends_word = position + VOID_KEYWORD_LENGTH >= len(type_name) || !(is_identifier_byte(strings.char_at(type_name, position + VOID_KEYWORD_LENGTH)))
        if starts_word && ends_word && (position == 0 || strings.char_at(type_name, position - 1) != '^') { return true }
        search_from = position + 1
    }
    return false
}

fn is_identifier_byte(character char) -> bool {
    return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9') || character == '_'
}

fn check_variable_declaration_annotation(checker ^TypeChecker, node ^ast.AstNode) {
    variable_data = node^.var_decl
    // Resolve type aliases in the declared type name so downstream checks and
    // codegen see the underlying type.
    if variable_data^.type_name != "" { variable_data^.type_name = resolve_type_alias_keeping_distinct(checker, variable_data^.type_name) }
    warn_if_type_name_deprecated(checker, node, variable_data^.type_name, "")
    mark_written_type_module_used(checker, variable_data^.type_name)
    file = node^.tok.file
    line = node^.tok.line
    col = node^.tok.col
    // A const identifier size (`[i64,SIZE]`) is resolved to its number before the mut/const checks
    if strings.starts_with(variable_data^.type_name, "[") && type_has_array_size(variable_data^.type_name) {
        variable_data^.type_name = resolve_array_size_text(checker, variable_data^.type_name, file, line, col)
    }
    mut display = variable_data^.name
    if variable_data^.original_name != "" { display = variable_data^.original_name }
    is_temporary = strings.starts_with(variable_data^.name, ast.SYNTH_TMP)
    is_or_temporary = strings.starts_with(variable_data^.name, ast.SYNTH_OR)
    value = variable_data^.value

    // A file-scope initializer cannot contain a runtime call
    if checker^.function_depth == 0 && value != nil && expression_contains_call(value) {
        add_diagnostic(checker, "E5013", error_registry.registry_message("E5013"), file, line, col)
    }
    // A function-scope const initializer cannot contain a runtime call
    if checker^.function_depth > 0 && !variable_data^.is_mutable && value != nil && expression_contains_call(value) {
        add_diagnostic(checker, "E5040", error_registry.registry_message("E5040"), file, line, col)
    }
    // Void as a variable type or inside an array/map type
    if variable_data^.type_name == "void" {
        add_diagnostic(checker, "E3038", error_registry.registry_message_formatted("E3038", {"a variable type"}), file, line, col)
    }
    if variable_data^.type_name != "" && variable_data^.type_name != "void" && type_name_has_value_void(variable_data^.type_name) {
        is_typed_function = strings.starts_with(variable_data^.type_name, "func(") || strings.starts_with(variable_data^.type_name, "[func(")
        if !is_typed_function {
            add_diagnostic(checker, "E3038", error_registry.registry_message_formatted("E3038", {"an element type in arrays or maps"}), file, line, col)
        }
    }
    // Func references are const
    if variable_data^.is_mutable {
        is_function_reference_value = value != nil && value^.kind == ast.NodeKind.FUNC_REF
        is_function_type = strings.starts_with(variable_data^.type_name, "func(")
        if is_function_reference_value || is_function_type {
            add_diagnostic(checker, "E3101", error_registry.registry_message("E3101"), file, line, col)
        }
    }
    // 'any' is reserved
    if variable_data^.type_name == "any" {
        add_diagnostic(checker, "E3034", error_registry.registry_message("E3034"), file, line, col)
    }
    // A reserved name as a variable name
    if !strings.starts_with(variable_data^.name, "_") {
        check_declaration_name(checker, variable_data^.name, display, "a variable", file, line, col)
    }
    check_reserved_main(checker, variable_data^.name, file, line, col)

    // Or_return / or_panic / or_default need a call returning (T, Error)
    if is_or_temporary && value != nil && value^.kind != ast.NodeKind.CALL_EXPR {
        add_diagnostic(checker, "E3211", error_registry.registry_message_formatted("E3211", {or_temporary_keyword(variable_data^.name)}), value^.tok.file, value^.tok.line, value^.tok.col)
    }
    if is_or_temporary && value != nil && value^.kind == ast.NodeKind.CALL_EXPR {
        call_function = value^.call^.function
        mut call_name = ""
        mut call_display = ""
        if call_function^.kind == ast.NodeKind.LABEL {
            call_name = call_function^.label^.value
            call_display = call_name
        } otherwise {
            qualifier = ast.ast_member_qualifier(call_function)
            if qualifier != "" {
                call_name = "${resolve_import_alias(checker, qualifier)}_${call_function^.member^.member}"
                call_display = "${qualifier}.${call_function^.member^.member}"
            }
        }
        if call_name != "" {
            signature = find_func(checker, call_name)
            mut is_non_fallible_native = false
            if signature == nil {
                if call_function^.kind != ast.NodeKind.LABEL {
                    native_key = "${resolve_import_alias(checker, ast.ast_member_qualifier(call_function))}.${call_function^.member^.member}"
                    is_non_fallible_native = maps.contains_key(checker^.stdlib_signatures, native_key) && !checker^.stdlib_signatures[native_key].fallible
                } or reserved.is_reserved_builtin_func_name(call_name) {
                    is_non_fallible_native = true
                } otherwise {
                    using_module = find_using_stdlib_module(checker, call_name)
                    if using_module != "" {
                        is_non_fallible_native = !checker^.stdlib_signatures["${using_module}.${call_name}"].fallible
                    }
                }
            }
            if is_non_fallible_native || (signature != nil && (len(signature^.return_types) < 2 || signature^.return_types[len(signature^.return_types) - 1]^.kind != types.TypeKind.ERROR)) {
                add_diagnostic(checker, "E3045", error_registry.registry_message_formatted("E3045", {or_temporary_keyword(variable_data^.name), call_display}), value^.tok.file, value^.tok.line, value^.tok.col)
            }
        }
    }
    // A mut declaration with a type but no value silently zero-initializes; say so
    if variable_data^.is_mutable && value == nil && variable_data^.type_name != "" && variable_data^.name != "_" && !strings.starts_with(variable_data^.name, ast.SYNTH_TMP) && !strings.starts_with(variable_data^.name, ast.SYNTH_OR) {
        mut zero_text = "its zero value"
        when variable_data^.type_name {
            is "f64", "f32" { zero_text = "0.0" }
            is "string" { zero_text = "\"\"" }
            is "bool" { zero_text = "false" }
            is "char" { zero_text = "'\\0'" }
            default {
                if is_integer_type_text(variable_data^.type_name) { zero_text = "0" }
            }
        }
        add_diagnostic(checker, "W1004", error_registry.registry_message_formatted("W1004", {display, zero_text}), file, line, col)
    }
    // Maps cannot be const
    if !variable_data^.is_mutable && strings.starts_with(variable_data^.type_name, "map[") {
        add_diagnostic(checker, "E3059", error_registry.registry_message("E3059"), file, line, col)
    }
    // A const needs a value
    if !variable_data^.is_mutable && value == nil {
        add_diagnostic(checker, "E2011", error_registry.registry_message_formatted("E2011", {display}), file, line, col)
    }
    // A type name used as the value
    if value != nil && value^.kind == ast.NodeKind.LABEL && reserved.is_reserved_type_name(value^.label^.value) {
        value_name = value^.label^.value
        add_diagnostic(checker, "E3011", error_registry.registry_message_formatted("E3011", {value_name, value_name}), value^.tok.file, value^.tok.line, value^.tok.col)
    }
    // A file-scope or struct-scope const of a primitive type needs an annotation
    if !variable_data^.is_mutable && variable_data^.type_name == "" && value != nil && (checker^.function_depth == 0 || checker^.current_struct_name != "") && !is_temporary && !is_or_temporary && value^.kind != ast.NodeKind.STRUCT_VALUE && value^.kind != ast.NodeKind.FUNC_REF && value^.kind != ast.NodeKind.ARRAY_VALUE && value^.kind != ast.NodeKind.MAP_VALUE {
        mut suggested = "<type>"
        #strict
        when value^.kind {
            is ast.NodeKind.INT_VALUE { suggested = "i64" }
            is ast.NodeKind.FLOAT_VALUE { suggested = "f64" }
            is ast.NodeKind.STRING_VALUE { suggested = "string" }
            is ast.NodeKind.INTERPOLATED_STRING { suggested = "string" }
            is ast.NodeKind.CHAR_VALUE { suggested = "char" }
            is ast.NodeKind.BOOL_VALUE { suggested = "bool" }
            is ast.NodeKind.LABEL, ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
            ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
            ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
            ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR,
            ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM,
            ast.NodeKind.WHEN_PATTERN, ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT,
            ast.NodeKind.RETURN_STMT, ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT,
            ast.NodeKind.BLOCK_STMT, ast.NodeKind.IF_STMT, ast.NodeKind.WHEN_STMT, ast.NodeKind.FOR_STMT,
            ast.NodeKind.FOR_EACH_STMT, ast.NodeKind.WHILE_STMT, ast.NodeKind.LOOP_STMT,
            ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL,
            ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL,
            ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL, ast.NodeKind.MODULE_DECL,
            ast.NodeKind.PROGRAM {}
        }
        add_diagnostic(checker, "E3131", error_registry.registry_message_formatted("E3131", {display, suggested}), file, line, col)
    }
    // A mutable array has no fixed size, a const array has one
    if strings.starts_with(variable_data^.type_name, "[") {
        has_size = type_has_array_size(variable_data^.type_name)
        if variable_data^.is_mutable && has_size {
            add_diagnostic_help(checker, "E3054", "mutable array '${display}' cannot have a fixed size '${spaced_type_spelling(variable_data^.type_name)}'", "use 'const' for fixed-size arrays, or remove the size for a dynamic 'mut' array", file, line, col)
        } or !variable_data^.is_mutable && !has_size {
            add_diagnostic(checker, "E3055", "const array '${display}' of type ${variable_data^.type_name} must have a fixed size", file, line, col)
        }
    }
    check_fixed_array_length(checker, value, variable_data^.type_name, node)
    warn_short_fixed_array(checker, value, variable_data^.type_name, "", node)
    // Private only applies to top-level declarations
    if variable_data^.is_private && checker^.function_depth > 0 {
        add_diagnostic(checker, "E4029", error_registry.registry_message("E4029"), file, line, col)
    }
}

// Resolves a non-numeric size in a fixed-size array type `[T,SIZE]` to the value of
// the const integer it names (`[T,5]`). An error for a name that is no known const
// integer, for one that is not positive, and for a non-positive number.
fn resolve_array_size_text(checker ^TypeChecker, type_text string, file string, line i64, col i64) -> string {
    inner = strings.slice(type_text, 1, len(type_text) - 1)
    comma = types.type_top_level_comma(inner)
    if comma < 0 || !strings.ends_with(type_text, "]") { return type_text }
    size_text = strings.trim(strings.slice(inner, comma + 1, len(inner)))
    if size_text == "" { return type_text }
    mut is_numeric = true
    for position in range(0, len(size_text)) {
        digit = strings.char_at(size_text, position)
        if (digit < '0' || digit > '9') && !(position == 0 && digit == '-' && len(size_text) > 1) { is_numeric = false }
    }
    if is_numeric {
        number, parsed = parse_integer_text(size_text)
        if parsed && number <= 0 {
            add_diagnostic(checker, "E3194", error_registry.registry_message_formatted("E3194", {"${number}"}), file, line, col)
        }
        return type_text
    }
    index = folding.constant_table_find(checker^.const_integers, size_text)
    if index < 0 {
        add_diagnostic(checker, "E3125", error_registry.registry_message_formatted("E3125", {size_text}), file, line, col)
        return type_text
    }
    resolved = checker^.const_integers^.values[index]
    resolved_text = folding.literal_text(resolved)
    if resolved.is_negative || folding.magnitude_is_zero(resolved.magnitude) {
        add_diagnostic(checker, "E3126", error_registry.registry_message_formatted("E3126", {size_text, resolved_text}), file, line, col)
        return type_text
    }
    return "[${strings.slice(inner, 0, comma)},${resolved_text}]"
}

// The value of a written decimal integer, and whether it parsed.
fn parse_integer_text(text string) -> (i64, bool) {
    mut value i64 = 0
    mut is_negative = false
    for position in range(0, len(text)) {
        digit = strings.char_at(text, position)
        if position == 0 && digit == '-' {
            is_negative = true
            continue
        }
        if digit < '0' || digit > '9' || value > MAX_VALUE_BEFORE_NEXT_DIGIT { return 0, false }
        value = value * DECIMAL_BASE + cast(digit, i64) - cast('0', i64)
    }
    if is_negative { return -value, true }
    return value, true
}

// The size of a written fixed-size array `[T,N]`, or 0 for any other spelling.
fn fixed_array_declared_size(spelling string) -> i64 {
    if !strings.starts_with(spelling, "[") || !strings.ends_with(spelling, "]") { return 0 }
    inner = strings.slice(spelling, 1, len(spelling) - 1)
    comma = types.type_top_level_comma(inner)
    if comma < 0 { return 0 }
    mut size i64 = 0
    for position in range(comma + 1, len(inner)) {
        digit = strings.char_at(inner, position)
        if digit == ' ' { continue }
        if digit < '0' || digit > '9' { return 0 }
        size = size * DECIMAL_BASE + cast(digit, i64) - cast('0', i64)
    }
    return size
}

// An error when an array literal has more elements than the fixed size its declared type
// gives it (and, for a nested fixed-size element type, any element literal does).
// `at` is where the top-level error is reported; a nested element reports at itself.
fn check_fixed_array_length(checker ^TypeChecker, value ^ast.AstNode, spelling string, at ^ast.AstNode) {
    if value == nil || value^.kind != ast.NodeKind.ARRAY_VALUE { return }
    size = fixed_array_declared_size(spelling)
    if size <= 0 { return }
    count = len(value^.array_value^.elements)
    if count > size {
        add_diagnostic(checker, "E3052", error_registry.registry_message_formatted("E3052", {"${size}", "${count}"}), at^.tok.file, at^.tok.line, at^.tok.col)
    }
    inner = strings.slice(spelling, 1, len(spelling) - 1)
    element_spelling = strings.slice(inner, 0, types.type_top_level_comma(inner))
    for_each element in value^.array_value^.elements {
        check_fixed_array_length(checker, element, element_spelling, element)
    }
}

// True when an array type is spelled with a size, `[T,N]`: a comma at depth 1.
fn type_has_array_size(type_text string) -> bool {
    mut depth i64 = 0
    for i in range(0, len(type_text)) {
        character = strings.char_at(type_text, i)
        if character == '(' || character == '[' {
            depth += 1
        } or character == ')' || character == ']' {
            depth -= 1
        } or character == ',' && depth == 1 {
            return true
        }
    }
    return false
}

// True for a Grayscale type C can hand back directly through a value return: the number
// families, bool, char, and any pointer. A C function result annotated with one of these
// is the user asserting the C return type; string goes through from_c_string(), aggregates
// through individual fields.
fn c_function_result_fits(result_type ^types.GrayType) -> bool {
    if result_type == nil { return false }
    if result_type^.name == "i128" || result_type^.name == "i256" || result_type^.name == "u128" || result_type^.name == "u256" { return false }
    return result_type^.kind == types.TypeKind.INT || result_type^.kind == types.TypeKind.UINT || result_type^.kind == types.TypeKind.FLOAT || result_type^.kind == types.TypeKind.BOOL || result_type^.kind == types.TypeKind.CHAR || result_type^.kind == types.TypeKind.POINTER
}

// Records the type a C call's result is declared or cast to on the call's extern site,
// so the driver can check it against the real C return type.
fn extern_call_assert_type(checker ^TypeChecker, call ^ast.AstNode, asserted ^types.GrayType, via_cast bool) {
    mut sites [ExternCallSite] = checker^.extern_calls
    for site_index in range(0, len(sites)) {
        if sites[site_index].is_call && sites[site_index].node == call {
            sites[site_index].asserted_type = asserted
            sites[site_index].is_asserted_via_cast = via_cast
        }
    }
    checker^.extern_calls = sites
}

fn check_variable_declaration(checker ^TypeChecker, node ^ast.AstNode) {
    variable_data = node^.var_decl
    // `retrun x` parses as a declaration of 'retrun' with type 'x'; the
    // misspelled statement is the mistake, not the operand.
    if variable_data^.is_bare && variable_data^.value == nil && variable_data^.type_name != "" && undefined_type_leaf(checker, variable_data^.type_name) == variable_data^.type_name {
        suggested_statement = suggest.suggest_statement_name(variable_data^.name)
        if suggested_statement != "" {
            add_diagnostic(checker, "E4041", error_registry.registry_message_formatted("E4041", {variable_data^.name, suggested_statement}), node^.tok.file, node^.tok.line, node^.tok.col)
            return
        }
    }
    check_variable_declaration_annotation(checker, node)
    mut declared = checker^.pool^.type_unknown
    if variable_data^.type_name != "" { declared = checker_type_from_name(checker, variable_data^.type_name) }

    // An annotation naming a type that does not exist, at any depth
    bad_leaf = undefined_type_leaf(checker, variable_data^.type_name)
    if bad_leaf != "" {
        message = fmt.sprintf("undefined type '%s'; check the spelling or import the module that defines it", {unqualified_display_name(bad_leaf)})
        add_diagnostic(checker, "E4016", message, node^.tok.file, node^.tok.line, node^.tok.col)
    }
    reject_error_in_container(checker, node, variable_data^.type_name)

    value = variable_data^.value
    if value != nil {
        allow_range_use(checker, value)
        saved_hidden_group_names = checker^.hidden_group_names
        if checker^.function_depth == 0 { checker^.hidden_group_names = variable_data^.earlier_group_names }
        saved_initialized_name = checker^.initialized_variable_name
        saved_reading_own_name = checker^.is_initializer_reading_own_name
        checker^.initialized_variable_name = variable_data^.name
        checker^.is_initializer_reading_own_name = false
        reject_non_json_parse_target(checker, node, value, declared)
        checker^.json_parse_target_call = nil
        if variable_data^.type_name != "" { checker^.json_parse_target_call = value }
        value_type = check_expression_as(checker, value, declared)
        variable_data^.shadows_own_initializer = checker^.is_initializer_reading_own_name
        checker^.initialized_variable_name = saved_initialized_name
        checker^.is_initializer_reading_own_name = saved_reading_own_name
        checker^.hidden_group_names = saved_hidden_group_names

        // An array or map literal with no annotation needs one,
        // unless a `mut` declaration built from primitives can infer it
        if variable_data^.type_name == "" && !strings.starts_with(variable_data^.name, "_gray_") {
            is_array = value^.kind == ast.NodeKind.ARRAY_VALUE
            is_map = value^.kind == ast.NodeKind.MAP_VALUE
            inferred = variable_data^.is_mutable && literal_type_inferable(checker, value, value_type)
            if is_array && !inferred {
                add_diagnostic_help(checker, "E3050", "array needs a type annotation; declare as [T] (e.g., mut x [i64] = {1, 2, 3})", "add a type annotation, e.g. 'mut x [i64] = {1, 2, 3}'", node^.tok.file, node^.tok.line, node^.tok.col)
            }
            if is_map && !inferred {
                add_diagnostic_help(checker, "E3051", "map needs a type annotation; declare as [K:V] or map[K:V] (e.g., mut x [string:i64] = {\"a\": 1})", "add a type annotation, e.g. 'mut x [string:i64] = {\"a\": 1}'", node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }

        // Cannot assign a void function's result
        if value_type^.kind == types.TypeKind.VOID {
            add_diagnostic(checker, "E3187", error_registry.registry_message_formatted("E3187", {"the value of a variable"}), node^.tok.file, node^.tok.line, node^.tok.col)
        }

        // A func-type return value cannot be assigned to a variable; a func
        // reference is made with `()name` or `ref(name)`
        if value_type^.kind == types.TypeKind.FUNCTION && value^.kind == ast.NodeKind.CALL_EXPR && !(value^.call^.function^.kind == ast.NodeKind.LABEL && value^.call^.function^.label^.value == "ref") {
            call_function = value^.call^.function
            mut called = "function"
            if call_function^.kind == ast.NodeKind.LABEL {
                called = call_function^.label^.value
            } or call_function^.kind == ast.NodeKind.MEMBER_EXPR && call_function^.member^.object^.kind == ast.NodeKind.LABEL {
                called = "${call_function^.member^.object^.label^.value}.${call_function^.member^.member}"
            }
            add_diagnostic(checker, "E3102", error_registry.registry_message_formatted("E3102", {called}), node^.tok.file, node^.tok.line, node^.tok.col)
        }

        // A multi-value call bound to a single variable (skipped for a part of a
        // multi-var expansion; its value is a .v0 access)
        if value^.kind == ast.NodeKind.CALL_EXPR && !strings.starts_with(variable_data^.name, ast.SYNTH_TMP) && !strings.starts_with(variable_data^.name, ast.SYNTH_OR) {
            reject_multi_value_call(checker, value, node, false)
        } or variable_data^.holds_single_value {
            // One value of `mut x, y = 1, f()`: bound to exactly one name, so a fallible or
            // multi-value call is unhandled
            reject_multi_return_in_single_position(checker, value)
        }

        // Nil only fits pointer and Error types
        if value_type^.kind == types.TypeKind.NIL_TYPE {
            if declared^.kind == types.TypeKind.UNKNOWN {
                add_diagnostic(checker, "E3196", error_registry.registry_message("E3196"), node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                if declared^.kind != types.TypeKind.ERROR && declared^.kind != types.TypeKind.POINTER && declared^.kind != types.TypeKind.NIL_TYPE {
                    message = fmt.sprintf("cannot assign nil to '%s'; only Error and pointer types are nullable", {shown_type(checker, declared)})
                    add_diagnostic(checker, "E3157", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }

        check_function_signature(checker, value, declared, value_type)

        if declared^.kind == types.TypeKind.UNKNOWN && !(variable_data^.type_name != "" && strings.contains(declared^.name, "?")) {
            declared = value_type
        } or declared^.kind == types.TypeKind.UNKNOWN {
            // a type parameter's placeholder stays the variable's type
        } or value_type^.kind == types.TypeKind.C_FUNCTION {
            // The one place a C function result may meet a declared type: the annotation is
            // the user asserting the C return type
            if !c_function_result_fits(declared) {
                message = fmt.sprintf("type mismatch: cannot assign %s to %s", {shown_type(checker, value_type), shown_type(checker, declared)})
                add_diagnostic_help(checker, "E3001", message, "convert it with from_c_string() for text, or read individual fields", node^.tok.file, node^.tok.line, node^.tok.col)
            } otherwise {
                extern_call_assert_type(checker, value, declared, false)
            }
        } otherwise {
            if bad_leaf == "" && value_type^.kind != types.TypeKind.UNKNOWN && value_type^.kind != types.TypeKind.VOID && value_type^.kind != types.TypeKind.NIL_TYPE {
                both_pointers = declared^.kind == types.TypeKind.POINTER && value_type^.kind == types.TypeKind.POINTER
                if !both_pointers && !types_assignable(checker, declared, value_type) && !(declared^.kind == types.TypeKind.POINTER && is_ref_variable(checker, value)) && !(declared^.kind == types.TypeKind.MAP && value^.kind == ast.NodeKind.ARRAY_VALUE) {
                    message = fmt.sprintf("type mismatch: cannot assign %s to %s", {shown_type(checker, value_type), shown_type(checker, declared)})
                    add_diagnostic(checker, "E3001", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
                // Pointer to pointer with different pointees
                if both_pointers && declared^.name != value_type^.name {
                    message = fmt.sprintf("type mismatch: cannot assign %s to %s", {shown_type(checker, value_type), shown_type(checker, declared)})
                    add_diagnostic(checker, "E3001", message, node^.tok.file, node^.tok.line, node^.tok.col)
                }
                // Both maps, but a different key or value type
                if declared^.kind == types.TypeKind.MAP && value_type^.kind == types.TypeKind.MAP && !map_types_match(declared, value_type) {
                    add_diagnostic(checker, "E3001", error_registry.registry_message_formatted("E3001", {shown_type(checker, value_type), shown_type(checker, declared)}), node^.tok.file, node^.tok.line, node^.tok.col)
                }
            }
        }
        // An array literal for a map falls through the type check (it has no elements to
        // derive a type from): point at the map literal form
        if variable_data^.type_name != "" && strings.starts_with(variable_data^.type_name, "map[") && value^.kind == ast.NodeKind.ARRAY_VALUE {
            mut map_initializer_help = "map literals use '{key: value, ...}' syntax"
            if len(value^.array_value^.elements) == 0 { map_initializer_help = "use '{:}' for an empty map" }
            add_diagnostic_help(checker, "E3001", error_registry.registry_message_formatted("E3001", {"an array literal", variable_data^.type_name}), map_initializer_help, value^.tok.file, value^.tok.line, value^.tok.col)
        }
    }

    // A blank identifier needs no type annotation
    if variable_data^.name == "_" && variable_data^.type_name != "" {
        add_diagnostic(checker, "W1005", "typed blank identifier; '_' doesn't need a type annotation, use 'mut _ = <expr>' instead", node^.tok.file, node^.tok.line, node^.tok.col)
    }

    check_const_integer_value(checker, node)

    // A composite type is not hashable as a map key (enums are integer-backed)
    if declared^.kind == types.TypeKind.MAP && declared^.key_type != "" {
        key_type_name = resolve_type_alias(checker, declared^.key_type)
        key_resolved = types.type_from_name(checker^.pool, key_type_name)
        if (key_resolved^.kind == types.TypeKind.STRUCT && !is_enum_name(checker, key_type_name)) || key_resolved^.kind == types.TypeKind.ARRAY || key_resolved^.kind == types.TypeKind.MAP || key_resolved^.kind == types.TypeKind.POINTER {
            add_diagnostic(checker, "E3057", error_registry.registry_message_formatted("E3057", {key_type_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }

    // Handle types (channels, mutexes, threads, builders) cannot be const
    if !variable_data^.is_mutable && declared^.kind == types.TypeKind.STRUCT && declared^.name != "" {
        mut handle_label = ""
        when declared^.name {
            is "Channel" { handle_label = "channel" }
            is "Mutex" { handle_label = "mutex" }
            is "Thread" { handle_label = "thread handle" }
            is "Builder" { handle_label = "string builder" }
        }
        if handle_label != "" {
            add_diagnostic(checker, "E3062", error_registry.registry_message_formatted("E3062", {handle_label, handle_label}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    declare_variable_symbol(checker, node, declared)
}

// Records a const integer's folded value for later folding.
fn register_const_integer(checker ^TypeChecker, name string, value folding.LiteralValue) {
    arrays.append(checker^.const_integers^.names, name)
    arrays.append(checker^.const_integers^.values, value)
}

// Tracks a const integer's value for constant folding in later declarations and
// rejects a const expression whose arithmetic overflows its declared type.
fn check_const_integer_value(checker ^TypeChecker, node ^ast.AstNode) {
    variable_data = node^.var_decl
    if variable_data^.is_mutable || variable_data^.type_name == "" || variable_data^.value == nil || folding.integer_type_bits(variable_data^.type_name) == 0 { return }
    checker^.const_integers^.typed_as = variable_data^.type_name
    folded, is_constant = folding.constant_fold(checker^.const_integers, variable_data^.value)
    checker^.const_integers^.typed_as = ""
    if !is_constant || folded.is_decimal { return }
    if !folded.is_too_large {
        register_const_integer(checker, variable_data^.name, folded)
    } or !folding.is_literal_expression(variable_data^.value) {
        add_diagnostic(checker, "E5039", error_registry.registry_message_formatted("E5039", {variable_data^.type_name}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// Registers every file-scope const integer before declarations are checked.
fn register_file_scope_const_integers(checker ^TypeChecker, program ^ast.AstNode) {
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.VAR_DECL { continue }
        variable_data = statement^.var_decl
        if variable_data^.is_mutable || variable_data^.is_synthetic || variable_data^.type_name == "" || variable_data^.value == nil { continue }
        if folding.integer_type_bits(variable_data^.type_name) == 0 { continue }
        folded, is_constant = folding.constant_fold(checker^.const_integers, variable_data^.value)
        if is_constant && !folded.is_decimal && !folded.is_too_large {
            register_const_integer(checker, variable_data^.name, folded)
        }
    }
}

// The variable at the root of an assignment target: walks member, index and
// `^` dereference chains down to the leading label, or nil when the chain
// does not start at one (a call result, for instance).
fn assign_target_root(target ^ast.AstNode) -> ^ast.AstNode {
    mut base = target
    as_long_as base != nil {
        if base^.kind == ast.NodeKind.MEMBER_EXPR {
            base = base^.member^.object
        } otherwise {
            if base^.kind == ast.NodeKind.INDEX_EXPR {
                base = base^.index_data^.left
            } otherwise {
                if base^.kind == ast.NodeKind.POSTFIX_EXPR && base^.postfix^.op == token.TokenKind.CARET {
                    base = base^.postfix^.left
                } otherwise {
                    break
                }
            }
        }
    }
    if base != nil && base^.kind == ast.NodeKind.LABEL { return base }
    return nil
}

// --- Escape summaries ---
//
// What a call does with the pointers it is given, worked out from the callee's
// body without a live scope: which parameters' addresses the result may carry
// (returns_parameter_address), where each parameter's address is stored
// (parameter_escape_into: a global, or another parameter's storage), and
// whether the function can return a pointer to a module-level constant.

const ESCAPE_NONE i64 = -1
const ESCAPE_GLOBAL i64 = -2

// The value a local named `name` was declared with, searched anywhere in
// `node`, or nil.
fn local_initializer(node ^ast.AstNode, name string) -> ^ast.AstNode {
    if node == nil { return nil }
    when node^.kind {
        is ast.NodeKind.VAR_DECL {
            if node^.var_decl^.name == name { return node^.var_decl^.value }
            return local_initializer(node^.var_decl^.value, name)
        }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts {
                found = local_initializer(statement, name)
                if found != nil { return found }
            }
            return nil
        }
        is ast.NodeKind.IF_STMT {
            found = local_initializer(node^.if_stmt^.consequence, name)
            if found != nil { return found }
            return local_initializer(node^.if_stmt^.alternative, name)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases {
                found = local_initializer(case_entry.body, name)
                if found != nil { return found }
            }
            return local_initializer(node^.when_stmt^.default_body, name)
        }
        is ast.NodeKind.FOR_STMT { return local_initializer(node^.for_stmt^.body, name) }
        is ast.NodeKind.FOR_EACH_STMT { return local_initializer(node^.for_each_stmt^.body, name) }
        is ast.NodeKind.WHILE_STMT { return local_initializer(node^.while_stmt^.body, name) }
        is ast.NodeKind.LOOP_STMT { return local_initializer(node^.loop_stmt^.body, name) }
        default { return nil }
    }
}

// Is `name` declared as a local anywhere in `node`?
fn declared_in_subtree(node ^ast.AstNode, name string) -> bool {
    if node == nil { return false }
    when node^.kind {
        is ast.NodeKind.VAR_DECL { return node^.var_decl^.name == name }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts {
                if declared_in_subtree(statement, name) { return true }
            }
            return false
        }
        is ast.NodeKind.IF_STMT { return declared_in_subtree(node^.if_stmt^.consequence, name) || declared_in_subtree(node^.if_stmt^.alternative, name) }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases {
                if declared_in_subtree(case_entry.body, name) { return true }
            }
            return declared_in_subtree(node^.when_stmt^.default_body, name)
        }
        is ast.NodeKind.FOR_STMT { return node^.for_stmt^.var_name == name || declared_in_subtree(node^.for_stmt^.body, name) }
        is ast.NodeKind.FOR_EACH_STMT { return declared_in_subtree(node^.for_each_stmt^.body, name) }
        is ast.NodeKind.WHILE_STMT { return declared_in_subtree(node^.while_stmt^.body, name) }
        is ast.NodeKind.LOOP_STMT { return declared_in_subtree(node^.loop_stmt^.body, name) }
        default { return false }
    }
}

// The function a func-ref initializer names, `()target` or `ref(target)`, or "".
fn function_reference_target_name(value ^ast.AstNode) -> string {
    if value == nil { return "" }
    if value^.kind == ast.NodeKind.FUNC_REF {
        target = value^.func_ref^.function
        if target != nil && target^.kind == ast.NodeKind.LABEL { return target^.label^.value }
        if target != nil && target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind == ast.NodeKind.LABEL { return "${target^.member^.object^.label^.value}_${target^.member^.member}" }
        return ""
    }
    if value^.kind == ast.NodeKind.CALL_EXPR && value^.call^.function != nil && value^.call^.function^.kind == ast.NodeKind.LABEL && value^.call^.function^.label^.value == "ref" && len(value^.call^.args) == 1 && value^.call^.args[0]^.kind == ast.NodeKind.LABEL {
        return value^.call^.args[0]^.label^.value
    }
    return ""
}

// resolve_call_signature, extended to see through a call to a func-ref variable
// declared inside `body`.
fn resolve_call_signature_in_body(checker ^TypeChecker, body ^ast.AstNode, call ^ast.AstNode) -> ^FuncSig {
    direct = resolve_call_signature(checker, call)
    if direct != nil { return direct }
    callee = call^.call^.function
    if callee == nil || callee^.kind != ast.NodeKind.LABEL { return nil }
    target = function_reference_target_name(local_initializer(body, callee^.label^.value))
    if target == "" { return nil }
    return find_func(checker, target)
}

// The index of the parameter of `signature` named `name`, or -1.
fn parameter_index_of(signature ^FuncSig, name string) -> i64 {
    if signature^.decl == nil { return -1 }
    params = signature^.decl^.params
    for index in range(0, len(params)) {
        if params[index].name == name { return index }
    }
    return -1
}

// Is `name` a module-level variable or constant of the program being checked?
fn is_module_level_variable(checker ^TypeChecker, name string) -> bool {
    return name != "" && scope.scope_lookup_local(checker^.global_scope, name) != nil
}

fn is_module_level_const(checker ^TypeChecker, name string) -> bool {
    symbol = scope.scope_lookup_local(checker^.global_scope, name)
    return name != "" && symbol != nil && !symbol^.mutable
}

// Where a store rooted at `root` lands: a parameter index, ESCAPE_GLOBAL, or
// ESCAPE_NONE (a local, an in-function concern the direct checks cover).
fn escape_destination_for_root(checker ^TypeChecker, signature ^FuncSig, root string, body ^ast.AstNode) -> i64 {
    if root == "" || signature^.decl == nil { return ESCAPE_NONE }
    index = parameter_index_of(signature, root)
    if index >= 0 && index < MAX_TRACKED_PARAMETERS { return index }
    if declared_in_subtree(body, root) { return ESCAPE_NONE }
    if is_module_level_variable(checker, root) { return ESCAPE_GLOBAL }
    return ESCAPE_NONE
}

fn record_parameter_escape(signature ^FuncSig, bits i64, destination i64, global_name string) {
    for index in range(0, len(signature^.param_types)) {
        if index >= MAX_TRACKED_PARAMETERS { break }
        if bits bit_and (1 bit_shift_left index) == 0 { continue }
        if signature^.parameter_escape_into[index] == ESCAPE_NONE || destination == ESCAPE_GLOBAL {
            signature^.parameter_escape_into[index] = destination
            if destination == ESCAPE_GLOBAL { signature^.parameter_escape_global_name[index] = global_name }
        }
        signature^.parameter_escape_via_function[index] = -1
    }
}

// record_parameter_escape() for an argument forwarded through an indirect call via the
// func-typed parameter `function_parameter`, at argument position `position`. The escape
// stays attributable to that one call only while nothing else has escaped the parameter.
fn record_parameter_escape_via_function(signature ^FuncSig, bits i64, function_parameter i64, position i64) {
    for index in range(0, len(signature^.param_types)) {
        if index >= MAX_TRACKED_PARAMETERS { break }
        if bits bit_and (1 bit_shift_left index) == 0 { continue }
        if signature^.parameter_escape_into[index] == ESCAPE_NONE {
            signature^.parameter_escape_into[index] = ESCAPE_GLOBAL
            signature^.parameter_escape_via_function[index] = function_parameter
            signature^.parameter_escape_via_position[index] = position
        } or signature^.parameter_escape_into[index] != ESCAPE_GLOBAL || signature^.parameter_escape_via_function[index] != function_parameter || signature^.parameter_escape_via_position[index] != position {
            signature^.parameter_escape_into[index] = ESCAPE_GLOBAL
            signature^.parameter_escape_via_function[index] = -1
        }
    }
}

// Bitmask of the parameters of `signature` whose address `node` may carry: the
// parameter named directly, addr()/raw() of a parameter's pointee, a field or
// element read through a parameter, a value buried in a literal, a local
// initialised from any of those, or a value forwarded through another call. A
// bare `p^` yields the pointee value, so it carries nothing.
fn return_expression_parameter_bits(checker ^TypeChecker, signature ^FuncSig, node ^ast.AstNode) -> i64 {
    if node == nil || signature^.decl == nil { return 0 }
    // A number, bool or char read through a pointer is a copy of the field
    if (node^.kind == ast.NodeKind.LABEL || node^.kind == ast.NodeKind.MEMBER_EXPR) && expression_is_plain_scalar(checker, signature, node) { return 0 }
    when node^.kind {
        is ast.NodeKind.LABEL {
            index = parameter_index_of(signature, node^.label^.value)
            if index >= 0 && index < MAX_TRACKED_PARAMETERS { return 1 bit_shift_left index }
            initializer = local_initializer(signature^.decl^.body, node^.label^.value)
            if initializer != nil && initializer != node { return return_expression_parameter_bits(checker, signature, initializer) }
            return 0
        }
        is ast.NodeKind.MEMBER_EXPR {
            mut operand ^ast.AstNode = node^.member^.object
            as_long_as operand != nil && operand^.kind == ast.NodeKind.POSTFIX_EXPR && operand^.postfix^.op == token.TokenKind.CARET { operand = operand^.postfix^.left }
            return return_expression_parameter_bits(checker, signature, operand)
        }
        is ast.NodeKind.INDEX_EXPR {
            mut left_operand ^ast.AstNode = node^.index_data^.left
            as_long_as left_operand != nil && left_operand^.kind == ast.NodeKind.POSTFIX_EXPR && left_operand^.postfix^.op == token.TokenKind.CARET { left_operand = left_operand^.postfix^.left }
            return return_expression_parameter_bits(checker, signature, left_operand)
        }
        is ast.NodeKind.POSTFIX_EXPR {
            if node^.postfix^.op == token.TokenKind.CARET { return 0 }
            return return_expression_parameter_bits(checker, signature, node^.postfix^.left)
        }
        is ast.NodeKind.STRUCT_VALUE {
            mut bits i64 = 0
            for_each field_value in node^.struct_value^.field_values { bits = bits bit_or return_expression_parameter_bits(checker, signature, field_value) }
            return bits
        }
        is ast.NodeKind.ARRAY_VALUE {
            mut bits i64 = 0
            for_each element in node^.array_value^.elements { bits = bits bit_or return_expression_parameter_bits(checker, signature, element) }
            return bits
        }
        is ast.NodeKind.MAP_VALUE {
            mut bits i64 = 0
            for_each key in node^.map_value^.keys { bits = bits bit_or return_expression_parameter_bits(checker, signature, key) }
            for_each element in node^.map_value^.values { bits = bits bit_or return_expression_parameter_bits(checker, signature, element) }
            return bits
        }
        is ast.NodeKind.CALL_EXPR {
            callee_node = node^.call^.function
            if callee_node != nil && callee_node^.kind == ast.NodeKind.LABEL && len(node^.call^.args) == 1 {
                callee_name = callee_node^.label^.value
                if callee_name == "addr" || callee_name == "raw" || callee_name == "copy" { return return_expression_parameter_bits(checker, signature, node^.call^.args[0]) }
            }
            if is_tagged_enum_variant_call(checker, node) {
                mut bits i64 = 0
                for_each argument in node^.call^.args { bits = bits bit_or return_expression_parameter_bits(checker, signature, argument) }
                return bits
            }
            callee = resolve_call_signature_in_body(checker, signature^.decl^.body, node)
            if callee == signature { return 0 }
            if callee == nil {
                // A stdlib call or builtin: carries its arguments' addresses when its
                // own result can hold a pointer
                if node^.resolved_type == "" { return 0 }
                result_type = checker_type_from_name(checker, node^.resolved_type)
                if result_type^.kind != types.TypeKind.POINTER && result_type^.kind != types.TypeKind.STRUCT && result_type^.kind != types.TypeKind.ARRAY && result_type^.kind != types.TypeKind.MAP { return 0 }
                mut bits i64 = 0
                for_each argument in node^.call^.args { bits = bits bit_or return_expression_parameter_bits(checker, signature, argument) }
                return bits
            }
            ensure_escape_summary(checker, callee)
            mut bits i64 = 0
            for index in range(0, len(callee^.param_types)) {
                if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
                if callee^.returns_parameter_address bit_and (1 bit_shift_left index) != 0 {
                    bits = bits bit_or return_expression_parameter_bits(checker, signature, node^.call^.args[index])
                }
            }
            return bits
        }
        default { return 0 }
    }
}

// The parameter bits of every `return` reachable in a statement subtree.
fn return_statement_parameter_bits(checker ^TypeChecker, signature ^FuncSig, node ^ast.AstNode) -> i64 {
    if node == nil { return 0 }
    mut bits i64 = 0
    #strict
    when node^.kind {
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values { bits = bits bit_or return_expression_parameter_bits(checker, signature, value) }
        }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts { bits = bits bit_or return_statement_parameter_bits(checker, signature, statement) }
        }
        is ast.NodeKind.IF_STMT {
            bits = return_statement_parameter_bits(checker, signature, node^.if_stmt^.consequence) bit_or return_statement_parameter_bits(checker, signature, node^.if_stmt^.alternative)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { bits = bits bit_or return_statement_parameter_bits(checker, signature, case_entry.body) }
            bits = bits bit_or return_statement_parameter_bits(checker, signature, node^.when_stmt^.default_body)
        }
        is ast.NodeKind.FOR_STMT { bits = return_statement_parameter_bits(checker, signature, node^.for_stmt^.body) }
        is ast.NodeKind.FOR_EACH_STMT { bits = return_statement_parameter_bits(checker, signature, node^.for_each_stmt^.body) }
        is ast.NodeKind.WHILE_STMT { bits = return_statement_parameter_bits(checker, signature, node^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { bits = return_statement_parameter_bits(checker, signature, node^.loop_stmt^.body) }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
        ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT, ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT,
        ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL,
        ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL,
        ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL, ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
    return bits
}

// Does a value `signature` returns point at a module-level constant: `addr(GLOBAL)`,
// a local initialised from one, or the result of a function that returns one.
fn return_expression_points_to_const(checker ^TypeChecker, signature ^FuncSig, body ^ast.AstNode, expression ^ast.AstNode) -> bool {
    if expression == nil { return false }
    if expression^.kind == ast.NodeKind.LABEL {
        initializer = local_initializer(body, expression^.label^.value)
        return initializer != nil && initializer != expression && return_expression_points_to_const(checker, signature, body, initializer)
    }
    if expression^.kind == ast.NodeKind.STRUCT_VALUE {
        for_each field_value in expression^.struct_value^.field_values {
            if return_expression_points_to_const(checker, signature, body, field_value) { return true }
        }
        return false
    }
    if expression^.kind == ast.NodeKind.ARRAY_VALUE {
        for_each element in expression^.array_value^.elements {
            if return_expression_points_to_const(checker, signature, body, element) { return true }
        }
        return false
    }
    if expression^.kind == ast.NodeKind.MAP_VALUE {
        for_each element in expression^.map_value^.values {
            if return_expression_points_to_const(checker, signature, body, element) { return true }
        }
        return false
    }
    if expression^.kind != ast.NodeKind.CALL_EXPR { return false }
    if is_tagged_enum_variant_call(checker, expression) {
        for_each argument in expression^.call^.args {
            if return_expression_points_to_const(checker, signature, body, argument) { return true }
        }
        return false
    }
    callee_node = expression^.call^.function
    if callee_node != nil && callee_node^.kind == ast.NodeKind.LABEL && len(expression^.call^.args) == 1 {
        if callee_node^.label^.value == "addr" {
            root = assignment_target_root_name(expression^.call^.args[0])
            if root == "" || declared_in_subtree(body, root) { return false }
            if parameter_index_of(signature, root) >= 0 { return false }
            return is_module_level_const(checker, root)
        }
        if callee_node^.label^.value == "copy" { return return_expression_points_to_const(checker, signature, body, expression^.call^.args[0]) }
    }
    callee = resolve_call_signature_in_body(checker, body, expression)
    if callee == nil || callee == signature { return false }
    ensure_escape_summary(checker, callee)
    return callee^.can_return_const_pointer
}

// --- Writes through a pointer parameter ---
//
// Which pointer parameters a function writes through, so a pointer to a
// const-declared variable is refused at a call whose callee would
// modify the value.

// Bit of the pointer parameter of `signature` that a write rooted at `root` lands
// in: `root` names the parameter itself, or a local declared as a plain copy of
// it. 0 for anything else, including a by-value parameter.
fn pointer_parameter_bit_for_root(signature ^FuncSig, body ^ast.AstNode, start_root string) -> i64 {
    mut root = start_root
    for _ in range(0, MAX_TRACKED_PARAMETERS) {
        if root == "" { return 0 }
        params = signature^.decl^.params
        for index in range(0, len(params)) {
            if index >= MAX_TRACKED_PARAMETERS { break }
            if params[index].name == root {
                if strings.starts_with(params[index].type_name, "^") { return 1 bit_shift_left index }
                return 0
            }
        }
        initializer = local_initializer(body, root)
        if initializer != nil && initializer^.kind == ast.NodeKind.CALL_EXPR && initializer^.call^.function != nil && initializer^.call^.function^.kind == ast.NodeKind.LABEL && initializer^.call^.function^.label^.value == "ref" && len(initializer^.call^.args) == 1 && initializer^.call^.args[0]^.kind != ast.NodeKind.LABEL {
            root = escape_root_name(initializer^.call^.args[0])
        } or initializer != nil && initializer^.kind == ast.NodeKind.LABEL {
            root = initializer^.label^.value
        } otherwise {
            root = ""
        }
    }
    return 0
}

// Bit of the pointer parameter that assigning to `target` writes through: a
// `p^`, `p^.f`, `p.f` or `p^[i]` target, never the bare `p = ...`.
fn write_target_parameter_bit(signature ^FuncSig, body ^ast.AstNode, target ^ast.AstNode) -> i64 {
    if target == nil || target^.kind == ast.NodeKind.LABEL { return 0 }
    return pointer_parameter_bit_for_root(signature, body, escape_root_name(target))
}

// Bit of the pointer parameter that a callee writing through the argument reaches:
// the parameter itself (`f(p)`), or the place `addr(p^.f)` takes the address of.
fn pointer_argument_parameter_bit(signature ^FuncSig, body ^ast.AstNode, argument ^ast.AstNode) -> i64 {
    if argument == nil { return 0 }
    if argument^.kind == ast.NodeKind.LABEL { return pointer_parameter_bit_for_root(signature, body, argument^.label^.value) }
    if argument^.kind == ast.NodeKind.CALL_EXPR && argument^.call^.function != nil && argument^.call^.function^.kind == ast.NodeKind.LABEL && argument^.call^.function^.label^.value == "addr" && len(argument^.call^.args) == 1 {
        return write_target_parameter_bit(signature, body, argument^.call^.args[0])
    }
    return 0
}

// Bit of the pointer parameter that instance dispatch `p.f()` (or `p^.f()`)
// writes through, for a call dispatch has not rewritten yet. The struct function
// must write through its receiver: a `^T` one that writes through it, or a `&` one.
fn dispatch_receiver_write_bit(checker ^TypeChecker, signature ^FuncSig, body ^ast.AstNode, call ^ast.AstNode) -> i64 {
    function_node = call^.call^.function
    if function_node == nil || function_node^.kind != ast.NodeKind.MEMBER_EXPR { return 0 }
    mut object ^ast.AstNode = function_node^.member^.object
    if object != nil && object^.kind == ast.NodeKind.POSTFIX_EXPR && object^.postfix^.op == token.TokenKind.CARET { object = object^.postfix^.left }
    if object == nil || object^.kind != ast.NodeKind.LABEL { return 0 }
    write_bit = pointer_parameter_bit_for_root(signature, body, object^.label^.value)
    if write_bit == 0 { return 0 }
    mut parameter_index i64 = 0
    for write_bit bit_and (1 bit_shift_left parameter_index) == 0 { parameter_index += 1 }
    if parameter_index >= len(signature^.param_types) { return 0 }
    parameter_type = signature^.param_types[parameter_index]
    if parameter_type^.kind != types.TypeKind.POINTER || parameter_type^.element_type == "" { return 0 }
    callee = find_func(checker, "${resolve_type_alias(checker, parameter_type^.element_type)}_${function_node^.member^.member}")
    if callee == nil || callee^.decl == nil || len(callee^.decl^.params) == 0 { return 0 }
    ensure_escape_summary(checker, callee)
    if callee^.writes_through_parameter bit_and 1 != 0 || callee^.decl^.params[0].is_mutable { return write_bit }
    return 0
}

// The stdlib writer a call names: its first parameter's name, and whether it
// mutates the container the first argument names rather than the pointer.
// "" when the call is not one.
fn pointer_writer_parameter(checker ^TypeChecker, call ^ast.AstNode) -> (string, string, bool) {
    function_node = call^.call^.function
    if function_node == nil || function_node^.kind != ast.NodeKind.MEMBER_EXPR || len(call^.call^.args) < 1 { return "", "", false }
    if function_node^.member^.object^.kind != ast.NodeKind.LABEL { return "", "", false }
    module_name = resolve_import_alias(checker, function_node^.member^.object^.label^.value)
    function_name = function_node^.member^.member
    if module_name == "atomic" {
        if function_name == "add" || function_name == "sub" || function_name == "exchange" || function_name == "and" || function_name == "or" || function_name == "xor" || function_name == "store" || function_name == "cas" { return module_name, "ptr", false }
    }
    if module_name == "mem" {
        if function_name == "zero" || function_name == "fill" { return module_name, "ptr", false }
        if function_name == "raw_copy" { return module_name, "dest", false }
    }
    if module_name == "arrays" {
        if function_name == "append" || function_name == "insert_at" || function_name == "remove" || function_name == "remove_at" || function_name == "remove_last" || function_name == "remove_first" || function_name == "prepend" || function_name == "fill" || function_name == "swap" || function_name == "sort_asc" || function_name == "sort_desc" || function_name == "sort_by" || function_name == "clear" { return module_name, "arr", true }
    }
    if module_name == "maps" {
        if function_name == "clear" || function_name == "remove_key" || function_name == "get_or_insert" || function_name == "get_and_remove" { return module_name, "m", true }
    }
    return "", "", false
}

// Scans a function body for places a parameter's address is stored into
// caller-visible memory: an assignment whose target roots at another parameter
// or a module-level variable, a stdlib container insert, or a call that itself
// escapes the argument.
fn escape_walk(checker ^TypeChecker, signature ^FuncSig, body ^ast.AstNode, node ^ast.AstNode) {
    if node == nil { return }
    #strict
    when node^.kind {
        is ast.NodeKind.ASSIGN_STMT {
            signature^.writes_through_parameter = signature^.writes_through_parameter bit_or write_target_parameter_bit(signature, body, node^.assign^.target)
            target_root = escape_root_name(node^.assign^.target)
            destination = escape_destination_for_root(checker, signature, target_root, body)
            if destination != ESCAPE_NONE {
                mut global_name string = ""
                if destination == ESCAPE_GLOBAL { global_name = target_root }
                record_parameter_escape(signature, return_expression_parameter_bits(checker, signature, node^.assign^.value), destination, global_name)
            }
            escape_walk(checker, signature, body, node^.assign^.value)
        }
        is ast.NodeKind.CALL_EXPR {
            value_index, container_index = container_sink_arguments(checker, node)
            if value_index >= 0 && len(node^.call^.args) > value_index && len(node^.call^.args) > container_index {
                container_root = escape_root_name(node^.call^.args[container_index])
                destination = escape_destination_for_root(checker, signature, container_root, body)
                if destination != ESCAPE_NONE {
                    mut global_name string = ""
                    if destination == ESCAPE_GLOBAL { global_name = container_root }
                    record_parameter_escape(signature, return_expression_parameter_bits(checker, signature, node^.call^.args[value_index]), destination, global_name)
                }
            }
            // A parameter's address reaching an extern.f() call right here in this body
            if node^.call^.function != nil && node^.call^.function^.kind == ast.NodeKind.MEMBER_EXPR && ast.ast_member_qualifier(node^.call^.function) == "extern" {
                for extern_index in range(0, len(node^.call^.args)) {
                    if extern_index >= MAX_TRACKED_PARAMETERS { break }
                    signature^.passes_parameter_to_extern = signature^.passes_parameter_to_extern bit_or return_expression_parameter_bits(checker, signature, node^.call^.args[extern_index])
                }
            }
            writer_module, _, writer_is_container = pointer_writer_parameter(checker, node)
            if writer_module != "" {
                if writer_is_container {
                    signature^.writes_through_parameter = signature^.writes_through_parameter bit_or pointer_parameter_bit_for_root(signature, body, escape_root_name(node^.call^.args[0]))
                } otherwise {
                    signature^.writes_through_parameter = signature^.writes_through_parameter bit_or pointer_argument_parameter_bit(signature, body, node^.call^.args[0])
                }
            }
            callee = resolve_call_signature_in_body(checker, body, node)
            if callee == nil {
                signature^.writes_through_parameter = signature^.writes_through_parameter bit_or dispatch_receiver_write_bit(checker, signature, body, node)
            }
            if callee != nil && callee != signature {
                ensure_escape_summary(checker, callee)
                for index in range(0, len(callee^.param_types)) {
                    if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
                    if callee^.writes_through_parameter bit_and (1 bit_shift_left index) != 0 {
                        signature^.writes_through_parameter = signature^.writes_through_parameter bit_or pointer_argument_parameter_bit(signature, body, node^.call^.args[index])
                    }
                    if callee^.decl != nil && index < len(callee^.decl^.params) && callee^.decl^.params[index].is_mutable {
                        signature^.writes_through_parameter = signature^.writes_through_parameter bit_or write_target_parameter_bit(signature, body, node^.call^.args[index])
                    }
                }
                for index in range(0, len(callee^.param_types)) {
                    if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
                    callee_destination = callee^.parameter_escape_into[index]
                    if callee_destination == ESCAPE_NONE { continue }
                    bits = return_expression_parameter_bits(checker, signature, node^.call^.args[index])
                    if bits == 0 { continue }
                    if callee_destination == ESCAPE_GLOBAL {
                        record_parameter_escape(signature, bits, ESCAPE_GLOBAL, callee^.parameter_escape_global_name[index])
                    } or callee_destination < len(node^.call^.args) {
                        destination_root = escape_root_name(node^.call^.args[callee_destination])
                        destination = escape_destination_for_root(checker, signature, destination_root, body)
                        if destination != ESCAPE_NONE {
                            mut global_name string = ""
                            if destination == ESCAPE_GLOBAL { global_name = destination_root }
                            record_parameter_escape(signature, bits, destination, global_name)
                        }
                    }
                }
            }
            if callee != nil && callee != signature {
                for index in range(0, len(callee^.param_types)) {
                    if index >= len(node^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
                    if callee^.passes_parameter_to_extern bit_and (1 bit_shift_left index) == 0 { continue }
                    signature^.passes_parameter_to_extern = signature^.passes_parameter_to_extern bit_or return_expression_parameter_bits(checker, signature, node^.call^.args[index])
                }
            }
            if callee == nil && call_target_is_opaque_function(signature, node) {
                // An indirect call may forward any pointer argument anywhere
                function_parameter = call_function_typed_parameter_index(signature, node)
                for index in range(0, len(node^.call^.args)) {
                    if index >= MAX_TRACKED_PARAMETERS { break }
                    signature^.writes_through_parameter = signature^.writes_through_parameter bit_or pointer_argument_parameter_bit(signature, body, node^.call^.args[index])
                    bits = return_expression_parameter_bits(checker, signature, node^.call^.args[index])
                    if function_parameter >= 0 {
                        record_parameter_escape_via_function(signature, bits, function_parameter, index)
                    } otherwise {
                        record_parameter_escape(signature, bits, ESCAPE_GLOBAL, "")
                    }
                }
            }
            for_each argument in node^.call^.args { escape_walk(checker, signature, body, argument) }
        }
        is ast.NodeKind.VAR_DECL { escape_walk(checker, signature, body, node^.var_decl^.value) }
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts { escape_walk(checker, signature, body, statement) }
        }
        is ast.NodeKind.IF_STMT {
            escape_walk(checker, signature, body, node^.if_stmt^.consequence)
            escape_walk(checker, signature, body, node^.if_stmt^.alternative)
        }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { escape_walk(checker, signature, body, case_entry.body) }
            escape_walk(checker, signature, body, node^.when_stmt^.default_body)
        }
        is ast.NodeKind.FOR_STMT { escape_walk(checker, signature, body, node^.for_stmt^.body) }
        is ast.NodeKind.FOR_EACH_STMT { escape_walk(checker, signature, body, node^.for_each_stmt^.body) }
        is ast.NodeKind.WHILE_STMT { escape_walk(checker, signature, body, node^.while_stmt^.body) }
        is ast.NodeKind.LOOP_STMT { escape_walk(checker, signature, body, node^.loop_stmt^.body) }
        is ast.NodeKind.EXPR_STMT { escape_walk(checker, signature, body, node^.expr_stmt^.expr) }
        is ast.NodeKind.POSTFIX_EXPR {
            if node^.postfix^.op == token.TokenKind.INCREMENT || node^.postfix^.op == token.TokenKind.DECREMENT {
                signature^.writes_through_parameter = signature^.writes_through_parameter bit_or write_target_parameter_bit(signature, body, node^.postfix^.left)
            }
        }
        is ast.NodeKind.ENSURE_STMT { escape_walk(checker, signature, body, node^.ensure_stmt^.expr) }
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values {
                if return_expression_points_to_const(checker, signature, body, value) { signature^.can_return_const_pointer = true }
                escape_walk(checker, signature, body, value)
            }
        }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.INDEX_EXPR, ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR,
        ast.NodeKind.CAST_EXPR, ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM,
        ast.NodeKind.WHEN_PATTERN, ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT,
        ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT,
        ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

// Lazily computes and memoises `signature`'s escape summary. A function caught
// mid-computation (recursion) keeps the partial summary it has: conservative,
// never a false positive.
fn ensure_escape_summary(checker ^TypeChecker, signature ^FuncSig) {
    if signature == nil || signature^.escape_state != ANALYSIS_NOT_STARTED { return }
    signature^.escape_state = ANALYSIS_IN_PROGRESS
    signature^.returns_parameter_address = 0
    signature^.can_return_const_pointer = false
    signature^.passes_parameter_to_extern = 0
    signature^.writes_through_parameter = 0
    for _ in range(0, len(signature^.param_types)) {
        arrays.append(signature^.parameter_escape_into, ESCAPE_NONE)
        arrays.append(signature^.parameter_escape_global_name, "")
        arrays.append(signature^.parameter_escape_via_function, -1)
        arrays.append(signature^.parameter_escape_via_position, 0)
    }
    if signature^.decl != nil && signature^.decl^.body != nil && len(signature^.decl^.params) <= MAX_TRACKED_PARAMETERS {
        body = signature^.decl^.body
        // The result matters only when it can carry a pointer: a pointer, or an
        // aggregate that may hold one. An unknown slot of a generic function counts
        // too, since call sites bind it to such types.
        mut is_escapable_return bool = false
        for index in range(0, len(signature^.return_types)) {
            return_type = signature^.return_types[index]
            if return_type^.kind == types.TypeKind.POINTER || return_type^.kind == types.TypeKind.STRUCT || return_type^.kind == types.TypeKind.ARRAY || return_type^.kind == types.TypeKind.MAP || return_type^.kind == types.TypeKind.ENUM {
                is_escapable_return = true
            } or index < len(signature^.decl^.return_types) && signature^.is_generic && return_type^.kind == types.TypeKind.UNKNOWN {
                is_escapable_return = true
            }
        }
        if is_escapable_return { signature^.returns_parameter_address = return_statement_parameter_bits(checker, signature, body) }
        escape_walk(checker, signature, body, body)
    }
    signature^.escape_state = ANALYSIS_DONE
}

// The origin a call result forwards from the arguments the callee's summary says
// its result may carry.
fn call_result_origin(checker ^TypeChecker, call ^ast.AstNode) -> (i64, string) {
    signature = resolve_call_signature(checker, call)
    if signature == nil { return 0, "" }
    ensure_escape_summary(checker, signature)
    if signature^.returns_parameter_address == 0 { return 0, "" }
    mut best i64 = 0
    mut best_name string = ""
    for index in range(0, len(signature^.param_types)) {
        if index >= len(call^.call^.args) || index >= MAX_TRACKED_PARAMETERS { break }
        if signature^.returns_parameter_address bit_and (1 bit_shift_left index) == 0 { continue }
        origin_depth, name = pointer_origin_of(checker, call^.call^.args[index])
        if origin_depth > best {
            best = origin_depth
            best_name = name
        }
    }
    return best, best_name
}

// --- Const-sourced pointers ---
//
// A pointer to a const-declared variable is read-only: writing through it is
// an error. Symbol.const_source marks a variable that holds such a pointer, or an
// aggregate that holds one in a field or element. One flag covers the whole
// variable.

fn const_walk_expression_type(checker ^TypeChecker, expression ^ast.AstNode) -> ^types.GrayType {
    if expression^.kind == ast.NodeKind.LABEL {
        symbol = scope.scope_lookup(checker^.current_scope, expression^.label^.value)
        if symbol != nil { return symbol^.sym_type }
    }
    return resolve_quietly(checker, expression)
}

// `^^T`: a pointer to a pointer.
fn is_pointer_to_pointer(pointer_type ^types.GrayType) -> bool {
    return pointer_type != nil && pointer_type^.kind == types.TypeKind.POINTER && strings.starts_with(pointer_type^.element_type, "^")
}

// The pointer expression a write through `place` dereferences, when it points at
// a const-declared variable (`p^`, `p^.f`, `p.f`, `h.p^.f`), else nil.
fn place_derefs_const_pointer(checker ^TypeChecker, place ^ast.AstNode) -> ^ast.AstNode {
    mut current ^ast.AstNode = place
    as_long_as current != nil {
        mut inner ^ast.AstNode = nil
        mut is_deref bool = false
        if current^.kind == ast.NodeKind.POSTFIX_EXPR {
            if current^.postfix^.op != token.TokenKind.CARET { return nil }
            inner = current^.postfix^.left
            is_deref = true
        } or current^.kind == ast.NodeKind.MEMBER_EXPR {
            inner = current^.member^.object
            if inner != nil { is_deref = const_walk_expression_type(checker, inner)^.kind == types.TypeKind.POINTER }
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            inner = current^.index_data^.left
        } otherwise {
            return nil
        }
        if inner == nil { return nil }
        if is_deref && !is_pointer_to_pointer(const_walk_expression_type(checker, inner)) && expression_points_to_const(checker, inner) { return inner }
        current = inner
    }
    return nil
}

// Is the address of `target` a pointer to a const-declared variable.
fn address_of_place_points_to_const(checker ^TypeChecker, target ^ast.AstNode) -> bool {
    root = assignment_target_root_name(target)
    mut root_symbol ^scope.Symbol = nil
    if root != "" { root_symbol = scope.scope_lookup(checker^.current_scope, root) }
    // A pointer root auto-derefs, so its own constness says nothing about the pointee
    if root_symbol != nil && !root_symbol^.mutable && root_symbol^.sym_type^.kind != types.TypeKind.POINTER { return true }
    // The address of a variable that holds a pointer to a const is a pointer to a pointer at it
    if target^.kind == ast.NodeKind.LABEL && root_symbol != nil && root_symbol^.const_source && root_symbol^.sym_type^.kind == types.TypeKind.POINTER { return true }
    return place_derefs_const_pointer(checker, target) != nil
}

fn expression_points_to_const(checker ^TypeChecker, expression ^ast.AstNode) -> bool {
    if expression == nil { return false }
    when expression^.kind {
        is ast.NodeKind.LABEL {
            symbol = scope.scope_lookup(checker^.current_scope, expression^.label^.value)
            return symbol != nil && symbol^.const_source
        }
        is ast.NodeKind.MEMBER_EXPR, ast.NodeKind.INDEX_EXPR {
            // A field or element of a marked aggregate is marked; one read out of
            // memory behind a pointer is a different pointer
            mut inner ^ast.AstNode = nil
            if expression^.kind == ast.NodeKind.INDEX_EXPR {
                inner = expression^.index_data^.left
            } otherwise {
                inner = expression^.member^.object
            }
            if inner == nil { return false }
            inner_type = const_walk_expression_type(checker, inner)
            // A destructuring temp is typed as its first slot, but its .vN fields are the return values
            mut is_tuple_temporary bool = false
            if inner^.kind == ast.NodeKind.LABEL {
                inner_symbol = scope.scope_lookup(checker^.current_scope, inner^.label^.value)
                is_tuple_temporary = inner_symbol != nil && len(inner_symbol^.ret_types) > 0
            }
            if inner_type^.kind == types.TypeKind.POINTER && !is_tuple_temporary { return false }
            return expression_points_to_const(checker, inner)
        }
        is ast.NodeKind.POSTFIX_EXPR {
            // `pp^` reads the pointer a `^^T` points at
            if expression^.postfix^.op != token.TokenKind.CARET { return false }
            inner = expression^.postfix^.left
            return is_pointer_to_pointer(const_walk_expression_type(checker, inner)) && expression_points_to_const(checker, inner)
        }
        is ast.NodeKind.STRUCT_VALUE {
            for_each field_value in expression^.struct_value^.field_values {
                if expression_points_to_const(checker, field_value) { return true }
            }
            return false
        }
        is ast.NodeKind.ARRAY_VALUE {
            for_each element in expression^.array_value^.elements {
                if expression_points_to_const(checker, element) { return true }
            }
            return false
        }
        is ast.NodeKind.MAP_VALUE {
            for_each element in expression^.map_value^.values {
                if expression_points_to_const(checker, element) { return true }
            }
            return false
        }
        is ast.NodeKind.CALL_EXPR {
            callee = expression^.call^.function
            if callee != nil && callee^.kind == ast.NodeKind.LABEL && len(expression^.call^.args) == 1 {
                if callee^.label^.value == "addr" {
                    return address_of_place_points_to_const(checker, expression^.call^.args[0])
                }
                if callee^.label^.value == "copy" { return expression_points_to_const(checker, expression^.call^.args[0]) }
            }
            signature = resolve_call_signature(checker, expression)
            if signature == nil {
                // A stdlib call, a builtin or a tagged-enum variant has no signature to
                // summarise: assume a pointer-carrying result was read out of its arguments
                return_type = resolve_quietly(checker, expression)
                if !is_tagged_enum_variant_call(checker, expression) && return_type^.kind != types.TypeKind.POINTER && return_type^.kind != types.TypeKind.STRUCT && return_type^.kind != types.TypeKind.ARRAY && return_type^.kind != types.TypeKind.MAP { return false }
                for_each argument in expression^.call^.args {
                    if expression_points_to_const(checker, argument) { return true }
                }
                return false
            }
            ensure_escape_summary(checker, signature)
            if signature^.can_return_const_pointer { return true }
            for index in range(0, len(expression^.call^.args)) {
                if index >= MAX_TRACKED_PARAMETERS { break }
                if signature^.returns_parameter_address bit_and (1 bit_shift_left index) != 0 && expression_points_to_const(checker, expression^.call^.args[index]) { return true }
            }
            return false
        }
        default { return false }
    }
}

// `destination` now holds a pointer to a const-declared variable, if `value` does.
fn propagate_const_source(checker ^TypeChecker, destination ^scope.Symbol, value ^ast.AstNode) {
    if destination == nil || destination^.const_source || destination^.sym_type == nil { return }
    kind = destination^.sym_type^.kind
    // A destructuring temp holds several return values and has no type of its own
    if kind != types.TypeKind.POINTER && kind != types.TypeKind.STRUCT && kind != types.TypeKind.ARRAY && kind != types.TypeKind.MAP && kind != types.TypeKind.ENUM && len(destination^.ret_types) == 0 { return }
    if expression_points_to_const(checker, value) { destination^.const_source = true }
}

// A write to `place` that goes through a pointer to a const-declared variable.
#[discard]
fn report_write_through_const_pointer(checker ^TypeChecker, report_node ^ast.AstNode, place ^ast.AstNode) -> bool {
    pointer_expression = place_derefs_const_pointer(checker, place)
    if pointer_expression == nil { return false }
    if pointer_expression^.kind == ast.NodeKind.LABEL {
        add_diagnostic(checker, "E3122", error_registry.registry_message_formatted("E3122", {pointer_expression^.label^.value}), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
    } otherwise {
        add_diagnostic(checker, "E3192", error_registry.registry_message("E3192"), report_node^.tok.file, report_node^.tok.line, report_node^.tok.col)
    }
    return true
}

// --- Pointer lifetime origins (the escape checker) ---
//
// A pointer taken with addr()/raw()/ref() remembers the scope depth of the
// variable it points at. Storing it where it outlives that variable (returning
// it, assigning it to an outer variable or to caller memory) dangles once the
// scope exits.

// The same root, seeing through pointer dereferences.
fn escape_root_name(expression ^ast.AstNode) -> string {
    mut current ^ast.AstNode = expression
    as_long_as current != nil {
        if current^.kind == ast.NodeKind.LABEL { return current^.label^.value }
        if current^.kind == ast.NodeKind.MEMBER_EXPR {
            current = current^.member^.object
        } or current^.kind == ast.NodeKind.INDEX_EXPR {
            current = current^.index_data^.left
        } or current^.kind == ast.NodeKind.POSTFIX_EXPR && current^.postfix^.op == token.TokenKind.CARET {
            current = current^.postfix^.left
        } otherwise {
            return ""
        }
    }
    return ""
}

// Depth of the scope declaring `name`, biased by +1; 0 when it is not found.
fn symbol_scope_depth(checker ^TypeChecker, name string) -> i64 {
    mut current ^scope.Scope = checker^.current_scope
    as_long_as current != nil {
        if scope.scope_lookup_local(current, name) != nil { return current^.depth + 1 }
        current = current^.parent
    }
    return 0
}

// The type of `node` without reporting anything: the pointer checker asks for
// types of expressions that are also checked on their own.
#[discard]
fn resolve_quietly(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    saved_count i64 = len(checker^.diagnostics)
    result = resolve_expression(checker, node)
    mut kept [Diagnostic] = {}
    for index in range(0, saved_count) { arrays.append(kept, checker^.diagnostics[index]) }
    checker^.diagnostics = kept
    return result
}

// True when `call` builds a tagged-enum variant (`Enum.Variant(..)` or `.Variant(..)`).
fn is_tagged_enum_variant_call(checker ^TypeChecker, node ^ast.AstNode) -> bool {
    if node == nil || node^.kind != ast.NodeKind.CALL_EXPR { return false }
    callee = node^.call^.function
    if callee == nil { return false }
    if callee^.kind == ast.NodeKind.IMPLICIT_ENUM { return true }
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        qualifier = callee^.member^.object^.label^.value
        return scope.scope_lookup(checker^.current_scope, qualifier) == nil && is_enum_name(checker, resolve_type_alias(checker, qualifier))
    }
    return false
}

// The user function `call` targets, or nil for a stdlib call or a builtin.
fn resolve_call_signature(checker ^TypeChecker, call ^ast.AstNode) -> ^FuncSig {
    if call == nil || call^.kind != ast.NodeKind.CALL_EXPR { return nil }
    callee = call^.call^.function
    if callee == nil { return nil }
    if callee^.kind == ast.NodeKind.LABEL {
        direct = find_func(checker, callee^.label^.value)
        if direct != nil { return direct }
        symbol = scope.scope_lookup(checker^.current_scope, callee^.label^.value)
        if symbol != nil && symbol^.func_ref_name != "" { return find_func(checker, symbol^.func_ref_name) }
    }
    // A struct function after instance dispatch: Type.func(instance, ...)
    if callee^.kind == ast.NodeKind.MEMBER_EXPR && callee^.member^.object^.kind == ast.NodeKind.LABEL {
        owner_name = callee^.member^.object^.label^.value
        if scope.scope_lookup(checker^.current_scope, owner_name) == nil && is_struct_name(checker, owner_name) {
            return find_func(checker, "${owner_name}_${callee^.member^.member}")
        }
    }
    return nil
}

// Deepest origin among a stdlib call's arguments, when its result can carry a
// pointer (a pointer, struct, array or map).
fn stdlib_call_argument_origin(checker ^TypeChecker, call ^ast.AstNode) -> (i64, string) {
    return_type = resolve_quietly(checker, call)
    if return_type^.kind != types.TypeKind.POINTER && return_type^.kind != types.TypeKind.STRUCT && return_type^.kind != types.TypeKind.ARRAY && return_type^.kind != types.TypeKind.MAP {
        return 0, ""
    }
    mut best i64 = 0
    mut best_name string = ""
    for_each argument in call^.call^.args {
        depth, name = expression_origin(checker, argument)
        if depth > best {
            best = depth
            best_name = name
        }
    }
    return best, best_name
}

// The origin of a pointer value: the direct addr()/raw()/ref() form, a pointer
// variable that carries one, an element read out of a container holding one, or
// a call result forwarding one.
fn pointer_origin_of(checker ^TypeChecker, value ^ast.AstNode) -> (i64, string) {
    if value == nil { return 0, "" }
    if value^.kind == ast.NodeKind.CALL_EXPR && value^.call^.function^.kind == ast.NodeKind.LABEL && len(value^.call^.args) == 1 {
        callee_name = value^.call^.function^.label^.value
        if callee_name == "addr" || callee_name == "raw" || callee_name == "ref" {
            root = assignment_target_root_name(value^.call^.args[0])
            if root == "" { return 0, "" }
            depth = symbol_scope_depth(checker, root)
            if depth > 0 { return depth, root }
            return 0, ""
        }
    }
    if value^.kind == ast.NodeKind.LABEL {
        source = scope.scope_lookup(checker^.current_scope, value^.label^.value)
        if source != nil && source^.origin_depth != 0 { return source^.origin_depth, source^.origin_name }
        if source != nil && source^.field_origin_depth != 0 { return source^.field_origin_depth, source^.field_origin_name }
    }
    if value^.kind == ast.NodeKind.INDEX_EXPR || value^.kind == ast.NodeKind.MEMBER_EXPR {
        root = assignment_target_root_name(value)
        if root != "" {
            symbol = scope.scope_lookup(checker^.current_scope, root)
            if symbol != nil && symbol^.field_origin_depth != 0 {
                if resolve_quietly(checker, value)^.kind == types.TypeKind.POINTER {
                    return symbol^.field_origin_depth, symbol^.field_origin_name
                }
            }
        }
    }
    if value^.kind == ast.NodeKind.CALL_EXPR {
        root_depth, root_name = call_result_origin(checker, value)
        // 0 both when a resolved function's summary says nothing escapes and when
        // there is no signature at all; only the latter falls back to the arguments
        if root_depth == 0 && resolve_call_signature(checker, value) == nil {
            stdlib_depth, stdlib_name = stdlib_call_argument_origin(checker, value)
            return stdlib_depth, stdlib_name
        }
        return root_depth, root_name
    }
    return 0, ""
}

// The deepest pointer origin buried in a struct, array or map literal, or in
// the payload of a tagged-enum variant, or a call result carrying one.
fn container_literal_origin(checker ^TypeChecker, node ^ast.AstNode) -> (i64, string) {
    if node == nil { return 0, "" }
    mut best i64 = 0
    mut best_name string = ""
    mut parts [^ast.AstNode] = {}
    when node^.kind {
        is ast.NodeKind.STRUCT_VALUE { parts = node^.struct_value^.field_values }
        is ast.NodeKind.ARRAY_VALUE { parts = node^.array_value^.elements }
        is ast.NodeKind.MAP_VALUE {
            for_each key in node^.map_value^.keys { arrays.append(parts, key) }
            for_each element in node^.map_value^.values { arrays.append(parts, element) }
        }
        is ast.NodeKind.CALL_EXPR {
            if is_tagged_enum_variant_call(checker, node) {
                parts = node^.call^.args
            } otherwise {
                call_depth, call_name = call_result_origin(checker, node)
                if call_depth == 0 && resolve_call_signature(checker, node) == nil {
                    stdlib_depth, stdlib_name = stdlib_call_argument_origin(checker, node)
                    return stdlib_depth, stdlib_name
                }
                return call_depth, call_name
            }
        }
        default { return 0, "" }
    }
    for_each part in parts {
        depth, name = expression_origin(checker, part)
        if depth > best {
            best = depth
            best_name = name
        }
    }
    return best, best_name
}

// The deepest lifetime origin an expression carries: a tracked pointer, or an
// address buried in a literal.
fn expression_origin(checker ^TypeChecker, value ^ast.AstNode) -> (i64, string) {
    direct_depth, direct_name = pointer_origin_of(checker, value)
    literal_depth, literal_name = container_literal_origin(checker, value)
    if literal_depth > direct_depth { return literal_depth, literal_name }
    if direct_depth != 0 { return direct_depth, direct_name }
    return 0, ""
}

// Records on a freshly bound variable the origin its initializer carries.
fn record_symbol_origin(checker ^TypeChecker, symbol ^scope.Symbol, initializer ^ast.AstNode) {
    if symbol == nil { return }
    origin_depth, origin_name = pointer_origin_of(checker, initializer)
    symbol^.origin_depth = origin_depth
    symbol^.origin_name = origin_name
    field_depth, field_name = container_literal_origin(checker, initializer)
    symbol^.field_origin_depth = field_depth
    symbol^.field_origin_name = field_name
}

// True when an assignment target writes into memory the caller owns, reached
// through a parameter: a mutable-reference parameter, or a write through a
// pointer parameter.
fn assign_target_outlives_locals(checker ^TypeChecker, target ^ast.AstNode) -> bool {
    function_node = checker^.current_function
    if function_node == nil || function_node^.kind != ast.NodeKind.FUNC_DECL || target == nil { return false }
    mut base ^ast.AstNode = target
    mut through_deref bool = false
    as_long_as base != nil {
        if base^.kind == ast.NodeKind.MEMBER_EXPR {
            // `.` on a pointer reads through it exactly as `^.` does
            if resolve_quietly(checker, base^.member^.object)^.kind == types.TypeKind.POINTER { through_deref = true }
            base = base^.member^.object
        } or base^.kind == ast.NodeKind.INDEX_EXPR {
            base = base^.index_data^.left
        } or base^.kind == ast.NodeKind.POSTFIX_EXPR && base^.postfix^.op == token.TokenKind.CARET {
            through_deref = true
            base = base^.postfix^.left
        } otherwise {
            break
        }
    }
    if base == nil || base^.kind != ast.NodeKind.LABEL { return false }
    root = base^.label^.value
    for_each parameter in function_node^.func_decl^.params {
        if parameter.name != root { continue }
        if parameter.is_mutable { return true }
        if through_deref { return checker_type_from_name(checker, parameter.type_name)^.kind == types.TypeKind.POINTER }
        return false
    }
    return false
}

// Assignment: implicit declaration (`x = expr` for an unknown `x`), const-target writes, string
// element writes, array element mismatches and plain target/value mismatches.
fn check_assign_statement(checker ^TypeChecker, node ^ast.AstNode) {
    ad = node^.assign
    reject_multi_return_in_single_position(checker, ad^.value)
    target = ad^.target

    // Implicit declaration: `x = expr` where `x` is not in scope
    if target^.kind == ast.NodeKind.LABEL && ad^.op == token.TokenKind.ASSIGN && target^.label^.value != "_" {
        name = target^.label^.value
        if scope.scope_lookup(checker^.current_scope, name) == nil && !strings.starts_with(name, "_") && reserved.is_reserved_type_name(name) {
            add_diagnostic(checker, "E2038", error_registry.registry_message_formatted("E2038", {name, "a variable"}), node^.tok.file, node^.tok.line, node^.tok.col)
            return
        }
        if scope.scope_lookup(checker^.current_scope, name) == nil && !reserved.is_reserved_builtin_func_name(name) && !is_struct_name(checker, name) && !is_enum_name(checker, name) && find_func(checker, name) == nil {
            allow_range_use(checker, ad^.value)
            value_type = resolve_expression(checker, ad^.value)
            if value_type^.kind == types.TypeKind.VOID {
                add_diagnostic(checker, "E3187", error_registry.registry_message_formatted("E3187", {"the value of a variable"}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            scope.scope_define(checker^.current_scope, name, value_type, true)
            symbol = scope.scope_lookup_local(checker^.current_scope, name)
            symbol^.def_line = node^.tok.line
            symbol^.def_column = node^.tok.col
            record_symbol_origin(checker, symbol, ad^.value)
            ad^.is_decl = true
            return
        }
    }

    if ad^.op == token.TokenKind.ASSIGN { allow_range_use(checker, target) }
    target_type = resolve_expression(checker, target)
    allow_range_use(checker, ad^.value)
    // The value is stored into the target, so it is checked as the target's
    // type, for a compound assignment `x operator= v` too.
    assigned_value_type = check_expression_as(checker, ad^.value, target_type)
    reject_non_json_parse_target(checker, node, ad^.value, target_type)
    assign_operator = ad^.op

    // Compound assignment type validation: x operator= y is valid when x operator y would
    // be. Mirrors the checks in resolve_infix_expr for the binary operator.
    if assign_operator == token.TokenKind.PLUS_ASSIGN || assign_operator == token.TokenKind.MINUS_ASSIGN || assign_operator == token.TokenKind.ASTERISK_ASSIGN || assign_operator == token.TokenKind.SLASH_ASSIGN || assign_operator == token.TokenKind.PERCENT_ASSIGN {
        // Pointer arithmetic
        if target_type^.kind == types.TypeKind.POINTER {
            add_diagnostic(checker, "E3078", error_registry.registry_message("E3078"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if target_type^.kind != types.TypeKind.UNKNOWN && assigned_value_type^.kind != types.TypeKind.UNKNOWN {
            // Bool in arithmetic
            if target_type^.kind == types.TypeKind.BOOL || assigned_value_type^.kind == types.TypeKind.BOOL {
                add_diagnostic(checker, "E3002", error_registry.registry_message_formatted("E3002", {operator_display_name(assign_operator), shown_type(checker, target_type), shown_type(checker, assigned_value_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            // Appending a non-string to a string. Only a string target makes
            // '+=' a concatenation.
            if target_type^.kind == types.TypeKind.STRING && assigned_value_type^.kind != types.TypeKind.STRING && assign_operator == token.TokenKind.PLUS_ASSIGN {
                add_diagnostic(checker, "E3048", error_registry.registry_message_formatted("E3048", {shown_type(checker, target_type), shown_type(checker, assigned_value_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            // String in non-plus arithmetic
            if (target_type^.kind == types.TypeKind.STRING || assigned_value_type^.kind == types.TypeKind.STRING) && assign_operator != token.TokenKind.PLUS_ASSIGN {
                add_diagnostic(checker, "E3180", error_registry.registry_message_formatted("E3180", {operator_display_name(assign_operator)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            // Modulo on a floating-point value
            if assign_operator == token.TokenKind.PERCENT_ASSIGN && (target_type^.kind == types.TypeKind.FLOAT || assigned_value_type^.kind == types.TypeKind.FLOAT) {
                add_diagnostic(checker, "E3181", error_registry.registry_message("E3181"), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            // Arithmetic on map, array, or struct
            target_is_aggregate = target_type^.kind == types.TypeKind.MAP || target_type^.kind == types.TypeKind.ARRAY || target_type^.kind == types.TypeKind.STRUCT
            value_is_aggregate = assigned_value_type^.kind == types.TypeKind.MAP || assigned_value_type^.kind == types.TypeKind.ARRAY || assigned_value_type^.kind == types.TypeKind.STRUCT
            if target_is_aggregate || value_is_aggregate {
                mut bad_type = assigned_value_type
                if target_is_aggregate { bad_type = target_type }
                add_diagnostic(checker, "E3093", error_registry.registry_message_formatted("E3093", {operator_display_name(assign_operator), shown_type(checker, bad_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }

    // A module constant or variable cannot be reassigned from outside its module
    mut was_module_write_reported = false
    if target^.kind == ast.NodeKind.LABEL && target^.label^.qualifier != "" {
        module_symbol = qualified_module_symbol(checker, target)
        if module_symbol != nil {
            mut module_member_kind = "constant"
            if module_symbol^.mutable { module_member_kind = "variable" }
            add_diagnostic(checker, "E6008", error_registry.registry_message_formatted("E6008", {target^.label^.qualifier, target^.label^.qualified_member, module_member_kind}), node^.tok.file, node^.tok.line, node^.tok.col)
            was_module_write_reported = true
        }
    } or target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind == ast.NodeKind.LABEL && scope.scope_lookup(checker^.current_scope, target^.member^.object^.label^.value) == nil && is_stdlib_module_reference(checker, target^.member^.object^.label^.value) {
        add_diagnostic(checker, "E6008", error_registry.registry_message_formatted("E6008", {target^.member^.object^.label^.value, target^.member^.member, "constant"}), node^.tok.file, node^.tok.line, node^.tok.col)
        was_module_write_reported = true
    }
    if !was_module_write_reported { report_write_to_module_variable(checker, node, target) }

    // Only a variable, field, element or dereference can be assigned to; a
    // call result or literal has no storage of its own
    is_assignable_kind = target^.kind == ast.NodeKind.LABEL || target^.kind == ast.NodeKind.MEMBER_EXPR || target^.kind == ast.NodeKind.INDEX_EXPR || target^.kind == ast.NodeKind.PREFIX_EXPR || target^.kind == ast.NodeKind.POSTFIX_EXPR
    if !is_assignable_kind || chain_rooted_at_temporary(target) {
        add_diagnostic(checker, "E5025", error_registry.registry_message("E5025"), node^.tok.file, node^.tok.line, node^.tok.col)
    }

    // Writing to a constant, directly or through a field or index.
    // A field write through a pointer auto-dereferences, so the pointer
    // itself is not modified.
    // The chain stops at a dereference: the memory behind a pointer is not the constant
    const_root_name = assignment_target_root_name(target)
    if const_root_name != "" {
        symbol = scope.scope_lookup(checker^.current_scope, const_root_name)
        if symbol != nil && symbol_is_const_write_target(symbol) {
            message = error_registry.registry_message_formatted("E3005", {assignment_target_root_display(target)})
            add_diagnostic(checker, "E3005", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }

    // A write through a pointer whose pointee is a const-declared variable
    report_write_through_const_pointer(checker, node, target)
    // A variable that now holds a pointer to a const-declared variable, in itself, a
    // field or an element, is marked so writes through it are caught
    const_root = assignment_target_root_name(target)
    if const_root != "" && ad^.value != nil { propagate_const_source(checker, scope.scope_lookup(checker^.current_scope, const_root), ad^.value) }

    if target^.kind == ast.NodeKind.INDEX_EXPR {
        indexed_type = resolve_expression(checker, target^.index_data^.left)
        // Strings are not element-assignable
        if indexed_type^.kind == types.TypeKind.STRING {
            add_diagnostic(checker, "E3004", "strings are not element-assignable; individual string characters cannot be modified by index", node^.tok.file, node^.tok.line, node^.tok.col)
        }
        // Array element type mismatch
        if indexed_type^.kind == types.TypeKind.ARRAY && indexed_type^.element_type != "" {
            element_type = checker_type_from_name(checker, indexed_type^.element_type)
            value_type = resolve_expression(checker, ad^.value)
            enum_elements = value_type^.kind == types.TypeKind.ENUM && element_type^.kind == types.TypeKind.STRUCT && is_enum_name(checker, indexed_type^.element_type)
            if value_type^.kind != types.TypeKind.UNKNOWN && element_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, element_type, value_type) && !enum_elements {
                add_diagnostic(checker, "E3094", error_registry.registry_message_formatted("E3094", {shown_type(checker, value_type), shown_type(checker, indexed_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }

    // A fixed-size array field reassigned with too many elements. The struct-literal
    // check never sees a plain assignment statement, so this is a second call site.
    if target^.kind == ast.NodeKind.MEMBER_EXPR && ad^.value != nil && !(target^.member^.object^.kind == ast.NodeKind.LABEL && scope.scope_lookup(checker^.current_scope, target^.member^.object^.label^.value) == nil && is_imported_module_name(checker, target^.member^.object^.label^.value)) {
        field_object_type = resolve_expression(checker, target^.member^.object)
        mut field_struct_name = ""
        if field_object_type^.kind == types.TypeKind.STRUCT { field_struct_name = field_object_type^.name }
        if field_object_type^.kind == types.TypeKind.POINTER { field_struct_name = field_object_type^.element_type }
        field_info = find_struct(checker, field_struct_name)
        if field_info != nil {
            for field_index in range(0, len(field_info^.field_names)) {
                if field_info^.field_names[field_index] == target^.member^.member && field_index < len(field_info^.field_spellings) {
                    check_fixed_array_slot_size(checker, field_info^.field_spellings[field_index], "field '${target^.member^.member}'", ad^.value)
                    break
                }
            }
        }
    }

    // Reject an integer assigned to an enum variable
    if target^.kind == ast.NodeKind.LABEL && target_type^.kind == types.TypeKind.ENUM && is_int_kind(assigned_value_type^.kind) {
        add_diagnostic(checker, "E3118", error_registry.registry_message_formatted("E3118", {shown_type(checker, assigned_value_type), shown_type(checker, target_type), shown_type(checker, target_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    // A direct variable whose value does not fit it
    if target^.kind == ast.NodeKind.LABEL {
        target_symbol = scope.scope_lookup(checker^.current_scope, target^.label^.value)
        if target_symbol != nil && target_symbol^.sym_type^.kind != types.TypeKind.UNKNOWN && assigned_value_type^.kind != types.TypeKind.UNKNOWN && target_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, target_type, assigned_value_type) && !(target_type^.kind == types.TypeKind.ENUM && is_int_kind(assigned_value_type^.kind)) && !(target_type^.kind == types.TypeKind.POINTER && is_ref_variable(checker, ad^.value)) && !(assigned_value_type^.kind == types.TypeKind.NIL_TYPE && (target_type^.kind == types.TypeKind.POINTER || target_type^.kind == types.TypeKind.ERROR)) && assigned_value_type^.kind != types.TypeKind.VOID {
            report_assign_mismatch(checker, node, assigned_value_type, target_type)
        }
        // Struct-to-struct name mismatch
        if target_type^.kind == types.TypeKind.STRUCT && assigned_value_type^.kind == types.TypeKind.STRUCT && target_type^.name != "" && assigned_value_type^.name != "" && target_type^.name != assigned_value_type^.name && types_assignable(checker, target_type, assigned_value_type) {
            report_assign_mismatch(checker, node, assigned_value_type, target_type)
        }
        // Enum-to-enum name mismatch
        if target_type^.kind == types.TypeKind.ENUM && assigned_value_type^.kind == types.TypeKind.ENUM && target_type^.name != "" && assigned_value_type^.name != "" && !same_enum_type(checker, target_type^.name, assigned_value_type^.name) && types_assignable(checker, target_type, assigned_value_type) {
            report_assign_mismatch(checker, node, assigned_value_type, target_type)
        }
        // Pointer-to-pointer: pointee types differ
        if target_type^.kind == types.TypeKind.POINTER && assigned_value_type^.kind == types.TypeKind.POINTER && target_type^.name != "" && assigned_value_type^.name != "" && target_type^.name != assigned_value_type^.name {
            report_assign_mismatch(checker, node, assigned_value_type, target_type)
        }
        // Array-to-array: element types differ
        if target_type^.kind == types.TypeKind.ARRAY && assigned_value_type^.kind == types.TypeKind.ARRAY && target_type^.element_type != "" && assigned_value_type^.element_type != "" && target_type^.element_type != assigned_value_type^.element_type {
            report_assign_mismatch(checker, node, assigned_value_type, target_type)
        }
        // Map-to-map: key or value types differ
        if target_type^.kind == types.TypeKind.MAP && assigned_value_type^.kind == types.TypeKind.MAP && target_type^.key_type != "" && assigned_value_type^.key_type != "" && target_type^.value_type != "" && assigned_value_type^.value_type != "" && (target_type^.key_type != assigned_value_type^.key_type || target_type^.value_type != assigned_value_type^.value_type) {
            report_assign_mismatch(checker, node, assigned_value_type, target_type)
        }
    }
    // A function variable reassigned a function of another signature
    if target^.kind == ast.NodeKind.LABEL && function_types_mismatch(checker, target_type, assigned_value_type) {
        report_assign_mismatch(checker, node, assigned_value_type, target_type)
    }
    // A mismatch through an explicit dereference (p^ = value)
    if target^.kind == ast.NodeKind.POSTFIX_EXPR && target^.postfix^.op == token.TokenKind.CARET && target_type^.kind != types.TypeKind.UNKNOWN && assigned_value_type^.kind != types.TypeKind.UNKNOWN {
        is_struct_name_mismatch = target_type^.kind == types.TypeKind.STRUCT && assigned_value_type^.kind == types.TypeKind.STRUCT && target_type^.name != "" && assigned_value_type^.name != "" && target_type^.name != assigned_value_type^.name
        is_other_mismatch = !types_assignable(checker, target_type, assigned_value_type) && !(assigned_value_type^.kind == types.TypeKind.NIL_TYPE && (target_type^.kind == types.TypeKind.POINTER || target_type^.kind == types.TypeKind.ERROR))
        // The two checks are independent, so a struct name mismatch reports both
        if is_struct_name_mismatch {
            add_diagnostic(checker, "E3098", error_registry.registry_message_formatted("E3098", {shown_type(checker, assigned_value_type), shown_type(checker, target_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if is_other_mismatch {
            add_diagnostic(checker, "E3098", error_registry.registry_message_formatted("E3098", {shown_type(checker, assigned_value_type), shown_type(checker, target_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    // A struct field assigned through a variable: the variable may be the
    // struct itself or a pointer to it.
    if target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind == ast.NodeKind.LABEL {
        field_owner = scope.scope_lookup(checker^.current_scope, target^.member^.object^.label^.value)
        if field_owner != nil && (field_owner^.sym_type^.kind == types.TypeKind.STRUCT || field_owner^.sym_type^.kind == types.TypeKind.POINTER) {
            field_type = struct_field_type(checker, field_owner^.sym_type^.name, target^.member^.member)
            if assigned_value_mismatches_field(checker, field_type, assigned_value_type) {
                report_assign_mismatch(checker, node, assigned_value_type, field_type)
            }
            check_function_signature(checker, ad^.value, field_type, assigned_value_type)
        }
    }
    // A field assigned through an explicit dereference: p^.field = value
    if target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind == ast.NodeKind.POSTFIX_EXPR && target^.member^.object^.postfix^.op == token.TokenKind.CARET {
        object_type = resolve_expression(checker, target^.member^.object)
        if object_type^.kind == types.TypeKind.STRUCT && object_type^.name != "" {
            field_type = struct_field_type(checker, object_type^.name, target^.member^.member)
            if field_type^.kind != types.TypeKind.UNKNOWN && assigned_value_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, field_type, assigned_value_type) && !(assigned_value_type^.kind == types.TypeKind.NIL_TYPE && (field_type^.kind == types.TypeKind.POINTER || field_type^.kind == types.TypeKind.ERROR)) {
                report_assign_mismatch(checker, node, assigned_value_type, field_type)
            }
        }
    }
    // A map element (m[k] = v) or a field reached through an element or a
    // nested field (xs[i].f, m[k].f): none of the checks above type-check these.
    mut is_map_element = false
    mut indexed_container_type = target_type
    if target^.kind == ast.NodeKind.INDEX_EXPR {
        indexed_container_type = resolve_expression(checker, target^.index_data^.left)
        is_map_element = indexed_container_type^.kind == types.TypeKind.MAP
    }
    is_indirect_field = target^.kind == ast.NodeKind.MEMBER_EXPR && target^.member^.object^.kind != ast.NodeKind.LABEL && !(target^.member^.object^.kind == ast.NodeKind.POSTFIX_EXPR && target^.member^.object^.postfix^.op == token.TokenKind.CARET)
    if (is_map_element || is_indirect_field) && target_type^.kind != types.TypeKind.UNKNOWN && assigned_value_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, target_type, assigned_value_type) && !(target_type^.kind == types.TypeKind.ENUM && is_int_kind(assigned_value_type^.kind)) && !(assigned_value_type^.kind == types.TypeKind.NIL_TYPE && (target_type^.kind == types.TypeKind.POINTER || target_type^.kind == types.TypeKind.ERROR)) {
        mut mismatch_slot_type = target_type
        if is_map_element && assigned_value_type^.kind == types.TypeKind.C_FUNCTION { mismatch_slot_type = indexed_container_type }
        report_assign_mismatch(checker, node, assigned_value_type, mismatch_slot_type)
    }
    // `a = mem.arena(n)` re-binds a fresh arena handle (the usual idiom after a destroy);
    // `p = mem.init(a, T)` / `mem.alloc(a, n)` re-binds which arena a pointer tracks
    if target^.kind == ast.NodeKind.LABEL && ad^.op == token.TokenKind.ASSIGN {
        target_name = target^.label^.value
        apply_mem_call(checker, ad^.value, node, target_name)
        arena_target_symbol = scope.scope_lookup(checker^.current_scope, target_name)
        if arena_target_symbol != nil {
            arena_target_symbol^.mem_arena = ""
            arena_target_symbol^.arena_identifier = ""
            bind_mem_pointer(checker, arena_target_symbol, ad^.value)
            bind_arena_handle(checker, arena_target_symbol, ad^.value, target_name)
        }
    }
    if ad^.op == token.TokenKind.ASSIGN { retire_arena_path(checker, target) }
    check_assignment_escape(checker, node, target)
}

// Storing a local's address into memory that outlives it. Reached through
// a pointer parameter, a &ref parameter or a new() object's field, into an outer
// variable, or into a field or element of an outer aggregate. The origin travels
// through intermediate pointers, so `tmp = addr(local); out^ = tmp` is caught.
fn check_assignment_escape(checker ^TypeChecker, node ^ast.AstNode, target ^ast.AstNode) {
    ad = node^.assign
    caller_memory = assign_target_outlives_locals(checker, target)
    // An arena-backed pointer stored where it outlives this function (caller
    // memory through a parameter, or a module-level global) dangles once the arena is torn down
    escape_target_root = escape_root_name(target)
    if escape_target_root != "" && (caller_memory || is_module_level_variable(checker, escape_target_root)) {
        check_mem_escape(checker, ad^.value, node)
    }
    if caller_memory {
        origin_depth, origin_name = expression_origin(checker, ad^.value)
        if origin_depth > 0 && origin_depth >= checker^.current_function_scope_depth {
            destination_root = escape_root_name(target)
            mut named string = destination_root
            if destination_root == "" { named = origin_name }
            add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {named, origin_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return
    }
    if target^.kind == ast.NodeKind.LABEL {
        pointer_name = target^.label^.value
        origin_depth, origin_name = expression_origin(checker, ad^.value)
        if origin_depth > symbol_scope_depth(checker, pointer_name) {
            add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {pointer_name, origin_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            record_symbol_origin(checker, scope.scope_lookup(checker^.current_scope, pointer_name), ad^.value)
        }
        return
    }
    if target^.kind != ast.NodeKind.MEMBER_EXPR && target^.kind != ast.NodeKind.INDEX_EXPR { return }
    root = assignment_target_root_name(target)
    if root != "" {
        origin_depth, origin_name = expression_origin(checker, ad^.value)
        root_depth = symbol_scope_depth(checker, root)
        if origin_depth > root_depth {
            add_diagnostic(checker, "E3163", error_registry.registry_message_formatted("E3163", {root, origin_name}), node^.tok.file, node^.tok.line, node^.tok.col)
        } or origin_depth > 0 {
            root_symbol = scope.scope_lookup(checker^.current_scope, root)
            if root_symbol != nil && origin_depth > root_symbol^.field_origin_depth {
                root_symbol^.field_origin_depth = origin_depth
                root_symbol^.field_origin_name = origin_name
            }
        }
        // `b.p = mem.alloc(a, x)` binds a @mem arena into a field, as a struct literal does
        // at construction: always the field slot, since the target is a field of the root
        field_root_symbol = scope.scope_lookup(checker^.current_scope, root)
        if field_root_symbol != nil {
            bound_arena, bound_epoch, _, is_bound = mem_pointer_in_expression(checker, ad^.value)
            if is_bound {
                field_root_symbol^.field_mem_arena = bound_arena
                field_root_symbol^.field_mem_epoch = bound_epoch
            }
        }
        return
    }
    // The chain passes through a `^` (`n^.link = addr(local)` on a new() object):
    // record the origin on the pointer variable so `return n` is still caught
    deref_root = escape_root_name(target)
    if deref_root == "" { return }
    root_symbol = scope.scope_lookup(checker^.current_scope, deref_root)
    if root_symbol != nil && root_symbol^.is_heap {
        origin_depth, origin_name = expression_origin(checker, ad^.value)
        if origin_depth > 0 && origin_depth > root_symbol^.field_origin_depth {
            root_symbol^.field_origin_depth = origin_depth
            root_symbol^.field_origin_name = origin_name
        }
    }
}

// `value_type` cannot be assigned to a slot of `slot_type`.
fn report_assign_mismatch(checker ^TypeChecker, node ^ast.AstNode, value_type ^types.GrayType, slot_type ^types.GrayType) {
    add_diagnostic(checker, "E3001", error_registry.registry_message_formatted("E3001", {shown_type(checker, value_type), shown_type(checker, slot_type)}), node^.tok.file, node^.tok.line, node^.tok.col)
}

// True when `assigned_value_type` cannot be stored in a struct field of
// `field_type`.
fn assigned_value_mismatches_field(checker ^TypeChecker, field_type ^types.GrayType, assigned_value_type ^types.GrayType) -> bool {
    if field_type^.kind == types.TypeKind.UNKNOWN || assigned_value_type^.kind == types.TypeKind.UNKNOWN { return false }
    if assigned_value_type^.kind == types.TypeKind.NIL_TYPE && (field_type^.kind == types.TypeKind.POINTER || field_type^.kind == types.TypeKind.ERROR) { return false }
    if !types_assignable(checker, field_type, assigned_value_type) { return true }
    if field_type^.kind == types.TypeKind.POINTER && field_type^.name != "" && assigned_value_type^.name != "" && field_type^.name != assigned_value_type^.name { return true }
    return field_type^.kind == types.TypeKind.STRUCT && assigned_value_type^.kind == types.TypeKind.STRUCT && field_type^.name != "" && assigned_value_type^.name != "" && field_type^.name != assigned_value_type^.name
}

// True when `node` or anything nested in it contains a return statement.
fn block_has_return(node ^ast.AstNode) -> bool {
    if node == nil { return false }
    if node^.kind == ast.NodeKind.RETURN_STMT { return true }
    if node^.kind == ast.NodeKind.BLOCK_STMT {
        for_each statement in node^.block^.stmts {
            if block_has_return(statement) { return true }
        }
    }
    if node^.kind == ast.NodeKind.IF_STMT {
        if block_has_return(node^.if_stmt^.consequence) { return true }
        if block_has_return(node^.if_stmt^.alternative) { return true }
    }
    if node^.kind == ast.NodeKind.WHEN_STMT {
        for_each wc in node^.when_stmt^.cases {
            if block_has_return(wc.body) { return true }
        }
        if block_has_return(node^.when_stmt^.default_body) { return true }
    }
    if node^.kind == ast.NodeKind.LOOP_STMT { return block_has_return(node^.loop_stmt^.body) }
    if node^.kind == ast.NodeKind.FOR_STMT { return block_has_return(node^.for_stmt^.body) }
    if node^.kind == ast.NodeKind.FOR_EACH_STMT { return block_has_return(node^.for_each_stmt^.body) }
    if node^.kind == ast.NodeKind.WHILE_STMT { return block_has_return(node^.while_stmt^.body) }
    return false
}

// True when `node` holds a `break` that leaves the loop being checked, whose
// label is `label` ("" when unlabeled). An unlabeled `break` in a nested loop
// leaves that loop, so only a `break label` is looked for there.
fn contains_loop_break(node ^ast.AstNode, loop_name string, is_nested bool) -> bool {
    if node == nil { return false }
    if node^.kind == ast.NodeKind.BREAK_STMT {
        target = node^.loop_jump^.label
        if target == "" { return !is_nested }
        return loop_name != "" && target == loop_name
    }
    if node^.kind == ast.NodeKind.BLOCK_STMT {
        for_each statement in node^.block^.stmts {
            if contains_loop_break(statement, loop_name, is_nested) { return true }
        }
    }
    if node^.kind == ast.NodeKind.IF_STMT {
        return contains_loop_break(node^.if_stmt^.consequence, loop_name, is_nested) || contains_loop_break(node^.if_stmt^.alternative, loop_name, is_nested)
    }
    if node^.kind == ast.NodeKind.WHEN_STMT {
        for_each wc in node^.when_stmt^.cases {
            if contains_loop_break(wc.body, loop_name, is_nested) { return true }
        }
        return contains_loop_break(node^.when_stmt^.default_body, loop_name, is_nested)
    }
    if loop_name != "" {
        if node^.kind == ast.NodeKind.FOR_STMT { return contains_loop_break(node^.for_stmt^.body, loop_name, true) }
        if node^.kind == ast.NodeKind.FOR_EACH_STMT { return contains_loop_break(node^.for_each_stmt^.body, loop_name, true) }
        if node^.kind == ast.NodeKind.WHILE_STMT { return contains_loop_break(node^.while_stmt^.body, loop_name, true) }
        if node^.kind == ast.NodeKind.LOOP_STMT { return contains_loop_break(node^.loop_stmt^.body, loop_name, true) }
    }
    return false
}

// True when every path through `node` ends in a return.
fn all_paths_return(node ^ast.AstNode) -> bool {
    if node == nil { return false }
    if node^.kind == ast.NodeKind.RETURN_STMT { return true }
    if node^.kind == ast.NodeKind.BLOCK_STMT {
        stmts = node^.block^.stmts
        if len(stmts) == 0 { return false }
        for_each statement in stmts {
            if statement^.kind == ast.NodeKind.RETURN_STMT { return true }
        }
        return all_paths_return(stmts[len(stmts) - 1])
    }
    if node^.kind == ast.NodeKind.IF_STMT {
        if node^.if_stmt^.alternative == nil { return false }
        return all_paths_return(node^.if_stmt^.consequence) && all_paths_return(node^.if_stmt^.alternative)
    }
    if node^.kind == ast.NodeKind.WHEN_STMT {
        wd = node^.when_stmt
        if wd^.default_body == nil {
            if !wd^.is_strict { return false }
        } otherwise {
            if !all_paths_return(wd^.default_body) { return false }
        }
        for_each wc in wd^.cases {
            if !all_paths_return(wc.body) { return false }
        }
        return true
    }
    // loop { ... return ... }: an infinite loop with a return always returns,
    // unless a break can leave it.
    if node^.kind == ast.NodeKind.LOOP_STMT {
        return block_has_return(node^.loop_stmt^.body) && !contains_loop_break(node^.loop_stmt^.body, node^.loop_label, false)
    }
    return false
}

// Return statement.
fn check_return_statement(checker ^TypeChecker, node ^ast.AstNode) {
    values = node^.return_stmt^.values
    expected_types = checker^.current_return_types
    mut value_types [^types.GrayType] = {}
    mut is_multi_value_rejected = false
    for i in range(0, len(values)) {
        // A multi-return call in a single-value return position
        errors_before_value = diagnostic_error_count(checker)
        reject_multi_return_in_single_position(checker, values[i])
        if diagnostic_error_count(checker) > errors_before_value { is_multi_value_rejected = true }
        mut slot_expected ^types.GrayType = nil
        if i < len(expected_types) { slot_expected = expected_types[i] }
        checker^.json_parse_target_call = values[i]
        arrays.append(value_types, check_expression_as(checker, values[i], slot_expected))
    }

    // Main exits when control reaches its closing brace
    if checker^.is_main_function {
        add_diagnostic_help(checker, "E3073", "'return' is not allowed in main(); main exits when control reaches the closing brace", "use exit(code) to terminate with a status code", node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }

    // Returning the address of a local; its memory is freed on return. The
    // origin travels through intermediate pointers, struct fields and container
    // literals.
    for_each returned in values {
        origin_depth, origin_name = expression_origin(checker, returned)
        if origin_depth > 0 && origin_depth >= checker^.current_function_scope_depth {
            add_diagnostic(checker, "E3162", error_registry.registry_message_formatted("E3162", {origin_name, origin_name}), returned^.tok.file, returned^.tok.line, returned^.tok.col)
        }
        // The returned pointer roots at a @mem arena this function tears down
        check_mem_escape(checker, returned, returned)
    }

    // Nil only fits pointer and error return types
    if len(expected_types) > 0 && len(values) > 0 && values[0]^.kind == ast.NodeKind.NIL_VALUE {
        k = expected_types[0]^.kind
        if k != types.TypeKind.POINTER && k != types.TypeKind.ERROR && k != types.TypeKind.UNKNOWN && k != types.TypeKind.NIL_TYPE && k != types.TypeKind.VOID {
            add_diagnostic(checker, "E3072", error_registry.registry_message_formatted("E3072", {shown_type(checker, expected_types[0])}), values[0]^.tok.file, values[0]^.tok.line, values[0]^.tok.col)
        }
    }

    // Nil cannot stand for a type parameter that no call has bound
    if len(expected_types) > 0 && len(values) > 0 && values[0]^.kind == ast.NodeKind.NIL_VALUE && expected_types[0]^.kind == types.TypeKind.UNKNOWN && strings.contains(expected_types[0]^.name, "?") {
        add_diagnostic(checker, "E3071", error_registry.registry_message("E3071"), values[0]^.tok.file, values[0]^.tok.line, values[0]^.tok.col)
    }

    if len(expected_types) == 0 && len(values) > 0 {
        // A value returned from a void function
        add_diagnostic(checker, "E3184", error_registry.registry_message("E3184"), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    if len(expected_types) > 0 && len(values) == 0 {
        // A bare return in a function without named returns
        if !checker^.has_named_returns {
            add_diagnostic(checker, "E3185", error_registry.registry_message("E3185"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return
    }
    // The parser's or_return guard returns just `_gray_orN.verr`; codegen fills the other slots.
    or_return_guard = len(values) == 1 && values[0]^.kind == ast.NodeKind.MEMBER_EXPR && values[0]^.member^.object^.kind == ast.NodeKind.LABEL && strings.starts_with(values[0]^.member^.object^.label^.value, ast.SYNTH_OR)
    if len(expected_types) > 0 && len(values) != len(expected_types) {
        // Wrong number of return values; a multi-value call already reported is the cause
        if !or_return_guard && !is_multi_value_rejected {
            add_diagnostic(checker, "E3188", error_registry.registry_message_formatted("E3188", {"${len(expected_types)}", "${len(values)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return
    }

    // Each returned value must fit its slot
    for i in range(0, len(values)) {
        if or_return_guard { break }
        got = value_types[i]
        want = expected_types[i]
        if got^.kind == types.TypeKind.UNKNOWN || want^.kind == types.TypeKind.UNKNOWN || got^.kind == types.TypeKind.NIL_TYPE { continue }
        slot_fits = types_assignable(checker, want, got)
        named_pair = got^.name != "" && want^.name != "" && got^.kind == want^.kind && (got^.kind == types.TypeKind.STRUCT || got^.kind == types.TypeKind.ENUM)
        mut same_named = true
        if named_pair {
            if got^.kind == types.TypeKind.STRUCT {
                same_named = same_struct_type(checker, got^.name, want^.name)
            } otherwise {
                same_named = same_enum_type(checker, got^.name, want^.name)
            }
        }
        mut is_map_mismatch = false
        if i == 0 && got^.kind == types.TypeKind.MAP && want^.kind == types.TypeKind.MAP {
            is_map_mismatch = (got^.key_type != "" && want^.key_type != "" && got^.key_type != want^.key_type) || (got^.value_type != "" && want^.value_type != "" && got^.value_type != want^.value_type)
        }
        if !slot_fits || !same_named || is_map_mismatch {
            // the first slot reports at the statement, later slots at their value
            mut report_at = node
            if i > 0 { report_at = values[i] }
            add_diagnostic(checker, "E5049", error_registry.registry_message_formatted("E5049", {shown_type(checker, want), shown_type(checker, got)}), report_at^.tok.file, report_at^.tok.line, report_at^.tok.col)
        }
    }

    // A returned function reference must have the declared signature
    if len(values) == 1 && len(expected_types) == 1 && !or_return_guard {
        check_function_signature(checker, values[0], expected_types[0], value_types[0])
    }

    // A named return must return its variable
    if checker^.has_named_returns {
        for i in range(0, len(values)) {
            if i >= len(checker^.current_return_names) { break }
            return_name = checker^.current_return_names[i]
            if return_name == "" { continue }
            is_named_variable = values[i]^.kind == ast.NodeKind.LABEL && values[i]^.label^.value == return_name
            if !is_named_variable {
                add_diagnostic(checker, "E3080", error_registry.registry_message_formatted("E3080", {return_name}), values[i]^.tok.file, values[i]^.tok.line, values[i]^.tok.col)
            }
        }
    }
}

// Function body: a fresh scope holding the parameters, the current-function return state, the
// body walk, missing returns, unmatched named returns, and unused locals.
// Ensure must appear at the top level of a function body. The cleanup
// pass only walks the function-body block, so an ensure inside a loop, branch
// or nested block would silently never run.
fn check_no_nested_ensure(checker ^TypeChecker, node ^ast.AstNode, nested bool) {
    if node == nil { return }
    if node^.kind == ast.NodeKind.ENSURE_STMT && nested {
        add_diagnostic(checker, "E3070", error_registry.registry_message("E3070"), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    #strict
    when node^.kind {
        is ast.NodeKind.BLOCK_STMT {
            for_each statement in node^.block^.stmts {
                // A block inside a block (`unsafe { }`) is its own scope
                check_no_nested_ensure(checker, statement, nested || statement^.kind == ast.NodeKind.BLOCK_STMT)
            }
        }
        is ast.NodeKind.IF_STMT {
            check_no_nested_ensure(checker, node^.if_stmt^.consequence, true)
            check_no_nested_ensure(checker, node^.if_stmt^.alternative, true)
        }
        is ast.NodeKind.FOR_STMT { check_no_nested_ensure(checker, node^.for_stmt^.body, true) }
        is ast.NodeKind.FOR_EACH_STMT { check_no_nested_ensure(checker, node^.for_each_stmt^.body, true) }
        is ast.NodeKind.WHILE_STMT { check_no_nested_ensure(checker, node^.while_stmt^.body, true) }
        is ast.NodeKind.LOOP_STMT { check_no_nested_ensure(checker, node^.loop_stmt^.body, true) }
        is ast.NodeKind.WHEN_STMT {
            for_each case_entry in node^.when_stmt^.cases { check_no_nested_ensure(checker, case_entry.body, true) }
            check_no_nested_ensure(checker, node^.when_stmt^.default_body, true)
        }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
        ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT, ast.NodeKind.RETURN_STMT,
        ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT, ast.NodeKind.BREAK_STMT,
        ast.NodeKind.CONTINUE_STMT, ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT,
        ast.NodeKind.USING_STMT, ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

fn check_function_declaration(checker ^TypeChecker, node ^ast.AstNode) {
    check_function_declaration_bound(checker, node, "")
}

// Checks a function body. A generic function is checked once with its type
// parameters unbound (`binding_text` empty), then once per instantiation with
// them bound to that instantiation's types.
fn check_function_declaration_bound(checker ^TypeChecker, node ^ast.AstNode, binding_text string) {
    function_data = node^.func_decl
    if binding_text == "" {
        check_declaration_name(checker, function_data^.name, func_display_name_for(node), "a function", node^.tok.file, node^.tok.line, node^.tok.col)
        // A function inside a function
        if checker^.function_depth > 0 {
            add_diagnostic(checker, "E2051", error_registry.registry_message_formatted("E2051", {func_display_name_for(node)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    checker^.function_depth = checker^.function_depth + 1
    outer = checker^.current_scope
    function_scope = scope.scope_create(outer)
    checker^.current_scope = function_scope
    saved_using_count i64 = len(checker^.using_modules)
    saved_function_scope_depth = checker^.current_function_scope_depth
    saved_function = checker^.current_function
    checker^.current_function_scope_depth = function_scope^.depth + 1
    checker^.current_function = node
    checker_enter_generics(checker, function_data, binding_text)

    params_local = function_data^.params
    mut seen_default = false
    mut parameter_index i64 = -1
    for_each p in params_local {
        parameter_index = parameter_index + 1
        // A required parameter cannot follow one with a default value
        if p.default_value != nil { seen_default = true }
        if p.default_value == nil && seen_default && binding_text == "" {
            add_diagnostic(checker, "E2039", "required parameter '${p.name}' follows a parameter with a default value", node^.tok.file, node^.tok.line, node^.tok.col)
        }
        if binding_text == "" {
            check_declaration_name(checker, p.name, p.name, "a parameter", node^.tok.file, node^.tok.line, node^.tok.col)
            report_shadowed_module(checker, node, p.name, p.name)
            check_reserved_main(checker, p.name, node^.tok.file, node^.tok.line, node^.tok.col)
            // The same parameter name twice
            for earlier in range(0, parameter_index) {
                if params_local[earlier].name == p.name {
                    add_diagnostic(checker, "E2012", error_registry.registry_message_formatted("E2012", {p.name}), node^.tok.file, node^.tok.line, node^.tok.col)
                    break
                }
            }
            report_shadowed_function(checker, node, p.name, p.name)
        }
        // A type parameter is not a variable: its name stands for a type
        if p.is_type_param { continue }
        // A parameter type that names a type parameter declared later
        if binding_text == "" {
            later_bindings = ast.generic_bindings_init(function_data, "")
            mut declared_so_far i64 = 0
            for earlier_index in range(0, parameter_index + 1) {
                if params_local[earlier_index].is_type_param { declared_so_far += 1 }
            }
            for later_index in range(declared_so_far, len(later_bindings.names)) {
                single_generic = ast.GenericBindings{names: {later_bindings.names[later_index]}, types: {later_bindings.types[later_index]}}
                if strings.contains(ast.generic_bindings_substitute(single_generic, p.type_name), "?") {
                    add_diagnostic(checker, "E4039", error_registry.registry_message_formatted("E4039", {later_bindings.names[later_index], p.name}), node^.tok.file, node^.tok.line, node^.tok.col)
                    break
                }
            }
        }
        // A fixed-size array cannot be a parameter
        if binding_text == "" && strings.starts_with(p.type_name, "[") && type_has_array_size(p.type_name) {
            inner_text = strings.slice(p.type_name, 1, len(p.type_name) - 1)
            element_text = strings.slice(inner_text, 0, types.type_top_level_comma(inner_text))
            add_diagnostic(checker, "E3119", "fixed-size array type '${p.type_name}' is not allowed in function parameter '${p.name}'; use [${element_text}] instead", node^.tok.file, node^.tok.line, node^.tok.col)
        }
        mut parameter_type = checker_type_from_name(checker, p.type_name)
        // With no annotation the type comes from a default value that is an enum member
        if p.type_name == "" && p.default_value != nil {
            inferred_type = resolve_expression(checker, p.default_value)
            if inferred_type^.kind == types.TypeKind.ENUM {
                parameter_type = inferred_type
                // the declaration now carries the type the default gave the parameter
                function_data^.params[parameter_index].type_name = inferred_type^.name
                function_data^.params[parameter_index].type_from_default = true
            } otherwise {
                add_diagnostic(checker, "E3160", error_registry.registry_message_formatted("E3160", {p.name, p.name}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
        // Undefined parameter type
        if binding_text == "" {
            undefined_parameter_leaf = undefined_type_leaf(checker, p.type_name)
            if undefined_parameter_leaf != "" {
                add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {unqualified_display_name(undefined_parameter_leaf)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            reject_error_in_container(checker, node, p.type_name)
            if p.type_name != "" && !strings.starts_with(p.type_name, "func(") && !strings.starts_with(p.type_name, "[func(") {
                reject_void_type(checker, node, p.type_name, "a parameter type")
            }
        }
        if binding_text == "" && p.name != "_" {
            // The parameter shadows an enum variant name
            mut found_variant = false
            for_each enum_key in maps.get_keys(checker^.enums) {
                if found_variant { break }
                enum_info = checker^.enums[enum_key]
                for_each enum_variant in enum_info^.values {
                    if enum_variant == p.name {
                        add_diagnostic(checker, "W2008", error_registry.registry_message_formatted("W2008", {p.name, enum_info^.display_name, p.name}), node^.tok.file, node^.tok.line, node^.tok.col)
                        found_variant = true
                        break
                    }
                }
            }
        }
        scope.scope_define(function_scope, p.name, parameter_type, p.is_mutable)
        parameter_symbol = scope.scope_lookup_local(function_scope, p.name)
        if parameter_symbol != nil { parameter_symbol^.param_line = node^.tok.line }
        // A default value must fit its parameter (checked once, in the unbound pass)
        if p.default_value != nil && p.type_name != "" && binding_text == "" {
            default_type = check_expression_as(checker, p.default_value, parameter_type)
            reject_multi_return_in_single_position(checker, p.default_value)
            if default_type^.kind != types.TypeKind.UNKNOWN && parameter_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, parameter_type, default_type) && default_type^.kind != types.TypeKind.NIL_TYPE {
                add_diagnostic(checker, "E5062", error_registry.registry_message_formatted("E5062", {p.name, p.type_name, shown_type(checker, default_type)}), p.default_value^.tok.file, p.default_value^.tok.line, p.default_value^.tok.col)
            }
        }
        // The parameter shadows a global constant or variable
        if binding_text == "" && p.name != "_" {
            global_symbol = scope.scope_lookup(outer, p.name)
            if global_symbol != nil && global_symbol^.def_line > 0 {
                add_diagnostic(checker, "W2007", error_registry.registry_message_formatted("W2007", {p.name, "${global_symbol^.def_line}"}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }

    // Named returns are variables of the function scope
    mut has_names = false
    for i in range(0, len(function_data^.return_names)) {
        rn = function_data^.return_names[i]
        if rn != "" {
            has_names = true
            if binding_text == "" {
                // A named return that repeats another, or names a parameter
                for earlier in range(0, i) {
                    if function_data^.return_names[earlier] == rn {
                        add_diagnostic(checker, "E2063", error_registry.registry_message_formatted("E2063", {rn, "another named return value"}), node^.tok.file, node^.tok.line, node^.tok.col)
                        break
                    }
                }
                for_each declared_parameter in params_local {
                    if declared_parameter.name == rn {
                        add_diagnostic(checker, "E2063", error_registry.registry_message_formatted("E2063", {rn, "a parameter"}), node^.tok.file, node^.tok.line, node^.tok.col)
                        break
                    }
                }
            }
            // Not defined here: the body declares a named return (`mut x T`) or its first assignment does
        }
    }

    saved_types = checker^.current_return_types
    saved_named = checker^.has_named_returns
    saved_return_names = checker^.current_return_names
    saved_main = checker^.is_main_function

    mut return_types [^types.GrayType] = {}
    for_each rt in function_data^.return_types {
        arrays.append(return_types, checker_type_from_name(checker, rt))
        // A returned func value cannot be called, assigned or stored, so a function
        // whose return type is func has no valid use
        if rt == "func" || strings.starts_with(rt, "func(") {
            add_diagnostic(checker, "E3142", error_registry.registry_message_formatted("E3142", {func_display_name_for(node)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
        reject_error_in_container(checker, node, rt)
        // Undefined return type
        bad_leaf = undefined_type_leaf(checker, rt)
        if bad_leaf != "" {
            add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {unqualified_display_name(bad_leaf)}), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    // main is always void; an error already reported a declared return type
    if function_data^.name == "main" { return_types = {} }
    checker^.current_return_types = return_types
    checker^.has_named_returns = has_names
    checker^.current_return_names = function_data^.return_names
    checker^.is_main_function = function_data^.name == "main"

    // The @mem arena state starts empty in each function; flag the arenas the body
    // tears down anywhere, so a pointer escaping via `return` is caught in any order
    checker^.arenas = {}
    checker^.reassigned_arena_paths = {}
    checker^.applied_mem_effects = {:}
    premark_function_destroys(checker, function_data^.body)
    check_block(checker, function_data^.body)
    if binding_text == "" { check_no_nested_ensure(checker, function_data^.body, false) }

    if len(return_types) > 0 && function_data^.body != nil && function_data^.body^.kind == ast.NodeKind.BLOCK_STMT {
        mut has_return = false
        for_each statement in function_data^.body^.block^.stmts {
            if block_has_return(statement) {
                has_return = true
                break
            }
        }
        if !has_return && !has_names {
            message = fmt.sprintf("function '%s' must return a value but has no return statement", {func_display_name_for(node)})
            add_diagnostic(checker, "E3024", message, node^.tok.file, node^.tok.line, node^.tok.col)
        } otherwise {
            if has_return && !has_names && !all_paths_return(function_data^.body) {
                message = fmt.sprintf("not all code paths in '%s' return a value", {func_display_name_for(node)})
                add_diagnostic(checker, "E3035", message, node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }

    // A named return with no matching variable in the body
    for_each rn in function_data^.return_names {
        if rn != "" && scope.scope_lookup_local(function_scope, rn) == nil {
            message = fmt.sprintf("named return value '%s' is declared in the signature but no matching variable exists in the function body", {rn})
            add_diagnostic(checker, "W2011", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }

    // Locals declared but never used (parameters are exempt)
    local_symbols = function_scope^.symbols
    for_each local_name in maps.get_keys(local_symbols) {
        symbol = local_symbols[local_name]
        if symbol^.used || strings.starts_with(local_name, "_") || symbol^.def_line <= 0 { continue }
        mut is_param = false
        for_each p in params_local {
            if p.name == local_name { is_param = true }
        }
        if !is_param {
            message = fmt.sprintf("variable '%s' is declared but never used", {local_name})
            add_diagnostic(checker, "W1001", message, node^.tok.file, symbol^.def_line, symbol^.def_column)
        }
    }

    checker^.current_return_types = saved_types
    checker^.has_named_returns = saved_named
    checker^.current_return_names = saved_return_names
    checker^.is_main_function = saved_main
    checker^.current_scope = outer
    // A `using` inside the body ends with it
    mut kept_using [string] = {}
    for kept_index in range(0, saved_using_count) { arrays.append(kept_using, checker^.using_modules[kept_index]) }
    checker^.using_modules = kept_using
    checker^.function_depth = checker^.function_depth - 1
    checker^.current_function_scope_depth = saved_function_scope_depth
    checker^.current_function = saved_function
    checker_leave_generics(checker)
}

// for_each.
fn check_for_each_statement(checker ^TypeChecker, node ^ast.AstNode) {
    fe = node^.for_each_stmt
    outer = checker^.current_scope
    loop_scope = scope.scope_create(outer)
    checker^.current_scope = loop_scope

    // A stdlib module name as a loop variable
    if fe^.var_name != "" && reserved.is_stdlib_module_name(fe^.var_name) {
        add_diagnostic(checker, "E5035", error_registry.registry_message_formatted("E5035", {fe^.var_name, "a variable"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    if fe^.index_name != "" && reserved.is_stdlib_module_name(fe^.index_name) {
        add_diagnostic(checker, "E5035", error_registry.registry_message_formatted("E5035", {fe^.index_name, "a variable"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    report_shadowed_module(checker, node, fe^.var_name, fe^.var_name)
    report_shadowed_module(checker, node, fe^.index_name, fe^.index_name)
    report_shadowed_function(checker, node, fe^.index_name, fe^.index_name)
    report_shadowed_function(checker, node, fe^.var_name, fe^.var_name)
    // The loop variables shadow an outer variable
    if fe^.var_name != "" && fe^.var_name != "_" {
        outer_sym = scope.scope_lookup(outer, fe^.var_name)
        if outer_sym != nil {
            message = fmt.sprintf("for_each variable '%s' shadows a variable declared on line %d", {fe^.var_name, symbol_shadow_line(outer_sym)})
            add_diagnostic(checker, "W2002", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    if fe^.index_name != "" && fe^.index_name != "_" {
        outer_sym = scope.scope_lookup(outer, fe^.index_name)
        if outer_sym != nil {
            message = fmt.sprintf("for_each index variable '%s' shadows a variable declared on line %d", {fe^.index_name, symbol_shadow_line(outer_sym)})
            add_diagnostic(checker, "W2002", message, node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }

    // Both positions discarded, nothing is accessed
    if fe^.index_name == "_" && fe^.var_name == "_" {
        add_diagnostic(checker, "E3123", "'for_each' with both positions discarded accesses nothing; use 'for _ in range(0, len(collection))' to iterate by count", node^.tok.file, node^.tok.line, node^.tok.col)
        resolve_quietly(checker, fe^.collection)
        checker^.current_scope = outer
        return
    }

    reject_multi_return_in_single_position(checker, fe^.collection)
    collection_type = resolve_expression(checker, fe^.collection)

    // An empty literal has no elements to infer from
    if fe^.collection^.kind == ast.NodeKind.ARRAY_VALUE && len(fe^.collection^.array_value^.elements) == 0 {
        add_diagnostic(checker, "E3136", "empty array literal has no elements to infer a type from; add at least one element or use a typed declaration", fe^.collection^.tok.file, fe^.collection^.tok.line, fe^.collection^.tok.col)
    }

    // Only arrays, maps and strings iterate
    ck = collection_type^.kind
    if ck != types.TypeKind.UNKNOWN && ck != types.TypeKind.ARRAY && ck != types.TypeKind.MAP && ck != types.TypeKind.STRING {
        message = fmt.sprintf("cannot iterate over type '%s'; for_each requires an array, map, or string", {shown_type(checker, collection_type)})
        add_diagnostic(checker, "E3009", message, node^.tok.file, node^.tok.line, node^.tok.col)
    }

    if ck == types.TypeKind.MAP {
        mut key_type = checker^.pool^.type_string
        if collection_type^.key_type != "" { key_type = checker_type_from_name(checker, collection_type^.key_type) }
        mut value_type = checker^.pool^.type_unknown
        if collection_type^.value_type != "" { value_type = checker_type_from_name(checker, collection_type^.value_type) }
        if fe^.index_name != "" {
            // Two-variable form: the first name is the key, the second the value
            scope.scope_define(loop_scope, fe^.index_name, key_type, false)
            scope.scope_define(loop_scope, fe^.var_name, value_type, false)
        } otherwise {
            scope.scope_define(loop_scope, fe^.var_name, key_type, false)
        }
    } otherwise {
        mut element_type = checker^.pool^.type_unknown
        if ck == types.TypeKind.ARRAY && collection_type^.element_type != "" {
            element_type = checker_type_from_name(checker, collection_type^.element_type)
        }
        if ck == types.TypeKind.STRING { element_type = checker^.pool^.type_char }
        if fe^.index_name != "" {
            scope.scope_define(loop_scope, fe^.index_name, checker^.pool^.type_i64, false)
        }
        scope.scope_define(loop_scope, fe^.var_name, element_type, false)
    }
    set_binding_line(loop_scope, fe^.index_name, node^.tok.line)
    set_binding_line(loop_scope, fe^.var_name, node^.tok.line)

    // A pointer read out of a tracked container keeps the container's lifetime
    // origin, so returning or storing the loop variable is still errors
    collection_root = assignment_target_root_name(fe^.collection)
    if collection_root != "" && fe^.var_name != "" {
        collection_symbol = scope.scope_lookup(outer, collection_root)
        loop_variable_symbol = scope.scope_lookup_local(loop_scope, fe^.var_name)
        if collection_symbol != nil && loop_variable_symbol != nil && collection_symbol^.field_origin_depth != 0 {
            loop_variable_symbol^.origin_depth = collection_symbol^.field_origin_depth
            loop_variable_symbol^.origin_name = collection_symbol^.field_origin_name
        }
    }
    // An element read out of a container holding a pointer to a const is such a pointer itself
    if fe^.var_name != "" { propagate_const_source(checker, scope.scope_lookup_local(loop_scope, fe^.var_name), fe^.collection) }

    enter_loop(checker, node)
    premark_loop_body(checker, fe^.body, fe^.body)    check_block(checker, fe^.body)
    leave_loop(checker)
    report_unused_in_scope(checker, loop_scope)
    checker^.current_scope = outer
}

// as_long_as loop.
fn check_while_statement(checker ^TypeChecker, node ^ast.AstNode) {
    wd = node^.while_stmt
    check_condition(checker, wd^.condition, resolve_expression(checker, wd^.condition), "as_long_as")
    reject_multi_return_in_single_position(checker, wd^.condition)

    // An empty body loops forever
    if wd^.body != nil && len(wd^.body^.block^.stmts) == 0 {
        add_diagnostic(checker, "E3129", "empty loop body; this will loop forever at runtime", node^.tok.file, node^.tok.line, node^.tok.col)
    }

    outer = checker^.current_scope
    while_scope = scope.scope_create(outer)
    checker^.current_scope = while_scope
    enter_loop(checker, node)
    premark_loop_body(checker, wd^.body, wd^.body)    check_block(checker, wd^.body)
    leave_loop(checker)
    report_unused_in_scope(checker, while_scope)
    checker^.current_scope = outer
}

// Unconditional `loop`.
fn check_loop_statement(checker ^TypeChecker, node ^ast.AstNode) {
    body = node^.loop_stmt^.body
    if body != nil && len(body^.block^.stmts) == 0 {
        add_diagnostic(checker, "E3129", "empty loop body; this will loop forever at runtime", node^.tok.file, node^.tok.line, node^.tok.col)
    }
    outer = checker^.current_scope
    loop_body_scope = scope.scope_create(outer)
    checker^.current_scope = loop_body_scope
    enter_loop(checker, node)
    check_block(checker, body)
    leave_loop(checker)
    report_unused_in_scope(checker, loop_body_scope)
    checker^.current_scope = outer
}

// True when two `when` case values are the same literal, enum selector or
// destructuring pattern, so the later one can never match.
// The constant i64 value of a case node, if it folds to one.
fn when_constant_i64(checker ^TypeChecker, node ^ast.AstNode) -> (i64, bool) {
    if node == nil { return 0, false }
    folded_value, is_folded, _ = fold_const_integer(checker, node)
    return folded_value, is_folded
}

// The start, stop and step of a `range(...)` case whose bounds are constant i64 values and
// whose step is not zero.
fn when_constant_range(checker ^TypeChecker, node ^ast.AstNode) -> (i64, i64, i64, bool) {
    if node == nil || node^.kind != ast.NodeKind.RANGE_EXPR { return 0, 0, 0, false }
    mut start i64 = 0
    mut stop i64 = 0
    mut step i64 = 1
    if node^.range_expr^.start_expr != nil {
        folded_start, is_start_constant = when_constant_i64(checker, node^.range_expr^.start_expr)
        if !is_start_constant { return 0, 0, 0, false }
        start = folded_start
    }
    folded_stop, is_stop_constant = when_constant_i64(checker, node^.range_expr^.end_expr)
    if !is_stop_constant { return 0, 0, 0, false }
    stop = folded_stop
    if node^.range_expr^.step != nil {
        folded_step, is_step_constant = when_constant_i64(checker, node^.range_expr^.step)
        if !is_step_constant { return 0, 0, 0, false }
        step = folded_step
    }
    return start, stop, step, step != 0
}

fn when_range_contains(start i64, stop i64, step i64, value i64) -> bool {
    if step > 0 { return value >= start && value < stop && (value - start) % step == 0 }
    return value <= start && value > stop && (start - value) % (0 - step) == 0
}

// True when every value the case `value` matches is already matched by the earlier range
// case `earlier`: a constant inside it, a constant range whose first and last values are
// inside it and whose step is a multiple of its step, or the same stored range variable.
fn when_case_covered_by_range(checker ^TypeChecker, value ^ast.AstNode, earlier ^ast.AstNode) -> bool {
    if value == nil || earlier == nil { return false }
    if value^.kind == ast.NodeKind.LABEL && earlier^.kind == ast.NodeKind.LABEL {
        label_symbol = scope.scope_lookup(checker^.current_scope, value^.label^.value)
        return label_symbol != nil && label_symbol^.sym_type^.kind == types.TypeKind.RANGE && value^.label^.value == earlier^.label^.value
    }
    earlier_start, earlier_stop, earlier_step, is_earlier_constant = when_constant_range(checker, earlier)
    if !is_earlier_constant { return false }
    point, is_point = when_constant_i64(checker, value)
    if is_point { return when_range_contains(earlier_start, earlier_stop, earlier_step, point) }
    start, stop, step, is_constant_range = when_constant_range(checker, value)
    if !is_constant_range { return false }
    if step > 0 && start >= stop { return false }
    if step <= 0 && start <= stop { return false }
    mut distance i64 = start - stop
    mut stride i64 = 0 - step
    if step > 0 {
        distance = stop - start
        stride = step
    }
    steps_to_last = (distance - 1) / stride
    mut last i64 = start - steps_to_last * stride
    if step > 0 { last = start + steps_to_last * stride }
    mut earlier_stride i64 = 0 - earlier_step
    if earlier_step > 0 { earlier_stride = earlier_step }
    return stride % earlier_stride == 0 && when_range_contains(earlier_start, earlier_stop, earlier_step, start) && when_range_contains(earlier_start, earlier_stop, earlier_step, last)
}

fn when_case_values_equal(checker ^TypeChecker, a ^ast.AstNode, b ^ast.AstNode) -> bool {
    left_constant, is_left_constant = when_constant_i64(checker, a)
    right_constant, is_right_constant = when_constant_i64(checker, b)
    if is_left_constant && is_right_constant { return left_constant == right_constant }
    if a^.kind == ast.NodeKind.INT_VALUE && b^.kind == ast.NodeKind.INT_VALUE {
        return a^.int_value^.value == b^.int_value^.value
    }
    if a^.kind == ast.NodeKind.STRING_VALUE && b^.kind == ast.NodeKind.STRING_VALUE {
        return a^.string_value^.value == b^.string_value^.value
    }
    if a^.kind == ast.NodeKind.CHAR_VALUE && b^.kind == ast.NodeKind.CHAR_VALUE {
        return a^.char_value^.value == b^.char_value^.value
    }
    if a^.kind == ast.NodeKind.BOOL_VALUE && b^.kind == ast.NodeKind.BOOL_VALUE {
        return a^.bool_value^.value == b^.bool_value^.value
    }
    if a^.kind == ast.NodeKind.IMPLICIT_ENUM && b^.kind == ast.NodeKind.IMPLICIT_ENUM {
        return a^.implicit_enum^.variant == b^.implicit_enum^.variant
    }
    if a^.kind == ast.NodeKind.WHEN_PATTERN && b^.kind == ast.NodeKind.WHEN_PATTERN {
        return a^.when_pattern^.variant == b^.when_pattern^.variant
    }
    if a^.kind == ast.NodeKind.MEMBER_EXPR && b^.kind == ast.NodeKind.MEMBER_EXPR {
        if a^.member^.object^.kind == ast.NodeKind.LABEL && b^.member^.object^.kind == ast.NodeKind.LABEL {
            return a^.member^.object^.label^.value == b^.member^.object^.label^.value && a^.member^.member == b^.member^.member
        }
    }
    return false
}

// Index of `variant` in an enum's variant list, or -1.
fn enum_variant_index(info ^EnumInfo, variant string) -> i64 {
    values = info^.values
    for i in range(0, len(values)) {
        if values[i] == variant { return i }
    }
    return -1
}

// when: subject validity, ErrorCode rules, duplicate cases, case/subject type agreement, enum
// variant and binding checks with payload bindings scoped to the case body, the empty default,
// and #strict exhaustiveness.
fn check_when_statement(checker ^TypeChecker, node ^ast.AstNode) {
    wd = node^.when_stmt
    subject = wd^.value

    // A bare struct or enum name is a type, not a value
    if subject^.kind == ast.NodeKind.LABEL && scope.scope_lookup(checker^.current_scope, subject^.label^.value) == nil {
        tn = subject^.label^.value
        if is_struct_name(checker, tn) {
            message = error_registry.registry_message_formatted("E3100", {tn})
            add_diagnostic_help(checker, "E3100", message, "use '${tn}{...}' or 'new(${tn})' to create an instance", subject^.tok.file, subject^.tok.line, subject^.tok.col)
            return
        }
        if is_enum_name(checker, tn) {
            message = error_registry.registry_message_formatted("E3100", {tn})
            add_diagnostic_help(checker, "E3100", message, "use '${tn}.VARIANT' to access an enum value", subject^.tok.file, subject^.tok.line, subject^.tok.col)
            return
        }
    }

    mut when_type = resolve_expression(checker, subject)
    if when_type^.kind == types.TypeKind.VOID {
        reject_void_in_context(checker, subject, when_type, "a when subject")
        when_type = checker^.pool^.type_unknown
    }
    if when_type^.kind == types.TypeKind.FLOAT {
        add_diagnostic(checker, "W2012", "'when' condition is a float; equality checks on floats are imprecise; prefer 'math.abs(x - y) < epsilon'", subject^.tok.file, subject^.tok.line, subject^.tok.col)
    }
    reject_multi_return_in_single_position(checker, subject)

    // Composite types are not valid subjects; skip the case type checks
    mut subject_valid = true
    wk = when_type^.kind
    if wk == types.TypeKind.STRUCT || wk == types.TypeKind.ARRAY || wk == types.TypeKind.MAP || wk == types.TypeKind.POINTER {
        message = fmt.sprintf("cannot use '%s' as a condition in a when statement; allowed types are integers, floats, string, char, bool, and enum", {shown_type(checker, when_type)})
        add_diagnostic(checker, "E3121", message, subject^.tok.file, subject^.tok.line, subject^.tok.col)
        subject_valid = false
    }

    // The program-wide ErrorCode enum is open: never exhaustive, never #strict
    mut errorcode_strict_rejected = false
    if subject_valid && when_type^.kind == types.TypeKind.ENUM && when_type^.name == "ErrorCode" {
        if wd^.is_strict {
            add_diagnostic(checker, "E3151", "'when err.code' cannot be #strict; ErrorCode is an open enum and can never be exhaustive", subject^.tok.file, subject^.tok.line, subject^.tok.col)
            errorcode_strict_rejected = true
        } otherwise {
            if wd^.default_body == nil {
                add_diagnostic(checker, "E3149", "'when err.code' must have a default branch; ErrorCode is an open enum and can never be exhaustive", subject^.tok.file, subject^.tok.line, subject^.tok.col)
            }
        }
    }

    // A case value that repeats an earlier one is dead code
    cases = wd^.cases
    // Each case body and the default run from the arena state before the `when`; the
    // state after it is the join of every branch
    arenas_before = checker^.arenas
    mut arenas_merged [ArenaLifetime] = {}
    mut has_merged_arenas bool = false
    for i in range(0, len(cases)) {
        values_i = cases[i].values
        for j in range(0, len(values_i)) {
            mut flagged = false
            for ei in range(0, i + 1) {
                if flagged { break }
                earlier_values = cases[ei].values
                mut limit = len(earlier_values)
                if ei == i { limit = j }
                for ej in range(0, limit) {
                    if when_case_values_equal(checker, values_i[j], earlier_values[ej]) || when_case_covered_by_range(checker, values_i[j], earlier_values[ej]) {
                        add_diagnostic(checker, "E2043", "duplicate case value in when statement", values_i[j]^.tok.file, values_i[j]^.tok.line, values_i[j]^.tok.col)
                        flagged = true
                        break
                    }
                }
            }
        }
    }

    mut subject_enum ^EnumInfo = nil
    if subject_valid && when_type^.kind == types.TypeKind.ENUM && when_type^.name != "" {
        subject_enum = find_enum(checker, when_type^.name)
    }

    for i in range(0, len(cases)) {
        values_i = cases[i].values
        for j in range(0, len(values_i)) {
            value_node = values_i[j]
            if value_node^.kind == ast.NodeKind.WHEN_PATTERN {
                pd = value_node^.when_pattern
                if subject_enum != nil {
                    pd^.enum_name = when_type^.name
                    vi = enum_variant_index(subject_enum, pd^.variant)
                    if vi < 0 {
                        message = fmt.sprintf("enum '%s' has no member '%s'", {when_type^.name, pd^.variant})
                        add_diagnostic(checker, "E3047", message, value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
                    } otherwise {
                        expected_bindings = len(subject_enum^.variant_payload_types[vi])
                        if expected_bindings != len(pd^.bindings) {
                            message = fmt.sprintf("wrong number of bindings for variant '%s'; expected %d, got %d", {pd^.variant, expected_bindings, len(pd^.bindings)})
                            add_diagnostic(checker, "E3116", message, value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
                        }
                    }
                }
                continue
            }
            if value_node^.kind == ast.NodeKind.IMPLICIT_ENUM {
                // `.VARIANT` resolves against the subject's enum
                if subject_enum != nil {
                    value_node^.implicit_enum^.resolved_enum = when_type^.name
                    if enum_variant_index(subject_enum, value_node^.implicit_enum^.variant) < 0 {
                        message = fmt.sprintf("enum '%s' has no member '%s'", {when_type^.name, value_node^.implicit_enum^.variant})
                        add_diagnostic(checker, "E3047", message, value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
                    }
                }
                continue
            }
            allow_range_use(checker, value_node)
            // A case value is checked as the subject's type: `is 300` on a u8 subject is out of range.
            // A range case is checked as a range.
            mut is_range_case = value_node^.kind == ast.NodeKind.RANGE_EXPR
            if value_node^.kind == ast.NodeKind.CALL_EXPR && value_node^.call^.function^.kind == ast.NodeKind.LABEL && value_node^.call^.function^.label^.value == "range" {
                is_range_case = true
            }
            if value_node^.kind == ast.NodeKind.LABEL {
                case_symbol = scope.scope_lookup(checker^.current_scope, value_node^.label^.value)
                if case_symbol != nil && case_symbol^.sym_type^.kind == types.TypeKind.RANGE { is_range_case = true }
            }
            mut case_type ^types.GrayType = nil
            // A `when` case may name a payload variant without its payload
            checker^.allows_payloadless_variant = true
            if is_range_case || !subject_valid {
                case_type = resolve_expression(checker, value_node)
            } otherwise {
                case_type = check_expression_as(checker, value_node, when_type)
            }
            checker^.allows_payloadless_variant = false
            if value_node^.kind == ast.NodeKind.LABEL && subject_valid && when_type^.kind != types.TypeKind.UNKNOWN && case_type^.kind == types.TypeKind.RANGE && (!is_int_kind(when_type^.kind) || !range_holds_integer(case_type, when_type)) {
                add_diagnostic(checker, "E3018", error_registry.registry_message_formatted("E3018", {shown_type(checker, when_type), shown_type(checker, case_type)}), value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
            }
            if case_type^.kind == types.TypeKind.RANGE { is_range_case = true }
            if subject_valid && !is_range_case && when_type^.kind != types.TypeKind.UNKNOWN && case_type^.kind != types.TypeKind.UNKNOWN {
                // An enum against a plain integer is a mismatch, as with ==
                enum_vs_int = (when_type^.kind == types.TypeKind.ENUM && is_int_kind(case_type^.kind)) || (is_int_kind(when_type^.kind) && case_type^.kind == types.TypeKind.ENUM)
                mut compatible = !enum_vs_int && types_assignable(checker, when_type, case_type)
                if !enum_vs_int && when_type^.kind == types.TypeKind.ENUM && case_type^.kind == types.TypeKind.STRING && enum_is_string(checker, when_type^.name) {
                    compatible = true
                }
                if !compatible {
                    message = fmt.sprintf("type mismatch in 'when'; comparing '%s' with '%s'", {shown_type(checker, when_type), shown_type(checker, case_type)})
                    add_diagnostic(checker, "E3018", message, value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
                }
            }
        }

        // Case body: a fresh scope holding the pattern bindings
        case_outer = checker^.current_scope
        case_scope = scope.scope_create(case_outer)
        checker^.current_scope = case_scope
        for j in range(0, len(values_i)) {
            value_node = values_i[j]
            if value_node^.kind != ast.NodeKind.WHEN_PATTERN || value_node^.when_pattern^.enum_name == "" || subject_enum == nil { continue }
            pd = value_node^.when_pattern
            vi = enum_variant_index(subject_enum, pd^.variant)
            if vi < 0 { continue }
            payload = subject_enum^.variant_payload_types[vi]
            mut bind_count = len(pd^.bindings)
            if len(payload) < bind_count { bind_count = len(payload) }
            // A pointer buried in the enum payload keeps the subject's lifetime origin
            // once destructured, so storing a binding where it outlives that origin is
            // still an escape
            subject_root = assignment_target_root_name(wd^.value)
            mut subject_symbol ^scope.Symbol = nil
            if subject_root != "" { subject_symbol = scope.scope_lookup(case_outer, subject_root) }
            for b in range(0, bind_count) {
                if pd^.bindings[b] != "_" {
                    shadowed_symbol = scope.scope_lookup(case_outer, pd^.bindings[b])
                    if shadowed_symbol != nil {
                        add_diagnostic(checker, "W2002", error_registry.registry_message_formatted("W2002", {"when binding", pd^.bindings[b], "${symbol_shadow_line(shadowed_symbol)}"}), value_node^.tok.file, value_node^.tok.line, value_node^.tok.col)
                    }
                }
                report_shadowed_function(checker, value_node, pd^.bindings[b], pd^.bindings[b])
                scope.scope_define(case_scope, pd^.bindings[b], checker_type_from_name(checker, payload[b]), false)
                binding_symbol = scope.scope_lookup_local(case_scope, pd^.bindings[b])
                if binding_symbol != nil { binding_symbol^.binding_line = value_node^.tok.line }
                // A payload read out of a value that holds a pointer to a const-declared
                // variable is such a pointer
                propagate_const_source(checker, binding_symbol, wd^.value)
                if subject_symbol != nil && binding_symbol != nil && subject_symbol^.field_origin_depth != 0 {
                    binding_symbol^.origin_depth = subject_symbol^.field_origin_depth
                    binding_symbol^.origin_name = subject_symbol^.field_origin_name
                }
            }
        }
        restore_arena_state(checker, arenas_before)
        check_block(checker, cases[i].body)
        if !has_merged_arenas {
            arenas_merged = checker^.arenas
            has_merged_arenas = true
        } otherwise {
            join_arena_state(checker, arenas_merged)
            arenas_merged = checker^.arenas
        }
        report_unused_in_scope(checker, case_scope)
        checker^.current_scope = case_outer
    }

    if wd^.default_body != nil {
        default_outer = checker^.current_scope
        checker^.current_scope = scope.scope_create(default_outer)
        restore_arena_state(checker, arenas_before)
        check_block(checker, wd^.default_body)
        if !has_merged_arenas {
            arenas_merged = checker^.arenas
            has_merged_arenas = true
        } otherwise {
            join_arena_state(checker, arenas_merged)
            arenas_merged = checker^.arenas
        }
        checker^.current_scope = default_outer
        // An empty default silently ignores unmatched values
        if len(wd^.default_body^.block^.stmts) == 0 {
            add_diagnostic(checker, "W3006", "empty default branch in when statement; unmatched values are silently ignored", wd^.default_body^.tok.file, wd^.default_body^.tok.line, wd^.default_body^.tok.col)
        }
    }

    // Settle the joined arena state. A `when` with no default (and not #strict) may match
    // nothing, so the state before it is also a possible outcome.
    if has_merged_arenas && !wd^.is_strict && wd^.default_body == nil {
        restore_arena_state(checker, arenas_before)
        join_arena_state(checker, arenas_merged)
        arenas_merged = checker^.arenas
    }
    if has_merged_arenas {
        restore_arena_state(checker, arenas_merged)
    } otherwise {
        restore_arena_state(checker, arenas_before)
    }

    // #strict exhaustiveness
    if wd^.is_strict && wd^.default_body == nil && !errorcode_strict_rejected {
        mut enum_name = ""
        if subject_enum != nil { enum_name = when_type^.name }
        // Otherwise infer the enum from the case values (Color.RED -> "Color")
        for_each wc in cases {
            for_each cv in wc.values {
                if enum_name != "" { break }
                if cv^.kind == ast.NodeKind.MEMBER_EXPR && cv^.member^.object^.kind == ast.NodeKind.LABEL && is_enum_name(checker, cv^.member^.object^.label^.value) {
                    enum_name = cv^.member^.object^.label^.value
                }
                if cv^.kind == ast.NodeKind.IMPLICIT_ENUM && cv^.implicit_enum^.resolved_enum != "" { enum_name = cv^.implicit_enum^.resolved_enum }
                if cv^.kind == ast.NodeKind.WHEN_PATTERN && cv^.when_pattern^.enum_name != "" { enum_name = cv^.when_pattern^.enum_name }
            }
        }
        if enum_name != "" {
            info = find_enum(checker, enum_name)
            if info != nil {
                variants = info^.values
                for vi in range(0, len(variants)) {
                    mut covered = false
                    for_each wc in cases {
                        for_each cv in wc.values {
                            if cv^.kind == ast.NodeKind.MEMBER_EXPR && cv^.member^.member == variants[vi] { covered = true }
                            if cv^.kind == ast.NodeKind.IMPLICIT_ENUM && cv^.implicit_enum^.variant == variants[vi] { covered = true }
                            if cv^.kind == ast.NodeKind.WHEN_PATTERN && cv^.when_pattern^.variant == variants[vi] { covered = true }
                            if cv^.kind == ast.NodeKind.INT_VALUE && cv^.int_value^.value == vi { covered = true }
                        }
                    }
                    if !covered {
                        message = fmt.sprintf("#strict when is not exhaustive; missing variant '%s.%s'", {enum_name, variants[vi]})
                        add_diagnostic(checker, "E3056", message, node^.tok.file, node^.tok.line, node^.tok.col)
                    }
                }
            }
        } otherwise {
            if when_type^.kind == types.TypeKind.BOOL {
                mut has_true = false
                mut has_false = false
                for_each wc in cases {
                    for_each cv in wc.values {
                        if cv^.kind == ast.NodeKind.BOOL_VALUE {
                            if cv^.bool_value^.value { has_true = true } otherwise { has_false = true }
                        }
                    }
                }
                if !has_true { add_diagnostic(checker, "E3189", error_registry.registry_message_formatted("E3189", {"true"}), node^.tok.file, node^.tok.line, node^.tok.col) }
                if !has_false { add_diagnostic(checker, "E3189", error_registry.registry_message_formatted("E3189", {"false"}), node^.tok.file, node^.tok.line, node^.tok.col) }
            } otherwise {
                add_diagnostic(checker, "E3190", error_registry.registry_message("E3190"), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
    }

    // Enum cases with neither #strict nor a default
    if !wd^.is_strict && wd^.default_body == nil {
        mut has_enum_case = false
        for_each wc in cases {
            for_each cv in wc.values {
                if cv^.kind == ast.NodeKind.IMPLICIT_ENUM || cv^.kind == ast.NodeKind.WHEN_PATTERN { has_enum_case = true }
                if cv^.kind == ast.NodeKind.MEMBER_EXPR && cv^.member^.object^.kind == ast.NodeKind.LABEL && is_enum_name(checker, cv^.member^.object^.label^.value) { has_enum_case = true }
            }
        }
        if has_enum_case {
            add_diagnostic(checker, "W3005", "when statement matches on enum values without #strict and no default; exhaustiveness is not checked", node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
}

fn enter_loop(checker ^TypeChecker, loop_node ^ast.AstNode) {
    if loop_node^.loop_label != "" && arrays.contains(checker^.loop_labels, loop_node^.loop_label) {
        add_diagnostic(checker, "E4042", error_registry.registry_message_formatted("E4042", {loop_node^.loop_label}), loop_node^.tok.file, loop_node^.tok.line, loop_node^.tok.col)
    }
    arrays.append(checker^.loop_labels, loop_node^.loop_label)
}

fn leave_loop(checker ^TypeChecker) {
    mut _ = arrays.remove_last(checker^.loop_labels)
}

fn check_break_or_continue(checker ^TypeChecker, node ^ast.AstNode) {
    loop_name = node^.loop_jump^.label
    if loop_name == "" {
        if len(checker^.loop_labels) == 0 {
            add_diagnostic(checker, "E2050", "break and continue can only be used inside a loop", node^.tok.file, node^.tok.line, node^.tok.col)
        }
        return
    }
    if arrays.contains(checker^.loop_labels, loop_name) { return }
    add_diagnostic(checker, "E4043", error_registry.registry_message_formatted("E4043", {loop_name}), node^.tok.file, node^.tok.line, node^.tok.col)
}

// True when a #json struct field of this type can be marshalled: a number,
// string, bool, #json struct, or a flat array of one of those.
fn json_field_type_supported(checker ^TypeChecker, type_name string) -> bool {
    field_type = checker_type_from_name(checker, type_name)
    if field_type^.kind == types.TypeKind.ARRAY {
        return field_type^.element_type != "" && !strings.contains(field_type^.element_type, "[") && json_field_type_supported(checker, field_type^.element_type)
    }
    if field_type^.kind == types.TypeKind.INT || field_type^.kind == types.TypeKind.UINT || field_type^.kind == types.TypeKind.FLOAT { return true }
    if type_name == "string" || type_name == "bool" { return true }
    if field_type^.kind == types.TypeKind.STRUCT {
        info = find_struct(checker, field_type^.name)
        return info != nil && info^.is_json
    }
    return false
}

// Struct declaration at statement level: not inside a function, the #json rules, then the
// struct-namespaced function bodies.
// True when the stdlib opaque type `name` belongs to a module the program imports.
// A use of a stdlib opaque type counts as a use of the module that owns it.
fn mark_type_module_used(checker ^TypeChecker, name string) {
    for_each owner in stdlib_opaque_modules(name) {
        mark_import_used(checker, owner)
    }
}

fn stdlib_opaque_type_available(checker ^TypeChecker, name string) -> bool {
    for_each owner in stdlib_opaque_modules(name) {
        if program_imports_module(checker, owner) { return true }
    }
    return false
}

// The module that owns a stdlib opaque type's bare name (Thread, Mutex, ...),
// or "" if `name` is not one. A type two modules share has an entry for each.
fn stdlib_opaque_modules(name string) -> [string] {
    when name {
        is "Arena" { return {"mem"} }
        is "Builder" { return {"strings"} }
        is "Thread" { return {"threads"} }
        is "Mutex" { return {"sync"} }
        is "SpinLock" { return {"atomic"} }
        is "Channel" { return {"channels"} }
        is "Socket", "Listener" { return {"net"} }
        is "Database" { return {"sqlite"} }
        is "Router" { return {"server"} }
        is "HttpRequest" { return {"server"} }
        is "HttpResponse" { return {"http", "server"} }
        is "ExecResult" { return {"os"} }
        is "FileInfo" { return {"io"} }
        is "UUID" { return {"uuid"} }
        default { return {} }
    }
}

// A user type name collides with a stdlib opaque type. Codegen maps these
// names to internal C types, so the conflict is real only when the owning module
// is imported. A name with no owning module (SourceLocation) is produced by a
// builtin with no import and stays reserved unconditionally.
fn check_stdlib_opaque_name_collision(checker ^TypeChecker, node ^ast.AstNode, name string) {
    // Enums a stdlib module exposes (io.OpenFlag, os.Platform) are reserved the
    // same way, only while the owning module is imported.
    if (name == "OpenFlag" && program_imports_module(checker, "io")) || (name == "Platform" && program_imports_module(checker, "os")) {
        add_diagnostic(checker, "E3099", error_registry.registry_message_formatted("E3099", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
        return
    }
    if !reserved.is_reserved_stdlib_struct_name(name) { return }
    owners = stdlib_opaque_modules(name)
    mut is_available = false
    for_each owner in owners {
        if program_imports_module(checker, owner) { is_available = true }
    }
    if len(owners) == 0 || is_available {
        add_diagnostic(checker, "E3099", error_registry.registry_message_formatted("E3099", {name}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

fn check_struct_declaration(checker ^TypeChecker, node ^ast.AstNode) {
    sd = node^.struct_decl
    display = struct_display_name_for(node)
    for_each declared_field in sd^.struct_fields {
        reject_error_in_container(checker, node, declared_field.type_name)
        check_fixed_array_length(checker, declared_field.default_value, declared_field.type_name, declared_field.default_value)
        warn_short_fixed_array(checker, declared_field.default_value, declared_field.type_name, "field '${declared_field.name}'", declared_field.default_value)
    }
    // A field default is checked as the field's own type, as a parameter default is
    declared_info = find_struct(checker, sd^.name)
    if declared_info != nil {
        for field_index in range(0, len(sd^.struct_fields)) {
            field_default = sd^.struct_fields[field_index].default_value
            if field_default == nil || field_index >= len(declared_info^.field_types) { continue }
            field_type = declared_info^.field_types[field_index]
            default_type = check_expression_as(checker, field_default, field_type)
            if default_type^.kind != types.TypeKind.UNKNOWN && field_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, field_type, default_type) && default_type^.kind != types.TypeKind.NIL_TYPE {
                add_diagnostic(checker, "E3175", error_registry.registry_message_formatted("E3175", {sd^.struct_fields[field_index].name, shown_type(checker, field_type), shown_type(checker, default_type)}), field_default^.tok.file, field_default^.tok.line, field_default^.tok.col)
            }
        }
    }
    check_stdlib_opaque_name_collision(checker, node, display)
    file = node^.tok.file
    line = node^.tok.line
    col = node^.tok.col
    if checker^.function_depth > 0 {
        add_diagnostic(checker, "E2053", error_registry.registry_message_formatted("E2053", {"struct", display}), file, line, col)
    }
    if sd^.is_json {
        if !program_imports_module(checker, "json") {
            add_diagnostic(checker, "E6012", error_registry.registry_message_formatted("E6012", {display}), file, line, col)
        }
        // Within one struct, fields are all tagged or all untagged
        mut dialect_set = false
        mut dialect_tagged = false
        mut dialect_field = ""
        struct_fields = sd^.struct_fields
        for index in range(0, len(struct_fields)) {
            field = struct_fields[index]
            mut has_tag = field.json_tag != ""
            if has_tag {
                raw_tag = field.json_tag
                prefix = "json:\""
                mut field_key = ""
                mut key_valid = false
                if len(raw_tag) > len(prefix) + 1 && strings.starts_with(raw_tag, prefix) && strings.char_at(raw_tag, len(raw_tag) - 1) == '"' {
                    field_key = strings.slice(raw_tag, len(prefix), len(raw_tag) - 1)
                    key_valid = true
                    for key_index in range(0, len(field_key)) {
                        key_character = strings.char_at(field_key, key_index)
                        if key_character == '"' || key_character == '\\' || cast(key_character, i64) < FIRST_PRINTABLE_CHARACTER { key_valid = false }
                    }
                }
                if !key_valid {
                    add_diagnostic(checker, "E3170", error_registry.registry_message_formatted("E3170", {raw_tag, display, field.name}), file, line, col)
                    has_tag = false
                } otherwise {
                    sd^.struct_fields[index].json_tag = field_key
                }
            }
            if !dialect_set {
                dialect_set = true
                dialect_tagged = has_tag
                dialect_field = field.name
            } or has_tag != dialect_tagged {
                this_state = "isn't tagged"
                if has_tag { this_state = "is tagged" }
                first_state = "isn't tagged"
                if dialect_tagged { first_state = "is tagged" }
                add_diagnostic(checker, "E3171", error_registry.registry_message_formatted("E3171", {display, field.name, this_state, dialect_field, first_state}), file, line, col)
            }
            field_type_name = field.type_name
            if strings.starts_with(field_type_name, "func") {
                add_diagnostic(checker, "E3103", error_registry.registry_message_formatted("E3103", {display, field.name}), file, line, col)
            }
            if field.default_value != nil {
                add_diagnostic(checker, "E3109", error_registry.registry_message_formatted("E3109", {display, field.name}), file, line, col)
            }
            if is_enum_name(checker, field_type_name) && enum_is_tagged(checker, field_type_name) {
                add_diagnostic(checker, "E3173", error_registry.registry_message_formatted("E3173", {display, field.name, enum_display_name(checker, field_type_name)}), file, line, col)
            }
            if !strings.starts_with(field_type_name, "func") && !json_field_type_supported(checker, field_type_name) && !is_enum_name(checker, field_type_name) {
                add_diagnostic(checker, "E3140", error_registry.registry_message_formatted("E3140", {display, field.name, field_type_name}), file, line, col)
            }
        }
        // Two fields serialize under the same JSON key
        struct_fields_after = sd^.struct_fields
        for left_index in range(0, len(struct_fields_after)) {
            left_field = struct_fields_after[left_index]
            mut left_key = left_field.name
            if left_field.json_tag != "" { left_key = left_field.json_tag }
            for right_index in range(left_index + 1, len(struct_fields_after)) {
                right_field = struct_fields_after[right_index]
                mut right_key = right_field.name
                if right_field.json_tag != "" { right_key = right_field.json_tag }
                if left_key == right_key {
                    add_diagnostic(checker, "E3172", error_registry.registry_message_formatted("E3172", {display, left_field.name, right_field.name, left_key}), file, line, col)
                }
            }
        }
        for_each struct_function in sd^.funcs {
            function_node = struct_function.func_decl
            if function_node != nil && function_node^.kind == ast.NodeKind.FUNC_DECL {
                add_diagnostic(checker, "E3104", error_registry.registry_message_formatted("E3104", {display, func_display_name_for(function_node)}), function_node^.tok.file, function_node^.tok.line, function_node^.tok.col)
            }
        }
    }
    // struct-namespaced function bodies
    checker^.current_struct_name = sd^.name
    for_each struct_function in sd^.funcs {
        function_node = struct_function.func_decl
        if function_node != nil && function_node^.kind == ast.NodeKind.FUNC_DECL {
            check_statement(checker, function_node)
        }
    }
    checker^.current_struct_name = ""
}

fn check_statement(checker ^TypeChecker, node ^ast.AstNode) {
    literal_start = len(checker^.pending_literals)
    check_statement_kind(checker, node)
    flush_pending_literals(checker, literal_start)
}

// Gives every literal expression read since `start` without taking a type its default type: the
// latest first, so an enclosing expression is typed as a whole before any part of it is.
fn flush_pending_literals(checker ^TypeChecker, start i64) {
    mut index = len(checker^.pending_literals) - 1
    as_long_as index >= start {
        pending = checker^.pending_literals[index]
        if !pending^.is_literal_typed {
            // the default type, taken without a second range check
            mut taken = checker^.pool^.type_i64
            if folding.literal_expression_is_decimal(pending) { taken = checker^.pool^.type_f64 }
            literal_take_type(checker, pending, taken)
        }
        index = index - 1
    }
    mut kept [^ast.AstNode] = {}
    for position in range(0, start) { arrays.append(kept, checker^.pending_literals[position]) }
    checker^.pending_literals = kept
}

fn check_statement_kind(checker ^TypeChecker, node ^ast.AstNode) {
    if node == nil { return }
    // Executable statements are not allowed at file scope
    if checker^.function_depth == 0 {
        is_executable = node^.kind == ast.NodeKind.ASSIGN_STMT || node^.kind == ast.NodeKind.IF_STMT || node^.kind == ast.NodeKind.FOR_STMT || node^.kind == ast.NodeKind.FOR_EACH_STMT || node^.kind == ast.NodeKind.WHILE_STMT || node^.kind == ast.NodeKind.LOOP_STMT || node^.kind == ast.NodeKind.EXPR_STMT || node^.kind == ast.NodeKind.RETURN_STMT || node^.kind == ast.NodeKind.BREAK_STMT || node^.kind == ast.NodeKind.CONTINUE_STMT || node^.kind == ast.NodeKind.WHEN_STMT
        if is_executable {
            add_diagnostic(checker, "E2056", error_registry.registry_message("E2056"), node^.tok.file, node^.tok.line, node^.tok.col)
        }
    }
    #strict
    when node^.kind {
        is ast.NodeKind.FUNC_DECL { check_function_declaration(checker, node) }
        is ast.NodeKind.STRUCT_DECL { check_struct_declaration(checker, node) }
        is ast.NodeKind.IMPORT_STMT {
            if checker^.function_depth > 0 {
                add_diagnostic(checker, "E2036", error_registry.registry_message("E2036"), node^.tok.file, node^.tok.line, node^.tok.col)
            }
        }
        is ast.NodeKind.ENUM_DECL {
            if checker^.function_depth > 0 {
                add_diagnostic(checker, "E2053", error_registry.registry_message_formatted("E2053", {"enum", enum_display_name_for(node)}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            check_stdlib_opaque_name_collision(checker, node, enum_display_name_for(node))
            // An explicit variant value is a C constant, so it is checked as any
            // expression would be (unsafe use, undefined names) and may hold no
            // runtime call.
            for_each variant in node^.enum_decl^.values {
                variant_value = variant.value
                if variant_value == nil || variant_value^.kind == ast.NodeKind.STRING_VALUE { continue }
                if folding.is_literal_expression(variant_value) && !folding.literal_expression_is_decimal(variant_value) {
                    check_expression_as(checker, variant_value, checker^.pool^.type_i64)
                } otherwise {
                    resolve_expression(checker, variant_value)
                }
                if expression_contains_call(variant_value) {
                    add_diagnostic(checker, "E5040", error_registry.registry_message("E5040"), variant_value^.tok.file, variant_value^.tok.line, variant_value^.tok.col)
                }
            }
            // A tagged variant's payload type must name a type, at any depth
            for_each variant in node^.enum_decl^.values {
                for_each payload_type in variant.payload_types {
                    undefined_payload = undefined_type_leaf(checker, payload_type)
                    if undefined_payload != "" {
                        add_diagnostic(checker, "E4016", error_registry.registry_message_formatted("E4016", {undefined_payload}), node^.tok.file, node^.tok.line, node^.tok.col)
                    }
                    reject_error_in_container(checker, node, payload_type)
                }
            }
        }
        is ast.NodeKind.ALIAS_DECL {
            if checker^.function_depth > 0 {
                add_diagnostic(checker, "E2053", error_registry.registry_message_formatted("E2053", {"alias", node^.alias_decl^.name}), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            warn_if_type_name_deprecated(checker, node, node^.alias_decl^.target_type, "")
            reject_error_in_container(checker, node, node^.alias_decl^.target_type)
            reject_void_type(checker, node, node^.alias_decl^.target_type, "an alias target")
        }
        is ast.NodeKind.VAR_DECL { check_variable_declaration(checker, node) }
        is ast.NodeKind.USING_STMT {
            if checker^.function_depth > 0 {
                for_each used_module in node^.using_stmt^.modules { arrays.append(checker^.using_modules, resolve_import_alias(checker, used_module)) }
            }
        }
        is ast.NodeKind.ASSIGN_STMT {
            // A write to a whole variable is not a read of it, so it does not count toward a warning
            written_name = whole_variable_write_name(node^.assign^.target)
            written_was_used = symbol_was_used_before_write(checker, written_name)
            check_assign_statement(checker, node)
            restore_symbol_used_flag(checker, written_name, written_was_used)
        }
        is ast.NodeKind.RETURN_STMT { check_return_statement(checker, node) }
        is ast.NodeKind.EXPR_STMT { check_expression_statement(checker, node) }
        is ast.NodeKind.ENSURE_STMT {
            deferred_expression = node^.ensure_stmt^.expr
            deferred_type = resolve_expression(checker, deferred_expression)
            check_discarded_call_result(checker, deferred_expression, deferred_expression, deferred_type)
            if deferred_expression != nil && deferred_expression^.kind != ast.NodeKind.CALL_EXPR {
                add_diagnostic(checker, "E3039", error_registry.registry_message("E3039"), node^.tok.file, node^.tok.line, node^.tok.col)
            }
            // `ensure mem.destroy(a)` marks the destroy pending rather than applying it
            if deferred_expression != nil && deferred_expression^.kind == ast.NodeKind.CALL_EXPR { apply_ensure_mem_call(checker, deferred_expression, node) }
        }
        is ast.NodeKind.IF_STMT { check_if_statement(checker, node) }
        is ast.NodeKind.FOR_STMT { check_for_statement(checker, node) }
        is ast.NodeKind.FOR_EACH_STMT { check_for_each_statement(checker, node) }
        is ast.NodeKind.WHILE_STMT { check_while_statement(checker, node) }
        is ast.NodeKind.LOOP_STMT { check_loop_statement(checker, node) }
        is ast.NodeKind.WHEN_STMT { check_when_statement(checker, node) }
        is ast.NodeKind.BREAK_STMT { check_break_or_continue(checker, node) }
        is ast.NodeKind.CONTINUE_STMT { check_break_or_continue(checker, node) }
        is ast.NodeKind.BLOCK_STMT {
            // An unsafe block opens its own scope; the parser also wraps desugared declarations in plain blocks, which must not
            outer_scope = checker^.current_scope
            if node^.block^.is_unsafe { checker^.current_scope = scope.scope_create(outer_scope) }
            check_block(checker, node)
            if node^.block^.is_unsafe { report_unused_in_scope(checker, checker^.current_scope) }
            checker^.current_scope = outer_scope
        }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
        ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

fn check_block(checker ^TypeChecker, node ^ast.AstNode) {
    if node == nil || node^.kind != ast.NodeKind.BLOCK_STMT { return }
    if node^.block^.is_unsafe { checker^.unsafe_depth = checker^.unsafe_depth + 1 }
    check_block_statements(checker, node)
    if node^.block^.is_unsafe { checker^.unsafe_depth = checker^.unsafe_depth - 1 }
}

fn check_block_statements(checker ^TypeChecker, node ^ast.AstNode) {
    mut seen_return = false
    mut index i64 = 0
    for_each statement in node^.block^.stmts {
        // Unreachable code after a return (warn once per block)
        if seen_return && statement != nil {
            add_diagnostic(checker, "W2003", error_registry.registry_message("W2003"), statement^.tok.file, statement^.tok.line, statement^.tok.col)
            break
        }
        if index == 1 { check_or_default_fallbacks(checker, node) }
        check_statement(checker, statement)
        if statement != nil && statement^.kind == ast.NodeKind.RETURN_STMT { seen_return = true }
        index += 1
    }
    mark_elided_array_copies(checker, node)
    check_destructuring_arity(checker, node)
}

// `or_default` desugars to `_tmp = call(); if _tmp.verr != nil { _tmp.v0 = f0; ... }; x = _tmp.v0`.
// Once the temporary is declared, the fallbacks are checked against the call's non-error
// values: one per value, each of the slot's type. A bad guard is emptied
// so the assignments do not report a second time.
fn check_or_default_fallbacks(checker ^TypeChecker, block ^ast.AstNode) {
    stmts = block^.block^.stmts
    if len(stmts) < 2 { return }
    temporary = stmts[0]
    guard = stmts[1]
    if temporary == nil || temporary^.kind != ast.NodeKind.VAR_DECL || !strings.starts_with(temporary^.var_decl^.name, ast.SYNTH_OR_DEFAULT) || guard == nil || guard^.kind != ast.NodeKind.IF_STMT { return }
    temporary_symbol = scope.scope_lookup_local(checker^.current_scope, temporary^.var_decl^.name)
    // A call that is not fallible is reported as an error by the declaration
    if temporary_symbol == nil || len(temporary_symbol^.ret_types) < 2 { return }
    return_count = len(temporary_symbol^.ret_types)
    if temporary_symbol^.ret_types[return_count - 1]^.kind != types.TypeKind.ERROR { return }
    assignments = guard^.if_stmt^.consequence
    value_count = return_count - 1
    fallback_count = len(assignments^.block^.stmts)
    if fallback_count != value_count {
        mut report_at = temporary
        if fallback_count > 0 { report_at = assignments^.block^.stmts[0] }
        add_diagnostic(checker, "E3207", error_registry.registry_message_formatted("E3207", {"${fallback_count}", "${value_count}"}), report_at^.tok.file, report_at^.tok.line, report_at^.tok.col)
        assignments^.block^.stmts = {}
        return
    }
    for position in range(0, fallback_count) {
        fallback = assignments^.block^.stmts[position]^.assign^.value
        slot_type = temporary_symbol^.ret_types[position]
        mut fallback_type = checker^.pool^.type_unknown
        if slot_type^.distinct_name != "" {
            fallback_type = check_expression_as(checker, fallback, slot_type)
        } otherwise {
            fallback_type = resolve_expression(checker, fallback)
        }
        if fallback_type^.kind != types.TypeKind.UNKNOWN && !types_assignable(checker, slot_type, fallback_type) {
            add_diagnostic(checker, "E3208", error_registry.registry_message_formatted("E3208", {shown_type(checker, fallback_type), shown_type(checker, slot_type)}), fallback^.tok.file, fallback^.tok.line, fallback^.tok.col)
            assignments^.block^.stmts = {}
            return
        }
    }
}

// The name a call is spelled with in an arity message.
fn called_function_name(call_function ^ast.AstNode) -> string {
    if call_function^.kind == ast.NodeKind.LABEL { return call_function^.label^.value }
    if call_function^.kind == ast.NodeKind.MEMBER_EXPR && call_function^.member^.member != "" { return call_function^.member^.member }
    return "function"
}

// A desugared multi-variable declaration
// (`_gray_tmpN = call(); a = _gray_tmpN.v0; ...`) or `or_return` binding
// (`_gray_orN = call(); if guard {...}; a = _gray_orN.v0; ...`) binds as many
// variables as the call returns values.
fn check_destructuring_arity(checker ^TypeChecker, node ^ast.AstNode) {
    stmts = node^.block^.stmts
    if len(stmts) < 2 { return }
    first = stmts[0]
    if first == nil || first^.kind != ast.NodeKind.VAR_DECL || first^.var_decl^.value == nil || first^.var_decl^.value^.kind != ast.NodeKind.CALL_EXPR { return }
    name = first^.var_decl^.name
    temporary_symbol = scope.scope_lookup_local(checker^.current_scope, name)
    if temporary_symbol == nil || len(temporary_symbol^.ret_types) == 0 { return }
    function_name = called_function_name(first^.var_decl^.value^.call^.function)
    return_count = len(temporary_symbol^.ret_types)
    if strings.starts_with(name, ast.SYNTH_TMP) {
        variable_count = len(stmts) - 1
        if variable_count < return_count {
            add_diagnostic(checker, "E3183", error_registry.registry_message_formatted("E3183", {function_name, "${return_count}", "${variable_count}"}), first^.tok.file, first^.tok.line, first^.tok.col)
        }
        return
    }
    if !strings.starts_with(name, ast.SYNTH_OR) || len(stmts) < 3 || return_count < 2 || temporary_symbol^.ret_types[return_count - 1]^.kind != types.TypeKind.ERROR { return }
    non_error_count = return_count - 1
    variable_count = len(stmts) - 2
    first_binding = stmts[2]
    discard_all = variable_count == 1 && first_binding != nil && first_binding^.kind == ast.NodeKind.VAR_DECL && first_binding^.var_decl^.name == "_"
    if discard_all { return }
    if variable_count == 1 && non_error_count > 1 {
        add_diagnostic(checker, "E3040", error_registry.registry_message_formatted("E3040", {function_name, "${non_error_count}", function_name}), first^.tok.file, first^.tok.line, first^.tok.col)
    } or variable_count < non_error_count {
        add_diagnostic(checker, "E3183", error_registry.registry_message_formatted("E3183", {function_name, "${non_error_count}", "${variable_count}"}), first^.tok.file, first^.tok.line, first^.tok.col)
    } or variable_count > non_error_count {
        add_diagnostic(checker, "E3006", error_registry.registry_message_formatted("E3006", {"${non_error_count}", "${variable_count}"}), first^.tok.file, first^.tok.line, first^.tok.col)
    }
}

// True when the program imported the stdlib module `name`.
fn program_imports_module(checker ^TypeChecker, name string) -> bool {
    for_each import_entry in checker^.imports {
        if import_entry.mod_name == name { return true }
    }
    return false
}

// Registers the stdlib struct types that are visible only to programs that
// import their module (and SourceLocation, which `here()` always returns).
fn register_stdlib_structs(checker ^TypeChecker) {
    pool = checker^.pool
    register_struct(checker, "SourceLocation", "SourceLocation", {"file", "line", "column"}, {pool^.type_string, pool^.type_i64, pool^.type_i64})
    headers = types.type_from_name(pool, "map[string:string]")
    if program_imports_module(checker, "server") || program_imports_module(checker, "http") {
        register_struct(checker, "HttpResponse", "HttpResponse", {"status", "body", "headers"}, {pool^.type_i64, pool^.type_string, headers})
    }
    if program_imports_module(checker, "server") {
        register_struct(checker, "HttpRequest", "HttpRequest", {"method", "path", "body", "query", "headers", "params"}, {pool^.type_string, pool^.type_string, pool^.type_string, headers, headers, headers})
    }
    if program_imports_module(checker, "uuid") {
        register_struct(checker, "UUID", "UUID", {"value"}, {pool^.type_string})
    }
    if program_imports_module(checker, "io") {
        register_struct(checker, "FileInfo", "FileInfo", {"size", "mode", "mod_time", "is_dir", "is_file", "is_symlink"}, {pool^.type_i64, pool^.type_i64, pool^.type_i64, pool^.type_bool, pool^.type_bool, pool^.type_bool})
    }
    if program_imports_module(checker, "os") {
        register_struct(checker, "ExecResult", "ExecResult", {"exit_code", "stdout", "stderr", "signal"}, {pool^.type_i64, pool^.type_string, pool^.type_string, pool^.type_i64})
    }
    // Enums a stdlib module exposes: reachable as `module.VARIANT` and `EnumName.VARIANT`.
    mut no_payloads [[string]] = {}
    if program_imports_module(checker, "io") && find_enum(checker, "OpenFlag") == nil {
        register_enum(checker, "OpenFlag", "OpenFlag", false, {"O_RDONLY", "O_WRONLY", "O_RDWR"}, no_payloads, false, false)
    }
    if program_imports_module(checker, "os") && find_enum(checker, "Platform") == nil {
        register_enum(checker, "Platform", "Platform", false, {"MAC_OS", "LINUX", "WINDOWS", "OTHER"}, no_payloads, false, false)
    }
}

// Whole-program entry point. Runs the declaration-registration passes, then
// checks every top-level function body and variable declaration, and returns
// the checker holding the accumulated diagnostics. Only the entry file's
// declarations are checked: imported modules are not yet merged in.
// Re-checks every generic function body once per recorded instantiation, with
// its type parameters bound to that instantiation's types: the unbound walk
// treats them as unknown, so operations the concrete type does not support
// slip through it. Errors that fire only inside an instantiation get a
// companion error at the call that asked for it. Repeats until no new
// instantiation appears, which covers a body forwarding its type parameters
// to another generic function.
fn recheck_generic_instantiations(checker ^TypeChecker, program ^ast.AstNode) {
    mut found_new = true
    mut cursors map[string:i64] = {:}
    for found_new == true {
        found_new = false
        mut candidates [^ast.AstNode] = {}
        mut candidate_owners [string] = {}
        for_each outer_stmt in program^.program^.stmts {
            if outer_stmt^.kind == ast.NodeKind.FUNC_DECL {
                arrays.append(candidates, outer_stmt)
                arrays.append(candidate_owners, "")
            } or outer_stmt^.kind == ast.NodeKind.STRUCT_DECL {
                for_each struct_member in outer_stmt^.struct_decl^.funcs {
                    arrays.append(candidates, struct_member.func_decl)
                    arrays.append(candidate_owners, outer_stmt^.struct_decl^.name)
                }
            }
        }
        for candidate_index in range(0, len(candidates)) {
            statement = candidates[candidate_index]
            function_data = statement^.func_decl
            mut sig_name = function_data^.name
            if candidate_owners[candidate_index] != "" { sig_name = "${candidate_owners[candidate_index]}_${function_data^.name}" }
            signature = find_func(checker, sig_name)
            if signature == nil || !signature^.is_generic { continue }
            mut cursor i64 = 0
            if maps.contains_key(cursors, sig_name) { cursor = cursors[sig_name] }
            for cursor < len(signature^.instantiations) {
                found_new = true
                concrete = signature^.instantiations[cursor]
                call_site = signature^.instantiation_calls[cursor]
                cursor += 1
                before = checker^.diagnostics
                checker^.suppress_type_writes = true
                saved_struct_name = checker^.current_struct_name
                checker^.current_struct_name = candidate_owners[candidate_index]
                check_function_declaration_bound(checker, statement, concrete)
                checker^.current_struct_name = saved_struct_name
                checker^.suppress_type_writes = false
                after = checker^.diagnostics
                // keep only diagnostics the unbound walk did not already report
                mut kept [Diagnostic] = before
                mut new_errors i64 = 0
                for index in range(len(before), len(after)) {
                    d = after[index]
                    mut seen = false
                    for_each existing in kept {
                        if existing.code == d.code && existing.file == d.file && existing.line == d.line && existing.col == d.col && existing.message == d.message { seen = true }
                    }
                    if seen { continue }
                    arrays.append(kept, d)
                    if strings.starts_with(d.code, "E") { new_errors += 1 }
                }
                checker^.diagnostics = kept
                if new_errors > 0 && call_site != nil {
                    bindings = ast.generic_bindings_init(function_data, concrete)
                    mut described [string] = {}
                    for i in range(0, len(bindings.names)) {
                        arrays.append(described, "${bindings.names[i]} = ${bindings.types[i]}")
                    }
                    message = fmt.sprintf("in instantiation of generic function '%s' with %s", {function_data^.name, strings.join(described, ", ")})
                    add_diagnostic(checker, "E3058", message, call_site^.tok.file, call_site^.tok.line, call_site^.tok.col)
                }
            }
            cursors[sig_name] = cursor
        }
    }
}

// --- Keyword alias consistency ---

// The spelling that first established the file's dialect for one alias family.
// `dialect` is 0 for the canonical spelling and 1 for the alias; the two words of
// a joint pair (when/is vs switch/case, or/otherwise vs elif/else) share one
// tracker, so crossing them is a mix.
const AliasFirst struct {
    form string
    dialect i64
    line i64
    col i64
}

const AliasState struct {
    loop_form ^AliasFirst
    branch ^AliasFirst
    not_in_form ^AliasFirst
    function ^AliasFirst
    match ^AliasFirst
    ensure_form ^AliasFirst
}

fn alias_state_create() -> ^AliasState {
    state = new(AliasState)
    state^.loop_form = new(AliasFirst)
    state^.branch = new(AliasFirst)
    state^.not_in_form = new(AliasFirst)
    state^.function = new(AliasFirst)
    state^.match = new(AliasFirst)
    state^.ensure_form = new(AliasFirst)
    return state
}

fn note_alias_form(checker ^TypeChecker, slot ^AliasFirst, form string, canonical string, alias_form string, line i64, col i64, file string) {
    mut dialect i64 = 0
    if form == canonical {
        dialect = 0
    } or form == alias_form {
        dialect = 1
    } otherwise {
        return
    }
    if slot^.form == "" {
        slot^.form = form
        slot^.dialect = dialect
        slot^.line = line
        slot^.col = col
    } or slot^.dialect != dialect {
        add_diagnostic(checker, "E2088", error_registry.registry_message_formatted("E2088", {form, slot^.form, "${slot^.line}"}), file, line, col)
    }
}

fn check_alias_block(checker ^TypeChecker, block ^ast.AstNode, state ^AliasState, file string) {
    if block == nil || block^.kind != ast.NodeKind.BLOCK_STMT { return }
    for_each statement in block^.block^.stmts {
        check_alias_walk(checker, statement, state, file)
    }
}

// Scans an expression tree for the !in / not_in membership operator.
fn check_alias_expression(checker ^TypeChecker, expression ^ast.AstNode, state ^AliasState, file string) {
    if expression == nil { return }
    #strict
    when expression^.kind {
        is ast.NodeKind.INFIX_EXPR {
            if expression^.infix^.op == token.TokenKind.NOT_IN {
                note_alias_form(checker, state^.not_in_form, expression^.tok.literal, "not_in", "!in", expression^.tok.line, expression^.tok.col, file)
            }
            check_alias_expression(checker, expression^.infix^.left, state, file)
            check_alias_expression(checker, expression^.infix^.right, state, file)
        }
        is ast.NodeKind.PREFIX_EXPR { check_alias_expression(checker, expression^.prefix^.right, state, file) }
        is ast.NodeKind.POSTFIX_EXPR { check_alias_expression(checker, expression^.postfix^.left, state, file) }
        is ast.NodeKind.CALL_EXPR {
            check_alias_expression(checker, expression^.call^.function, state, file)
            for_each arg in expression^.call^.args {
                check_alias_expression(checker, arg, state, file)
            }
        }
        is ast.NodeKind.INDEX_EXPR {
            check_alias_expression(checker, expression^.index_data^.left, state, file)
            check_alias_expression(checker, expression^.index_data^.index_expr, state, file)
        }
        is ast.NodeKind.MEMBER_EXPR { check_alias_expression(checker, expression^.member^.object, state, file) }
        is ast.NodeKind.CAST_EXPR { check_alias_expression(checker, expression^.cast_data^.value, state, file) }
        is ast.NodeKind.RANGE_EXPR {
            check_alias_expression(checker, expression^.range_expr^.start_expr, state, file)
            check_alias_expression(checker, expression^.range_expr^.end_expr, state, file)
            check_alias_expression(checker, expression^.range_expr^.step, state, file)
        }
        is ast.NodeKind.ARRAY_VALUE {
            for_each element in expression^.array_value^.elements {
                check_alias_expression(checker, element, state, file)
            }
        }
        is ast.NodeKind.MAP_VALUE {
            for_each key in expression^.map_value^.keys {
                check_alias_expression(checker, key, state, file)
            }
            for_each value in expression^.map_value^.values {
                check_alias_expression(checker, value, state, file)
            }
        }
        is ast.NodeKind.STRUCT_VALUE {
            for_each value in expression^.struct_value^.field_values {
                check_alias_expression(checker, value, state, file)
            }
        }
        is ast.NodeKind.INTERPOLATED_STRING {
            for_each part in expression^.interp_string^.parts {
                check_alias_expression(checker, part, state, file)
            }
        }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE, ast.NodeKind.NIL_VALUE, ast.NodeKind.NEW_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.VAR_DECL, ast.NodeKind.ASSIGN_STMT, ast.NodeKind.RETURN_STMT,
        ast.NodeKind.ENSURE_STMT, ast.NodeKind.EXPR_STMT, ast.NodeKind.BLOCK_STMT, ast.NodeKind.IF_STMT,
        ast.NodeKind.WHEN_STMT, ast.NodeKind.FOR_STMT, ast.NodeKind.FOR_EACH_STMT, ast.NodeKind.WHILE_STMT,
        ast.NodeKind.LOOP_STMT, ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT,
        ast.NodeKind.FUNC_DECL, ast.NodeKind.IMPORT_STMT, ast.NodeKind.USING_STMT,
        ast.NodeKind.STRUCT_DECL, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL,
        ast.NodeKind.MODULE_DECL, ast.NodeKind.PROGRAM {}
    }
}

fn check_alias_walk(checker ^TypeChecker, node ^ast.AstNode, state ^AliasState, file string) {
    if node == nil { return }
    #strict
    when node^.kind {
        is ast.NodeKind.WHILE_STMT {
            note_alias_form(checker, state^.loop_form, node^.tok.literal, "as_long_as", "while", node^.tok.line, node^.tok.col, file)
            check_alias_expression(checker, node^.while_stmt^.condition, state, file)
            check_alias_block(checker, node^.while_stmt^.body, state, file)
        }
        is ast.NodeKind.IF_STMT {
            // 'or'/'elif' arrives as a nested if node whose own token is the branch
            // keyword; a leading 'if' matches neither and is skipped.
            note_alias_form(checker, state^.branch, node^.tok.literal, "or", "elif", node^.tok.line, node^.tok.col, file)
            // The final branch shares the tracker: 'elif' must close with 'else',
            // 'or' with 'otherwise'.
            if node^.if_stmt^.alternative != nil && node^.if_stmt^.else_token.line > 0 {
                else_token = node^.if_stmt^.else_token
                note_alias_form(checker, state^.branch, else_token.literal, "otherwise", "else", else_token.line, else_token.col, file)
            }
            check_alias_expression(checker, node^.if_stmt^.condition, state, file)
            check_alias_block(checker, node^.if_stmt^.consequence, state, file)
            if node^.if_stmt^.alternative != nil {
                check_alias_walk(checker, node^.if_stmt^.alternative, state, file)
            }
        }
        is ast.NodeKind.BLOCK_STMT { check_alias_block(checker, node, state, file) }
        is ast.NodeKind.FOR_STMT {
            check_alias_expression(checker, node^.for_stmt^.iterable, state, file)
            check_alias_block(checker, node^.for_stmt^.body, state, file)
        }
        is ast.NodeKind.FOR_EACH_STMT {
            check_alias_expression(checker, node^.for_each_stmt^.collection, state, file)
            check_alias_block(checker, node^.for_each_stmt^.body, state, file)
        }
        is ast.NodeKind.LOOP_STMT { check_alias_block(checker, node^.loop_stmt^.body, state, file) }
        is ast.NodeKind.FUNC_DECL {
            note_alias_form(checker, state^.function, node^.tok.literal, "do", "fn", node^.tok.line, node^.tok.col, file)
            check_alias_block(checker, node^.func_decl^.body, state, file)
        }
        is ast.NodeKind.STRUCT_DECL {
            // Struct functions are declared with 'do'/'fn' too.
            for_each struct_function in node^.struct_decl^.funcs {
                check_alias_walk(checker, struct_function.func_decl, state, file)
            }
        }
        is ast.NodeKind.WHEN_STMT {
            note_alias_form(checker, state^.match, node^.tok.literal, "when", "switch", node^.tok.line, node^.tok.col, file)
            check_alias_expression(checker, node^.when_stmt^.value, state, file)
            // Case keywords share the tracker: 'switch' pairs with 'case', 'when' with 'is'.
            for_each when_case in node^.when_stmt^.cases {
                keyword = when_case.keyword_token
                note_alias_form(checker, state^.match, keyword.literal, "is", "case", keyword.line, keyword.col, file)
                check_alias_block(checker, when_case.body, state, file)
            }
            if node^.when_stmt^.default_body != nil {
                check_alias_block(checker, node^.when_stmt^.default_body, state, file)
            }
        }
        is ast.NodeKind.VAR_DECL { check_alias_expression(checker, node^.var_decl^.value, state, file) }
        is ast.NodeKind.ASSIGN_STMT { check_alias_expression(checker, node^.assign^.value, state, file) }
        is ast.NodeKind.RETURN_STMT {
            for_each value in node^.return_stmt^.values {
                check_alias_expression(checker, value, state, file)
            }
        }
        is ast.NodeKind.ENSURE_STMT {
            note_alias_form(checker, state^.ensure_form, node^.tok.literal, "ensure", "defer", node^.tok.line, node^.tok.col, file)
            check_alias_expression(checker, node^.ensure_stmt^.expr, state, file)
        }
        is ast.NodeKind.EXPR_STMT { check_alias_expression(checker, node^.expr_stmt^.expr, state, file) }
        is ast.NodeKind.LABEL, ast.NodeKind.INT_VALUE, ast.NodeKind.FLOAT_VALUE, ast.NodeKind.STRING_VALUE,
        ast.NodeKind.INTERPOLATED_STRING, ast.NodeKind.CHAR_VALUE, ast.NodeKind.BOOL_VALUE,
        ast.NodeKind.NIL_VALUE, ast.NodeKind.ARRAY_VALUE, ast.NodeKind.MAP_VALUE,
        ast.NodeKind.STRUCT_VALUE, ast.NodeKind.PREFIX_EXPR, ast.NodeKind.INFIX_EXPR,
        ast.NodeKind.POSTFIX_EXPR, ast.NodeKind.CALL_EXPR, ast.NodeKind.INDEX_EXPR,
        ast.NodeKind.MEMBER_EXPR, ast.NodeKind.NEW_EXPR, ast.NodeKind.RANGE_EXPR, ast.NodeKind.CAST_EXPR,
        ast.NodeKind.FUNC_REF, ast.NodeKind.IMPLICIT_ENUM, ast.NodeKind.WHEN_PATTERN,
        ast.NodeKind.BREAK_STMT, ast.NodeKind.CONTINUE_STMT, ast.NodeKind.IMPORT_STMT,
        ast.NodeKind.USING_STMT, ast.NodeKind.ENUM_DECL, ast.NodeKind.ALIAS_DECL, ast.NodeKind.MODULE_DECL,
        ast.NodeKind.PROGRAM {}
    }
}

fn check_keyword_alias_consistency(checker ^TypeChecker, program ^ast.AstNode) {
    if program == nil || program^.kind != ast.NodeKind.PROGRAM { return }
    mut current_file = ""
    mut has_file = false
    state = alias_state_create()
    for_each statement in program^.program^.stmts {
        if statement == nil { continue }
        statement_file = statement^.tok.file
        if !has_file || statement_file != current_file {
            has_file = true
            current_file = statement_file
            state = alias_state_create()
        }
        check_alias_walk(checker, statement, state, statement_file)
    }
}

// Imports the driver found used before the checker ran, by alias: references
// written `alias.name` were already rewritten to mangled names.
mut resolver_used_imports [string:bool] = {:}

fn note_resolver_used_import(name string) {
    resolver_used_imports[name] = true
}

// The names of the modules loaded from the program's own files; a reference through
// one is an error (reported by the driver) when the file does not import it.
mut user_module_names [string:bool] = {:}

// Where a reference to another file's private declaration was written (file:line:column): the access
// is refused, so it does not count as a use of the declaration
mut denied_references [string:bool] = {:}

fn note_denied_reference(file string, line i64, column i64) {
    denied_references["${file}:${line}:${column}"] = true
}

fn is_denied_reference(node ^ast.AstNode) -> bool {
    return maps.contains_key(denied_references, "${node^.tok.file}:${node^.tok.line}:${node^.tok.col}")
}

fn note_user_module(name string) {
    user_module_names[name] = true
}

// `gray check DIR` checks the directory as one module: no unused-import warnings.
mut is_directory_entry bool = false
mut is_test_mode bool = false

fn set_test_mode(enabled bool) {
    is_test_mode = enabled
}

// A #test function is an entry point for `gray test`; a normal build strips it,
// so any call or reference from other code would dangle.
fn reject_test_function_reference(checker ^TypeChecker, node ^ast.AstNode, signature ^FuncSig) {
    if signature == nil || signature^.decl == nil || !signature^.decl^.is_test { return }
    mut display string = signature^.decl^.original_name
    if display == "" { display = signature^.decl^.name }
    add_diagnostic(checker, "E5047", error_registry.registry_message_formatted("E5047", {display}), node^.tok.file, node^.tok.line, node^.tok.col)
}

fn set_directory_entry(enabled bool) {
    is_directory_entry = enabled
}

fn typecheck_program(program ^ast.AstNode, is_main_optional bool) -> ^TypeChecker {
    checker = typechecker_create()
    checker^.is_main_optional = is_main_optional
    checker^.is_registering = true
    register_file_scope_const_integers(checker, program)
    register_decl_imports(checker, program)
    check_using_after_import(checker, program)
    register_decl_aliases(checker, program)
    register_decl_enums(checker, program)
    register_error_code_set(checker, program)
    register_decl_structs(checker, program)
    register_decl_functions(checker, program)
    register_stdlib_structs(checker)
    checker^.is_registering = false
    // Every leaf of an alias target must name a type, checked now that structs and
    // enums are registered
    for_each target_alias in checker^.type_aliases {
        checker^.current_check_file = target_alias.file
        // A public alias of a private type re-exports it, around every use-site check
        if !target_alias.is_private {
            private_target = private_target_leaf(checker, program, target_alias.target)
            if private_target != "" {
                add_diagnostic(checker, "E4025", error_registry.registry_message_formatted("E4025", {module_member_display_name(target_alias.name), module_member_display_name(private_target)}), target_alias.file, target_alias.line, target_alias.col)
            }
        }
        undefined_target = undefined_type_leaf(checker, resolve_type_alias(checker, target_alias.target))
        // A cycle never resolves to a type: its target is the undefined leaf
        if alias_forms_cycle(checker, target_alias) { undefined_target = target_alias.target }
        if undefined_target != "" {
            add_diagnostic(checker, "E3132", error_registry.registry_message_formatted("E3132", {undefined_target}), target_alias.file, target_alias.line, target_alias.col)
        }
    }
    checker^.current_check_file = ""
    check_keyword_alias_consistency(checker, program)
    mut previous_file = ""
    mut has_previous_file = false
    mut has_seen_file_declaration = false
    mut deferred_statements [^ast.AstNode] = {}
    for_each statement in program^.program^.stmts {
        // Imports come before every other declaration, per file
        if !has_previous_file || statement^.tok.file != previous_file {
            previous_file = statement^.tok.file
            has_previous_file = true
            has_seen_file_declaration = false
        }
        if statement^.kind == ast.NodeKind.IMPORT_STMT {
            if has_seen_file_declaration {
                add_diagnostic(checker, "E2098", error_registry.registry_message("E2098"), statement^.tok.file, statement^.tok.line, statement^.tok.col)
            }
        } or statement^.kind != ast.NodeKind.USING_STMT {
            has_seen_file_declaration = true
        }
        // File-scope variables are visible to every function, wherever they are
        // declared: check them before the declarations whose bodies may read them
        checker^.current_check_file = statement^.tok.file
        if statement^.kind == ast.NodeKind.VAR_DECL {
            check_statement(checker, statement)
        } otherwise {
            arrays.append(deferred_statements, statement)
        }
    }
    for_each statement in deferred_statements {
        checker^.current_check_file = statement^.tok.file
        check_statement(checker, statement)
    }
    flush_pending_literals(checker, 0)
    checker^.current_check_file = ""

    recheck_generic_instantiations(checker, program)

    // Every program needs a main(), reported at its last statement. A
    // #test-attributed main is stripped from a normal build, so it does not count.
    main_signature = find_func(checker, "main")
    main_is_test = main_signature != nil && main_signature^.decl != nil && main_signature^.decl^.is_test
    if !checker^.is_main_optional && !is_test_mode && !checker^.was_main_name_misused && (main_signature == nil || main_is_test) {
        stmts = program^.program^.stmts
        mut error_line i64 = 1
        mut error_file = ""
        if len(stmts) > 0 {
            error_line = stmts[len(stmts) - 1]^.tok.line
            error_file = stmts[len(stmts) - 1]^.tok.file
        }
        add_diagnostic(checker, "E4035", error_registry.registry_message("E4035"), error_file, error_line, 1)
    }

    // Imports of the entry file that nothing used. Imports of other files are
    // their author's responsibility.
    program_stmts = program^.program^.stmts
    if len(program_stmts) > 0 && !is_directory_entry {
        entry_file = program_stmts[len(program_stmts) - 1]^.tok.file
        for_each import_entry in checker^.imports {
            if import_entry.used || import_entry.file != entry_file { continue }
            if maps.contains_key(resolver_used_imports, import_entry.mod_name) { continue }
            add_diagnostic(checker, "W1002", error_registry.registry_message_formatted("W1002", {import_entry.mod_name}), import_entry.file, import_entry.line, 1)
        }
        // Functions nothing called. A private function is dead code the moment nothing in
        // its file calls it. A public function is some module's API, so it is reported only in the
        // entry file, and a public struct function is API too.
        mut reportable_functions [^FuncSig] = {}
        mut reportable_names [string] = {}
        for_each function_name in maps.get_keys(checker^.funcs) {
            arrays.append(reportable_functions, checker^.funcs[function_name])
            arrays.append(reportable_names, function_name)
        }
        for_each shadowed in checker^.shadowed_functions {
            arrays.append(reportable_functions, shadowed)
            arrays.append(reportable_names, shadowed^.name)
        }
        for function_position in range(0, len(reportable_functions)) {
            function_name = reportable_names[function_position]
            function_signature = reportable_functions[function_position]
            if function_signature^.used || function_signature^.definition_line <= 0 || function_name == "main" || function_signature^.decl == nil { continue }
            if function_signature^.decl^.is_test { continue }
            first_letter = strings.char_at(function_name, 0)
            is_struct_function = first_letter >= 'A' && first_letter <= 'Z' && strings.contains(function_name, "_")
            in_entry_file = function_signature^.file == entry_file || function_signature^.file == ""
            if !(function_signature^.is_private || (in_entry_file && !is_struct_function)) { continue }
            mut display = function_signature^.decl^.original_name
            if display == "" { display = function_signature^.decl^.name }
            add_diagnostic(checker, "W1003", error_registry.registry_message_formatted("W1003", {display}), function_signature^.file, function_signature^.definition_line, 1)
        }
    }
    return checker
}

// True when a write through this symbol modifies a constant: a plain const, or
// a const `ref` that is not itself a reference to a pointer.
fn symbol_is_const_write_target(symbol ^scope.Symbol) -> bool {
    if symbol^.mutable { return false }
    if symbol^.sym_type^.kind != types.TypeKind.POINTER { return true }
    if !symbol^.is_ref { return false }
    return !strings.starts_with(symbol^.sym_type^.element_type, "^")
}

// The name a struct, enum or alias declaration gives its type, or "".
fn type_declaration_name(statement ^ast.AstNode) -> string {
    if statement^.kind == ast.NodeKind.STRUCT_DECL { return statement^.struct_decl^.name }
    if statement^.kind == ast.NodeKind.ENUM_DECL { return statement^.enum_decl^.name }
    if statement^.kind == ast.NodeKind.ALIAS_DECL { return statement^.alias_decl^.name }
    return ""
}

// A duplicate-type error applies to a type declaration when it is not the first one of its name: the first
// declaration owns the name. A name registered by something outside the program (a stdlib
// type) is taken before the program's own first declaration.
fn type_name_is_duplicate(checker ^TypeChecker, program ^ast.AstNode, current ^ast.AstNode, is_registered bool) -> bool {
    mut seen_current = false
    mut has_earlier = false
    mut has_later = false
    for_each other in program^.program^.stmts {
        if other == current { seen_current = true; continue }
        if type_declaration_name(other) != type_declaration_name(current) { continue }
        if seen_current { has_later = true } otherwise { has_earlier = true }
    }
    return has_earlier || (is_registered && !has_later)
}

// A #json struct, or an array of one: the targets json.parse() can fill.
fn type_is_json_struct_or_array(checker ^TypeChecker, target_type ^types.GrayType) -> bool {
    if target_type^.kind == types.TypeKind.MAP { return true }
    if target_type^.kind == types.TypeKind.STRUCT { return struct_has_json_attribute(checker, target_type^.name) }
    if target_type^.kind == types.TypeKind.ARRAY && target_type^.element_type != "" {
        element_type = checker_type_from_name(checker, target_type^.element_type)
        return element_type^.kind == types.TypeKind.STRUCT && struct_has_json_attribute(checker, element_type^.name)
    }
    return false
}

// True when `call_node` is `module.function(...)`, resolved through any import alias.
fn call_is_stdlib_function(checker ^TypeChecker, call_node ^ast.AstNode, module_name string, function_name string) -> bool {
    if call_node == nil || call_node^.kind != ast.NodeKind.CALL_EXPR { return false }
    function_node = call_node^.call^.function
    if function_node == nil || function_node^.kind != ast.NodeKind.MEMBER_EXPR { return false }
    raw_module_name = ast.ast_member_base_qualifier(function_node)
    if raw_module_name == "" { return false }
    return resolve_import_alias(checker, raw_module_name) == module_name && function_node^.member^.member == function_name
}

// Json.parse()'s target must be a #json struct (or an array of one); its own
// return type depends on the declaration or assignment target.
fn reject_non_json_parse_target(checker ^TypeChecker, node ^ast.AstNode, value ^ast.AstNode, target_type ^types.GrayType) {
    if call_is_stdlib_function(checker, value, "json", "parse") && target_type^.kind != types.TypeKind.UNKNOWN && !type_is_json_struct_or_array(checker, target_type) {
        add_diagnostic(checker, "E3174", error_registry.registry_message_formatted("E3174", {shown_type(checker, target_type), "parse"}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
}

// True when `candidate` is `directory` or lies inside it (both already absolute and clean).
fn path_within_directory(candidate string, directory string) -> bool {
    if len(candidate) < len(directory) { return false }
    if !strings.starts_with(candidate, directory) { return false }
    if len(candidate) == len(directory) { return true }
    return strings.char_at(candidate, len(directory)) == '/' || strings.char_at(candidate, len(directory)) == '\\'
}

// embed(path): one string literal naming a file inside the source file's directory.
// An error for a non-literal path, for one that leaves the source tree, and for a
// file that cannot be read.
fn resolve_embed_call(checker ^TypeChecker, node ^ast.AstNode) -> ^types.GrayType {
    arguments = node^.call^.args
    if len(arguments) != 1 {
        resolve_call_args_only(checker, node)
        add_diagnostic(checker, "E5008", error_registry.registry_message_formatted("E5008", {"embed", "1", "${len(arguments)}"}), node^.tok.file, node^.tok.line, node^.tok.col)
        return checker^.pool^.type_string
    }
    argument = arguments[0]
    if argument^.kind != ast.NodeKind.STRING_VALUE {
        add_diagnostic(checker, "E5017", error_registry.registry_message("E5017"), node^.tok.file, node^.tok.line, node^.tok.col)
        resolve_quietly(checker, argument)
        return checker^.pool^.type_string
    }
    embed_path = ast.ast_string_decode(argument^.string_value)
    source_file = node^.tok.file
    mut source_directory = ""
    mut separator_position i64 = -1
    for position in range(0, len(source_file)) {
        separator = strings.char_at(source_file, position)
        if separator == '/' || separator == '\\' { separator_position = position }
    }
    if separator_position >= 0 { source_directory = strings.slice(source_file, 0, separator_position + 1) }
    mut resolved = embed_path
    if !path.is_absolute(embed_path) && source_directory != "" { resolved = "${source_directory}${embed_path}" }
    if io.file_exists(resolved) {
        real_embed, embed_error = path.absolute_path(resolved)
        mut directory_to_check = "."
        if source_directory != "" { directory_to_check = strings.slice(source_directory, 0, len(source_directory) - 1) }
        real_directory, directory_error = path.absolute_path(directory_to_check)
        if embed_error == nil && directory_error == nil && !path_within_directory(real_embed, real_directory) {
            add_diagnostic(checker, "E5027", error_registry.registry_message("E5027"), node^.tok.file, node^.tok.line, node^.tok.col)
            return checker^.pool^.type_string
        }
    }
    _, read_error = io.read_file(resolved)
    if read_error != nil {
        add_diagnostic(checker, "E5018", error_registry.registry_message_formatted("E5018", {embed_path}), node^.tok.file, node^.tok.line, node^.tok.col)
    }
    return checker^.pool^.type_string
}

// The extern-call error, forwarded through a pointer-parameter function boundary: a helper that passes
// its `^T` parameter straight into its own extern call still leaks the caller's stack
// address into C, so the caller passing the address of a local for that parameter is
// rejected exactly like a direct extern call would be.
fn apply_call_parameter_extern_effects(checker ^TypeChecker, node ^ast.AstNode) {
    if checker^.current_function_scope_depth <= 0 { return }
    callee_signature = resolve_call_signature(checker, node)
    if callee_signature == nil { return }
    ensure_escape_summary(checker, callee_signature)
    if callee_signature^.passes_parameter_to_extern == 0 { return }
    arguments = node^.call^.args
    for argument_index in range(0, len(arguments)) {
        if argument_index >= len(callee_signature^.param_types) || argument_index >= MAX_TRACKED_PARAMETERS { break }
        if callee_signature^.passes_parameter_to_extern bit_and (1 bit_shift_left argument_index) == 0 { continue }
        origin_depth, root = expression_origin(checker, arguments[argument_index])
        if origin_depth > 0 && origin_depth >= checker^.current_function_scope_depth && root != "" {
            add_diagnostic(checker, "E3154", error_registry.registry_message_formatted("E3154", {root}), arguments[argument_index]^.tok.file, arguments[argument_index]^.tok.line, arguments[argument_index]^.tok.col)
        }
    }
}

// A `using` names a module imported earlier in the same file; a `using` in an
// imported file only needs the import to exist.
fn check_using_after_import(checker ^TypeChecker, program ^ast.AstNode) {
    for_each statement in program^.program^.stmts {
        if statement^.kind != ast.NodeKind.USING_STMT { continue }
        for_each used_module in statement^.using_stmt^.modules {
            mut imported_before = false
            mark_import_used(checker, used_module)
            for_each entry in checker^.imports {
                if entry.mod_name != used_module { continue }
                if entry.file == statement^.tok.file && entry.line < statement^.tok.line { imported_before = true }
                if entry.file != statement^.tok.file && statement^.tok.file != "" { imported_before = true }
            }
            if !imported_before {
                add_diagnostic(checker, "E2010", error_registry.registry_message_formatted("E2010", {used_module, used_module}), statement^.tok.file, statement^.tok.line, statement^.tok.col)
            }
        }
    }
}

// How a declaration is written from outside its module: `module.name`, or the bare name
// for the entry module.
fn qualified_declaration_spelling(module_prefix string, name string) -> string {
    if module_prefix == "" { return name }
    return "${strings.slice(module_prefix, 0, len(module_prefix) - 1)}.${name}"
}

fn type_kind_is_plain_scalar(scalar_type ^types.GrayType) -> bool {
    return scalar_type^.kind == types.TypeKind.INT || scalar_type^.kind == types.TypeKind.UINT || scalar_type^.kind == types.TypeKind.FLOAT || scalar_type^.kind == types.TypeKind.BOOL || scalar_type^.kind == types.TypeKind.CHAR
}

// True when the expression reads a number, bool or char: a local initialized from one, or
// a field of a (pointer to) struct parameter declared with such a type.
fn expression_is_plain_scalar(checker ^TypeChecker, signature ^FuncSig, node ^ast.AstNode) -> bool {
    if node == nil || signature^.decl == nil { return false }
    if node^.kind == ast.NodeKind.LABEL {
        initializer = local_initializer(signature^.decl^.body, node^.label^.value)
        return initializer != nil && initializer != node && expression_is_plain_scalar(checker, signature, initializer)
    }
    if node^.kind != ast.NodeKind.MEMBER_EXPR { return false }
    mut object_node ^ast.AstNode = node^.member^.object
    as_long_as object_node != nil && object_node^.kind == ast.NodeKind.POSTFIX_EXPR && object_node^.postfix^.op == token.TokenKind.CARET { object_node = object_node^.postfix^.left }
    if object_node == nil || object_node^.kind != ast.NodeKind.LABEL { return false }
    for_each declared_parameter in signature^.decl^.params {
        if declared_parameter.name != object_node^.label^.value || declared_parameter.type_name == "" { continue }
        mut struct_name = declared_parameter.type_name
        if strings.starts_with(struct_name, "^") { struct_name = strings.slice(struct_name, 1, len(struct_name)) }
        info = find_struct(checker, struct_name)
        if info == nil { return false }
        for field_index in range(0, len(info^.field_names)) {
            if info^.field_names[field_index] == node^.member^.member { return type_kind_is_plain_scalar(info^.field_types[field_index]) }
        }
        return false
    }
    return false
}

// --- Array copy elision ---
//
// `mut xs = h^.items` copies the field, and `h^.items = xs` after changing the copy copies
// it back. When nothing between the two can observe or write the field, and `xs` is dead
// after the store, sharing the storage is indistinguishable from copying it.

// The label at the root of a member / index / dereference chain, or nil.
fn place_root_label(place ^ast.AstNode) -> ^ast.AstNode {
    mut current = place
    mut none ^ast.AstNode = nil
    as_long_as current != nil {
        when current^.kind {
            is ast.NodeKind.LABEL { return current }
            is ast.NodeKind.MEMBER_EXPR { current = current^.member^.object }
            is ast.NodeKind.INDEX_EXPR { current = current^.index_data^.left }
            is ast.NodeKind.POSTFIX_EXPR {
                if current^.postfix^.op != token.TokenKind.CARET { return none }
                current = current^.postfix^.left
            }
            default { return none }
        }
    }
    return none
}

// A place with no side effects: names, fields, dereferences, and indexes by a literal or a name.
fn place_is_pure(place ^ast.AstNode) -> bool {
    if place == nil { return false }
    when place^.kind {
        is ast.NodeKind.LABEL { return true }
        is ast.NodeKind.MEMBER_EXPR { return place_is_pure(place^.member^.object) }
        is ast.NodeKind.INDEX_EXPR {
            index_node = place^.index_data^.index_expr
            return index_node != nil && (index_node^.kind == ast.NodeKind.INT_VALUE || index_node^.kind == ast.NodeKind.LABEL) && place_is_pure(place^.index_data^.left)
        }
        is ast.NodeKind.POSTFIX_EXPR { return place^.postfix^.op == token.TokenKind.CARET && place_is_pure(place^.postfix^.left) }
        default { return false }
    }
}

fn places_equal(left ^ast.AstNode, right ^ast.AstNode) -> bool {
    if left == nil || right == nil || left^.kind != right^.kind { return false }
    when left^.kind {
        is ast.NodeKind.LABEL { return left^.label^.value == right^.label^.value }
        is ast.NodeKind.INT_VALUE { return left^.int_value^.value == right^.int_value^.value }
        is ast.NodeKind.MEMBER_EXPR { return left^.member^.member == right^.member^.member && places_equal(left^.member^.object, right^.member^.object) }
        is ast.NodeKind.INDEX_EXPR { return places_equal(left^.index_data^.left, right^.index_data^.left) && places_equal(left^.index_data^.index_expr, right^.index_data^.index_expr) }
        is ast.NodeKind.POSTFIX_EXPR { return left^.postfix^.op == right^.postfix^.op && places_equal(left^.postfix^.left, right^.postfix^.left) }
        default { return false }
    }
}

// Does `node` mention `name`? Kinds this does not know count as a mention.
fn expression_mentions(node ^ast.AstNode, name string) -> bool {
    if node == nil { return false }
    when node^.kind {
        is ast.NodeKind.LABEL { return node^.label^.value == name }
        is ast.NodeKind.INT_VALUE { return false }
        is ast.NodeKind.FLOAT_VALUE { return false }
        is ast.NodeKind.STRING_VALUE { return false }
        is ast.NodeKind.CHAR_VALUE { return false }
        is ast.NodeKind.BOOL_VALUE { return false }
        is ast.NodeKind.NIL_VALUE { return false }
        is ast.NodeKind.INTERPOLATED_STRING {
            for_each part in node^.interp_string^.parts { if expression_mentions(part, name) { return true } }
            return false
        }
        is ast.NodeKind.ARRAY_VALUE {
            for_each element in node^.array_value^.elements { if expression_mentions(element, name) { return true } }
            return false
        }
        is ast.NodeKind.MAP_VALUE {
            for position in range(0, len(node^.map_value^.keys)) {
                if expression_mentions(node^.map_value^.keys[position], name) || expression_mentions(node^.map_value^.values[position], name) { return true }
            }
            return false
        }
        is ast.NodeKind.STRUCT_VALUE {
            for_each field_value in node^.struct_value^.field_values { if expression_mentions(field_value, name) { return true } }
            return false
        }
        is ast.NodeKind.PREFIX_EXPR { return expression_mentions(node^.prefix^.right, name) }
        is ast.NodeKind.INFIX_EXPR { return expression_mentions(node^.infix^.left, name) || expression_mentions(node^.infix^.right, name) }
        is ast.NodeKind.POSTFIX_EXPR { return expression_mentions(node^.postfix^.left, name) }
        is ast.NodeKind.INDEX_EXPR { return expression_mentions(node^.index_data^.left, name) || expression_mentions(node^.index_data^.index_expr, name) }
        is ast.NodeKind.MEMBER_EXPR { return expression_mentions(node^.member^.object, name) }
        is ast.NodeKind.CALL_EXPR {
            if expression_mentions(node^.call^.function, name) { return true }
            for_each call_argument in node^.call^.args { if expression_mentions(call_argument, name) { return true } }
            return false
        }
        default { return true }
    }
}

fn type_is_plain_scalar_for_elision(scalar_type ^types.GrayType) -> bool {
    return type_kind_is_plain_scalar(scalar_type) || scalar_type^.kind == types.TypeKind.STRING || scalar_type^.kind == types.TypeKind.LITERAL
}

// An expression between the copy and the store cannot reach the place: it reads only plain
// scalars, other than the place's root, and calls only standard-library functions and `len`,
// which touch nothing but their arguments. `array_name` may appear only as a call argument or
// an indexed base.
fn expression_leaves_place_alone(checker ^TypeChecker, node ^ast.AstNode, array_name string, root_name string) -> bool {
    if node == nil { return true }
    when node^.kind {
        is ast.NodeKind.LABEL {
            if node^.label^.value == array_name || node^.label^.value == root_name { return false }
            return type_is_plain_scalar_for_elision(resolve_quietly(checker, node))
        }
        is ast.NodeKind.INT_VALUE { return true }
        is ast.NodeKind.FLOAT_VALUE { return true }
        is ast.NodeKind.STRING_VALUE { return true }
        is ast.NodeKind.CHAR_VALUE { return true }
        is ast.NodeKind.BOOL_VALUE { return true }
        is ast.NodeKind.INTERPOLATED_STRING {
            for_each part in node^.interp_string^.parts { if !expression_leaves_place_alone(checker, part, array_name, root_name) { return false } }
            return true
        }
        is ast.NodeKind.ARRAY_VALUE {
            for_each element in node^.array_value^.elements { if !expression_leaves_place_alone(checker, element, array_name, root_name) { return false } }
            return true
        }
        is ast.NodeKind.STRUCT_VALUE {
            for_each field_value in node^.struct_value^.field_values { if !expression_leaves_place_alone(checker, field_value, array_name, root_name) { return false } }
            return true
        }
        is ast.NodeKind.PREFIX_EXPR { return expression_leaves_place_alone(checker, node^.prefix^.right, array_name, root_name) }
        is ast.NodeKind.INFIX_EXPR { return expression_leaves_place_alone(checker, node^.infix^.left, array_name, root_name) && expression_leaves_place_alone(checker, node^.infix^.right, array_name, root_name) }
        is ast.NodeKind.INDEX_EXPR {
            base_node = node^.index_data^.left
            base_is_array = base_node^.kind == ast.NodeKind.LABEL && base_node^.label^.value == array_name
            return base_is_array && type_is_plain_scalar_for_elision(resolve_quietly(checker, node)) && expression_leaves_place_alone(checker, node^.index_data^.index_expr, array_name, root_name)
        }
        is ast.NodeKind.CALL_EXPR {
            callee_node = node^.call^.function
            mut is_standard_call = false
            if callee_node^.kind == ast.NodeKind.MEMBER_EXPR && callee_node^.member^.object^.kind == ast.NodeKind.LABEL {
                module_name = callee_node^.member^.object^.label^.value
                is_standard_call = scope.scope_lookup(checker^.current_scope, module_name) == nil && is_imported_module_name(checker, module_name) && reserved.is_stdlib_module_name(resolve_import_alias(checker, module_name))
            } or callee_node^.kind == ast.NodeKind.LABEL {
                is_standard_call = callee_node^.label^.value == "len"
            }
            if !is_standard_call { return false }
            for_each call_argument in node^.call^.args {
                is_array_argument = call_argument^.kind == ast.NodeKind.LABEL && call_argument^.label^.value == array_name
                if !is_array_argument && !expression_leaves_place_alone(checker, call_argument, array_name, root_name) { return false }
            }
            return true
        }
        default { return false }
    }
}

// Is `statement` straight-line code that leaves the place alone?
fn statement_leaves_place_alone(checker ^TypeChecker, statement ^ast.AstNode, array_name string, root_name string) -> bool {
    when statement^.kind {
        is ast.NodeKind.EXPR_STMT { return expression_leaves_place_alone(checker, statement^.expr_stmt^.expr, array_name, root_name) }
        is ast.NodeKind.VAR_DECL {
            declared_value = statement^.var_decl^.value
            if declared_value == nil { return false }
            return type_is_plain_scalar_for_elision(resolve_quietly(checker, declared_value)) && expression_leaves_place_alone(checker, declared_value, array_name, root_name)
        }
        is ast.NodeKind.ASSIGN_STMT {
            assign_target = statement^.assign^.target
            target_is_scalar_local = assign_target^.kind == ast.NodeKind.LABEL && assign_target^.label^.value != array_name && assign_target^.label^.value != root_name && type_is_plain_scalar_for_elision(resolve_quietly(checker, assign_target))
            target_is_array_element = assign_target^.kind == ast.NodeKind.INDEX_EXPR && assign_target^.index_data^.left^.kind == ast.NodeKind.LABEL && assign_target^.index_data^.left^.label^.value == array_name && expression_leaves_place_alone(checker, assign_target^.index_data^.index_expr, array_name, root_name)
            return (target_is_scalar_local || target_is_array_element) && type_is_plain_scalar_for_elision(resolve_quietly(checker, statement^.assign^.value)) && expression_leaves_place_alone(checker, statement^.assign^.value, array_name, root_name)
        }
        default { return false }
    }
}

// Is `statement` simple code that never mentions `array_name`?
fn statement_ignores_array(statement ^ast.AstNode, array_name string) -> bool {
    when statement^.kind {
        is ast.NodeKind.EXPR_STMT { return !expression_mentions(statement^.expr_stmt^.expr, array_name) }
        is ast.NodeKind.VAR_DECL { return !expression_mentions(statement^.var_decl^.value, array_name) }
        is ast.NodeKind.ASSIGN_STMT { return !expression_mentions(statement^.assign^.target, array_name) && !expression_mentions(statement^.assign^.value, array_name) }
        is ast.NodeKind.RETURN_STMT {
            for_each returned in statement^.return_stmt^.values { if expression_mentions(returned, array_name) { return false } }
            return true
        }
        default { return false }
    }
}

// Flags each `mut xs = place` in the block whose copy can be elided.
fn mark_elided_array_copies(checker ^TypeChecker, block ^ast.AstNode) {
    stmts = block^.block^.stmts
    count = len(stmts)
    for start in range(0, count) {
        declaration = stmts[start]
        if declaration == nil || declaration^.kind != ast.NodeKind.VAR_DECL || !declaration^.var_decl^.is_mutable || declaration^.var_decl^.is_synthetic { continue }
        place = declaration^.var_decl^.value
        if place == nil || (place^.kind != ast.NodeKind.MEMBER_EXPR && place^.kind != ast.NodeKind.INDEX_EXPR) { continue }
        if !place_is_pure(place) { continue }
        place_type = resolve_quietly(checker, place)
        if place_type^.kind != types.TypeKind.ARRAY { continue }
        root = place_root_label(place)
        array_name = declaration^.var_decl^.name
        if root == nil || root^.label^.value == array_name { continue }

        for end in range(start + 1, count) {
            statement = stmts[end]
            if statement == nil { break }
            if statement^.kind == ast.NodeKind.ASSIGN_STMT && statement^.assign^.op == token.TokenKind.ASSIGN && places_equal(statement^.assign^.target, place) {
                stored = statement^.assign^.value
                if stored^.kind != ast.NodeKind.LABEL || stored^.label^.value != array_name { break }
                mut is_dead_after = true
                for after in range(end + 1, count) {
                    later = stmts[after]
                    if later == nil || !statement_ignores_array(later, array_name) { is_dead_after = false; break }
                }
                if is_dead_after { declaration^.var_decl^.elides_copy = true }
                break
            }
            if !statement_leaves_place_alone(checker, statement, array_name, root^.label^.value) { break }
        }
    }
}

// A write to a whole variable (`x = v`, `x += v`, `x++`) is not a read of it, so the reference
// the write makes does not count toward a warning. The symbol is looked up by name, because
// `x = v` may declare `x` while it is checked.
fn whole_variable_write_name(target ^ast.AstNode) -> string {
    if target != nil && target^.kind == ast.NodeKind.LABEL { return target^.label^.value }
    return ""
}

fn symbol_was_used_before_write(checker ^TypeChecker, name string) -> bool {
    if name == "" { return false }
    written_symbol = scope.scope_lookup(checker^.current_scope, name)
    return written_symbol != nil && written_symbol^.used
}

fn restore_symbol_used_flag(checker ^TypeChecker, name string, was_used bool) {
    if name == "" { return }
    written_symbol = scope.scope_lookup(checker^.current_scope, name)
    if written_symbol != nil { written_symbol^.used = was_used }
}

// i8 through i256 and u8 through u256.
fn is_integer_type_text(type_text string) -> bool {
    return type_text == "i8" || type_text == "i16" || type_text == "i32" || type_text == "i64" || type_text == "i128" || type_text == "i256" || type_text == "u8" || type_text == "u16" || type_text == "u32" || type_text == "u64" || type_text == "u128" || type_text == "u256"
}

// A fixed-size array `[T, N]` given a literal with fewer than N elements; the rest are
// zero-valued. `description` names a struct field; "" names the array type itself.
fn warn_short_fixed_array(checker ^TypeChecker, value ^ast.AstNode, spelling string, description string, at ^ast.AstNode) {
    if value == nil || value^.kind != ast.NodeKind.ARRAY_VALUE || !strings.starts_with(spelling, "[") { return }
    size = fixed_array_declared_size(spelling)
    count = len(value^.array_value^.elements)
    if size <= 0 || count >= size { return }
    mut shown = description
    if shown == "" {
        inner = strings.slice(spelling, 1, len(spelling) - 1)
        mut element_text = strings.trim(strings.slice(inner, 0, types.type_top_level_comma(inner)))
        if element_text == "" { element_text = "?" }
        shown = "[${element_text}, ${size}]"
    }
    add_diagnostic(checker, "W3003", error_registry.registry_message_formatted("W3003", {shown, "${count}", "${size}"}), at^.tok.file, at^.tok.line, at^.tok.col)
}

// --- Type names in diagnostics ---

// The name as written, without its module: `Type` for `mod.Type` and for `mod_Type`.
fn unqualified_display_name(name string) -> string {
    last_dot = strings.last_index_of(name, ".")
    if last_dot >= 0 && last_dot + 1 < len(name) && strings.char_at(name, last_dot + 1) >= 'A' && strings.char_at(name, last_dot + 1) <= 'Z' { return strings.slice(name, last_dot + 1, len(name)) }
    underscore = strings.last_index_of(name, "_")
    if underscore >= 0 && underscore + 1 < len(name) && strings.char_at(name, underscore + 1) >= 'A' && strings.char_at(name, underscore + 1) <= 'Z' { return strings.slice(name, underscore + 1, len(name)) }
    return name
}

// How many declared types go by this display name.
fn display_name_count(checker ^TypeChecker, display string) -> i64 {
    mut count i64 = 0
    for_each struct_key in maps.get_keys(checker^.structs) {
        if checker^.structs[struct_key]^.display_name == display { count += 1 }
    }
    for_each enum_key in maps.get_keys(checker^.enums) {
        if checker^.enums[enum_key]^.display_name == display { count += 1 }
    }
    for_each alias_entry in checker^.type_aliases {
        if alias_entry.is_distinct && unqualified_display_name(alias_entry.name) == display { count += 1 }
    }
    return count
}

// The name a diagnostic gives a declared type: as written, qualified by its module when another
// declaration goes by the same name. `key` is the registry spelling, `display` the name looked up.
fn qualify_ambiguous_name(checker ^TypeChecker, key string, display string) -> string {
    if display == key || display_name_count(checker, display) < 2 { return display }
    suffix = "_${display}"
    if strings.ends_with(key, suffix) && len(key) > len(suffix) { return "${strings.slice(key, 0, len(key) - len(suffix))}.${display}" }
    return display
}

// A type name fit to print in a diagnostic: for struct and enum types the user-facing name, never
// the module-prefixed lookup key; pointers and arrays recurse into their inner type.
fn shown_type(checker ^TypeChecker, shown ^types.GrayType) -> string {
    if shown == nil { return "unknown" }
    if shown^.distinct_name != "" { return qualify_ambiguous_name(checker, shown^.distinct_name, unqualified_display_name(shown^.distinct_name)) }
    if shown^.kind == types.TypeKind.STRUCT && shown^.name != "" { return qualify_ambiguous_name(checker, shown^.name, struct_display_name(checker, shown^.name)) }
    if shown^.kind == types.TypeKind.ENUM && shown^.name != "" { return qualify_ambiguous_name(checker, shown^.name, enum_display_name(checker, shown^.name)) }
    if shown^.kind == types.TypeKind.POINTER && shown^.name != "" {
        mut inner = struct_display_name(checker, shown^.name)
        if inner == shown^.name { inner = enum_display_name(checker, shown^.name) }
        if inner != shown^.name { return "^${qualify_ambiguous_name(checker, shown^.name, inner)}" }
    }
    if shown^.kind == types.TypeKind.ARRAY && shown^.element_type != "" {
        mut inner = struct_display_name(checker, shown^.element_type)
        if inner == shown^.element_type { inner = enum_display_name(checker, shown^.element_type) }
        if inner != shown^.element_type { return "[${qualify_ambiguous_name(checker, shown^.element_type, inner)}]" }
    }
    return types.type_display_name(shown)
}

// A function as the program wrote it: `module.name` for a module's function, else the name.
fn written_function_name(node ^ast.AstNode, name string) -> string {
    if node^.kind == ast.NodeKind.LABEL && node^.label^.qualifier != "" { return "${node^.label^.qualifier}.${node^.label^.qualified_member}" }
    return name
}

// A function as a diagnostic names it: `module.name` for a function of a module (its registry name
// is `module_name`), else the name the call used.
fn shown_function_name(signature ^FuncSig, as_called string) -> string {
    if signature == nil || signature^.decl == nil || as_called != signature^.name { return as_called }
    if signature^.decl^.runtime_name != "" { return signature^.decl^.runtime_name }
    original = signature^.decl^.original_name
    if original == "" || original == signature^.name || !strings.ends_with(signature^.name, original) { return as_called }
    prefix = strings.slice(signature^.name, 0, len(signature^.name) - len(original))
    if prefix == "" { return as_called }
    return "${strings.slice(prefix, 0, len(prefix) - 1)}.${original}"
}

// The variable a write reaches, as the program wrote it: `module.NAME` for a module's variable.
fn assignment_target_root_display(target ^ast.AstNode) -> string {
    if target == nil { return "" }
    if target^.kind == ast.NodeKind.LABEL {
        if target^.label^.qualifier != "" { return "${target^.label^.qualifier}.${target^.label^.qualified_member}" }
        if target^.label^.written_name != "" { return target^.label^.written_name }
        return target^.label^.value
    }
    if target^.kind == ast.NodeKind.MEMBER_EXPR { return assignment_target_root_display(target^.member^.object) }
    if target^.kind == ast.NodeKind.INDEX_EXPR { return assignment_target_root_display(target^.index_data^.left) }
    return ""
}

// A type spelling with a space after each comma: `[i64,3]` is printed `[i64, 3]`.
fn spaced_type_spelling(spelling string) -> string {
    mut spaced = ""
    for position in range(0, len(spelling)) {
        letter = strings.slice(spelling, position, position + 1)
        spaced = "${spaced}${letter}"
        if letter == "," && !(position + 1 < len(spelling) && strings.char_at(spelling, position + 1) == ' ') { spaced = "${spaced} " }
    }
    return spaced
}

// The suggestion printed under a diagnostic whose every emission carries the same one.
fn default_help(code string, message string) -> string {
    when code {
        is "E5057" { return "convert one with cast()" }
        is "E3183" { return "all return values must be handled; use '_' to discard unwanted values" }
        is "E3182" { return "nil is only valid for == and != against nullable types (Error, pointers)" }
        is "E3074" { return "use 'arrays.is_equal(a, b)' to compare arrays element-by-element" }
        is "E3076" { return "use 'maps.is_equal(a, b)' to compare maps for equality" }
        is "E3077" { return "compare individual fields instead, e.g. 'a.x == b.x'" }
        is "E3059" { return "change 'const' to 'mut'; use a struct for fixed key-value data" }
        is "E3055" { return "add a size: const name [type, N] = {...}, or use 'mut' for a dynamic array" }
        is "E3119" { return "use a dynamic array type instead, e.g. [i64] without a size" }
        is "E2039" { return "move all parameters with default values to the end of the parameter list" }
        is "E3196" { return "add a type annotation (e.g., 'mut x Error = nil')" }
        is "E3130" { return "use a typed signature: 'func(params) -> return_type'" }
        is "E5060" { return "use '()func_name' to pass a function" }
        is "E3075" { return "assign the intermediate result to a variable, then call the next struct function on it" }
        is "E3191" { return "available fields: msg, code" }
        is "E3193" { return "the function modifies the value through it" }
        is "E3041" { return "use when/is to destructure the payload first" }
        is "E4034" { return "add extern import \"header.h\" at the top of the file" }
        is "E6009" { return "rename one of the declarations, or rename one of the modules" }
        is "E5058" { return "only primitive and string element types are supported" }
        is "E6012" { return "add 'import @json' to this file" }
        is "E4016" {
            first_quote = strings.index_of(message, "'")
            second_quote = strings.index_of(strings.slice(message, first_quote + 1, len(message)), "'")
            if first_quote >= 0 && second_quote >= 0 {
                undefined_name = strings.slice(message, first_quote + 1, first_quote + 1 + second_quote)
                replacement = removed_type_replacement(undefined_name)
                if replacement != "" { return "use '${replacement}', or declare 'alias ${undefined_name} = ${replacement}'" }
            }
            return ""
        }
        is "E3161" {
            if strings.contains(message, "a map index expression") { return "map values may relocate on rehash" }
            if strings.contains(message, "a dynamic array index expression") { return "the backing store may relocate when the array grows" }
            if strings.contains(message, "a string index expression") { return "string bytes are immutable" }
            return ""
        }
        default { return "" }
    }
}

// The type a name that was once built in stands for now, or "".
fn removed_type_replacement(name string) -> string {
    when name {
        is "int" { return "i64" }
        is "uint" { return "u64" }
        is "float" { return "f64" }
        is "byte" { return "u8" }
        default { return "" }
    }
}

// An operand mismatch whose fix is a conversion.
fn add_cast_help_diagnostic(checker ^TypeChecker, code string, message string, file string, line i64, col i64) {
    add_diagnostic_help(checker, code, message, "convert one side with cast()", file, line, col)
}

// The closest name in scope or among the functions, within an edit distance of 2, or "".
fn suggest_similar_name(checker ^TypeChecker, name string) -> string {
    mut best = ""
    mut best_distance i64 = SUGGESTION_DISTANCE_LIMIT
    mut current = checker^.current_scope
    as_long_as current != nil {
        for_each symbol_name in maps.get_keys(current^.symbols) {
            distance = suggest.edit_distance(name, symbol_name)
            if distance > 0 && distance < best_distance {
                best_distance = distance
                best = symbol_name
            }
        }
        current = current^.parent
    }
    for_each function_name in maps.get_keys(checker^.funcs) {
        distance = suggest.edit_distance(name, function_name)
        if distance > 0 && distance < best_distance {
            best_distance = distance
            best = function_name
        }
    }
    return best
}

// Every variable of `scope_to_report` that was never read, except a parameter's name. Reported
// as each scope closes, so the warnings come in the order the scopes end.
fn report_unused_in_scope(checker ^TypeChecker, scope_to_report ^scope.Scope) {
    if checker^.current_function == nil { return }
    function_params = checker^.current_function^.func_decl^.params
    for_each local_name in maps.get_keys(scope_to_report^.symbols) {
        local_symbol = scope_to_report^.symbols[local_name]
        if local_symbol^.used || strings.starts_with(local_name, "_") || local_symbol^.def_line <= 0 { continue }
        mut is_parameter = false
        for_each declared_parameter in function_params {
            if declared_parameter.name == local_name { is_parameter = true }
        }
        if is_parameter { continue }
        add_diagnostic(checker, "W1001", error_registry.registry_message_formatted("W1001", {local_name}), checker^.current_function^.tok.file, local_symbol^.def_line, local_symbol^.def_column)
    }
}

// --- #deprecated warnings ---
// One warning at every genuine reference to a deprecated function, struct or enum.

fn warn_deprecated(checker ^TypeChecker, node ^ast.AstNode, kind string, display_name string, message string) {
    add_diagnostic_help(checker, "W3007", error_registry.registry_message_formatted("W3007", {kind, display_name}), message, node^.tok.file, node^.tok.line, node^.tok.col)
}

// A deprecated function's own recursive calls to itself are exempt.
fn warn_if_function_deprecated(checker ^TypeChecker, node ^ast.AstNode, signature ^FuncSig) {
    if signature == nil || signature^.decl == nil || !signature^.decl^.is_deprecated { return }
    if checker^.current_function != nil && signature^.decl == checker^.current_function^.func_decl { return }
    mut display = signature^.decl^.name
    if signature^.decl^.original_name != "" { display = signature^.decl^.original_name }
    warn_deprecated(checker, node, "function", display, signature^.decl^.deprecated_message)
}

// A deprecated struct's own struct functions may name it.
fn warn_if_struct_deprecated(checker ^TypeChecker, node ^ast.AstNode, info ^StructInfo) {
    if info == nil || !info^.is_deprecated { return }
    if checker^.current_struct_name == info^.struct_name { return }
    warn_deprecated(checker, node, "struct", info^.display_name, info^.deprecated_message)
}

fn warn_if_enum_deprecated(checker ^TypeChecker, node ^ast.AstNode, info ^EnumInfo) {
    if info == nil || !info^.is_deprecated { return }
    warn_deprecated(checker, node, "enum", info^.display_name, info^.deprecated_message)
}

// A written type name (annotation, `new` or `size_of` argument, alias target) that names a
// deprecated struct or enum, at any depth of ^T, [T] and map[K:V].
fn warn_if_type_name_deprecated(checker ^TypeChecker, node ^ast.AstNode, type_name string, self_struct_name string) {
    if type_name == "" { return }
    if self_struct_name != "" && type_name == self_struct_name { return }
    components = type_name_components(type_name)
    if components.is_container {
        for_each component_name in components.names { warn_if_type_name_deprecated(checker, node, component_name, self_struct_name) }
        return
    }
    struct_info = find_struct(checker, type_name)
    if struct_info != nil {
        warn_if_struct_deprecated(checker, node, struct_info)
        return
    }
    warn_if_enum_deprecated(checker, node, find_enum(checker, type_name))
}

// The line a shadowed symbol was declared on: its declaration, else the `is` pattern that bound it,
// else the function it is a parameter of.
fn symbol_shadow_line(shadowed ^scope.Symbol) -> i64 {
    if shadowed^.def_line > 0 { return shadowed^.def_line }
    if shadowed^.binding_line > 0 { return shadowed^.binding_line }
    return shadowed^.param_line
}

// Marks the variable `name` of `target_scope` as bound by a loop or `when` statement written on `line`.
fn set_binding_line(target_scope ^scope.Scope, name string, line i64) {
    if name == "" { return }
    bound = scope.scope_lookup_local(target_scope, name)
    if bound != nil { bound^.binding_line = line }
}

// The length of `expression` when it is statically known: an array literal, a reference to a
// fixed-size local or parameter, or a fixed-size struct field. (length, true), else (0, false).
fn try_get_static_array_length(checker ^TypeChecker, expression ^ast.AstNode) -> (i64, bool) {
    if expression == nil { return 0, false }
    if expression^.kind == ast.NodeKind.ARRAY_VALUE { return len(expression^.array_value^.elements), true }
    if expression^.kind == ast.NodeKind.LABEL {
        referenced = scope.scope_lookup(checker^.current_scope, expression^.label^.value)
        if referenced != nil && referenced^.declared_type != "" {
            declared_length = fixed_array_declared_size(referenced^.declared_type)
            if declared_length > 0 { return declared_length, true }
        }
        return 0, false
    }
    if expression^.kind == ast.NodeKind.MEMBER_EXPR {
        field_length = member_expression_fixed_array_field_size(checker, expression)
        if field_length > 0 { return field_length, true }
    }
    return 0, false
}

// Diagnostics for a value stored into a fixed-size slot spelled `spelling`: too many elements is
// an error, too few a warning (the rest are zero-valued). `shown` names the slot in the warning.
fn check_fixed_array_slot_size(checker ^TypeChecker, spelling string, shown string, value ^ast.AstNode) {
    if !type_has_array_size(spelling) { return }
    fixed_size = fixed_array_declared_size(spelling)
    if fixed_size <= 0 { return }
    actual_length, is_known = try_get_static_array_length(checker, value)
    if !is_known {
        value^.runtime_fixed_length = fixed_size
        return
    }
    if actual_length > fixed_size {
        add_diagnostic(checker, "E3052", error_registry.registry_message_formatted("E3052", {"${fixed_size}", "${actual_length}"}), value^.tok.file, value^.tok.line, value^.tok.col)
    } or actual_length < fixed_size {
        value^.zero_fill_length = fixed_size
        add_diagnostic(checker, "W3003", error_registry.registry_message_formatted("W3003", {shown, "${actual_length}", "${fixed_size}"}), value^.tok.file, value^.tok.line, value^.tok.col)
    }
}

// A warning for an element of an array literal whose element type is a fixed-size array and which has
// fewer elements than that size (an error for too many is reported by check_fixed_array_length).
fn warn_short_fixed_array_element(checker ^TypeChecker, element_spelling string, element ^ast.AstNode) {
    if !type_has_array_size(element_spelling) { return }
    fixed_size = fixed_array_declared_size(element_spelling)
    if fixed_size <= 0 { return }
    actual_length, is_known = try_get_static_array_length(checker, element)
    if !is_known {
        element^.runtime_fixed_length = fixed_size
        return
    }
    if actual_length >= fixed_size { return }
    element^.zero_fill_length = fixed_size
    add_diagnostic(checker, "W3003", error_registry.registry_message_formatted("W3003", {element_spelling, "${actual_length}", "${fixed_size}"}), element^.tok.file, element^.tok.line, element^.tok.col)
}

// Naming a type in a declaration counts as a use of the module that owns it, a stdlib opaque type
// written at any depth of ^T, [T] and map[K:V].
fn mark_written_type_module_used(checker ^TypeChecker, type_name string) {
    if type_name == "" { return }
    components = type_name_components(type_name)
    if components.is_container {
        for_each component_name in components.names { mark_written_type_module_used(checker, component_name) }
        return
    }
    mark_type_module_used(checker, type_name)
}

// The type a call through a func-typed struct field produces: the first return type of the field's
// signature (unknown when it returns nothing), or nil when the field is not func-typed.
fn func_field_call_type(checker ^TypeChecker, struct_name string, field string) -> ^types.GrayType {
    field_type = struct_field_type(checker, struct_name, field)
    if field_type^.kind != types.TypeKind.FUNCTION { return nil }
    if field_type^.func_sig != nil && field_type^.func_sig^.return_count > 0 && len(field_type^.func_sig^.return_types) > 0 {
        return checker_type_from_name(checker, field_type^.func_sig^.return_types[0])
    }
    return checker^.pool^.type_unknown
}
